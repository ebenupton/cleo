001A4Cr 2  90 15                bcc @f4
001A4Er 2  A9 06                lda #6
001A50r 2  18                   clc                         ; only this arm reaches @fr with C set (cmp #9
001A51r 2  4C rr rr             bra @fr                     ; fell through); @f2 and @f4 got here on a bcc
001A54r 2  A5 B0        @f0:    lda fc
001A56r 2  4C rr rr             bra @sp
001A59r 2  A9 02        @f2:    lda #2
001A5Br 2  4C rr rr             bra @fr
001A5Er 2  A9 08        @f8:    lda #8
001A60r 2  4C rr rr             bra @sp
001A63r 2  A9 04        @f4:    lda #4
001A65r 2  65 B0        @fr:    adc fc
001A67r 2  A6 D0        @sp:    ldx otype                   ; the frame stays in A: no round trip through q1
001A69r 2  E0 05                cpx #5
001A6Br 2  D0 05                bne :+
001A6Dr 2  69 42                adc #66                     ; C = 1 from the equal cpx, so this is A + 67
001A6Fr 2  4C rr rr             bra :++
001A72r 2  18           :       clc
001A73r 2  69 4C                adc #76
001A75r 2  4C rr rr     :       jmp m_addsprite
001A78r 2               
001A78r 2               ; ---------------------------------------------------------------- SPIKE (7)
001A78r 2               ob_spike:
001A78r 2                       ; A is a dormancy counter running -127..24 (CleoApp.run case 7: A++, and at 24
001A78r 2                       ; A = -(rnd&63)-64).  That fits a signed byte exactly, so the byte IS the value
001A78r 2                       ; and the high half was only ever its sign extension.
001A78r 2  E6 AC                inc fa
001A7Ar 2  A5 AC                lda fa
001A7Cr 2  C9 18                cmp #24
001A7Er 2  D0 0C                bne @nowrap
001A80r 2  20 rr rr             jsr m_rnd
001A83r 2  29 3F                and #63
001A85r 2  49 3F                eor #63                     ; 63-r, then +129, is 192-r: the byte form of
001A87r 2  18                   clc                         ; -(r&63)-64, i.e. -64 down to -127
001A88r 2  69 81                adc #129
001A8Ar 2  85 AC                sta fa
001A8Cr 2               @nowrap:
001A8Cr 2  A5 rr                lda health
001A8Er 2  F0 2A                beq @draw
001A90r 2  A5 AC                lda fa
001A92r 2  30 26                bmi @draw                   ; still dormant
001A94r 2  C9 08                cmp #8
001A96r 2  B0 22                bcs @draw
001A98r 2                       ; rx > -8 && rx < (A+1)*2 && ry > -24 && ry < 8
001A98r 2  85 DF E6 DF          inca                        ; A is still fa: cmp does not write A
001A9Cr 2  A5 DF        
001A9Er 2  0A                   asl
001A9Fr 2  49 80                eor #$80                    ; biased limit
001AA1r 2  8D rr rr             sta RNGTAB+49
001AA4r 2  A2 30                ldx #48
001AA6r 2  20 rr rr             jsr inrange
001AA9r 2  90 0F                bcc @draw
001AABr 2  A5 rr                lda hurt
001AADr 2  D0 0B                bne @draw
001AAFr 2  A5 B6 85 D7          mov16 hx, rx
001AB3r 2  A5 B7 85 D8  
001AB7r 2  20 rr rr             jsr player_hit
001ABAr 2  A5 AC        @draw:  lda fa
001ABCr 2  30 10                bmi @done
001ABEr 2  C9 08                cmp #8
001AC0r 2  90 07                bcc :+
001AC2r 2  A9 17                lda #23
001AC4r 2  38                   sec
001AC5r 2  E5 AC                sbc fa
001AC7r 2  4A                   lsr
001AC8r 2  18                   clc                         ; only the lsr can leave C set; bcc arrives with C=0
001AC9r 2  69 55        :       adc #85
001ACBr 2  4C rr rr             jmp m_addsprite
001ACEr 2  60           @done:  rts
001ACFr 2               
001ACFr 2               ; ---------------------------------------------------------------- FLAME (9)
001ACFr 2               ob_flame:
