000424r 2               @dorows:
000424r 2  A5 rr                lda wcx
000426r 2  85 rr                sta rc_x
000428r 2  A5 rr                lda wcx+1
00042Ar 2  85 rr                sta rc_x+1
00042Cr 2  A9 50                lda #ROWCHARS
00042Er 2  85 rr                sta rc_w
000430r 2  20 rr rr             jsr drawrect
000433r 2  4C rr rr             bra @done
000436r 2               @full:
000436r 2  A5 rr                lda wcy
000438r 2  85 rr                sta rc_y
00043Ar 2  A9 16                lda #BUFROWS
00043Cr 2  85 rr                sta rc_h
00043Er 2  4C rr rr             bra @dorows
000441r 2               @done:
000441r 2  A6 rr                ldx curbuf
000443r 2  A9 01                lda #1
000445r 2  9D rr rr             sta BUF_VALID,x
000448r 2  A5 rr                lda wcy
00044Ar 2  9D rr rr             sta BUF_CY,x
00044Dr 2  8A                   txa
00044Er 2  0A                   asl
00044Fr 2  A8                   tay
000450r 2  A5 rr                lda wcx
000452r 2  99 rr rr             sta BUF_CX,y
000455r 2  A5 rr                lda wcx+1
000457r 2  99 rr rr             sta BUF_CX+1,y
00045Ar 2  60                   rts
00045Br 2               
00045Br 2               ; ============================================================================
00045Br 2               ; ============================================================================
00045Br 2               ; Persistent sprite records.  match_sprites: KEEP[i] = new sprite i identical to record i
00045Br 2               ; ============================================================================
00045Br 2               match_sprites:
00045Br 2  A6 rr                ldx curbuf
00045Dr 2  BD rr rr             lda RECCNT,x
000460r 2  C5 A2                cmp NSPR
000462r 2  90 02                bcc :+
000464r 2  A5 A2                lda NSPR
000466r 2  85 rr        :       sta cnt                     ; n = min(RECCNT, NSPR)
000468r 2  48 A9 00 85          stza tmp4                   ; i
00046Cr 2  rr 68        
00046Er 2  A5 rr                lda recp
000470r 2  85 rr                sta rp
000472r 2  A5 rr                lda recp+1
000474r 2  85 rr                sta rp+1
000476r 2  A6 rr        @l:     ldx tmp4
000478r 2  E4 A2                cpx NSPR
00047Ar 2  B0 65                bcs @done
00047Cr 2  48 A9 00 9D          stza KEEP,x
000480r 2  rr rr 68     
000483r 2  E4 rr                cpx cnt
000485r 2  B0 4A                bcs @next
000487r 2  BD 30 80             lda sprmul5,x
00048Ar 2  AA                   tax
00048Br 2  BD rr rr             lda SPRLIST,x
00048Er 2  A0 00 D1 rr          cmpz rp                     ; (zp): offset 0 needs no index register
000492r 2  F0 11                beq @same
000494r 2                       ; two box-star frames at the same place overwrite each other exactly -- every
000494r 2                       ; pixel opaque, and each box covers the art of the frame before it -- so a
000494r 2                       ; frame change there needs no erase either
000494r 2  C9 67                cmp #BOXID0
000496r 2  90 39                bcc @next
000498r 2  A0 00 B1 rr          ldaz rp
00049Cr 2  C9 67                cmp #BOXID0
00049Er 2  90 31                bcc @next
0004A0r 2  A9 01                lda #1                      ; 1 = a different frame of the same thing
0004A2r 2  4C rr rr             bra @pos
0004A5r 2  A9 02        @same:  lda #2                      ; 2 = identical, so its pixels are already right
0004A7r 2  85 rr        @pos:   sta tmp3
0004A9r 2  A0 01                ldy #1
0004ABr 2  BD rr rr             lda SPRLIST+1,x
0004AEr 2  D1 rr                cmp (rp),y
0004B0r 2  D0 1F                bne @next
0004B2r 2  C8                   iny
0004B3r 2  BD rr rr             lda SPRLIST+2,x
0004B6r 2  D1 rr                cmp (rp),y
0004B8r 2  D0 17                bne @next
0004BAr 2  C8                   iny
0004BBr 2  BD rr rr             lda SPRLIST+3,x
0004BEr 2  D1 rr                cmp (rp),y
0004C0r 2  D0 0F                bne @next
0004C2r 2  C8                   iny
0004C3r 2  BD rr rr             lda SPRLIST+4,x
0004C6r 2  D1 rr                cmp (rp),y
0004C8r 2  D0 07                bne @next
0004CAr 2  A6 rr                ldx tmp4
0004CCr 2  A5 rr                lda tmp3
0004CEr 2  9D rr rr             sta KEEP,x                  ; same pixels in the same place: skip the erase
0004D1r 2  A5 rr        @next:  lda rp
0004D3r 2  18                   clc
0004D4r 2  69 0A                adc #10
0004D6r 2  85 rr                sta rp
0004D8r 2  90 02                bcc :+
0004DAr 2  E6 rr                inc rp+1
0004DCr 2  E6 rr        :       inc tmp4
0004DEr 2  4C rr rr             bra @l
0004E1r 2  60           @done:  rts
0004E2r 2               
0004E2r 2               ; erase_old: redraw tiles under old records that are not kept
0004E2r 2               erase_old:
0004E2r 2  A6 rr                ldx curbuf
0004E4r 2  BD rr rr             lda RECCNT,x
0004E7r 2  F0 4C                beq @done
0004E9r 2  85 rr                sta lcnt
0004EBr 2  A9 00 85 rr          stz lidx
0004EFr 2  A5 rr                lda recp
0004F1r 2  85 rr                sta rp
0004F3r 2  A5 rr                lda recp+1
0004F5r 2  85 rr                sta rp+1
0004F7r 2  A6 rr        @l:     ldx lidx
0004F9r 2  E4 A2                cpx NSPR
0004FBr 2  B0 05                bcs @erase
0004FDr 2  BD rr rr             lda KEEP,x
000500r 2  D0 22                bne @next
000502r 2  A0 08        @erase: ldy #8
000504r 2  B1 rr                lda (rp),y
000506r 2  F0 1C                beq @next
000508r 2  85 rr                sta rc_w
00050Ar 2  C8                   iny
00050Br 2  B1 rr                lda (rp),y
00050Dr 2  29 7F                and #$7F
00050Fr 2  85 rr                sta rc_h
000511r 2  A0 05                ldy #5
000513r 2  B1 rr                lda (rp),y
000515r 2  85 rr                sta rc_x
000517r 2  C8                   iny
000518r 2  B1 rr                lda (rp),y
00051Ar 2  85 rr                sta rc_x+1
00051Cr 2  C8                   iny
00051Dr 2  B1 rr                lda (rp),y
00051Fr 2  85 rr                sta rc_y
000521r 2  20 rr rr             jsr drawrect_clip
000524r 2  A5 rr        @next:  lda rp
000526r 2  18                   clc
000527r 2  69 0A                adc #10
000529r 2  85 rr                sta rp
00052Br 2  90 02                bcc :+
00052Dr 2  E6 rr                inc rp+1
00052Fr 2  E6 rr        :       inc lidx
000531r 2  C6 rr                dec lcnt
000533r 2  D0 C2                bne @l
000535r 2  60           @done:  rts
000536r 2               
000536r 2               ; ============================================================================
000536r 2               ; Sprites
000536r 2               ; ============================================================================
000536r 2               ; add sprite to draw list: A = id, spx/spy = map px
000536r 2                       PLACE "CODE", "LGCLO"       ; Model B: the logic's bank writes SPRLIST in low RAM
000000r 2               addsprite:
000000r 2  A6 A2                ldx NSPR
000002r 2  E0 18                cpx #MAXSPR
000004r 2  B0 1C                bcs @full
000006r 2  BC 30 80             ldy sprmul5,x
000009r 2  99 rr rr             sta SPRLIST,y
00000Cr 2  A5 rr                lda spx
00000Er 2  99 rr rr             sta SPRLIST+1,y
000011r 2  A5 rr                lda spx+1
000013r 2  99 rr rr             sta SPRLIST+2,y
000016r 2  A5 rr                lda spy
000018r 2  99 rr rr             sta SPRLIST+3,y
00001Br 2  A5 rr                lda spy+1
00001Dr 2  99 rr rr             sta SPRLIST+4,y
000020r 2  E6 A2                inc NSPR
000022r 2  60           @full:  rts
000023r 2               
000023r 2               ; draw all listed sprites into current buffer (skipping unchanged kept ones)
000023r 2                       PLACE "CODE", "TILCODE"
000536r 2               draw_sprites:
000536r 2                       ; Two passes.  A box star is an opaque rectangle with its background baked in,
000536r 2                       ; so it has to go down before anything that shares its space -- drawn in list
000536r 2                       ; order it would paint that background over whatever was standing there.
000536r 2  A9 01                lda #1
000538r 2  8D rr rr             sta dpass
00053Br 2  48 A9 00 85  @pass:  stza spi
00053Fr 2  rr 68        
000541r 2  A5 rr                lda recp
000543r 2  85 rr                sta rp
000545r 2  A5 rr                lda recp+1
000547r 2  85 rr                sta rp+1
000549r 2  A6 rr        @l:     ldx spi
00054Br 2  E4 A2                cpx NSPR
00054Dr 2  B0 67                bcs @endpass
00054Fr 2  BD 30 80             lda sprmul5,x
000552r 2  AA                   tax
000553r 2  BD rr rr             lda SPRLIST,x
000556r 2  C9 67                cmp #BOXID0
000558r 2  AD rr rr             lda dpass
00055Br 2  69 FF                adc #$FF
00055Dr 2  F0 47                beq @next
00055Fr 2  BD rr rr             lda SPRLIST,x
000562r 2  C9 76                cmp #BOXID0+BOXN            ; a box star the logic says nothing can disturb, and
000564r 2  90 0F                bcc @write                  ; the same frame already in the same place: if
000566r 2  A4 rr                ldy spi                     ; nothing has been repainted under it, its pixels
000568r 2  B9 rr rr             lda KEEP,y                  ; are still right, so leave it alone
00056Br 2  C9 02                cmp #2
00056Dr 2  D0 06                bne @write
00056Fr 2  A0 09                ldy #9                      ; and it was not cut off at a window edge, so all
000571r 2  B1 rr                lda (rp),y                  ; of it is on screen and still intact
000573r 2  10 31                bpl @next
000575r 2  A0 01        @write: ldy #1
000577r 2  BD rr rr             lda SPRLIST+1,x
00057Ar 2  85 rr                sta spx
00057Cr 2  91 rr                sta (rp),y
00057Er 2  C8                   iny
00057Fr 2  BD rr rr             lda SPRLIST+2,x
000582r 2  85 rr                sta spx+1
000584r 2  91 rr                sta (rp),y
000586r 2  C8                   iny
000587r 2  BD rr rr             lda SPRLIST+3,x
00058Ar 2  85 rr                sta spy
00058Cr 2  91 rr                sta (rp),y
00058Er 2  C8                   iny
00058Fr 2  BD rr rr             lda SPRLIST+4,x
000592r 2  85 rr                sta spy+1
000594r 2  91 rr                sta (rp),y
000596r 2  A0 08                ldy #8
000598r 2  A9 00                lda #0
00059Ar 2  91 rr                sta (rp),y
00059Cr 2  BD rr rr             lda SPRLIST,x
00059Fr 2  A0 00 91 rr          staz rp                     ; sta (rp) - offset 0 needs no index
0005A3r 2  20 rr rr             jsr drawsprite
0005A6r 2  A5 rr        @next:  lda rp
0005A8r 2  18                   clc
0005A9r 2  69 0A                adc #10
0005ABr 2  85 rr                sta rp
0005ADr 2  90 02                bcc :+
0005AFr 2  E6 rr                inc rp+1
0005B1r 2  E6 rr        :       inc spi
0005B3r 2  4C rr rr             jmp @l
0005B6r 2               @endpass:
0005B6r 2  CE rr rr             dec dpass
0005B9r 2  30 03                bmi :+
0005BBr 2  4C rr rr             jmp @pass                   ; (out of branch range on the 6502 build)
0005BEr 2  A6 rr        :       ldx curbuf
0005C0r 2  A5 A2                lda NSPR
0005C2r 2  9D rr rr             sta RECCNT,x
0005C5r 2  60                   rts
0005C6r 2               
0005C6r 2               ; draw one sprite: A = id ; spx, spy = map px (ref point)
0005C6r 2               ; A = sprite id. Game sprites (spbank = BANK_SPR): directory is in main RAM at
0005C6r 2               ; SPR_TABLE; sprite data is in bank 4, or in ANDY ($8000, ROMSEL bit7) when the
0005C6r 2               ; entry's flag bit2 is set. Title pieces (spbank != BANK_SPR): directory and data
0005C6r 2               ; both live at TITLE_ADDR of that bank.
0005C6r 2               drawsprite:
0005C6r 2  48 A9 00 8D          stza spclip                 ; set at every window edge the sprite is cut against
0005CAr 2  rr rr 68     
0005CDr 2  C9 76                cmp #BOXID0+BOXN            ; the "nothing can disturb it" aliases draw the same
0005CFr 2  90 02                bcc :+                      ; picture as the ids BOXN below them
0005D1r 2  E9 0F                sbc #BOXN
0005D3r 2               :
0005D3r 2                 .if MODE1
0005D3r 2  85 rr                sta sp_id
0005D5r 2                 .endif
0005D5r 2  48 A9 00 85          stza ptr+1
0005D9r 2  rr 68        
0005DBr 2  0A                   asl                         ; id*8 -> offset
0005DCr 2  26 rr                rol ptr+1
0005DEr 2  0A                   asl
0005DFr 2  26 rr                rol ptr+1
0005E1r 2  0A                   asl
0005E2r 2  26 rr                rol ptr+1
0005E4r 2  AE rr rr             ldx spbank
0005E7r 2  E0 04                cpx #BANK_SPR
0005E9r 2  D0 41                bne @titledir
0005EBr 2                 .if .not MODELB               ; (Model B: the directory is in this bank)
0005EBr 2                       ldx #BANK_LVL           ; SPR_TABLE is in bank 7; the whole prologue reads
0005EBr 2                       stx ROMSEL_CPY          ; the directory and none of it reads sprite data
0005EBr 2                       stx ROMSEL
0005EBr 2                 .endif
0005EBr 2  18                   clc
0005ECr 2  69 rr                adc #<SPR_TABLE
0005EEr 2  85 rr                sta ptr
0005F0r 2  A5 rr                lda ptr+1
0005F2r 2  69 rr                adc #>SPR_TABLE
0005F4r 2  85 rr                sta ptr+1
0005F6r 2                 .if MODELB
0005F6r 2  20 rr rr             jsr dirfetch                ; the directory is in bank 6: its eight bytes come
0005F9r 2                 .endif                            ; into low RAM and ptr points there
0005F9r 2  A0 06                ldy #6
0005FBr 2  B1 rr                lda (ptr),y
0005FDr 2  85 rr                sta sp_flags
0005FFr 2  A2 04                ldx #BANK_SPR
000601r 2  85 DF 29 04          bitimm 4
000605r 2  08 A5 DF 28  
000609r 2  F0 02                beq :+
00060Br 2  A2 84                ldx #(BANK_SPR|$80)
00060Dr 2  85 DF 29 10  :       bitimm $10              ; A still holds the flags byte
000611r 2  08 A5 DF 28  
000615r 2  F0 02                beq :+
000617r 2  A2 06                ldx #BANK_TIL1
000619r 2  86 rr        :       stx sp_dbank            ; wanted later: the directory is still being read
00061Br 2                 .if MODE1
00061Br 2  A5 rr                lda sp_id
00061Dr 2  0A                   asl
00061Er 2  AA                   tax
00061Fr 2  BD rr rr             lda SPRMASK,x
000622r 2  85 EC                sta sp_mbase
000624r 2  BD rr rr             lda SPRMASK+1,x
000627r 2  85 ED                sta sp_mbase+1
000629r 2                 .endif
000629r 2  4C rr rr             bra @entry2
00062Cr 2               @titledir:
00062Cr 2                       ; ---- title piece: directory + data at TITLE_ADDR of bank(spbank)
00062Cr 2  85 rr                sta ptr                     ; only this path uses id*8 as the low byte unadjusted
00062Er 2  A5 rr                lda ptr+1
000630r 2  18                   clc
000631r 2  69 89                adc #>TITLE_ADDR
000633r 2  85 rr                sta ptr+1
000635r 2  AD rr rr             lda spbank              ; title pieces keep directory and data in one bank
000638r 2  85 rr                sta sp_dbank
00063Ar 2                 .if .not MODELB
00063Ar 2                       sta ROMSEL_CPY
00063Ar 2                       sta ROMSEL
00063Ar 2                 .endif
00063Ar 2  A0 06                ldy #6
00063Cr 2  B1 rr                lda (ptr),y
00063Er 2  85 rr                sta sp_flags
000640r 2                 .if MODE1
000640r 2  A5 rr                lda sp_id                   ; the mask address table behind the directory
000642r 2  0A                   asl
000643r 2  AA                   tax
000644r 2  BD 80 89             lda TITLE_ADDR+$80,x
000647r 2  85 EC                sta sp_mbase
000649r 2  BD 81 89             lda TITLE_ADDR+$81,x
00064Cr 2  85 ED                sta sp_mbase+1
00064Er 2                 .endif
00064Er 2               @entry2:
00064Er 2  A0 00 B1 rr          ldaz ptr
000652r 2  85 rr                sta sp_ptr
000654r 2  A0 01                ldy #1
000656r 2  B1 rr                lda (ptr),y
000658r 2  85 rr                sta sp_ptr+1
00065Ar 2  C8                   iny
00065Br 2  B1 rr                lda (ptr),y
00065Dr 2  85 rr                sta sp_w
00065Fr 2                 .if MODELB
00065Fr 2  D0 03                bne @w_ok                   ; (the 6502 spellings put @out0 out of reach)
000661r 2  4C rr rr             jmp @out0
000664r 2               @w_ok:
000664r 2                 .else
000664r 2                       beq @out0
000664r 2                 .endif
000664r 2               :                                   ; keep the bare label: it preserves the anonymous-label count
000664r 2  A0 07                ldy #7
000666r 2  B1 rr                lda (ptr),y
000668r 2  85 rr                sta sp_lines
00066Ar 2  85 rr                sta sp_ext
00066Cr 2                 .if MODE1
00066Cr 2  4A                   lsr
00066Dr 2  85 E9                sta sp_mh                   ; mask bytes per column group = pixel rows
00066Fr 2                 .endif
00066Fr 2  A5 rr                lda sp_flags
000671r 2  29 02                and #2
000673r 2  D0 02                bne :+
000675r 2  06 rr                asl sp_ext                  ; half-res: two scanlines per stored row
000677r 2               :       ; ---- horizontal: sx = spx - refx - wx ; c0 = sx >> 1
000677r 2  A0 04                ldy #4
000679r 2  B1 rr                lda (ptr),y
00067Br 2  29 80                and #$80                    ; sext inlined: the jsr/rts was 12 cycles of the 39
00067Dr 2  F0 02                beq @sxp
00067Fr 2  A9 FF                lda #$FF
000681r 2  85 rr        @sxp:   sta tmp3
000683r 2  A5 rr                lda spx
000685r 2  38                   sec
000686r 2  F1 rr                sbc (ptr),y
000688r 2  AA                   tax
000689r 2  A5 rr                lda spx+1
00068Br 2  E5 rr                sbc tmp3
00068Dr 2  A8                   tay
00068Er 2  8A                   txa
00068Fr 2  38                   sec
000690r 2  E5 rr                sbc wx
000692r 2  85 rr                sta w16
000694r 2  98                   tya
000695r 2  E5 rr                sbc wx+1
000697r 2  C9 80                cmp #$80
000699r 2  6A                   ror a                       ; sign into bit 7, old bit 0 out to C
00069Ar 2  66 rr                ror w16                     ; arithmetic shift right 1 -> c0 (16 bit)
00069Cr 2  C9 00                cmp #0                      ; A still holds w16+1: just restore N,Z
00069Er 2  F0 29                beq @cpos
0006A0r 2  C9 FF                cmp #$FF
0006A2r 2  D0 49                bne @out0
0006A4r 2                       ; c0 negative (-128..-1): cstart = 0 ; visible if c0 + W > 0
0006A4r 2  A5 rr                lda w16
0006A6r 2  18                   clc
0006A7r 2  65 rr                adc sp_w
0006A9r 2  85 DF C6 DF          deca
0006ADr 2  A5 DF        
0006AFr 2  30 3C                bmi @out0
0006B1r 2  EE rr rr             inc spclip
0006B4r 2  85 rr                sta sp_c1
0006B6r 2  A9 00 85 rr          stz sp_c0
0006BAr 2                       ; first visible column index = -c0
0006BAr 2  A5 rr                lda w16
0006BCr 2  49 FF                eor #$FF
0006BEr 2  85 DF E6 DF          inca
0006C2r 2  A5 DF        
0006C4r 2  85 rr                sta sp_c                    ; starting image column
0006C6r 2  4C rr rr             bra @vert
0006C9r 2  A5 rr        @cpos:  lda w16
0006CBr 2  C9 50                cmp #ROWCHARS
0006CDr 2  B0 1E                bcs @out0                   ; not taken: C = 0 for the adc below
0006CFr 2  85 rr                sta sp_c0
0006D1r 2  65 rr                adc sp_w
0006D3r 2  85 DF C6 DF          deca
0006D7r 2  A5 DF        
0006D9r 2  C9 50                cmp #ROWCHARS
0006DBr 2  90 05                bcc :+
0006DDr 2  EE rr rr             inc spclip                  ; and at the right
0006E0r 2  A9 4F                lda #(ROWCHARS-1)
0006E2r 2  85 rr        :       sta sp_c1
0006E4r 2  48 A9 00 85          stza sp_c
0006E8r 2  rr 68        
0006EAr 2  4C rr rr             bra @vert
0006EDr 2  60           @out0:  rts
0006EEr 2               @vert:
0006EEr 2                       ; ---- vertical: sy = spy - refy - wy ; lb0 = 2*sy + wfine
0006EEr 2  A0 05                ldy #5
0006F0r 2  B1 rr                lda (ptr),y
0006F2r 2  20 rr rr             jsr sext
0006F5r 2  A5 rr                lda spy
0006F7r 2  38                   sec
0006F8r 2  F1 rr                sbc (ptr),y
0006FAr 2  AA                   tax
0006FBr 2  A5 rr                lda spy+1
0006FDr 2  E5 rr                sbc tmp3
0006FFr 2  A8                   tay
000700r 2                 .if .not MODELB               ; (Model B: the data's bank runs the loop, below)
000700r 2                       lda sp_dbank            ; done with the directory: the blitter wants the data
000700r 2                       sta ROMSEL_CPY
000700r 2                       sta ROMSEL
000700r 2                 .endif
000700r 2  8A                   txa
000701r 2  38                   sec
000702r 2  E5 rr                sbc wy
000704r 2  AA                   tax
000705r 2  98                   tya
000706r 2  E5 rr                sbc wy+1
000708r 2  85 rr                sta sp_lb0+1
00070Ar 2  8A                   txa
00070Br 2  0A                   asl                         ; C = old bit 7, exactly what 'asl w16' left
00070Cr 2  26 rr                rol sp_lb0+1
00070Er 2  18                   clc
00070Fr 2  65 rr                adc wfine
000711r 2  85 rr                sta sp_lb0
000713r 2  90 03                bcc @nc
000715r 2  E6 rr                inc sp_lb0+1                ; lb0 (16 bit signed)
000717r 2  18                   clc                         ; only this arm arrives with C set
000718r 2               @nc:
000718r 2                       ; lend = lb0 + ext - 1
000718r 2  A5 rr                lda sp_ext
00071Ar 2  85 DF C6 DF          deca
00071Er 2  A5 DF        
000720r 2  65 rr                adc sp_lb0
000722r 2  85 rr                sta w16
000724r 2  A5 rr                lda sp_lb0+1
000726r 2  69 00                adc #0
000728r 2  85 rr                sta w16+1                   ; w16 = lb1
00072Ar 2                       ; clip lstart = max(lb0,0) ; lend = min(lb1, 247)
00072Ar 2  A5 rr                lda sp_lb0+1
00072Cr 2  30 0D                bmi @top
00072Er 2  D0 BD                bne @out0                   ; lb0 >= 256 -> below
000730r 2  A5 rr                lda sp_lb0
000732r 2  C9 B0                cmp #BUFROWS*8
000734r 2  B0 B7                bcs @out0
000736r 2  85 rr                sta tmp                     ; lstart
000738r 2  4C rr rr             bra @ck
00073Br 2  A5 rr        @top:   lda w16+1
00073Dr 2  30 AE                bmi @out0                   ; lb1 < 0
00073Fr 2  EE rr rr             inc spclip                  ; cut off at the top
000742r 2  A9 00 85 rr          stz tmp
000746r 2  A5 rr        @ck:    lda w16+1
000748r 2  D0 06                bne @clampend
00074Ar 2  A5 rr                lda w16
00074Cr 2  C9 B0                cmp #BUFROWS*8
00074Er 2  90 05                bcc :+
000750r 2               @clampend:
