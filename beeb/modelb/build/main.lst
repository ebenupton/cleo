0004F2r 2               
0004F2r 2               ; A pattern that makes the geometry readable: each ring row is a band of one colour
0004F2r 2               ; with its slot number written as a run of black chars at the left, so the order of
0004F2r 2               ; the rows on screen, the wrap and the mirror can all be counted off.
0004F2r 2               test_pattern:
0004F2r 2  A2 00                ldx #0                      ; slot
0004F4r 2  86 rr        @slot:  stx tmp2
0004F6r 2  8A                   txa
0004F7r 2  18                   clc
0004F8r 2  69 01                adc #1
0004FAr 2  85 rr                sta tmp                     ; colour 1..3 by slot
0004FCr 2  C9 04        @c1:    cmp #4
0004FEr 2  90 05                bcc :+
000500r 2  E9 03                sbc #3
000502r 2  4C rr rr             bra @c1
000505r 2  A8           :       tay
000506r 2  B9 rr rr             lda @cols,y
000509r 2  85 rr                sta tmp3                    ; the band's byte
00050Br 2  A6 rr                ldx tmp2
00050Dr 2  B5 rr                lda RINGLO,x
00050Fr 2  85 rr                sta w16
000511r 2  B5 rr                lda RINGHI,x
000513r 2  85 rr                sta w16+1
000515r 2  A0 00                ldy #0
000517r 2  A9 00                lda #0
000519r 2  85 rr                sta cnt                     ; char within the row
00051Br 2  A5 rr        @char:  lda cnt
00051Dr 2  C5 rr                cmp tmp2                    ; the first (slot+1) chars are black
00051Fr 2  90 07                bcc @black
000521r 2  F0 05                beq @black
000523r 2  A5 rr                lda tmp3
000525r 2  4C rr rr             bra @put
000528r 2  A9 00        @black: lda #0
00052Ar 2  A2 08        @put:   ldx #8
