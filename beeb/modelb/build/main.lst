000A05r 2  26 rr                rol spy+1
000A07r 2  85 rr                sta spy
000A09r 2  60                   rts
000A0Ar 2               
000A0Ar 2                       .segment "LGCBSS"
000000r 2  xx xx xx xx  OBJS:     .res NOBJS*6 + 40
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
0000B8r 2  xx xx        bptx:     .res 2                    ; per buffer: the tile window its ring holds
0000BAr 2  xx xx        bpty:     .res 2
0000BCr 2  xx xx        bvalid:   .res 2
0000BEr 2               
0000BEr 1                       .include "bank6.s"
0000BEr 2               ; ============================================================================
0000BEr 2               ; Bank 6: the map, the level's tables, and the routines that read them.  The
0000BEr 2               ; tile blitter and the logic live in other banks, so what leaves here goes
0000BEr 2               ; through a strip copy into MAPBUF in main RAM, or one byte through mapbyte.
0000BEr 2               ; ============================================================================
0000BEr 2                       .segment "MAPCODE"
000000r 2               ; map_strip: copy cnt map bytes from tile (tmp, tmp2) into MAPBUF.
000000r 2               map_strip:
000000r 2  A9 00 85 rr          stz w16+1                   ; stz is lda #0 on a 6502: it cannot go between
000004r 2  A5 rr                lda tmp2                    ; the load of ty and the shifts that use it
000006r 2  A2 05                ldx #MAPLW                  ; * the map's stride
000008r 2  0A           @sh:    asl
000009r 2  26 rr                rol w16+1
00000Br 2  CA                   dex
00000Cr 2  D0 FA                bne @sh
00000Er 2  18                   clc
00000Fr 2  65 rr                adc tmp
000011r 2  85 rr                sta w16
000013r 2  A5 rr                lda w16+1
000015r 2  69 00                adc #0
000017r 2  18                   clc
000018r 2  69 rr                adc #>LV_MAP
00001Ar 2  85 rr                sta w16+1
00001Cr 2  A5 rr                lda w16
00001Er 2  18                   clc
00001Fr 2  69 rr                adc #<LV_MAP
000021r 2  85 rr                sta w16
000023r 2  90 02                bcc :+
000025r 2  E6 rr                inc w16+1
000027r 2  A0 00        :       ldy #0
000029r 2  B1 rr        @cp:    lda (w16),y
00002Br 2  99 rr rr             sta MAPBUF,y
00002Er 2  C8                   iny
00002Fr 2  C4 rr                cpy cnt
000031r 2  D0 F6                bne @cp
000033r 2  60                   rts
000034r 2               
000034r 2               ; map_col: the same, but a column: cnt bytes down from tile (tmp, tmp2)
000034r 2               map_col:
000034r 2  A9 00 85 rr          stz w16+1
000038r 2  A5 rr                lda tmp2
00003Ar 2  A2 05                ldx #MAPLW
00003Cr 2  0A           @sh:    asl
00003Dr 2  26 rr                rol w16+1
00003Fr 2  CA                   dex
000040r 2  D0 FA                bne @sh
000042r 2  18                   clc
000043r 2  65 rr                adc tmp
000045r 2  85 rr                sta w16
000047r 2  A5 rr                lda w16+1
000049r 2  69 00                adc #0
00004Br 2  18                   clc
00004Cr 2  69 rr                adc #>LV_MAP
00004Er 2  85 rr                sta w16+1
000050r 2  A5 rr                lda w16
000052r 2  18                   clc
000053r 2  69 rr                adc #<LV_MAP
000055r 2  85 rr                sta w16
000057r 2  90 02                bcc :+
000059r 2  E6 rr                inc w16+1
00005Br 2  A2 00        :       ldx #0
00005Dr 2  A0 00                ldy #0
00005Fr 2  B1 rr        @cp:    lda (w16),y
000061r 2  95 rr                sta MAPBUF,x
000063r 2  A5 rr                lda w16
000065r 2  18                   clc
000066r 2  69 20                adc #MAPW
000068r 2  85 rr                sta w16
00006Ar 2  90 02                bcc :+
00006Cr 2  E6 rr                inc w16+1
00006Er 2  E8           :       inx
00006Fr 2  E4 rr                cpx cnt
000071r 2  D0 EC                bne @cp
000073r 2  60                   rts
000074r 2               
000074r 2               ; alt_row: tmp2 = tile id -> MAPBUF[0..7] = the altitude row of its class
000074r 2               alt_row:
000074r 2  A6 rr                ldx tmp2
000076r 2  BD rr rr             lda LV_ACLS,x
000079r 2  0A                   asl
00007Ar 2  0A                   asl
00007Br 2  0A                   asl
00007Cr 2  18                   clc
00007Dr 2  69 rr                adc #<LV_ALT
00007Fr 2  85 rr                sta w16
000081r 2  A9 00                lda #0
000083r 2  69 rr                adc #>LV_ALT
000085r 2  85 rr                sta w16+1
000087r 2  A0 07                ldy #7
000089r 2  B1 rr        :       lda (w16),y
00008Br 2  99 rr rr             sta MAPBUF,y
00008Er 2  88                   dey
00008Fr 2  10 F8                bpl :-
000091r 2  60                   rts
000092r 2               
000092r 2               ; map_copy: cnt bytes from w16b in this bank into MAPBUF
000092r 2               map_copy:
000092r 2  A0 00                ldy #0
000094r 2  B1 rr        :       lda (w16b),y
000096r 2  99 rr rr             sta MAPBUF,y
000099r 2  C8                   iny
00009Ar 2  C4 rr                cpy cnt
00009Cr 2  D0 F6                bne :-
00009Er 2  60                   rts
00009Fr 2               
00009Fr 2                       .segment "MAPDATA"
000000r 2                       .align 256
000000r 2               LV_HDR:
000000r 2  05 05 0D 1C          .incbin "build/level.bin"       ; header, objects, attributes, alt classes
000004r 2  16 1B 18 7F  
000008r 2  60 61 7F 7F  
000320r 2               LV_ALT:
000320r 2  80 80 80 80          .incbin "build/alt.bin"
000324r 2  80 80 80 80  
000328r 2  08 08 08 08  
000368r 2  xx xx xx xx          .align 256
00036Cr 2  xx xx xx xx  
000370r 2  xx xx xx xx  
000400r 2               LV_MAP:
000400r 2  03 03 03 03          .incbin "build/map.bin"
000404r 2  03 03 03 03  
000408r 2  03 03 03 03  
000800r 2               LV_OBJS = LV_HDR + 32
000800r 2               LV_ATTR = LV_HDR + 32 + 256
000800r 2               LV_ACLS = LV_HDR + 32 + 256 + 256
000800r 2               
000800r 1                       .include "bank5.s"
000800r 2               ; ============================================================================
000800r 2               ; Bank 5: this level's tiles and the blitter that draws them.  A tile is 8 game
000800r 2               ; pixels square: 4 chars wide and 2 char rows tall, 64 bytes, and 1840 (the ring
000800r 2               ; in chars) divides by 4, so a tile's four chars are always contiguous -- only
000800r 2               ; whole tiles can straddle the ring end, never their columns.
000800r 2               ; ============================================================================
000800r 2                       .segment "TILCODE"
000000r 2               ; draw_maprect: the tile rectangle (dt_tx, dt_ty) size (dt_nx, dt_ny), into the
000000r 2               ; ring where the window arithmetic says it goes.  A map char (cx, cy) is ring
000000r 2               ; char ((cy mod 23)*80 + cx) mod 1840, which does not depend on the window.
000000r 2               draw_maprect:
000000r 2  A5 rr        @row:   lda dt_tx                   ; one strip of map per tile row
000002r 2  85 rr                sta tmp
000004r 2  A5 rr                lda dt_ty
000006r 2  85 rr                sta tmp2
000008r 2  A5 rr                lda dt_nx
00000Ar 2  85 rr                sta cnt
00000Cr 2  A2 09 20 rr          farjsr F_MAPSTRIP
000010r 2  rr           
000011r 2  A5 rr                lda dt_ty                   ; char row = 2*ty, and its ring slot
000013r 2  0A                   asl
000014r 2  20 rr rr             jsr ring_row                ; -> dst0
000017r 2  A5 rr                lda dt_tx                   ; + 4*tx chars = 32*tx bytes, which is 16 bit
000019r 2  85 rr                sta w16                     ; from tx = 8 on
00001Br 2  A9 00 85 rr          stz w16+1
00001Fr 2  A2 05                ldx #5
000021r 2  06 rr        :       asl w16
000023r 2  26 rr                rol w16+1
000025r 2  CA                   dex
000026r 2  D0 F9                bne :-
000028r 2  A5 rr                lda dst0
00002Ar 2  18                   clc
00002Br 2  65 rr                adc w16
00002Dr 2  85 rr                sta dst0
00002Fr 2  A5 rr                lda dst0+1
000031r 2  65 rr                adc w16+1
000033r 2  85 rr                sta dst0+1
000035r 2  20 rr rr             jsr fold0                   ; the columns can carry past the ring end
000038r 2  20 rr rr             jsr ring_next               ; dst1 = the char row below
00003Br 2  A2 00                ldx #0
00003Dr 2  86 rr                stx dt_i
00003Fr 2  A6 rr        @tile:  ldx dt_i
000041r 2  B5 rr                lda MAPBUF,x
000043r 2  20 rr rr             jsr draw_tile
000046r 2  A5 rr                lda dst0                    ; the next tile is four chars on
000048r 2  18                   clc
000049r 2  69 20                adc #32
00004Br 2  85 rr                sta dst0
00004Dr 2  90 02                bcc :+
00004Fr 2  E6 rr                inc dst0+1
000051r 2  20 rr rr     :       jsr fold0
000054r 2  A5 rr                lda dst1
000056r 2  18                   clc
000057r 2  69 20                adc #32
000059r 2  85 rr                sta dst1
00005Br 2  90 02                bcc :+
00005Dr 2  E6 rr                inc dst1+1
00005Fr 2  20 rr rr     :       jsr fold1
000062r 2  E6 rr                inc dt_i
000064r 2  A5 rr                lda dt_i
000066r 2  C5 rr                cmp dt_nx
000068r 2  D0 D5                bne @tile
00006Ar 2  E6 rr                inc dt_ty
00006Cr 2  C6 rr                dec dt_ny
00006Er 2  D0 90                bne @row
000070r 2  60                   rts
000071r 2               
000071r 2               ; copy_partial: compose the row section A shows.  It is the 80 chars above the
000071r 2               ; window, and holds lines wfine..7 of the window's first row in lines 0..7-wfine,
000071r 2               ; so the playfield can scroll in two-scanline steps.
000071r 2               copy_partial:
000071r 2  A5 rr                lda wfine
000073r 2  D0 01                bne :+
000075r 2  60                   rts
000076r 2               :
000076r 2  A5 rr                lda ringS                   ; source = the window's first char
000078r 2  85 rr                sta w16
00007Ar 2  A5 rr                lda ringS+1
00007Cr 2  85 rr                sta w16+1
00007Er 2  06 rr                asl w16
000080r 2  26 rr                rol w16+1
000082r 2  06 rr                asl w16
000084r 2  26 rr                rol w16+1
000086r 2  06 rr                asl w16
000088r 2  26 rr                rol w16+1
00008Ar 2  A5 rr                lda w16
00008Cr 2  18                   clc
00008Dr 2  65 rr                adc ringbase
00008Fr 2  85 rr                sta dst1                    ; dst1 is the source here, and carries the
000091r 2  A5 rr                lda w16+1                   ; wfine offset: a positive offset under 8 on an
000093r 2  65 rr                adc ringbase+1              ; 8-aligned pointer leaves its page crossings on
000095r 2  85 rr                sta dst1+1                  ; the char boundaries, so the fold still works
000097r 2  A5 rr                lda dst1                    ; destination = one row earlier, wrapped
000099r 2  38                   sec
00009Ar 2  E9 80                sbc #<ROWBYTES
00009Cr 2  85 rr                sta dst0
00009Er 2  A5 rr                lda dst1+1
0000A0r 2  E9 02                sbc #>ROWBYTES
0000A2r 2  85 rr                sta dst0+1
0000A4r 2  C5 rr                cmp ringbase+1              ; below the base: + RINGBYTES
0000A6r 2  B0 0D                bcs :+
0000A8r 2  A5 rr                lda dst0
0000AAr 2  18                   clc
0000ABr 2  69 80                adc #<RINGBYTES
0000ADr 2  85 rr                sta dst0
0000AFr 2  A5 rr                lda dst0+1
0000B1r 2  69 39                adc #>RINGBYTES
0000B3r 2  85 rr                sta dst0+1
0000B5r 2  A9 08        :       lda #8                      ; bytes per char = 8 - wfine
0000B7r 2  38                   sec
0000B8r 2  E5 rr                sbc wfine
0000BAr 2  85 rr                sta tmp2
0000BCr 2  A5 rr                lda dst1                    ; the source starts wfine lines into the row
0000BEr 2  18                   clc
0000BFr 2  65 rr                adc wfine
0000C1r 2  85 rr                sta dst1
0000C3r 2  90 02                bcc :+
0000C5r 2  E6 rr                inc dst1+1
0000C7r 2  A9 50        :       lda #ROWCHARS
0000C9r 2  85 rr                sta tmp
0000CBr 2  A0 00        @char:  ldy #0
0000CDr 2  B1 rr        @l:     lda (dst1),y
0000CFr 2  91 rr                sta (dst0),y
0000D1r 2  C8                   iny
0000D2r 2  C4 rr                cpy tmp2
0000D4r 2  D0 F7                bne @l
0000D6r 2  A5 rr                lda dst0                    ; next char in both
0000D8r 2  18                   clc
0000D9r 2  69 08                adc #8
0000DBr 2  85 rr                sta dst0
0000DDr 2  90 02                bcc :+
0000DFr 2  E6 rr                inc dst0+1
0000E1r 2  20 rr rr     :       jsr fold0
0000E4r 2  A5 rr                lda dst1
0000E6r 2  18                   clc
0000E7r 2  69 08                adc #8
0000E9r 2  85 rr                sta dst1
0000EBr 2  90 02                bcc :+
0000EDr 2  E6 rr                inc dst1+1
0000EFr 2  20 rr rr     :       jsr fold1
0000F2r 2  C6 rr                dec tmp
0000F4r 2  F0 03                beq :+
0000F6r 2  4C rr rr             jmp @char
0000F9r 2  60           :       rts
0000FAr 2               
0000FAr 2               ; fold0/fold1: bring a destination back inside the ring.  A row of the window is
0000FAr 2               ; 80 chars wherever it starts, so the columns of a tile row can run off the end.
0000FAr 2               fold0:
0000FAr 2  A5 rr                lda dst0+1
0000FCr 2  C5 rr                cmp ringehi
0000FEr 2  90 0D                bcc :+
000100r 2  A5 rr                lda dst0
000102r 2  38                   sec
000103r 2  E9 80                sbc #<RINGBYTES
000105r 2  85 rr                sta dst0
000107r 2  A5 rr                lda dst0+1
000109r 2  E9 39                sbc #>RINGBYTES
00010Br 2  85 rr                sta dst0+1
00010Dr 2  60           :       rts
00010Er 2               fold1:
00010Er 2  A5 rr                lda dst1+1
000110r 2  C5 rr                cmp ringehi
000112r 2  90 0D                bcc :+
000114r 2  A5 rr                lda dst1
000116r 2  38                   sec
000117r 2  E9 80                sbc #<RINGBYTES
000119r 2  85 rr                sta dst1
00011Br 2  A5 rr                lda dst1+1
00011Dr 2  E9 39                sbc #>RINGBYTES
00011Fr 2  85 rr                sta dst1+1
000121r 2  60           :       rts
000122r 2               
000122r 2               ; ring_row: A = char row -> dst0 = the address of its first char in the ring
000122r 2               ring_row:
000122r 2  AA                   tax
000123r 2  BD 00 80             lda RINGMODTAB,x            ; the slot
000126r 2  AA                   tax
000127r 2  B5 rr                lda RINGLO,x
000129r 2  85 rr                sta dst0
00012Br 2  B5 rr                lda RINGHI,x
00012Dr 2  85 rr                sta dst0+1
00012Fr 2  60                   rts
000130r 2               
000130r 2               ; ring_next: dst1 = dst0 + one char row, folded at the ring end
000130r 2               ring_next:
000130r 2  A5 rr                lda dst0
000132r 2  18                   clc
000133r 2  69 80                adc #<ROWBYTES
000135r 2  85 rr                sta dst1
000137r 2  A5 rr                lda dst0+1
000139r 2  69 02                adc #>ROWBYTES
00013Br 2  C5 rr                cmp ringehi
00013Dr 2  90 0B                bcc :+
00013Fr 2  48                   pha                         ; past the end: - RINGBYTES, which is not a
000140r 2  A5 rr                lda dst1                    ; whole number of pages
000142r 2  38                   sec
000143r 2  E9 80                sbc #<RINGBYTES
000145r 2  85 rr                sta dst1
000147r 2  68                   pla
000148r 2  E9 39                sbc #>RINGBYTES
00014Ar 2  85 rr        :       sta dst1+1
00014Cr 2  60                   rts
00014Dr 2               
00014Dr 2               ; draw_tile: A = tile id, dst0/dst1 = where its two char rows go
00014Dr 2               draw_tile:
00014Dr 2  C9 7F                cmp #EMPTYTILE              ; nothing to draw for a hole in the map
00014Fr 2  F0 30                beq @done
000151r 2  48                   pha
000152r 2  4A                   lsr
000153r 2  4A                   lsr
000154r 2  18                   clc
000155r 2  69 rr                adc #>TILES                 ; the tiles are page aligned: id*64 is
000157r 2  85 rr                sta tp+1                    ; (id >> 2) pages plus (id & 3) * 64
000159r 2  68                   pla
00015Ar 2  29 03                and #3
00015Cr 2  0A                   asl
00015Dr 2  0A                   asl
00015Er 2  0A                   asl
00015Fr 2  0A                   asl
000160r 2  0A                   asl
000161r 2  0A                   asl
000162r 2  85 rr                sta tp
000164r 2  A0 1F                ldy #31
000166r 2  B1 rr        :       lda (tp),y
000168r 2  91 rr                sta (dst0),y
00016Ar 2  88                   dey
00016Br 2  10 F9                bpl :-
00016Dr 2  A5 rr                lda tp
00016Fr 2  18                   clc
000170r 2  69 20                adc #32
000172r 2  85 rr                sta tp
000174r 2  90 02                bcc :+
000176r 2  E6 rr                inc tp+1
000178r 2  A0 1F        :       ldy #31
00017Ar 2  B1 rr        :       lda (tp),y
00017Cr 2  91 rr                sta (dst1),y
00017Er 2  88                   dey
00017Fr 2  10 F9                bpl :-
000181r 2  60           @done:  rts
000182r 2               
000182r 2                       .segment "TILDATA"
000000r 2                       .align 256
000000r 2  00 00 00 00  TILES:  .incbin "build/tiles.bin"
000004r 2  00 00 00 00  
000008r 2  00 00 00 00  
002000r 2               
002000r 1                       .include "bank4.s"
002000r 2               ; ============================================================================
002000r 2               ; Bank 4: the sprite images, their mask planes, the four MASKTABs and the
002000r 2               ; blitter.  Everything the inner loop touches is here, so a sprite is drawn
002000r 2               ; without a single bank switch; what crosses is one far call per erased
002000r 2               ; rectangle, into the tile blitter.
002000r 2               ; ============================================================================
002000r 2                       .segment "SPRCODE"
000000r 2               
000000r 2               .macro ringmod                      ; A = a map char row -> its ring slot
000000r 2                       tax
000000r 2                       lda RINGMODTAB,x
000000r 2               .endmacro
000000r 2               .macro ringup                       ; A = sp+1 just advanced: fold sp:A at the ring end
000000r 2                       .local done
000000r 2                       cmp ringehi
000000r 2                       bcc done
000000r 2                       pha                         ; the ring is 23 rows of 640, which is not a whole
000000r 2                       lda sp                      ; number of pages, so the low byte moves too
000000r 2                       sec
000000r 2                       sbc #<RINGBYTES
000000r 2                       sta sp
000000r 2                       pla
000000r 2                       sbc #>RINGBYTES
000000r 2               done:
000000r 2               .endmacro
000000r 2               .macro spnext                       ; the next char to the right, with the ring fold
000000r 2                       .local done
000000r 2                       lda sp
000000r 2                       clc
000000r 2                       adc #8
000000r 2                       sta sp
000000r 2                       bcc done
000000r 2                       lda sp+1
000000r 2                       inca
000000r 2                       ringup
000000r 2                       sta sp+1
000000r 2               done:
000000r 2               .endmacro
000000r 2               
000000r 2               ; sp = the address of char (w16, A) of the window's ring
000000r 2               ringaddr:
000000r 2  AA BD 00 80          ringmod
000004r 2  AA                   tax
000005r 2  A5 rr                lda w16+1
000007r 2  85 rr                sta sp+1
000009r 2  A5 rr                lda w16
00000Br 2  0A                   asl
00000Cr 2  26 rr                rol sp+1
00000Er 2  0A                   asl
00000Fr 2  26 rr                rol sp+1
000011r 2  0A                   asl
000012r 2  26 rr                rol sp+1                    ; sp+1:A = cx*8
000014r 2  18                   clc
000015r 2  75 rr                adc RINGLO,x
000017r 2  85 rr                sta sp
000019r 2  A5 rr                lda sp+1
00001Br 2  75 rr                adc RINGHI,x
00001Dr 2  C5 rr 90 0B          ringup
000021r 2  48 A5 rr 38  
000025r 2  E9 80 85 rr  
00002Cr 2  85 rr                sta sp+1
00002Er 2  60                   rts
00002Fr 2               
00002Fr 2  29 80        sext:   and #$80
000031r 2  F0 02                beq :+
000033r 2  A9 FF                lda #$FF
000035r 2  85 rr        :       sta tmp3
000037r 2  60                   rts
000038r 2               
000038r 2               ; ---------------------------------------------------------------- the pass
000038r 2               ; draw every sprite on the list, keeping a record of where each landed so the
000038r 2               ; next frame can erase it.
000038r 2               draw_sprites:
000038r 2  A5 rr                lda curbuf
00003Ar 2  F0 05                beq :+
00003Cr 2  A9 rr                lda #>(SPRREC + 10*MAXREC)
00003Er 2  4C rr rr             bra :++
000041r 2  A9 rr        :       lda #>SPRREC
000043r 2  85 rr        :       sta rp+1
000045r 2  A5 rr                lda curbuf
000047r 2  F0 05                beq :+
000049r 2  A9 rr                lda #<(SPRREC + 10*MAXREC)
00004Br 2  4C rr rr             bra :++
00004Er 2  A9 rr        :       lda #<SPRREC
000050r 2  85 rr        :       sta rp
000052r 2  A9 00                lda #0
000054r 2  85 rr                sta spi
000056r 2  A5 rr        @l:     lda spi
000058r 2  CD rr rr             cmp NSPR
00005Br 2  B0 50                bcs @done
00005Dr 2  C9 10                cmp #MAXREC
00005Fr 2  B0 4C                bcs @done
000061r 2  0A                   asl                         ; entry = SPRLIST + i*5
000062r 2  0A                   asl
000063r 2  18                   clc
000064r 2  65 rr                adc spi
000066r 2  A8                   tay
000067r 2  B9 rr rr             lda SPRLIST+1,y
00006Ar 2  85 rr                sta spx
00006Cr 2  B9 rr rr             lda SPRLIST+2,y
00006Fr 2  85 rr                sta spx+1
000071r 2  B9 rr rr             lda SPRLIST+3,y
000074r 2  85 rr                sta spy
000076r 2  B9 rr rr             lda SPRLIST+4,y
000079r 2  85 rr                sta spy+1
00007Br 2  B9 rr rr             lda SPRLIST,y
00007Er 2  A0 00                ldy #0
000080r 2  91 rr                sta (rp),y                  ; the record is id, map position, then the
000082r 2  A5 rr                lda spx                     ; rectangle drawsprite works out
000084r 2  C8                   iny
000085r 2  91 rr                sta (rp),y
000087r 2  A5 rr                lda spx+1
000089r 2  C8                   iny
00008Ar 2  91 rr                sta (rp),y
00008Cr 2  A5 rr                lda spy
00008Er 2  C8                   iny
00008Fr 2  91 rr                sta (rp),y
000091r 2  A5 rr                lda spy+1
000093r 2  C8                   iny
000094r 2  91 rr                sta (rp),y
000096r 2  A0 00                ldy #0
000098r 2  B1 rr                lda (rp),y
00009Ar 2  20 rr rr             jsr drawsprite
00009Dr 2  A5 rr                lda rp
00009Fr 2  18                   clc
0000A0r 2  69 0A                adc #10
0000A2r 2  85 rr                sta rp
0000A4r 2  90 02                bcc :+
0000A6r 2  E6 rr                inc rp+1
0000A8r 2  E6 rr        :       inc spi
0000AAr 2  4C rr rr             bra @l
0000ADr 2  A6 rr        @done:  ldx curbuf
0000AFr 2  A5 rr                lda spi
0000B1r 2  9D rr rr             sta RECCNT,x
0000B4r 2  A9 00                lda #0
0000B6r 2  8D rr rr             sta NSPR                    ; the logic fills the list again next frame
0000B9r 2  60                   rts
0000BAr 2               
0000BAr 2               ; ---------------------------------------------------------------- erase
0000BAr 2               ; put the tiles back where this buffer's sprites were two frames ago.  The
0000BAr 2               ; record is in chars; the tile blitter wants tiles, so round outwards.
0000BAr 2               erase_old:
0000BAr 2  A6 rr                ldx curbuf
0000BCr 2  BD rr rr             lda RECCNT,x
0000BFr 2  F0 72                beq @done
0000C1r 2  85 rr                sta tmp4
0000C3r 2  A5 rr                lda curbuf
0000C5r 2  F0 05                beq :+
0000C7r 2  A9 rr                lda #>(SPRREC + 10*MAXREC)
0000C9r 2  4C rr rr             bra :++
0000CCr 2  A9 rr        :       lda #>SPRREC
0000CEr 2  85 rr        :       sta rp+1
0000D0r 2  A5 rr                lda curbuf
0000D2r 2  F0 05                beq :+
0000D4r 2  A9 rr                lda #<(SPRREC + 10*MAXREC)
0000D6r 2  4C rr rr             bra :++
0000D9r 2  A9 rr        :       lda #<SPRREC
0000DBr 2  85 rr        :       sta rp
0000DDr 2  A0 05        @l:     ldy #5
0000DFr 2  B1 rr                lda (rp),y                  ; cx low (the high byte only matters past 255
0000E1r 2  4A                   lsr                         ; chars, which no window reaches)
0000E2r 2  4A                   lsr
0000E3r 2  85 rr                sta dt_tx
0000E5r 2  A0 07                ldy #7
0000E7r 2  B1 rr                lda (rp),y                  ; cy
0000E9r 2  4A                   lsr
0000EAr 2  85 rr                sta dt_ty
0000ECr 2  A0 05                ldy #5
0000EEr 2  B1 rr                lda (rp),y
0000F0r 2  29 03                and #3                      ; the columns the rounding down left out
0000F2r 2  85 rr                sta tmp2
0000F4r 2  A0 08                ldy #8
0000F6r 2  B1 rr                lda (rp),y                  ; w in chars
0000F8r 2  18                   clc
0000F9r 2  65 rr                adc tmp2
0000FBr 2  69 03                adc #3
0000FDr 2  4A                   lsr
0000FEr 2  4A                   lsr
0000FFr 2  85 rr                sta dt_nx
000101r 2  A0 07                ldy #7
000103r 2  B1 rr                lda (rp),y
000105r 2  29 01                and #1
000107r 2  85 rr                sta tmp2
000109r 2  A0 09                ldy #9
00010Br 2  B1 rr                lda (rp),y                  ; h in rows, bit 7 = it was clipped
00010Dr 2  29 7F                and #$7F
00010Fr 2  18                   clc
000110r 2  65 rr                adc tmp2
000112r 2  69 01                adc #1
000114r 2  4A                   lsr
000115r 2  85 rr                sta dt_ny
000117r 2  A5 rr                lda dt_nx
000119r 2  F0 09                beq @next
00011Br 2  A5 rr                lda dt_ny
00011Dr 2  F0 05                beq @next
00011Fr 2  A2 0C 20 rr          farjsr F_DRAWRECT
000123r 2  rr           
000124r 2  A5 rr        @next:  lda rp
000126r 2  18                   clc
000127r 2  69 0A                adc #10
000129r 2  85 rr                sta rp
00012Br 2  90 02                bcc :+
00012Dr 2  E6 rr                inc rp+1
00012Fr 2  C6 rr        :       dec tmp4
000131r 2  D0 AA                bne @l
000133r 2  60           @done:  rts
000134r 2               
000134r 2               ; ---------------------------------------------------------------- tables
000134r 2               ; MASKTABk[x] is the AND mask for the column of phase k in mask byte x: the
000134r 2               ; blitter indexes by the whole byte and never shifts.
000134r 2               init_masks:
000134r 2  A9 00                lda #0                      ; the bank's variables come up undefined
000136r 2  8D rr rr             sta NSPR
000139r 2  8D rr rr             sta RECCNT
00013Cr 2  8D rr rr             sta RECCNT+1
00013Fr 2  A2 00                ldx #0
000141r 2  8A           @mt:    txa
000142r 2  4A                   lsr
000143r 2  4A                   lsr
