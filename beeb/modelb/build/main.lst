000100r 1                       .include "low.s"
000100r 2               ; ============================================================================
000100r 2               ; Main RAM, $0140-$02FF.  Everything here is visible whatever bank is paged in:
000100r 2               ; the interrupt handler, the section table it reads, the far-call thunk, and the
000100r 2               ; buffer a bank copies a strip of its data into for another bank to read.
000100r 2               ; ============================================================================
000100r 2                       .segment "LOWCODE"
000000r 2               
000000r 2               ; ---------------------------------------------------------------- far calls
000000r 2               ; X = the index of a (bank, address) entry.  The caller's bank comes back from the
000000r 2               ; stack, so a bank may call one that replaces it, and a call may nest.
000000r 2               farcall:
000000r 2  85 rr                sta fc_a                    ; A is an argument and a result, so it travels
000002r 2  A5 F4                lda ROMSEL_CPY              ; around the bank switch on both legs
000004r 2  48                   pha
000005r 2  BD rr rr             lda FARTAB+1,x
000008r 2  8D rr rr             sta @j+1
00000Br 2  BD rr rr             lda FARTAB+2,x
00000Er 2  8D rr rr             sta @j+2
000011r 2  BD rr rr             lda FARTAB,x
000014r 2  85 F4                sta ROMSEL_CPY
000016r 2  8D 30 FE             sta ROMSEL
000019r 2  A5 rr                lda fc_a
00001Br 2  20 FF FF     @j:     jsr $FFFF
00001Er 2  85 rr                sta fc_a
000020r 2  68                   pla
000021r 2  85 F4                sta ROMSEL_CPY
000023r 2  8D 30 FE             sta ROMSEL
000026r 2  A5 rr                lda fc_a
000028r 2  60                   rts
000029r 2               
000029r 2               ; ---------------------------------------------------------------- map peek
000029r 2               ; The logic reads single map bytes with this: ptr/Y address the map in bank 6 and
000029r 2               ; the routine is in main RAM, so only the data is far away.  31 cycles.
000029r 2               mapbyte:
000029r 2  A9 06                lda #BANK_MAP
00002Br 2  85 F4                sta ROMSEL_CPY
00002Dr 2  8D 30 FE             sta ROMSEL
000030r 2  B1 rr                lda (w16b),y
000032r 2  A2 07                ldx #BANK_LGC
000034r 2  86 F4                stx ROMSEL_CPY
000036r 2  8E 30 FE             stx ROMSEL
000039r 2  60                   rts
00003Ar 2               
00003Ar 2               ; ---------------------------------------------------------------- interrupts
00003Ar 2               irq_handler:
00003Ar 2  86 rr                stx irq_x
00003Cr 2  84 rr                sty irq_y
00003Er 2  2C 4D FE             bit VIA_IFR
000041r 2  70 03                bvs @t1arm
000043r 2  4C rr rr             jmp @notT1
000046r 2               @t1arm: ; A rupture step is a CRTC restart: R12/R13 were armed during the section
000046r 2                       ; before and latch at the boundary; R9 with R4 decide where the section ends
000046r 2                       ; and are compared at the start of its last scanline, and R6 from scanline 1
000046r 2                       ; on.  The chain is phased so the step fires ~60 cycles BEFORE the restart,
000046r 2                       ; and the hold below carries the first write past it.
000046r 2  A6 rr                ldx SECIDX
000048r 2  A0 05                ldy #5
00004Ar 2  88           @hold:  dey
00004Br 2  D0 FD                bne @hold
00004Dr 2  A9 09                lda #9
00004Fr 2  8D 00 FE             sta CRTC_IDX
000052r 2  BD rr rr             lda SECTAB+3,x
000055r 2  8D 01 FE             sta CRTC_DAT
000058r 2  A9 04                lda #4
00005Ar 2  8D 00 FE             sta CRTC_IDX
00005Dr 2  BD rr rr             lda SECTAB+2,x
000060r 2  8D 01 FE             sta CRTC_DAT
000063r 2  A9 06                lda #6
000065r 2  8D 00 FE             sta CRTC_IDX
000068r 2  BD rr rr             lda SECTAB+4,x
00006Br 2  8D 01 FE             sta CRTC_DAT
00006Er 2  A9 07                lda #7
000070r 2  8D 00 FE             sta CRTC_IDX
000073r 2  BD rr rr             lda SECTAB+5,x
000076r 2  8D 01 FE             sta CRTC_DAT
000079r 2  85 rr                sta curR7
00007Br 2  A9 0C                lda #12
00007Dr 2  8D 00 FE             sta CRTC_IDX
000080r 2  BD rr rr             lda SECTAB,x
000083r 2  8D 01 FE             sta CRTC_DAT
000086r 2  A9 0D                lda #13
000088r 2  8D 00 FE             sta CRTC_IDX
00008Br 2  BD rr rr             lda SECTAB+1,x
00008Er 2  8D 01 FE             sta CRTC_DAT
000091r 2  BD rr rr             lda SECTAB+6,x
000094r 2  8D 46 FE             sta VIA_T1LL
000097r 2  BD rr rr             lda SECTAB+7,x
00009Ar 2  8D 47 FE             sta VIA_T1LH
00009Dr 2  AD 44 FE             lda VIA_T1CL                ; clear the T1 flag
0000A0r 2  A5 rr                lda curR7                   ; the chain stops at Q, the only section whose R7
0000A2r 2  C9 08                cmp #QVSYNC                 ; is the vsync row: a late vsync must not walk it
0000A4r 2  F0 06                beq @stay                   ; off the end of SECTAB
0000A6r 2  8A                   txa
0000A7r 2  18                   clc
0000A8r 2  69 08                adc #8
0000AAr 2  85 rr                sta SECIDX
0000ACr 2  A4 rr        @stay:  ldy irq_y
0000AEr 2  A6 rr                ldx irq_x
0000B0r 2  A5 FC                lda $FC
0000B2r 2  40                   rti
0000B3r 2               
0000B3r 2               @notT1:
0000B3r 2  AD 4D FE             lda VIA_IFR
0000B6r 2  29 02                and #$02
0000B8r 2  F0 05                beq @exit
0000BAr 2                       ; ---- vsync.  The T1 re-phase, the flip and section 0 all have the 64 lines
0000BAr 2                       ; between the vsync and the bar to happen in, so they live in bank 7 and this
0000BAr 2                       ; pays 63 cycles to reach them -- main RAM is 448 bytes and the step above is
0000BAr 2                       ; the only part of the chain that cannot afford to be anywhere else.
0000BAr 2  A2 00 20 rr          farjsr F_VSYNC
0000BEr 2  rr           
0000BFr 2               @exit:
0000BFr 2  A4 rr                ldy irq_y
0000C1r 2  A6 rr                ldx irq_x
0000C3r 2  A5 FC                lda $FC
0000C5r 2  40                   rti
0000C6r 2               
0000C6r 2                       .segment "LOWBSS"
000000r 2  xx xx xx xx  SECTAB:     .res 2*48               ; per buffer: 6 sections x 8 bytes
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000060r 2  xx xx xx xx  FARTAB:     .res 3*NFAR             ; (bank, lo, hi) per far entry point
000064r 2  xx xx xx xx  
000068r 2  xx xx xx xx  
00008Dr 2               
00008Dr 1                       .include "bank7.s"
00008Dr 2               ; ============================================================================
00008Dr 2               ; Bank 7: the game logic, the frame loop, and the chain the CRTC is driven by.
00008Dr 2               ; Bank 7 is the one the loader leaves paged in, so $8000 is the entry vector.
00008Dr 2               ; ============================================================================
00008Dr 2                       .segment "LGCCODE"
000000r 2  4C rr rr     entry:  jmp init
000003r 2               
000003r 2               ; ---------------------------------------------------------------- start up
000003r 2               init:
000003r 2  A2 3F                ldx #$3F                    ; the stack is 64 bytes: $0100-$013F
000005r 2  9A                   txs
000006r 2  A9 00                lda #0                      ; the OS left its own variables here; $F0-$FF is
000008r 2  A2 00                ldx #0                      ; left alone ($F4 is the bank the loader selected,
00000Ar 2  95 00        :       sta $00,x                   ; and the OS IRQ still restores from it until
00000Cr 2  E8                   inx                         ; take_over).  Counting up: $EF is negative, so a
00000Dr 2  E0 F0                cpx #$F0                    ; dex/bpl loop would stop after one store
00000Fr 2  D0 F9                bne :-
000011r 2                       ; the main-RAM image travels in bank 7 and is copied down to $0140
000011r 2  A9 rr                lda #<__LOWCODE_LOAD__
000013r 2  85 rr                sta w16
000015r 2  A9 rr                lda #>__LOWCODE_LOAD__
000017r 2  85 rr                sta w16+1
000019r 2  A9 rr                lda #<__LOWCODE_RUN__
00001Br 2  85 rr                sta w16b
00001Dr 2  A9 rr                lda #>__LOWCODE_RUN__
00001Fr 2  85 rr                sta w16b+1
000021r 2  A0 00                ldy #0
000023r 2  A2 rr                ldx #>(__LOWCODE_SIZE__ + 255)
000025r 2  B1 rr        @lc:    lda (w16),y
000027r 2  91 rr                sta (w16b),y
000029r 2  C8                   iny
00002Ar 2  D0 F9                bne @lc
00002Cr 2  E6 rr                inc w16+1
00002Er 2  E6 rr                inc w16b+1
000030r 2  CA                   dex
000031r 2  D0 F2                bne @lc
000033r 2  20 rr rr             jsr init_far
000036r 2  A2 24 20 rr          farjsr F_SPRINIT            ; the MASKTABs, and the directory's pointers
00003Ar 2  rr           
00003Br 2  20 rr rr             jsr clear_screen
00003Er 2  A9 00                lda #0                      ; a bank's .res is not cleared by loading it
000040r 2  8D rr rr             sta bvalid
000043r 2  8D rr rr             sta bvalid+1
000046r 2  8D rr rr             sta bptx
000049r 2  8D rr rr             sta bptx+1
00004Cr 2  8D rr rr             sta bpty
00004Fr 2  8D rr rr             sta bpty+1
000052r 2  85 rr                sta onground
000054r 2  85 rr                sta facing
000056r 2  85 rr                sta anim
000058r 2  85 rr                sta vy
00005Ar 2  85 rr                sta vy+1
00005Cr 2  20 rr rr             jsr fetch_objs
00005Fr 2  A9 68                lda #<(STARTX*8)            ; Cleo starts where the level says
000061r 2  85 rr                sta px
000063r 2  A9 00                lda #>(STARTX*8)
000065r 2  85 rr                sta px+1
000067r 2  A9 E0                lda #<(STARTY*8)
000069r 2  85 rr                sta py
00006Br 2  A9 00                lda #>(STARTY*8)
00006Dr 2  85 rr                sta py+1
00006Fr 2  20 rr rr             jsr camera
000072r 2  20 rr rr             jsr win_px
000075r 2  20 rr rr             jsr calc_ring
000078r 2  A9 00                lda #0
00007Ar 2  85 rr                sta curbuf
00007Cr 2  20 rr rr             jsr select_backbuf
00007Fr 2  20 rr rr             jsr scroll_validate
000082r 2  20 rr rr             jsr mirror_copy
000085r 2  A9 01                lda #1
000087r 2  85 rr                sta curbuf
000089r 2  20 rr rr             jsr select_backbuf
00008Cr 2  20 rr rr             jsr scroll_validate
00008Fr 2  20 rr rr             jsr mirror_copy
000092r 2  20 rr rr             jsr bar_pattern
000095r 2  A9 00                lda #0
000097r 2  85 rr                sta curbuf
000099r 2  85 rr                sta DISPSECT
00009Br 2  85 rr                sta NEXTSECT
00009Dr 2  85 rr                sta SECIDX                  ; the chain starts at the bar; the first vsync
00009Fr 2  85 rr                sta wcx                     ; re-phases everything
0000A1r 2  85 rr                sta wcx+1
0000A3r 2  85 rr                sta wcy
0000A5r 2  85 rr                sta wfine
0000A7r 2  85 rr                sta frame
0000A9r 2  A9 39                lda #<VS2T_DEFAULT
0000ABr 2  85 rr                sta VS2T
0000ADr 2  A9 0F                lda #>VS2T_DEFAULT
0000AFr 2  85 rr                sta VS2T+1
0000B1r 2  20 rr rr             jsr select_backbuf
0000B4r 2  20 rr rr             jsr calc_ring
0000B7r 2  20 rr rr             jsr build_sections          ; buffer 0's chain, before anything can display it
0000BAr 2  20 rr rr             jsr set_palette
0000BDr 2  20 rr rr             jsr crtc_init
0000C0r 2  20 rr rr             jsr take_over
0000C3r 2                       ; ---------------------------------------------------------------- loop
0000C3r 2               frame_top:
0000C3r 2  E6 rr                inc frame
0000C5r 2  20 rr rr             jsr player_step
0000C8r 2  20 rr rr             jsr camera
0000CBr 2  20 rr rr             jsr win_px
0000CEr 2  20 rr rr             jsr calc_ring
0000D1r 2  20 rr rr             jsr scroll_validate
0000D4r 2  A2 18 20 rr          farjsr F_ERASE              ; put tiles back where this buffer's sprites were
0000D8r 2  rr           
0000D9r 2  20 rr rr             jsr queue_sprites
0000DCr 2  A2 15 20 rr          farjsr F_DRAWSPR
0000E0r 2  rr           
0000E1r 2  A2 1B 20 rr          farjsr F_PARTIAL            ; the fine-scroll row, from what was just drawn
0000E5r 2  rr           
0000E6r 2  20 rr rr             jsr mirror_copy             ; and the ring's last row, for the straddle
0000E9r 2  20 rr rr             jsr build_sections
0000ECr 2  A5 rr                lda curbuf
0000EEr 2  F0 02                beq :+
0000F0r 2  A9 30                lda #48
0000F2r 2  85 rr        :       sta NEXTSECT
0000F4r 2  A9 01                lda #1
0000F6r 2  85 rr                sta flipreq
0000F8r 2  A5 rr        :       lda flipreq
0000FAr 2  D0 FC                bne :-
0000FCr 2  A5 rr                lda curbuf
0000FEr 2  49 01                eor #1
000100r 2  85 rr                sta curbuf
000102r 2  20 rr rr             jsr select_backbuf
000105r 2  4C rr rr             jmp frame_top
000108r 2               
000108r 2               ; ---------------------------------------------------------------- vsync
000108r 2               ; Reached from the interrupt handler in main RAM, 64 lines before the bar.
000108r 2               vsync_tick:
000108r 2  A5 rr                lda VS2T                    ; restart T1 first, for constant latency
00010Ar 2  8D 46 FE             sta VIA_T1LL
00010Dr 2  A5 rr                lda VS2T+1
00010Fr 2  8D 45 FE             sta VIA_T1CH
000112r 2  A9 02                lda #$02
000114r 2  8D 4D FE             sta VIA_IFR
000117r 2  A9 09                lda #9                      ; re-phase: end this frame curR7 + (QROWS-1-QVSYNC)
000119r 2  8D 00 FE             sta CRTC_IDX                ; rows from the vsync, whatever the row counter did
00011Cr 2  A9 07                lda #7
00011Er 2  8D 01 FE             sta CRTC_DAT
000121r 2  A9 06                lda #6                      ; pre-arm the bar's R6 here in Q, where the display
000123r 2  8D 00 FE             sta CRTC_IDX                ; is off and a new R6 cannot show
000126r 2  A9 02                lda #BARROWS
000128r 2  8D 01 FE             sta CRTC_DAT
00012Br 2  A9 04                lda #4
00012Dr 2  8D 00 FE             sta CRTC_IDX
000130r 2  A5 rr                lda curR7
000132r 2  18                   clc
000133r 2  69 07                adc #QROWS-1-QVSYNC
000135r 2  29 7F                and #$7F
000137r 2  8D 01 FE             sta CRTC_DAT
00013Ar 2  E6 rr                inc vsyncs
00013Cr 2  A5 rr                lda flipreq
00013Er 2  F0 15                beq @noflip
000140r 2  A5 rr                lda vsyncs
000142r 2  38                   sec
000143r 2  E5 rr                sbc flipvs
000145r 2  C9 02                cmp #2
000147r 2  90 0C                bcc @noflip
000149r 2  A5 rr                lda vsyncs
00014Br 2  85 rr                sta flipvs
00014Dr 2  A5 rr                lda NEXTSECT
00014Fr 2  85 rr                sta DISPSECT
000151r 2  A9 00 85 rr          stz flipreq
000155r 2               @noflip:
000155r 2  A2 00                ldx #0                      ; section 0 is the bar: its address and length come
000157r 2  A4 rr                ldy DISPSECT                ; from the buffer about to be displayed
000159r 2  F0 02                beq :+
00015Br 2  A2 02                ldx #2
00015Dr 2  B5 rr        :       lda BUF_SEC0T1,x
00015Fr 2  8D 46 FE             sta VIA_T1LL
000162r 2  B5 rr                lda BUF_SEC0T1+1,x
000164r 2  8D 47 FE             sta VIA_T1LH
000167r 2  A9 0C                lda #12
000169r 2  8D 00 FE             sta CRTC_IDX
00016Cr 2  B5 rr                lda BUF_SEC0,x
00016Er 2  8D 01 FE             sta CRTC_DAT
000171r 2  A9 0D                lda #13
000173r 2  8D 00 FE             sta CRTC_IDX
000176r 2  B5 rr                lda BUF_SEC0+1,x
000178r 2  8D 01 FE             sta CRTC_DAT
00017Br 2  A9 40                lda #$40
00017Dr 2  8D 4D FE             sta VIA_IFR
000180r 2  84 rr                sty SECIDX
000182r 2  60                   rts
000183r 2               
000183r 2               ; the (bank, address) table the thunk in main RAM indexes
000183r 2               init_far:
000183r 2  A2 2C                ldx #3*NFAR-1
000185r 2  BD rr rr     :       lda @src,x
000188r 2  9D rr rr             sta FARTAB,x
00018Br 2  CA                   dex
00018Cr 2  10 F7                bpl :-
00018Er 2  60                   rts
00018Fr 2  07 rr rr     @src:   .byte BANK_LGC, <vsync_tick, >vsync_tick
000192r 2  07 rr rr             .byte BANK_LGC, <vsync_tick, >vsync_tick    ; F_SCANKEYS, not yet
000195r 2  07 rr rr             .byte BANK_LGC, <vsync_tick, >vsync_tick    ; F_SNDTICK, not yet
000198r 2  06 rr rr             .byte BANK_MAP, <map_strip, >map_strip
00019Br 2  05 rr rr             .byte BANK_TIL, <draw_maprect, >draw_maprect
00019Er 2  05 00 00             .byte BANK_TIL, 0, 0
0001A1r 2  05 00 00             .byte BANK_TIL, 0, 0
0001A4r 2  04 rr rr             .byte BANK_SPR, <draw_sprites, >draw_sprites
0001A7r 2  04 rr rr             .byte BANK_SPR, <erase_old, >erase_old
0001AAr 2  05 rr rr             .byte BANK_TIL, <copy_partial, >copy_partial
0001ADr 2  05 00 00             .byte BANK_TIL, 0, 0
0001B0r 2  04 rr rr             .byte BANK_SPR, <addsprite, >addsprite
0001B3r 2  04 rr rr             .byte BANK_SPR, <init_masks, >init_masks
0001B6r 2  06 rr rr             .byte BANK_MAP, <alt_row, >alt_row
0001B9r 2  06 rr rr             .byte BANK_MAP, <map_copy, >map_copy
0001BCr 2               
0001BCr 2               ; wx/wy from the char window: a char is two game pixels across and a char row is
0001BCr 2               ; four down, with wfine the two-scanline remainder.
0001BCr 2               win_px:
0001BCr 2  A5 rr                lda wcx
0001BEr 2  0A                   asl
0001BFr 2  85 rr                sta wx
0001C1r 2  A5 rr                lda wcx+1
0001C3r 2  2A                   rol
0001C4r 2  85 rr                sta wx+1
0001C6r 2  A5 rr                lda wcy                     ; a char row is four game pixels
0001C8r 2  85 rr                sta wy
0001CAr 2  A9 00                lda #0
0001CCr 2  85 rr                sta wy+1
0001CEr 2  06 rr                asl wy
0001D0r 2  26 rr                rol wy+1
0001D2r 2  06 rr                asl wy
0001D4r 2  26 rr                rol wy+1
0001D6r 2  A5 rr                lda wfine
0001D8r 2  4A                   lsr
0001D9r 2  18                   clc
0001DAr 2  65 rr                adc wy
0001DCr 2  85 rr                sta wy
0001DEr 2  90 02                bcc :+
0001E0r 2  E6 rr                inc wy+1
0001E2r 2  60           :       rts
0001E3r 2               
0001E3r 2               ; ---------------------------------------------------------------- tables
0001E3r 2               ; select_backbuf: point the ring tables, the fold and the CRTC base at curbuf
0001E3r 2               select_backbuf:
0001E3r 2  A5 rr                lda curbuf
0001E5r 2  F0 17                beq @a
0001E7r 2  A9 80                lda #<RING_B
0001E9r 2  85 rr                sta ringbase
0001EBr 2  A9 46                lda #>RING_B
0001EDr 2  85 rr                sta ringbase+1
0001EFr 2  A9 80                lda #>RINGEND_B
0001F1r 2  85 rr                sta ringehi
0001F3r 2  A9 D0                lda #<CRTCB_B
0001F5r 2  85 rr                sta crtcb
0001F7r 2  A9 08                lda #>CRTCB_B
0001F9r 2  85 rr                sta crtcb+1
0001FBr 2  4C rr rr             bra @tab
0001FEr 2  A9 80        @a:     lda #<RING_A
000200r 2  85 rr                sta ringbase
000202r 2  A9 0A                lda #>RING_A
000204r 2  85 rr                sta ringbase+1
000206r 2  A9 44                lda #>RINGEND_A
000208r 2  85 rr                sta ringehi
00020Ar 2  A9 50                lda #<CRTCB_A
00020Cr 2  85 rr                sta crtcb
00020Er 2  A9 01                lda #>CRTCB_A
000210r 2  85 rr                sta crtcb+1
000212r 2  A5 rr        @tab:   lda crtcb                   ; the mirror redirect is the same add with the ring
000214r 2  38                   sec                         ; subtracted: crtcb - RINGCHARS
000215r 2  E9 30                sbc #<RINGCHARS
000217r 2  85 rr                sta crtcbm
000219r 2  A5 rr                lda crtcb+1
00021Br 2  E9 07                sbc #>RINGCHARS
00021Dr 2  85 rr                sta crtcbm+1
00021Fr 2  A5 rr                lda ringbase
000221r 2  85 rr                sta w16
000223r 2  A5 rr                lda ringbase+1
000225r 2  85 rr                sta w16+1
000227r 2  A2 00                ldx #0
000229r 2  A5 rr        @rt:    lda w16
00022Br 2  95 rr                sta RINGLO,x
00022Dr 2  A5 rr                lda w16+1
00022Fr 2  95 rr                sta RINGHI,x
000231r 2  A5 rr                lda w16
000233r 2  18                   clc
000234r 2  69 80                adc #<ROWBYTES
000236r 2  85 rr                sta w16
000238r 2  A5 rr                lda w16+1
00023Ar 2  69 02                adc #>ROWBYTES
00023Cr 2  85 rr                sta w16+1
00023Er 2  E8                   inx
00023Fr 2  E0 17                cpx #RINGROWS
000241r 2  D0 E6                bne @rt
000243r 2  60                   rts
000244r 2               
000244r 2               ; calc_ring: ringS = ((wcy mod RINGROWS) * 80 + wcx) mod RINGCHARS ; barq = ringS / 80
000244r 2               calc_ring:
000244r 2  A6 rr                ldx wcy
000246r 2  BD 00 80             lda RINGMODTAB,x
000249r 2  AA                   tax
00024Ar 2  BD rr rr             lda mulrowlo,x
00024Dr 2  18                   clc
00024Er 2  65 rr                adc wcx
000250r 2  85 rr                sta ringS
000252r 2  BD rr rr             lda mulrowhi,x
000255r 2  65 rr                adc wcx+1
000257r 2  85 rr                sta ringS+1
000259r 2  C9 07                cmp #>RINGCHARS
00025Br 2  90 15                bcc :++
00025Dr 2  D0 06                bne :+
00025Fr 2  A5 rr                lda ringS
000261r 2  C9 30                cmp #<RINGCHARS
000263r 2  90 0D                bcc :++
000265r 2  A5 rr        :       lda ringS
000267r 2  38                   sec
000268r 2  E9 30                sbc #<RINGCHARS
00026Ar 2  85 rr                sta ringS
00026Cr 2  A5 rr                lda ringS+1
00026Er 2  E9 07                sbc #>RINGCHARS
000270r 2  85 rr                sta ringS+1
000272r 2  A5 rr        :       lda ringS                   ; q = S / 80 by repeated subtraction: 23 at most
000274r 2  A4 rr                ldy ringS+1
000276r 2  A2 FF                ldx #$FF
000278r 2  38                   sec
000279r 2  E8           @div:   inx
00027Ar 2  E9 50                sbc #ROWCHARS
00027Cr 2  B0 FB                bcs @div
00027Er 2  38                   sec
00027Fr 2  88                   dey
000280r 2  10 F7                bpl @div
000282r 2  86 rr                stx barq
000284r 2  60                   rts
000285r 2               
000285r 2               ; ---------------------------------------------------------------- the chain
000285r 2               ; entry i: R12n, R13n, R4, R9, R6, R7, T1lo, T1hi.  The shape is section i's; the
000285r 2               ; address and duration are section i+1's, because R12/R13 latch at the next restart
000285r 2               ; and the T1 latch takes effect one interrupt later.
000285r 2               build_sections:
000285r 2  A5 rr                lda curbuf
000287r 2  0A                   asl
000288r 2  AA                   tax
000289r 2  A9 00                lda #>BARCRTC               ; section 0 is the bar: fixed address and length
00028Br 2  95 rr                sta BUF_SEC0,x
00028Dr 2  A9 60                lda #<BARCRTC
00028Fr 2  95 rr                sta BUF_SEC0+1,x
000291r 2  A9 FE                lda #<(BARROWS*8*LINE-2)
000293r 2  95 rr                sta BUF_SEC0T1,x
000295r 2  A9 03                lda #>(BARROWS*8*LINE-2)
000297r 2  95 rr                sta BUF_SEC0T1+1,x
000299r 2  A6 rr                ldx curbuf
00029Br 2  F0 02                beq :+
00029Dr 2  A2 30                ldx #48
00029Fr 2  A9 01        :       lda #BARROWS-1
0002A1r 2  9D rr rr             sta SECTAB+2,x
0002A4r 2  A9 07                lda #7
0002A6r 2  9D rr rr             sta SECTAB+3,x
0002A9r 2  A9 02                lda #BARROWS
0002ABr 2  9D rr rr             sta SECTAB+4,x
0002AEr 2  A9 1E                lda #30
0002B0r 2  9D rr rr             sta SECTAB+5,x
0002B3r 2  A5 rr                lda wfine
0002B5r 2  F0 6C                beq @coarse
0002B7r 2                       ; ---- f > 0: T -> A (the composed row) -> P.. -> P2 -> Q
0002B7r 2  49 07                eor #7
0002B9r 2  18 69 01             inca                        ; 8-f lines of it
0002BCr 2  20 rr rr             jsr @dur
0002BFr 2  9D rr rr             sta SECTAB+6,x
0002C2r 2  A5 rr                lda tmp3
0002C4r 2  9D rr rr             sta SECTAB+7,x
0002C7r 2  A5 rr                lda ringS                   ; the composed row is the 80 chars above the window
0002C9r 2  38                   sec
0002CAr 2  E9 50                sbc #<ROWCHARS
0002CCr 2  85 rr                sta w16
0002CEr 2  A5 rr                lda ringS+1
0002D0r 2  E9 00                sbc #0
0002D2r 2  85 rr                sta w16+1
0002D4r 2  10 0D                bpl :+
0002D6r 2  A5 rr                lda w16
0002D8r 2  18                   clc
0002D9r 2  69 30                adc #<RINGCHARS
0002DBr 2  85 rr                sta w16
0002DDr 2  A5 rr                lda w16+1
0002DFr 2  69 07                adc #>RINGCHARS
0002E1r 2  85 rr                sta w16+1
0002E3r 2  20 rr rr     :       jsr @addr
0002E6r 2  8A                   txa
0002E7r 2  18                   clc
0002E8r 2  69 08                adc #8
0002EAr 2  AA                   tax                         ; A's entry
0002EBr 2  A9 00 9D rr          stz SECTAB+2,x
0002EFr 2  rr           
0002F0r 2  A5 rr                lda wfine
0002F2r 2  49 07                eor #7                      ; 7 - f
0002F4r 2  9D rr rr             sta SECTAB+3,x
0002F7r 2  A9 02                lda #2
0002F9r 2  9D rr rr             sta SECTAB+4,x
0002FCr 2  A9 1E                lda #30
0002FEr 2  9D rr rr             sta SECTAB+5,x
000301r 2  A5 rr                lda ringS                   ; the run starts one row into the window
000303r 2  18                   clc
000304r 2  69 50                adc #<ROWCHARS
000306r 2  85 rr                sta w16
000308r 2  A5 rr                lda ringS+1
00030Ar 2  69 00                adc #0
00030Cr 2  85 rr                sta w16+1
00030Er 2  20 rr rr             jsr @wrap
000311r 2  A9 14                lda #VISROWS-1
000313r 2  85 rr                sta tmp4                    ; rows in the run
000315r 2  A4 rr                ldy barq
000317r 2  C8                   iny
000318r 2  C0 17                cpy #RINGROWS
00031Ar 2  90 02                bcc :+
00031Cr 2  A0 00                ldy #0
00031Er 2  84 rr        :       sty tmp3
000320r 2  4C rr rr             bra @run
000323r 2               @coarse:                            ; ---- f = 0: T -> P.. -> Q
000323r 2  A5 rr                lda ringS
000325r 2  85 rr                sta w16
000327r 2  A5 rr                lda ringS+1
000329r 2  85 rr                sta w16+1
00032Br 2  A9 15                lda #VISROWS
00032Dr 2  85 rr                sta tmp4
00032Fr 2  A5 rr                lda barq
000331r 2  85 rr                sta tmp3
000333r 2               @run:   ; w16 = the run's ring offset, tmp4 = its rows, X = the entry before it
000333r 2  20 rr rr             jsr @nfull                  ; rows that end before the ring end
000336r 2  C5 rr                cmp tmp4
000338r 2  B0 15                bcs @one                    ; the whole run fits
00033Ar 2  C9 00                cmp #0
00033Cr 2  F0 11                beq @one                    ; it starts inside the straddling row: all of it folds
00033Er 2  85 rr                sta tmp2
000340r 2  20 rr rr             jsr @emit                   ; up to the ring end
000343r 2  A5 rr                lda tmp2
000345r 2  20 rr rr             jsr @advance
000348r 2  A5 rr                lda tmp4
00034Ar 2  38                   sec
00034Br 2  E5 rr                sbc tmp2
00034Dr 2  85 rr                sta tmp4
00034Fr 2  A5 rr        @one:   lda tmp4
000351r 2  85 rr                sta tmp2
000353r 2  20 rr rr             jsr @emit
000356r 2  A5 rr                lda tmp4
000358r 2  20 rr rr             jsr @advance                ; now the row below the playfield
00035Br 2  A5 rr                lda wfine
00035Dr 2  F0 3D                beq @setq
00035Fr 2                       ; --- P2: the top f lines of that row
00035Fr 2  20 rr rr             jsr @addr
000362r 2  A5 rr                lda wfine
000364r 2  20 rr rr             jsr @dur
000367r 2  9D rr rr             sta SECTAB+6,x
00036Ar 2  A5 rr                lda tmp3
00036Cr 2  9D rr rr             sta SECTAB+7,x
00036Fr 2  8A                   txa
000370r 2  18                   clc
000371r 2  69 08                adc #8
000373r 2  AA                   tax
000374r 2  48 A9 00 9D          stza SECTAB+2, x
000378r 2  rr rr 68     
00037Br 2  A5 rr                lda wfine
00037Dr 2  38 E9 01             deca
000380r 2  9D rr rr             sta SECTAB+3,x
000383r 2  A9 15                lda #VISROWS
000385r 2  9D rr rr             sta SECTAB+4,x
000388r 2  A9 1E                lda #30
00038Ar 2  9D rr rr             sta SECTAB+5,x
00038Dr 2  BD rr rr             lda SECTAB-8,x              ; w16 has not moved: the address the P2 @addr left
000390r 2  9D rr rr             sta SECTAB,x                ; in the previous entry is this one's too
000393r 2  BD rr rr             lda SECTAB-8+1,x
000396r 2  9D rr rr             sta SECTAB+1,x
000399r 2  4C rr rr             bra @sq2
00039Cr 2  20 rr rr     @setq:  jsr @addr                   ; Q starts on the row below the playfield
00039Fr 2  A9 FE        @sq2:   lda #<(40*LINE-2)
0003A1r 2  9D rr rr             sta SECTAB+6,x
0003A4r 2  A9 09                lda #>(40*LINE-2)
0003A6r 2  9D rr rr             sta SECTAB+7,x
0003A9r 2  8A                   txa
0003AAr 2  18                   clc
0003ABr 2  69 08                adc #8
0003ADr 2  AA                   tax
0003AEr 2  A9 00                lda #>BARCRTC               ; and hands the chain back to the bar
0003B0r 2  9D rr rr             sta SECTAB,x
0003B3r 2  A9 60                lda #<BARCRTC
0003B5r 2  9D rr rr             sta SECTAB+1,x
0003B8r 2  A9 0F                lda #QROWS-1
0003BAr 2  9D rr rr             sta SECTAB+2,x
0003BDr 2  A9 07                lda #7
0003BFr 2  9D rr rr             sta SECTAB+3,x
0003C2r 2  48 A9 00 9D          stza SECTAB+4, x
0003C6r 2  rr rr 68     
0003C9r 2  A9 08                lda #QVSYNC
0003CBr 2  9D rr rr             sta SECTAB+5, x
0003CEr 2  A9 FE                lda #<(40*LINE-2)
0003D0r 2  9D rr rr             sta SECTAB+6, x
0003D3r 2  A9 09                lda #>(40*LINE-2)
0003D5r 2  9D rr rr             sta SECTAB+7, x
0003D8r 2  60                   rts
0003D9r 2               ; --- emit a run of tmp2 rows starting at ring offset w16, following entry X
0003D9r 2  20 rr rr     @emit:  jsr @addr
0003DCr 2  A5 rr                lda tmp2
0003DEr 2  20 rr rr             jsr @lines
0003E1r 2  9D rr rr             sta SECTAB+6,x
0003E4r 2  A5 rr                lda tmp3
0003E6r 2  9D rr rr             sta SECTAB+7,x
0003E9r 2  8A                   txa
0003EAr 2  18                   clc
0003EBr 2  69 08                adc #8
0003EDr 2  AA                   tax
0003EEr 2  A5 rr                lda tmp2
0003F0r 2  38 E9 01             deca
0003F3r 2  9D rr rr             sta SECTAB+2,x
0003F6r 2  A9 07                lda #7
0003F8r 2  9D rr rr             sta SECTAB+3,x
0003FBr 2  A9 1E                lda #30
0003FDr 2  9D rr rr             sta SECTAB+4,x
000400r 2  9D rr rr             sta SECTAB+5,x
000403r 2  60                   rts
000404r 2               ; --- SECTAB+0/1,x = the CRTC address of the row at ring offset w16.  A row starting
000404r 2               ; past RINGCHARS-80 straddles the ring end and is read from the mirror below the base,
000404r 2               ; which is exactly the address w16 - RINGCHARS names.
000404r 2  A5 rr        @addr:  lda w16
000406r 2  A4 rr                ldy w16+1
000408r 2  C0 06                cpy #>(RINGCHARS-ROWCHARS+1)
00040Ar 2  90 13                bcc :++
00040Cr 2  D0 04                bne :+
00040Er 2  C9 E1                cmp #<(RINGCHARS-ROWCHARS+1)
000410r 2  90 0D                bcc :++
000412r 2  18           :       clc
000413r 2  65 rr                adc crtcbm
000415r 2  9D rr rr             sta SECTAB+1,x
000418r 2  98                   tya
000419r 2  65 rr                adc crtcbm+1
00041Br 2  9D rr rr             sta SECTAB,x
00041Er 2  60                   rts
00041Fr 2  18           :       clc
000420r 2  65 rr                adc crtcb
000422r 2  9D rr rr             sta SECTAB+1,x
000425r 2  98                   tya
000426r 2  65 rr                adc crtcb+1
000428r 2  9D rr rr             sta SECTAB,x
00042Br 2  60                   rts
00042Cr 2                       ; --- A = rows -> A/tmp3 = that many rows of lines, as a T1 count
00042Cr 2  0A           @lines: asl
00042Dr 2  0A                   asl
00042Er 2  0A                   asl
00042Fr 2  4C rr rr             jmp @dur
000432r 2                       ; --- A = rows: advance w16 by that many rows, folding into 0..RINGCHARS
000432r 2               @advance:
000432r 2  A8                   tay
000433r 2  18                   clc
000434r 2  A5 rr                lda w16
000436r 2  79 rr rr             adc mulrowlo,y
000439r 2  85 rr                sta w16
00043Br 2  A5 rr                lda w16+1
00043Dr 2  79 rr rr             adc mulrowhi,y
000440r 2  85 rr                sta w16+1
000442r 2  A5 rr        @wrap:  lda w16+1
000444r 2  C9 07                cmp #>RINGCHARS
000446r 2  90 15                bcc :++
000448r 2  D0 06                bne :+
00044Ar 2  A5 rr                lda w16
00044Cr 2  C9 30                cmp #<RINGCHARS
00044Er 2  90 0D                bcc :++
000450r 2  A5 rr        :       lda w16
000452r 2  38                   sec
000453r 2  E9 30                sbc #<RINGCHARS
000455r 2  85 rr                sta w16
000457r 2  A5 rr                lda w16+1
000459r 2  E9 07                sbc #>RINGCHARS
00045Br 2  85 rr                sta w16+1
00045Dr 2  60           :       rts
00045Er 2                       ; --- rows of the run that finish before the ring end.  The run starts on ring
00045Er 2                       ; row tmp3; when r = ringS mod 80 is non-zero the last ring row straddles and
00045Er 2                       ; @addr sends it to the mirror, so RINGROWS-1-tmp3 rows come first.
00045Er 2  A4 rr        @nfull: ldy barq
000460r 2  A5 rr                lda ringS
000462r 2  38                   sec
000463r 2  F9 rr rr             sbc mulrowlo,y              ; r
000466r 2  C9 01                cmp #1                      ; C = 1 iff r > 0
000468r 2  A9 16                lda #RINGROWS-1
00046Ar 2  B0 04                bcs :+
00046Cr 2  69 00                adc #0                      ; r == 0: C is clear here, so this adds 1
00046Er 2  69 01                adc #1
000470r 2  38           :       sec
000471r 2  E5 rr                sbc tmp3
000473r 2  60                   rts
000474r 2                       ; --- A = lines -> A/tmp3 = the T1 count that lasts that long
000474r 2  85 rr        @dur:   sta tmp3                    ; n*64 == (n*256)>>2
000476r 2  A9 00                lda #0
000478r 2  46 rr                lsr tmp3
00047Ar 2  6A                   ror
00047Br 2  46 rr                lsr tmp3
00047Dr 2  6A                   ror
00047Er 2  E9 01                sbc #1                      ; C = 0 out of the ror pair: A - 2
000480r 2  B0 02                bcs :+
000482r 2  C6 rr                dec tmp3
000484r 2  60           :       rts
000485r 2               
000485r 2               ; ---------------------------------------------------------------- display
000485r 2               set_palette:                        ; MODE 1: logical 0..3 = black, cyan, magenta, yellow
000485r 2  A2 0F                ldx #15                     ; a pixel's two bits land in index bits 3 and 1
000487r 2  8A           :       txa
000488r 2  29 08                and #8
00048Ar 2  4A                   lsr
00048Br 2  4A                   lsr
00048Cr 2  85 rr                sta tmp
00048Er 2  8A                   txa
00048Fr 2  29 02                and #2
000491r 2  4A                   lsr
000492r 2  05 rr                ora tmp
000494r 2  A8                   tay
000495r 2  B9 rr rr             lda @cmyk,y
000498r 2  85 rr                sta tmp
00049Ar 2  8A                   txa
00049Br 2  0A                   asl
00049Cr 2  0A                   asl
00049Dr 2  0A                   asl
00049Er 2  0A                   asl
00049Fr 2  05 rr                ora tmp
0004A1r 2  8D 21 FE             sta ULA_PAL
0004A4r 2  CA                   dex
0004A5r 2  10 E0                bpl :-
0004A7r 2  60                   rts
0004A8r 2  07 01 02 04  @cmyk:  .byte 0^7, 6^7, 5^7, 3^7    ; physical black, cyan, magenta, yellow, inverted
0004ACr 2               
0004ACr 2               crtc_init:                          ; start the chain at the bar and let vsync re-phase
0004ACr 2  A2 09                ldx #9
0004AEr 2  A9 07                lda #7
0004B0r 2  20 rr rr             jsr @w
0004B3r 2  A2 04                ldx #4
0004B5r 2  A9 01                lda #BARROWS-1
0004B7r 2  20 rr rr             jsr @w
0004BAr 2  A2 06                ldx #6
0004BCr 2  A9 02                lda #BARROWS
0004BEr 2  20 rr rr             jsr @w
0004C1r 2  A2 07                ldx #7
0004C3r 2  A9 1E                lda #30
0004C5r 2  20 rr rr             jsr @w
0004C8r 2  A2 0C                ldx #12
0004CAr 2  A9 00                lda #>BARCRTC
0004CCr 2  20 rr rr             jsr @w
0004CFr 2  A2 0D                ldx #13
0004D1r 2  A9 60                lda #<BARCRTC
0004D3r 2  8E 00 FE     @w:     stx CRTC_IDX
0004D6r 2  8D 01 FE             sta CRTC_DAT
0004D9r 2  60                   rts
0004DAr 2               
0004DAr 2               take_over:
0004DAr 2  78                   sei
0004DBr 2  A9 rr                lda #<irq_handler
0004DDr 2  8D 04 02             sta IRQ1V
0004E0r 2  A9 rr                lda #>irq_handler
0004E2r 2  8D 05 02             sta IRQ1V+1
0004E5r 2  A9 7F                lda #$7F
0004E7r 2  8D 4E FE             sta VIA_IER
0004EAr 2  8D 6E FE             sta UVIA_IER
0004EDr 2  AD 4B FE             lda VIA_ACR
0004F0r 2  29 3F                and #$3F
0004F2r 2  09 40                ora #$40                    ; T1 continuous
0004F4r 2  8D 4B FE             sta VIA_ACR
0004F7r 2  A9 00                lda #<(40*LINE)
0004F9r 2  8D 46 FE             sta VIA_T1LL
0004FCr 2  A9 0A                lda #>(40*LINE)
0004FEr 2  8D 45 FE             sta VIA_T1CH
000501r 2  A9 C2                lda #$C2                    ; CA1 (vsync) + T1
000503r 2  8D 4E FE             sta VIA_IER
000506r 2  A9 7F                lda #$7F
000508r 2  8D 4D FE             sta VIA_IFR
00050Br 2  A9 1E                lda #30                     ; the chain stops when curR7 is Q's; start it at a
00050Dr 2  85 rr                sta curR7                   ; value that is not
00050Fr 2  A9 00 85 rr          stz flipreq
000513r 2  A9 00 85 rr          stz vsyncs
000517r 2  A9 00 85 rr          stz flipvs
00051Br 2  58                   cli
00051Cr 2  60                   rts
00051Dr 2               
00051Dr 2               ; ---------------------------------------------------------------- scaffolding
00051Dr 2               clear_screen:                       ; $0300-$7FFF: the bar, both mirrors and both rings
00051Dr 2  A9 00                lda #0
00051Fr 2  85 rr                sta w16
000521r 2  A9 03                lda #>BARADDR
000523r 2  85 rr                sta w16+1
000525r 2  A0 00                ldy #0
000527r 2  A2 7D                ldx #$7D                    ; pages $03..$7F
000529r 2  91 rr        :       sta (w16),y
00052Br 2  C8                   iny
00052Cr 2  D0 FB                bne :-
00052Er 2  E6 rr                inc w16+1
000530r 2  CA                   dex
000531r 2  D0 F6                bne :-
000533r 2  60                   rts
000534r 2               
000534r 2               ; the whole window: 20 tiles across, 11 tile rows (22 char rows)
000534r 2               draw_window:
000534r 2  A5 rr                lda wcx                     ; a tile is four chars and two char rows
000536r 2  4A                   lsr
000537r 2  4A                   lsr
000538r 2  85 rr                sta dt_tx
00053Ar 2  A5 rr                lda wcy
00053Cr 2  4A                   lsr
00053Dr 2  85 rr                sta dt_ty
00053Fr 2  A9 14                lda #20
000541r 2  85 rr                sta dt_nx
000543r 2  A9 0B                lda #11
000545r 2  85 rr                sta dt_ny
000547r 2  A2 0C 20 rr          farjsr F_DRAWRECT
00054Br 2  rr           
00054Cr 2  60                   rts
00054Dr 2               
00054Dr 2               ; A pattern that makes the geometry readable: each ring row is a band of one colour
00054Dr 2               ; with its slot number written as a run of black chars at the left, so the order of
00054Dr 2               ; the rows on screen, the wrap and the mirror can all be counted off.
00054Dr 2               test_pattern:
00054Dr 2  A2 00                ldx #0                      ; slot
00054Fr 2  86 rr        @slot:  stx tmp2
000551r 2  8A                   txa
000552r 2  18                   clc
000553r 2  69 01                adc #1
000555r 2  85 rr                sta tmp                     ; colour 1..3 by slot
000557r 2  C9 04        @c1:    cmp #4
000559r 2  90 05                bcc :+
00055Br 2  E9 03                sbc #3
00055Dr 2  4C rr rr             bra @c1
000560r 2  A8           :       tay
000561r 2  B9 rr rr             lda @cols,y
000564r 2  85 rr                sta tmp3                    ; the band's byte
000566r 2  A6 rr                ldx tmp2
000568r 2  B5 rr                lda RINGLO,x
00056Ar 2  85 rr                sta w16
00056Cr 2  B5 rr                lda RINGHI,x
00056Er 2  85 rr                sta w16+1
000570r 2  A0 00                ldy #0
000572r 2  A9 00                lda #0
000574r 2  85 rr                sta cnt                     ; char within the row
000576r 2  A5 rr        @char:  lda cnt
000578r 2  C5 rr                cmp tmp2                    ; the first (slot+1) chars are black
00057Ar 2  90 07                bcc @black
00057Cr 2  F0 05                beq @black
00057Er 2  A5 rr                lda tmp3
000580r 2  4C rr rr             bra @put
000583r 2  A9 00        @black: lda #0
000585r 2  A2 08        @put:   ldx #8
000587r 2  91 rr        @st:    sta (w16),y
000589r 2  C8                   iny
00058Ar 2  D0 02                bne :+
00058Cr 2  E6 rr                inc w16+1
00058Er 2  CA           :       dex
00058Fr 2  D0 F6                bne @st
000591r 2  E6 rr                inc cnt
000593r 2  A5 rr                lda cnt
000595r 2  C9 50                cmp #ROWCHARS
000597r 2  D0 DD                bne @char
000599r 2  A6 rr                ldx tmp2
00059Br 2  E8                   inx
00059Cr 2  E0 17                cpx #RINGROWS
00059Er 2  D0 AF                bne @slot
0005A0r 2  60                   rts
0005A1r 2  00 0F F0 FF  @cols:  .byte $00, $0F, $F0, $FF
0005A5r 2               
0005A5r 2               bar_pattern:                        ; yellow with a black tick every eight chars
0005A5r 2  A9 00                lda #<BARADDR
0005A7r 2  85 rr                sta w16
0005A9r 2  A9 03                lda #>BARADDR
0005ABr 2  85 rr                sta w16+1
0005ADr 2  A0 00                ldy #0
0005AFr 2  A2 00                ldx #0
0005B1r 2  98           @b:     tya
0005B2r 2  29 38                and #$38
0005B4r 2  C9 38                cmp #$38
0005B6r 2  D0 05                bne :+
0005B8r 2  A9 00                lda #0
0005BAr 2  4C rr rr             bra :++
0005BDr 2  A9 FF        :       lda #$FF
0005BFr 2  91 rr        :       sta (w16),y
0005C1r 2  C8                   iny
0005C2r 2  D0 ED                bne @b
0005C4r 2  E6 rr                inc w16+1
0005C6r 2  E8                   inx
0005C7r 2  E0 05                cpx #5
0005C9r 2  D0 E6                bne @b
0005CBr 2  60                   rts
0005CCr 2               
0005CCr 2               ; the mirror is a copy of the ring's last row, so a straddling row reads as one run
0005CCr 2               mirror_copy:
0005CCr 2  A2 16                ldx #RINGROWS-1
0005CEr 2  B5 rr                lda RINGLO,x
0005D0r 2  85 rr                sta w16
0005D2r 2  B5 rr                lda RINGHI,x
0005D4r 2  85 rr                sta w16+1
0005D6r 2  A5 rr                lda ringbase
0005D8r 2  38                   sec
0005D9r 2  E9 80                sbc #<ROWBYTES
0005DBr 2  85 rr                sta w16b
0005DDr 2  A5 rr                lda ringbase+1
0005DFr 2  E9 02                sbc #>ROWBYTES
0005E1r 2  85 rr                sta w16b+1
0005E3r 2  A0 00                ldy #0
0005E5r 2  A2 02                ldx #>ROWBYTES
0005E7r 2  B1 rr        :       lda (w16),y
0005E9r 2  91 rr                sta (w16b),y
0005EBr 2  C8                   iny
0005ECr 2  D0 F9                bne :-
0005EEr 2  E6 rr                inc w16+1
0005F0r 2  E6 rr                inc w16b+1
0005F2r 2  CA                   dex
0005F3r 2  D0 F2                bne :-
0005F5r 2  A2 80                ldx #<ROWBYTES              ; the odd half page
0005F7r 2  B1 rr        :       lda (w16),y
0005F9r 2  91 rr                sta (w16b),y
0005FBr 2  C8                   iny
0005FCr 2  CA                   dex
0005FDr 2  D0 F8                bne :-
0005FFr 2  60                   rts
000600r 2               
000600r 2                       .include "tables.inc"
000600r 3  00 50 A0 F0  mulrowlo:   .repeat RINGROWS+1, i
000604r 3  40 90 E0 30  
000608r 3  80 D0 20 70  
000618r 3                           .byte <(i*ROWCHARS)
000618r 3                           .endrepeat
000618r 3  00 00 00 00  mulrowhi:   .repeat RINGROWS+1, i
00061Cr 3  01 01 01 02  
000620r 3  02 02 03 03  
000630r 3                           .byte >(i*ROWCHARS)
000630r 3                           .endrepeat
000630r 3               
000630r 2               
000630r 2                       .segment "LGCBSS"
000000r 2               
000000r 1                       .include "logicb.s"
000000r 2               ; ============================================================================
000000r 2               ; The game, such as it is on this target: Cleo, the level's objects, a camera
000000r 2               ; and the scroll validation that keeps the ring honest.  Bank 7.
000000r 2               ; ============================================================================
000000r 2               K_LEFT  = 1
000000r 2               K_RIGHT = 2
000000r 2               K_UP    = 4
000000r 2               K_FIRE  = 16
000000r 2               VIA_ORB   = $FE40
000000r 2               VIA_DDRA  = $FE43
000000r 2               VIA_ORANH = $FE4F
000000r 2               
000000r 2                       .segment "LGCCODE"
000630r 2               scan_keys:
000630r 2  A9 7F                lda #$7F
000632r 2  8D 43 FE             sta VIA_DDRA
000635r 2  A9 03                lda #3
000637r 2  8D 40 FE             sta VIA_ORB                 ; autoscan off: the matrix is read directly
00063Ar 2  A9 00                lda #0
00063Cr 2  85 rr                sta tmp
00063Er 2  A2 06                ldx #6
000640r 2  BD rr rr     @k:     lda keytab,x
000643r 2  8D 4F FE             sta VIA_ORANH
000646r 2  AD 4F FE             lda VIA_ORANH
000649r 2  10 07                bpl :+
00064Br 2  BD rr rr             lda keybits,x
00064Er 2  05 rr                ora tmp                     ; no tsb on a 6502
000650r 2  85 rr                sta tmp
000652r 2  CA           :       dex
000653r 2  10 EB                bpl @k
000655r 2  A5 rr                lda tmp
000657r 2  85 rr                sta keys
000659r 2  60                   rts
00065Ar 2  61 19 42 79  keytab:  .byte $61,$19, $42,$79, $48,$39,$49
00065Er 2  48 39 49     
000661r 2  01 01 02 02  keybits: .byte K_LEFT,K_LEFT, K_RIGHT,K_RIGHT, K_UP,K_UP,K_FIRE
000665r 2  04 04 10     
000668r 2               
000668r 2               ; ---------------------------------------------------------------- the player
000668r 2               ; px, py are her feet in game pixels; vy is 1/256 px a step, as on the Master.
000668r 2               player_step:
000668r 2  20 rr rr             jsr scan_keys
00066Br 2  A9 00                lda #0                      ; horizontal: a step is two pixels, and the
00066Dr 2  85 rr                sta dx                      ; original's acceleration is not missed here
00066Fr 2  A5 rr                lda keys
000671r 2  29 01                and #K_LEFT
000673r 2  F0 08                beq :+
000675r 2  A9 FE                lda #$FE
000677r 2  85 rr                sta dx
000679r 2  A9 01                lda #1
00067Br 2  85 rr                sta facing
00067Dr 2  A5 rr        :       lda keys
00067Fr 2  29 02                and #K_RIGHT
000681r 2  F0 08                beq :+
000683r 2  A9 02                lda #2
000685r 2  85 rr                sta dx
000687r 2  A9 00                lda #0
000689r 2  85 rr                sta facing
00068Br 2  A5 rr        :       lda keys                    ; jump, if there is ground under her
00068Dr 2  29 04                and #K_UP
00068Fr 2  F0 10                beq @nojump
000691r 2  A5 rr                lda onground
000693r 2  F0 0C                beq @nojump
000695r 2  A9 00                lda #0
000697r 2  85 rr                sta vy
000699r 2  A9 FB                lda #>(-1280)
00069Br 2  85 rr                sta vy+1
00069Dr 2  A9 00                lda #0
00069Fr 2  85 rr                sta onground
0006A1r 2               @nojump:
0006A1r 2                       ; ---- gravity: vy = (vy + 80) * 31/32
0006A1r 2  A5 rr                lda vy
0006A3r 2  18                   clc
0006A4r 2  69 50                adc #80
0006A6r 2  85 rr                sta vy
0006A8r 2  A5 rr                lda vy+1
0006AAr 2  69 00                adc #0
0006ACr 2  85 rr                sta vy+1
0006AEr 2  38                   sec                         ; t16 = -vy
0006AFr 2  A9 00                lda #0
0006B1r 2  E5 rr                sbc vy
0006B3r 2  85 rr                sta t16
0006B5r 2  A9 00                lda #0
0006B7r 2  E5 rr                sbc vy+1
0006B9r 2  C9 80 6A 66          .repeat 5                   ; >> 5, arithmetic
0006BDr 2  rr C9 80 6A  
0006C1r 2  66 rr C9 80  
0006D2r 2                       cmp #$80
0006D2r 2                       ror a
0006D2r 2                       ror t16
0006D2r 2                       .endrepeat
0006D2r 2  85 rr                sta t16+1
0006D4r 2  A5 rr                lda vy                      ; vy += -vy/32
0006D6r 2  18                   clc
0006D7r 2  65 rr                adc t16
0006D9r 2  85 rr                sta vy
0006DBr 2  A5 rr                lda vy+1
0006DDr 2  65 rr                adc t16+1
0006DFr 2  85 rr                sta vy+1
0006E1r 2                       ; ---- dy = (vy + 128) >> 8, clamped when falling
0006E1r 2  A5 rr                lda vy
0006E3r 2  18                   clc
0006E4r 2  69 80                adc #128
0006E6r 2  A5 rr                lda vy+1
0006E8r 2  69 00                adc #0
0006EAr 2  85 rr                sta dy
0006ECr 2  10 08                bpl :+
0006EEr 2  C9 F8                cmp #$F8                    ; rising faster than 8 px a step is fine
0006F0r 2  B0 04                bcs :+
0006F2r 2  A9 F8                lda #$F8
0006F4r 2  85 rr                sta dy
0006F6r 2  A5 rr        :       lda dy
0006F8r 2  C9 09                cmp #MAXDWY+1
0006FAr 2  90 06                bcc :+
0006FCr 2  30 04                bmi :+
0006FEr 2  A9 08                lda #MAXDWY
000700r 2  85 rr                sta dy
000702r 2               :
000702r 2                       ; ---- horizontal: a step up of four pixels or less is walkable, more is a wall
000702r 2  A5 rr                lda dx
000704r 2  F0 3E                beq @novx
000706r 2  18                   clc
000707r 2  65 rr                adc px
000709r 2  85 rr                sta w16b
00070Br 2  A5 rr                lda px+1
00070Dr 2  69 00                adc #0
00070Fr 2  30 33                bmi @novx                   ; off the left edge
000711r 2  85 rr                sta w16b+1
000713r 2  A5 rr                lda py                      ; look from eight pixels above her feet, so a
000715r 2  38                   sec                         ; step up is found as well as the floor
000716r 2  E9 08                sbc #8
000718r 2  85 rr                sta ga_py
00071Ar 2  A5 rr                lda w16b
00071Cr 2  20 rr rr             jsr ground_at
00071Fr 2  A5 rr                lda tmp4
000721r 2  C9 FF                cmp #255
000723r 2  F0 07                beq @movex                  ; nothing there: walk off the edge
000725r 2  18                   clc
000726r 2  69 04                adc #4                      ; surface + 4 < py means it rises too steeply
000728r 2  C5 rr                cmp py
00072Ar 2  90 18                bcc @novx
00072Cr 2  A5 rr        @movex: lda w16b
00072Er 2  85 rr                sta px
000730r 2  A5 rr                lda w16b+1
000732r 2  85 rr                sta px+1
000734r 2  A5 rr                lda onground                ; on the ground, follow the surface
000736r 2  F0 0C                beq @novx
000738r 2  A5 rr                lda tmp4
00073Ar 2  C9 FF                cmp #255
00073Cr 2  F0 06                beq @novx
00073Er 2  85 rr                sta py
000740r 2  A9 00                lda #0
000742r 2  85 rr                sta py+1
000744r 2               @novx:
000744r 2                       ; ---- the floor under her, before she moves down it
000744r 2  A5 rr                lda py
000746r 2  85 rr                sta ga_py
000748r 2  A5 rr                lda px
00074Ar 2  20 rr rr             jsr ground_at
00074Dr 2  A5 rr                lda tmp4
00074Fr 2  85 rr                sta floor
000751r 2                       ; ---- vertical move
000751r 2  A5 rr                lda dy
000753r 2  F0 1B                beq @noy
000755r 2  30 0E                bmi @up
000757r 2  18                   clc
000758r 2  65 rr                adc py
00075Ar 2  85 rr                sta py
00075Cr 2  A5 rr                lda py+1
00075Er 2  69 00                adc #0
000760r 2  85 rr                sta py+1
000762r 2  4C rr rr             bra @noy
000765r 2  18           @up:    clc
000766r 2  65 rr                adc py
000768r 2  85 rr                sta py
00076Ar 2  A5 rr                lda py+1
00076Cr 2  69 FF                adc #$FF
00076Er 2  85 rr                sta py+1
000770r 2  A5 rr        @noy:   lda floor
000772r 2  C9 FF                cmp #255
000774r 2  F0 1E                beq @air
000776r 2  C5 rr                cmp py                      ; her feet have reached the floor when py >= floor
000778r 2  F0 09                beq @landit
00077Ar 2  90 07                bcc @landit
00077Cr 2  A9 00                lda #0                      ; still above it
00077Er 2  85 rr                sta onground
000780r 2  4C rr rr             bra @anim
000783r 2  85 rr        @landit: sta py
000785r 2  A9 00                lda #0
000787r 2  85 rr                sta py+1
000789r 2  85 rr                sta vy
00078Br 2  85 rr                sta vy+1
00078Dr 2  A9 01                lda #1
00078Fr 2  85 rr                sta onground
000791r 2  4C rr rr             bra @anim
000794r 2  A9 00        @air:   lda #0
000796r 2  85 rr                sta onground
000798r 2  E6 rr        @anim:  inc anim
00079Ar 2  60                   rts
00079Br 2               
00079Br 2               ; ground_at: A = x in map pixels -> tmp4 = the surface y at or below her feet in
00079Br 2               ; that pixel column, or 255 if there is none within two tiles.
00079Br 2               ground_at:
00079Br 2  85 rr                sta ga_x
00079Dr 2  4A                   lsr
00079Er 2  4A                   lsr
00079Fr 2  4A                   lsr
0007A0r 2  85 rr                sta ga_tx
0007A2r 2  A5 rr                lda ga_py
0007A4r 2  4A                   lsr
0007A5r 2  4A                   lsr
0007A6r 2  4A                   lsr
0007A7r 2  85 rr                sta ga_ty
0007A9r 2  A2 00                ldx #0
0007ABr 2  86 rr                stx ga_k
0007ADr 2  A5 rr        @try:   lda ga_ty
0007AFr 2  18                   clc
0007B0r 2  65 rr                adc ga_k
0007B2r 2  C9 20                cmp #MAPH
0007B4r 2  B0 43                bcs @none
0007B6r 2  85 rr                sta tmp2                    ; map_strip wants the tile in tmp/tmp2
0007B8r 2  85 rr                sta ga_row
0007BAr 2  A5 rr                lda ga_tx
0007BCr 2  85 rr                sta tmp
0007BEr 2  A9 01                lda #1
0007C0r 2  85 rr                sta cnt
0007C2r 2  A2 09 20 rr          farjsr F_MAPSTRIP
0007C6r 2  rr           
0007C7r 2  A5 rr                lda MAPBUF
0007C9r 2  85 rr                sta tmp2                    ; the tile id, for its altitude class
0007CBr 2  A2 27 20 rr          farjsr F_ALTROW
0007CFr 2  rr           
0007D0r 2  A5 rr                lda ga_x
0007D2r 2  29 07                and #7
0007D4r 2  A8                   tay
0007D5r 2  B9 rr rr             lda MAPBUF,y
0007D8r 2  4A                   lsr
0007D9r 2  4A                   lsr
0007DAr 2  4A                   lsr
0007DBr 2  4A                   lsr
0007DCr 2  C9 08                cmp #8
0007DEr 2  B0 11                bcs @next                   ; no ground in this pixel column
0007E0r 2  85 rr                sta tmp4
0007E2r 2  A5 rr                lda ga_row
0007E4r 2  0A                   asl
0007E5r 2  0A                   asl
0007E6r 2  0A                   asl
0007E7r 2  18                   clc
0007E8r 2  65 rr                adc tmp4
0007EAr 2  85 rr                sta tmp4                    ; surface = tile row * 8 + the altitude
0007ECr 2  C5 rr                cmp ga_py
0007EEr 2  90 01                bcc @next                   ; above the starting point: look further down
0007F0r 2  60                   rts
0007F1r 2  E6 rr        @next:  inc ga_k
0007F3r 2  A5 rr                lda ga_k
0007F5r 2  C9 03                cmp #3
0007F7r 2  D0 B4                bne @try
0007F9r 2  A9 FF        @none:  lda #255
0007FBr 2  85 rr                sta tmp4
0007FDr 2  60                   rts
0007FEr 2               
0007FEr 2               ; ---------------------------------------------------------------- camera
0007FEr 2               camera:
0007FEr 2  A5 rr                lda px                      ; wx = clamp(px - 80, 0, MAPW*8 - 160)
000800r 2  38                   sec
000801r 2  E9 50                sbc #80
000803r 2  85 rr                sta wx
000805r 2  A5 rr                lda px+1
000807r 2  E9 00                sbc #0
000809r 2  85 rr                sta wx+1
00080Br 2  10 06                bpl :+
00080Dr 2  A9 00                lda #0
00080Fr 2  85 rr                sta wx
000811r 2  85 rr                sta wx+1
000813r 2  A5 rr        :       lda wx+1
000815r 2  C9 00                cmp #>(MAPW*8-160)
000817r 2  90 10                bcc :++
000819r 2  D0 06                bne :+
00081Br 2  A5 rr                lda wx
00081Dr 2  C9 60                cmp #<(MAPW*8-160)
00081Fr 2  90 08                bcc :++
000821r 2  A9 60        :       lda #<(MAPW*8-160)
000823r 2  85 rr                sta wx
000825r 2  A9 00                lda #>(MAPW*8-160)
000827r 2  85 rr                sta wx+1
000829r 2  A5 rr        :       lda py                      ; wy = clamp(py - 42, 0, MAPH*8 - VISROWS*4)
00082Br 2  38                   sec
00082Cr 2  E9 2A                sbc #42
00082Er 2  85 rr                sta wy
000830r 2  A5 rr                lda py+1
000832r 2  E9 00                sbc #0
000834r 2  85 rr                sta wy+1
000836r 2  10 06                bpl :+
000838r 2  A9 00                lda #0
00083Ar 2  85 rr                sta wy
00083Cr 2  85 rr                sta wy+1
00083Er 2  A5 rr        :       lda wy+1
000840r 2  C9 00                cmp #>(MAPH*8-VISROWS*4)
000842r 2  90 10                bcc :++
000844r 2  D0 06                bne :+
000846r 2  A5 rr                lda wy
000848r 2  C9 AC                cmp #<(MAPH*8-VISROWS*4)
00084Ar 2  90 08                bcc :++
00084Cr 2  A9 AC        :       lda #<(MAPH*8-VISROWS*4)
00084Er 2  85 rr                sta wy
000850r 2  A9 00                lda #>(MAPH*8-VISROWS*4)
000852r 2  85 rr                sta wy+1
000854r 2  A5 rr        :       lda wx+1                    ; wcx = wx >> 1 (a char is two game pixels)
000856r 2  4A                   lsr
000857r 2  85 rr                sta wcx+1
000859r 2  A5 rr                lda wx
00085Br 2  6A                   ror
00085Cr 2  85 rr                sta wcx
00085Er 2  A5 rr                lda wy                      ; wfine = (wy & 3) * 2
000860r 2  29 03                and #3
000862r 2  0A                   asl
000863r 2  85 rr                sta wfine
000865r 2  A5 rr                lda wy+1                    ; wcy = wy >> 2 (a char row is four)
000867r 2  4A                   lsr
000868r 2  85 rr                sta tmp
00086Ar 2  A5 rr                lda wy
00086Cr 2  6A                   ror
00086Dr 2  46 rr                lsr tmp
00086Fr 2  6A                   ror
000870r 2  85 rr                sta wcy
000872r 2  60                   rts
000873r 2               
000873r 2               ; ---------------------------------------------------------------- scrolling
000873r 2               ; The ring holds the window's rows wherever the map says they go, so what a move
000873r 2               ; costs is the strip that has just come into view.
000873r 2               scroll_validate:
000873r 2  A5 rr                lda wcx
000875r 2  4A                   lsr
000876r 2  4A                   lsr
000877r 2  85 rr                sta tx0
000879r 2  A5 rr                lda wcy
00087Br 2  4A                   lsr
00087Cr 2  85 rr                sta ty0
00087Er 2  A6 rr                ldx curbuf
000880r 2  BD rr rr             lda bvalid,x
000883r 2  D0 1D                bne @inc
000885r 2  A9 01                lda #1                      ; this buffer has never been drawn
000887r 2  9D rr rr             sta bvalid,x
00088Ar 2  A5 rr                lda tx0
00088Cr 2  85 rr                sta dt_tx
00088Er 2  A5 rr                lda ty0
000890r 2  85 rr                sta dt_ty
000892r 2  A9 15                lda #WINTX
000894r 2  85 rr                sta dt_nx
000896r 2  A9 0C                lda #WINTY
000898r 2  85 rr                sta dt_ny
00089Ar 2  A2 0C 20 rr          farjsr F_DRAWRECT
00089Er 2  rr           
00089Fr 2  4C rr rr             jmp @save
0008A2r 2  A6 rr        @inc:   ldx curbuf
0008A4r 2  A5 rr                lda ty0                     ; ---- vertical
0008A6r 2  38                   sec
0008A7r 2  FD rr rr             sbc bpty,x
0008AAr 2  F0 2F                beq @dx
0008ACr 2  30 11                bmi @up
0008AEr 2  C9 0C                cmp #WINTY
0008B0r 2  B0 65                bcs @full
0008B2r 2  85 rr                sta dt_ny
0008B4r 2  BD rr rr             lda bpty,x
0008B7r 2  18                   clc
0008B8r 2  69 0C                adc #WINTY
0008BAr 2  85 rr                sta dt_ty
0008BCr 2  4C rr rr             bra @vdraw
0008BFr 2  49 FF        @up:    eor #$FF
0008C1r 2  18                   clc
0008C2r 2  69 01                adc #1
0008C4r 2  C9 0C                cmp #WINTY
0008C6r 2  B0 4F                bcs @full
0008C8r 2  85 rr                sta dt_ny
0008CAr 2  A5 rr                lda ty0
0008CCr 2  85 rr                sta dt_ty
0008CEr 2  A5 rr        @vdraw: lda tx0
0008D0r 2  85 rr                sta dt_tx
0008D2r 2  A9 15                lda #WINTX
0008D4r 2  85 rr                sta dt_nx
0008D6r 2  A2 0C 20 rr          farjsr F_DRAWRECT
0008DAr 2  rr           
0008DBr 2  A6 rr        @dx:    ldx curbuf
0008DDr 2  A5 rr                lda tx0                     ; ---- horizontal
0008DFr 2  38                   sec
0008E0r 2  FD rr rr             sbc bptx,x
0008E3r 2  F0 47                beq @save
0008E5r 2  30 11                bmi @left
0008E7r 2  C9 15                cmp #WINTX
0008E9r 2  B0 2C                bcs @full
0008EBr 2  85 rr                sta dt_nx
0008EDr 2  BD rr rr             lda bptx,x
0008F0r 2  18                   clc
0008F1r 2  69 15                adc #WINTX
0008F3r 2  85 rr                sta dt_tx
0008F5r 2  4C rr rr             bra @hdraw
0008F8r 2  49 FF        @left:  eor #$FF
0008FAr 2  18                   clc
0008FBr 2  69 01                adc #1
0008FDr 2  C9 15                cmp #WINTX
0008FFr 2  B0 16                bcs @full
000901r 2  85 rr                sta dt_nx
000903r 2  A5 rr                lda tx0
000905r 2  85 rr                sta dt_tx
000907r 2  A5 rr        @hdraw: lda ty0
000909r 2  85 rr                sta dt_ty
00090Br 2  A9 0C                lda #WINTY
00090Dr 2  85 rr                sta dt_ny
00090Fr 2  A2 0C 20 rr          farjsr F_DRAWRECT
000913r 2  rr           
000914r 2  4C rr rr             bra @save
000917r 2  A5 rr        @full:  lda tx0
000919r 2  85 rr                sta dt_tx
00091Br 2  A5 rr                lda ty0
00091Dr 2  85 rr                sta dt_ty
00091Fr 2  A9 15                lda #WINTX
000921r 2  85 rr                sta dt_nx
000923r 2  A9 0C                lda #WINTY
000925r 2  85 rr                sta dt_ny
000927r 2  A2 0C 20 rr          farjsr F_DRAWRECT
00092Br 2  rr           
00092Cr 2  A6 rr        @save:  ldx curbuf
00092Er 2  A5 rr                lda tx0
000930r 2  9D rr rr             sta bptx,x
000933r 2  A5 rr                lda ty0
000935r 2  9D rr rr             sta bpty,x
000938r 2  60                   rts
000939r 2               
000939r 2               ; ---------------------------------------------------------------- sprites
000939r 2               ; the level's objects, copied out of bank 6 once, then drawn where they stand
000939r 2               fetch_objs:
000939r 2  A9 00                lda #0
00093Br 2  85 rr                sta tmp3
00093Dr 2  A9 rr        @l:     lda #<LV_OBJS
00093Fr 2  18                   clc
000940r 2  65 rr                adc tmp3
000942r 2  85 rr                sta w16b
000944r 2  A9 rr                lda #>LV_OBJS
000946r 2  69 00                adc #0
000948r 2  85 rr                sta w16b+1
00094Ar 2  A9 28                lda #40
00094Cr 2  85 rr                sta cnt
00094Er 2  A2 2A 20 rr          farjsr F_MAPCOPY
000952r 2  rr           
000953r 2  A0 00                ldy #0
000955r 2  B9 rr rr     :       lda MAPBUF,y
000958r 2  84 rr                sty tmp4
00095Ar 2  A6 rr                ldx tmp3
00095Cr 2  9D rr rr             sta OBJS,x
00095Fr 2  E6 rr                inc tmp3
000961r 2  A4 rr                ldy tmp4
000963r 2  C8                   iny
000964r 2  C0 28                cpy #40
000966r 2  D0 ED                bne :-
000968r 2  A5 rr                lda tmp3
00096Ar 2  C9 90                cmp #NOBJS*6
00096Cr 2  90 CF                bcc @l
00096Er 2  60                   rts
00096Fr 2               
00096Fr 2               queue_sprites:
00096Fr 2  A9 00                lda #0                      ; the objects first, so Cleo is drawn over them
000971r 2  85 rr                sta tmp3
000973r 2  A6 rr        @o:     ldx tmp3
000975r 2  BD rr rr             lda OBJS,x                  ; type
000978r 2  C9 00                cmp #0
00097Ar 2  D0 0F                bne @notstar
00097Cr 2  20 rr rr             jsr @pos
00097Fr 2  A5 rr                lda anim                    ; the star spins
000981r 2  4A                   lsr
000982r 2  4A                   lsr
000983r 2  29 03                and #3
000985r 2  18                   clc
000986r 2  69 22                adc #34
000988r 2  4C rr rr             bra @add
00098Br 2               @notstar:
00098Br 2  C9 01                cmp #1
00098Dr 2  D0 0A                bne @next
00098Fr 2  20 rr rr             jsr @pos
000992r 2  A9 2B                lda #43                     ; a trampoline
000994r 2  A2 21 20 rr  @add:   farjsr F_ADDSPR
000998r 2  rr           
000999r 2  A5 rr        @next:  lda tmp3
00099Br 2  18                   clc
00099Cr 2  69 06                adc #6
00099Er 2  85 rr                sta tmp3
0009A0r 2  C9 90                cmp #NOBJS*6
0009A2r 2  90 CF                bcc @o
0009A4r 2                       ; ---- Cleo
0009A4r 2  A5 rr                lda px
0009A6r 2  85 rr                sta spx
0009A8r 2  A5 rr                lda px+1
0009AAr 2  85 rr                sta spx+1
0009ACr 2  A5 rr                lda py
0009AEr 2  85 rr                sta spy
0009B0r 2  A5 rr                lda py+1
0009B2r 2  85 rr                sta spy+1
0009B4r 2  A5 rr                lda onground
0009B6r 2  F0 16                beq @jump
0009B8r 2  A5 rr                lda dx
0009BAr 2  F0 0D                beq @stand
0009BCr 2  A5 rr                lda anim                    ; a four frame run
0009BEr 2  4A                   lsr
0009BFr 2  4A                   lsr
0009C0r 2  29 03                and #3
0009C2r 2  0A                   asl
0009C3r 2  18                   clc
0009C4r 2  69 00                adc #0
0009C6r 2  4C rr rr             bra @face
0009C9r 2  A9 08        @stand: lda #8
0009CBr 2  4C rr rr             bra @face
0009CEr 2  A9 10        @jump:  lda #16
0009D0r 2  18           @face:  clc
0009D1r 2  65 rr                adc facing
0009D3r 2  A2 21 20 rr          farjsr F_ADDSPR
0009D7r 2  rr           
0009D8r 2  60                   rts
0009D9r 2  A6 rr        @pos:   ldx tmp3                    ; the object's tile position, in pixels
0009DBr 2  BD rr rr             lda OBJS+1,x
0009DEr 2  85 rr                sta tmp4
0009E0r 2  A9 00                lda #0
0009E2r 2  85 rr                sta spx+1
0009E4r 2  A5 rr                lda tmp4
0009E6r 2  0A                   asl
0009E7r 2  26 rr                rol spx+1
0009E9r 2  0A                   asl
0009EAr 2  26 rr                rol spx+1
0009ECr 2  0A                   asl
0009EDr 2  26 rr                rol spx+1
0009EFr 2  85 rr                sta spx
0009F1r 2  A6 rr                ldx tmp3
0009F3r 2  BD rr rr             lda OBJS+2,x
0009F6r 2  85 rr                sta tmp4
0009F8r 2  A9 00                lda #0
0009FAr 2  85 rr                sta spy+1
0009FCr 2  A5 rr                lda tmp4
0009FEr 2  0A                   asl
0009FFr 2  26 rr                rol spy+1
000A01r 2  0A                   asl
000A02r 2  26 rr                rol spy+1
