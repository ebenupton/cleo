0008BAr 2               ; ---- inner blocks.  ptr = source column (already offset), sp = screen char,
0008BAr 2               ;      tmp = ra0', tmp2 = ra1'.  Full-res: source byte per line.
0008BAr 2               .macro SPRLINE k, mirror, copy, solid, blank
0008BAr 2                       .local done, skip, opaque, masked
0008BAr 2               .if k = 0
0008BAr 2                       ldaz ptr                    ; line 0: Y is not needed here
0008BAr 2               .else
0008BAr 2                       ldy #k
0008BAr 2                       lda (ptr),y
0008BAr 2               .endif
0008BAr 2               .if copy
0008BAr 2                 .if mirror
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2                 .endif
0008BAr 2                 .if k = 0
0008BAr 2                       staz sp                     ; box sprite: every byte opaque, plain copy
0008BAr 2                 .else
0008BAr 2                       sta (sp),y
0008BAr 2                 .endif
0008BAr 2               .else
0008BAr 2                 .if k = 0
0008BAr 2                       beq done                    ; 0: both pixels transparent, no store
0008BAr 2                       bpl masked                  ; (N from the load: cmp would set it from the subtraction)
0008BAr 2                       cmp #$C0
0008BAr 2                       bcc opaque                  ; bit7 alone: single opaque byte
0008BAr 2                       jmp solid                   ; bit 7+6: this and the next 7 bytes all opaque
0008BAr 2               masked: cmp #$41                    ; and the mirror image of that: this and the next 7
0008BAr 2                       beq blank                   ; all transparent, so the cell is left alone
0008BAr 2                 .else
0008BAr 2                       bmi opaque                  ; bit 7: both pixels opaque (see encode_sprite).  Tested
0008BAr 2                       beq done                    ; before the transparent case because the sprite data is
0008BAr 2                                                   ; 45.7% opaque against 24.1% transparent, and both read
0008BAr 2                                                   ; the same load's flags -- $00 is never negative
0008BAr 2                       cmp #$41                    ; a blank-run tag reached below line 0 (the packer marks
0008BAr 2                       bne :+                      ; every line a run covers): the rest of this cell is all
0008BAr 2                       jmp blank                   ; transparent, so skip it -- $41 else draws a red pixel
0008BAr 2               :
0008BAr 2                 .endif
0008BAr 2                       tax
0008BAr 2                 .if mirror
0008BAr 2                       lda MASKTAB+$80,x           ; mask of the mirrored byte (MASKTAB[SWAPTAB[x]])
0008BAr 2                 .else
0008BAr 2                       lda MASKTAB,x
0008BAr 2                 .endif
0008BAr 2                 .if k = 0
0008BAr 2                       andz sp
0008BAr 2                 .else
0008BAr 2                       and (sp),y
0008BAr 2                 .endif
0008BAr 2                 .if mirror
0008BAr 2                       ora IDENT+$80,x             ; the mirrored byte's OR value (IDENT[SWAPTAB[x]])
0008BAr 2                 .else
0008BAr 2                       ora IDENT,x
0008BAr 2                 .endif
0008BAr 2                 .if mirror
0008BAr 2                       bra skip                    ; only the mirrored form has anything at 'opaque' to
0008BAr 2                 .endif                            ; jump over; unmirrored, this branched to the next
0008BAr 2               opaque:                             ; instruction, 3 cycles on every masked byte
0008BAr 2                 .if mirror
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2                 .endif
0008BAr 2               skip:
0008BAr 2                 .if k = 0
0008BAr 2                       staz sp
0008BAr 2                 .else
0008BAr 2                       sta (sp),y
0008BAr 2                 .endif
0008BAr 2               done:
0008BAr 2               .endif
0008BAr 2               .endmacro
0008BAr 2               
0008BAr 2               .macro SOLID1 k
0008BAr 2                       ldy #k
0008BAr 2                       lda (ptr),y
0008BAr 2                       sta (sp),y
0008BAr 2               .endmacro
0008BAr 2               .macro SOLIDM k                     ; mirrored: nibble swap through the table
0008BAr 2               .if k > 0
0008BAr 2                       ldy #k
0008BAr 2                       lda (ptr),y
0008BAr 2               .endif
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2               .if k = 0
0008BAr 2                       staz sp
0008BAr 2               .else
0008BAr 2                       sta (sp),y
0008BAr 2               .endif
0008BAr 2               .endmacro
0008BAr 2               
0008BAr 2               .macro SPRFULL name, mirror, copy
0008BAr 2                       .local partial, et, l0, l1, l2, l3, l4, l5, l6, l7, pl, ps, po, pd, solid, blank
0008BAr 2               .if .not copy
0008BAr 2               solid:  ; byte 0 carried the RUN flag: the whole cell is opaque, straight copy
0008BAr 2               .if mirror
0008BAr 2                       SOLIDM 0
0008BAr 2                       SOLIDM 1
0008BAr 2                       SOLIDM 2
0008BAr 2                       SOLIDM 3
0008BAr 2                       SOLIDM 4
0008BAr 2                       SOLIDM 5
0008BAr 2                       SOLIDM 6
0008BAr 2                       SOLIDM 7
0008BAr 2                       jmp sprretM
0008BAr 2               .else
0008BAr 2                       staz sp                     ; A = byte 0
0008BAr 2                       ldy #1
0008BAr 2                       lda (ptr),y
0008BAr 2                       sta (sp),y
0008BAr 2                       iny
0008BAr 2                       lda (ptr),y
0008BAr 2                       sta (sp),y
0008BAr 2                       iny
0008BAr 2                       lda (ptr),y
0008BAr 2                       sta (sp),y
0008BAr 2                       iny
0008BAr 2                       lda (ptr),y
0008BAr 2                       sta (sp),y
0008BAr 2                       iny
0008BAr 2                       lda (ptr),y
0008BAr 2                       sta (sp),y
0008BAr 2                       iny
0008BAr 2                       lda (ptr),y
0008BAr 2                       sta (sp),y
0008BAr 2                       iny
0008BAr 2                       lda (ptr),y
0008BAr 2                       sta (sp),y
0008BAr 2                       jmp sprretP
0008BAr 2               .endif
0008BAr 2               .endif
0008BAr 2               name:
0008BAr 2                       lda tmp2
0008BAr 2                       cmp #7
0008BAr 2                       bne @np
0008BAr 2                       lda tmp
0008BAr 2                       beq l0                      ; the whole cell: the overwhelmingly common case, and
0008BAr 2                       asl                         ; it needs no table at all (was lda/asl/tax/jmpx, 21
0008BAr 2                       tax                         ; cycles of dispatch to reach the same place)
0008BAr 2                       jmpx et
0008BAr 2               @np:    jmp partial
0008BAr 2               et:     .word l0,l1,l2,l3,l4,l5,l6,l7
0008BAr 2               .if .not copy
0008BAr 2               blank:  ; byte 0 was $41: the whole cell is transparent, so there is nothing to do
0008BAr 2               .if mirror
0008BAr 2                       jmp sprretM
0008BAr 2               .else
0008BAr 2                       jmp sprretP
0008BAr 2               .endif
0008BAr 2               .endif
0008BAr 2               l0:     SPRLINE 0, mirror, copy, solid, blank
0008BAr 2               l1:     SPRLINE 1, mirror, copy, solid, blank
0008BAr 2               l2:     SPRLINE 2, mirror, copy, solid, blank
0008BAr 2               l3:     SPRLINE 3, mirror, copy, solid, blank
0008BAr 2               l4:     SPRLINE 4, mirror, copy, solid, blank
0008BAr 2               l5:     SPRLINE 5, mirror, copy, solid, blank
0008BAr 2               l6:     SPRLINE 6, mirror, copy, solid, blank
0008BAr 2               l7:     SPRLINE 7, mirror, copy, solid, blank
0008BAr 2                       .if mirror
0008BAr 2                       jmp sprretM
0008BAr 2                       .else
0008BAr 2                       jmp sprretP
0008BAr 2                       .endif
0008BAr 2               partial:
0008BAr 2                       ldy tmp
0008BAr 2               .if copy
0008BAr 2               pl:     lda (ptr),y
0008BAr 2                 .if mirror
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2                 .endif
0008BAr 2                       sta (sp),y
0008BAr 2               .else
0008BAr 2               pl:     lda (ptr),y
0008BAr 2                       bmi po                      ; bit 7: both pixels opaque.  Tested before the
0008BAr 2                       beq ps                      ; transparent case for the same reason SPRLINE does
0008BAr 2                       ; it -- 45.7% opaque against 24.1% transparent, and
0008BAr 2                       ; both read this load's flags ($00 is never negative)
0008BAr 2                       cmp #$41
0008BAr 2                       beq pd
0008BAr 2                       tax
0008BAr 2               .if mirror
0008BAr 2                       lda MASKTAB+$80,x
0008BAr 2                       and (sp),y
0008BAr 2                       ora IDENT+$80,x
0008BAr 2               .else
0008BAr 2                       lda MASKTAB,x
0008BAr 2                       and (sp),y
0008BAr 2                       ora IDENT,x
0008BAr 2               .endif
0008BAr 2                       sta (sp),y
0008BAr 2                       bra ps
0008BAr 2               po:
0008BAr 2               .if mirror
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2               .endif
0008BAr 2                       sta (sp),y
0008BAr 2               .endif
0008BAr 2               ps:     cpy tmp2
0008BAr 2                       beq pd
0008BAr 2                       iny
0008BAr 2                       bra pl
0008BAr 2               pd:
0008BAr 2                       .if mirror
0008BAr 2                       jmp sprretM
0008BAr 2                       .else
0008BAr 2                       jmp sprretP
0008BAr 2                       .endif
0008BAr 2               .endmacro
0008BAr 2               
0008BAr 2                 .if ::MODE1
0008BAr 2               ; ---- MODE 1 masked blitter.  A col entry has no spare bit, so the mask is a plane of
0008BAr 2               ; its own: one bit per game pixel, a data byte's two pixels as a 2-bit pair, four
0008BAr 2               ; horizontally adjacent columns packed into one byte (column 4g+j in bits 7-2j, 6-2j),
0008BAr 2               ; column-group-major: for group g, one byte per pixel row -- the shape of the data, so
0008BAr 2               ; mptr walks like ptr.  MASKTAB0..3 turn a whole mask byte into the AND mask for the
0008BAr 2               ; column of that phase, no shifting: $FF (both transparent) $CC $33 $00 (both opaque).
0008BAr 2               ; The two scanlines of a pixel row share a mask, so lines go in pairs, and a sprite's
0008BAr 2               ; first line in a cell is always even (refy is a multiple of 4 game px).  The data has
0008BAr 2               ; 0 in transparent pixels, so screen = (screen AND mask) OR data.  Mirrored: the pair's
0008BAr 2               ; mask is SWAPTAB of the table's answer ($33 <-> $CC), and the data byte is swapped.
0008BAr 2               .macro MLINE mirror                 ; masked store of line Y
0008BAr 2                 .if mirror
0008BAr 2                       lda (ptr),y
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2                       sta sp_ext                  ; dead during the blit
0008BAr 2                       lda (sp),y
0008BAr 2                       and sp_msk
0008BAr 2                       ora sp_ext
0008BAr 2                 .else
0008BAr 2                       lda (sp),y
0008BAr 2                       and sp_msk
0008BAr 2                       ora (ptr),y
0008BAr 2                 .endif
0008BAr 2                       sta (sp),y
0008BAr 2               .endmacro
0008BAr 2               .macro CLINE mirror                 ; plain store of line Y
0008BAr 2                       lda (ptr),y
0008BAr 2                 .if mirror
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2                 .endif
0008BAr 2                       sta (sp),y
0008BAr 2               .endmacro
0008BAr 2               .macro MPAIR k, mirror              ; lines k, k+1 of the cell
0008BAr 2                       .local opq, done
0008BAr 2                       ldy #k/2
0008BAr 2                       lda (mptr),y
0008BAr 2                       tay
0008BAr 2                       lda (mtab),y
0008BAr 2                       beq opq                     ; $00: both pixels opaque, plain stores
0008BAr 2                       cmp #$FF
0008BAr 2                       beq done                    ; both transparent
0008BAr 2                 .if mirror
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2                 .endif
0008BAr 2                       sta sp_msk
0008BAr 2                       ldy #k
0008BAr 2                       MLINE mirror
0008BAr 2                       iny
0008BAr 2                       MLINE mirror
0008BAr 2                       bra done
0008BAr 2               opq:    ldy #k
0008BAr 2                       CLINE mirror
0008BAr 2                       iny
0008BAr 2                       CLINE mirror
0008BAr 2               done:
0008BAr 2               .endmacro
0008BAr 2               .macro SPRMSK name, mirror
0008BAr 2                       .local partial, np, et, p0, p1, p2, p3, pl, pop, pnext
0008BAr 2               name:
0008BAr 2                       lda tmp2
0008BAr 2                       cmp #7
0008BAr 2                       bne np
0008BAr 2                       lda tmp                     ; even: 0,2,4,6 -> entry p0..p3
0008BAr 2                       beq p0
0008BAr 2                       tax
0008BAr 2                       jmpx et
0008BAr 2               np:     jmp partial
0008BAr 2               et:     .word p0, p1, p2, p3
0008BAr 2               p0:     MPAIR 0, mirror
0008BAr 2               p1:     MPAIR 2, mirror
0008BAr 2               p2:     MPAIR 4, mirror
0008BAr 2               p3:     MPAIR 6, mirror
0008BAr 2                 .if mirror
0008BAr 2                       jmp sprretMk
0008BAr 2                 .else
0008BAr 2                       jmp sprretPk
0008BAr 2                 .endif
0008BAr 2               partial:                            ; lines tmp..tmp2: tmp even, tmp2 odd
0008BAr 2                       lda tmp
0008BAr 2                       sta sp_lim
0008BAr 2               pl:     lda sp_lim
0008BAr 2                       lsr
0008BAr 2                       tay
0008BAr 2                       lda (mptr),y
0008BAr 2                       tay
0008BAr 2                       lda (mtab),y
0008BAr 2                       beq pop
0008BAr 2                       cmp #$FF
0008BAr 2                       beq pnext
0008BAr 2                 .if mirror
0008BAr 2                       tax
0008BAr 2                       lda SWAPTAB,x
0008BAr 2                 .endif
0008BAr 2                       sta sp_msk
0008BAr 2                       ldy sp_lim
0008BAr 2                       MLINE mirror
0008BAr 2                       iny
0008BAr 2                       MLINE mirror
0008BAr 2                       bra pnext
0008BAr 2               pop:    ldy sp_lim
0008BAr 2                       CLINE mirror
0008BAr 2                       iny
0008BAr 2                       CLINE mirror
0008BAr 2               pnext:  lda sp_lim
0008BAr 2                       inca
0008BAr 2                       inca
0008BAr 2                       sta sp_lim
0008BAr 2                       cmp tmp2
0008BAr 2                       bcc pl
0008BAr 2                 .if mirror
0008BAr 2                       jmp sprretMk
0008BAr 2                 .else
0008BAr 2                       jmp sprretPk
0008BAr 2                 .endif
0008BAr 2               .endmacro
0008BAr 2                 .endif
0008BAr 2               ; The row loop and the inner blocks.  On the Master this is plain code after the
0008BAr 2               ; prologue; on the Model B it is assembled once into EACH sprite data bank (the loop
0008BAr 2               ; reads image bytes, so it must be resident with them) and reached by a far call
0008BAr 2               ; from the prologue, which lives with the directory in bank 5.
0008BAr 2               .macro SPRITE_LOOPS withmirror, withcopy   ; withmirror = 0: a copy for a bank whose
0008BAr 2                 .if ::MODELB                      ; images are never drawn mirrored (no sprFM, no
0008BAr 2                                                   ; SWAPTAB); withcopy = 0: none drawn by the copy
0008BAr 2                                                   ; blitter (no sprFC)
0008BAr 2               ds_entry:                           ; the far entry: the dispatch jump is patched here,
0008BAr 2                       ldx sp_disp                 ; in the bank that owns it
0008BAr 2                       lda sprdisp_tab,x
0008BAr 2                       sta ds_dispatch+1
0008BAr 2                       lda sprdisp_tab+1,x
0008BAr 2                       sta ds_dispatch+2
0008BAr 2                 .endif
0008BAr 2               ds_rowloop:
0008BAr 2                       lda sp_rb
0008BAr 2                       sta sp
0008BAr 2                       lda sp_rb+1
0008BAr 2                       sta sp+1
0008BAr 2                       lda sp_rp
0008BAr 2                       sta ptr
0008BAr 2                       lda sp_rp+1
0008BAr 2                       sta ptr+1
0008BAr 2                 .if ::MODE1
0008BAr 2                       lda sp_mrp
0008BAr 2                       sta mptr
0008BAr 2                       lda sp_mrp+1
0008BAr 2                       sta mptr+1
0008BAr 2                       lda sp_mpg0
0008BAr 2                       sta mtab+1
0008BAr 2                 .endif
0008BAr 2                       ; ra range for this row
0008BAr 2                       stz tmp                     ; ra0' = 0 unless this is the first row
0008BAr 2                       lda sp_row
0008BAr 2                       cmp sp_r0
0008BAr 2                       bne :+
0008BAr 2                       ldx sp_ra0
0008BAr 2                       stx tmp
0008BAr 2               :       ldx #7
0008BAr 2                       cmp sp_r1
0008BAr 2                       bne :+
0008BAr 2                       ldx sp_ra1
0008BAr 2               :       stx tmp2                    ; ra1'
0008BAr 2                       lda sp_ncol
0008BAr 2                       sta sp_cnt                  ; columns-1 (countdown)
0008BAr 2               ds_colloop:
0008BAr 2               ds_dispatch:
0008BAr 2                       jmp sprFN                   ; operand patched per sprite
0008BAr 2                 .if withmirror
0008BAr 2               sprdisp_tab: .word sprFN, sprFM, sprFN, sprFM
0008BAr 2                 .else
0008BAr 2               sprdisp_tab: .word sprFN, sprFN, sprFN, sprFN
0008BAr 2                 .endif
0008BAr 2                 .if withcopy
0008BAr 2                       .word sprFC
0008BAr 2                 .else
0008BAr 2                       .word sprFN
0008BAr 2                 .endif
0008BAr 2                 .if withmirror
0008BAr 2                 .if ::MODE1
0008BAr 2               sprretMk:                           ; mask blitter, mirrored: the image column descends,
0008BAr 2                       dec mtab+1                  ; so the phase (= page & 3) does too; below phase 0
0008BAr 2                       lda mtab+1                  ; it is the previous group's phase 3
0008BAr 2                       and #3
0008BAr 2                       cmp #3
0008BAr 2                       bne @mk
0008BAr 2                       lda mtab+1
0008BAr 2                       clc
0008BAr 2                       adc #4
0008BAr 2                       sta mtab+1
0008BAr 2                       lda mptr
0008BAr 2                       sec
0008BAr 2                       sbc sp_mh
0008BAr 2                       sta mptr
0008BAr 2                       bcs @mk
0008BAr 2                       dec mptr+1
0008BAr 2               @mk:
0008BAr 2                 .endif
0008BAr 2               sprretM:                            ; next column, mirrored: source pointer - lines
0008BAr 2                       lda ptr
0008BAr 2                       sec
0008BAr 2                       sbc sp_lines
0008BAr 2                       sta ptr
0008BAr 2                       bcs sprnext
0008BAr 2                       dec ptr+1
0008BAr 2                       bra sprnext
0008BAr 2                 .endif
0008BAr 2                 .if ::MODE1
0008BAr 2               sprretPk:                           ; mask blitter: next phase is the next page; past
0008BAr 2                       inc mtab+1                  ; phase 3 it is the next group's phase 0
0008BAr 2                       lda mtab+1
0008BAr 2                       and #3
0008BAr 2                       bne @pk
0008BAr 2                       lda mtab+1
0008BAr 2                       sec
0008BAr 2                       sbc #4
0008BAr 2                       sta mtab+1
0008BAr 2                       lda mptr
0008BAr 2                       clc
0008BAr 2                       adc sp_mh
0008BAr 2                       sta mptr
0008BAr 2                       bcc @pk
0008BAr 2                       inc mptr+1
0008BAr 2               @pk:
0008BAr 2                 .endif
0008BAr 2               sprretP:                            ; next column: source pointer + lines
0008BAr 2                       lda ptr
0008BAr 2                       clc
0008BAr 2                       adc sp_lines
0008BAr 2                       sta ptr
0008BAr 2                       bcc sprnext
0008BAr 2                       inc ptr+1
0008BAr 2               sprnext:
0008BAr 2                       spnext
0008BAr 2                       dec sp_cnt
0008BAr 2                 .if ::MODELB
0008BAr 2                       bmi ds_rowdone              ; (the 6502 spellings put ds_colloop out of reach)
0008BAr 2                       jmp ds_colloop
0008BAr 2                 .else
0008BAr 2                       bpl ds_colloop
0008BAr 2                 .endif
0008BAr 2               ds_rowdone:
0008BAr 2                       lda sp_row
0008BAr 2                       cmp sp_r1
0008BAr 2                       beq ds_done
0008BAr 2                       inc sp_row
0008BAr 2                       lda sp_rp
0008BAr 2                       clc
0008BAr 2                       adc sp_rinc
0008BAr 2                       sta sp_rp
0008BAr 2                       bcc :+
0008BAr 2                       inc sp_rp+1
0008BAr 2                       clc
0008BAr 2               :
0008BAr 2                 .if ::MODE1
0008BAr 2                       lda sp_mrp
0008BAr 2                       adc #4                      ; C is clear
0008BAr 2                       sta sp_mrp
0008BAr 2                       bcc @mrnc
0008BAr 2                       inc sp_mrp+1
0008BAr 2                       clc
0008BAr 2               @mrnc:
0008BAr 2                 .endif
0008BAr 2                       lda sp_rb
0008BAr 2                       adc #<ROWBYTES
0008BAr 2                       sta sp_rb
0008BAr 2                       lda sp_rb+1
0008BAr 2                       adc #>ROWBYTES
0008BAr 2                       ringup sp_rb
0008BAr 2                       sta sp_rb+1
0008BAr 2                       jmp ds_rowloop
0008BAr 2               ds_done: rts
0008BAr 2               
0008BAr 2                 .if ::MODE1
0008BAr 2                       SPRMSK sprFN, 0
0008BAr 2                 .if withmirror
0008BAr 2                       SPRMSK sprFM, 1
0008BAr 2                 .endif
0008BAr 2               mask4:  .byte $FF, $CC, $33, $00    ; AND mask by pair (bit 1 = left opaque, bit 0 = right):
0008BAr 2                                                   ; keep what is NOT opaque -- right only opaque keeps the left dots
0008BAr 2                 .else
0008BAr 2                       SPRFULL sprFN, 0, 0
0008BAr 2                 .if withmirror
0008BAr 2                       SPRFULL sprFM, 1, 0
0008BAr 2                 .endif
0008BAr 2                 .endif
0008BAr 2               .endmacro
0008BAr 2                 .if ::MODELB
0008BAr 2                       .segment "SPR4CODE"
000000r 2                       .scope spr4
000000r 2  A6 E7 BD rr          SPRITE_LOOPS 1, ::SPR4_COPY ; (assets.inc: the packer puts the box stars in one
000004r 2  rr 8D rr rr  
000008r 2  BD rr rr 8D  
000407r 2                       .if ::SPR4_COPY             ;  bank and no mirrored image in the other)
000407r 2                       SPRFULL sprFC, 0, 1
000407r 2                       .endif
000407r 2                       .endscope
000407r 2                       .segment "SPR6CODE"
000000r 2                       .scope spr6
000000r 2  A6 E7 BD rr          SPRITE_LOOPS ::SPR6_MIRROR, 1
000004r 2  rr 8D rr rr  
000008r 2  BD rr rr 8D  
00021Cr 2  A5 rr C9 07          SPRFULL sprFC, 0, 1
000220r 2  D0 15 A5 rr  
000224r 2  F0 24 0A AA  
000290r 2                       .endscope
000290r 2                       PLACE "CODE", "TILCODE"
0008BAr 2                 .else
0008BAr 2                       SPRITE_LOOPS 1, 1
0008BAr 2                 .if ::MODE1
0008BAr 2               sp_mpg0:  .res 1                  ; MASKTAB page of the sprite's first column: >MASKTAB0 | phase
0008BAr 2               sp_mh:    .res 1                  ; pixel rows = mask bytes per column group
0008BAr 2               sp_mrp:   .res 2                  ; mask pointer for the current row's first column
0008BAr 2               sp_mbase: .res 2                  ; the sprite's mask plane
0008BAr 2               SWAPTAB:   .res 256               ; four-dot reversal for mirroring (from TABLES in MODE 2)
0008BAr 2               SECTAB:    .res 2*48              ; per buffer: 6 sections x 8 bytes
0008BAr 2               music_tab: .res 144               ; SN76489 periods for MIDI 24..95, decoded at start-up
0008BAr 2                 .endif
0008BAr 2                       SPRFULL sprFC, 0, 1         ; box stars: pre-composited on their background, no mask
0008BAr 2                 .endif
0008BAr 2               
0008BAr 2               ; (There were half-res blitters here -- one source byte to two screen lines -- for the
0008BAr 2               ; title's Cleo frames.  Every image is full-res now, so entries 0/1 of sprdisp_tab
0008BAr 2               ; alias the full blitters and the flag bit is vestigial.)
0008BAr 2               
0008BAr 2               ; ============================================================================
0008BAr 2               ; copy_partial: copy lines wfine..7 of ring row wcy into lines 0..(7-wfine) of the
0008BAr 2               ; ring row above the window (the "A" section source), for the columns drawn since.
0008BAr 2               ; ============================================================================
0008BAr 2               copy_partial:
0008BAr 2  A5 rr                lda wfine
0008BCr 2  D0 01                bne :+
0008BEr 2  60                   rts
0008BFr 2  A6 rr        :       ldx curbuf
0008C1r 2  DD rr rr             cmp PART_F,x
0008C4r 2  D0 25                bne @all
0008C6r 2  A5 rr                lda wcy
0008C8r 2  DD rr rr             cmp PART_CY,x
0008CBr 2  D0 1E                bne @all
0008CDr 2                       ; same source row and lines as last time: only the columns drawn since.  A
0008CDr 2                       ; horizontal scroll does not matter: the composed row is a ring row at a fixed
0008CDr 2                       ; offset from its source, so it moves with the ring and stays valid
0008CDr 2  BD rr rr             lda PART_HI,x
0008D0r 2  C9 50                cmp #ROWCHARS
0008D2r 2  90 02                bcc :+
0008D4r 2  A9 4F                lda #(ROWCHARS-1)
0008D6r 2  38           :       sec
0008D7r 2  FD rr rr             sbc PART_LO,x
0008DAr 2  B0 01                bcs :+
0008DCr 2  60                   rts                         ; nothing drawn in the top row
0008DDr 2  85 DF E6 DF  :       inca
0008E1r 2  A5 DF        
0008E3r 2  85 rr                sta cnt
0008E5r 2  BD rr rr             lda PART_LO,x
0008E8r 2  4C rr rr             bra @go
0008EBr 2  A5 rr        @all:   lda wfine
0008EDr 2  9D rr rr             sta PART_F,x
0008F0r 2  A5 rr                lda wcy
0008F2r 2  9D rr rr             sta PART_CY,x
0008F5r 2  A9 50                lda #ROWCHARS
0008F7r 2  85 rr                sta cnt
0008F9r 2  A9 00                lda #0
0008FBr 2  85 rr        @go:    sta tmp4                    ; first column to copy
0008FDr 2  18                   clc
0008FEr 2  65 rr                adc wcx
000900r 2  85 rr                sta w16
000902r 2  A5 rr                lda wcx+1
000904r 2  69 00                adc #0
000906r 2  85 rr                sta w16+1
000908r 2  A9 FF                lda #$FF                    ; range is clean once copied
00090Ar 2  9D rr rr             sta PART_LO,x
00090Dr 2  48 A9 00 9D          stza PART_HI, x
000911r 2  rr rr 68     
000914r 2                 .if MODELB
000914r 2  A5 rr                lda barq                    ; the composed row is the ring row above the window,
000916r 2  D0 0C                bne @nomir                  ; the last slot when the window starts at slot 0
000918r 2  A5 rr                lda tmp4
00091Ar 2  18                   clc
00091Br 2  65 rr                adc cnt
00091Dr 2  AA                   tax
00091Er 2  CA                   dex
00091Fr 2  A5 rr                lda tmp4
000921r 2  20 rr rr             jsr mirdirty
000924r 2               @nomir:
000924r 2                 .endif
000924r 2  A5 rr                lda wcy
000926r 2  20 rr rr             jsr ringaddr                ; sp = source start (row wcy, first dirty column)
000929r 2                       ; source: sp is the char, and the copy starts wfine lines into it.  Offsetting
000929r 2                       ; sp by wfine (under 8, and a char is 8-aligned) keeps its page crossings on
000929r 2                       ; the real char boundaries, so spnext's fold still lands where it should
000929r 2  A5 rr                lda sp
00092Br 2  18                   clc
00092Cr 2  65 rr                adc wfine
00092Er 2  85 rr                sta sp
000930r 2                       ; dest: the same column of the composed row, ring char (ringS + col + 2480)
000930r 2                       ; mod 2560 -- the row above the window -- as a real address from RINGBASE
000930r 2  A5 rr                lda tmp4
000932r 2  18                   clc
000933r 2  65 rr                adc ringS
000935r 2  85 rr                sta ptr
000937r 2  A5 rr                lda ringS+1
000939r 2  69 00                adc #0
00093Br 2  85 rr                sta ptr+1
00093Dr 2  A5 rr                lda ptr
00093Fr 2  18                   clc
000940r 2  69 E0                adc #<(RINGCHARS-ROWCHARS)
000942r 2  85 rr                sta ptr
000944r 2  A5 rr                lda ptr+1
000946r 2  69 06                adc #>(RINGCHARS-ROWCHARS)
000948r 2                 .if MODELB
000948r 2  85 rr                sta ptr+1                   ; 23 rows of chars is not whole pages: 16-bit fold
00094Ar 2  C9 07                cmp #>RINGCHARS
00094Cr 2  90 15                bcc @pnf
00094Er 2  D0 06                bne @pfold
000950r 2  A5 rr                lda ptr
000952r 2  C9 30                cmp #<RINGCHARS
000954r 2  90 0D                bcc @pnf
000956r 2  A5 rr        @pfold: lda ptr
000958r 2  38                   sec
000959r 2  E9 30                sbc #<RINGCHARS
00095Br 2  85 rr                sta ptr
00095Dr 2  A5 rr                lda ptr+1
00095Fr 2  E9 07                sbc #>RINGCHARS
000961r 2  85 rr                sta ptr+1
000963r 2               @pnf:
000963r 2                 .else
000963r 2                       cmp #>RINGCHARS             ; RINGCHARS is whole pages, so the fold is a
000963r 2                       bcc @pnf                    ; high-byte compare
000963r 2                       sbc #>RINGCHARS
000963r 2               @pnf:   sta ptr+1
000963r 2                 .endif
000963r 2  06 rr                asl ptr                     ; char -> byte address, + RINGBASE (the rols leave
000965r 2  26 rr                rol ptr+1                   ; C clear: the offset is under $5000)
000967r 2  06 rr                asl ptr
000969r 2  26 rr                rol ptr+1
00096Br 2  06 rr                asl ptr
00096Dr 2  26 rr                rol ptr+1
00096Fr 2                 .if MODELB
00096Fr 2  A5 rr                lda ptr                     ; the base is xx80, and which xx is the buffer's
000971r 2  69 80                adc #<RING_A
000973r 2  85 rr                sta ptr
000975r 2  A5 rr                lda ptr+1
000977r 2  65 E0                adc ringbhi
000979r 2                 .else
000979r 2                       lda ptr+1
000979r 2                       adc #>RINGBASE
000979r 2                 .endif
000979r 2  85 rr                sta ptr+1
00097Br 2                       ; Y is the dest line, 0..7-wfine, and the source line is Y + wfine through the
00097Br 2                       ; offset sp: enter the unrolled copy at the pair for this wfine.  (A loop here
00097Br 2                       ; is 40 bytes smaller and ~1% of a frame slower: every frame with vertical
00097Br 2                       ; movement recomposes all 80 columns.)
00097Br 2  A6 rr                ldx wfine
00097Dr 2  BD rr rr             lda @ftab-2,x
000980r 2  8D rr rr             sta @fjmp+1
000983r 2  BD rr rr             lda @ftab-1,x
000986r 2  8D rr rr             sta @fjmp+2
000989r 2  A6 rr                ldx cnt                     ; char counter in X: dex/beq is 3 cycles cheaper
00098Br 2  4C rr rr     @fjmp:  jmp @g4
00098Er 2  rr rr rr rr  @ftab:  .word @g4, @g2, @g0         ; wfine 2: six lines, 4: four, 6: two
000992r 2  rr rr        
000994r 2  A0 05        @g4:    ldy #5
000996r 2  B1 rr                lda (sp),y
000998r 2  91 rr                sta (ptr),y
00099Ar 2  88                   dey
00099Br 2  B1 rr                lda (sp),y
00099Dr 2  91 rr                sta (ptr),y
00099Fr 2  A0 03        @g2:    ldy #3
0009A1r 2  B1 rr                lda (sp),y
0009A3r 2  91 rr                sta (ptr),y
0009A5r 2  88                   dey
0009A6r 2  B1 rr                lda (sp),y
0009A8r 2  91 rr                sta (ptr),y
0009AAr 2  A0 01        @g0:    ldy #1
0009ACr 2  B1 rr                lda (sp),y
0009AEr 2  91 rr                sta (ptr),y
0009B0r 2  88                   dey
0009B1r 2  B1 rr                lda (sp),y
0009B3r 2  91 rr                sta (ptr),y
0009B5r 2                       ; next char, both with the ring fold on the page crossing: the composed row
0009B5r 2                       ; can straddle the ring end like any other row
0009B5r 2  A5 rr 18 69          spnext
0009B9r 2  08 85 rr 90  
0009BDr 2  1B A5 rr 85  
0009D9r 2  CA                   dex
0009DAr 2  F0 27                beq @done
0009DCr 2  A5 rr                lda ptr
0009DEr 2  18                   clc
0009DFr 2  69 08                adc #8
0009E1r 2  85 rr                sta ptr
0009E3r 2  90 A6                bcc @fjmp
0009E5r 2  A5 rr                lda ptr+1
0009E7r 2  85 DF E6 DF          inca
0009EBr 2  A5 DF        
0009EDr 2  C5 E1 90 0D          ringup ptr
0009F1r 2  E9 39 48 A5  
0009F5r 2  rr 38 E9 80  
0009FEr 2  85 rr                sta ptr+1
000A00r 2  4C rr rr             bra @fjmp
000A03r 2  60           @done:  rts
000A04r 2               
000A04r 2               ; ============================================================================
000A04r 2               ; calc_ring: ringS = ((wcy & 31) * 80 + wcx) mod 2560 ; barq = ringS / 80
000A04r 2               ; ============================================================================
000A04r 2               ; copy_bar: if this buffer's bar rows are stale, write bar image into ring slots q-3, q-2
000A04r 2               ; The bar has a fixed home outside the ring, so it stays put however the window
000A04r 2               ; scrolls and is only written when its contents change.  It used to live in the two
000A04r 2               ; ring rows above the window, which move every frame the view scrolls vertically;
000A04r 2               ; re-copying 1280 bytes for that cost 13,310 cycles of an 80,000 cycle frame.
000A04r 2               ; bar_bg: blit the static bar template (icons, labels, blank digit slots) from bank 4
000A04r 2               ; into the current back buffer's fixed bar rows.  Source art, not a maintained buffer.
000A04r 2                       PLACE "CODE", "LGCCODE"     ; Model B: the bar is loaded into place by the loader
000000r 2               bar_bg:                             ; and never redrawn: only the digit cache is reset
000000r 2  A2 08                ldx #8                      ; level).  The template buries the digits, so the
000002r 2  A9 FF                lda #$FF                    ; cached "already drawn" values are no longer true.
000004r 2  9D rr rr     @bci:   sta BARCACHE,x              ; (One bar, one cache: this used to index it by
000007r 2  CA                   dex                         ; curbuf and, at a level start with curbuf = 1,
000008r 2  10 FA                bpl @bci                    ; reset the wrong 16 bytes and left the digits stale)
00000Ar 2                 .if MODELB
00000Ar 2  60                   rts
00000Br 2                 .else
00000Br 2                       lda #HUD_BANK               ; The bar is black with a few icon spans, so
00000Br 2                                                   ; fill black and lay the spans (BARBUF is now the span
00000Br 2                       sta ROMSEL_CPY              ; list: offset16, len, bytes... ending $FFFF).
00000Br 2                       sta ROMSEL
00000Br 2                 .if MODE1
00000Br 2                       lda #0                      ; MODE 1 black is plain 0: no opaque-black tag
00000Br 2                 .else
00000Br 2                       lda #$C0                    ; BARADDR is a constant, so the fill needs no pointer:
00000Br 2                 .endif
00000Br 2                       ldx #0                      ; five abs,x stores cover the 5 pages in one pass
00000Br 2               @bf:    sta BARADDR+$000,x
00000Br 2                       sta BARADDR+$100,x
00000Br 2                       sta BARADDR+$200,x
00000Br 2                       sta BARADDR+$300,x
00000Br 2                       sta BARADDR+$400,x
00000Br 2                       inx
00000Br 2                       bne @bf
00000Br 2                       lda #<BARBUF
00000Br 2                       sta w16
00000Br 2                       lda #>BARBUF
00000Br 2                       sta w16+1
00000Br 2               @bs:    ldy #1
00000Br 2                       lda (w16),y                 ; offset high ($FF = end)
00000Br 2                       cmp #$FF
00000Br 2                       beq @bsdone
00000Br 2                       tax                         ; X is free: the @bf counter ran down to 0
00000Br 2                       ldaz w16                    ; offset low, (zp): no dey needed
00000Br 2                       clc
00000Br 2                       adc #<BARADDR
00000Br 2                       sta w16b
00000Br 2                       txa
00000Br 2                       adc #>BARADDR
00000Br 2                       sta w16b+1
00000Br 2                       ldy #2
00000Br 2                       lda (w16),y
00000Br 2                       sta tmp2                    ; len
00000Br 2                       lda w16                     ; step past the 3-byte header
00000Br 2                       clc
00000Br 2                       adc #3
00000Br 2                       sta w16
00000Br 2                       bcc :+
00000Br 2                       inc w16+1
00000Br 2               :       ldy #0
00000Br 2               @bc:    lda (w16),y
00000Br 2                       sta (w16b),y
00000Br 2                       iny
00000Br 2                       cpy tmp2
00000Br 2                       bne @bc
00000Br 2                       tya                         ; step past the data
00000Br 2                       clc
00000Br 2                       adc w16
00000Br 2                       sta w16
00000Br 2                       bcc @bs
00000Br 2                       inc w16+1
00000Br 2                       bra @bs
00000Br 2               @bsdone: rts
00000Br 2                 .endif
00000Br 2               
00000Br 2               ; ============================================================================
00000Br 2                 .if .not MODELB                   ; (Model B: its rupture chain is modelb/src/display.s)
00000Br 2                       .segment "LOGIC"           ; main RAM is full on a Master: this touches
00000Br 2                                                   ; nothing but main RAM and the CRTC, so it can
00000Br 2                                                   ; live in the bank the game logic already uses
00000Br 2               ; build_sections: fill SECTAB for the current buffer from ringS and wfine.
00000Br 2               ; entry i: R12n, R13n, R4, R9, R6, R7, T1lo, T1hi (T1 = duration of section i+1)
00000Br 2               ;
00000Br 2               ; The bar and the partial row have fixed homes, so only the playfield walks the ring.
00000Br 2               ; A row starting past RINGCHARS-80 straddles the ring end; it is read from the mirror
00000Br 2               ; sitting immediately below the ring base, which makes its address c - RINGCHARS in
00000Br 2               ; ring-offset terms, and every row after it follows on contiguously.  That costs one
00000Br 2               ; extra section whenever the window straddles.
00000Br 2               ; ============================================================================
00000Br 2               LINE = 64
00000Br 2               BARLEAD = 10                        ; us the bar's T1 fires early, beyond the lead every
00000Br 2                                                   ; step has, so ACCCON D can be switched in the
00000Br 2                                                   ; blanking of the bar's last line
00000Br 2               BARCRTC  = BARADDR / 8
00000Br 2                       .code
00000Br 2                       .segment "LOGIC"            ; back to the bank
00000Br 2               build_sections:
00000Br 2                       lda curbuf
00000Br 2                       asl
00000Br 2                       tax
00000Br 2                       lda #>BARCRTC               ; section 0 is the bar: fixed address, fixed length
00000Br 2                       sta BUF_SEC0,x
00000Br 2                       lda #<BARCRTC
00000Br 2                       sta BUF_SEC0+1,x
00000Br 2                       lda #<(BARROWS*8*LINE-2-BARLEAD)   ; the bar's step fires early: see the ISR
00000Br 2                       sta BUF_SEC0T1,x
00000Br 2                       lda #>(BARROWS*8*LINE-2-BARLEAD)
00000Br 2                       sta BUF_SEC0T1+1,x
00000Br 2                       ldx curbuf
00000Br 2                       beq :+
00000Br 2                       ldx #48
00000Br 2               :       lda #1
00000Br 2                       sta SECTAB+2,x
00000Br 2                       lda #7
00000Br 2                       sta SECTAB+3,x
00000Br 2                       lda #2
00000Br 2                       sta SECTAB+4,x
00000Br 2                       lda #30
00000Br 2                       sta SECTAB+5,x
00000Br 2                       lda wfine
00000Br 2                       beq @coarse
00000Br 2                       ; ---- f > 0 : T -> A (the partial row) -> P.. -> P2 -> Q
00000Br 2                       eor #7                      ; wfine is still in A from the test above
00000Br 2                       inca                        ; 8-f lines of it
00000Br 2                       jsr @dur
00000Br 2                       sta SECTAB+6,x
00000Br 2                       lda tmp3
00000Br 2                       sta SECTAB+7,x
00000Br 2                       lda ringS                   ; section A shows the composed row: the ring row
00000Br 2                       sec                         ; above the window, ringS - 80 mod RINGCHARS
00000Br 2                       sbc #ROWCHARS
00000Br 2                       sta w16
00000Br 2                       lda ringS+1
00000Br 2                       sbc #0
00000Br 2                       bpl :+
00000Br 2                       adc #>RINGCHARS             ; went below 0: + RINGCHARS (whole pages; C clear)
00000Br 2               :       sta w16+1
00000Br 2                       jsr @addr
00000Br 2                       txa
00000Br 2                       clc
00000Br 2                       adc #8
00000Br 2                       tax                         ; A's entry
00000Br 2                       stz SECTAB+2,x
00000Br 2                       lda wfine
00000Br 2                       eor #7                      ; 7 - wfine, wfine in 0..7
00000Br 2                       sta SECTAB+3,x
00000Br 2                       lda #2
00000Br 2                       sta SECTAB+4,x
00000Br 2                       lda #30
00000Br 2                       sta SECTAB+5,x
00000Br 2                       lda ringS                   ; the run starts one row into the window
00000Br 2                       clc
00000Br 2                       adc #ROWCHARS
00000Br 2                       sta w16
00000Br 2                       lda ringS+1
00000Br 2                       adc #0
00000Br 2                       sta w16+1
00000Br 2                       jsr @wrap
00000Br 2                       lda #VISROWS-1
00000Br 2                       sta tmp4                    ; rows in the run
00000Br 2                       lda barq
00000Br 2                       inca
00000Br 2                       cmp #RINGROWS
00000Br 2                       bcc :+
00000Br 2                       lda #0
00000Br 2               :       sta tmp3
00000Br 2                       bra @run
00000Br 2               @coarse:                            ; ---- f = 0 : T -> P.. -> Q
00000Br 2                       lda ringS
00000Br 2                       sta w16
00000Br 2                       lda ringS+1
00000Br 2                       sta w16+1
00000Br 2                       lda #VISROWS
00000Br 2                       sta tmp4
00000Br 2                       lda barq                    ; the run starts on the window's ring row
00000Br 2                       sta tmp3
00000Br 2               @run:   ; w16 = the run's ring offset, tmp4 = its rows, X = the entry of the section
00000Br 2                       ; before it.  Entry i carries section i+1's address and duration, and section
00000Br 2                       ; i's own R4/R9/R6/R7, so each section is written across two entries.
00000Br 2                       ; The run is never split any more: a row that straddles the ring end is
00000Br 2                       ; folded by the CRTC, so the playfield is one section however the window sits.
00000Br 2                       lda tmp4
00000Br 2                       sta tmp2
00000Br 2                       jsr @emit
00000Br 2               @past:  lda tmp4
00000Br 2                       jsr @advance                ; now the row below the playfield
00000Br 2                       lda wfine
00000Br 2                       beq @setq
00000Br 2                       ; --- P2 : the top f lines of that row
00000Br 2                       jsr @addr
00000Br 2                       lda wfine
00000Br 2                       jsr @dur
00000Br 2                       sta SECTAB+6,x
00000Br 2                       lda tmp3
00000Br 2                       sta SECTAB+7,x
00000Br 2                       txa
00000Br 2                       clc
00000Br 2                       adc #8
00000Br 2                       tax
00000Br 2                       stza SECTAB+2,x             ; stz abs,x
00000Br 2                       lda wfine
00000Br 2                       deca
00000Br 2                       sta SECTAB+3,x
00000Br 2                       lda #VISROWS
00000Br 2                       sta SECTAB+4,x
00000Br 2                       lda #30
00000Br 2                       sta SECTAB+5,x
00000Br 2                       lda SECTAB-8,x              ; w16 has not moved since the P2 @addr above, so the
00000Br 2                       sta SECTAB,x                ; address it left in the previous entry is this one's
00000Br 2                       lda SECTAB-8+1,x
00000Br 2                       sta SECTAB+1,x
00000Br 2                       bra @sq2
00000Br 2               @setq:  jsr @addr                   ; Q starts on the row below the playfield
00000Br 2               @sq2:   lda #<(40*LINE-2)
00000Br 2                       sta SECTAB+6,x
00000Br 2                       lda #>(40*LINE-2)
00000Br 2                       sta SECTAB+7,x
00000Br 2                       txa
00000Br 2                       clc
00000Br 2                       adc #8
00000Br 2                       tax
00000Br 2                       lda #>BARCRTC               ; and hands the chain back to the bar
00000Br 2                       sta SECTAB,x
00000Br 2                       lda #<BARCRTC
00000Br 2                       sta SECTAB+1,x
00000Br 2                       lda #QROWS-1
00000Br 2                       sta SECTAB+2,x
00000Br 2                       lda #7
00000Br 2                       sta SECTAB+3,x
00000Br 2                       stza SECTAB+4, x
00000Br 2                       lda #QVSYNC
00000Br 2                       sta SECTAB+5, x
00000Br 2                       lda #<(40*LINE-2)
00000Br 2                       sta SECTAB+6, x
00000Br 2                       lda #>(40*LINE-2)
00000Br 2                       sta SECTAB+7, x
00000Br 2                       ; the bar's step fired BARLEAD early, so the section after the bar -- whose
00000Br 2                       ; duration entry 0 carries -- runs BARLEAD longer to end where it should
00000Br 2                       ldx curbuf
00000Br 2                       beq @e0
00000Br 2                       ldx #48
00000Br 2               @e0:    lda SECTAB+6,x
00000Br 2                       clc
00000Br 2                       adc #BARLEAD
00000Br 2                       sta SECTAB+6,x
00000Br 2                       bcc @e1
00000Br 2                       inc SECTAB+7,x
00000Br 2               @e1:    rts
00000Br 2               ; --- emit a run of tmp2 rows starting at w16 (a ring offset), following entry X
00000Br 2               @emit:  jsr @addr
00000Br 2                       lda tmp2
00000Br 2                       jsr @lines
00000Br 2                       sta SECTAB+6,x
00000Br 2                       lda tmp3
00000Br 2                       sta SECTAB+7,x
00000Br 2                       txa
00000Br 2                       clc
00000Br 2                       adc #8
00000Br 2                       tax
00000Br 2                       lda tmp2
00000Br 2                       deca
00000Br 2                       sta SECTAB+2,x
00000Br 2                       lda #7
00000Br 2                       sta SECTAB+3,x
00000Br 2                       lda #30
00000Br 2                       sta SECTAB+4,x
00000Br 2                       sta SECTAB+5,x
00000Br 2                       rts
00000Br 2               ; --- SECTAB+0/1,x = the CRTC address for the row at ring offset w16.  Ring offsets are
00000Br 2               ; 0..RINGCHARS-1 and CRTCBASE is $600, so the sum is always under $1000 and MA12 is
00000Br 2               ; clear: a section's START address never needs folding.  The fold happens mid-scan, in
00000Br 2               ; hardware, which is the whole reason the ring begins at $3000.
00000Br 2               @addr:  lda w16
00000Br 2                       ldy w16+1
00000Br 2                       clc
00000Br 2                       adc #<CRTCBASE
00000Br 2                       sta SECTAB+1,x
00000Br 2                       tya
00000Br 2                       adc #>CRTCBASE
00000Br 2                       sta SECTAB,x
00000Br 2                       rts
00000Br 2                       ; --- A = rows -> A/tmp3 = that many rows of lines, as a T1 count
00000Br 2               @lines: asl
00000Br 2                       asl
00000Br 2                       asl
00000Br 2                       jmp @dur
00000Br 2                       ; --- A = rows: advance w16 by that many rows, folding into 0..RINGCHARS
00000Br 2               @advance:
00000Br 2                       tay
00000Br 2                       clc
00000Br 2                       lda w16
00000Br 2                       adc mulrowlo,y
00000Br 2                       sta w16
00000Br 2                       lda w16+1
00000Br 2                       adc mulrowhi,y
00000Br 2                       sta w16+1
00000Br 2                       ; fall through
00000Br 2               @wrap:  lda w16+1
00000Br 2                       cmp #>RINGCHARS
00000Br 2                       bcc :++
00000Br 2                       bne :+
00000Br 2                       lda w16
00000Br 2                       cmp #<RINGCHARS
00000Br 2                       bcc :++
00000Br 2               :       lda w16
00000Br 2                       sec
00000Br 2                       sbc #<RINGCHARS
00000Br 2                       sta w16
00000Br 2                       lda w16+1
00000Br 2                       sbc #>RINGCHARS
00000Br 2                       sta w16+1
00000Br 2               :       rts
00000Br 2               ; A = lines -> A/tmp3 = lines*64-2
00000Br 2               @dur:   sta tmp3                    ; n*64 == (n*256)>>2: start from hi=n, lo=0 and
00000Br 2                       lda #0                      ; shift right twice instead of left six times
00000Br 2                       lsr tmp3
00000Br 2                       ror
00000Br 2                       lsr tmp3
00000Br 2                       ror
00000Br 2                       sbc #1                      ; C = 0 out of the ror pair, so this is A - 2
00000Br 2                       bcs :+
00000Br 2                       dec tmp3
00000Br 2               :       rts
00000Br 2               ; w16 = (w16 - 80) with ring wrap (w16 holds CRTC address S+$600 in $600..$FFF)
00000Br 2               @subrow: lda w16
00000Br 2                       sec
00000Br 2                       sbc #ROWCHARS
00000Br 2                       sta w16
00000Br 2                       bcs :+
00000Br 2                       dec w16+1
00000Br 2               :       lda w16+1
00000Br 2                       cmp #6
00000Br 2                       bcs :+                      ; not taken: C = 0 for the adc
00000Br 2                       adc #$0A
00000Br 2                       sta w16+1
00000Br 2               :       rts
00000Br 2               @addrow: lda w16
00000Br 2                       clc
00000Br 2                       adc #ROWCHARS
00000Br 2                       sta w16
00000Br 2                       bcc :+
00000Br 2                       inc w16+1
00000Br 2               :       lda w16+1
00000Br 2                       cmp #$10
00000Br 2                       bcc :+                      ; not taken: C = 1 for the sbc
00000Br 2                       sbc #$0A
00000Br 2                       sta w16+1
00000Br 2               :       rts
00000Br 2                 .endif
00000Br 2               
00000Br 2                       PLACE "CODE", "TILCODE"
000A04r 2               
000A04r 2               BARROWS = 2                        ; the status bar
000A04r 2               QROWS  = 39 - VISROWS - BARROWS    ; blank rows after the display: 312 lines in all
000A04r 2                 .if MODELB
000A04r 2               QVSYNC = 8                         ; vsync at Q row 8 of 16: the picture starts 64 lines after
000A04r 2                                                  ; it, 4 lines below where a MODE 1 screen sits
000A04r 2                 .else
000A04r 2               QVSYNC = 3                         ; vsync at Q row 3 of 7: four rows (32 lines) between the
000A04r 2                                                  ; vsync and the bar, which is where the bar is drawn, and
000A04r 2                                                  ; three below.  Measured against the Master MOS's own
000A04r 2                                                  ; MODE 2 (R7 = 35): the picture sits exactly where it does.
000A04r 2                 .endif
000A04r 2               
000A04r 2               ; ============================================================================
000A04r 2               ; Frame control
000A04r 2               ; ============================================================================
000A04r 2               ; select CPU access to the current back buffer (ACCCON X bit)
000A04r 2               select_backbuf:
000A04r 2                 .if MODELB
000A04r 2  A6 rr                ldx curbuf                  ; the buffer's ring: its base and end, the two
000A06r 2  BD rr rr             lda @bhi,x                  ; derived constants the blitters' wrap tests use,
000A09r 2  85 E0                sta ringbhi                 ; and the row table from its base
000A0Br 2  BD rr rr             lda @ehi,x
000A0Er 2  85 E1                sta ringehi
000A10r 2  38                   sec
000A11r 2  E9 03                sbc #3
000A13r 2  85 E2                sta ringe3
000A15r 2  A9 00                lda #0
000A17r 2  38                   sec
000A18r 2  E5 E1                sbc ringehi
000A1Ar 2  85 E3                sta ringneg
000A1Cr 2  20 rr rr             jsr build_ring
000A1Fr 2  4C rr rr             jmp @recs
000A22r 2  0A 46        @bhi:   .byte >RING_A, >RING_B
000A24r 2  44 80        @ehi:   .byte >RINGEND_A, >RINGEND_B
000A26r 2               @recs:
000A26r 2                 .else
000A26r 2                       php                         ; the ISR writes ACCCON's D bit; this read-modify-
000A26r 2                       sei                         ; write of the X bit must not straddle one
000A26r 2                       lda ACCCON
000A26r 2                       and #$FB
000A26r 2                       ldx curbuf
000A26r 2                       beq :+
000A26r 2                       ora #$04
000A26r 2               :       sta ACCCON
000A26r 2                       plp
000A26r 2                 .endif
000A26r 2  A5 rr                lda curbuf
000A28r 2  F0 09                beq :+
000A2Ar 2  A9 rr                lda #<(SPRREC+MAXREC*10)
000A2Cr 2  85 rr                sta recp
000A2Er 2  A9 rr                lda #>(SPRREC+MAXREC*10)
000A30r 2  85 rr                sta recp+1
000A32r 2  60                   rts
000A33r 2  A9 rr        :       lda #<SPRREC
000A35r 2  85 rr                sta recp
000A37r 2  A9 rr                lda #>SPRREC
000A39r 2  85 rr                sta recp+1
000A3Br 2  60                   rts
000A3Cr 2               
000A3Cr 2               ; render everything queued for the current back buffer and request flip
000A3Cr 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the game loop; the ring work
00000Br 2               render_frame:                       ; is render_core in bank 5
00000Br 2  20 rr rr             jsr wait_flip               ; the previous frame's flip must land before we
00000Er 2                 .if .not MODELB
00000Er 2                       jsr select_backbuf          ; draw into the buffer it is leaving
00000Er 2                 .endif
00000Er 2                       ; ---- the bar first.  It is single buffered and drawn where it is displayed,
00000Er 2                       ; so it has to be finished before the CRTC reaches it: T starts 40 lines after
00000Er 2                       ; the vsync wait_flip just returned from, which is 2560 cycles.  A full
00000Er 2                       ; template blit does not fit and does not need to -- it runs twice a level.
00000Er 2  A5 A4                lda BARBG
000010r 2  F0 07                beq :+
000012r 2  20 rr rr             jsr bar_bg
000015r 2  A9 00 85 A4          stz BARBG
000019r 2  A5 A3        :       lda BARDIRTY
00001Br 2  F0 07                beq :+
00001Dr 2  20 rr rr             jsr t_redraw_hud
000020r 2  A9 00 85 A3          stz BARDIRTY
000024r 2               :
000024r 2                       ; derive char window
000024r 2  A5 rr                lda wx
000026r 2  85 rr                sta wcx
000028r 2  A5 rr                lda wx+1
00002Ar 2  4A                   lsr
00002Br 2  85 rr                sta wcx+1
00002Dr 2  66 rr                ror wcx
00002Fr 2  A5 rr                lda wy
000031r 2  29 03                and #3
000033r 2  0A                   asl
000034r 2  85 rr                sta wfine
000036r 2  A5 rr                lda wy+1                    ; wcy = wy >> 2, a full 16-bit shift: shifting the
000038r 2  4A                   lsr                         ; high byte once only was right below wy = 512 and
000039r 2  85 rr                sta wcy                     ; lost 128 rows above it, which put the tall maps
00003Br 2  A5 rr                lda wy                      ; 512 px out of place once the player got that deep
00003Dr 2  6A                   ror
00003Er 2  46 rr                lsr wcy
000040r 2  6A                   ror
000041r 2  85 rr                sta wcy
000043r 2                 .if MODELB
000043r 2  A2 00 20 rr          farjsr F_RENDCORE
000047r 2  rr           
000048r 2                 .else
000048r 2                       jsr calc_ring
000048r 2                       jsr match_sprites
000048r 2                       jsr erase_old
000048r 2                       jsr scroll_validate
000048r 2                       jsr draw_dirty
000048r 2                       jsr draw_sprites
000048r 2                       jsr copy_partial
000048r 2                 .endif
000048r 2  48 A9 00 85          stza NSPR
00004Cr 2  A2 68        
00004Er 2                 .if MODELB
00004Er 2  20 rr rr             jsr build_sections
000051r 2                 .else
000051r 2                       jsr t_build_sections
000051r 2                 .endif
000051r 2                       ; hand over to ISR
000051r 2  A5 rr                lda curbuf
000053r 2                 .if .not MODELB
000053r 2                       sta NEXTBUF
000053r 2                 .endif
000053r 2  F0 02                beq :+
000055r 2  A9 30                lda #48
000057r 2  8D rr rr     :       sta NEXTSECT
00005Ar 2  A9 01                lda #1
00005Cr 2  85 rr                sta flipreq
00005Er 2               render_done:                        ; (label for the phase timer harness)
00005Er 2                       ; no wait here: the next logic step runs while the flip is pending and
00005Er 2                       ; the next render_frame waits for it before touching the buffer
00005Er 2  A5 rr                lda curbuf
000060r 2  49 01                eor #1
000062r 2  85 rr                sta curbuf
000064r 2  60                   rts
000065r 2               
000065r 2               ; spin until any pending flip has been taken by the vsync ISR
000065r 2               wait_flip:
000065r 2  A5 rr                lda flipreq
000067r 2  D0 FC                bne wait_flip
000069r 2  60                   rts
00006Ar 2                 .if MODELB
00006Ar 2                       .segment "TILCODE"          ; the ring work, in the tile blitter's bank
000A3Cr 2               render_core:
000A3Cr 2  20 rr rr             jsr select_backbuf          ; draw into the buffer the flip is leaving
000A3Fr 2  20 rr rr             jsr calc_ring
000A42r 2  20 rr rr             jsr match_sprites
000A45r 2  20 rr rr             jsr erase_old
000A48r 2  20 rr rr             jsr scroll_validate
000A4Br 2  20 rr rr             jsr draw_dirty
000A4Er 2  20 rr rr             jsr draw_sprites
000A51r 2  20 rr rr             jsr copy_partial
000A54r 2  4C rr rr             jmp mirror_copy             ; the straddling row's copy (display.s)
000A57r 2                 .endif
000A57r 2               
000A57r 2               
000A57r 2                       PLACE "LOW", "TILCODE"     ; render-time helpers in the NMI page ($0D03..),
000A57r 2                                                  ; copied there at init
000A57r 2               ; ============================================================================
000A57r 2               drawrect_clip:
000A57r 2                       ; rows
000A57r 2  A5 rr                lda rc_y
000A59r 2  38                   sec
000A5Ar 2  E5 rr                sbc wcy                     ; rel row start (may be negative), kept in A
000A5Cr 2  10 0F                bpl :+
000A5Er 2                       ; start above window: shrink
000A5Er 2  18                   clc
000A5Fr 2  65 rr                adc rc_h
000A61r 2  F0 69                beq @none
000A63r 2  30 67                bmi @none
000A65r 2  85 rr                sta rc_h
000A67r 2  A5 rr                lda wcy
000A69r 2  85 rr                sta rc_y
000A6Br 2  A9 00                lda #0                      ; clipped to the top: rel is now 0
000A6Dr 2  85 rr        :       sta tmp                     ; stored here, so the common path never reloads it
000A6Fr 2  18                   clc
000A70r 2  65 rr                adc rc_h                    ; rel end+1
000A72r 2  C9 17                cmp #BUFROWS+1
000A74r 2  90 0A                bcc :+
000A76r 2  A9 16                lda #BUFROWS                ; bcc not taken: C = 1 already, for the sbc
000A78r 2  E5 rr                sbc tmp
000A7Ar 2  F0 50                beq @none
000A7Cr 2  30 4E                bmi @none
000A7Er 2  85 rr                sta rc_h
000A80r 2               :       ; cols: rel = rc_x - wcx (16 bit signed)
000A80r 2  A5 rr                lda rc_x
000A82r 2  38                   sec
000A83r 2  E5 rr                sbc wcx
000A85r 2  85 rr                sta w16
000A87r 2  A5 rr                lda rc_x+1
000A89r 2  E5 rr                sbc wcx+1
000A8Br 2  85 rr                sta w16+1
000A8Dr 2  10 24                bpl @right
000A8Fr 2                       ; rel < 0: the visible width is w + rel, and rel is already two's complement,
000A8Fr 2                       ; so add rather than negate-and-subtract.  Only a result whose high byte comes
000A8Fr 2                       ; out exactly 0 survives: anything else is the whole rect off the left edge.
000A8Fr 2  A5 rr                lda w16
000A91r 2  18                   clc
000A92r 2  65 rr                adc rc_w
000A94r 2  85 rr                sta rc_w
000A96r 2  F0 34                beq @none                   ; Z is still the low sum: sta sets no flags
000A98r 2  A5 rr                lda w16+1
000A9Ar 2  69 00                adc #0                      ; branches do not touch C
000A9Cr 2  D0 2E                bne @none
000A9Er 2  A5 rr                lda wcx
000AA0r 2  85 rr                sta rc_x
000AA2r 2  A5 rr                lda wcx+1
000AA4r 2  85 rr                sta rc_x+1
000AA6r 2  A5 rr                lda rc_w                    ; rel is now exactly 0, so the right clip is just
000AA8r 2  C9 51                cmp #ROWCHARS+1             ; min(rc_w, ROWCHARS): no need to store it and read
000AAAr 2  90 04                bcc :+                      ; it back through the general test below
000AACr 2  A9 50                lda #ROWCHARS
000AAEr 2  85 rr                sta rc_w
000AB0r 2  4C rr rr     :       jmp drawrect
000AB3r 2  A5 rr        @right: lda w16+1
000AB5r 2  D0 15                bne @none                   ; rel >= 256 -> off right
000AB7r 2  A5 rr                lda w16
000AB9r 2  C9 50                cmp #ROWCHARS
000ABBr 2  B0 0F                bcs @none                   ; not taken: C = 0 for the adc
000ABDr 2  65 rr                adc rc_w
000ABFr 2  C9 51                cmp #ROWCHARS+1
000AC1r 2  90 06                bcc :+                      ; not taken: C = 1 for the sbc
000AC3r 2  A9 50                lda #ROWCHARS
000AC5r 2  E5 rr                sbc w16
000AC7r 2  85 rr                sta rc_w
000AC9r 2  4C rr rr     :       jmp drawrect
000ACCr 2  60           @none:  rts
000ACDr 2               ; ============================================================================
000ACDr 2               ; drawrect_clip: like drawrect but clips the rect to the current window
000ACDr 2               ; (rows wcy..wcy+BUFROWS-1, cols wcx..wcx+ROWCHARS-1).
000ACDr 2               calc_ring:
000ACDr 2  A5 rr                lda wcy
000ACFr 2  AA BD 80 80          ringmod
000AD3r 2  AA                   tax
000AD4r 2  BD 50 80             lda mulrowlo,x
000AD7r 2  18                   clc
000AD8r 2  65 rr                adc wcx
000ADAr 2  85 rr                sta ringS
000ADCr 2  BD 68 80             lda mulrowhi,x
000ADFr 2  65 rr                adc wcx+1
000AE1r 2  85 rr                sta ringS+1
000AE3r 2  C9 07                cmp #>RINGCHARS
000AE5r 2  90 15                bcc :+
000AE7r 2  D0 06                bne @sub
000AE9r 2  A5 rr                lda ringS
000AEBr 2  C9 30                cmp #<RINGCHARS
000AEDr 2  90 0D                bcc :+
000AEFr 2  A5 rr        @sub:   lda ringS
000AF1r 2  38                   sec
000AF2r 2  E9 30                sbc #<RINGCHARS
000AF4r 2  85 rr                sta ringS
000AF6r 2  A5 rr                lda ringS+1
000AF8r 2  E9 07                sbc #>RINGCHARS
000AFAr 2  85 rr                sta ringS+1
000AFCr 2               :       ; q = S / 80
000AFCr 2  A5 rr                lda ringS                   ; running value: low in A, high in Y
000AFEr 2  A4 rr                ldy ringS+1
000B00r 2  A2 FF                ldx #$FF                    ; quotient, pre-decremented
000B02r 2  38                   sec                         ; the loop's own bcs guarantees C=1 all the way
000B03r 2  E8           @div:   inx                         ; round, so the only entries needing a sec are
000B04r 2  E9 50                sbc #ROWCHARS               ; this one and the one after a borrow
000B06r 2  B0 FB                bcs @div                    ; no borrow: high byte unchanged, value still >= 0
000B08r 2  38                   sec                         ; dey does not touch the carry
000B09r 2  88                   dey
000B0Ar 2  10 F7                bpl @div                    ; borrow absorbed by the high byte
000B0Cr 2  86 rr        @dd:    stx barq                    ; high byte went negative: X is the quotient
000B0Er 2                 .if MODELB
000B0Er 2  18                   clc                         ; the remainder, A + 80, is where the window starts
000B0Fr 2  69 50                adc #ROWCHARS               ; in its slot: the first char the mirror is read for
000B11r 2  85 E5                sta wcxm
000B13r 2  A9 16                lda #RINGROWS-1             ; the window row that lives in the last slot, and
000B15r 2  38                   sec                         ; the map row it shows: the row the mirror follows
000B16r 2  E5 rr                sbc barq
000B18r 2  85 E6                sta rstar
000B1Ar 2  18                   clc
000B1Br 2  65 rr                adc wcy
000B1Dr 2  85 E4                sta mrow
000B1Fr 2                 .endif
