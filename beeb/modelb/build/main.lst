000100r 1                       .include "low.s"
000100r 2               ; ============================================================================
000100r 2               ; Main RAM, $0140-$02FF.  Everything here is visible whatever bank is paged in:
000100r 2               ; the interrupt handler, the section table it reads, the far-call thunk, and the
000100r 2               ; buffer a bank copies a strip of its data into for another bank to read.
000100r 2               ; ============================================================================
000100r 2                       .segment "LOWCODE"
000000r 2               
000000r 2               ; ---------------------------------------------------------------- far calls
000000r 2               ; X = the index of a (bank, address) entry.  The caller's bank comes back from the
000000r 2               ; stack, so a bank may call one that replaces it, and a call may nest.
000000r 2               farcall:
000000r 2  85 rr                sta fc_a                    ; A is an argument and a result, so it travels
000002r 2  A5 F4                lda ROMSEL_CPY              ; around the bank switch on both legs
000004r 2  48                   pha
000005r 2  BD rr rr             lda FARTAB+1,x
000008r 2  8D rr rr             sta @j+1
00000Br 2  BD rr rr             lda FARTAB+2,x
00000Er 2  8D rr rr             sta @j+2
000011r 2  BD rr rr             lda FARTAB,x
000014r 2  85 F4                sta ROMSEL_CPY
000016r 2  8D 30 FE             sta ROMSEL
000019r 2  A5 rr                lda fc_a
00001Br 2  20 FF FF     @j:     jsr $FFFF
00001Er 2  85 rr                sta fc_a
000020r 2  68                   pla
000021r 2  85 F4                sta ROMSEL_CPY
000023r 2  8D 30 FE             sta ROMSEL
000026r 2  A5 rr                lda fc_a
000028r 2  60                   rts
000029r 2               
000029r 2               ; ---------------------------------------------------------------- map peek
000029r 2               ; The logic reads single map bytes with this: ptr/Y address the map in bank 6 and
000029r 2               ; the routine is in main RAM, so only the data is far away.  31 cycles.
000029r 2               mapbyte:
000029r 2  A9 06                lda #BANK_MAP
00002Br 2  85 F4                sta ROMSEL_CPY
00002Dr 2  8D 30 FE             sta ROMSEL
000030r 2  B1 rr                lda (w16b),y
000032r 2  A2 07                ldx #BANK_LGC
000034r 2  86 F4                stx ROMSEL_CPY
000036r 2  8E 30 FE             stx ROMSEL
000039r 2  60                   rts
00003Ar 2               
00003Ar 2               ; ---------------------------------------------------------------- interrupts
00003Ar 2               irq_handler:
00003Ar 2  86 rr                stx irq_x
00003Cr 2  84 rr                sty irq_y
00003Er 2  2C 4D FE             bit VIA_IFR
000041r 2  70 03                bvs @t1arm
000043r 2  4C rr rr             jmp @notT1
000046r 2               @t1arm: ; A rupture step is a CRTC restart: R12/R13 were armed during the section
000046r 2                       ; before and latch at the boundary; R9 with R4 decide where the section ends
000046r 2                       ; and are compared at the start of its last scanline, and R6 from scanline 1
000046r 2                       ; on.  The chain is phased so the step fires ~60 cycles BEFORE the restart,
000046r 2                       ; and the hold below carries the first write past it.
000046r 2  A6 rr                ldx SECIDX
000048r 2  A0 05                ldy #5
00004Ar 2  88           @hold:  dey
00004Br 2  D0 FD                bne @hold
00004Dr 2  A9 09                lda #9
00004Fr 2  8D 00 FE             sta CRTC_IDX
000052r 2  BD rr rr             lda SECTAB+3,x
000055r 2  8D 01 FE             sta CRTC_DAT
000058r 2  A9 04                lda #4
00005Ar 2  8D 00 FE             sta CRTC_IDX
00005Dr 2  BD rr rr             lda SECTAB+2,x
000060r 2  8D 01 FE             sta CRTC_DAT
000063r 2  A9 06                lda #6
000065r 2  8D 00 FE             sta CRTC_IDX
000068r 2  BD rr rr             lda SECTAB+4,x
00006Br 2  8D 01 FE             sta CRTC_DAT
00006Er 2  A9 07                lda #7
000070r 2  8D 00 FE             sta CRTC_IDX
000073r 2  BD rr rr             lda SECTAB+5,x
000076r 2  8D 01 FE             sta CRTC_DAT
000079r 2  85 rr                sta curR7
00007Br 2  A9 0C                lda #12
00007Dr 2  8D 00 FE             sta CRTC_IDX
000080r 2  BD rr rr             lda SECTAB,x
000083r 2  8D 01 FE             sta CRTC_DAT
000086r 2  A9 0D                lda #13
000088r 2  8D 00 FE             sta CRTC_IDX
00008Br 2  BD rr rr             lda SECTAB+1,x
00008Er 2  8D 01 FE             sta CRTC_DAT
000091r 2  BD rr rr             lda SECTAB+6,x
000094r 2  8D 46 FE             sta VIA_T1LL
000097r 2  BD rr rr             lda SECTAB+7,x
00009Ar 2  8D 47 FE             sta VIA_T1LH
00009Dr 2  AD 44 FE             lda VIA_T1CL                ; clear the T1 flag
0000A0r 2  A5 rr                lda curR7                   ; the chain stops at Q, the only section whose R7
0000A2r 2  C9 08                cmp #QVSYNC                 ; is the vsync row: a late vsync must not walk it
0000A4r 2  F0 06                beq @stay                   ; off the end of SECTAB
0000A6r 2  8A                   txa
0000A7r 2  18                   clc
0000A8r 2  69 08                adc #8
0000AAr 2  85 rr                sta SECIDX
0000ACr 2  A4 rr        @stay:  ldy irq_y
0000AEr 2  A6 rr                ldx irq_x
0000B0r 2  A5 FC                lda $FC
0000B2r 2  40                   rti
0000B3r 2               
0000B3r 2               @notT1:
0000B3r 2  AD 4D FE             lda VIA_IFR
0000B6r 2  29 02                and #$02
0000B8r 2  F0 05                beq @exit
0000BAr 2                       ; ---- vsync.  The T1 re-phase, the flip and section 0 all have the 64 lines
0000BAr 2                       ; between the vsync and the bar to happen in, so they live in bank 7 and this
0000BAr 2                       ; pays 63 cycles to reach them -- main RAM is 448 bytes and the step above is
0000BAr 2                       ; the only part of the chain that cannot afford to be anywhere else.
0000BAr 2  A2 00 20 rr          farjsr F_VSYNC
0000BEr 2  rr           
0000BFr 2               @exit:
0000BFr 2  A4 rr                ldy irq_y
0000C1r 2  A6 rr                ldx irq_x
0000C3r 2  A5 FC                lda $FC
0000C5r 2  40                   rti
0000C6r 2               
0000C6r 2                       .segment "LOWBSS"
000000r 2  xx xx xx xx  SECTAB:     .res 2*48               ; per buffer: 6 sections x 8 bytes
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000060r 2  xx xx xx xx  FARTAB:     .res 3*NFAR             ; (bank, lo, hi) per far entry point
000064r 2  xx xx xx xx  
000068r 2  xx xx xx xx  
000087r 2               
000087r 1                       .include "bank7.s"
000087r 2               ; ============================================================================
000087r 2               ; Bank 7: the game logic, the frame loop, and the chain the CRTC is driven by.
000087r 2               ; Bank 7 is the one the loader leaves paged in, so $8000 is the entry vector.
000087r 2               ; ============================================================================
000087r 2                       .segment "LGCCODE"
000000r 2  4C rr rr     entry:  jmp init
000003r 2               
000003r 2               ; ---------------------------------------------------------------- start up
000003r 2               init:
000003r 2  A2 3F                ldx #$3F                    ; the stack is 64 bytes: $0100-$013F
000005r 2  9A                   txs
000006r 2  A9 00                lda #0                      ; the OS left its own variables here; $F0-$FF is
000008r 2  A2 00                ldx #0                      ; left alone ($F4 is the bank the loader selected,
00000Ar 2  95 00        :       sta $00,x                   ; and the OS IRQ still restores from it until
00000Cr 2  E8                   inx                         ; take_over).  Counting up: $EF is negative, so a
00000Dr 2  E0 F0                cpx #$F0                    ; dex/bpl loop would stop after one store
00000Fr 2  D0 F9                bne :-
000011r 2                       ; the main-RAM image travels in bank 7 and is copied down to $0140
000011r 2  A9 rr                lda #<__LOWCODE_LOAD__
000013r 2  85 rr                sta w16
000015r 2  A9 rr                lda #>__LOWCODE_LOAD__
000017r 2  85 rr                sta w16+1
000019r 2  A9 rr                lda #<__LOWCODE_RUN__
00001Br 2  85 rr                sta w16b
00001Dr 2  A9 rr                lda #>__LOWCODE_RUN__
00001Fr 2  85 rr                sta w16b+1
000021r 2  A0 00                ldy #0
000023r 2  A2 rr                ldx #>(__LOWCODE_SIZE__ + 255)
000025r 2  B1 rr        @lc:    lda (w16),y
000027r 2  91 rr                sta (w16b),y
000029r 2  C8                   iny
00002Ar 2  D0 F9                bne @lc
00002Cr 2  E6 rr                inc w16+1
00002Er 2  E6 rr                inc w16b+1
000030r 2  CA                   dex
000031r 2  D0 F2                bne @lc
000033r 2  20 rr rr             jsr init_far
000036r 2  A2 24 20 rr          farjsr F_SPRINIT            ; the MASKTABs, and the directory's pointers
00003Ar 2  rr           
00003Br 2  20 rr rr             jsr clear_screen
00003Er 2  A9 00                lda #0
000040r 2  85 rr                sta curbuf
000042r 2  20 rr rr             jsr select_backbuf
000045r 2  20 rr rr             jsr draw_window
000048r 2  20 rr rr             jsr mirror_copy
00004Br 2  A9 01                lda #1
00004Dr 2  85 rr                sta curbuf
00004Fr 2  20 rr rr             jsr select_backbuf
000052r 2  20 rr rr             jsr draw_window
000055r 2  20 rr rr             jsr mirror_copy
000058r 2  20 rr rr             jsr bar_pattern
00005Br 2  A9 00                lda #0
00005Dr 2  85 rr                sta curbuf
00005Fr 2  85 rr                sta DISPSECT
000061r 2  85 rr                sta NEXTSECT
000063r 2  85 rr                sta SECIDX                  ; the chain starts at the bar; the first vsync
000065r 2  85 rr                sta wcx                     ; re-phases everything
000067r 2  85 rr                sta wcx+1
000069r 2  85 rr                sta wcy
00006Br 2  85 rr                sta wfine
00006Dr 2  85 rr                sta frame
00006Fr 2  A9 39                lda #<VS2T_DEFAULT
000071r 2  85 rr                sta VS2T
000073r 2  A9 0F                lda #>VS2T_DEFAULT
000075r 2  85 rr                sta VS2T+1
000077r 2  20 rr rr             jsr select_backbuf
00007Ar 2  20 rr rr             jsr calc_ring
00007Dr 2  20 rr rr             jsr build_sections          ; buffer 0's chain, before anything can display it
000080r 2  20 rr rr             jsr set_palette
000083r 2  20 rr rr             jsr crtc_init
000086r 2  20 rr rr             jsr take_over
000089r 2                       ; ---------------------------------------------------------------- loop
000089r 2               frame_top:
000089r 2  E6 rr                inc frame
00008Br 2                       .ifdef TESTY                ; a fixed window, so a screenshot can be checked
00008Br 2                       lda #TESTY                  ; against the geometry it is meant to show
00008Br 2                       sta wcy
00008Br 2                       lda #TESTX
00008Br 2                       sta wcx
00008Br 2                       lda #0
00008Br 2                       sta wcx+1
00008Br 2                       lda #TESTF
00008Br 2                       sta wfine
00008Br 2                       .else
00008Br 2  A5 rr                lda frame                   ; walk the window: two frames a char row down,
00008Dr 2  4A                   lsr                         ; and a char right every eight, which takes the
00008Er 2  85 rr                sta wcy                     ; straddling row through every column
000090r 2  A5 rr                lda frame
000092r 2  4A                   lsr
000093r 2  4A                   lsr
000094r 2  4A                   lsr
000095r 2  85 rr                sta wcx
000097r 2  A9 00                lda #0
000099r 2  85 rr                sta wcx+1
00009Br 2  A5 rr                lda frame
00009Dr 2  29 03                and #3
00009Fr 2  0A                   asl
0000A0r 2  85 rr                sta wfine
0000A2r 2                       .endif
0000A2r 2  20 rr rr             jsr calc_ring
0000A5r 2  A2 18 20 rr          farjsr F_ERASE              ; put tiles back where this buffer's sprites were
0000A9r 2  rr           
0000AAr 2  20 rr rr             jsr queue_sprites
0000ADr 2  A2 15 20 rr          farjsr F_DRAWSPR
0000B1r 2  rr           
0000B2r 2  20 rr rr             jsr build_sections
0000B5r 2  A5 rr                lda curbuf
0000B7r 2  F0 02                beq :+
0000B9r 2  A9 30                lda #48
0000BBr 2  85 rr        :       sta NEXTSECT
0000BDr 2  A9 01                lda #1
0000BFr 2  85 rr                sta flipreq
0000C1r 2  A5 rr        :       lda flipreq
0000C3r 2  D0 FC                bne :-
0000C5r 2  A5 rr                lda curbuf
0000C7r 2  49 01                eor #1
0000C9r 2  85 rr                sta curbuf
0000CBr 2  20 rr rr             jsr select_backbuf
0000CEr 2  4C rr rr             jmp frame_top
0000D1r 2               
0000D1r 2               ; ---------------------------------------------------------------- vsync
0000D1r 2               ; Reached from the interrupt handler in main RAM, 64 lines before the bar.
0000D1r 2               vsync_tick:
0000D1r 2  A5 rr                lda VS2T                    ; restart T1 first, for constant latency
0000D3r 2  8D 46 FE             sta VIA_T1LL
0000D6r 2  A5 rr                lda VS2T+1
0000D8r 2  8D 45 FE             sta VIA_T1CH
0000DBr 2  A9 02                lda #$02
0000DDr 2  8D 4D FE             sta VIA_IFR
0000E0r 2  A9 09                lda #9                      ; re-phase: end this frame curR7 + (QROWS-1-QVSYNC)
0000E2r 2  8D 00 FE             sta CRTC_IDX                ; rows from the vsync, whatever the row counter did
0000E5r 2  A9 07                lda #7
0000E7r 2  8D 01 FE             sta CRTC_DAT
0000EAr 2  A9 06                lda #6                      ; pre-arm the bar's R6 here in Q, where the display
0000ECr 2  8D 00 FE             sta CRTC_IDX                ; is off and a new R6 cannot show
0000EFr 2  A9 02                lda #BARROWS
0000F1r 2  8D 01 FE             sta CRTC_DAT
0000F4r 2  A9 04                lda #4
0000F6r 2  8D 00 FE             sta CRTC_IDX
0000F9r 2  A5 rr                lda curR7
0000FBr 2  18                   clc
0000FCr 2  69 07                adc #QROWS-1-QVSYNC
0000FEr 2  29 7F                and #$7F
000100r 2  8D 01 FE             sta CRTC_DAT
000103r 2  E6 rr                inc vsyncs
000105r 2  A5 rr                lda flipreq
000107r 2  F0 15                beq @noflip
000109r 2  A5 rr                lda vsyncs
00010Br 2  38                   sec
00010Cr 2  E5 rr                sbc flipvs
00010Er 2  C9 02                cmp #2
000110r 2  90 0C                bcc @noflip
000112r 2  A5 rr                lda vsyncs
000114r 2  85 rr                sta flipvs
000116r 2  A5 rr                lda NEXTSECT
000118r 2  85 rr                sta DISPSECT
00011Ar 2  A9 00 85 rr          stz flipreq
00011Er 2               @noflip:
00011Er 2  A2 00                ldx #0                      ; section 0 is the bar: its address and length come
000120r 2  A4 rr                ldy DISPSECT                ; from the buffer about to be displayed
000122r 2  F0 02                beq :+
000124r 2  A2 02                ldx #2
000126r 2  B5 rr        :       lda BUF_SEC0T1,x
000128r 2  8D 46 FE             sta VIA_T1LL
00012Br 2  B5 rr                lda BUF_SEC0T1+1,x
00012Dr 2  8D 47 FE             sta VIA_T1LH
000130r 2  A9 0C                lda #12
000132r 2  8D 00 FE             sta CRTC_IDX
000135r 2  B5 rr                lda BUF_SEC0,x
000137r 2  8D 01 FE             sta CRTC_DAT
00013Ar 2  A9 0D                lda #13
00013Cr 2  8D 00 FE             sta CRTC_IDX
00013Fr 2  B5 rr                lda BUF_SEC0+1,x
000141r 2  8D 01 FE             sta CRTC_DAT
000144r 2  A9 40                lda #$40
000146r 2  8D 4D FE             sta VIA_IFR
000149r 2  84 rr                sty SECIDX
00014Br 2  60                   rts
00014Cr 2               
00014Cr 2               ; the (bank, address) table the thunk in main RAM indexes
00014Cr 2               init_far:
00014Cr 2  A2 26                ldx #3*NFAR-1
00014Er 2  BD rr rr     :       lda @src,x
000151r 2  9D rr rr             sta FARTAB,x
000154r 2  CA                   dex
000155r 2  10 F7                bpl :-
000157r 2  60                   rts
000158r 2  07 rr rr     @src:   .byte BANK_LGC, <vsync_tick, >vsync_tick
00015Br 2  07 rr rr             .byte BANK_LGC, <vsync_tick, >vsync_tick    ; F_SCANKEYS, not yet
00015Er 2  07 rr rr             .byte BANK_LGC, <vsync_tick, >vsync_tick    ; F_SNDTICK, not yet
000161r 2  06 rr rr             .byte BANK_MAP, <map_strip, >map_strip
000164r 2  05 rr rr             .byte BANK_TIL, <draw_maprect, >draw_maprect
000167r 2  05 00 00             .byte BANK_TIL, 0, 0
00016Ar 2  05 00 00             .byte BANK_TIL, 0, 0
00016Dr 2  04 rr rr             .byte BANK_SPR, <draw_sprites, >draw_sprites
000170r 2  04 rr rr             .byte BANK_SPR, <erase_old, >erase_old
000173r 2  05 00 00             .byte BANK_TIL, 0, 0
000176r 2  05 00 00             .byte BANK_TIL, 0, 0
000179r 2  04 rr rr             .byte BANK_SPR, <addsprite, >addsprite
00017Cr 2  04 rr rr             .byte BANK_SPR, <init_masks, >init_masks
00017Fr 2               
00017Fr 2               ; A hand-made draw list until the logic arrives: Cleo where the level starts her,
00017Fr 2               ; and the stars that share her ledge.
00017Fr 2               queue_sprites:
00017Fr 2  A9 68                lda #<(STARTX*8)
000181r 2  85 rr                sta spx
000183r 2  A9 00                lda #>(STARTX*8)
000185r 2  85 rr                sta spx+1
000187r 2  A9 E0                lda #<(STARTY*8)
000189r 2  85 rr                sta spy
00018Br 2  A9 00                lda #>(STARTY*8)
00018Dr 2  85 rr                sta spy+1
00018Fr 2  A9 08                lda #8                      ; Cleo, standing
000191r 2  A2 21 20 rr          farjsr F_ADDSPR
000195r 2  rr           
000196r 2  A9 90                lda #<(STARTX*8+40)
000198r 2  85 rr                sta spx
00019Ar 2  A9 00                lda #>(STARTX*8+40)
00019Cr 2  85 rr                sta spx+1
00019Er 2  A9 D0                lda #<(STARTY*8-16)
0001A0r 2  85 rr                sta spy
0001A2r 2  A9 00                lda #>(STARTY*8-16)
0001A4r 2  85 rr                sta spy+1
0001A6r 2  A9 22                lda #34                     ; a star
0001A8r 2  A2 21 20 rr          farjsr F_ADDSPR
0001ACr 2  rr           
0001ADr 2  A9 38                lda #<(STARTX*8-48)
0001AFr 2  85 rr                sta spx
0001B1r 2  A9 00                lda #>(STARTX*8-48)
0001B3r 2  85 rr                sta spx+1
0001B5r 2  A9 E0                lda #<(STARTY*8)
0001B7r 2  85 rr                sta spy
0001B9r 2  A9 00                lda #>(STARTY*8)
0001BBr 2  85 rr                sta spy+1
0001BDr 2  A9 25                lda #37
0001BFr 2  A2 21 20 rr          farjsr F_ADDSPR
0001C3r 2  rr           
0001C4r 2  60                   rts
0001C5r 2               
0001C5r 2               ; ---------------------------------------------------------------- tables
0001C5r 2               ; select_backbuf: point the ring tables, the fold and the CRTC base at curbuf
0001C5r 2               select_backbuf:
0001C5r 2  A5 rr                lda curbuf
0001C7r 2  F0 17                beq @a
0001C9r 2  A9 80                lda #<RING_B
0001CBr 2  85 rr                sta ringbase
0001CDr 2  A9 46                lda #>RING_B
0001CFr 2  85 rr                sta ringbase+1
0001D1r 2  A9 80                lda #>RINGEND_B
0001D3r 2  85 rr                sta ringehi
0001D5r 2  A9 D0                lda #<CRTCB_B
0001D7r 2  85 rr                sta crtcb
0001D9r 2  A9 08                lda #>CRTCB_B
0001DBr 2  85 rr                sta crtcb+1
0001DDr 2  4C rr rr             bra @tab
0001E0r 2  A9 80        @a:     lda #<RING_A
0001E2r 2  85 rr                sta ringbase
0001E4r 2  A9 0A                lda #>RING_A
0001E6r 2  85 rr                sta ringbase+1
0001E8r 2  A9 44                lda #>RINGEND_A
0001EAr 2  85 rr                sta ringehi
0001ECr 2  A9 50                lda #<CRTCB_A
0001EEr 2  85 rr                sta crtcb
0001F0r 2  A9 01                lda #>CRTCB_A
0001F2r 2  85 rr                sta crtcb+1
0001F4r 2  A5 rr        @tab:   lda crtcb                   ; the mirror redirect is the same add with the ring
0001F6r 2  38                   sec                         ; subtracted: crtcb - RINGCHARS
0001F7r 2  E9 30                sbc #<RINGCHARS
0001F9r 2  85 rr                sta crtcbm
0001FBr 2  A5 rr                lda crtcb+1
0001FDr 2  E9 07                sbc #>RINGCHARS
0001FFr 2  85 rr                sta crtcbm+1
000201r 2  A5 rr                lda ringbase
000203r 2  85 rr                sta w16
000205r 2  A5 rr                lda ringbase+1
000207r 2  85 rr                sta w16+1
000209r 2  A2 00                ldx #0
00020Br 2  A5 rr        @rt:    lda w16
00020Dr 2  95 rr                sta RINGLO,x
00020Fr 2  A5 rr                lda w16+1
000211r 2  95 rr                sta RINGHI,x
000213r 2  A5 rr                lda w16
000215r 2  18                   clc
000216r 2  69 80                adc #<ROWBYTES
000218r 2  85 rr                sta w16
00021Ar 2  A5 rr                lda w16+1
00021Cr 2  69 02                adc #>ROWBYTES
00021Er 2  85 rr                sta w16+1
000220r 2  E8                   inx
000221r 2  E0 17                cpx #RINGROWS
000223r 2  D0 E6                bne @rt
000225r 2  60                   rts
000226r 2               
000226r 2               ; calc_ring: ringS = ((wcy mod RINGROWS) * 80 + wcx) mod RINGCHARS ; barq = ringS / 80
000226r 2               calc_ring:
000226r 2  A6 rr                ldx wcy
000228r 2  BD 00 80             lda RINGMODTAB,x
00022Br 2  AA                   tax
00022Cr 2  BD rr rr             lda mulrowlo,x
00022Fr 2  18                   clc
000230r 2  65 rr                adc wcx
000232r 2  85 rr                sta ringS
000234r 2  BD rr rr             lda mulrowhi,x
000237r 2  65 rr                adc wcx+1
000239r 2  85 rr                sta ringS+1
00023Br 2  C9 07                cmp #>RINGCHARS
00023Dr 2  90 15                bcc :++
00023Fr 2  D0 06                bne :+
000241r 2  A5 rr                lda ringS
000243r 2  C9 30                cmp #<RINGCHARS
000245r 2  90 0D                bcc :++
000247r 2  A5 rr        :       lda ringS
000249r 2  38                   sec
00024Ar 2  E9 30                sbc #<RINGCHARS
00024Cr 2  85 rr                sta ringS
00024Er 2  A5 rr                lda ringS+1
000250r 2  E9 07                sbc #>RINGCHARS
000252r 2  85 rr                sta ringS+1
000254r 2  A5 rr        :       lda ringS                   ; q = S / 80 by repeated subtraction: 23 at most
000256r 2  A4 rr                ldy ringS+1
000258r 2  A2 FF                ldx #$FF
00025Ar 2  38                   sec
00025Br 2  E8           @div:   inx
00025Cr 2  E9 50                sbc #ROWCHARS
00025Er 2  B0 FB                bcs @div
000260r 2  38                   sec
000261r 2  88                   dey
000262r 2  10 F7                bpl @div
000264r 2  86 rr                stx barq
000266r 2  60                   rts
000267r 2               
000267r 2               ; ---------------------------------------------------------------- the chain
000267r 2               ; entry i: R12n, R13n, R4, R9, R6, R7, T1lo, T1hi.  The shape is section i's; the
000267r 2               ; address and duration are section i+1's, because R12/R13 latch at the next restart
000267r 2               ; and the T1 latch takes effect one interrupt later.
000267r 2               build_sections:
000267r 2  A5 rr                lda curbuf
000269r 2  0A                   asl
00026Ar 2  AA                   tax
00026Br 2  A9 00                lda #>BARCRTC               ; section 0 is the bar: fixed address and length
00026Dr 2  95 rr                sta BUF_SEC0,x
00026Fr 2  A9 60                lda #<BARCRTC
000271r 2  95 rr                sta BUF_SEC0+1,x
000273r 2  A9 FE                lda #<(BARROWS*8*LINE-2)
000275r 2  95 rr                sta BUF_SEC0T1,x
000277r 2  A9 03                lda #>(BARROWS*8*LINE-2)
000279r 2  95 rr                sta BUF_SEC0T1+1,x
00027Br 2  A6 rr                ldx curbuf
00027Dr 2  F0 02                beq :+
00027Fr 2  A2 30                ldx #48
000281r 2  A9 01        :       lda #BARROWS-1
000283r 2  9D rr rr             sta SECTAB+2,x
000286r 2  A9 07                lda #7
000288r 2  9D rr rr             sta SECTAB+3,x
00028Br 2  A9 02                lda #BARROWS
00028Dr 2  9D rr rr             sta SECTAB+4,x
000290r 2  A9 1E                lda #30
000292r 2  9D rr rr             sta SECTAB+5,x
000295r 2  A5 rr                lda wfine
000297r 2  F0 6C                beq @coarse
000299r 2                       ; ---- f > 0: T -> A (the composed row) -> P.. -> P2 -> Q
000299r 2  49 07                eor #7
00029Br 2  18 69 01             inca                        ; 8-f lines of it
00029Er 2  20 rr rr             jsr @dur
0002A1r 2  9D rr rr             sta SECTAB+6,x
0002A4r 2  A5 rr                lda tmp3
0002A6r 2  9D rr rr             sta SECTAB+7,x
0002A9r 2  A5 rr                lda ringS                   ; the composed row is the 80 chars above the window
0002ABr 2  38                   sec
0002ACr 2  E9 50                sbc #<ROWCHARS
0002AEr 2  85 rr                sta w16
0002B0r 2  A5 rr                lda ringS+1
0002B2r 2  E9 00                sbc #0
0002B4r 2  85 rr                sta w16+1
0002B6r 2  10 0D                bpl :+
0002B8r 2  A5 rr                lda w16
0002BAr 2  18                   clc
0002BBr 2  69 30                adc #<RINGCHARS
0002BDr 2  85 rr                sta w16
0002BFr 2  A5 rr                lda w16+1
0002C1r 2  69 07                adc #>RINGCHARS
0002C3r 2  85 rr                sta w16+1
0002C5r 2  20 rr rr     :       jsr @addr
0002C8r 2  8A                   txa
0002C9r 2  18                   clc
0002CAr 2  69 08                adc #8
0002CCr 2  AA                   tax                         ; A's entry
0002CDr 2  A9 00 9D rr          stz SECTAB+2,x
0002D1r 2  rr           
0002D2r 2  A5 rr                lda wfine
0002D4r 2  49 07                eor #7                      ; 7 - f
0002D6r 2  9D rr rr             sta SECTAB+3,x
0002D9r 2  A9 02                lda #2
0002DBr 2  9D rr rr             sta SECTAB+4,x
0002DEr 2  A9 1E                lda #30
0002E0r 2  9D rr rr             sta SECTAB+5,x
0002E3r 2  A5 rr                lda ringS                   ; the run starts one row into the window
0002E5r 2  18                   clc
0002E6r 2  69 50                adc #<ROWCHARS
0002E8r 2  85 rr                sta w16
0002EAr 2  A5 rr                lda ringS+1
0002ECr 2  69 00                adc #0
0002EEr 2  85 rr                sta w16+1
0002F0r 2  20 rr rr             jsr @wrap
0002F3r 2  A9 14                lda #VISROWS-1
0002F5r 2  85 rr                sta tmp4                    ; rows in the run
0002F7r 2  A4 rr                ldy barq
0002F9r 2  C8                   iny
0002FAr 2  C0 17                cpy #RINGROWS
0002FCr 2  90 02                bcc :+
0002FEr 2  A0 00                ldy #0
000300r 2  84 rr        :       sty tmp3
000302r 2  4C rr rr             bra @run
000305r 2               @coarse:                            ; ---- f = 0: T -> P.. -> Q
000305r 2  A5 rr                lda ringS
000307r 2  85 rr                sta w16
000309r 2  A5 rr                lda ringS+1
00030Br 2  85 rr                sta w16+1
00030Dr 2  A9 15                lda #VISROWS
00030Fr 2  85 rr                sta tmp4
000311r 2  A5 rr                lda barq
000313r 2  85 rr                sta tmp3
000315r 2               @run:   ; w16 = the run's ring offset, tmp4 = its rows, X = the entry before it
000315r 2  20 rr rr             jsr @nfull                  ; rows that end before the ring end
000318r 2  C5 rr                cmp tmp4
00031Ar 2  B0 15                bcs @one                    ; the whole run fits
00031Cr 2  C9 00                cmp #0
00031Er 2  F0 11                beq @one                    ; it starts inside the straddling row: all of it folds
000320r 2  85 rr                sta tmp2
000322r 2  20 rr rr             jsr @emit                   ; up to the ring end
000325r 2  A5 rr                lda tmp2
000327r 2  20 rr rr             jsr @advance
00032Ar 2  A5 rr                lda tmp4
00032Cr 2  38                   sec
00032Dr 2  E5 rr                sbc tmp2
00032Fr 2  85 rr                sta tmp4
000331r 2  A5 rr        @one:   lda tmp4
000333r 2  85 rr                sta tmp2
000335r 2  20 rr rr             jsr @emit
000338r 2  A5 rr                lda tmp4
00033Ar 2  20 rr rr             jsr @advance                ; now the row below the playfield
00033Dr 2  A5 rr                lda wfine
00033Fr 2  F0 3D                beq @setq
000341r 2                       ; --- P2: the top f lines of that row
000341r 2  20 rr rr             jsr @addr
000344r 2  A5 rr                lda wfine
000346r 2  20 rr rr             jsr @dur
000349r 2  9D rr rr             sta SECTAB+6,x
00034Cr 2  A5 rr                lda tmp3
00034Er 2  9D rr rr             sta SECTAB+7,x
000351r 2  8A                   txa
000352r 2  18                   clc
000353r 2  69 08                adc #8
000355r 2  AA                   tax
000356r 2  48 A9 00 9D          stza SECTAB+2, x
00035Ar 2  rr rr 68     
00035Dr 2  A5 rr                lda wfine
00035Fr 2  38 E9 01             deca
000362r 2  9D rr rr             sta SECTAB+3,x
000365r 2  A9 15                lda #VISROWS
000367r 2  9D rr rr             sta SECTAB+4,x
00036Ar 2  A9 1E                lda #30
00036Cr 2  9D rr rr             sta SECTAB+5,x
00036Fr 2  BD rr rr             lda SECTAB-8,x              ; w16 has not moved: the address the P2 @addr left
000372r 2  9D rr rr             sta SECTAB,x                ; in the previous entry is this one's too
000375r 2  BD rr rr             lda SECTAB-8+1,x
000378r 2  9D rr rr             sta SECTAB+1,x
00037Br 2  4C rr rr             bra @sq2
00037Er 2  20 rr rr     @setq:  jsr @addr                   ; Q starts on the row below the playfield
000381r 2  A9 FE        @sq2:   lda #<(40*LINE-2)
000383r 2  9D rr rr             sta SECTAB+6,x
000386r 2  A9 09                lda #>(40*LINE-2)
000388r 2  9D rr rr             sta SECTAB+7,x
00038Br 2  8A                   txa
00038Cr 2  18                   clc
00038Dr 2  69 08                adc #8
00038Fr 2  AA                   tax
000390r 2  A9 00                lda #>BARCRTC               ; and hands the chain back to the bar
000392r 2  9D rr rr             sta SECTAB,x
000395r 2  A9 60                lda #<BARCRTC
000397r 2  9D rr rr             sta SECTAB+1,x
00039Ar 2  A9 0F                lda #QROWS-1
00039Cr 2  9D rr rr             sta SECTAB+2,x
00039Fr 2  A9 07                lda #7
0003A1r 2  9D rr rr             sta SECTAB+3,x
0003A4r 2  48 A9 00 9D          stza SECTAB+4, x
0003A8r 2  rr rr 68     
0003ABr 2  A9 08                lda #QVSYNC
0003ADr 2  9D rr rr             sta SECTAB+5, x
0003B0r 2  A9 FE                lda #<(40*LINE-2)
0003B2r 2  9D rr rr             sta SECTAB+6, x
0003B5r 2  A9 09                lda #>(40*LINE-2)
0003B7r 2  9D rr rr             sta SECTAB+7, x
0003BAr 2  60                   rts
0003BBr 2               ; --- emit a run of tmp2 rows starting at ring offset w16, following entry X
0003BBr 2  20 rr rr     @emit:  jsr @addr
0003BEr 2  A5 rr                lda tmp2
0003C0r 2  20 rr rr             jsr @lines
0003C3r 2  9D rr rr             sta SECTAB+6,x
0003C6r 2  A5 rr                lda tmp3
0003C8r 2  9D rr rr             sta SECTAB+7,x
0003CBr 2  8A                   txa
0003CCr 2  18                   clc
0003CDr 2  69 08                adc #8
0003CFr 2  AA                   tax
0003D0r 2  A5 rr                lda tmp2
0003D2r 2  38 E9 01             deca
0003D5r 2  9D rr rr             sta SECTAB+2,x
0003D8r 2  A9 07                lda #7
0003DAr 2  9D rr rr             sta SECTAB+3,x
0003DDr 2  A9 1E                lda #30
0003DFr 2  9D rr rr             sta SECTAB+4,x
0003E2r 2  9D rr rr             sta SECTAB+5,x
0003E5r 2  60                   rts
0003E6r 2               ; --- SECTAB+0/1,x = the CRTC address of the row at ring offset w16.  A row starting
0003E6r 2               ; past RINGCHARS-80 straddles the ring end and is read from the mirror below the base,
0003E6r 2               ; which is exactly the address w16 - RINGCHARS names.
0003E6r 2  A5 rr        @addr:  lda w16
0003E8r 2  A4 rr                ldy w16+1
0003EAr 2  C0 06                cpy #>(RINGCHARS-ROWCHARS+1)
0003ECr 2  90 13                bcc :++
0003EEr 2  D0 04                bne :+
0003F0r 2  C9 E1                cmp #<(RINGCHARS-ROWCHARS+1)
0003F2r 2  90 0D                bcc :++
0003F4r 2  18           :       clc
0003F5r 2  65 rr                adc crtcbm
0003F7r 2  9D rr rr             sta SECTAB+1,x
0003FAr 2  98                   tya
0003FBr 2  65 rr                adc crtcbm+1
0003FDr 2  9D rr rr             sta SECTAB,x
000400r 2  60                   rts
000401r 2  18           :       clc
000402r 2  65 rr                adc crtcb
000404r 2  9D rr rr             sta SECTAB+1,x
000407r 2  98                   tya
000408r 2  65 rr                adc crtcb+1
00040Ar 2  9D rr rr             sta SECTAB,x
00040Dr 2  60                   rts
00040Er 2                       ; --- A = rows -> A/tmp3 = that many rows of lines, as a T1 count
00040Er 2  0A           @lines: asl
00040Fr 2  0A                   asl
000410r 2  0A                   asl
000411r 2  4C rr rr             jmp @dur
000414r 2                       ; --- A = rows: advance w16 by that many rows, folding into 0..RINGCHARS
000414r 2               @advance:
000414r 2  A8                   tay
000415r 2  18                   clc
000416r 2  A5 rr                lda w16
000418r 2  79 rr rr             adc mulrowlo,y
00041Br 2  85 rr                sta w16
00041Dr 2  A5 rr                lda w16+1
00041Fr 2  79 rr rr             adc mulrowhi,y
000422r 2  85 rr                sta w16+1
000424r 2  A5 rr        @wrap:  lda w16+1
000426r 2  C9 07                cmp #>RINGCHARS
000428r 2  90 15                bcc :++
00042Ar 2  D0 06                bne :+
00042Cr 2  A5 rr                lda w16
00042Er 2  C9 30                cmp #<RINGCHARS
000430r 2  90 0D                bcc :++
000432r 2  A5 rr        :       lda w16
000434r 2  38                   sec
000435r 2  E9 30                sbc #<RINGCHARS
000437r 2  85 rr                sta w16
000439r 2  A5 rr                lda w16+1
00043Br 2  E9 07                sbc #>RINGCHARS
00043Dr 2  85 rr                sta w16+1
00043Fr 2  60           :       rts
000440r 2                       ; --- rows of the run that finish before the ring end.  The run starts on ring
000440r 2                       ; row tmp3; when r = ringS mod 80 is non-zero the last ring row straddles and
000440r 2                       ; @addr sends it to the mirror, so RINGROWS-1-tmp3 rows come first.
000440r 2  A4 rr        @nfull: ldy barq
000442r 2  A5 rr                lda ringS
000444r 2  38                   sec
000445r 2  F9 rr rr             sbc mulrowlo,y              ; r
000448r 2  C9 01                cmp #1                      ; C = 1 iff r > 0
00044Ar 2  A9 16                lda #RINGROWS-1
00044Cr 2  B0 04                bcs :+
00044Er 2  69 00                adc #0                      ; r == 0: C is clear here, so this adds 1
000450r 2  69 01                adc #1
000452r 2  38           :       sec
000453r 2  E5 rr                sbc tmp3
000455r 2  60                   rts
000456r 2                       ; --- A = lines -> A/tmp3 = the T1 count that lasts that long
000456r 2  85 rr        @dur:   sta tmp3                    ; n*64 == (n*256)>>2
000458r 2  A9 00                lda #0
00045Ar 2  46 rr                lsr tmp3
00045Cr 2  6A                   ror
00045Dr 2  46 rr                lsr tmp3
00045Fr 2  6A                   ror
000460r 2  E9 01                sbc #1                      ; C = 0 out of the ror pair: A - 2
000462r 2  B0 02                bcs :+
000464r 2  C6 rr                dec tmp3
000466r 2  60           :       rts
000467r 2               
000467r 2               ; ---------------------------------------------------------------- display
000467r 2               set_palette:                        ; MODE 1: logical 0..3 = black, cyan, magenta, yellow
000467r 2  A2 0F                ldx #15                     ; a pixel's two bits land in index bits 3 and 1
000469r 2  8A           :       txa
00046Ar 2  29 08                and #8
00046Cr 2  4A                   lsr
00046Dr 2  4A                   lsr
00046Er 2  85 rr                sta tmp
000470r 2  8A                   txa
000471r 2  29 02                and #2
000473r 2  4A                   lsr
000474r 2  05 rr                ora tmp
000476r 2  A8                   tay
000477r 2  B9 rr rr             lda @cmyk,y
00047Ar 2  85 rr                sta tmp
00047Cr 2  8A                   txa
00047Dr 2  0A                   asl
00047Er 2  0A                   asl
00047Fr 2  0A                   asl
000480r 2  0A                   asl
000481r 2  05 rr                ora tmp
000483r 2  8D 21 FE             sta ULA_PAL
000486r 2  CA                   dex
000487r 2  10 E0                bpl :-
000489r 2  60                   rts
00048Ar 2  07 01 02 04  @cmyk:  .byte 0^7, 6^7, 5^7, 3^7    ; physical black, cyan, magenta, yellow, inverted
00048Er 2               
00048Er 2               crtc_init:                          ; start the chain at the bar and let vsync re-phase
00048Er 2  A2 09                ldx #9
000490r 2  A9 07                lda #7
000492r 2  20 rr rr             jsr @w
000495r 2  A2 04                ldx #4
000497r 2  A9 01                lda #BARROWS-1
000499r 2  20 rr rr             jsr @w
00049Cr 2  A2 06                ldx #6
00049Er 2  A9 02                lda #BARROWS
0004A0r 2  20 rr rr             jsr @w
0004A3r 2  A2 07                ldx #7
0004A5r 2  A9 1E                lda #30
0004A7r 2  20 rr rr             jsr @w
0004AAr 2  A2 0C                ldx #12
0004ACr 2  A9 00                lda #>BARCRTC
0004AEr 2  20 rr rr             jsr @w
0004B1r 2  A2 0D                ldx #13
0004B3r 2  A9 60                lda #<BARCRTC
0004B5r 2  8E 00 FE     @w:     stx CRTC_IDX
0004B8r 2  8D 01 FE             sta CRTC_DAT
0004BBr 2  60                   rts
0004BCr 2               
0004BCr 2               take_over:
0004BCr 2  78                   sei
0004BDr 2  A9 rr                lda #<irq_handler
0004BFr 2  8D 04 02             sta IRQ1V
0004C2r 2  A9 rr                lda #>irq_handler
0004C4r 2  8D 05 02             sta IRQ1V+1
0004C7r 2  A9 7F                lda #$7F
0004C9r 2  8D 4E FE             sta VIA_IER
0004CCr 2  8D 6E FE             sta UVIA_IER
0004CFr 2  AD 4B FE             lda VIA_ACR
0004D2r 2  29 3F                and #$3F
0004D4r 2  09 40                ora #$40                    ; T1 continuous
0004D6r 2  8D 4B FE             sta VIA_ACR
0004D9r 2  A9 00                lda #<(40*LINE)
0004DBr 2  8D 46 FE             sta VIA_T1LL
0004DEr 2  A9 0A                lda #>(40*LINE)
0004E0r 2  8D 45 FE             sta VIA_T1CH
0004E3r 2  A9 C2                lda #$C2                    ; CA1 (vsync) + T1
0004E5r 2  8D 4E FE             sta VIA_IER
0004E8r 2  A9 7F                lda #$7F
0004EAr 2  8D 4D FE             sta VIA_IFR
0004EDr 2  A9 1E                lda #30                     ; the chain stops when curR7 is Q's; start it at a
0004EFr 2  85 rr                sta curR7                   ; value that is not
0004F1r 2  A9 00 85 rr          stz flipreq
0004F5r 2  A9 00 85 rr          stz vsyncs
0004F9r 2  A9 00 85 rr          stz flipvs
0004FDr 2  58                   cli
0004FEr 2  60                   rts
0004FFr 2               
0004FFr 2               ; ---------------------------------------------------------------- scaffolding
0004FFr 2               clear_screen:                       ; $0300-$7FFF: the bar, both mirrors and both rings
0004FFr 2  A9 00                lda #0
000501r 2  85 rr                sta w16
000503r 2  A9 03                lda #>BARADDR
000505r 2  85 rr                sta w16+1
000507r 2  A0 00                ldy #0
000509r 2  A2 7D                ldx #$7D                    ; pages $03..$7F
00050Br 2  91 rr        :       sta (w16),y
00050Dr 2  C8                   iny
00050Er 2  D0 FB                bne :-
000510r 2  E6 rr                inc w16+1
000512r 2  CA                   dex
000513r 2  D0 F6                bne :-
000515r 2  60                   rts
000516r 2               
000516r 2               ; the whole window: 20 tiles across, 11 tile rows (22 char rows)
000516r 2               draw_window:
000516r 2  A5 rr                lda wcx                     ; a tile is four chars and two char rows
000518r 2  4A                   lsr
000519r 2  4A                   lsr
00051Ar 2  85 rr                sta dt_tx
00051Cr 2  A5 rr                lda wcy
00051Er 2  4A                   lsr
00051Fr 2  85 rr                sta dt_ty
000521r 2  A9 14                lda #20
000523r 2  85 rr                sta dt_nx
000525r 2  A9 0B                lda #11
000527r 2  85 rr                sta dt_ny
000529r 2  A2 0C 20 rr          farjsr F_DRAWRECT
00052Dr 2  rr           
00052Er 2  60                   rts
00052Fr 2               
00052Fr 2               ; A pattern that makes the geometry readable: each ring row is a band of one colour
00052Fr 2               ; with its slot number written as a run of black chars at the left, so the order of
00052Fr 2               ; the rows on screen, the wrap and the mirror can all be counted off.
00052Fr 2               test_pattern:
00052Fr 2  A2 00                ldx #0                      ; slot
000531r 2  86 rr        @slot:  stx tmp2
000533r 2  8A                   txa
000534r 2  18                   clc
000535r 2  69 01                adc #1
000537r 2  85 rr                sta tmp                     ; colour 1..3 by slot
000539r 2  C9 04        @c1:    cmp #4
00053Br 2  90 05                bcc :+
00053Dr 2  E9 03                sbc #3
00053Fr 2  4C rr rr             bra @c1
000542r 2  A8           :       tay
000543r 2  B9 rr rr             lda @cols,y
000546r 2  85 rr                sta tmp3                    ; the band's byte
000548r 2  A6 rr                ldx tmp2
00054Ar 2  B5 rr                lda RINGLO,x
00054Cr 2  85 rr                sta w16
00054Er 2  B5 rr                lda RINGHI,x
000550r 2  85 rr                sta w16+1
000552r 2  A0 00                ldy #0
000554r 2  A9 00                lda #0
000556r 2  85 rr                sta cnt                     ; char within the row
000558r 2  A5 rr        @char:  lda cnt
00055Ar 2  C5 rr                cmp tmp2                    ; the first (slot+1) chars are black
00055Cr 2  90 07                bcc @black
00055Er 2  F0 05                beq @black
000560r 2  A5 rr                lda tmp3
000562r 2  4C rr rr             bra @put
000565r 2  A9 00        @black: lda #0
000567r 2  A2 08        @put:   ldx #8
000569r 2  91 rr        @st:    sta (w16),y
00056Br 2  C8                   iny
00056Cr 2  D0 02                bne :+
00056Er 2  E6 rr                inc w16+1
000570r 2  CA           :       dex
000571r 2  D0 F6                bne @st
000573r 2  E6 rr                inc cnt
000575r 2  A5 rr                lda cnt
000577r 2  C9 50                cmp #ROWCHARS
000579r 2  D0 DD                bne @char
00057Br 2  A6 rr                ldx tmp2
00057Dr 2  E8                   inx
00057Er 2  E0 17                cpx #RINGROWS
000580r 2  D0 AF                bne @slot
000582r 2  60                   rts
000583r 2  00 0F F0 FF  @cols:  .byte $00, $0F, $F0, $FF
000587r 2               
000587r 2               bar_pattern:                        ; yellow with a black tick every eight chars
000587r 2  A9 00                lda #<BARADDR
000589r 2  85 rr                sta w16
00058Br 2  A9 03                lda #>BARADDR
00058Dr 2  85 rr                sta w16+1
00058Fr 2  A0 00                ldy #0
000591r 2  A2 00                ldx #0
000593r 2  98           @b:     tya
000594r 2  29 38                and #$38
000596r 2  C9 38                cmp #$38
000598r 2  D0 05                bne :+
00059Ar 2  A9 00                lda #0
00059Cr 2  4C rr rr             bra :++
00059Fr 2  A9 FF        :       lda #$FF
0005A1r 2  91 rr        :       sta (w16),y
0005A3r 2  C8                   iny
0005A4r 2  D0 ED                bne @b
0005A6r 2  E6 rr                inc w16+1
0005A8r 2  E8                   inx
0005A9r 2  E0 05                cpx #5
0005ABr 2  D0 E6                bne @b
0005ADr 2  60                   rts
0005AEr 2               
0005AEr 2               ; the mirror is a copy of the ring's last row, so a straddling row reads as one run
0005AEr 2               mirror_copy:
0005AEr 2  A2 16                ldx #RINGROWS-1
0005B0r 2  B5 rr                lda RINGLO,x
0005B2r 2  85 rr                sta w16
0005B4r 2  B5 rr                lda RINGHI,x
0005B6r 2  85 rr                sta w16+1
0005B8r 2  A5 rr                lda ringbase
0005BAr 2  38                   sec
0005BBr 2  E9 80                sbc #<ROWBYTES
0005BDr 2  85 rr                sta w16b
0005BFr 2  A5 rr                lda ringbase+1
0005C1r 2  E9 02                sbc #>ROWBYTES
0005C3r 2  85 rr                sta w16b+1
0005C5r 2  A0 00                ldy #0
0005C7r 2  A2 02                ldx #>ROWBYTES
0005C9r 2  B1 rr        :       lda (w16),y
0005CBr 2  91 rr                sta (w16b),y
0005CDr 2  C8                   iny
0005CEr 2  D0 F9                bne :-
0005D0r 2  E6 rr                inc w16+1
0005D2r 2  E6 rr                inc w16b+1
0005D4r 2  CA                   dex
0005D5r 2  D0 F2                bne :-
0005D7r 2  A2 80                ldx #<ROWBYTES              ; the odd half page
0005D9r 2  B1 rr        :       lda (w16),y
0005DBr 2  91 rr                sta (w16b),y
0005DDr 2  C8                   iny
0005DEr 2  CA                   dex
0005DFr 2  D0 F8                bne :-
0005E1r 2  60                   rts
0005E2r 2               
0005E2r 2                       .include "tables.inc"
0005E2r 3  00 50 A0 F0  mulrowlo:   .repeat RINGROWS+1, i
0005E6r 3  40 90 E0 30  
0005EAr 3  80 D0 20 70  
0005FAr 3                           .byte <(i*ROWCHARS)
0005FAr 3                           .endrepeat
0005FAr 3  00 00 00 00  mulrowhi:   .repeat RINGROWS+1, i
0005FEr 3  01 01 01 02  
000602r 3  02 02 03 03  
000612r 3                           .byte >(i*ROWCHARS)
000612r 3                           .endrepeat
000612r 3               
000612r 2               
000612r 2                       .segment "LGCBSS"
000000r 2               
000000r 1                       .include "bank6.s"
000000r 2               ; ============================================================================
000000r 2               ; Bank 6: the map, the level's tables, and the routines that read them.  The
000000r 2               ; tile blitter and the logic live in other banks, so what leaves here goes
000000r 2               ; through a strip copy into MAPBUF in main RAM, or one byte through mapbyte.
000000r 2               ; ============================================================================
000000r 2                       .segment "MAPCODE"
000000r 2               ; map_strip: copy cnt map bytes from tile (tmp, tmp2) into MAPBUF.
000000r 2               map_strip:
000000r 2  A9 00 85 rr          stz w16+1                   ; stz is lda #0 on a 6502: it cannot go between
000004r 2  A5 rr                lda tmp2                    ; the load of ty and the shifts that use it
000006r 2  A2 05                ldx #MAPLW                  ; * the map's stride
000008r 2  0A           @sh:    asl
000009r 2  26 rr                rol w16+1
00000Br 2  CA                   dex
00000Cr 2  D0 FA                bne @sh
00000Er 2  18                   clc
00000Fr 2  65 rr                adc tmp
000011r 2  85 rr                sta w16
000013r 2  A5 rr                lda w16+1
000015r 2  69 00                adc #0
000017r 2  18                   clc
000018r 2  69 rr                adc #>LV_MAP
00001Ar 2  85 rr                sta w16+1
00001Cr 2  A5 rr                lda w16
00001Er 2  18                   clc
00001Fr 2  69 rr                adc #<LV_MAP
000021r 2  85 rr                sta w16
000023r 2  90 02                bcc :+
000025r 2  E6 rr                inc w16+1
000027r 2  A0 00        :       ldy #0
000029r 2  B1 rr        @cp:    lda (w16),y
00002Br 2  99 rr rr             sta MAPBUF,y
00002Er 2  C8                   iny
00002Fr 2  C4 rr                cpy cnt
000031r 2  D0 F6                bne @cp
000033r 2  60                   rts
000034r 2               
000034r 2               ; map_col: the same, but a column: cnt bytes down from tile (tmp, tmp2)
000034r 2               map_col:
000034r 2  A9 00 85 rr          stz w16+1
000038r 2  A5 rr                lda tmp2
00003Ar 2  A2 05                ldx #MAPLW
00003Cr 2  0A           @sh:    asl
00003Dr 2  26 rr                rol w16+1
00003Fr 2  CA                   dex
000040r 2  D0 FA                bne @sh
000042r 2  18                   clc
000043r 2  65 rr                adc tmp
000045r 2  85 rr                sta w16
000047r 2  A5 rr                lda w16+1
000049r 2  69 00                adc #0
00004Br 2  18                   clc
00004Cr 2  69 rr                adc #>LV_MAP
00004Er 2  85 rr                sta w16+1
000050r 2  A5 rr                lda w16
000052r 2  18                   clc
000053r 2  69 rr                adc #<LV_MAP
000055r 2  85 rr                sta w16
000057r 2  90 02                bcc :+
000059r 2  E6 rr                inc w16+1
00005Br 2  A2 00        :       ldx #0
00005Dr 2  A0 00                ldy #0
00005Fr 2  B1 rr        @cp:    lda (w16),y
000061r 2  95 rr                sta MAPBUF,x
000063r 2  A5 rr                lda w16
000065r 2  18                   clc
000066r 2  69 20                adc #MAPW
000068r 2  85 rr                sta w16
00006Ar 2  90 02                bcc :+
00006Cr 2  E6 rr                inc w16+1
00006Er 2  E8           :       inx
00006Fr 2  E4 rr                cpx cnt
000071r 2  D0 EC                bne @cp
000073r 2  60                   rts
000074r 2               
000074r 2                       .segment "MAPDATA"
000000r 2                       .align 256
000000r 2               LV_HDR:
000000r 2  05 05 0D 1C          .incbin "build/level.bin"       ; header, objects, attributes, alt classes
000004r 2  16 1B 18 7F  
000008r 2  60 61 7F 7F  
000320r 2               LV_ALT:
000320r 2  80 80 80 80          .incbin "build/alt.bin"
000324r 2  80 80 80 80  
000328r 2  08 08 08 08  
000368r 2  xx xx xx xx          .align 256
00036Cr 2  xx xx xx xx  
000370r 2  xx xx xx xx  
000400r 2               LV_MAP:
000400r 2  03 03 03 03          .incbin "build/map.bin"
000404r 2  03 03 03 03  
000408r 2  03 03 03 03  
000800r 2               LV_OBJS = LV_HDR + 32
000800r 2               LV_ATTR = LV_HDR + 32 + 256
000800r 2               LV_ACLS = LV_HDR + 32 + 256 + 256
000800r 2               
000800r 1                       .include "bank5.s"
000800r 2               ; ============================================================================
000800r 2               ; Bank 5: this level's tiles and the blitter that draws them.  A tile is 8 game
000800r 2               ; pixels square: 4 chars wide and 2 char rows tall, 64 bytes, and 1840 (the ring
000800r 2               ; in chars) divides by 4, so a tile's four chars are always contiguous -- only
000800r 2               ; whole tiles can straddle the ring end, never their columns.
000800r 2               ; ============================================================================
000800r 2                       .segment "TILCODE"
000000r 2               ; draw_maprect: the tile rectangle (dt_tx, dt_ty) size (dt_nx, dt_ny), into the
000000r 2               ; ring where the window arithmetic says it goes.  A map char (cx, cy) is ring
000000r 2               ; char ((cy mod 23)*80 + cx) mod 1840, which does not depend on the window.
000000r 2               draw_maprect:
000000r 2  A5 rr        @row:   lda dt_tx                   ; one strip of map per tile row
000002r 2  85 rr                sta tmp
000004r 2  A5 rr                lda dt_ty
000006r 2  85 rr                sta tmp2
000008r 2  A5 rr                lda dt_nx
00000Ar 2  85 rr                sta cnt
00000Cr 2  A2 09 20 rr          farjsr F_MAPSTRIP
000010r 2  rr           
000011r 2  A5 rr                lda dt_ty                   ; char row = 2*ty, and its ring slot
000013r 2  0A                   asl
000014r 2  20 rr rr             jsr ring_row                ; -> dst0
000017r 2  A5 rr                lda dt_tx                   ; + 4*tx chars = 32*tx bytes, which is 16 bit
000019r 2  85 rr                sta w16                     ; from tx = 8 on
00001Br 2  A9 00 85 rr          stz w16+1
00001Fr 2  A2 05                ldx #5
000021r 2  06 rr        :       asl w16
000023r 2  26 rr                rol w16+1
000025r 2  CA                   dex
000026r 2  D0 F9                bne :-
000028r 2  A5 rr                lda dst0
00002Ar 2  18                   clc
00002Br 2  65 rr                adc w16
00002Dr 2  85 rr                sta dst0
00002Fr 2  A5 rr                lda dst0+1
000031r 2  65 rr                adc w16+1
000033r 2  85 rr                sta dst0+1
000035r 2  20 rr rr             jsr ring_next               ; dst1 = the char row below
000038r 2  A2 00                ldx #0
00003Ar 2  86 rr                stx dt_i
00003Cr 2  A6 rr        @tile:  ldx dt_i
00003Er 2  B5 rr                lda MAPBUF,x
000040r 2  20 rr rr             jsr draw_tile
000043r 2  A5 rr                lda dst0                    ; the next tile is four chars on
000045r 2  18                   clc
000046r 2  69 20                adc #32
000048r 2  85 rr                sta dst0
00004Ar 2  90 02                bcc :+
00004Cr 2  E6 rr                inc dst0+1
00004Er 2  A5 rr        :       lda dst1
000050r 2  18                   clc
000051r 2  69 20                adc #32
000053r 2  85 rr                sta dst1
000055r 2  90 02                bcc :+
000057r 2  E6 rr                inc dst1+1
000059r 2  E6 rr        :       inc dt_i
00005Br 2  A5 rr                lda dt_i
00005Dr 2  C5 rr                cmp dt_nx
00005Fr 2  D0 DB                bne @tile
000061r 2  E6 rr                inc dt_ty
000063r 2  C6 rr                dec dt_ny
000065r 2  D0 99                bne @row
000067r 2  60                   rts
000068r 2               
000068r 2               ; ring_row: A = char row -> dst0 = the address of its first char in the ring
000068r 2               ring_row:
000068r 2  AA                   tax
000069r 2  BD 00 80             lda RINGMODTAB,x            ; the slot
00006Cr 2  AA                   tax
00006Dr 2  B5 rr                lda RINGLO,x
00006Fr 2  85 rr                sta dst0
000071r 2  B5 rr                lda RINGHI,x
000073r 2  85 rr                sta dst0+1
000075r 2  60                   rts
000076r 2               
000076r 2               ; ring_next: dst1 = dst0 + one char row, folded at the ring end
000076r 2               ring_next:
000076r 2  A5 rr                lda dst0
000078r 2  18                   clc
000079r 2  69 80                adc #<ROWBYTES
00007Br 2  85 rr                sta dst1
00007Dr 2  A5 rr                lda dst0+1
00007Fr 2  69 02                adc #>ROWBYTES
000081r 2  C5 rr                cmp ringehi
000083r 2  90 0B                bcc :+
000085r 2  48                   pha                         ; past the end: - RINGBYTES, which is not a
000086r 2  A5 rr                lda dst1                    ; whole number of pages
000088r 2  38                   sec
000089r 2  E9 80                sbc #<RINGBYTES
00008Br 2  85 rr                sta dst1
00008Dr 2  68                   pla
00008Er 2  E9 39                sbc #>RINGBYTES
000090r 2  85 rr        :       sta dst1+1
000092r 2  60                   rts
000093r 2               
000093r 2               ; draw_tile: A = tile id, dst0/dst1 = where its two char rows go
000093r 2               draw_tile:
000093r 2  C9 7F                cmp #EMPTYTILE              ; nothing to draw for a hole in the map
000095r 2  F0 30                beq @done
000097r 2  48                   pha
000098r 2  4A                   lsr
000099r 2  4A                   lsr
00009Ar 2  18                   clc
00009Br 2  69 rr                adc #>TILES                 ; the tiles are page aligned: id*64 is
00009Dr 2  85 rr                sta tp+1                    ; (id >> 2) pages plus (id & 3) * 64
00009Fr 2  68                   pla
0000A0r 2  29 03                and #3
0000A2r 2  0A                   asl
0000A3r 2  0A                   asl
0000A4r 2  0A                   asl
0000A5r 2  0A                   asl
0000A6r 2  0A                   asl
0000A7r 2  0A                   asl
0000A8r 2  85 rr                sta tp
0000AAr 2  A0 1F                ldy #31
0000ACr 2  B1 rr        :       lda (tp),y
0000AEr 2  91 rr                sta (dst0),y
0000B0r 2  88                   dey
0000B1r 2  10 F9                bpl :-
0000B3r 2  A5 rr                lda tp
0000B5r 2  18                   clc
0000B6r 2  69 20                adc #32
0000B8r 2  85 rr                sta tp
0000BAr 2  90 02                bcc :+
0000BCr 2  E6 rr                inc tp+1
0000BEr 2  A0 1F        :       ldy #31
0000C0r 2  B1 rr        :       lda (tp),y
0000C2r 2  91 rr                sta (dst1),y
0000C4r 2  88                   dey
0000C5r 2  10 F9                bpl :-
0000C7r 2  60           @done:  rts
0000C8r 2               
0000C8r 2                       .segment "TILDATA"
000000r 2                       .align 256
000000r 2  00 00 00 00  TILES:  .incbin "build/tiles.bin"
000004r 2  00 00 00 00  
000008r 2  00 00 00 00  
002000r 2               
002000r 1                       .include "bank4.s"
002000r 2               ; ============================================================================
002000r 2               ; Bank 4: the sprite images, their mask planes, the four MASKTABs and the
002000r 2               ; blitter.  Everything the inner loop touches is here, so a sprite is drawn
002000r 2               ; without a single bank switch; what crosses is one far call per erased
002000r 2               ; rectangle, into the tile blitter.
002000r 2               ; ============================================================================
002000r 2                       .segment "SPRCODE"
000000r 2               
000000r 2               .macro ringmod                      ; A = a map char row -> its ring slot
000000r 2                       tax
000000r 2                       lda RINGMODTAB,x
000000r 2               .endmacro
000000r 2               .macro ringup                       ; A = sp+1 just advanced: fold sp:A at the ring end
000000r 2                       .local done
000000r 2                       cmp ringehi
000000r 2                       bcc done
000000r 2                       pha                         ; the ring is 23 rows of 640, which is not a whole
000000r 2                       lda sp                      ; number of pages, so the low byte moves too
000000r 2                       sec
000000r 2                       sbc #<RINGBYTES
000000r 2                       sta sp
000000r 2                       pla
000000r 2                       sbc #>RINGBYTES
000000r 2               done:
000000r 2               .endmacro
000000r 2               .macro spnext                       ; the next char to the right, with the ring fold
000000r 2                       .local done
000000r 2                       lda sp
000000r 2                       clc
000000r 2                       adc #8
000000r 2                       sta sp
000000r 2                       bcc done
000000r 2                       lda sp+1
000000r 2                       inca
000000r 2                       ringup
000000r 2                       sta sp+1
000000r 2               done:
000000r 2               .endmacro
000000r 2               
000000r 2               ; sp = the address of char (w16, A) of the window's ring
000000r 2               ringaddr:
000000r 2  AA BD 00 80          ringmod
000004r 2  AA                   tax
000005r 2  A5 rr                lda w16+1
000007r 2  85 rr                sta sp+1
000009r 2  A5 rr                lda w16
00000Br 2  0A                   asl
00000Cr 2  26 rr                rol sp+1
00000Er 2  0A                   asl
00000Fr 2  26 rr                rol sp+1
000011r 2  0A                   asl
000012r 2  26 rr                rol sp+1                    ; sp+1:A = cx*8
000014r 2  18                   clc
000015r 2  75 rr                adc RINGLO,x
000017r 2  85 rr                sta sp
000019r 2  A5 rr                lda sp+1
00001Br 2  75 rr                adc RINGHI,x
00001Dr 2  C5 rr 90 0B          ringup
000021r 2  48 A5 rr 38  
000025r 2  E9 80 85 rr  
00002Cr 2  85 rr                sta sp+1
00002Er 2  60                   rts
00002Fr 2               
00002Fr 2  29 80        sext:   and #$80
000031r 2  F0 02                beq :+
000033r 2  A9 FF                lda #$FF
000035r 2  85 rr        :       sta tmp3
000037r 2  60                   rts
000038r 2               
000038r 2               ; ---------------------------------------------------------------- the pass
000038r 2               ; draw every sprite on the list, keeping a record of where each landed so the
000038r 2               ; next frame can erase it.
000038r 2               draw_sprites:
000038r 2  A5 rr                lda curbuf
00003Ar 2  F0 05                beq :+
00003Cr 2  A9 rr                lda #>(SPRREC + 10*MAXREC)
00003Er 2  4C rr rr             bra :++
000041r 2  A9 rr        :       lda #>SPRREC
000043r 2  85 rr        :       sta rp+1
000045r 2  A5 rr                lda curbuf
000047r 2  F0 05                beq :+
000049r 2  A9 rr                lda #<(SPRREC + 10*MAXREC)
00004Br 2  4C rr rr             bra :++
00004Er 2  A9 rr        :       lda #<SPRREC
000050r 2  85 rr        :       sta rp
000052r 2  A9 00                lda #0
000054r 2  85 rr                sta spi
000056r 2  A5 rr        @l:     lda spi
000058r 2  CD rr rr             cmp NSPR
00005Br 2  B0 38                bcs @done
00005Dr 2  C9 10                cmp #MAXREC
00005Fr 2  B0 34                bcs @done
000061r 2  0A                   asl                         ; entry = SPRLIST + i*5
000062r 2  0A                   asl
000063r 2  18                   clc
000064r 2  65 rr                adc spi
000066r 2  A8                   tay
000067r 2  B9 rr rr             lda SPRLIST+1,y
00006Ar 2  85 rr                sta spx
00006Cr 2  B9 rr rr             lda SPRLIST+2,y
00006Fr 2  85 rr                sta spx+1
000071r 2  B9 rr rr             lda SPRLIST+3,y
000074r 2  85 rr                sta spy
000076r 2  B9 rr rr             lda SPRLIST+4,y
000079r 2  85 rr                sta spy+1
00007Br 2  B9 rr rr             lda SPRLIST,y
00007Er 2  A0 00                ldy #0
000080r 2  91 rr                sta (rp),y                  ; the record starts with the id
000082r 2  20 rr rr             jsr drawsprite
000085r 2  A5 rr                lda rp
000087r 2  18                   clc
000088r 2  69 0A                adc #10
00008Ar 2  85 rr                sta rp
00008Cr 2  90 02                bcc :+
00008Er 2  E6 rr                inc rp+1
000090r 2  E6 rr        :       inc spi
000092r 2  4C rr rr             bra @l
000095r 2  A6 rr        @done:  ldx curbuf
000097r 2  A5 rr                lda spi
000099r 2  9D rr rr             sta RECCNT,x
00009Cr 2  A9 00                lda #0
00009Er 2  8D rr rr             sta NSPR                    ; the logic fills the list again next frame
0000A1r 2  60                   rts
0000A2r 2               
0000A2r 2               ; ---------------------------------------------------------------- erase
0000A2r 2               ; put the tiles back where this buffer's sprites were two frames ago.  The
0000A2r 2               ; record is in chars; the tile blitter wants tiles, so round outwards.
0000A2r 2               erase_old:
0000A2r 2  A6 rr                ldx curbuf
0000A4r 2  BD rr rr             lda RECCNT,x
0000A7r 2  F0 72                beq @done
0000A9r 2  85 rr                sta tmp4
0000ABr 2  A5 rr                lda curbuf
0000ADr 2  F0 05                beq :+
0000AFr 2  A9 rr                lda #>(SPRREC + 10*MAXREC)
0000B1r 2  4C rr rr             bra :++
0000B4r 2  A9 rr        :       lda #>SPRREC
0000B6r 2  85 rr        :       sta rp+1
0000B8r 2  A5 rr                lda curbuf
0000BAr 2  F0 05                beq :+
0000BCr 2  A9 rr                lda #<(SPRREC + 10*MAXREC)
0000BEr 2  4C rr rr             bra :++
0000C1r 2  A9 rr        :       lda #<SPRREC
0000C3r 2  85 rr        :       sta rp
0000C5r 2  A0 05        @l:     ldy #5
0000C7r 2  B1 rr                lda (rp),y                  ; cx low (the high byte only matters past 255
0000C9r 2  4A                   lsr                         ; chars, which no window reaches)
0000CAr 2  4A                   lsr
0000CBr 2  85 rr                sta dt_tx
0000CDr 2  A0 07                ldy #7
0000CFr 2  B1 rr                lda (rp),y                  ; cy
0000D1r 2  4A                   lsr
0000D2r 2  85 rr                sta dt_ty
0000D4r 2  A0 05                ldy #5
0000D6r 2  B1 rr                lda (rp),y
0000D8r 2  29 03                and #3                      ; the columns the rounding down left out
0000DAr 2  85 rr                sta tmp2
0000DCr 2  A0 08                ldy #8
0000DEr 2  B1 rr                lda (rp),y                  ; w in chars
0000E0r 2  18                   clc
0000E1r 2  65 rr                adc tmp2
0000E3r 2  69 03                adc #3
0000E5r 2  4A                   lsr
0000E6r 2  4A                   lsr
0000E7r 2  85 rr                sta dt_nx
0000E9r 2  A0 07                ldy #7
0000EBr 2  B1 rr                lda (rp),y
0000EDr 2  29 01                and #1
0000EFr 2  85 rr                sta tmp2
0000F1r 2  A0 09                ldy #9
0000F3r 2  B1 rr                lda (rp),y                  ; h in rows, bit 7 = it was clipped
0000F5r 2  29 7F                and #$7F
0000F7r 2  18                   clc
0000F8r 2  65 rr                adc tmp2
0000FAr 2  69 01                adc #1
0000FCr 2  4A                   lsr
0000FDr 2  85 rr                sta dt_ny
0000FFr 2  A5 rr                lda dt_nx
000101r 2  F0 09                beq @next
000103r 2  A5 rr                lda dt_ny
000105r 2  F0 05                beq @next
000107r 2  A2 0C 20 rr          farjsr F_DRAWRECT
00010Br 2  rr           
00010Cr 2  A5 rr        @next:  lda rp
00010Er 2  18                   clc
00010Fr 2  69 0A                adc #10
000111r 2  85 rr                sta rp
000113r 2  90 02                bcc :+
000115r 2  E6 rr                inc rp+1
000117r 2  C6 rr        :       dec tmp4
000119r 2  D0 AA                bne @l
00011Br 2  60           @done:  rts
00011Cr 2               
00011Cr 2               ; ---------------------------------------------------------------- tables
00011Cr 2               ; MASKTABk[x] is the AND mask for the column of phase k in mask byte x: the
00011Cr 2               ; blitter indexes by the whole byte and never shifts.
00011Cr 2               init_masks:
00011Cr 2  A2 00                ldx #0
00011Er 2  8A           @mt:    txa
00011Fr 2  4A                   lsr
000120r 2  4A                   lsr
000121r 2  4A                   lsr
000122r 2  4A                   lsr
000123r 2  4A                   lsr
000124r 2  4A                   lsr
000125r 2  A8                   tay
000126r 2  B9 rr rr             lda mask4,y
000129r 2  9D rr rr             sta MASKTAB0,x
00012Cr 2  8A                   txa
00012Dr 2  4A                   lsr
00012Er 2  4A                   lsr
00012Fr 2  4A                   lsr
000130r 2  4A                   lsr
000131r 2  29 03                and #3
000133r 2  A8                   tay
000134r 2  B9 rr rr             lda mask4,y
000137r 2  9D rr rr             sta MASKTAB1,x
00013Ar 2  8A                   txa
00013Br 2  4A                   lsr
00013Cr 2  4A                   lsr
00013Dr 2  29 03                and #3
00013Fr 2  A8                   tay
000140r 2  B9 rr rr             lda mask4,y
000143r 2  9D rr rr             sta MASKTAB2,x
000146r 2  8A                   txa
000147r 2  29 03                and #3
000149r 2  A8                   tay
00014Ar 2  B9 rr rr             lda mask4,y
00014Dr 2  9D rr rr             sta MASKTAB3,x
000150r 2  8A                   txa                         ; and the four-dot reversal for mirroring:
000151r 2  29 88                and #$88                    ; dot i is bit 7-i and bit 3-i, so 7<->4,
000153r 2  4A                   lsr                         ; 6<->5, 3<->0, 2<->1
000154r 2  4A                   lsr
000155r 2  4A                   lsr
000156r 2  85 rr                sta tmp
000158r 2  8A                   txa
000159r 2  29 44                and #$44
00015Br 2  4A                   lsr
00015Cr 2  05 rr                ora tmp
00015Er 2  85 rr                sta tmp
000160r 2  8A                   txa
000161r 2  29 22                and #$22
000163r 2  0A                   asl
000164r 2  05 rr                ora tmp
000166r 2  85 rr                sta tmp
000168r 2  8A                   txa
000169r 2  29 11                and #$11
00016Br 2  0A                   asl
00016Cr 2  0A                   asl
00016Dr 2  0A                   asl
00016Er 2  05 rr                ora tmp
000170r 2  9D rr rr             sta SWAPTAB,x
000173r 2  E8                   inx
000174r 2  D0 A8                bne @mt
000176r 2                       ; the directory carries offsets from the start of the sprite data
000176r 2  A9 rr                lda #<SPRTAB
000178r 2  85 rr                sta ptr
00017Ar 2  A9 rr                lda #>SPRTAB
00017Cr 2  85 rr                sta ptr+1
00017Er 2  A2 67                ldx #103
000180r 2  A0 00        @fx:    ldy #0
000182r 2  B1 rr                lda (ptr),y
000184r 2  18                   clc
000185r 2  69 rr                adc #<SPRDATA
000187r 2  91 rr                sta (ptr),y
000189r 2  C8                   iny
00018Ar 2  B1 rr                lda (ptr),y
00018Cr 2  69 rr                adc #>SPRDATA
00018Er 2  91 rr                sta (ptr),y
000190r 2  A5 rr                lda ptr
000192r 2  18                   clc
000193r 2  69 08                adc #8
000195r 2  85 rr                sta ptr
000197r 2  90 02                bcc :+
000199r 2  E6 rr                inc ptr+1
00019Br 2  CA           :       dex
00019Cr 2  D0 E2                bne @fx
00019Er 2  A9 rr                lda #<SPRMSKTAB
0001A0r 2  85 rr                sta ptr
0001A2r 2  A9 rr                lda #>SPRMSKTAB
0001A4r 2  85 rr                sta ptr+1
0001A6r 2  A2 67                ldx #103
0001A8r 2  A0 00        @fm:    ldy #0
0001AAr 2  B1 rr                lda (ptr),y
0001ACr 2  18                   clc
0001ADr 2  69 rr                adc #<SPRDATA
0001AFr 2  91 rr                sta (ptr),y
0001B1r 2  C8                   iny
0001B2r 2  B1 rr                lda (ptr),y
0001B4r 2  69 rr                adc #>SPRDATA
0001B6r 2  91 rr                sta (ptr),y
0001B8r 2  A5 rr                lda ptr
0001BAr 2  18                   clc
0001BBr 2  69 02                adc #2
0001BDr 2  85 rr                sta ptr
0001BFr 2  90 02                bcc :+
0001C1r 2  E6 rr                inc ptr+1
0001C3r 2  CA           :       dex
0001C4r 2  D0 E2                bne @fm
0001C6r 2  60                   rts
0001C7r 2               
0001C7r 2               ; the logic is in another bank, so it hands sprites over one at a time
0001C7r 2               addsprite:                          ; A = id, spx/spy = map px of the reference point
0001C7r 2  AE rr rr             ldx NSPR
0001CAr 2  E0 18                cpx #MAXSPR
0001CCr 2  B0 27                bcs @full
0001CEr 2  85 rr                sta tmp2                    ; the id, while X is turned into the list offset
0001D0r 2  86 rr                stx tmp
0001D2r 2  8A                   txa
0001D3r 2  0A                   asl
0001D4r 2  0A                   asl
0001D5r 2  18                   clc
0001D6r 2  65 rr                adc tmp
0001D8r 2  A8                   tay
0001D9r 2  A5 rr                lda tmp2
0001DBr 2  99 rr rr             sta SPRLIST,y
0001DEr 2  A5 rr                lda spx
0001E0r 2  99 rr rr             sta SPRLIST+1,y
0001E3r 2  A5 rr                lda spx+1
0001E5r 2  99 rr rr             sta SPRLIST+2,y
0001E8r 2  A5 rr                lda spy
0001EAr 2  99 rr rr             sta SPRLIST+3,y
0001EDr 2  A5 rr                lda spy+1
0001EFr 2  99 rr rr             sta SPRLIST+4,y
0001F2r 2  EE rr rr             inc NSPR
0001F5r 2  60           @full:  rts
0001F6r 2               
0001F6r 2               drawsprite:
0001F6r 2  48 A9 00 85          stza spclip                 ; set at every window edge the sprite is cut against
0001FAr 2  rr 68        
0001FCr 2  85 rr                sta sp_id
0001FEr 2  48 A9 00 85          stza ptr+1
000202r 2  rr 68        
000204r 2  0A                   asl                         ; id*8 -> the directory offset
000205r 2  26 rr                rol ptr+1
000207r 2  0A                   asl
000208r 2  26 rr                rol ptr+1
00020Ar 2  0A                   asl
00020Br 2  26 rr                rol ptr+1
00020Dr 2  18                   clc
00020Er 2  69 rr                adc #<SPRTAB
000210r 2  85 rr                sta ptr
000212r 2  A5 rr                lda ptr+1
000214r 2  69 rr                adc #>SPRTAB
000216r 2  85 rr                sta ptr+1
000218r 2  A0 06                ldy #6
00021Ar 2  B1 rr                lda (ptr),y
00021Cr 2  85 rr                sta sp_flags
00021Er 2  A5 rr                lda sp_id                   ; the mask plane, from the table beside it
000220r 2  0A                   asl
000221r 2  AA                   tax
000222r 2  BD rr rr             lda SPRMSKTAB,x
000225r 2  85 rr                sta sp_mbase
000227r 2  BD rr rr             lda SPRMSKTAB+1,x
00022Ar 2  85 rr                sta sp_mbase+1
00022Cr 2               @entry2:
00022Cr 2  A0 00 B1 rr          ldaz ptr
000230r 2  85 rr                sta sp_ptr
000232r 2  A0 01                ldy #1
000234r 2  B1 rr                lda (ptr),y
000236r 2  85 rr                sta sp_ptr+1
000238r 2  C8                   iny
000239r 2  B1 rr                lda (ptr),y
00023Br 2  85 rr                sta sp_w
00023Dr 2  F0 7E                beq @out0
00023Fr 2               :                                   ; keep the bare label: it preserves the anonymous-label count
00023Fr 2  A0 07                ldy #7
000241r 2  B1 rr                lda (ptr),y
000243r 2  85 rr                sta sp_lines
000245r 2  85 rr                sta sp_ext
000247r 2                 .if MODE1
000247r 2  4A                   lsr
000248r 2  85 rr                sta sp_mh                   ; mask bytes per column group = pixel rows
00024Ar 2                 .endif
00024Ar 2  A5 rr                lda sp_flags
00024Cr 2  29 02                and #2
00024Er 2  D0 02                bne :+
000250r 2  06 rr                asl sp_ext                  ; half-res: two scanlines per stored row
000252r 2               :       ; ---- horizontal: sx = spx - refx - wx ; c0 = sx >> 1
000252r 2  A0 04                ldy #4
000254r 2  B1 rr                lda (ptr),y
000256r 2  29 80                and #$80                    ; sext inlined: the jsr/rts was 12 cycles of the 39
000258r 2  F0 02                beq @sxp
00025Ar 2  A9 FF                lda #$FF
00025Cr 2  85 rr        @sxp:   sta tmp3
00025Er 2  A5 rr                lda spx
000260r 2  38                   sec
000261r 2  F1 rr                sbc (ptr),y
000263r 2  AA                   tax
000264r 2  A5 rr                lda spx+1
000266r 2  E5 rr                sbc tmp3
000268r 2  A8                   tay
000269r 2  8A                   txa
00026Ar 2  38                   sec
00026Br 2  E5 rr                sbc wx
00026Dr 2  85 rr                sta w16
00026Fr 2  98                   tya
000270r 2  E5 rr                sbc wx+1
000272r 2  C9 80                cmp #$80
000274r 2  6A                   ror a                       ; sign into bit 7, old bit 0 out to C
000275r 2  66 rr                ror w16                     ; arithmetic shift right 1 -> c0 (16 bit)
000277r 2  C9 00                cmp #0                      ; A still holds w16+1: just restore N,Z
000279r 2  F0 22                beq @cpos
00027Br 2  C9 FF                cmp #$FF
00027Dr 2  D0 3E                bne @out0
00027Fr 2                       ; c0 negative (-128..-1): cstart = 0 ; visible if c0 + W > 0
00027Fr 2  A5 rr                lda w16
000281r 2  18                   clc
000282r 2  65 rr                adc sp_w
000284r 2  38 E9 01             deca
000287r 2  30 34                bmi @out0
000289r 2  E6 rr                inc spclip
00028Br 2  85 rr                sta sp_c1
00028Dr 2  A9 00 85 rr          stz sp_c0
000291r 2                       ; first visible column index = -c0
000291r 2  A5 rr                lda w16
000293r 2  49 FF                eor #$FF
000295r 2  18 69 01             inca
000298r 2  85 rr                sta sp_c                    ; starting image column
00029Ar 2  4C rr rr             bra @vert
00029Dr 2  A5 rr        @cpos:  lda w16
00029Fr 2  C9 50                cmp #ROWCHARS
0002A1r 2  B0 1A                bcs @out0                   ; not taken: C = 0 for the adc below
0002A3r 2  85 rr                sta sp_c0
0002A5r 2  65 rr                adc sp_w
0002A7r 2  38 E9 01             deca
0002AAr 2  C9 50                cmp #ROWCHARS
0002ACr 2  90 04                bcc :+
0002AEr 2  E6 rr                inc spclip                  ; and at the right
0002B0r 2  A9 4F                lda #(ROWCHARS-1)
0002B2r 2  85 rr        :       sta sp_c1
0002B4r 2  48 A9 00 85          stza sp_c
0002B8r 2  rr 68        
0002BAr 2  4C rr rr             bra @vert
0002BDr 2  60           @out0:  rts
0002BEr 2               @vert:
