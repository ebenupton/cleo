0000A3r 2               ; transient temps (not preserved across disc loads)
0000A3r 2               ox      = $A8
0000A3r 2               oy      = $AA
0000A3r 2               fa      = $AC
0000A3r 2               fb      = $AE
0000A3r 2               fc      = $B0
0000A3r 2               fd      = $B2
0000A3r 2               fe      = $B4
0000A3r 2               rx      = $B6
0000A3r 2               ry      = $B8
0000A3r 2               sx      = $BA
0000A3r 2               sy      = $BC
0000A3r 2               qx      = $BE
0000A3r 2               qy      = $C0
0000A3r 2               alt     = $C2
0000A3r 2               q1      = $C3
0000A3r 2               q2      = $C4
0000A3r 2               q3      = $C5
0000A3r 2               q4      = $C6
0000A3r 2               q5      = $C7
0000A3r 2               q6      = $C8
0000A3r 2               obj     = $C9
0000A3r 2               gx      = $CA
0000A3r 2               gy      = $CB
0000A3r 2               grow    = $DE                   ; bucket walk: gy << gridsh
0000A3r 2               gx0     = $CC
0000A3r 2               gx1     = $CD
0000A3r 2               gy1     = $CE
0000A3r 2               bent    = $CF
0000A3r 2               otype   = $D0
0000A3r 2               t16     = $D1                     ; 2 bytes
0000A3r 2               t16b    = $D3                     ; 2 bytes
0000A3r 2               dpx     = $D5                     ; 2 bytes: player step count etc
0000A3r 2               hx      = $D7                     ; 2 bytes: rx used for hit direction
0000A3r 2               mapptr  = $D9                     ; 2 bytes
0000A3r 2               q1x     = $DB
0000A3r 2               rise    = $DC                     ; 2 bytes
0000A3r 2               
0000A3r 2                       PLACE "LOGIC", "LGCCODE"
000276r 2               
000276r 2               ; ============================================================================
000276r 2               ; Map queries.  The map is in bank 6 with the row tables and the row-page table,
000276r 2               ; so these select it and put bank 7 back; maptilew leaves bank 6 selected for a
000276r 2               ; caller that is about to write through mapptr.
000276r 2               ; ============================================================================
000276r 2               ; get map byte at tile (X = tx, A = ty) -> A = byte, q1 = page (0/1).  The per-page
000276r 2               ; alt-class and attribute tables are 256 bytes apart (q1 used to be page*2, which sent
000276r 2               ; every page-1 row's altitude lookup into LV_MAPROWLO: no ground, Cleo fell through
000276r 2               ; the floor at the Vineyards spawn and wherever else those levels use page 1)
000276r 2               maptile:
000276r 2  20 rr rr             jsr maprow                  ; main RAM: the map is in bank 6 and this code is
000279r 2  8A                   txa                         ; in bank 7, so every touch goes through a helper
00027Ar 2  A8                   tay
00027Br 2  4C rr rr             jmp mapbyte
00027Er 2               
00027Er 2               ; tilexy: X = qx >> 3, A = qy >> 3, carry set if (qx,qy) is inside the map.
00027Er 2               ; Map sizes are multiples of 256 px, so "0 <= q < size" is just a compare of the high
00027Er 2               ; byte, and with that byte < 8 the tile coordinate is (hi << 5) | (lo >> 3) in one byte.
00027Er 2  A5 BF        tilexy: lda qx+1
000280r 2  C5 rr                cmp mapw+1
000282r 2  B0 25                bcs @out
000284r 2  0A                   asl
000285r 2  0A                   asl
000286r 2  0A                   asl
000287r 2  0A                   asl
000288r 2  0A                   asl
000289r 2  85 C4                sta q2
00028Br 2  A5 BE                lda qx
00028Dr 2  4A                   lsr
00028Er 2  4A                   lsr
00028Fr 2  4A                   lsr
000290r 2  05 C4                ora q2
000292r 2  AA                   tax
000293r 2  A5 C1                lda qy+1
000295r 2  C5 rr                cmp maph+1
000297r 2  B0 10                bcs @out
000299r 2  0A                   asl
00029Ar 2  0A                   asl
00029Br 2  0A                   asl
00029Cr 2  0A                   asl
00029Dr 2  0A                   asl
00029Er 2  85 C4                sta q2
0002A0r 2  A5 C0                lda qy
0002A2r 2  4A                   lsr
0002A3r 2  4A                   lsr
0002A4r 2  4A                   lsr
0002A5r 2  05 C4                ora q2
0002A7r 2  38                   sec
0002A8r 2  60                   rts
0002A9r 2  18           @out:   clc
0002AAr 2  60                   rts
0002ABr 2               
0002ABr 2               ; getinfo: A = alt byte for pixel (qx, qy), 8 if outside the map
0002ABr 2               getinfo:
0002ABr 2  20 rr rr             jsr tilexy                  ; X = qx>>3, A = qy>>3
0002AEr 2  B0 03                bcs :+
0002B0r 2  A9 08                lda #8
0002B2r 2  60                   rts
0002B3r 2  20 rr rr     :       jsr maptile
0002B6r 2                       ; alt class = LV_ALTCLS[tile id]
0002B6r 2  A8                   tay
0002B7r 2  B9 rr rr             lda LV_ALTCLS,y
0002BAr 2                       ; ALTTAB[cls*8 + (qx&7)]
0002BAr 2  0A                   asl
0002BBr 2  0A                   asl
0002BCr 2  0A                   asl
0002BDr 2  85 C4                sta q2
0002BFr 2  A5 BE                lda qx
0002C1r 2  29 07                and #7
0002C3r 2  05 C4                ora q2
0002C5r 2  A8                   tay
0002C6r 2  B9 rr rr             lda LV_ALTTAB,y
0002C9r 2  60                   rts
0002CAr 2               
0002CAr 2               ; getaltitude: A = altitude (signed) at pixel (qx, qy)  [qy modified]
0002CAr 2               getaltitude:
0002CAr 2  20 rr rr             jsr getinfo
0002CDr 2  85 C5                sta q3                      ; n3
0002CFr 2  4A                   lsr
0002D0r 2  4A                   lsr
0002D1r 2  4A                   lsr
0002D2r 2  4A                   lsr
0002D3r 2  85 C6                sta q4                      ; n4
0002D5r 2  A5 C0                lda qy
0002D7r 2  29 07                and #7
0002D9r 2  85 C7                sta q5                      ; n5
0002DBr 2  A5 C5                lda q3
0002DDr 2  29 0F                and #15
0002DFr 2  C5 C7                cmp q5
0002E1r 2  F0 02                beq @below
0002E3r 2  B0 18                bcs @notbelow
0002E5r 2  A5 C0        @below: lda qy
0002E7r 2  18                   clc
0002E8r 2  69 08                adc #8
0002EAr 2  85 C0                sta qy
0002ECr 2  90 02                bcc @b1
0002EEr 2  E6 C1                inc qy+1
0002F0r 2  20 rr rr     @b1:    jsr getinfo
0002F3r 2  4A                   lsr
0002F4r 2  4A                   lsr
0002F5r 2  4A                   lsr
0002F6r 2  4A                   lsr
0002F7r 2  18                   clc
0002F8r 2  69 09                adc #9                      ; the extra 1 pays the borrow: A <= 24 so adc leaves
0002FAr 2  E5 C7                sbc q5                      ; C = 0, and (A+9) - q5 - 1 is the (A+8) - q5 wanted
0002FCr 2  60                   rts
0002FDr 2               @notbelow:
0002FDr 2  A5 C6                lda q4
0002FFr 2  D0 22                bne @d2
000301r 2  A5 C0                lda qy
000303r 2  38                   sec
000304r 2  E9 08                sbc #8
000306r 2  85 C0                sta qy
000308r 2  B0 02                bcs :+
00030Ar 2  C6 C1                dec qy+1
00030Cr 2  20 rr rr     :       jsr getinfo
00030Fr 2  85 C5                sta q3
000311r 2  29 0F                and #15
000313r 2  C9 08                cmp #8
000315r 2  D0 0A                bne @done
000317r 2  A5 C5                lda q3
000319r 2  4A                   lsr
00031Ar 2  4A                   lsr
00031Br 2  4A                   lsr
00031Cr 2  4A                   lsr
00031Dr 2  E9 08                sbc #8
00031Fr 2  85 C6                sta q4
000321r 2  A5 C6        @done:  lda q4
000323r 2  38           @d2:    sec
000324r 2  E5 C7                sbc q5
000326r 2  60                   rts
000327r 2               
000327r 2               ; gettileattr: A = attribute byte for the tile at (qx,qy): bits0-2 push+3, bit7 kill ; 3 if outside
000327r 2               gettileattr:
000327r 2  20 rr rr             jsr tilexy                  ; X = qx>>3, A = qy>>3
00032Ar 2  B0 03                bcs :+
00032Cr 2  A9 03                lda #3
00032Er 2  60                   rts
00032Fr 2  20 rr rr     :       jsr maptile
000332r 2  A8                   tay
000333r 2  B9 rr rr             lda LV_ATTR0,y
000336r 2  60                   rts
000337r 2               
