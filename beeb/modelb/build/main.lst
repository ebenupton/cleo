000B20r 2                       .segment "LOGIC"            ; cold, and main RAM under the screen is full
000B20r 2               init_tables:
000B20r 2                 .if MODE1
000B20r 2                       ldx #0
000B20r 2               @mt:    txa                         ; MASKTABk[x] = mask4[(x >> (6 - 2k)) & 3]
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       tay
000B20r 2                       lda mask4,y
000B20r 2                       sta MASKTAB0,x
000B20r 2                       txa
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       and #3
000B20r 2                       tay
000B20r 2                       lda mask4,y
000B20r 2                       sta MASKTAB1,x
000B20r 2                       txa
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       and #3
000B20r 2                       tay
000B20r 2                       lda mask4,y
000B20r 2                       sta MASKTAB2,x
000B20r 2                       txa
000B20r 2                       and #3
000B20r 2                       tay
000B20r 2                       lda mask4,y
000B20r 2                       sta MASKTAB3,x
000B20r 2                       inx
000B20r 2                       bne @mt
000B20r 2                 .else
000B20r 2                       jsr init_ident
000B20r 2                 .endif
000B20r 2                       ldx #0
000B20r 2               @t:     txa
000B20r 2                 .if .not MODE1
000B20r 2                       and #$AA
000B20r 2                       beq :+
000B20r 2                       lda #0
000B20r 2                       bra :++
000B20r 2               :       lda #$AA
000B20r 2               :       sta tmp
000B20r 2                       txa
000B20r 2                       and #$55
000B20r 2                       beq :+
000B20r 2                       lda #0
000B20r 2                       bra :++
000B20r 2               :       lda #$55
000B20r 2               :       ora tmp
000B20r 2                       sta MASKTAB,x
000B20r 2                 .endif
000B20r 2                 .if MODE1
000B20r 2                       ; MODE 1: a byte is four dots, bit 7-i / bit 3-i for dot i; mirroring reverses
000B20r 2                       ; them: 7<->4, 6<->5, 3<->0, 2<->1
000B20r 2                       txa
000B20r 2                       and #$88
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       lsr
000B20r 2                       sta tmp
000B20r 2                       txa
000B20r 2                       and #$44
000B20r 2                       lsr
000B20r 2                       ora tmp
000B20r 2                       sta tmp
000B20r 2                       txa
000B20r 2                       and #$22
000B20r 2                       asl
000B20r 2                       ora tmp
000B20r 2                       sta tmp
000B20r 2                       txa
000B20r 2                       and #$11
000B20r 2                       asl
000B20r 2                       asl
000B20r 2                       asl
000B20r 2                       ora tmp
000B20r 2                 .else
000B20r 2                       txa
000B20r 2                       and #$AA
000B20r 2                       lsr
000B20r 2                       sta tmp
000B20r 2                       txa
000B20r 2                       and #$55
000B20r 2                       asl
000B20r 2                       ora tmp
000B20r 2                 .endif
000B20r 2                       sta SWAPTAB,x
000B20r 2                       inx
000B20r 2                       bne @t
000B20r 2                 .if .not MODE1
000B20r 2                       ; sprite encoding (convert.py encode_sprite): bit 7 = both pixels opaque and never
000B20r 2                       ; reaches the tables; left-black-only is code $44 (its $80 slot is taken)
000B20r 2                       lda #$55
000B20r 2                       sta MASKTAB+$44             ; keep the right screen pixel
000B20r 2                       stz IDENT+$44               ; left pixel black
000B20r 2                       lda #$44
000B20r 2                       sta SWAPTAB+$40             ; right-black-only <-> left-black-only
000B20r 2                       lda #$40
000B20r 2                       sta SWAPTAB+$44
000B20r 2                       lda #$FF                    ; $41 marks eight transparent bytes; if it reaches
000B20r 2                       sta MASKTAB+$41             ; the tables (a clipped cell, or as a line 1..7)
000B20r 2                       stza IDENT+$41               ; it must leave the screen byte alone.  $82 is its
000B20r 2                       sta MASKTAB+$82             ; mirror image, and unreachable otherwise
000B20r 2                       stz IDENT+$82
000B20r 2                       ; MASKTAB+$80..: the mask of the mirrored byte, so the mirrored blitters do one
000B20r 2                       ; lookup instead of SWAPTAB then MASKTAB (only codes < $80 are ever looked up)
000B20r 2                       ldx #0
000B20r 2               :       ldy SWAPTAB,x
000B20r 2                       lda MASKTAB,y
000B20r 2                       sta MASKTAB+$80,x
000B20r 2                       lda IDENT,y
000B20r 2                       sta IDENT+$80,x             ; and its OR value (differs from SWAPTAB only at \$40)
000B20r 2                       inx
000B20r 2                       bpl :-
000B20r 2                 .endif
000B20r 2                       jsr build_ring              ; ring row -> screen address
000B20r 2                       ; row slot -> chars
000B20r 2                       stz w16
000B20r 2                       stz w16+1
000B20r 2                       ldx #0
000B20r 2               @m80:   lda w16+1
000B20r 2                       sta mulrowhi,x
000B20r 2                       lda w16
000B20r 2                       sta mulrowlo,x
000B20r 2                       clc
000B20r 2                       adc #ROWCHARS
000B20r 2                       sta w16
000B20r 2                       bcc :+
000B20r 2                       inc w16+1
000B20r 2               :       inx
000B20r 2                       cpx #RINGROWS
000B20r 2                       bne @m80
000B20r 2                       ldx #0
000B20r 2                       lda #0
000B20r 2               @m:     sta sprmul5,x
000B20r 2                       clc
000B20r 2                       adc #5
000B20r 2                       inx
000B20r 2                       cpx #MAXSPR
000B20r 2                       bne @m
000B20r 2                       stz RECCNT
000B20r 2                       stz RECCNT+1
000B20r 2                       stz DIRTYCNT
000B20r 2                       stz DIRTYCNT+1
000B20r 2                       stz BUF_VALID
000B20r 2                       stz BUF_VALID+1
000B20r 2                       stz NSPR
000B20r 2                       stz SFXREQ
000B20r 2                       stz SFXPTR+1
000B20r 2                       stz MUSON
000B20r 2                       stz DISPSECT
000B20r 2                       stz curbuf
000B20r 2                       lda #BANK_SPR
000B20r 2                       sta spbank
000B20r 2                       lda #$FF
000B20r 2                       sta BUF_BARQ
000B20r 2                       sta BUF_BARQ+1
000B20r 2                       sta tset                    ; no tile set resident yet
000B20r 2                       stz BARDIRTY
000B20r 2                       stz BARBG
000B20r 2                       lda #<VS2T_DEFAULT
000B20r 2                       sta VS2T
000B20r 2                       lda #>VS2T_DEFAULT
000B20r 2                       sta VS2T+1
000B20r 2                       rts
000B20r 2               
000B20r 2               
000B20r 2               ; identity table for the sprite blitter (A | X without a temp store)
000B20r 2                 .if .not MODE1
000B20r 2               init_ident:
000B20r 2                       ldx #0
000B20r 2               :       txa
000B20r 2                       sta IDENT,x
000B20r 2                       inx
