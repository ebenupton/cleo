000D54r 2  00 00 33 33          .incbin "build/digits.bin"
000D58r 2  FD FF EE CC  
000D5Cr 2  FF FF E6 CC  
000FD4r 2                       .segment "LGCBSS"
000080r 2               ; the object state arrays, laid out as the Master's (logic.s): O_STAMP + k*OBJN, then
000080r 2               ; the grid heads and chains and the cached bin walk lists.  level_init's clear runs
000080r 2               ; 2560 bytes from LV_OBJST, which stays inside these.
000080r 2  xx xx xx xx  LV_OBJST:   .res 16*OBJN
000084r 2  xx xx xx xx  
000088r 2  xx xx xx xx  
000860r 2  xx xx xx xx  LV_GRID:    .res 128
000864r 2  xx xx xx xx  
000868r 2  xx xx xx xx  
0008E0r 2  xx xx xx xx  LV_BOBJ:    .res 256                ; an entry per object per grid cell it covers: up
0008E4r 2  xx xx xx xx  
0008E8r 2  xx xx xx xx  
