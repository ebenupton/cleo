000000r 1               ; Cleo, Model B target.  One assembly, four bank images: see DESIGN.md.
000000r 1                       .include "defs.inc"
000000r 2               ; ============================================================================
000000r 2               ; Cleo, Model B target: the memory map is the design.
000000r 2               ;
000000r 2               ;   $0000-$00FF  zero page, shared by all four banks
000000r 2               ;   $0100-$013F  stack
000000r 2               ;   $0140-$02FF  ISR, section table, thunks, the map strip buffer
000000r 2               ;   $0300-$07FF  status bar, 2 rows, single buffered, scanned where it is drawn
000000r 2               ;   $0800-$0A7F  mirror A     a copy of ring A's last row
000000r 2               ;   $0A80-$43FF  ring A       23 slots of 640 bytes
000000r 2               ;   $4400-$467F  mirror B
000000r 2               ;   $4680-$7FFF  ring B
000000r 2               ; ============================================================================
000000r 2               ROWCHARS  = 80
000000r 2               ROWBYTES  = ROWCHARS*8
000000r 2               RINGROWS  = 23                      ; slots in a ring
000000r 2               VISROWS   = 21                      ; visible char rows: 168 lines = 84 game px
000000r 2               BUFROWS   = VISROWS + 1             ; held: the visible rows plus the bottom partial's source
000000r 2               RINGCHARS = ROWCHARS*RINGROWS
000000r 2               RINGBYTES = ROWBYTES*RINGROWS       ; 14720: NOT a whole number of pages, so the fold
000000r 2                                                   ; body is 16 bit -- but both ring ENDS are page
000000r 2                                                   ; aligned, so the fold test stays 8 bit
000000r 2               MAXDWY    = 8
000000r 2               
000000r 2               BARADDR   = $0300
000000r 2               BARROWS   = 2
000000r 2               BARCRTC   = BARADDR / 8
000000r 2               
000000r 2               RING_A    = $0A80
000000r 2               RING_B    = $4680
000000r 2               MIRR_A    = RING_A - ROWBYTES       ; $0800
000000r 2               MIRR_B    = RING_B - ROWBYTES       ; $4400
000000r 2               RINGEND_A = RING_A + RINGBYTES      ; $4400
000000r 2               RINGEND_B = RING_B + RINGBYTES      ; $8000
000000r 2               CRTCB_A   = RING_A / 8
000000r 2               CRTCB_B   = RING_B / 8
000000r 2               
000000r 2               ; 39 rows of 8 lines = 312.  2 bar + 21 playfield + 16 blanking, vsync at Q row 8, so
000000r 2               ; the picture starts 64 lines after the vsync: 4 lines below where a MODE 1 screen sits.
000000r 2               QROWS     = 39 - VISROWS - BARROWS
000000r 2               QVSYNC    = 8
000000r 2               LINE      = 64                      ; T1 ticks in one scanline
000000r 2               ; CA1 fires at the end of the 2-line vsync pulse.  -35 would put each step ~5 us INTO
000000r 2               ; its section; the further -36 puts it ~30 us BEFORE the restart instead, so the shape
000000r 2               ; registers land early in the section's first scanline.
000000r 2               VS2T_DEFAULT = (QROWS-QVSYNC)*8*LINE - 2*LINE - 35 - 36
000000r 2               
000000r 2               ; ---------------------------------------------------------------- hardware
000000r 2               CRTC_IDX  = $FE00
000000r 2               CRTC_DAT  = $FE01
000000r 2               ULA_CTRL  = $FE20
000000r 2               ULA_PAL   = $FE21
000000r 2               VIA_T1CL  = $FE44
000000r 2               VIA_T1CH  = $FE45
000000r 2               VIA_T1LL  = $FE46
000000r 2               VIA_T1LH  = $FE47
000000r 2               VIA_ACR   = $FE4B
000000r 2               VIA_IFR   = $FE4D
000000r 2               VIA_IER   = $FE4E
000000r 2               UVIA_IER  = $FE6E
000000r 2               IRQ1V     = $0204
000000r 2               OSWRCH    = $FFEE
000000r 2               
000000r 2               RINGMODTAB = $8000                  ; 256 bytes at the foot of every bank
000000r 2               BANKCODE   = $8100                  ; where each bank's code starts
000000r 2               
000000r 2               MAXSPR    = 24
000000r 2               MAXREC    = 16
000000r 2               
000000r 2               ; ---------------------------------------------------------------- far calls
000000r 2               ; The index of a (bank, address) entry in FARTAB.  Everything that crosses a bank
000000r 2               ; boundary goes through one of these, and the list is meant to stay short: the traffic
000000r 2               ; is per frame or per rectangle, never per tile.
000000r 2               F_VSYNC    = 0*3
000000r 2               F_SCANKEYS = 1*3
000000r 2               F_SNDTICK  = 2*3
000000r 2               F_MAPSTRIP = 3*3
000000r 2               F_DRAWRECT = 4*3
000000r 2               F_SCROLLV  = 5*3
000000r 2               F_DRAWDIRT = 6*3
000000r 2               F_DRAWSPR  = 7*3
000000r 2               F_ERASE    = 8*3
000000r 2               F_PARTIAL  = 9*3
000000r 2               F_BARFLUSH = 10*3
000000r 2               F_ADDSPR   = 11*3
000000r 2               NFAR       = 12
000000r 2               
000000r 1                       .include "cpu.inc"
000000r 2               ; ============================================================================
000000r 2               ; The Model B is a plain 6502: the 65C02 instructions the engine is written in
000000r 2               ; become macros here.  Same spellings as the Master build so the sources stay
000000r 2               ; comparable -- stza is the form that keeps A, stz the one that may clobber it.
000000r 2               ; ============================================================================
000000r 2                       .setcpu "6502"
000000r 2               .macro stz arg, ix                  ; A dead: the caller has said so by using stz
000000r 2                       lda #0
000000r 2               .if .paramcount = 2
000000r 2                       sta arg,ix
000000r 2               .else
000000r 2                       sta arg
000000r 2               .endif
000000r 2               .endmacro
000000r 2               .macro stza arg, ix                 ; A live across the store
000000r 2                       pha
000000r 2                       lda #0
000000r 2               .if .paramcount = 2
000000r 2                       sta arg,ix
000000r 2               .else
000000r 2                       sta arg
000000r 2               .endif
000000r 2                       pla
000000r 2               .endmacro
000000r 2               .macro bra arg
000000r 2                       jmp arg
000000r 2               .endmacro
000000r 2               .macro inca
000000r 2                       clc
000000r 2                       adc #1
000000r 2               .endmacro
000000r 2               .macro deca
000000r 2                       sec
000000r 2                       sbc #1
000000r 2               .endmacro
000000r 2               .macro phx
000000r 2                       txa
000000r 2                       pha
000000r 2               .endmacro
000000r 2               .macro plx
000000r 2                       pla
000000r 2                       tax
000000r 2               .endmacro
000000r 2               .macro phy
000000r 2                       tya
000000r 2                       pha
000000r 2               .endmacro
000000r 2               .macro ply
000000r 2                       pla
000000r 2                       tay
000000r 2               .endmacro
000000r 2               .macro jmpx tab                     ; jmp (abs,x): through a zero page vector
000000r 2                       pha
000000r 2                       lda tab,x
000000r 2                       sta jv
000000r 2                       lda tab+1,x
000000r 2                       sta jv+1
000000r 2                       pla
000000r 2                       jmp (jv)
000000r 2               .endmacro
000000r 2               .macro ldaz zp                      ; (zp) with no index: Y is free at every site
000000r 2                       ldy #0
000000r 2                       lda (zp),y
000000r 2               .endmacro
000000r 2               .macro staz zp
000000r 2                       ldy #0
000000r 2                       sta (zp),y
000000r 2               .endmacro
000000r 2               .macro andz zp
000000r 2                       ldy #0
000000r 2                       and (zp),y
000000r 2               .endmacro
000000r 2               
000000r 2               ; ---------------------------------------------------------------- banking
000000r 2               ROMSEL    = $FE30
000000r 2               ROMSEL_CPY = $F4                    ; the OS's copy: an interrupt that pages a ROM in
000000r 2                                                   ; restores from here, so both are always written
000000r 2               BANK_SPR  = 4                       ; sprite images + the sprite blitter
000000r 2               BANK_TIL  = 5                       ; this level's tiles + the tile blitter
000000r 2               BANK_MAP  = 6                       ; the map, objects, attributes
000000r 2               BANK_LGC  = 7                       ; the game logic and the frame loop
000000r 2               
000000r 2               .macro setbank n                    ; A is clobbered
000000r 2                       lda #n
000000r 2                       sta ROMSEL_CPY
000000r 2                       sta ROMSEL
000000r 2               .endmacro
000000r 2               
000000r 2               ; A far call: X = the index of a (bank, address) entry in FARTAB.  farcall itself is
000000r 2               ; in main RAM, which is why a bank may call one that replaces it.
000000r 2               .macro farjsr idx
000000r 2                       ldx #idx
000000r 2                       jsr farcall
000000r 2               .endmacro
000000r 2               
