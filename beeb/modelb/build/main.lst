000565r 2               .macro MLINE mirror                 ; masked store of line Y
000565r 2                 .if mirror
000565r 2                       lda (ptr),y
000565r 2                       tax
000565r 2                       lda SWAPTAB,x
000565r 2                       sta sp_ext                  ; dead during the blit
000565r 2                       lda (sp),y
000565r 2                       and sp_msk
000565r 2                       ora sp_ext
000565r 2                 .else
000565r 2                       lda (sp),y
000565r 2                       and sp_msk
000565r 2                       ora (ptr),y
000565r 2                 .endif
000565r 2                       sta (sp),y
000565r 2               .endmacro
000565r 2               .macro CLINE mirror                 ; plain store of line Y
000565r 2                       lda (ptr),y
000565r 2                 .if mirror
000565r 2                       tax
000565r 2                       lda SWAPTAB,x
000565r 2                 .endif
000565r 2                       sta (sp),y
000565r 2               .endmacro
000565r 2               .macro MPAIR k, mirror              ; lines k, k+1 of the cell
000565r 2                       .local opq, done
000565r 2                       ldy #k/2
000565r 2                       lda (mptr),y
000565r 2                       tay
000565r 2                       lda (mtab),y
000565r 2                       beq opq                     ; $00: both pixels opaque, plain stores
000565r 2                       cmp #$FF
000565r 2                       beq done                    ; both transparent
000565r 2                 .if mirror
000565r 2                       tax
000565r 2                       lda SWAPTAB,x
000565r 2                 .endif
000565r 2                       sta sp_msk
000565r 2                       ldy #k
000565r 2                       MLINE mirror
000565r 2                       iny
000565r 2                       MLINE mirror
000565r 2                       bra done
000565r 2               opq:    ldy #k
000565r 2                       CLINE mirror
000565r 2                       iny
000565r 2                       CLINE mirror
000565r 2               done:
000565r 2               .endmacro
000565r 2               .macro SPRMSK name, mirror
000565r 2                       .local partial, np, et, p0, p1, p2, p3, pl, pop, pnext
000565r 2               name:
000565r 2                       lda tmp2
000565r 2                       cmp #7
000565r 2                       bne np
000565r 2                       lda tmp                     ; even: 0,2,4,6 -> entry p0..p3
000565r 2                       beq p0
000565r 2                       tax
000565r 2                       jmpx et
000565r 2               np:     jmp partial
000565r 2               et:     .word p0, p1, p2, p3
000565r 2               p0:     MPAIR 0, mirror
000565r 2               p1:     MPAIR 2, mirror
000565r 2               p2:     MPAIR 4, mirror
000565r 2               p3:     MPAIR 6, mirror
000565r 2                 .if mirror
000565r 2                       jmp sprretMk
000565r 2                 .else
000565r 2                       jmp sprretPk
000565r 2                 .endif
000565r 2               partial:                            ; lines tmp..tmp2: tmp even, tmp2 odd
000565r 2                       lda tmp
000565r 2                       sta sp_lim
000565r 2               pl:     lda sp_lim
000565r 2                       lsr
000565r 2                       tay
000565r 2                       lda (mptr),y
000565r 2                       tay
000565r 2                       lda (mtab),y
000565r 2                       beq pop
000565r 2                       cmp #$FF
000565r 2                       beq pnext
000565r 2                 .if mirror
000565r 2                       tax
000565r 2                       lda SWAPTAB,x
000565r 2                 .endif
000565r 2                       sta sp_msk
000565r 2                       ldy sp_lim
000565r 2                       MLINE mirror
000565r 2                       iny
000565r 2                       MLINE mirror
000565r 2                       bra pnext
000565r 2               pop:    ldy sp_lim
000565r 2                       CLINE mirror
000565r 2                       iny
000565r 2                       CLINE mirror
000565r 2               pnext:  lda sp_lim
000565r 2                       inca
000565r 2                       inca
000565r 2                       sta sp_lim
000565r 2                       cmp tmp2
000565r 2                       bcc pl
000565r 2                 .if mirror
000565r 2                       jmp sprretMk
000565r 2                 .else
000565r 2                       jmp sprretPk
000565r 2                 .endif
000565r 2               .endmacro
