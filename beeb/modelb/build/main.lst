0008BFr 2               ; ---- inner blocks.  ptr = source column (already offset), sp = screen char,
0008BFr 2               ;      tmp = ra0', tmp2 = ra1'.  Full-res: source byte per line.
0008BFr 2               .macro SPRLINE k, mirror, copy, solid, blank
0008BFr 2                       .local done, skip, opaque, masked
0008BFr 2               .if k = 0
0008BFr 2                       ldaz ptr                    ; line 0: Y is not needed here
0008BFr 2               .else
0008BFr 2                       ldy #k
0008BFr 2                       lda (ptr),y
0008BFr 2               .endif
0008BFr 2               .if copy
0008BFr 2                 .if mirror
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2                 .endif
0008BFr 2                 .if k = 0
0008BFr 2                       staz sp                     ; box sprite: every byte opaque, plain copy
0008BFr 2                 .else
0008BFr 2                       sta (sp),y
0008BFr 2                 .endif
0008BFr 2               .else
0008BFr 2                 .if k = 0
0008BFr 2                       beq done                    ; 0: both pixels transparent, no store
0008BFr 2                       bpl masked                  ; (N from the load: cmp would set it from the subtraction)
0008BFr 2                       cmp #$C0
0008BFr 2                       bcc opaque                  ; bit7 alone: single opaque byte
0008BFr 2                       jmp solid                   ; bit 7+6: this and the next 7 bytes all opaque
0008BFr 2               masked: cmp #$41                    ; and the mirror image of that: this and the next 7
0008BFr 2                       beq blank                   ; all transparent, so the cell is left alone
0008BFr 2                 .else
0008BFr 2                       bmi opaque                  ; bit 7: both pixels opaque (see encode_sprite).  Tested
0008BFr 2                       beq done                    ; before the transparent case because the sprite data is
0008BFr 2                                                   ; 45.7% opaque against 24.1% transparent, and both read
0008BFr 2                                                   ; the same load's flags -- $00 is never negative
0008BFr 2                       cmp #$41                    ; a blank-run tag reached below line 0 (the packer marks
0008BFr 2                       bne :+                      ; every line a run covers): the rest of this cell is all
0008BFr 2                       jmp blank                   ; transparent, so skip it -- $41 else draws a red pixel
0008BFr 2               :
0008BFr 2                 .endif
0008BFr 2                       tax
0008BFr 2                 .if mirror
0008BFr 2                       lda MASKTAB+$80,x           ; mask of the mirrored byte (MASKTAB[SWAPTAB[x]])
0008BFr 2                 .else
0008BFr 2                       lda MASKTAB,x
0008BFr 2                 .endif
0008BFr 2                 .if k = 0
0008BFr 2                       andz sp
0008BFr 2                 .else
0008BFr 2                       and (sp),y
0008BFr 2                 .endif
0008BFr 2                 .if mirror
0008BFr 2                       ora IDENT+$80,x             ; the mirrored byte's OR value (IDENT[SWAPTAB[x]])
0008BFr 2                 .else
0008BFr 2                       ora IDENT,x
0008BFr 2                 .endif
0008BFr 2                 .if mirror
0008BFr 2                       bra skip                    ; only the mirrored form has anything at 'opaque' to
0008BFr 2                 .endif                            ; jump over; unmirrored, this branched to the next
0008BFr 2               opaque:                             ; instruction, 3 cycles on every masked byte
0008BFr 2                 .if mirror
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2                 .endif
0008BFr 2               skip:
0008BFr 2                 .if k = 0
0008BFr 2                       staz sp
0008BFr 2                 .else
0008BFr 2                       sta (sp),y
0008BFr 2                 .endif
0008BFr 2               done:
0008BFr 2               .endif
0008BFr 2               .endmacro
0008BFr 2               
0008BFr 2               .macro SOLID1 k
0008BFr 2                       ldy #k
0008BFr 2                       lda (ptr),y
0008BFr 2                       sta (sp),y
0008BFr 2               .endmacro
0008BFr 2               .macro SOLIDM k                     ; mirrored: nibble swap through the table
0008BFr 2               .if k > 0
0008BFr 2                       ldy #k
0008BFr 2                       lda (ptr),y
0008BFr 2               .endif
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2               .if k = 0
0008BFr 2                       staz sp
0008BFr 2               .else
0008BFr 2                       sta (sp),y
0008BFr 2               .endif
0008BFr 2               .endmacro
0008BFr 2               
0008BFr 2               .macro SPRFULL name, mirror, copy
0008BFr 2                       .local partial, et, l0, l1, l2, l3, l4, l5, l6, l7, pl, ps, po, pd, solid, blank
0008BFr 2               .if .not copy
0008BFr 2               solid:  ; byte 0 carried the RUN flag: the whole cell is opaque, straight copy
0008BFr 2               .if mirror
0008BFr 2                       SOLIDM 0
0008BFr 2                       SOLIDM 1
0008BFr 2                       SOLIDM 2
0008BFr 2                       SOLIDM 3
0008BFr 2                       SOLIDM 4
0008BFr 2                       SOLIDM 5
0008BFr 2                       SOLIDM 6
0008BFr 2                       SOLIDM 7
0008BFr 2                       jmp sprretM
0008BFr 2               .else
0008BFr 2                       staz sp                     ; A = byte 0
0008BFr 2                       ldy #1
0008BFr 2                       lda (ptr),y
0008BFr 2                       sta (sp),y
0008BFr 2                       iny
0008BFr 2                       lda (ptr),y
0008BFr 2                       sta (sp),y
0008BFr 2                       iny
0008BFr 2                       lda (ptr),y
0008BFr 2                       sta (sp),y
0008BFr 2                       iny
0008BFr 2                       lda (ptr),y
0008BFr 2                       sta (sp),y
0008BFr 2                       iny
0008BFr 2                       lda (ptr),y
0008BFr 2                       sta (sp),y
0008BFr 2                       iny
0008BFr 2                       lda (ptr),y
0008BFr 2                       sta (sp),y
0008BFr 2                       iny
0008BFr 2                       lda (ptr),y
0008BFr 2                       sta (sp),y
0008BFr 2                       jmp sprretP
0008BFr 2               .endif
0008BFr 2               .endif
0008BFr 2               name:
0008BFr 2                       lda tmp2
0008BFr 2                       cmp #7
0008BFr 2                       bne @np
0008BFr 2                       lda tmp
0008BFr 2                       beq l0                      ; the whole cell: the overwhelmingly common case, and
0008BFr 2                       asl                         ; it needs no table at all (was lda/asl/tax/jmpx, 21
0008BFr 2                       tax                         ; cycles of dispatch to reach the same place)
0008BFr 2                       jmpx et
0008BFr 2               @np:    jmp partial
0008BFr 2               et:     .word l0,l1,l2,l3,l4,l5,l6,l7
0008BFr 2               .if .not copy
0008BFr 2               blank:  ; byte 0 was $41: the whole cell is transparent, so there is nothing to do
0008BFr 2               .if mirror
0008BFr 2                       jmp sprretM
0008BFr 2               .else
0008BFr 2                       jmp sprretP
0008BFr 2               .endif
0008BFr 2               .endif
0008BFr 2               l0:     SPRLINE 0, mirror, copy, solid, blank
0008BFr 2               l1:     SPRLINE 1, mirror, copy, solid, blank
0008BFr 2               l2:     SPRLINE 2, mirror, copy, solid, blank
0008BFr 2               l3:     SPRLINE 3, mirror, copy, solid, blank
0008BFr 2               l4:     SPRLINE 4, mirror, copy, solid, blank
0008BFr 2               l5:     SPRLINE 5, mirror, copy, solid, blank
0008BFr 2               l6:     SPRLINE 6, mirror, copy, solid, blank
0008BFr 2               l7:     SPRLINE 7, mirror, copy, solid, blank
0008BFr 2                       .if mirror
0008BFr 2                       jmp sprretM
0008BFr 2                       .else
0008BFr 2                       jmp sprretP
0008BFr 2                       .endif
0008BFr 2               partial:
0008BFr 2                       ldy tmp
0008BFr 2               .if copy
0008BFr 2               pl:     lda (ptr),y
0008BFr 2                 .if mirror
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2                 .endif
0008BFr 2                       sta (sp),y
0008BFr 2               .else
0008BFr 2               pl:     lda (ptr),y
0008BFr 2                       bmi po                      ; bit 7: both pixels opaque.  Tested before the
0008BFr 2                       beq ps                      ; transparent case for the same reason SPRLINE does
0008BFr 2                       ; it -- 45.7% opaque against 24.1% transparent, and
0008BFr 2                       ; both read this load's flags ($00 is never negative)
0008BFr 2                       cmp #$41
0008BFr 2                       beq pd
0008BFr 2                       tax
0008BFr 2               .if mirror
0008BFr 2                       lda MASKTAB+$80,x
0008BFr 2                       and (sp),y
0008BFr 2                       ora IDENT+$80,x
0008BFr 2               .else
0008BFr 2                       lda MASKTAB,x
0008BFr 2                       and (sp),y
0008BFr 2                       ora IDENT,x
0008BFr 2               .endif
0008BFr 2                       sta (sp),y
0008BFr 2                       bra ps
0008BFr 2               po:
0008BFr 2               .if mirror
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2               .endif
0008BFr 2                       sta (sp),y
0008BFr 2               .endif
0008BFr 2               ps:     cpy tmp2
0008BFr 2                       beq pd
0008BFr 2                       iny
0008BFr 2                       bra pl
0008BFr 2               pd:
0008BFr 2                       .if mirror
0008BFr 2                       jmp sprretM
0008BFr 2                       .else
0008BFr 2                       jmp sprretP
0008BFr 2                       .endif
0008BFr 2               .endmacro
0008BFr 2               
0008BFr 2                 .if ::MODE1
0008BFr 2               ; ---- MODE 1 masked blitter.  A col entry has no spare bit, so the mask is a plane of
0008BFr 2               ; its own: one bit per game pixel, a data byte's two pixels as a 2-bit pair, four
0008BFr 2               ; horizontally adjacent columns packed into one byte (column 4g+j in bits 7-2j, 6-2j),
0008BFr 2               ; column-group-major: for group g, one byte per pixel row -- the shape of the data, so
0008BFr 2               ; mptr walks like ptr.  MASKTAB0..3 turn a whole mask byte into the AND mask for the
0008BFr 2               ; column of that phase, no shifting: $FF (both transparent) $CC $33 $00 (both opaque).
0008BFr 2               ; The two scanlines of a pixel row share a mask, so lines go in pairs, and a sprite's
0008BFr 2               ; first line in a cell is always even (refy is a multiple of 4 game px).  The data has
0008BFr 2               ; 0 in transparent pixels, so screen = (screen AND mask) OR data.  Mirrored: the pair's
0008BFr 2               ; mask is SWAPTAB of the table's answer ($33 <-> $CC), and the data byte is swapped.
0008BFr 2               .macro MLINE mirror                 ; masked store of line Y
0008BFr 2                 .if mirror
0008BFr 2                       lda (ptr),y
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2                       sta sp_ext                  ; dead during the blit
0008BFr 2                       lda (sp),y
0008BFr 2                       and sp_msk
0008BFr 2                       ora sp_ext
0008BFr 2                 .else
0008BFr 2                       lda (sp),y
0008BFr 2                       and sp_msk
0008BFr 2                       ora (ptr),y
0008BFr 2                 .endif
0008BFr 2                       sta (sp),y
0008BFr 2               .endmacro
0008BFr 2               .macro CLINE mirror                 ; plain store of line Y
0008BFr 2                       lda (ptr),y
0008BFr 2                 .if mirror
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2                 .endif
0008BFr 2                       sta (sp),y
0008BFr 2               .endmacro
0008BFr 2               .macro MPAIR k, mirror              ; lines k, k+1 of the cell
0008BFr 2                       .local opq, done
0008BFr 2                       ldy #k/2
0008BFr 2                       lda (mptr),y
0008BFr 2                       tay
0008BFr 2                       lda (mtab),y
0008BFr 2                       beq opq                     ; $00: both pixels opaque, plain stores
0008BFr 2                       cmp #$FF
0008BFr 2                       beq done                    ; both transparent
0008BFr 2                 .if mirror
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2                 .endif
0008BFr 2                       sta sp_msk
0008BFr 2                       ldy #k
0008BFr 2                       MLINE mirror
0008BFr 2                       iny
0008BFr 2                       MLINE mirror
0008BFr 2                       bra done
0008BFr 2               opq:    ldy #k
0008BFr 2                       CLINE mirror
0008BFr 2                       iny
0008BFr 2                       CLINE mirror
0008BFr 2               done:
0008BFr 2               .endmacro
0008BFr 2               .macro SPRMSK name, mirror
0008BFr 2                       .local partial, np, et, p0, p1, p2, p3, pl, pop, pnext
0008BFr 2               name:
0008BFr 2                       lda tmp2
0008BFr 2                       cmp #7
0008BFr 2                       bne np
0008BFr 2                       lda tmp                     ; even: 0,2,4,6 -> entry p0..p3
0008BFr 2                       beq p0
0008BFr 2                       tax
0008BFr 2                       jmpx et
0008BFr 2               np:     jmp partial
0008BFr 2               et:     .word p0, p1, p2, p3
0008BFr 2               p0:     MPAIR 0, mirror
0008BFr 2               p1:     MPAIR 2, mirror
0008BFr 2               p2:     MPAIR 4, mirror
0008BFr 2               p3:     MPAIR 6, mirror
0008BFr 2                 .if mirror
0008BFr 2                       jmp sprretMk
0008BFr 2                 .else
0008BFr 2                       jmp sprretPk
0008BFr 2                 .endif
0008BFr 2               partial:                            ; lines tmp..tmp2: tmp even, tmp2 odd
0008BFr 2                       lda tmp
0008BFr 2                       sta sp_lim
0008BFr 2               pl:     lda sp_lim
0008BFr 2                       lsr
0008BFr 2                       tay
0008BFr 2                       lda (mptr),y
0008BFr 2                       tay
0008BFr 2                       lda (mtab),y
0008BFr 2                       beq pop
0008BFr 2                       cmp #$FF
0008BFr 2                       beq pnext
0008BFr 2                 .if mirror
0008BFr 2                       tax
0008BFr 2                       lda SWAPTAB,x
0008BFr 2                 .endif
0008BFr 2                       sta sp_msk
0008BFr 2                       ldy sp_lim
0008BFr 2                       MLINE mirror
0008BFr 2                       iny
0008BFr 2                       MLINE mirror
0008BFr 2                       bra pnext
0008BFr 2               pop:    ldy sp_lim
0008BFr 2                       CLINE mirror
0008BFr 2                       iny
0008BFr 2                       CLINE mirror
0008BFr 2               pnext:  lda sp_lim
0008BFr 2                       inca
0008BFr 2                       inca
0008BFr 2                       sta sp_lim
0008BFr 2                       cmp tmp2
0008BFr 2                       bcc pl
0008BFr 2                 .if mirror
0008BFr 2                       jmp sprretMk
0008BFr 2                 .else
0008BFr 2                       jmp sprretPk
0008BFr 2                 .endif
0008BFr 2               .endmacro
0008BFr 2                 .endif
0008BFr 2               ; The row loop and the inner blocks.  On the Master this is plain code after the
0008BFr 2               ; prologue; on the Model B it is assembled once into EACH sprite data bank (the loop
0008BFr 2               ; reads image bytes, so it must be resident with them) and reached by a far call
0008BFr 2               ; from the prologue, which lives with the directory in bank 5.
0008BFr 2               .macro SPRITE_LOOPS withmirror, withcopy   ; withmirror = 0: a copy for a bank whose
0008BFr 2                 .if ::MODELB                      ; images are never drawn mirrored (no sprFM, no
0008BFr 2                                                   ; SWAPTAB); withcopy = 0: none drawn by the copy
0008BFr 2                                                   ; blitter (no sprFC)
0008BFr 2               ds_entry:                           ; the far entry: the dispatch jump is patched here,
0008BFr 2                       ldx sp_disp                 ; in the bank that owns it
0008BFr 2                       lda sprdisp_tab,x
0008BFr 2                       sta ds_dispatch+1
0008BFr 2                       lda sprdisp_tab+1,x
0008BFr 2                       sta ds_dispatch+2
0008BFr 2                 .endif
0008BFr 2               ds_rowloop:
0008BFr 2                       lda sp_rb
0008BFr 2                       sta sp
0008BFr 2                       lda sp_rb+1
0008BFr 2                       sta sp+1
0008BFr 2                       lda sp_rp
0008BFr 2                       sta ptr
0008BFr 2                       lda sp_rp+1
0008BFr 2                       sta ptr+1
0008BFr 2                 .if ::MODE1
0008BFr 2                       lda sp_mrp
0008BFr 2                       sta mptr
0008BFr 2                       lda sp_mrp+1
0008BFr 2                       sta mptr+1
0008BFr 2                       lda sp_mpg0
0008BFr 2                       sta mtab+1
0008BFr 2                 .endif
0008BFr 2                       ; ra range for this row
0008BFr 2                       stz tmp                     ; ra0' = 0 unless this is the first row
0008BFr 2                       lda sp_row
0008BFr 2                       cmp sp_r0
0008BFr 2                       bne :+
0008BFr 2                       ldx sp_ra0
0008BFr 2                       stx tmp
0008BFr 2               :       ldx #7
0008BFr 2                       cmp sp_r1
0008BFr 2                       bne :+
0008BFr 2                       ldx sp_ra1
0008BFr 2               :       stx tmp2                    ; ra1'
0008BFr 2                       lda sp_ncol
0008BFr 2                       sta sp_cnt                  ; columns-1 (countdown)
0008BFr 2               ds_colloop:
0008BFr 2               ds_dispatch:
0008BFr 2                       jmp sprFN                   ; operand patched per sprite
0008BFr 2                 .if withmirror
0008BFr 2               sprdisp_tab: .word sprFN, sprFM, sprFN, sprFM
0008BFr 2                 .else
0008BFr 2               sprdisp_tab: .word sprFN, sprFN, sprFN, sprFN
0008BFr 2                 .endif
0008BFr 2                 .if withcopy
0008BFr 2                       .word sprFC
0008BFr 2                 .else
0008BFr 2                       .word sprFN
0008BFr 2                 .endif
0008BFr 2                 .if withmirror
0008BFr 2                 .if ::MODE1
0008BFr 2               sprretMk:                           ; mask blitter, mirrored: the image column descends,
0008BFr 2                       dec mtab+1                  ; so the phase (= page & 3) does too; below phase 0
0008BFr 2                       lda mtab+1                  ; it is the previous group's phase 3
0008BFr 2                       and #3
0008BFr 2                       cmp #3
0008BFr 2                       bne @mk
0008BFr 2                       lda mtab+1
0008BFr 2                       clc
0008BFr 2                       adc #4
0008BFr 2                       sta mtab+1
0008BFr 2                       lda mptr
0008BFr 2                       sec
0008BFr 2                       sbc sp_mh
0008BFr 2                       sta mptr
0008BFr 2                       bcs @mk
0008BFr 2                       dec mptr+1
0008BFr 2               @mk:
0008BFr 2                 .endif
0008BFr 2               sprretM:                            ; next column, mirrored: source pointer - lines
0008BFr 2                       lda ptr
0008BFr 2                       sec
0008BFr 2                       sbc sp_lines
0008BFr 2                       sta ptr
0008BFr 2                       bcs sprnext
0008BFr 2                       dec ptr+1
0008BFr 2                       bra sprnext
0008BFr 2                 .endif
0008BFr 2                 .if ::MODE1
0008BFr 2               sprretPk:                           ; mask blitter: next phase is the next page; past
0008BFr 2                       inc mtab+1                  ; phase 3 it is the next group's phase 0
0008BFr 2                       lda mtab+1
0008BFr 2                       and #3
0008BFr 2                       bne @pk
0008BFr 2                       lda mtab+1
0008BFr 2                       sec
0008BFr 2                       sbc #4
0008BFr 2                       sta mtab+1
0008BFr 2                       lda mptr
0008BFr 2                       clc
0008BFr 2                       adc sp_mh
0008BFr 2                       sta mptr
0008BFr 2                       bcc @pk
0008BFr 2                       inc mptr+1
0008BFr 2               @pk:
0008BFr 2                 .endif
0008BFr 2               sprretP:                            ; next column: source pointer + lines
0008BFr 2                       lda ptr
0008BFr 2                       clc
0008BFr 2                       adc sp_lines
0008BFr 2                       sta ptr
0008BFr 2                       bcc sprnext
0008BFr 2                       inc ptr+1
0008BFr 2               sprnext:
0008BFr 2                       spnext
0008BFr 2                       dec sp_cnt
0008BFr 2                 .if ::MODELB
0008BFr 2                       bmi ds_rowdone              ; (the 6502 spellings put ds_colloop out of reach)
0008BFr 2                       jmp ds_colloop
0008BFr 2                 .else
0008BFr 2                       bpl ds_colloop
0008BFr 2                 .endif
0008BFr 2               ds_rowdone:
0008BFr 2                       lda sp_row
0008BFr 2                       cmp sp_r1
0008BFr 2                       beq ds_done
0008BFr 2                       inc sp_row
0008BFr 2                       lda sp_rp
0008BFr 2                       clc
0008BFr 2                       adc sp_rinc
0008BFr 2                       sta sp_rp
0008BFr 2                       bcc :+
0008BFr 2                       inc sp_rp+1
0008BFr 2                       clc
0008BFr 2               :
0008BFr 2                 .if ::MODE1
0008BFr 2                       lda sp_mrp
0008BFr 2                       adc #4                      ; C is clear
0008BFr 2                       sta sp_mrp
0008BFr 2                       bcc @mrnc
0008BFr 2                       inc sp_mrp+1
0008BFr 2                       clc
0008BFr 2               @mrnc:
0008BFr 2                 .endif
0008BFr 2                       lda sp_rb
0008BFr 2                       adc #<ROWBYTES
0008BFr 2                       sta sp_rb
0008BFr 2                       lda sp_rb+1
0008BFr 2                       adc #>ROWBYTES
0008BFr 2                       ringup sp_rb
0008BFr 2                       sta sp_rb+1
0008BFr 2                       jmp ds_rowloop
0008BFr 2               ds_done: rts
0008BFr 2               
0008BFr 2                 .if ::MODE1
0008BFr 2                       SPRMSK sprFN, 0
0008BFr 2                 .if withmirror
0008BFr 2                       SPRMSK sprFM, 1
0008BFr 2                 .endif
0008BFr 2               mask4:  .byte $FF, $CC, $33, $00    ; AND mask by pair (bit 1 = left opaque, bit 0 = right):
0008BFr 2                                                   ; keep what is NOT opaque -- right only opaque keeps the left dots
0008BFr 2                 .else
0008BFr 2                       SPRFULL sprFN, 0, 0
0008BFr 2                 .if withmirror
0008BFr 2                       SPRFULL sprFM, 1, 0
0008BFr 2                 .endif
0008BFr 2                 .endif
0008BFr 2               .endmacro
0008BFr 2                 .if ::MODELB
0008BFr 2                       .segment "SPR4CODE"
000000r 2                       .scope spr4
000000r 2  A6 E7 BD rr          SPRITE_LOOPS 1, ::SPR4_COPY ; (assets.inc: the packer puts the box stars in one
000004r 2  rr 8D rr rr  
000008r 2  BD rr rr 8D  
000407r 2                       .if ::SPR4_COPY             ;  bank and no mirrored image in the other)
000407r 2                       SPRFULL sprFC, 0, 1
000407r 2                       .endif
000407r 2                       .endscope
000407r 2                       .segment "SPR6CODE"
000000r 2                       .scope spr6
000000r 2  A6 E7 BD rr          SPRITE_LOOPS ::SPR6_MIRROR, 1
000004r 2  rr 8D rr rr  
000008r 2  BD rr rr 8D  
00021Cr 2  A5 rr C9 07          SPRFULL sprFC, 0, 1
000220r 2  D0 15 A5 rr  
000224r 2  F0 24 0A AA  
000290r 2                       .endscope
000290r 2                       PLACE "CODE", "TILCODE"
0008BFr 2                 .else
0008BFr 2                       SPRITE_LOOPS 1, 1
0008BFr 2                 .if ::MODE1
0008BFr 2               sp_mpg0:  .res 1                  ; MASKTAB page of the sprite's first column: >MASKTAB0 | phase
0008BFr 2               sp_mh:    .res 1                  ; pixel rows = mask bytes per column group
0008BFr 2               sp_mrp:   .res 2                  ; mask pointer for the current row's first column
0008BFr 2               sp_mbase: .res 2                  ; the sprite's mask plane
0008BFr 2               SWAPTAB:   .res 256               ; four-dot reversal for mirroring (from TABLES in MODE 2)
0008BFr 2               SECTAB:    .res 2*48              ; per buffer: 6 sections x 8 bytes
0008BFr 2               music_tab: .res 144               ; SN76489 periods for MIDI 24..95, decoded at start-up
0008BFr 2                 .endif
0008BFr 2                       SPRFULL sprFC, 0, 1         ; box stars: pre-composited on their background, no mask
0008BFr 2                 .endif
0008BFr 2               
0008BFr 2               ; (There were half-res blitters here -- one source byte to two screen lines -- for the
0008BFr 2               ; title's Cleo frames.  Every image is full-res now, so entries 0/1 of sprdisp_tab
0008BFr 2               ; alias the full blitters and the flag bit is vestigial.)
0008BFr 2               
0008BFr 2               ; ============================================================================
0008BFr 2               ; copy_partial: copy lines wfine..7 of ring row wcy into lines 0..(7-wfine) of the
0008BFr 2               ; ring row above the window (the "A" section source), for the columns drawn since.
0008BFr 2               ; ============================================================================
0008BFr 2               copy_partial:
0008BFr 2  A5 rr                lda wfine
0008C1r 2  D0 01                bne :+
0008C3r 2  60                   rts
0008C4r 2  A6 rr        :       ldx curbuf
0008C6r 2  DD rr rr             cmp PART_F,x
0008C9r 2  D0 25                bne @all
0008CBr 2  A5 rr                lda wcy
0008CDr 2  DD rr rr             cmp PART_CY,x
0008D0r 2  D0 1E                bne @all
0008D2r 2                       ; same source row and lines as last time: only the columns drawn since.  A
0008D2r 2                       ; horizontal scroll does not matter: the composed row is a ring row at a fixed
0008D2r 2                       ; offset from its source, so it moves with the ring and stays valid
0008D2r 2  BD rr rr             lda PART_HI,x
0008D5r 2  C9 50                cmp #ROWCHARS
0008D7r 2  90 02                bcc :+
0008D9r 2  A9 4F                lda #(ROWCHARS-1)
0008DBr 2  38           :       sec
0008DCr 2  FD rr rr             sbc PART_LO,x
0008DFr 2  B0 01                bcs :+
0008E1r 2  60                   rts                         ; nothing drawn in the top row
0008E2r 2  85 DF E6 DF  :       inca
0008E6r 2  A5 DF        
0008E8r 2  85 rr                sta cnt
0008EAr 2  BD rr rr             lda PART_LO,x
0008EDr 2  4C rr rr             bra @go
0008F0r 2  A5 rr        @all:   lda wfine
0008F2r 2  9D rr rr             sta PART_F,x
0008F5r 2  A5 rr                lda wcy
0008F7r 2  9D rr rr             sta PART_CY,x
0008FAr 2  A9 50                lda #ROWCHARS
0008FCr 2  85 rr                sta cnt
0008FEr 2  A9 00                lda #0
000900r 2  85 rr        @go:    sta tmp4                    ; first column to copy
000902r 2  18                   clc
000903r 2  65 rr                adc wcx
000905r 2  85 rr                sta w16
000907r 2  A5 rr                lda wcx+1
000909r 2  69 00                adc #0
00090Br 2  85 rr                sta w16+1
00090Dr 2  A9 FF                lda #$FF                    ; range is clean once copied
00090Fr 2  9D rr rr             sta PART_LO,x
000912r 2  48 A9 00 9D          stza PART_HI, x
000916r 2  rr rr 68     
000919r 2                 .if MODELB
000919r 2  A5 rr                lda barq                    ; the composed row is the ring row above the window,
00091Br 2  D0 0C                bne @nomir                  ; the last slot when the window starts at slot 0
00091Dr 2  A5 rr                lda tmp4
00091Fr 2  18                   clc
000920r 2  65 rr                adc cnt
000922r 2  AA                   tax
000923r 2  CA                   dex
000924r 2  A5 rr                lda tmp4
000926r 2  20 rr rr             jsr mirdirty
000929r 2               @nomir:
000929r 2                 .endif
000929r 2  A5 rr                lda wcy
00092Br 2  20 rr rr             jsr ringaddr                ; sp = source start (row wcy, first dirty column)
00092Er 2                       ; source: sp is the char, and the copy starts wfine lines into it.  Offsetting
00092Er 2                       ; sp by wfine (under 8, and a char is 8-aligned) keeps its page crossings on
00092Er 2                       ; the real char boundaries, so spnext's fold still lands where it should
00092Er 2  A5 rr                lda sp
000930r 2  18                   clc
000931r 2  65 rr                adc wfine
000933r 2  85 rr                sta sp
000935r 2                       ; dest: the same column of the composed row, ring char (ringS + col + 2480)
000935r 2                       ; mod 2560 -- the row above the window -- as a real address from RINGBASE
000935r 2  A5 rr                lda tmp4
000937r 2  18                   clc
000938r 2  65 rr                adc ringS
00093Ar 2  85 rr                sta ptr
00093Cr 2  A5 rr                lda ringS+1
00093Er 2  69 00                adc #0
000940r 2  85 rr                sta ptr+1
000942r 2  A5 rr                lda ptr
000944r 2  18                   clc
000945r 2  69 E0                adc #<(RINGCHARS-ROWCHARS)
000947r 2  85 rr                sta ptr
000949r 2  A5 rr                lda ptr+1
00094Br 2  69 06                adc #>(RINGCHARS-ROWCHARS)
00094Dr 2                 .if MODELB
00094Dr 2  85 rr                sta ptr+1                   ; 23 rows of chars is not whole pages: 16-bit fold
00094Fr 2  C9 07                cmp #>RINGCHARS
000951r 2  90 15                bcc @pnf
000953r 2  D0 06                bne @pfold
000955r 2  A5 rr                lda ptr
000957r 2  C9 30                cmp #<RINGCHARS
000959r 2  90 0D                bcc @pnf
00095Br 2  A5 rr        @pfold: lda ptr
00095Dr 2  38                   sec
00095Er 2  E9 30                sbc #<RINGCHARS
000960r 2  85 rr                sta ptr
000962r 2  A5 rr                lda ptr+1
000964r 2  E9 07                sbc #>RINGCHARS
000966r 2  85 rr                sta ptr+1
000968r 2               @pnf:
000968r 2                 .else
000968r 2                       cmp #>RINGCHARS             ; RINGCHARS is whole pages, so the fold is a
000968r 2                       bcc @pnf                    ; high-byte compare
000968r 2                       sbc #>RINGCHARS
000968r 2               @pnf:   sta ptr+1
000968r 2                 .endif
000968r 2  06 rr                asl ptr                     ; char -> byte address, + RINGBASE (the rols leave
00096Ar 2  26 rr                rol ptr+1                   ; C clear: the offset is under $5000)
00096Cr 2  06 rr                asl ptr
00096Er 2  26 rr                rol ptr+1
000970r 2  06 rr                asl ptr
000972r 2  26 rr                rol ptr+1
000974r 2                 .if MODELB
000974r 2  A5 rr                lda ptr                     ; the base is xx80, and which xx is the buffer's
000976r 2  69 80                adc #<RING_A
000978r 2  85 rr                sta ptr
00097Ar 2  A5 rr                lda ptr+1
00097Cr 2  65 E0                adc ringbhi
00097Er 2                 .else
00097Er 2                       lda ptr+1
00097Er 2                       adc #>RINGBASE
00097Er 2                 .endif
00097Er 2  85 rr                sta ptr+1
000980r 2                       ; Y is the dest line, 0..7-wfine, and the source line is Y + wfine through the
000980r 2                       ; offset sp: enter the unrolled copy at the pair for this wfine.  (A loop here
000980r 2                       ; is 40 bytes smaller and ~1% of a frame slower: every frame with vertical
000980r 2                       ; movement recomposes all 80 columns.)
000980r 2  A6 rr                ldx wfine
000982r 2  BD rr rr             lda @ftab-2,x
000985r 2  8D rr rr             sta @fjmp+1
000988r 2  BD rr rr             lda @ftab-1,x
00098Br 2  8D rr rr             sta @fjmp+2
00098Er 2  A6 rr                ldx cnt                     ; char counter in X: dex/beq is 3 cycles cheaper
000990r 2  4C rr rr     @fjmp:  jmp @g4
000993r 2  rr rr rr rr  @ftab:  .word @g4, @g2, @g0         ; wfine 2: six lines, 4: four, 6: two
000997r 2  rr rr        
000999r 2  A0 05        @g4:    ldy #5
00099Br 2  B1 rr                lda (sp),y
00099Dr 2  91 rr                sta (ptr),y
00099Fr 2  88                   dey
0009A0r 2  B1 rr                lda (sp),y
0009A2r 2  91 rr                sta (ptr),y
0009A4r 2  A0 03        @g2:    ldy #3
0009A6r 2  B1 rr                lda (sp),y
0009A8r 2  91 rr                sta (ptr),y
0009AAr 2  88                   dey
0009ABr 2  B1 rr                lda (sp),y
0009ADr 2  91 rr                sta (ptr),y
0009AFr 2  A0 01        @g0:    ldy #1
0009B1r 2  B1 rr                lda (sp),y
0009B3r 2  91 rr                sta (ptr),y
0009B5r 2  88                   dey
0009B6r 2  B1 rr                lda (sp),y
0009B8r 2  91 rr                sta (ptr),y
0009BAr 2                       ; next char, both with the ring fold on the page crossing: the composed row
0009BAr 2                       ; can straddle the ring end like any other row
0009BAr 2  A5 rr 18 69          spnext
0009BEr 2  08 85 rr 90  
0009C2r 2  1B A5 rr 85  
0009DEr 2  CA                   dex
0009DFr 2  F0 27                beq @done
0009E1r 2  A5 rr                lda ptr
0009E3r 2  18                   clc
0009E4r 2  69 08                adc #8
0009E6r 2  85 rr                sta ptr
0009E8r 2  90 A6                bcc @fjmp
0009EAr 2  A5 rr                lda ptr+1
0009ECr 2  85 DF E6 DF          inca
0009F0r 2  A5 DF        
0009F2r 2  C5 E1 90 0D          ringup ptr
0009F6r 2  E9 39 48 A5  
0009FAr 2  rr 38 E9 80  
000A03r 2  85 rr                sta ptr+1
000A05r 2  4C rr rr             bra @fjmp
000A08r 2  60           @done:  rts
000A09r 2               
000A09r 2               ; ============================================================================
000A09r 2               ; blank_below: the 6845 always displays the first scanline of a frame, whatever R6
000A09r 2               ; says, so the blanking section's row 0 line 0 -- the ring slot below the playfield --
000A09r 2               ; is a 241st line under the picture.  Everywhere it is the next map line; parked on
000A09r 2               ; the map's bottom row it is whatever that never-drawn slot last held.  So when the
000A09r 2               ; window sits on the bottom row, blank the slot, once per buffer per arrival.
000A09r 2               ; ============================================================================
000A09r 2                       PLACE "CODE", "TILCODE"
000A09r 2               blank_below:
000A09r 2  A5 rr                lda wfine
000A0Br 2  D0 58                bne @no
000A0Dr 2  A5 rr                lda wy
000A0Fr 2  C5 rr                cmp maxwy
000A11r 2  D0 52                bne @no
000A13r 2  A5 rr                lda wy+1
000A15r 2  C5 rr                cmp maxwy+1
000A17r 2  D0 4C                bne @no
000A19r 2  A6 rr                ldx curbuf
000A1Br 2  BD rr rr             lda BUF_BOTOK,x
000A1Er 2  D0 45                bne @no
000A20r 2  FE rr rr             inc BUF_BOTOK,x
000A23r 2  A5 rr                lda wcx                     ; the row below the playfield: map char row
000A25r 2  85 rr                sta w16                     ; wcy + VISROWS at the window's column -- rows
000A27r 2  A5 rr                lda wcx+1                   ; are not slot aligned, so this is a run of 80
000A29r 2  85 rr                sta w16+1                   ; chars that may straddle the ring end
000A2Br 2  A5 rr                lda wcy
000A2Dr 2  18                   clc
000A2Er 2  69 15                adc #VISROWS
000A30r 2  20 rr rr             jsr ringaddr                ; sp = its ring address
000A33r 2  A2 50                ldx #ROWCHARS
000A35r 2  A9 00        @char:  lda #0
000A37r 2  A0 07                ldy #7
000A39r 2  91 rr        @b:     sta (sp),y
000A3Br 2  88                   dey
000A3Cr 2  10 FB                bpl @b
000A3Er 2  A5 rr 18 69          spnext                      ; 8 on, folding at the ring end
000A42r 2  08 85 rr 90  
000A46r 2  1B A5 rr 85  
000A62r 2  CA                   dex
000A63r 2  D0 D0                bne @char
000A65r 2  60           @no:    rts
000A66r 2               
000A66r 2               ; ============================================================================
000A66r 2               ; calc_ring: ringS = ((wcy & 31) * 80 + wcx) mod 2560 ; barq = ringS / 80
000A66r 2               ; ============================================================================
000A66r 2               ; copy_bar: if this buffer's bar rows are stale, write bar image into ring slots q-3, q-2
000A66r 2               ; The bar has a fixed home outside the ring, so it stays put however the window
000A66r 2               ; scrolls and is only written when its contents change.  It used to live in the two
000A66r 2               ; ring rows above the window, which move every frame the view scrolls vertically;
000A66r 2               ; re-copying 1280 bytes for that cost 13,310 cycles of an 80,000 cycle frame.
000A66r 2               ; bar_bg: blit the static bar template (icons, labels, blank digit slots) from bank 4
000A66r 2               ; into the current back buffer's fixed bar rows.  Source art, not a maintained buffer.
000A66r 2                       PLACE "CODE", "LGCCODE"     ; Model B: the bar is loaded into place by the loader
000000r 2               bar_bg:                             ; and never redrawn: only the digit cache is reset
000000r 2  A2 08                ldx #8                      ; level).  The template buries the digits, so the
000002r 2  A9 FF                lda #$FF                    ; cached "already drawn" values are no longer true.
000004r 2  9D rr rr     @bci:   sta BARCACHE,x              ; (One bar, one cache: this used to index it by
000007r 2  CA                   dex                         ; curbuf and, at a level start with curbuf = 1,
000008r 2  10 FA                bpl @bci                    ; reset the wrong 16 bytes and left the digits stale)
00000Ar 2                 .if MODELB
00000Ar 2  60                   rts
00000Br 2                 .else
00000Br 2                       lda #HUD_BANK               ; The bar is black with a few icon spans, so
00000Br 2                                                   ; fill black and lay the spans (BARBUF is now the span
00000Br 2                       sta ROMSEL_CPY              ; list: offset16, len, bytes... ending $FFFF).
00000Br 2                       sta ROMSEL
00000Br 2                 .if MODE1
00000Br 2                       lda #0                      ; MODE 1 black is plain 0: no opaque-black tag
00000Br 2                 .else
00000Br 2                       lda #$C0                    ; BARADDR is a constant, so the fill needs no pointer:
00000Br 2                 .endif
00000Br 2                       ldx #0                      ; five abs,x stores cover the 5 pages in one pass
00000Br 2               @bf:    sta BARADDR+$000,x
00000Br 2                       sta BARADDR+$100,x
00000Br 2                       sta BARADDR+$200,x
00000Br 2                       sta BARADDR+$300,x
00000Br 2                       sta BARADDR+$400,x
00000Br 2                       inx
00000Br 2                       bne @bf
00000Br 2                       lda #<BARBUF
00000Br 2                       sta w16
00000Br 2                       lda #>BARBUF
00000Br 2                       sta w16+1
00000Br 2               @bs:    ldy #1
00000Br 2                       lda (w16),y                 ; offset high ($FF = end)
00000Br 2                       cmp #$FF
00000Br 2                       beq @bsdone
00000Br 2                       tax                         ; X is free: the @bf counter ran down to 0
00000Br 2                       ldaz w16                    ; offset low, (zp): no dey needed
00000Br 2                       clc
00000Br 2                       adc #<BARADDR
00000Br 2                       sta w16b
00000Br 2                       txa
00000Br 2                       adc #>BARADDR
00000Br 2                       sta w16b+1
00000Br 2                       ldy #2
00000Br 2                       lda (w16),y
00000Br 2                       sta tmp2                    ; len
00000Br 2                       lda w16                     ; step past the 3-byte header
00000Br 2                       clc
00000Br 2                       adc #3
00000Br 2                       sta w16
00000Br 2                       bcc :+
00000Br 2                       inc w16+1
00000Br 2               :       ldy #0
00000Br 2               @bc:    lda (w16),y
00000Br 2                       sta (w16b),y
00000Br 2                       iny
00000Br 2                       cpy tmp2
00000Br 2                       bne @bc
00000Br 2                       tya                         ; step past the data
00000Br 2                       clc
00000Br 2                       adc w16
00000Br 2                       sta w16
00000Br 2                       bcc @bs
00000Br 2                       inc w16+1
00000Br 2                       bra @bs
00000Br 2               @bsdone: rts
00000Br 2                 .endif
00000Br 2               
00000Br 2               ; ============================================================================
00000Br 2                 .if .not MODELB                   ; (Model B: its rupture chain is modelb/src/display.s)
00000Br 2                       .segment "LOGIC"           ; main RAM is full on a Master: this touches
00000Br 2                                                   ; nothing but main RAM and the CRTC, so it can
00000Br 2                                                   ; live in the bank the game logic already uses
00000Br 2               ; build_sections: fill SECTAB for the current buffer from ringS and wfine.
00000Br 2               ; entry i: R12n, R13n, R4, R9, R6, R7, T1lo, T1hi (T1 = duration of section i+1)
00000Br 2               ;
00000Br 2               ; The bar and the partial row have fixed homes, so only the playfield walks the ring.
00000Br 2               ; A row starting past RINGCHARS-80 straddles the ring end; it is read from the mirror
00000Br 2               ; sitting immediately below the ring base, which makes its address c - RINGCHARS in
00000Br 2               ; ring-offset terms, and every row after it follows on contiguously.  That costs one
00000Br 2               ; extra section whenever the window straddles.
00000Br 2               ; ============================================================================
00000Br 2               LINE = 64
00000Br 2               BARLEAD = 10                        ; us the bar's T1 fires early, beyond the lead every
00000Br 2                                                   ; step has, so ACCCON D can be switched in the
00000Br 2                                                   ; blanking of the bar's last line
00000Br 2               BARCRTC  = BARADDR / 8
00000Br 2                       .code
00000Br 2                       .segment "LOGIC"            ; back to the bank
00000Br 2               build_sections:
00000Br 2                       lda curbuf
00000Br 2                       asl
00000Br 2                       tax
00000Br 2                       lda #>BARCRTC               ; section 0 is the bar: fixed address, fixed length
00000Br 2                       sta BUF_SEC0,x
00000Br 2                       lda #<BARCRTC
00000Br 2                       sta BUF_SEC0+1,x
00000Br 2                       lda #<(BARROWS*8*LINE-2-BARLEAD)   ; the bar's step fires early: see the ISR
00000Br 2                       sta BUF_SEC0T1,x
00000Br 2                       lda #>(BARROWS*8*LINE-2-BARLEAD)
00000Br 2                       sta BUF_SEC0T1+1,x
00000Br 2                       ldx curbuf
00000Br 2                       beq :+
00000Br 2                       ldx #48
00000Br 2               :       lda #1
00000Br 2                       sta SECTAB+2,x
00000Br 2                       lda #7
00000Br 2                       sta SECTAB+3,x
00000Br 2                       lda #2
00000Br 2                       sta SECTAB+4,x
00000Br 2                       lda #30
00000Br 2                       sta SECTAB+5,x
00000Br 2                       lda wfine
00000Br 2                       beq @coarse
00000Br 2                       ; ---- f > 0 : T -> A (the partial row) -> P.. -> P2 -> Q
00000Br 2                       eor #7                      ; wfine is still in A from the test above
00000Br 2                       inca                        ; 8-f lines of it
00000Br 2                       jsr @dur
00000Br 2                       sta SECTAB+6,x
00000Br 2                       lda tmp3
00000Br 2                       sta SECTAB+7,x
00000Br 2                       lda ringS                   ; section A shows the composed row: the ring row
00000Br 2                       sec                         ; above the window, ringS - 80 mod RINGCHARS
00000Br 2                       sbc #ROWCHARS
00000Br 2                       sta w16
00000Br 2                       lda ringS+1
00000Br 2                       sbc #0
00000Br 2                       bpl :+
00000Br 2                       adc #>RINGCHARS             ; went below 0: + RINGCHARS (whole pages; C clear)
00000Br 2               :       sta w16+1
00000Br 2                       jsr @addr
00000Br 2                       txa
00000Br 2                       clc
00000Br 2                       adc #8
00000Br 2                       tax                         ; A's entry
00000Br 2                       stz SECTAB+2,x
00000Br 2                       lda wfine
00000Br 2                       eor #7                      ; 7 - wfine, wfine in 0..7
00000Br 2                       sta SECTAB+3,x
00000Br 2                       lda #2
00000Br 2                       sta SECTAB+4,x
00000Br 2                       lda #30
00000Br 2                       sta SECTAB+5,x
00000Br 2                       lda ringS                   ; the run starts one row into the window
00000Br 2                       clc
00000Br 2                       adc #ROWCHARS
00000Br 2                       sta w16
00000Br 2                       lda ringS+1
00000Br 2                       adc #0
00000Br 2                       sta w16+1
00000Br 2                       jsr @wrap
00000Br 2                       lda #VISROWS-1
00000Br 2                       sta tmp4                    ; rows in the run
00000Br 2                       lda barq
00000Br 2                       inca
00000Br 2                       cmp #RINGROWS
00000Br 2                       bcc :+
00000Br 2                       lda #0
00000Br 2               :       sta tmp3
00000Br 2                       bra @run
00000Br 2               @coarse:                            ; ---- f = 0 : T -> P.. -> Q
00000Br 2                       lda ringS
00000Br 2                       sta w16
00000Br 2                       lda ringS+1
00000Br 2                       sta w16+1
00000Br 2                       lda #VISROWS
00000Br 2                       sta tmp4
00000Br 2                       lda barq                    ; the run starts on the window's ring row
00000Br 2                       sta tmp3
00000Br 2               @run:   ; w16 = the run's ring offset, tmp4 = its rows, X = the entry of the section
00000Br 2                       ; before it.  Entry i carries section i+1's address and duration, and section
00000Br 2                       ; i's own R4/R9/R6/R7, so each section is written across two entries.
00000Br 2                       ; The run is never split any more: a row that straddles the ring end is
00000Br 2                       ; folded by the CRTC, so the playfield is one section however the window sits.
00000Br 2                       lda tmp4
00000Br 2                       sta tmp2
00000Br 2                       jsr @emit
00000Br 2               @past:  lda tmp4
00000Br 2                       jsr @advance                ; now the row below the playfield
00000Br 2                       lda wfine
00000Br 2                       beq @setq
00000Br 2                       ; --- P2 : the top f lines of that row
00000Br 2                       jsr @addr
00000Br 2                       lda wfine
00000Br 2                       jsr @dur
00000Br 2                       sta SECTAB+6,x
00000Br 2                       lda tmp3
00000Br 2                       sta SECTAB+7,x
00000Br 2                       txa
00000Br 2                       clc
00000Br 2                       adc #8
00000Br 2                       tax
00000Br 2                       stza SECTAB+2,x             ; stz abs,x
00000Br 2                       lda wfine
00000Br 2                       deca
00000Br 2                       sta SECTAB+3,x
00000Br 2                       lda #VISROWS
00000Br 2                       sta SECTAB+4,x
00000Br 2                       lda #30
00000Br 2                       sta SECTAB+5,x
00000Br 2                       lda SECTAB-8,x              ; w16 has not moved since the P2 @addr above, so the
00000Br 2                       sta SECTAB,x                ; address it left in the previous entry is this one's
00000Br 2                       lda SECTAB-8+1,x
00000Br 2                       sta SECTAB+1,x
00000Br 2                       bra @sq2
00000Br 2               @setq:  jsr @addr                   ; Q starts on the row below the playfield
00000Br 2               @sq2:   lda #<(40*LINE-2)
00000Br 2                       sta SECTAB+6,x
00000Br 2                       lda #>(40*LINE-2)
00000Br 2                       sta SECTAB+7,x
00000Br 2                       txa
00000Br 2                       clc
00000Br 2                       adc #8
00000Br 2                       tax
00000Br 2                       lda #>BARCRTC               ; and hands the chain back to the bar
00000Br 2                       sta SECTAB,x
00000Br 2                       lda #<BARCRTC
00000Br 2                       sta SECTAB+1,x
00000Br 2                       lda #QROWS-1
00000Br 2                       sta SECTAB+2,x
00000Br 2                       lda #7
00000Br 2                       sta SECTAB+3,x
00000Br 2                       stza SECTAB+4, x
00000Br 2                       lda #QVSYNC
00000Br 2                       sta SECTAB+5, x
00000Br 2                       lda #<(40*LINE-2)
00000Br 2                       sta SECTAB+6, x
00000Br 2                       lda #>(40*LINE-2)
00000Br 2                       sta SECTAB+7, x
00000Br 2                       ; the bar's step fired BARLEAD early, so the section after the bar -- whose
00000Br 2                       ; duration entry 0 carries -- runs BARLEAD longer to end where it should
00000Br 2                       ldx curbuf
00000Br 2                       beq @e0
00000Br 2                       ldx #48
00000Br 2               @e0:    lda SECTAB+6,x
00000Br 2                       clc
00000Br 2                       adc #BARLEAD
00000Br 2                       sta SECTAB+6,x
00000Br 2                       bcc @e1
00000Br 2                       inc SECTAB+7,x
00000Br 2               @e1:    rts
00000Br 2               ; --- emit a run of tmp2 rows starting at w16 (a ring offset), following entry X
00000Br 2               @emit:  jsr @addr
00000Br 2                       lda tmp2
00000Br 2                       jsr @lines
00000Br 2                       sta SECTAB+6,x
00000Br 2                       lda tmp3
00000Br 2                       sta SECTAB+7,x
00000Br 2                       txa
00000Br 2                       clc
00000Br 2                       adc #8
00000Br 2                       tax
00000Br 2                       lda tmp2
00000Br 2                       deca
00000Br 2                       sta SECTAB+2,x
00000Br 2                       lda #7
00000Br 2                       sta SECTAB+3,x
00000Br 2                       lda #30
00000Br 2                       sta SECTAB+4,x
00000Br 2                       sta SECTAB+5,x
00000Br 2                       rts
00000Br 2               ; --- SECTAB+0/1,x = the CRTC address for the row at ring offset w16.  Ring offsets are
00000Br 2               ; 0..RINGCHARS-1 and CRTCBASE is $600, so the sum is always under $1000 and MA12 is
00000Br 2               ; clear: a section's START address never needs folding.  The fold happens mid-scan, in
00000Br 2               ; hardware, which is the whole reason the ring begins at $3000.
00000Br 2               @addr:  lda w16
00000Br 2                       ldy w16+1
00000Br 2                       clc
00000Br 2                       adc #<CRTCBASE
00000Br 2                       sta SECTAB+1,x
00000Br 2                       tya
00000Br 2                       adc #>CRTCBASE
00000Br 2                       sta SECTAB,x
00000Br 2                       rts
00000Br 2                       ; --- A = rows -> A/tmp3 = that many rows of lines, as a T1 count
00000Br 2               @lines: asl
00000Br 2                       asl
00000Br 2                       asl
00000Br 2                       jmp @dur
00000Br 2                       ; --- A = rows: advance w16 by that many rows, folding into 0..RINGCHARS
00000Br 2               @advance:
00000Br 2                       tay
00000Br 2                       clc
00000Br 2                       lda w16
00000Br 2                       adc mulrowlo,y
00000Br 2                       sta w16
00000Br 2                       lda w16+1
00000Br 2                       adc mulrowhi,y
00000Br 2                       sta w16+1
00000Br 2                       ; fall through
00000Br 2               @wrap:  lda w16+1
00000Br 2                       cmp #>RINGCHARS
00000Br 2                       bcc :++
00000Br 2                       bne :+
00000Br 2                       lda w16
00000Br 2                       cmp #<RINGCHARS
00000Br 2                       bcc :++
00000Br 2               :       lda w16
00000Br 2                       sec
00000Br 2                       sbc #<RINGCHARS
00000Br 2                       sta w16
00000Br 2                       lda w16+1
00000Br 2                       sbc #>RINGCHARS
00000Br 2                       sta w16+1
00000Br 2               :       rts
00000Br 2               ; A = lines -> A/tmp3 = lines*64-2
00000Br 2               @dur:   sta tmp3                    ; n*64 == (n*256)>>2: start from hi=n, lo=0 and
00000Br 2                       lda #0                      ; shift right twice instead of left six times
00000Br 2                       lsr tmp3
00000Br 2                       ror
00000Br 2                       lsr tmp3
00000Br 2                       ror
00000Br 2                       sbc #1                      ; C = 0 out of the ror pair, so this is A - 2
00000Br 2                       bcs :+
00000Br 2                       dec tmp3
00000Br 2               :       rts
00000Br 2               ; w16 = (w16 - 80) with ring wrap (w16 holds CRTC address S+$600 in $600..$FFF)
00000Br 2               @subrow: lda w16
00000Br 2                       sec
00000Br 2                       sbc #ROWCHARS
00000Br 2                       sta w16
00000Br 2                       bcs :+
00000Br 2                       dec w16+1
00000Br 2               :       lda w16+1
00000Br 2                       cmp #6
00000Br 2                       bcs :+                      ; not taken: C = 0 for the adc
00000Br 2                       adc #$0A
00000Br 2                       sta w16+1
00000Br 2               :       rts
00000Br 2               @addrow: lda w16
00000Br 2                       clc
00000Br 2                       adc #ROWCHARS
00000Br 2                       sta w16
00000Br 2                       bcc :+
00000Br 2                       inc w16+1
00000Br 2               :       lda w16+1
00000Br 2                       cmp #$10
00000Br 2                       bcc :+                      ; not taken: C = 1 for the sbc
00000Br 2                       sbc #$0A
00000Br 2                       sta w16+1
00000Br 2               :       rts
00000Br 2                 .endif
00000Br 2               
00000Br 2                       PLACE "CODE", "TILCODE"
000A66r 2               
000A66r 2               BARROWS = 2                        ; the status bar
000A66r 2               QROWS  = 39 - VISROWS - BARROWS    ; blank rows after the display: 312 lines in all
000A66r 2                 .if MODELB
000A66r 2               QVSYNC = 8                         ; vsync at Q row 8 of 16: the picture starts 64 lines after
000A66r 2                                                  ; it, 4 lines below where a MODE 1 screen sits
000A66r 2                 .else
000A66r 2               QVSYNC = 3                         ; vsync at Q row 3 of 7: four rows (32 lines) between the
000A66r 2                                                  ; vsync and the bar, which is where the bar is drawn, and
000A66r 2                                                  ; three below.  Measured against the Master MOS's own
000A66r 2                                                  ; MODE 2 (R7 = 35): the picture sits exactly where it does.
000A66r 2                 .endif
000A66r 2               
000A66r 2               ; ============================================================================
000A66r 2               ; Frame control
000A66r 2               ; ============================================================================
000A66r 2               ; select CPU access to the current back buffer (ACCCON X bit)
000A66r 2               select_backbuf:
000A66r 2                 .if MODELB
000A66r 2  A6 rr                ldx curbuf                  ; the buffer's ring: its base and end, the two
000A68r 2  BD rr rr             lda @bhi,x                  ; derived constants the blitters' wrap tests use,
000A6Br 2  85 E0                sta ringbhi                 ; and the row table from its base
000A6Dr 2  BD rr rr             lda @ehi,x
000A70r 2  85 E1                sta ringehi
000A72r 2  38                   sec
000A73r 2  E9 03                sbc #3
000A75r 2  85 E2                sta ringe3
000A77r 2  A9 00                lda #0
000A79r 2  38                   sec
000A7Ar 2  E5 E1                sbc ringehi
000A7Cr 2  85 E3                sta ringneg
000A7Er 2  20 rr rr             jsr build_ring
000A81r 2  4C rr rr             jmp @recs
000A84r 2  0A 46        @bhi:   .byte >RING_A, >RING_B
000A86r 2  44 80        @ehi:   .byte >RINGEND_A, >RINGEND_B
000A88r 2               @recs:
000A88r 2                 .else
000A88r 2                       php                         ; the ISR writes ACCCON's D bit; this read-modify-
000A88r 2                       sei                         ; write of the X bit must not straddle one
000A88r 2                       lda ACCCON
000A88r 2                       and #$FB
000A88r 2                       ldx curbuf
000A88r 2                       beq :+
000A88r 2                       ora #$04
000A88r 2               :       sta ACCCON
000A88r 2                       plp
000A88r 2                 .endif
000A88r 2  A5 rr                lda curbuf
000A8Ar 2  F0 09                beq :+
000A8Cr 2  A9 rr                lda #<(SPRREC+MAXREC*10)
000A8Er 2  85 rr                sta recp
000A90r 2  A9 rr                lda #>(SPRREC+MAXREC*10)
000A92r 2  85 rr                sta recp+1
000A94r 2  60                   rts
000A95r 2  A9 rr        :       lda #<SPRREC
000A97r 2  85 rr                sta recp
000A99r 2  A9 rr                lda #>SPRREC
000A9Br 2  85 rr                sta recp+1
000A9Dr 2  60                   rts
000A9Er 2               
000A9Er 2               ; render everything queued for the current back buffer and request flip
000A9Er 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the game loop; the ring work
00000Br 2               render_frame:                       ; is render_core in bank 5
00000Br 2  20 rr rr             jsr wait_flip               ; the previous frame's flip must land before we
00000Er 2                 .if .not MODELB
00000Er 2                       jsr select_backbuf          ; draw into the buffer it is leaving
00000Er 2                 .endif
00000Er 2                       ; ---- the bar first.  It is single buffered and drawn where it is displayed,
00000Er 2                       ; so it has to be finished before the CRTC reaches it: T starts 40 lines after
00000Er 2                       ; the vsync wait_flip just returned from, which is 2560 cycles.  A full
00000Er 2                       ; template blit does not fit and does not need to -- it runs twice a level.
00000Er 2  A5 A5                lda BARBG
000010r 2  F0 07                beq :+
000012r 2  20 rr rr             jsr bar_bg
000015r 2  A9 00 85 A5          stz BARBG
000019r 2  A5 A4        :       lda BARDIRTY
00001Br 2  F0 07                beq :+
00001Dr 2  20 rr rr             jsr t_redraw_hud
000020r 2  A9 00 85 A4          stz BARDIRTY
000024r 2               :
000024r 2                       ; derive char window
000024r 2  A5 rr                lda wx
000026r 2  85 rr                sta wcx
000028r 2  A5 rr                lda wx+1
00002Ar 2  4A                   lsr
00002Br 2  85 rr                sta wcx+1
00002Dr 2  66 rr                ror wcx
00002Fr 2  A5 rr                lda wy
000031r 2  29 03                and #3
000033r 2  0A                   asl
000034r 2  85 rr                sta wfine
000036r 2  A5 rr                lda wy+1                    ; wcy = wy >> 2, a full 16-bit shift: shifting the
000038r 2  4A                   lsr                         ; high byte once only was right below wy = 512 and
000039r 2  85 rr                sta wcy                     ; lost 128 rows above it, which put the tall maps
00003Br 2  A5 rr                lda wy                      ; 512 px out of place once the player got that deep
00003Dr 2  6A                   ror
00003Er 2  46 rr                lsr wcy
000040r 2  6A                   ror
000041r 2  85 rr                sta wcy
000043r 2                 .if MODELB
000043r 2  A2 00 20 rr          farjsr F_RENDCORE
000047r 2  rr           
000048r 2                 .else
000048r 2                       jsr calc_ring
000048r 2                       jsr match_sprites
000048r 2                       jsr erase_old
000048r 2                       jsr scroll_validate
000048r 2                       jsr draw_dirty
000048r 2                       jsr draw_sprites
000048r 2                       jsr copy_partial
000048r 2                       jsr blank_below
000048r 2                 .endif
000048r 2  48 A9 00 85          stza NSPR
00004Cr 2  A3 68        
00004Er 2                 .if MODELB
00004Er 2  20 rr rr             jsr build_sections
000051r 2                 .else
000051r 2                       jsr t_build_sections
000051r 2                 .endif
000051r 2                       ; hand over to ISR
000051r 2  A5 rr                lda curbuf
000053r 2                 .if .not MODELB
000053r 2                       sta NEXTBUF
000053r 2                 .endif
000053r 2  F0 02                beq :+
000055r 2  A9 30                lda #48
000057r 2  8D rr rr     :       sta NEXTSECT
00005Ar 2  A9 01                lda #1
00005Cr 2  85 rr                sta flipreq
00005Er 2               render_done:                        ; (label for the phase timer harness)
00005Er 2                       ; no wait here: the next logic step runs while the flip is pending and
00005Er 2                       ; the next render_frame waits for it before touching the buffer
00005Er 2  A5 rr                lda curbuf
000060r 2  49 01                eor #1
000062r 2  85 rr                sta curbuf
000064r 2  60                   rts
000065r 2               
000065r 2               ; spin until any pending flip has been taken by the vsync ISR
000065r 2               wait_flip:
000065r 2  A5 rr                lda flipreq
000067r 2  D0 FC                bne wait_flip
000069r 2  60                   rts
00006Ar 2                 .if MODELB
00006Ar 2                       .segment "TILCODE"          ; the ring work, in the tile blitter's bank
000A9Er 2               render_core:
000A9Er 2  20 rr rr             jsr select_backbuf          ; draw into the buffer the flip is leaving
000AA1r 2  20 rr rr             jsr calc_ring
000AA4r 2  20 rr rr             jsr match_sprites
000AA7r 2  20 rr rr             jsr erase_old
000AAAr 2  20 rr rr             jsr scroll_validate
000AADr 2  20 rr rr             jsr draw_dirty
000AB0r 2  20 rr rr             jsr draw_sprites
000AB3r 2  20 rr rr             jsr copy_partial
000AB6r 2  20 rr rr             jsr blank_below
000AB9r 2  4C rr rr             jmp mirror_copy             ; the straddling row's copy (display.s)
000ABCr 2                 .endif
000ABCr 2               
000ABCr 2               
000ABCr 2                       PLACE "LOW", "TILCODE"     ; render-time helpers in the NMI page ($0D03..),
000ABCr 2                                                  ; copied there at init
000ABCr 2               ; ============================================================================
000ABCr 2               drawrect_clip:
000ABCr 2                       ; rows
000ABCr 2  A5 rr                lda rc_y
000ABEr 2  38                   sec
000ABFr 2  E5 rr                sbc wcy                     ; rel row start (may be negative), kept in A
000AC1r 2  10 0F                bpl :+
000AC3r 2                       ; start above window: shrink
000AC3r 2  18                   clc
000AC4r 2  65 rr                adc rc_h
000AC6r 2  F0 69                beq @none
000AC8r 2  30 67                bmi @none
000ACAr 2  85 rr                sta rc_h
000ACCr 2  A5 rr                lda wcy
000ACEr 2  85 rr                sta rc_y
000AD0r 2  A9 00                lda #0                      ; clipped to the top: rel is now 0
000AD2r 2  85 rr        :       sta tmp                     ; stored here, so the common path never reloads it
000AD4r 2  18                   clc
000AD5r 2  65 rr                adc rc_h                    ; rel end+1
000AD7r 2  C9 17                cmp #BUFROWS+1
000AD9r 2  90 0A                bcc :+
000ADBr 2  A9 16                lda #BUFROWS                ; bcc not taken: C = 1 already, for the sbc
000ADDr 2  E5 rr                sbc tmp
000ADFr 2  F0 50                beq @none
000AE1r 2  30 4E                bmi @none
000AE3r 2  85 rr                sta rc_h
000AE5r 2               :       ; cols: rel = rc_x - wcx (16 bit signed)
000AE5r 2  A5 rr                lda rc_x
000AE7r 2  38                   sec
000AE8r 2  E5 rr                sbc wcx
000AEAr 2  85 rr                sta w16
000AECr 2  A5 rr                lda rc_x+1
000AEEr 2  E5 rr                sbc wcx+1
000AF0r 2  85 rr                sta w16+1
000AF2r 2  10 24                bpl @right
000AF4r 2                       ; rel < 0: the visible width is w + rel, and rel is already two's complement,
000AF4r 2                       ; so add rather than negate-and-subtract.  Only a result whose high byte comes
000AF4r 2                       ; out exactly 0 survives: anything else is the whole rect off the left edge.
000AF4r 2  A5 rr                lda w16
000AF6r 2  18                   clc
000AF7r 2  65 rr                adc rc_w
000AF9r 2  85 rr                sta rc_w
000AFBr 2  F0 34                beq @none                   ; Z is still the low sum: sta sets no flags
000AFDr 2  A5 rr                lda w16+1
000AFFr 2  69 00                adc #0                      ; branches do not touch C
000B01r 2  D0 2E                bne @none
000B03r 2  A5 rr                lda wcx
000B05r 2  85 rr                sta rc_x
000B07r 2  A5 rr                lda wcx+1
000B09r 2  85 rr                sta rc_x+1
000B0Br 2  A5 rr                lda rc_w                    ; rel is now exactly 0, so the right clip is just
000B0Dr 2  C9 51                cmp #ROWCHARS+1             ; min(rc_w, ROWCHARS): no need to store it and read
000B0Fr 2  90 04                bcc :+                      ; it back through the general test below
000B11r 2  A9 50                lda #ROWCHARS
000B13r 2  85 rr                sta rc_w
000B15r 2  4C rr rr     :       jmp drawrect
000B18r 2  A5 rr        @right: lda w16+1
000B1Ar 2  D0 15                bne @none                   ; rel >= 256 -> off right
000B1Cr 2  A5 rr                lda w16
000B1Er 2  C9 50                cmp #ROWCHARS
000B20r 2  B0 0F                bcs @none                   ; not taken: C = 0 for the adc
000B22r 2  65 rr                adc rc_w
000B24r 2  C9 51                cmp #ROWCHARS+1
000B26r 2  90 06                bcc :+                      ; not taken: C = 1 for the sbc
000B28r 2  A9 50                lda #ROWCHARS
000B2Ar 2  E5 rr                sbc w16
000B2Cr 2  85 rr                sta rc_w
000B2Er 2  4C rr rr     :       jmp drawrect
000B31r 2  60           @none:  rts
000B32r 2               ; ============================================================================
000B32r 2               ; drawrect_clip: like drawrect but clips the rect to the current window
000B32r 2               ; (rows wcy..wcy+BUFROWS-1, cols wcx..wcx+ROWCHARS-1).
000B32r 2               calc_ring:
000B32r 2  A5 rr                lda wcy
000B34r 2  AA BD 80 80          ringmod
000B38r 2  AA                   tax
000B39r 2  BD 50 80             lda mulrowlo,x
000B3Cr 2  18                   clc
000B3Dr 2  65 rr                adc wcx
000B3Fr 2  85 rr                sta ringS
000B41r 2  BD 68 80             lda mulrowhi,x
000B44r 2  65 rr                adc wcx+1
000B46r 2  85 rr                sta ringS+1
000B48r 2  C9 07                cmp #>RINGCHARS
000B4Ar 2  90 15                bcc :+
000B4Cr 2  D0 06                bne @sub
000B4Er 2  A5 rr                lda ringS
000B50r 2  C9 30                cmp #<RINGCHARS
000B52r 2  90 0D                bcc :+
000B54r 2  A5 rr        @sub:   lda ringS
000B56r 2  38                   sec
000B57r 2  E9 30                sbc #<RINGCHARS
000B59r 2  85 rr                sta ringS
000B5Br 2  A5 rr                lda ringS+1
000B5Dr 2  E9 07                sbc #>RINGCHARS
000B5Fr 2  85 rr                sta ringS+1
000B61r 2               :       ; q = S / 80
000B61r 2  A5 rr                lda ringS                   ; running value: low in A, high in Y
000B63r 2  A4 rr                ldy ringS+1
000B65r 2  A2 FF                ldx #$FF                    ; quotient, pre-decremented
000B67r 2  38                   sec                         ; the loop's own bcs guarantees C=1 all the way
000B68r 2  E8           @div:   inx                         ; round, so the only entries needing a sec are
000B69r 2  E9 50                sbc #ROWCHARS               ; this one and the one after a borrow
000B6Br 2  B0 FB                bcs @div                    ; no borrow: high byte unchanged, value still >= 0
000B6Dr 2  38                   sec                         ; dey does not touch the carry
000B6Er 2  88                   dey
000B6Fr 2  10 F7                bpl @div                    ; borrow absorbed by the high byte
000B71r 2  86 rr        @dd:    stx barq                    ; high byte went negative: X is the quotient
000B73r 2                 .if MODELB
000B73r 2  18                   clc                         ; the remainder, A + 80, is where the window starts
000B74r 2  69 50                adc #ROWCHARS               ; in its slot: the first char the mirror is read for
000B76r 2  85 E5                sta wcxm
000B78r 2  A9 16                lda #RINGROWS-1             ; the window row that lives in the last slot, and
000B7Ar 2  38                   sec                         ; the map row it shows: the row the mirror follows
000B7Br 2  E5 rr                sbc barq
000B7Dr 2  85 E6                sta rstar
000B7Fr 2  18                   clc
000B80r 2  65 rr                adc wcy
000B82r 2  85 E4                sta mrow
000B84r 2                 .endif
000B84r 2  60                   rts
000B85r 2               
000B85r 2                 .if .not MODELB                   ; (Model B: modelb/src/init.s -- its tables are static)
000B85r 2                       .segment "LOW2"            ; MOS vector/VDU pages ($0206..$03FF), copied there after MODE 2:
000B85r 2                                                  ; init-only table builders and the dirty-tile routines
000B85r 2               
000B85r 2               ; ============================================================================
000B85r 2               ; table init
000B85r 2               ; ============================================================================
000B85r 2                       .segment "LOGIC"            ; cold, and main RAM under the screen is full
000B85r 2               init_tables:
000B85r 2                 .if MODE1
000B85r 2                       ldx #0
000B85r 2               @mt:    txa                         ; MASKTABk[x] = mask4[(x >> (6 - 2k)) & 3]
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       tay
000B85r 2                       lda mask4,y
000B85r 2                       sta MASKTAB0,x
000B85r 2                       txa
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       and #3
000B85r 2                       tay
000B85r 2                       lda mask4,y
000B85r 2                       sta MASKTAB1,x
000B85r 2                       txa
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       and #3
000B85r 2                       tay
000B85r 2                       lda mask4,y
000B85r 2                       sta MASKTAB2,x
000B85r 2                       txa
000B85r 2                       and #3
000B85r 2                       tay
000B85r 2                       lda mask4,y
000B85r 2                       sta MASKTAB3,x
000B85r 2                       inx
000B85r 2                       bne @mt
000B85r 2                 .else
000B85r 2                       jsr init_ident
000B85r 2                 .endif
000B85r 2                       ldx #0
000B85r 2               @t:     txa
000B85r 2                 .if .not MODE1
000B85r 2                       and #$AA
000B85r 2                       beq :+
000B85r 2                       lda #0
000B85r 2                       bra :++
000B85r 2               :       lda #$AA
000B85r 2               :       sta tmp
000B85r 2                       txa
000B85r 2                       and #$55
000B85r 2                       beq :+
000B85r 2                       lda #0
000B85r 2                       bra :++
000B85r 2               :       lda #$55
000B85r 2               :       ora tmp
000B85r 2                       sta MASKTAB,x
000B85r 2                 .endif
000B85r 2                 .if MODE1
000B85r 2                       ; MODE 1: a byte is four dots, bit 7-i / bit 3-i for dot i; mirroring reverses
000B85r 2                       ; them: 7<->4, 6<->5, 3<->0, 2<->1
000B85r 2                       txa
000B85r 2                       and #$88
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       lsr
000B85r 2                       sta tmp
000B85r 2                       txa
000B85r 2                       and #$44
000B85r 2                       lsr
000B85r 2                       ora tmp
000B85r 2                       sta tmp
000B85r 2                       txa
000B85r 2                       and #$22
000B85r 2                       asl
000B85r 2                       ora tmp
000B85r 2                       sta tmp
000B85r 2                       txa
000B85r 2                       and #$11
000B85r 2                       asl
000B85r 2                       asl
000B85r 2                       asl
000B85r 2                       ora tmp
000B85r 2                 .else
000B85r 2                       txa
000B85r 2                       and #$AA
000B85r 2                       lsr
000B85r 2                       sta tmp
000B85r 2                       txa
000B85r 2                       and #$55
000B85r 2                       asl
000B85r 2                       ora tmp
000B85r 2                 .endif
000B85r 2                       sta SWAPTAB,x
000B85r 2                       inx
000B85r 2                       bne @t
000B85r 2                 .if .not MODE1
000B85r 2                       ; sprite encoding (convert.py encode_sprite): bit 7 = both pixels opaque and never
000B85r 2                       ; reaches the tables; left-black-only is code $44 (its $80 slot is taken)
000B85r 2                       lda #$55
000B85r 2                       sta MASKTAB+$44             ; keep the right screen pixel
000B85r 2                       stz IDENT+$44               ; left pixel black
000B85r 2                       lda #$44
000B85r 2                       sta SWAPTAB+$40             ; right-black-only <-> left-black-only
000B85r 2                       lda #$40
000B85r 2                       sta SWAPTAB+$44
000B85r 2                       lda #$FF                    ; $41 marks eight transparent bytes; if it reaches
000B85r 2                       sta MASKTAB+$41             ; the tables (a clipped cell, or as a line 1..7)
000B85r 2                       stza IDENT+$41               ; it must leave the screen byte alone.  $82 is its
000B85r 2                       sta MASKTAB+$82             ; mirror image, and unreachable otherwise
000B85r 2                       stz IDENT+$82
000B85r 2                       ; MASKTAB+$80..: the mask of the mirrored byte, so the mirrored blitters do one
000B85r 2                       ; lookup instead of SWAPTAB then MASKTAB (only codes < $80 are ever looked up)
000B85r 2                       ldx #0
000B85r 2               :       ldy SWAPTAB,x
000B85r 2                       lda MASKTAB,y
000B85r 2                       sta MASKTAB+$80,x
000B85r 2                       lda IDENT,y
000B85r 2                       sta IDENT+$80,x             ; and its OR value (differs from SWAPTAB only at \$40)
000B85r 2                       inx
000B85r 2                       bpl :-
000B85r 2                 .endif
000B85r 2                       jsr build_ring              ; ring row -> screen address
000B85r 2                       ; row slot -> chars
000B85r 2                       stz w16
000B85r 2                       stz w16+1
000B85r 2                       ldx #0
000B85r 2               @m80:   lda w16+1
000B85r 2                       sta mulrowhi,x
000B85r 2                       lda w16
000B85r 2                       sta mulrowlo,x
000B85r 2                       clc
000B85r 2                       adc #ROWCHARS
000B85r 2                       sta w16
000B85r 2                       bcc :+
000B85r 2                       inc w16+1
000B85r 2               :       inx
000B85r 2                       cpx #RINGROWS
000B85r 2                       bne @m80
000B85r 2                       ldx #0
000B85r 2                       lda #0
000B85r 2               @m:     sta sprmul5,x
000B85r 2                       clc
000B85r 2                       adc #5
000B85r 2                       inx
000B85r 2                       cpx #MAXSPR
000B85r 2                       bne @m
000B85r 2                       stz RECCNT
000B85r 2                       stz RECCNT+1
000B85r 2                       stz DIRTYCNT
000B85r 2                       stz DIRTYCNT+1
000B85r 2                       stz BUF_VALID
000B85r 2                       stz BUF_VALID+1
000B85r 2                       stz NSPR
000B85r 2                       stz SFXREQ
000B85r 2                       stz SFXPTR+1
000B85r 2                       stz MUSON
000B85r 2                       stz DISPSECT
000B85r 2                       stz curbuf
000B85r 2                       lda #BANK_SPR
000B85r 2                       sta spbank
000B85r 2                       lda #$FF
000B85r 2                       sta BUF_BARQ
000B85r 2                       sta BUF_BARQ+1
000B85r 2                       sta tset                    ; no tile set resident yet
000B85r 2                       stz BARDIRTY
000B85r 2                       stz BARBG
000B85r 2                       lda #<VS2T_DEFAULT
000B85r 2                       sta VS2T
000B85r 2                       lda #>VS2T_DEFAULT
000B85r 2                       sta VS2T+1
000B85r 2                       rts
000B85r 2               
000B85r 2               
000B85r 2               ; identity table for the sprite blitter (A | X without a temp store)
000B85r 2                 .if .not MODE1
000B85r 2               init_ident:
000B85r 2                       ldx #0
000B85r 2               :       txa
000B85r 2                       sta IDENT,x
000B85r 2                       inx
000B85r 2                       bne :-
000B85r 2                       rts
000B85r 2                 .endif
000B85r 2                 .endif
000B85r 2                       PLACE "LOW2", "TILCODE"     ; back to the render helpers
000B85r 2               
000B85r 2               
000B85r 2               ; ============================================================================
000B85r 2               ; dirty tiles: redraw changed map tiles (both buffers keep their own list)
000B85r 2               ; ============================================================================
000B85r 2               mark_dirty:                         ; A = tx, X = ty  (adds to both buffers' lists)
000B85r 2  85 rr                sta tmp
000B87r 2  86 rr                stx tmp2
000B89r 2  A2 00                ldx #0
000B8Br 2  BD rr rr     @b:     lda DIRTYCNT,x
000B8Er 2  C9 10                cmp #16
000B90r 2  B0 19                bcs @next
000B92r 2  0A                   asl
000B93r 2  85 rr                sta tmp3
000B95r 2  8A                   txa
000B96r 2  0A                   asl
000B97r 2  0A                   asl
000B98r 2  0A                   asl
000B99r 2  0A                   asl
000B9Ar 2  0A                   asl                         ; x*32 -- X is 0 or 1, so the fifth asl cannot
000B9Br 2  65 rr                adc tmp3                    ; carry out and the clc is dead
000B9Dr 2  A8                   tay
000B9Er 2  A5 rr                lda tmp
000BA0r 2  99 rr rr             sta DIRTYLIST,y
000BA3r 2  A5 rr                lda tmp2
000BA5r 2  99 rr rr             sta DIRTYLIST+1,y
000BA8r 2  FE rr rr             inc DIRTYCNT,x
000BABr 2  E8           @next:  inx
000BACr 2  E0 02                cpx #2
000BAEr 2  D0 DB                bne @b
000BB0r 2  60                   rts
000BB1r 2               
000BB1r 2               draw_dirty:
000BB1r 2  A6 rr                ldx curbuf
000BB3r 2  BD rr rr             lda DIRTYCNT,x
000BB6r 2  F0 3F                beq @done
000BB8r 2  85 rr                sta lcnt
000BBAr 2  8A                   txa
000BBBr 2  0A                   asl
000BBCr 2  0A                   asl
000BBDr 2  0A                   asl
000BBEr 2  0A                   asl
000BBFr 2  0A                   asl
000BC0r 2  85 rr                sta lidx
000BC2r 2  A4 rr        @l:     ldy lidx
000BC4r 2  B9 rr rr             lda DIRTYLIST,y
000BC7r 2  48 A9 00 85          stza rc_x+1
000BCBr 2  rr 68        
000BCDr 2  0A                   asl
000BCEr 2  26 rr                rol rc_x+1
000BD0r 2  0A                   asl
000BD1r 2  26 rr                rol rc_x+1
000BD3r 2  85 rr                sta rc_x
000BD5r 2  B9 rr rr             lda DIRTYLIST+1,y
000BD8r 2  C8                   iny                         ; Y is dead from here: advance the index in it
000BD9r 2  C8                   iny
000BDAr 2  84 rr                sty lidx
000BDCr 2  0A                   asl
000BDDr 2  85 rr                sta rc_y
000BDFr 2  A9 04                lda #4
000BE1r 2  85 rr                sta rc_w
000BE3r 2  A9 02                lda #2
000BE5r 2  85 rr                sta rc_h
000BE7r 2  20 rr rr             jsr drawrect_clip
000BEAr 2  C6 rr                dec lcnt
000BECr 2  D0 D4                bne @l
000BEEr 2  A6 rr                ldx curbuf
000BF0r 2  48 A9 00 9D          stza DIRTYCNT,x
000BF4r 2  rr rr 68     
000BF7r 2  60           @done:  rts
000BF8r 2               
000BF8r 2                 .if .not MODELB                   ; (Model B: modelb/src/display.s, in bank 6)
000BF8r 2                       .segment "CODE"
000BF8r 2               
000BF8r 2               ; ============================================================================
000BF8r 2               ; IRQ handling
000BF8r 2               ; ============================================================================
000BF8r 2               irq_handler:
000BF8r 2                       stx irq_x
000BF8r 2                       sty irq_y
000BF8r 2                       bit VIA_IFR
000BF8r 2                       bvs @t1arm                  ; the T1 arm grew past bvc's reach: one cycle each way
000BF8r 2                       jmp @notT1
000BF8r 2               @t1arm: ; ---- rupture chain step.  This is a CRTC restart: the next section's address
000BF8r 2                       ; was armed during the previous one and is latched at the boundary.  What the
000BF8r 2                       ; new section needs quickly is its shape.  R9 and R4 together decide where the
000BF8r 2                       ; section ENDS: the CRTC latches end-of-frame at the start of the scanline
000BF8r 2                       ; where row = R4 and line = R9, so for a 2-line section (a partial with
000BF8r 2                       ; R9 = 1) both must be in place before the start of scanline 1 -- 128 cycles
000BF8r 2                       ; after the restart.  R6 is compared from scanline 1 on, so Q's R6 = 0 has
000BF8r 2                       ; the same deadline.  Everything else has a row or more to spare.  The chain is
000BF8r 2                       ; phased (VS2T_DEFAULT) so the step fires ~50 cycles BEFORE the restart, the
000BF8r 2                       ; hold below carries the first write past it, and the three deadline registers
000BF8r 2                       ; then land about 40, 60 and 80 cycles in, with the rest behind them.  Writing
000BF8r 2                       ; R4 third put it at ~140 for a 2-line P2: that section never ended, Q's R6
000BF8r 2                       ; hit never came, and both borders lit up on every scroll frame.
000BF8r 2                       ; ACCCON D is different again: it is the memory map, sampled by every fetch,
000BF8r 2                       ; so it must be in place BEFORE the boundary -- the bar's T1 fires a further
000BF8r 2                       ; BARLEAD us early so D lands in the horizontal blanking of the bar's last line.
000BF8r 2                       ldx SECIDX
000BF8r 2                       cpx DISPSECT                ; the first step is the start of the bar itself, which
000BF8r 2                       beq @noD                    ; is only main RAM to the CRTC while D = 0: leave it
000BF8r 2                       lda ACCCON
000BF8r 2                       and #$FE
000BF8r 2                       ora dispD
000BF8r 2                       sta ACCCON
000BF8r 2               @noD:   ldy #5                      ; ~26 cycles: the first CRTC write must follow the
000BF8r 2               @hold:  dey                         ; restart, and the step fires ahead of it
000BF8r 2                       bne @hold
000BF8r 2                       lda #9
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda SECTAB+3,x
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       lda #4
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda SECTAB+2,x
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       lda #6
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       ldy SECTAB+4,x
000BF8r 2                       sty CRTC_DAT
000BF8r 2                       lda #7
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda SECTAB+5,x
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       sta curR7                   ; the vsync handler re-phases the frame from this
000BF8r 2                       lda #12
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda SECTAB,x
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       lda #13
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda SECTAB+1,x
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       lda SECTAB+6,x
000BF8r 2                       sta VIA_T1LL
000BF8r 2                       lda SECTAB+7,x
000BF8r 2                       sta VIA_T1LH
000BF8r 2                       lda VIA_T1CL                ; clear T1 flag
000BF8r 2                       ; next entry; the chain stops at Q, the only entry whose R7 is the vsync row: a
000BF8r 2                       ; late vsync must not walk the chain off the end of SECTAB.  Every other
000BF8r 2                       ; section's R7 is 30, so C = 1 on the way past, as the adc below needs.
000BF8r 2                       lda curR7                   ; R7, just written
000BF8r 2                       cmp #QVSYNC
000BF8r 2                       beq @stay
000BF8r 2                       txa
000BF8r 2                       adc #7                      ; cpy #0 always leaves C set, so this adds 8
000BF8r 2                       sta SECIDX                  ; X is dead: @exit restores it from irq_x
000BF8r 2               @stay:  ldy irq_y                   ; @exit inlined: no jmp on the chain-step path
000BF8r 2                       ldx irq_x                   ; (X is still SECIDX here, so nothing to store)
000BF8r 2                       lda $FC
000BF8r 2                       rti
000BF8r 2               @notT1:
000BF8r 2                       lda VIA_IFR
000BF8r 2                       and #$02
000BF8r 2                       bne :+
000BF8r 2                       jmp @exit
000BF8r 2               :       ; ---- vsync: restart T1 first (constant latency), counter = vsync->T.  The
000BF8r 2                       ; latch (how long section 0 lasts) is programmed further down, after the
000BF8r 2                       ; flip, because with no status bar section 0's length depends on the fine
000BF8r 2                       ; scroll and so belongs to the buffer that is about to be displayed.
000BF8r 2                       lda VS2T
000BF8r 2                       sta VIA_T1LL
000BF8r 2                       lda VS2T+1
000BF8r 2                       sta VIA_T1CH
000BF8r 2                       lda #$02
000BF8r 2                       sta VIA_IFR
000BF8r 2                       ; re-phase: the vsync fired at row curR7, so end this frame at row curR7+5 with
000BF8r 2                       ; 8-line rows -> T starts exactly 40 lines after the vsync even if the CRTC row
000BF8r 2                       ; counter had run past its vertical total (which otherwise never recovers)
000BF8r 2                       lda #9
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda #7
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       lda #6                      ; pre-arm the bar's R6 now, in Q, where the display
000BF8r 2                       sta CRTC_IDX                ; is already off and a new R6 cannot show: the step
000BF8r 2                       lda #BARROWS                ; ISR at the bar's start is too close to the second
000BF8r 2                       sta CRTC_DAT                ; scanline to be trusted with it
000BF8r 2                       lda #4
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda curR7
000BF8r 2                       clc
000BF8r 2                       adc #QROWS-1-QVSYNC
000BF8r 2                       and #$7F
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       inc vsyncs
000BF8r 2                       lda flipreq
000BF8r 2                       beq @noflip
000BF8r 2                       lda vsyncs
000BF8r 2                       sec
000BF8r 2                       sbc flipvs
000BF8r 2                       cmp #2
000BF8r 2                       bcc @noflip
000BF8r 2                       lda vsyncs
000BF8r 2                       sta flipvs
000BF8r 2                       lda NEXTSECT
000BF8r 2                       sta DISPSECT
000BF8r 2                       lda NEXTBUF                 ; the flip is the section chain moving to the other
000BF8r 2                       sta dispD                   ; buffer's rows; D follows it, but only from the
000BF8r 2                       stz flipreq                 ; first playfield section -- the bar needs D = 0
000BF8r 2               @noflip:
000BF8r 2                       ; everything section 0 needs comes from the buffer that is about to be
000BF8r 2                       ; displayed -- its start address, and (with no status bar) its length
000BF8r 2                       ldx #0
000BF8r 2                       ldy DISPSECT                ; held in Y: SECIDX wants the same byte below
000BF8r 2                       beq :+
000BF8r 2                       ldx #2
000BF8r 2               :       lda BUF_SEC0T1,x
000BF8r 2                       sta VIA_T1LL
000BF8r 2                       lda BUF_SEC0T1+1,x
000BF8r 2                       sta VIA_T1LH
000BF8r 2                       lda #12
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda BUF_SEC0,x
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       lda #13
000BF8r 2                       sta CRTC_IDX
000BF8r 2                       lda BUF_SEC0+1,x
000BF8r 2                       sta CRTC_DAT
000BF8r 2                       lda #$40
000BF8r 2                       sta VIA_IFR
000BF8r 2                       sty SECIDX
000BF8r 2                       lda ACCCON                  ; the bar is below $3000: it is only main RAM to the
000BF8r 2                       and #$FE                    ; CRTC while D = 0
000BF8r 2                       sta ACCCON
000BF8r 2                       jsr scan_keys
000BF8r 2                       jsr sound_tick
000BF8r 2               @exit:
000BF8r 2                       ldy irq_y
000BF8r 2                       ldx irq_x
000BF8r 2                       lda $FC
000BF8r 2                       rti
000BF8r 2               
000BF8r 2               ; CA1 fires at the end of the 2-line vsync pulse.  -35 put every step ~5 us INTO its
000BF8r 2               ; section; the further -36 puts it ~30 us before the restart, so that the shape
000BF8r 2               ; registers land early in the first scanline -- see the chain step in irq_handler.
000BF8r 2               VS2T_DEFAULT = (QROWS-QVSYNC)*8*LINE - 2*LINE - 35 - 36
000BF8r 2                 .endif
000BF8r 2               
000BF8r 2               ; ---------------------------------------------------------------- keyboard
000BF8r 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the interrupt's own work
00006Ar 2               scan_keys:
00006Ar 2  A9 7F                lda #$7F
00006Cr 2  8D 43 FE             sta VIA_DDRA
00006Fr 2  A9 03                lda #3
000071r 2  8D 40 FE             sta VIA_ORB                 ; disable keyboard autoscan
000074r 2  A9 00 8D rr          stz KEYSCAN
000078r 2  rr           
000079r 2  A2 0A                ldx #10
00007Br 2  BD rr rr     @k:     lda keytab,x
00007Er 2  8D 4F FE             sta VIA_ORANH
000081r 2  AD 4F FE             lda VIA_ORANH
000084r 2  10 09                bpl :+
000086r 2  BD rr rr             lda keybits,x
000089r 2                 .if MODELB
000089r 2  0D rr rr             ora KEYSCAN
00008Cr 2  8D rr rr             sta KEYSCAN
00008Fr 2                 .else
00008Fr 2                       tsb KEYSCAN
00008Fr 2                 .endif
00008Fr 2  CA           :       dex
000090r 2  10 E9                bpl @k
000092r 2  AD rr rr             lda KEYSCAN
000095r 2  85 rr                sta keys
000097r 2  60                   rts
000098r 2  61 19 42 79  keytab:  .byte $61,$19, $42,$79, $48,$39,$49, $68,$29, $62, $70
00009Cr 2  48 39 49 68  
0000A0r 2  29 62 70     
0000A3r 2  01 01 02 02  keybits: .byte K_LEFT,K_LEFT, K_RIGHT,K_RIGHT, K_UP,K_UP,K_FIRE, K_DOWN,K_DOWN, K_FIRE, K_MENU
0000A7r 2  04 04 10 08  
0000ABr 2  08 10 20     
0000AEr 2               
0000AEr 2               ; ---------------------------------------------------------------- sound
0000AEr 2               ; sfx format: steps of (b0,b1,b2,frames) written to the SN76489 ; end = $FF
0000AEr 2               sound_tick:
0000AEr 2  A5 A6                lda SFXREQ
0000B0r 2  F0 15                beq @play
0000B2r 2                       ; start new sfx
0000B2r 2  0A                   asl
0000B3r 2  AA                   tax
0000B4r 2  BD rr rr             lda sfxtab-2,x
0000B7r 2  85 rr                sta SFXPTR
0000B9r 2  BD rr rr             lda sfxtab-1,x
0000BCr 2  85 rr                sta SFXPTR+1
0000BEr 2  A9 00 85 A6          stz SFXREQ
0000C2r 2  A9 01                lda #1
0000C4r 2  8D rr rr             sta SFXDUR
0000C7r 2  A5 rr        @play:  lda SFXPTR+1
0000C9r 2  F0 3F                beq @music
0000CBr 2  CE rr rr             dec SFXDUR
0000CEr 2  D0 3A                bne @music
0000D0r 2  A0 00 B1 rr          ldaz SFXPTR                 ; (zp): the first byte needs no index
0000D4r 2  C9 FF                cmp #$FF
0000D6r 2  F0 24                beq @end
0000D8r 2  20 rr rr             jsr sndwrite
0000DBr 2  A0 01                ldy #1
0000DDr 2  B1 rr                lda (SFXPTR),y
0000DFr 2  20 rr rr             jsr sndwrite
0000E2r 2  C8                   iny
0000E3r 2  B1 rr                lda (SFXPTR),y
0000E5r 2  20 rr rr             jsr sndwrite
0000E8r 2  C8                   iny
0000E9r 2  B1 rr                lda (SFXPTR),y
0000EBr 2  8D rr rr             sta SFXDUR
0000EEr 2  A5 rr                lda SFXPTR
0000F0r 2  18                   clc
0000F1r 2  69 04                adc #4
0000F3r 2  85 rr                sta SFXPTR
0000F5r 2  90 13                bcc @music
0000F7r 2  E6 rr                inc SFXPTR+1
0000F9r 2  4C rr rr             bra @music
0000FCr 2  A9 00 85 rr  @end:   stz SFXPTR+1
000100r 2  A9 DF                lda #$DF                    ; channel 2 off
000102r 2  20 rr rr             jsr sndwrite
000105r 2  A9 FF                lda #$FF
000107r 2  20 rr rr             jsr sndwrite
00010Ar 2  4C rr rr     @music: jmp music_tick
00010Dr 2               
00010Dr 2               sndwrite:
00010Dr 2  48                   pha
00010Er 2  A9 FF                lda #$FF
000110r 2  8D 43 FE             sta VIA_DDRA
000113r 2  A9 0B                lda #$0B
000115r 2  8D 40 FE             sta VIA_ORB                 ; keyboard autoscan on so the keyboard does not pull PA7
000118r 2  68                   pla
000119r 2  8D 4F FE             sta VIA_ORANH
00011Cr 2  A9 00                lda #0
00011Er 2  8D 40 FE             sta VIA_ORB
000121r 2  EA                   nop
000122r 2  EA                   nop
000123r 2  EA                   nop
000124r 2  EA                   nop
000125r 2  EA                   nop
000126r 2  EA                   nop
000127r 2  EA                   nop
000128r 2  EA                   nop
000129r 2  A9 08                lda #8
00012Br 2  8D 40 FE             sta VIA_ORB
00012Er 2  A9 7F                lda #$7F
000130r 2  8D 43 FE             sta VIA_DDRA
000133r 2  60                   rts
000134r 2               
000134r 2               ; ---------------------------------------------------------------- music
000134r 2               ; 144-byte period table then the sequence (4-byte records: frames, note0..2;
000134r 2               ; frames = 0 -> loop).  It used to be hidden in bit 6 of the tile bytes, which only
000134r 2               ; worked while the whole tile set was resident; a level now loads just the tiles it
000134r 2               ; uses, so the music is its own file -- in bank 7 above the logic: bank 6 has no room
000134r 2               ; ($B000 + 2208 bytes of box stars runs past $B800, which is where it used to sit, and
000134r 2               ; the music load then took the tail off the last trampoline box).
000134r 2                 .if .not MODELB                   ; (Model B: a label in bank 6, with the player)
000134r 2               MUSIC_ADDR = $B000                  ; bank 7: LOGIC may reach $B000, LV_ALTTAB is at $BE00
000134r 2                 .endif
000134r 2               MUSIC_SEQ  = MUSIC_ADDR + 144
000134r 2                 .if MODELB
000134r 2               MUSIC_TAB  = MUSIC_ADDR             ; the player is in the data's bank: no copy needed
000134r 2                 .else
000134r 2               MUSIC_TAB  = music_tab              ; 72 x 2 byte periods (MIDI 24..95), decoded into RAM
000134r 2                 .endif
000134r 2               ; decode the period table (the first 144 hidden bytes) into music_tab; bank 5 loaded
000134r 2               music_init:
000134r 2                 .if MODELB
000134r 2  60                   rts
000135r 2                 .else
000135r 2                       lda #BANK_LVL
000135r 2                       sta ROMSEL_CPY
000135r 2                       sta ROMSEL
000135r 2                       ldx #144
000135r 2               :       lda MUSIC_ADDR-1,x
000135r 2                       sta music_tab-1,x
000135r 2                       dex
000135r 2                       bne :-
000135r 2                       rts
000135r 2                 .endif
000135r 2               music_tick:
000135r 2  AD rr rr             lda MUSON
000138r 2  F0 2D                beq @done
00013Ar 2  CE rr rr             dec MUSDUR
00013Dr 2  D0 28                bne @done
00013Fr 2                 .if .not MODELB
00013Fr 2                       lda ROMSEL_CPY
00013Fr 2                       pha
00013Fr 2                       lda #BANK_LVL
00013Fr 2                       sta ROMSEL_CPY
00013Fr 2                       sta ROMSEL
00013Fr 2                 .endif
00013Fr 2  20 rr rr             jsr musbyte
000142r 2  D0 0B                bne :+
000144r 2  A9 rr                lda #<MUSIC_SEQ
000146r 2  85 rr                sta MUSPTR
000148r 2  A9 rr                lda #>MUSIC_SEQ
00014Ar 2  85 rr                sta MUSPTR+1
00014Cr 2  20 rr rr             jsr musbyte
00014Fr 2  8D rr rr     :       sta MUSDUR
000152r 2  A2 00                ldx #0
000154r 2  20 rr rr     @v:     jsr musbyte
000157r 2  DD rr rr             cmp MUSNOTE,x
00015Ar 2  F0 06                beq :+
00015Cr 2  9D rr rr             sta MUSNOTE,x
00015Fr 2  20 rr rr             jsr set_voice
000162r 2  E8           :       inx
000163r 2  E0 03                cpx #3
000165r 2  D0 ED                bne @v
000167r 2                 .if .not MODELB
000167r 2                       pla
000167r 2                       sta ROMSEL_CPY
000167r 2                       sta ROMSEL
000167r 2                 .endif
000167r 2  60           @done:  rts
000168r 2               
000168r 2               ; A = next music byte; MUSPTR += 1.  Preserves X.  Z reflects A.  Bank 6 selected.
000168r 2               musbyte:
000168r 2  A0 00 B1 rr          ldaz MUSPTR
00016Cr 2  E6 rr                inc MUSPTR
00016Er 2  D0 02                bne :+
000170r 2  E6 rr                inc MUSPTR+1
000172r 2  C9 00        :       cmp #0
000174r 2  60                   rts
000175r 2               
000175r 2               
000175r 2               ; X = voice (0..2), A = MIDI note (0 = rest)
000175r 2               set_voice:
000175r 2  A8                   tay                         ; the note goes in Y before X is pushed: on a 6502
000176r 2  8A 48                phx                         ; phx is txa/pha and would land on it
000178r 2  8A                   txa
000179r 2  0A                   asl
00017Ar 2  0A                   asl
00017Br 2  0A                   asl
00017Cr 2  0A                   asl
00017Dr 2  0A                   asl
00017Er 2  8D rr rr             sta ISRT1                   ; ch << 5
000181r 2  C0 00                cpy #0
000183r 2  D0 08                bne @note
000185r 2  09 9F                ora #$9F                    ; A is still ch<<5
000187r 2  20 rr rr             jsr sndwrite
00018Ar 2  68 AA                plx
00018Cr 2  60                   rts
00018Dr 2  98           @note:  tya
00018Er 2  38                   sec
00018Fr 2  E9 18                sbc #24
000191r 2  0A                   asl
000192r 2  A8                   tay
000193r 2  B9 rr rr             lda MUSIC_TAB,y
000196r 2  29 0F                and #15
000198r 2  0D rr rr             ora ISRT1
00019Br 2  09 80                ora #$80
00019Dr 2  20 rr rr             jsr sndwrite
0001A0r 2  B9 rr rr             lda MUSIC_TAB,y
0001A3r 2  4A                   lsr
0001A4r 2  4A                   lsr
0001A5r 2  4A                   lsr
0001A6r 2  4A                   lsr
0001A7r 2  8D rr rr             sta ISRT2
0001AAr 2  B9 rr rr             lda MUSIC_TAB+1,y
0001ADr 2  0A                   asl
0001AEr 2  0A                   asl
0001AFr 2  0A                   asl
0001B0r 2  0A                   asl
0001B1r 2  0D rr rr             ora ISRT2
0001B4r 2  20 rr rr             jsr sndwrite
0001B7r 2  68 AA                plx
0001B9r 2  BD rr rr             lda musvol,x
0001BCr 2  0D rr rr             ora ISRT1
0001BFr 2  09 90                ora #$90
0001C1r 2  4C rr rr             jmp sndwrite
0001C4r 2  03 08 08     musvol: .byte 3, 8, 8
0001C7r 2               
0001C7r 2               music_start:
0001C7r 2  A9 rr                lda #<MUSIC_SEQ
0001C9r 2  85 rr                sta MUSPTR
0001CBr 2  A9 rr                lda #>MUSIC_SEQ
0001CDr 2  85 rr                sta MUSPTR+1
0001CFr 2  A9 01                lda #1
0001D1r 2  8D rr rr             sta MUSDUR
0001D4r 2  48 A9 00 8D          stza MUSNOTE
0001D8r 2  rr rr 68     
0001DBr 2  48 A9 00 8D          stza MUSNOTE+1
0001DFr 2  rr rr 68     
0001E2r 2  48 A9 00 8D          stza MUSNOTE+2
0001E6r 2  rr rr 68     
0001E9r 2  8D rr rr             sta MUSON
0001ECr 2  60                   rts
0001EDr 2               
0001EDr 2               music_stop:
0001EDr 2  A9 00 8D rr          stz MUSON
0001F1r 2  rr           
0001F2r 2  A9 9F                lda #$9F
0001F4r 2  20 rr rr             jsr sndwrite
0001F7r 2  A9 BF                lda #$BF
0001F9r 2  20 rr rr             jsr sndwrite
0001FCr 2  A9 DF                lda #$DF
0001FEr 2  20 rr rr             jsr sndwrite
000201r 2  A9 FF                lda #$FF
000203r 2  4C rr rr             jmp sndwrite
000206r 2               
000206r 2               ; ---------------------------------------------------------------- interrupt takeover
000206r 2               take_over:
000206r 2  78                   sei
000207r 2                 .if .not MODELB
000207r 2                       lda IRQ1V
000207r 2                       sta OLDIRQ
000207r 2                       lda IRQ1V+1
000207r 2                       sta OLDIRQ+1
000207r 2                 .endif
000207r 2  A9 rr                lda #<irq_handler
000209r 2  8D 04 02             sta IRQ1V
00020Cr 2  A9 rr                lda #>irq_handler
00020Er 2  8D 05 02             sta IRQ1V+1
000211r 2  A9 7F                lda #$7F
000213r 2  8D 4E FE             sta VIA_IER
000216r 2  8D 6E FE             sta UVIA_IER
000219r 2  AD 4B FE             lda VIA_ACR
00021Cr 2  29 3F                and #$3F
00021Er 2  09 40                ora #$40                    ; T1 continuous
000220r 2  8D 4B FE             sta VIA_ACR
000223r 2  A9 00                lda #<(40*LINE)
000225r 2  8D 46 FE             sta VIA_T1LL
000228r 2  A9 0A                lda #>(40*LINE)
00022Ar 2  8D 45 FE             sta VIA_T1CH
00022Dr 2  A9 C2                lda #$C2                    ; enable CA1 (vsync) + T1
00022Fr 2  8D 4E FE             sta VIA_IER
000232r 2  A9 7F                lda #$7F
000234r 2  8D 4D FE             sta VIA_IFR
000237r 2  48 A9 00 85          stza flipreq
00023Br 2  rr 68        
00023Dr 2  58                   cli
00023Er 2  60                   rts
00023Fr 2               
00023Fr 2               ; ============================================================================
00023Fr 2               ; CRTC / palette setup
00023Fr 2               ; ============================================================================
00023Fr 2                 .if .not MODELB                   ; (Model B: modelb/src/display.s)
00023Fr 2               crtc_init:
00023Fr 2                       ; standard MODE 2 timings, no interlace, cursor off
00023Fr 2                       ldx #0
00023Fr 2               :       stx CRTC_IDX
00023Fr 2                       lda crtctab,x
00023Fr 2                       sta CRTC_DAT
00023Fr 2                       inx
00023Fr 2                       cpx #14
00023Fr 2                       bne :-
00023Fr 2                       lda crtctab+7
00023Fr 2                       sta curR7
00023Fr 2                       rts
00023Fr 2               crtctab: .byte 127,ROWCHARS,98,$28, 38,0,32,34, 0,7, $20,8, $06,$00
00023Fr 2               .if (RINGROWS & (RINGROWS - 1)) <> 0
00023Fr 2               ringmodtab:                         ; only a non-power-of-two ring needs the table; at
00023Fr 2               .repeat 256, i                      ; RINGROWS = 32 ringmod is `and #31` and this is 256
00023Fr 2                       .byte i .mod RINGROWS       ; bytes of main RAM that the bar now uses instead
00023Fr 2               .endrepeat
00023Fr 2               .endif
00023Fr 2                 .endif
00023Fr 2               
00023Fr 2               set_palette:
00023Fr 2                 .if MODE1
00023Fr 2                       ; MODE 1: a pixel's two bits land in bits 3 and 1 of the palette index, the other
00023Fr 2                       ; two bits are don't-cares, so all 16 entries are written: logical 0..3 = K C M Y
00023Fr 2  A2 0F                ldx #15
000241r 2  8A           :       txa
000242r 2  29 08                and #8
000244r 2  4A                   lsr
000245r 2  4A                   lsr
000246r 2  85 rr                sta tmp
000248r 2  8A                   txa
000249r 2  29 02                and #2
00024Br 2  4A                   lsr
00024Cr 2  05 rr                ora tmp
00024Er 2  A8                   tay
00024Fr 2  B9 rr rr             lda @cmyk,y
000252r 2  85 rr                sta tmp
000254r 2  8A                   txa
000255r 2  0A                   asl
000256r 2  0A                   asl
000257r 2  0A                   asl
000258r 2  0A                   asl
000259r 2  05 rr                ora tmp
00025Br 2  8D 21 FE             sta ULA_PAL
00025Er 2  CA                   dex
00025Fr 2  10 E0                bpl :-
000261r 2  60                   rts
000262r 2  07 01 02 04  @cmyk:  .byte 0^7, 6^7, 5^7, 3^7    ; physical black, cyan, magenta, yellow (inverted)
000266r 2                 .else
000266r 2                       ldx #15
000266r 2               :       txa
000266r 2                       asl
000266r 2                       asl
000266r 2                       asl
000266r 2                       asl
000266r 2                       sta tmp
000266r 2                       txa
000266r 2                       and #7
000266r 2                       eor #7
000266r 2                       ora tmp
000266r 2                       sta ULA_PAL
000266r 2                       dex
000266r 2                       bpl :-
000266r 2                       rts
000266r 2                 .endif
000266r 2               
000266r 2               blank_palette:
000266r 2  A2 0F                ldx #15
000268r 2  8A           :       txa
000269r 2  0A                   asl
00026Ar 2  0A                   asl
00026Br 2  0A                   asl
00026Cr 2  0A                   asl
00026Dr 2  09 07                ora #7
00026Fr 2  8D 21 FE             sta ULA_PAL
000272r 2  CA                   dex
000273r 2  10 F3                bpl :-
000275r 2  60                   rts
000276r 2                 .if .not MODELB                   ; (Model B: static tables in the banks that read them,
000276r 2                       .segment "TABLES"           ;  and no disc loader -- modelb/src/banks.s)
000276r 2               sprmul5: .res MAXSPR
000276r 2               mulrowlo: .res RINGROWS
000276r 2               mulrowhi: .res RINGROWS
000276r 2                       .code
000276r 2               
000276r 2               ; ============================================================================
000276r 2               ; Disc loading: polled WD1770 sector reads (DFS single density, 10 x 256 byte sectors/track)
000276r 2               ; file table entries: sector lo, hi, nsectors, bank, dest hi (dest lo = 0)
000276r 2               ; ============================================================================
000276r 2               FDC_CTRL = $FE24
000276r 2               FDC_STAT = $FE28
000276r 2               FDC_CMD  = $FE28
000276r 2               FDC_TRK  = $FE29
000276r 2               FDC_SEC  = $FE2A
000276r 2               FDC_DATA = $FE2B
000276r 2               
000276r 2                       .segment "TABLES"
000276r 2               ld_sec:    .res 2
000276r 2               ld_n:      .res 1
000276r 2               ld_trk:    .res 1
000276r 2               ld_sc:     .res 1
000276r 2               cur_trk:   .res 1
000276r 2               ld_done:   .res 1
000276r 2               ld_secs:   .res 1
000276r 2                       .code
000276r 2               
000276r 2               ; NMI handler (reached via JMP at $0D00): 1770 data request / completion (multi-sector read)
000276r 2               nmi_handler:
000276r 2                       pha
000276r 2                       lda FDC_STAT
000276r 2                       and #3
000276r 2                       cmp #3
000276r 2                       bne nmi_nd
000276r 2                       lda FDC_DATA
000276r 2               nmi_sta:
000276r 2                       sta $FFFF
000276r 2                       inc nmi_sta+1
000276r 2                       bne :+
000276r 2                       inc nmi_sta+2
000276r 2                       dec ld_secs                 ; a whole sector done
000276r 2                       bne :+
000276r 2                       lda #$D0                    ; force interrupt: stop the multi-sector read
000276r 2                       sta FDC_CMD
000276r 2                       lda #1
000276r 2                       sta ld_done
000276r 2               :       pla
000276r 2                       rti
000276r 2               nmi_nd: and #1
000276r 2                       bne :+
000276r 2                       lda #1
000276r 2                       sta ld_done
000276r 2               :       pla
000276r 2                       rti
000276r 2               
000276r 2               ; The 1770 answers at $FE24 (control) and $FE28 (registers).  Control has reset in
000276r 2               ; bit 2 (active low) and density in bit 5.
000276r 2               ; initialise: reset controller, restore head to track 0
000276r 2               disc_init:
000276r 2                       lda #$20
000276r 2                       sta FDC_CTRL                ; reset asserted (active low bit 2)
000276r 2                       lda #$25
000276r 2                       sta FDC_CTRL                ; drive 0, FM, reset released
000276r 2                       lda #$00                    ; restore, spin up, 6ms
000276r 2                       sta FDC_CMD
000276r 2                       jsr fdc_wait
000276r 2                       stza cur_trk
000276r 2                       rts
000276r 2               
000276r 2               fdc_wait:
000276r 2                       ldx #20
000276r 2               :       dex
000276r 2                       bne :-
000276r 2               :
000276r 2                       lda FDC_STAT
000276r 2                       and #1
000276r 2                       bne :-
000276r 2                       rts
000276r 2               
000276r 2               ; load file A (index into filetab) into its destination
000276r 2               loadfile:
000276r 2                       pha
000276r 2                       jsr music_stop
000276r 2                       pla
000276r 2                       tax
000276r 2                       lda ft_seclo,x
000276r 2                       sta ld_sec
000276r 2                       lda ft_sechi,x
000276r 2                       sta ld_sec+1
000276r 2                       lda ft_n,x
000276r 2                       sta ld_n
000276r 2                       lda ft_bank,x
000276r 2                       beq :+
000276r 2                       sta ROMSEL_CPY
000276r 2                       sta ROMSEL
000276r 2               :       lda ft_dest,x
000276r 2                       sta ptr+1
000276r 2                       stz ptr
000276r 2                       ; read ld_n sectors from linear sector ld_sec to ptr
000276r 2               ldread:
000276r 2                       ; track = ld_sec / 10, sector-on-track = ld_sec mod 10.  A 16-bit divide by
000276r 2                       ; repeated subtraction: the disc is 80 tracks, so the quotient is under 80 and
000276r 2                       ; this runs at most ~80 times, once per file.  (The old form accumulated the
000276r 2                       ; high byte as "25 tracks + 6 sectors" into the low byte, which overflowed a
000276r 2                       ; file whose start sector had a low byte of 250 or more -- L4B's header piece
000276r 2                       ; landed exactly there and read from the wrong track.)
000276r 2                       stz ld_trk
000276r 2               @d10:   lda ld_sec
000276r 2                       sec
000276r 2                       sbc #10
000276r 2                       tay
000276r 2                       lda ld_sec+1
000276r 2                       sbc #0
000276r 2                       bcc @drem                   ; ld_sec < 10: what is left is the sector
000276r 2                       sty ld_sec
000276r 2                       sta ld_sec+1
000276r 2                       inc ld_trk
000276r 2                       bne @d10                    ; (unconditional: ld_trk stays under 80)
000276r 2               @drem:  lda ld_sec
000276r 2                       sta ld_sc
000276r 2               ldr_trk: lda ld_trk
000276r 2                       cmp cur_trk
000276r 2                       beq ldr_rd
000276r 2                       sta cur_trk
000276r 2                       sta FDC_DATA
000276r 2                       lda #$10                    ; seek (no verify)
000276r 2                       sta FDC_CMD
000276r 2                       jsr fdc_wait
000276r 2               ldr_rd:  ; sectors to read on this track: min(ld_n, 10 - ld_sc)
000276r 2                       lda #10
000276r 2                       sec
000276r 2                       sbc ld_sc
000276r 2                       cmp ld_n
000276r 2                       bcc :+
000276r 2                       lda ld_n
000276r 2               :       sta ld_secs
000276r 2                       sta tmp
000276r 2                       lda ld_sc
000276r 2                       sta FDC_SEC
000276r 2                       lda ptr
000276r 2                       sta nmi_sta+1
000276r 2                       lda ptr+1
000276r 2                       sta nmi_sta+2
000276r 2                       stz ld_done
000276r 2                       lda #$94                    ; read multiple sectors with head settle (NMI handler transfers and stops)
000276r 2                       sta FDC_CMD
000276r 2                       ldx #20
000276r 2               :       dex
000276r 2                       bne :-
000276r 2               :       lda ld_done
000276r 2                       bne :+
000276r 2                       lda FDC_STAT                ; fallback: command finished without a completion NMI
000276r 2                       and #1
000276r 2                       bne :-
000276r 2               :       jsr fdc_wait                ; the abort takes a moment to clear busy
000276r 2                       lda ptr+1
000276r 2                       clc
000276r 2                       adc tmp
000276r 2                       sta ptr+1
000276r 2                       lda ld_n
000276r 2                       sec
000276r 2                       sbc tmp
000276r 2                       sta ld_n
000276r 2                       beq ldr_end
000276r 2                       stza ld_sc
000276r 2                       inc ld_trk
000276r 2                       bra ldr_trk
000276r 2               ldr_end:  rts
000276r 2                 .endif
000276r 2               
000276r 2                       PLACE "LOW2", "LOWCODE"     ; main RAM under the screen is full; the old MOS
000000r 2               ; ============================================================================
000000r 2               ; Map access for the logic, which lives in bank 7 and so cannot select bank 6
000000r 2               ; itself.  Each of these leaves bank 7 selected, so the logic calls them directly.
000000r 2               ; ============================================================================
000000r 2               ; A = tile row -> mapptr = address of that map row
000000r 2                 .if MODELB
000000r 2                   .if MAPLW = 7
000000r 2  4A           maprow: lsr                         ; row * 128: the row's low bit is the low byte's top
000001r 2  8D DA 00             sta mapptr+1
000004r 2  A9 00                lda #0
000006r 2  6A                   ror
000007r 2  8D D9 00             sta mapptr
00000Ar 2  AD DA 00             lda mapptr+1
00000Dr 2  18                   clc
00000Er 2  69 rr                adc #>LV_MAP
000010r 2  8D DA 00             sta mapptr+1
000013r 2  60                   rts
000014r 2                   .elseif MAPLW = 8
000014r 2               maprow: clc                         ; row * 256: the row is the high byte
000014r 2                       adc #>LV_MAP
000014r 2                       sta mapptr+1
000014r 2                       lda #0
000014r 2                       sta mapptr
000014r 2                       rts
000014r 2                   .else
000014r 2                       .error "maprow: a map is 128 or 256 tiles wide"
000014r 2                   .endif
000014r 2                 .else
000014r 2               maprow: tay
000014r 2                       lda #BANK_MAP
000014r 2                       sta ROMSEL_CPY
000014r 2                       sta ROMSEL
000014r 2                       lda LV_MAPROWLO,y
000014r 2                       sta mapptr
000014r 2                       lda LV_MAPROWHI,y
000014r 2                       sta mapptr+1
000014r 2                       jmp pagelogic
000014r 2                 .endif
000014r 2               
000014r 2               ; A = (mapptr),y ; Y preserved
000014r 2               mapbyte:
000014r 2  A9 06                lda #BANK_MAP
000016r 2  85 F4                sta ROMSEL_CPY
000018r 2  8D 30 FE             sta ROMSEL
00001Br 2  B1 D9                lda (mapptr),y
00001Dr 2  4C rr rr             jmp pagelogic
000020r 2               
000020r 2               ; store A at (mapptr),y ; Y preserved
000020r 2  48           mapput: pha
000021r 2  A9 06                lda #BANK_MAP
000023r 2  85 F4                sta ROMSEL_CPY
000025r 2  8D 30 FE             sta ROMSEL
000028r 2  68                   pla
000029r 2  91 D9                sta (mapptr),y
00002Br 2  4C rr rr             jmp pagelogic
00002Er 2               
00002Er 2               ; the level's map row address table, from maplw (level_init's first job)
00002Er 2                 .if MODELB
00002Er 2                       .segment "LGCLO"
000023r 2               init_maprows:                       ; the row address is arithmetic here (maprow,
000023r 2  60                   rts                         ; maprow5): there is no table to build
000024r 2                 .else
000024r 2               init_maprows:
000024r 2                       lda #BANK_MAP
000024r 2                       sta ROMSEL_CPY
000024r 2                       sta ROMSEL
000024r 2                       stz t16
000024r 2                       lda #>LV_MAP
000024r 2                       sta t16+1
000024r 2                       stz t16b                    ; row stride = 1 << maplw bytes
000024r 2                       stz t16b+1
000024r 2                       ldx maplw
000024r 2                       cpx #8
000024r 2                       beq :++
000024r 2                       lda #1
000024r 2               :       asl
000024r 2                       dex
000024r 2                       bne :-
000024r 2                       sta t16b
000024r 2                       bra :++
000024r 2               :       lda #1
000024r 2                       sta t16b+1
000024r 2               :       lda t16b                    ; (this ':' is counted by the beq/bra :++ above)
000024r 2                       sta MAPSTRIDE
000024r 2                       lda t16b+1
000024r 2                       sta MAPSTRIDE+1
000024r 2                       ldx #0
000024r 2               :       lda t16
000024r 2                       sta LV_MAPROWLO,x
000024r 2                       clc
000024r 2                       adc t16b
000024r 2                       sta t16
000024r 2                       lda t16+1
000024r 2                       sta LV_MAPROWHI,x
000024r 2                       adc t16b+1
000024r 2                       sta t16+1
000024r 2                       inx
000024r 2                       bne :-
000024r 2                       jmp pagelogic
000024r 2                 .endif
000024r 2               
000024r 2               ; build_tileaddr: the tile id -> data address table, into bank 6 at LV_PAGE0.  Ids
000024r 2               ; 0..253 address 64 bytes each from $8000 in the tile bank; 254 and 255 are the two
000024r 2               ; solid fills, which own no bytes there -- hi bit 6 says "fill from a constant" and
000024r 2               ; lo bit 4 picks cyan over black.  Constant, so this runs once at startup.
000024r 2                       PLACE "LOW2", "TILCODE"     ; Model B: the table is in bank 5 with the tiles
000BF8r 2               build_tileaddr:
000BF8r 2                 .if .not MODELB
000BF8r 2                       lda #BANK_MAP
000BF8r 2                       sta ROMSEL_CPY
000BF8r 2                       sta ROMSEL
000BF8r 2                 .endif
000BF8r 2  A2 00                ldx #0
000BFAr 2  8A           @t:     txa
000BFBr 2  0A                   asl                         ; (id & 3) << 6: the rest shifts out
000BFCr 2  0A                   asl
000BFDr 2  0A                   asl
000BFEr 2  0A                   asl
000BFFr 2  0A                   asl
000C00r 2  0A                   asl
000C01r 2  9D rr rr             sta LV_PAGE0,x
000C04r 2  8A                   txa
000C05r 2  4A                   lsr
000C06r 2  4A                   lsr
000C07r 2                 .if MODELB
000C07r 2  18                   clc                         ; the tiles sit at TILES (page aligned), not $8000
000C08r 2  69 rr                adc #>TILES
000C0Ar 2                 .else
000C0Ar 2                       ora #$80                    ; $80 | id >> 2
000C0Ar 2                 .endif
000C0Ar 2  9D rr rr             sta LV_PAGE0+256,x
000C0Dr 2  E8                   inx
000C0Er 2  D0 EA                bne @t
000C10r 2  A9 C0                lda #$C0                    ; the two solid ids carry a fill, not an address
000C12r 2  8D rr rr             sta LV_PAGE0+256+SOLID_CYAN
000C15r 2  8D rr rr             sta LV_PAGE0+256+SOLID_BLACK
000C18r 2  A9 10                lda #$10
000C1Ar 2  8D rr rr             sta LV_PAGE0+SOLID_CYAN
000C1Dr 2  A9 00 8D rr          stz LV_PAGE0+SOLID_BLACK
000C21r 2  rr           
000C22r 2  4C rr rr             jmp pagelogic
000C25r 2               
000C25r 2                 .if .not MODELB
000C25r 2               ; one font glyph out of bank 4, for the menus
000C25r 2               getglyph:
000C25r 2                       lda #HUD_BANK
000C25r 2                       sta ROMSEL_CPY
000C25r 2                       sta ROMSEL
000C25r 2                       ldy #7
000C25r 2               :       lda (w16b),y
000C25r 2                       sta GLYPHBUF,y
000C25r 2                       dey
000C25r 2                       bpl :-
000C25r 2                       jmp pagelogic
000C25r 2                       .segment "CODE"
000C25r 2                 .endif
000C25r 2               
000C25r 2                       PLACE "LOW2", "TILCODE"
000C25r 2               ; the screen address of each ring row, from the base of the buffer being drawn
000C25r 2               build_ring:
000C25r 2                 .if MODELB
000C25r 2  A9 80                lda #<RING_A                ; both bases are xx80: the high byte is the buffer's
000C27r 2  85 rr                sta w16
000C29r 2  A5 E0                lda ringbhi
000C2Br 2                 .else
000C2Br 2                       stz w16
000C2Br 2                       lda #>RINGBASE
000C2Br 2                 .endif
000C2Br 2  85 rr                sta w16+1
000C2Dr 2  A2 00                ldx #0
000C2Fr 2  A5 rr        @r:     lda w16+1
000C31r 2  9D rr rr             sta RINGHI,x
000C34r 2  A5 rr                lda w16
000C36r 2  9D rr rr             sta RINGLO,x
000C39r 2  18                   clc
000C3Ar 2  69 80                adc #<ROWBYTES
000C3Cr 2  85 rr                sta w16
000C3Er 2  A5 rr                lda w16+1
000C40r 2  69 02                adc #>ROWBYTES
000C42r 2  85 rr                sta w16+1
000C44r 2  E8                   inx
000C45r 2  E0 17                cpx #RINGROWS
000C47r 2  D0 E6                bne @r
000C49r 2  60                   rts
000C4Ar 2                 .if .not MODELB
000C4Ar 2                       .segment "CODE"
000C4Ar 2               
000C4Ar 2               ; ---------------------------------------------------------------- level tiles
000C4Ar 2               ; There are two fixed tile sets, outdoors and indoors, each a bank of at most
000C4Ar 2               ; 256 tiles, and a level's header says which it wants.  Levels alternate, so
000C4Ar 2               ; this reads 16K about every other level and nothing in between.
000C4Ar 2               load_tiles:
000C4Ar 2                       setbank BANK_LVL
000C4Ar 2                       lda LV_HDR+20               ; which tile set (header: 20 fixed bytes, then gset)
000C4Ar 2                       cmp tset
000C4Ar 2                       beq :+
000C4Ar 2                       sta tset
000C4Ar 2                       clc
000C4Ar 2                       adc #FI_TILESO
000C4Ar 2                       jmp loadfile
000C4Ar 2               :       rts
000C4Ar 2                 .endif
000C4Ar 2               
000C4Ar 2               ; sign extend A -> tmp3 (0 or $FF).  In LOW2 (the old MOS vector page) because main
000C4Ar 2               ; RAM below the screen is full: there is room to spare there.
000C4Ar 2                       PLACE "LOW2", "TILCODE"     ; (its one caller is the sprite prologue)
000C4Ar 2  29 80        sext:   and #$80
000C4Cr 2  F0 02                beq :+
000C4Er 2  A9 FF                lda #$FF
000C50r 2  85 rr        :       sta tmp3
000C52r 2  60                   rts
000C53r 2               
000C53r 2               ; ============================================================================
000C53r 2               ; Bridges between main RAM and the game logic, which lives at $8900 in bank 7 --
000C53r 2               ; a choice inherited from the Model B, which had no HAZEL to put it in.  t_ goes
000C53r 2               ; in, m_ comes back out:
000C53r 2               ; both leave bank 7 selected on return, so a tail jump through one is as good as
000C53r 2               ; a call.  pagelogic is the whole of the bank switch and the return path of m_.
000C53r 2               ; ============================================================================
000C53r 2                       PLACE "LOW2", "LOWCODE"
00002Er 2               pagelogic:                          ; A, X, Y and the carry all come through intact:
00002Er 2  48                   pha                         ; these sit in the middle of calls that return values
00002Fr 2  A9 07                lda #BANK_LVL
000031r 2  85 F4                sta ROMSEL_CPY
000033r 2  8D 30 FE             sta ROMSEL
000036r 2  68                   pla
000037r 2  60                   rts
000038r 2                 .if .not MODELB
000038r 2               .macro TOBANK n
000038r 2               .ident(.concat("t_", n)):
000038r 2                       jsr pagelogic
000038r 2                       jmp .ident(n)
000038r 2               .endmacro
000038r 2               ; Only TOBANK pays for pagelogic being a subroutine: the jsr and its rts are 12 cycles
000038r 2               ; of ceremony, where m_ and the six direct `jmp pagelogic` are tail jumps that waste
000038r 2               ; nothing.  Of pagelogic's 54 executions a frame only 3.1 are t_ entries, so this is
000038r 2               ; worth 36 cycles a frame, not the 646 the window-wide count suggested.  The inline form
000038r 2               ; is 7 bytes dearer and the bridges live in LOW2, which has ten bytes to its name -- so
000038r 2               ; the two that are worth it move to CODE, which gives LOW2 twelve bytes back.
000038r 2               .macro TOBANKI n
000038r 2               .ident(.concat("t_", n)):
000038r 2                       pha
000038r 2                       lda #BANK_LVL
000038r 2                       sta ROMSEL_CPY
000038r 2                       sta ROMSEL
000038r 2                       pla
000038r 2                       jmp .ident(n)
000038r 2               .endmacro
000038r 2                       .segment "CODE"             ; the two hot bridges, inlined, out of LOW2
000038r 2                       TOBANKI "game_frame"
000038r 2                       TOBANKI "build_sections"
000038r 2                       .segment "LOW2"
000038r 2               
000038r 2               .macro TOMAIN n
000038r 2               .ident(.concat("m_", n)):
000038r 2                       jsr .ident(n)
000038r 2                       jmp pagelogic
000038r 2               .endmacro
000038r 2                       TOBANK "init_tables"
000038r 2                       TOBANK "draw_health"
000038r 2                       TOBANK "draw_lives"
000038r 2                       TOBANK "draw_score"
000038r 2                       TOBANK "redraw_hud"
000038r 2                       TOBANK "draw_stars"
000038r 2                       TOBANK "help_screen"
000038r 2                       TOBANK "level_init"
000038r 2                       TOBANK "level_select"
000038r 2                       TOBANK "pause_menu"
000038r 2                       TOBANK "title_menu"
000038r 2                       TOBANK "winlose"
000038r 2                       TOMAIN "addsprite"
000038r 2                       TOMAIN "blank_palette"
000038r 2                       TOMAIN "calc_ring"
000038r 2                       TOMAIN "clamp_window"
000038r 2                       TOMAIN "drawsprite"
000038r 2                       TOMAIN "loadfile"
000038r 2                       TOMAIN "mark_dirty"
000038r 2               
000038r 2                       .segment "CODE"
000038r 2                       TOMAIN "music_start"
000038r 2                       TOMAIN "music_stop"
000038r 2                       TOMAIN "ringaddr"
000038r 2                       TOMAIN "rnd"
000038r 2                       TOMAIN "select_backbuf"
000038r 2                       TOMAIN "set_palette"
000038r 2                       TOMAIN "wait_flip"
000038r 2                 .else
000038r 2               ; Model B: the logic and the game loop share bank 7, so a bridge to it is only a
000038r 2               ; name; what crosses a bank goes through the far table (modelb/src/defs.inc), and
000038r 2               ; the menus, which the one-level disc does without, are stubs.
000038r 2               t_game_frame = game_frame
000038r 2               t_level_init = level_init
000038r 2               m_addsprite  = addsprite
000038r 2               m_clamp_window = clamp_window
000038r 2               m_rnd        = rnd
000038r 2                       .segment "LGCLO"            ; bank 7's first page, with the entry vector
000024r 2               m_mark_dirty:                       ; A = tx, X = ty -> the lists are in bank 5, and a
000024r 2  48                   pha                         ; far call keeps only A and Y: ty travels in Y
000025r 2  8A                   txa
000026r 2  A8                   tay
000027r 2  68                   pla
000028r 2  A2 09 20 rr          farjsr F_MARKDIRTY
00002Cr 2  rr           
00002Dr 2  60                   rts
00002Er 2               MENU_HELP = 1
00002Er 2               t_title_menu:                       ; "play": never the help screen
00002Er 2  A9 00                lda #0
000030r 2  60                   rts
000031r 2               t_help_screen:
000031r 2               t_pause_menu:                       ; resume
000031r 2               t_winlose:
000031r 2  A9 00                lda #0
000033r 2  60                   rts
000034r 2               t_level_select:                     ; the level is the one on the disc
000034r 2  A9 01                lda #LEVEL_IDX/2
000036r 2  60                   rts
000037r 2               t_redraw_hud = redraw_hud
000037r 2                       .segment "TILCODE"
000C53r 2               mark_dirty_far:                     ; the far entry: Y = ty back into X
000C53r 2  98                   tya
000C54r 2  AA                   tax
000C55r 2  4C rr rr             jmp mark_dirty
000C58r 2                 .endif
000C58r 2               
000C58r 2               ; ============================================================================
000C58r 2               ; Random
000C58r 2               ; ============================================================================
000C58r 2                       PLACE "CODE", "LGCLO"
000037r 2  46 rr        rnd:    lsr seed+1
000039r 2  66 rr                ror seed
00003Br 2  90 06                bcc :+
00003Dr 2  A5 rr                lda seed+1
00003Fr 2  49 B4                eor #$B4
000041r 2  85 rr                sta seed+1
000043r 2  A5 rr        :       lda seed
000045r 2  60                   rts
000046r 2               
000046r 1                       .include "logic.s"
000046r 2               ; ============================================================================
000046r 2               ; CLEO - game logic (port of CleoApp.run() from the J2ME original)
000046r 2               ; ============================================================================
000046r 2               
000046r 2               ; ---------------------------------------------------------------- 16-bit macros
000046r 2               .macro mov16 dst, src
000046r 2                       lda src
000046r 2                       sta dst
000046r 2                       lda src+1
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro mov16i dst, imm
000046r 2                       lda #<(imm)
000046r 2                       sta dst
000046r 2                       lda #>(imm)
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro add16 dst, src
000046r 2                       clc
000046r 2                       lda dst
000046r 2                       adc src
000046r 2                       sta dst
000046r 2                       lda dst+1
000046r 2                       adc src+1
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro add16i dst, imm
000046r 2                       clc
000046r 2                       lda dst
000046r 2                       adc #<(imm)
000046r 2                       sta dst
000046r 2                       lda dst+1
000046r 2                       adc #>(imm)
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro sub16 dst, src
000046r 2                       sec
000046r 2                       lda dst
000046r 2                       sbc src
000046r 2                       sta dst
000046r 2                       lda dst+1
000046r 2                       sbc src+1
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro sub16i dst, imm
000046r 2                       sec
000046r 2                       lda dst
000046r 2                       sbc #<(imm)
000046r 2                       sta dst
000046r 2                       lda dst+1
000046r 2                       sbc #>(imm)
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               ; dst = a - b
000046r 2               .macro dif16 dst, aa, bb
000046r 2                       sec
000046r 2                       lda aa
000046r 2                       sbc bb
000046r 2                       sta dst
000046r 2                       lda aa+1
000046r 2                       sbc bb+1
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro asr16 var
000046r 2                       lda var+1
000046r 2                       cmp #$80
000046r 2                       ror var+1
000046r 2                       ror var
000046r 2               .endmacro
000046r 2               .macro asl16 var
000046r 2                       asl var
000046r 2                       rol var+1
000046r 2               .endmacro
000046r 2               .macro neg16 var
000046r 2                       sec
000046r 2                       lda #0
000046r 2                       sbc var
000046r 2                       sta var
000046r 2                       lda #0
000046r 2                       sbc var+1
000046r 2                       sta var+1
000046r 2               .endmacro
000046r 2               ; sign-extend 8-bit A into dst
000046r 2               .macro sx16 dst
000046r 2                       sta dst
000046r 2                       and #$80
000046r 2                       beq :+
000046r 2                       lda #$FF
000046r 2               :       sta dst+1
000046r 2               .endmacro
000046r 2               ; branch if var > imm (signed 16)
000046r 2               .macro bgt16i var, imm, label
000046r 2                       lda #<(imm)
000046r 2                       cmp var
000046r 2                       lda #>(imm)
000046r 2                       sbc var+1
000046r 2                       bvc :+
000046r 2                       eor #$80
000046r 2               :      bmi label
000046r 2               .endmacro
000046r 2               ; branch if var < imm
000046r 2                       ; branch if var < imm
000046r 2               .macro blt16i var, imm, label
000046r 2                       lda var
000046r 2                       cmp #<(imm)
000046r 2                       lda var+1
000046r 2                       eor #$80                    ; bias both sides by $8000 and compare unsigned:
000046r 2                       sbc #(>(imm) ^ $80)         ; the bias on the constant is free at assembly time
000046r 2               :                                   ; placeholder - keeps the anonymous-label count
000046r 2                       bcc label
000046r 2               .endmacro
000046r 2                       ; branch if var >= imm
000046r 2               .macro bge16i var, imm, label
000046r 2                       lda var
000046r 2                       cmp #<(imm)
000046r 2                       lda var+1
000046r 2                       eor #$80
000046r 2                       sbc #(>(imm) ^ $80)
000046r 2               :                                   ; placeholder - keeps the anonymous-label count
000046r 2                       bcs label
000046r 2               .endmacro
000046r 2               ; branch if var <= imm
000046r 2                       ; branch if var <= imm
000046r 2               .macro ble16i var, imm, label
000046r 2                       lda var                     ; var <= imm is var < imm+1, so this is blt16i's
000046r 2                       cmp #<((imm)+1)             ; bias form: one instruction and no V fixup
000046r 2                       lda var+1
000046r 2                       eor #$80
000046r 2                       sbc #(>((imm)+1) ^ $80)
000046r 2               :                                   ; placeholder - keeps the anonymous-label count
000046r 2                       bcc label
000046r 2               .endmacro
000046r 2               ; branch if a > b (both 16-bit vars)
000046r 2               .macro bgt16 aa, bb, label
000046r 2                       lda bb
000046r 2                       cmp aa
000046r 2                       lda bb+1
000046r 2                       sbc aa+1
000046r 2                       bvc :+
000046r 2                       eor #$80
000046r 2               :      bmi label
000046r 2               .endmacro
000046r 2               .macro blt16 aa, bb, label
000046r 2                       lda aa
000046r 2                       cmp bb
000046r 2                       lda aa+1
000046r 2                       sbc bb+1
000046r 2                       bvc :+
000046r 2                       eor #$80
000046r 2               :      bmi label
000046r 2               .endmacro
000046r 2               .macro bge16 aa, bb, label
000046r 2                       lda aa
000046r 2                       cmp bb
000046r 2                       lda aa+1
000046r 2                       sbc bb+1
000046r 2                       bvc :+
000046r 2                       eor #$80
000046r 2               :      bpl label
000046r 2               .endmacro
000046r 2               .macro bmi16 var, label
000046r 2                       bit var+1
000046r 2                       bmi label
000046r 2               .endmacro
000046r 2               .macro bpl16 var, label
000046r 2                       bit var+1
000046r 2                       bpl label
000046r 2               .endmacro
000046r 2               ; A = max(A - n, 0)  (unsigned)
000046r 2                       ; A = max(A - n, 0)  (unsigned)
000046r 2               .macro submin0 n
000046r 2                       sec
000046r 2                       sbc #n
000046r 2                       bcs :+                      ; no borrow: A >= n, the difference stands
000046r 2                       lda #0
000046r 2               :
000046r 2               .endmacro
000046r 2               ; branch if var (16) == 0
000046r 2               .macro beq16 var, label
000046r 2                       lda var
000046r 2                       ora var+1
000046r 2                       beq label
000046r 2               .endmacro
000046r 2               .macro bne16 var, label
000046r 2                       lda var
000046r 2                       ora var+1
000046r 2                       bne label
000046r 2               .endmacro
000046r 2               
000046r 2               ; ---------------------------------------------------------------- object arrays (bank 7)
000046r 2               NLEAN   = 2                        ; object types below this take the lean path in
000046r 2                                                  ; process_object: no zero-page staging at all
000046r 2                 .if MODELB
000046r 2               OBJN    = 126                      ; the one level on the disc has 126 objects; the arrays
000046r 2                 .else                            ; are laid out exactly as the Master's, just shorter
000046r 2               OBJN    = 149
000046r 2                 .endif
000046r 2               O_STAMP = LV_OBJST
000046r 2               O_TYPE  = O_STAMP + OBJN
000046r 2               O_XL    = O_TYPE + OBJN
000046r 2               O_XH    = O_XL + OBJN
000046r 2               O_YL    = O_XH + OBJN
000046r 2               O_YH    = O_YL + OBJN
000046r 2               O_AL    = O_YH + OBJN
000046r 2               O_AH    = O_AL + OBJN
000046r 2               O_BL    = O_AH + OBJN
000046r 2               O_BH    = O_BL + OBJN
000046r 2               O_CL    = O_BH + OBJN
000046r 2               O_CH    = O_CL + OBJN
000046r 2               O_DL    = O_CH + OBJN
000046r 2               O_DH    = O_DL + OBJN
000046r 2               O_EL    = O_DH + OBJN
000046r 2               O_EH    = O_EL + OBJN
000046r 2                 .if .not MODELB                  ; (Model B: labels in bank 6, page aligned)
000046r 2               LV_MAPROWLO = $A900               ; bank 6: 256 : tile row -> map row address
000046r 2               LV_MAPROWHI = $AA00
000046r 2                 .endif
000046r 2               
