001C2Cr 2               ; ============================================================================
001C2Cr 2               ; Status bar digits (drawn into the bar master image in bank 4)  [main RAM]
001C2Cr 2               ; ============================================================================
001C2Cr 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the digits and the bar art
001C2Cr 2               ; draw digit A at bar pixel column X (even), digit slot Y (0..8): copies a 64-byte digit
001C2Cr 2               ; tile into the bar image.
001C2Cr 2               ;
001C2Cr 2               ; Each buffer remembers the nine values its bar was last drawn with, because redraw_hud
001C2Cr 2               ; redraws all nine whenever anything changes and a score tick usually moves only one of
001C2Cr 2               ; them -- the other eight were 128 bytes of copy for no pixels (measured 5.0K cycles a
001C2Cr 2               ; render on an L0 run, 3.2% of the frame).  The bank is BANK_LVL on entry and on exit, so
001C2Cr 2               ; the skip path must not touch it.
001C2Cr 2               bar_digit:
001C2Cr 2  D9 rr rr             cmp BARCACHE,y              ; one bar, so one cache: no curbuf in the index
001C2Fr 2  F0 59                beq bd_same
