001C34r 2                       setbank HUD_BANK
001C34r 2                       pla
001C34r 2                 .endif
001C34r 2  4A                   lsr                         ; C = d bit0, A = d >> 1
001C35r 2  85 rr                sta w16+1
001C37r 2  A9 00                lda #0
001C39r 2  6A                   ror                         ; A = d0 << 7
001C3Ar 2  46 rr                lsr w16+1                   ; C = d bit1, w16+1 = d >> 2
001C3Cr 2  6A                   ror                         ; A = d1 << 7 | d0 << 6
001C3Dr 2  18                   clc
001C3Er 2  69 rr                adc #<SPR_DIGITS
001C40r 2  85 rr                sta w16
001C42r 2  A5 rr                lda w16+1
001C44r 2  69 rr                adc #>SPR_DIGITS
001C46r 2  85 rr                sta w16+1                   ; digit tile
001C48r 2  8A                   txa
001C49r 2  29 FE                and #$FE                    ; char = x/2, then *8 -- i.e. (x & $FE) * 4
001C4Br 2  48 A9 00 85          stza ptr+1
001C4Fr 2  rr 68        
001C51r 2  0A                   asl
001C52r 2  26 rr                rol ptr+1
001C54r 2  0A                   asl
001C55r 2  26 rr                rol ptr+1
001C57r 2  69 00                adc #<BARADDR               ; straight into the back buffer's bar row (no offscreen
001C59r 2  85 rr                sta ptr                     ; buffer): bank 4 glyph at $8xxx, screen bar at $7Bxx
001C5Br 2  A5 rr                lda ptr+1                   ; C is already clear: ptr+1 was 0 or 1 before the second
001C5Dr 2  69 03                adc #>BARADDR               ; rol, so that rol shifted a 0 out
001C5Fr 2  85 rr                sta ptr+1
