000542r 2                       CLINE mirror
000542r 2                       iny
000542r 2                       CLINE mirror
000542r 2               done:
000542r 2               .endmacro
000542r 2               .macro SPRMSK name, mirror
000542r 2                       .local partial, np, et, p0, p1, p2, p3, pl, pop, pnext
000542r 2               name:
000542r 2                       lda tmp2
000542r 2                       cmp #7
