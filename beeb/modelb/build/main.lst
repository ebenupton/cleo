00052Er 2  C8                   iny
00052Fr 2  D0 02                bne :+
000531r 2  E6 rr                inc w16+1
000533r 2  CA           :       dex
000534r 2  D0 F6                bne @st
000536r 2  E6 rr                inc cnt
000538r 2  A5 rr                lda cnt
00053Ar 2  C9 50                cmp #ROWCHARS
00053Cr 2  D0 DD                bne @char
00053Er 2  A6 rr                ldx tmp2
000540r 2  E8                   inx
000541r 2  E0 17                cpx #RINGROWS
