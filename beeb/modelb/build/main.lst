000542r 2               .macro MPAIR k, mirror              ; lines k, k+1 of the cell
000542r 2                       .local opq, done
000542r 2                       ldy #k/2
000542r 2                       lda (mptr),y
000542r 2                       tay
000542r 2                       lda (mtab),y
