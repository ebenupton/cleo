00041Er 2  69 16                adc #BUFROWS                ; A = BUFROWS-1-rc_h, C = 1 (rc_h <= BUFROWS-1)
000420r 2  65 rr                adc wcy                     ; + wcy + 1 -> wcy + BUFROWS - rc_h
000422r 2  85 rr                sta rc_y
000424r 2               @dorows:
000424r 2  A5 rr                lda wcx
000426r 2  85 rr                sta rc_x
000428r 2  A5 rr                lda wcx+1
00042Ar 2  85 rr                sta rc_x+1
00042Cr 2  A9 50                lda #ROWCHARS
00042Er 2  85 rr                sta rc_w
000430r 2  20 rr rr             jsr drawrect
000433r 2  4C rr rr             bra @done
000436r 2               @full:
000436r 2  A5 rr                lda wcy
000438r 2  85 rr                sta rc_y
00043Ar 2  A9 16                lda #BUFROWS
00043Cr 2  85 rr                sta rc_h
00043Er 2  4C rr rr             bra @dorows
000441r 2               @done:
000441r 2  A6 rr                ldx curbuf
000443r 2  A9 01                lda #1
000445r 2  9D rr rr             sta BUF_VALID,x
000448r 2  A9 00 9D rr          stz BUF_BOTOK,x             ; the window moved: the slot below is stale again
00044Cr 2  rr           
00044Dr 2  A5 rr                lda wcy
00044Fr 2  9D rr rr             sta BUF_CY,x
000452r 2  8A                   txa
000453r 2  0A                   asl
000454r 2  A8                   tay
000455r 2  A5 rr                lda wcx
000457r 2  99 rr rr             sta BUF_CX,y
00045Ar 2  A5 rr                lda wcx+1
00045Cr 2  99 rr rr             sta BUF_CX+1,y
00045Fr 2  60                   rts
000460r 2               
000460r 2               ; ============================================================================
000460r 2               ; ============================================================================
000460r 2               ; Persistent sprite records.  match_sprites: KEEP[i] = new sprite i identical to record i
000460r 2               ; ============================================================================
000460r 2               match_sprites:
000460r 2  A6 rr                ldx curbuf
000462r 2  BD rr rr             lda RECCNT,x
000465r 2  C5 A3                cmp NSPR
000467r 2  90 02                bcc :+
000469r 2  A5 A3                lda NSPR
00046Br 2  85 rr        :       sta cnt                     ; n = min(RECCNT, NSPR)
00046Dr 2  48 A9 00 85          stza tmp4                   ; i
000471r 2  rr 68        
000473r 2  A5 rr                lda recp
000475r 2  85 rr                sta rp
000477r 2  A5 rr                lda recp+1
000479r 2  85 rr                sta rp+1
00047Br 2  A6 rr        @l:     ldx tmp4
00047Dr 2  E4 A3                cpx NSPR
00047Fr 2  B0 65                bcs @done
000481r 2  48 A9 00 9D          stza KEEP,x
000485r 2  rr rr 68     
000488r 2  E4 rr                cpx cnt
00048Ar 2  B0 4A                bcs @next
00048Cr 2  BD 30 80             lda sprmul5,x
00048Fr 2  AA                   tax
000490r 2  BD rr rr             lda SPRLIST,x
000493r 2  A0 00 D1 rr          cmpz rp                     ; (zp): offset 0 needs no index register
000497r 2  F0 11                beq @same
000499r 2                       ; two box-star frames at the same place overwrite each other exactly -- every
000499r 2                       ; pixel opaque, and each box covers the art of the frame before it -- so a
000499r 2                       ; frame change there needs no erase either
000499r 2  C9 67                cmp #BOXID0
00049Br 2  90 39                bcc @next
00049Dr 2  A0 00 B1 rr          ldaz rp
0004A1r 2  C9 67                cmp #BOXID0
0004A3r 2  90 31                bcc @next
0004A5r 2  A9 01                lda #1                      ; 1 = a different frame of the same thing
0004A7r 2  4C rr rr             bra @pos
0004AAr 2  A9 02        @same:  lda #2                      ; 2 = identical, so its pixels are already right
0004ACr 2  85 rr        @pos:   sta tmp3
0004AEr 2  A0 01                ldy #1
0004B0r 2  BD rr rr             lda SPRLIST+1,x
0004B3r 2  D1 rr                cmp (rp),y
0004B5r 2  D0 1F                bne @next
0004B7r 2  C8                   iny
0004B8r 2  BD rr rr             lda SPRLIST+2,x
0004BBr 2  D1 rr                cmp (rp),y
0004BDr 2  D0 17                bne @next
0004BFr 2  C8                   iny
0004C0r 2  BD rr rr             lda SPRLIST+3,x
0004C3r 2  D1 rr                cmp (rp),y
0004C5r 2  D0 0F                bne @next
0004C7r 2  C8                   iny
0004C8r 2  BD rr rr             lda SPRLIST+4,x
0004CBr 2  D1 rr                cmp (rp),y
0004CDr 2  D0 07                bne @next
0004CFr 2  A6 rr                ldx tmp4
0004D1r 2  A5 rr                lda tmp3
0004D3r 2  9D rr rr             sta KEEP,x                  ; same pixels in the same place: skip the erase
0004D6r 2  A5 rr        @next:  lda rp
0004D8r 2  18                   clc
0004D9r 2  69 0A                adc #10
0004DBr 2  85 rr                sta rp
0004DDr 2  90 02                bcc :+
0004DFr 2  E6 rr                inc rp+1
0004E1r 2  E6 rr        :       inc tmp4
0004E3r 2  4C rr rr             bra @l
0004E6r 2  60           @done:  rts
0004E7r 2               
0004E7r 2               ; erase_old: redraw tiles under old records that are not kept
0004E7r 2               erase_old:
0004E7r 2  A6 rr                ldx curbuf
0004E9r 2  BD rr rr             lda RECCNT,x
0004ECr 2  F0 4C                beq @done
0004EEr 2  85 rr                sta lcnt
0004F0r 2  A9 00 85 rr          stz lidx
0004F4r 2  A5 rr                lda recp
0004F6r 2  85 rr                sta rp
0004F8r 2  A5 rr                lda recp+1
0004FAr 2  85 rr                sta rp+1
0004FCr 2  A6 rr        @l:     ldx lidx
0004FEr 2  E4 A3                cpx NSPR
000500r 2  B0 05                bcs @erase
000502r 2  BD rr rr             lda KEEP,x
000505r 2  D0 22                bne @next
000507r 2  A0 08        @erase: ldy #8
000509r 2  B1 rr                lda (rp),y
00050Br 2  F0 1C                beq @next
00050Dr 2  85 rr                sta rc_w
00050Fr 2  C8                   iny
000510r 2  B1 rr                lda (rp),y
000512r 2  29 7F                and #$7F
000514r 2  85 rr                sta rc_h
000516r 2  A0 05                ldy #5
000518r 2  B1 rr                lda (rp),y
00051Ar 2  85 rr                sta rc_x
00051Cr 2  C8                   iny
00051Dr 2  B1 rr                lda (rp),y
00051Fr 2  85 rr                sta rc_x+1
000521r 2  C8                   iny
000522r 2  B1 rr                lda (rp),y
000524r 2  85 rr                sta rc_y
000526r 2  20 rr rr             jsr drawrect_clip
000529r 2  A5 rr        @next:  lda rp
00052Br 2  18                   clc
00052Cr 2  69 0A                adc #10
00052Er 2  85 rr                sta rp
000530r 2  90 02                bcc :+
000532r 2  E6 rr                inc rp+1
000534r 2  E6 rr        :       inc lidx
000536r 2  C6 rr                dec lcnt
000538r 2  D0 C2                bne @l
00053Ar 2  60           @done:  rts
00053Br 2               
00053Br 2               ; ============================================================================
00053Br 2               ; Sprites
00053Br 2               ; ============================================================================
00053Br 2               ; add sprite to draw list: A = id, spx/spy = map px
00053Br 2                       PLACE "CODE", "LGCLO"       ; Model B: the logic's bank writes SPRLIST in low RAM
000000r 2               addsprite:
000000r 2  A6 A3                ldx NSPR
000002r 2  E0 18                cpx #MAXSPR
000004r 2  B0 1C                bcs @full
000006r 2  BC 30 80             ldy sprmul5,x
000009r 2  99 rr rr             sta SPRLIST,y
00000Cr 2  A5 rr                lda spx
00000Er 2  99 rr rr             sta SPRLIST+1,y
000011r 2  A5 rr                lda spx+1
000013r 2  99 rr rr             sta SPRLIST+2,y
000016r 2  A5 rr                lda spy
000018r 2  99 rr rr             sta SPRLIST+3,y
00001Br 2  A5 rr                lda spy+1
00001Dr 2  99 rr rr             sta SPRLIST+4,y
000020r 2  E6 A3                inc NSPR
000022r 2  60           @full:  rts
000023r 2               
000023r 2               ; draw all listed sprites into current buffer (skipping unchanged kept ones)
000023r 2                       PLACE "CODE", "TILCODE"
00053Br 2               draw_sprites:
00053Br 2                       ; Two passes.  A box star is an opaque rectangle with its background baked in,
00053Br 2                       ; so it has to go down before anything that shares its space -- drawn in list
00053Br 2                       ; order it would paint that background over whatever was standing there.
00053Br 2  A9 01                lda #1
00053Dr 2  8D rr rr             sta dpass
000540r 2  48 A9 00 85  @pass:  stza spi
000544r 2  rr 68        
000546r 2  A5 rr                lda recp
000548r 2  85 rr                sta rp
00054Ar 2  A5 rr                lda recp+1
00054Cr 2  85 rr                sta rp+1
00054Er 2  A6 rr        @l:     ldx spi
000550r 2  E4 A3                cpx NSPR
000552r 2  B0 67                bcs @endpass
000554r 2  BD 30 80             lda sprmul5,x
000557r 2  AA                   tax
000558r 2  BD rr rr             lda SPRLIST,x
00055Br 2  C9 67                cmp #BOXID0
00055Dr 2  AD rr rr             lda dpass
000560r 2  69 FF                adc #$FF
000562r 2  F0 47                beq @next
000564r 2  BD rr rr             lda SPRLIST,x
000567r 2  C9 76                cmp #BOXID0+BOXN            ; a box star the logic says nothing can disturb, and
000569r 2  90 0F                bcc @write                  ; the same frame already in the same place: if
00056Br 2  A4 rr                ldy spi                     ; nothing has been repainted under it, its pixels
00056Dr 2  B9 rr rr             lda KEEP,y                  ; are still right, so leave it alone
000570r 2  C9 02                cmp #2
000572r 2  D0 06                bne @write
000574r 2  A0 09                ldy #9                      ; and it was not cut off at a window edge, so all
000576r 2  B1 rr                lda (rp),y                  ; of it is on screen and still intact
000578r 2  10 31                bpl @next
00057Ar 2  A0 01        @write: ldy #1
00057Cr 2  BD rr rr             lda SPRLIST+1,x
00057Fr 2  85 rr                sta spx
000581r 2  91 rr                sta (rp),y
000583r 2  C8                   iny
000584r 2  BD rr rr             lda SPRLIST+2,x
000587r 2  85 rr                sta spx+1
000589r 2  91 rr                sta (rp),y
00058Br 2  C8                   iny
00058Cr 2  BD rr rr             lda SPRLIST+3,x
00058Fr 2  85 rr                sta spy
000591r 2  91 rr                sta (rp),y
000593r 2  C8                   iny
000594r 2  BD rr rr             lda SPRLIST+4,x
000597r 2  85 rr                sta spy+1
000599r 2  91 rr                sta (rp),y
00059Br 2  A0 08                ldy #8
00059Dr 2  A9 00                lda #0
00059Fr 2  91 rr                sta (rp),y
0005A1r 2  BD rr rr             lda SPRLIST,x
0005A4r 2  A0 00 91 rr          staz rp                     ; sta (rp) - offset 0 needs no index
0005A8r 2  20 rr rr             jsr drawsprite
0005ABr 2  A5 rr        @next:  lda rp
0005ADr 2  18                   clc
0005AEr 2  69 0A                adc #10
0005B0r 2  85 rr                sta rp
0005B2r 2  90 02                bcc :+
0005B4r 2  E6 rr                inc rp+1
0005B6r 2  E6 rr        :       inc spi
0005B8r 2  4C rr rr             jmp @l
0005BBr 2               @endpass:
0005BBr 2  CE rr rr             dec dpass
0005BEr 2  30 03                bmi :+
0005C0r 2  4C rr rr             jmp @pass                   ; (out of branch range on the 6502 build)
0005C3r 2  A6 rr        :       ldx curbuf
0005C5r 2  A5 A3                lda NSPR
0005C7r 2  9D rr rr             sta RECCNT,x
0005CAr 2  60                   rts
0005CBr 2               
0005CBr 2               ; draw one sprite: A = id ; spx, spy = map px (ref point)
0005CBr 2               ; A = sprite id. Game sprites (spbank = BANK_SPR): directory is in main RAM at
0005CBr 2               ; SPR_TABLE; sprite data is in bank 4, or in ANDY ($8000, ROMSEL bit7) when the
0005CBr 2               ; entry's flag bit2 is set. Title pieces (spbank != BANK_SPR): directory and data
0005CBr 2               ; both live at TITLE_ADDR of that bank.
0005CBr 2               drawsprite:
0005CBr 2  48 A9 00 8D          stza spclip                 ; set at every window edge the sprite is cut against
0005CFr 2  rr rr 68     
0005D2r 2  C9 76                cmp #BOXID0+BOXN            ; the "nothing can disturb it" aliases draw the same
0005D4r 2  90 02                bcc :+                      ; picture as the ids BOXN below them
0005D6r 2  E9 0F                sbc #BOXN
0005D8r 2               :
0005D8r 2                 .if MODE1
0005D8r 2  85 rr                sta sp_id
0005DAr 2                 .endif
0005DAr 2  48 A9 00 85          stza ptr+1
0005DEr 2  rr 68        
0005E0r 2  0A                   asl                         ; id*8 -> offset
0005E1r 2  26 rr                rol ptr+1
0005E3r 2  0A                   asl
0005E4r 2  26 rr                rol ptr+1
0005E6r 2  0A                   asl
0005E7r 2  26 rr                rol ptr+1
0005E9r 2  AE rr rr             ldx spbank
0005ECr 2  E0 04                cpx #BANK_SPR
0005EEr 2  D0 41                bne @titledir
0005F0r 2                 .if .not MODELB               ; (Model B: the directory is in this bank)
0005F0r 2                       ldx #BANK_LVL           ; SPR_TABLE is in bank 7; the whole prologue reads
0005F0r 2                       stx ROMSEL_CPY          ; the directory and none of it reads sprite data
0005F0r 2                       stx ROMSEL
0005F0r 2                 .endif
0005F0r 2  18                   clc
0005F1r 2  69 rr                adc #<SPR_TABLE
0005F3r 2  85 rr                sta ptr
0005F5r 2  A5 rr                lda ptr+1
0005F7r 2  69 rr                adc #>SPR_TABLE
0005F9r 2  85 rr                sta ptr+1
0005FBr 2                 .if MODELB
0005FBr 2  20 rr rr             jsr dirfetch                ; the directory is in bank 6: its eight bytes come
0005FEr 2                 .endif                            ; into low RAM and ptr points there
0005FEr 2  A0 06                ldy #6
000600r 2  B1 rr                lda (ptr),y
000602r 2  85 rr                sta sp_flags
000604r 2  A2 04                ldx #BANK_SPR
000606r 2  85 DF 29 04          bitimm 4
00060Ar 2  08 A5 DF 28  
00060Er 2  F0 02                beq :+
000610r 2  A2 84                ldx #(BANK_SPR|$80)
000612r 2  85 DF 29 10  :       bitimm $10              ; A still holds the flags byte
000616r 2  08 A5 DF 28  
00061Ar 2  F0 02                beq :+
00061Cr 2  A2 06                ldx #BANK_TIL1
00061Er 2  86 rr        :       stx sp_dbank            ; wanted later: the directory is still being read
000620r 2                 .if MODE1
000620r 2  A5 rr                lda sp_id
000622r 2  0A                   asl
000623r 2  AA                   tax
000624r 2  BD rr rr             lda SPRMASK,x
000627r 2  85 EC                sta sp_mbase
000629r 2  BD rr rr             lda SPRMASK+1,x
00062Cr 2  85 ED                sta sp_mbase+1
00062Er 2                 .endif
00062Er 2  4C rr rr             bra @entry2
000631r 2               @titledir:
000631r 2                       ; ---- title piece: directory + data at TITLE_ADDR of bank(spbank)
000631r 2  85 rr                sta ptr                     ; only this path uses id*8 as the low byte unadjusted
000633r 2  A5 rr                lda ptr+1
000635r 2  18                   clc
000636r 2  69 89                adc #>TITLE_ADDR
000638r 2  85 rr                sta ptr+1
00063Ar 2  AD rr rr             lda spbank              ; title pieces keep directory and data in one bank
00063Dr 2  85 rr                sta sp_dbank
00063Fr 2                 .if .not MODELB
00063Fr 2                       sta ROMSEL_CPY
00063Fr 2                       sta ROMSEL
00063Fr 2                 .endif
00063Fr 2  A0 06                ldy #6
000641r 2  B1 rr                lda (ptr),y
000643r 2  85 rr                sta sp_flags
000645r 2                 .if MODE1
000645r 2  A5 rr                lda sp_id                   ; the mask address table behind the directory
000647r 2  0A                   asl
000648r 2  AA                   tax
000649r 2  BD 80 89             lda TITLE_ADDR+$80,x
00064Cr 2  85 EC                sta sp_mbase
00064Er 2  BD 81 89             lda TITLE_ADDR+$81,x
000651r 2  85 ED                sta sp_mbase+1
000653r 2                 .endif
000653r 2               @entry2:
000653r 2  A0 00 B1 rr          ldaz ptr
000657r 2  85 rr                sta sp_ptr
000659r 2  A0 01                ldy #1
00065Br 2  B1 rr                lda (ptr),y
00065Dr 2  85 rr                sta sp_ptr+1
00065Fr 2  C8                   iny
000660r 2  B1 rr                lda (ptr),y
000662r 2  85 rr                sta sp_w
000664r 2                 .if MODELB
000664r 2  D0 03                bne @w_ok                   ; (the 6502 spellings put @out0 out of reach)
000666r 2  4C rr rr             jmp @out0
000669r 2               @w_ok:
000669r 2                 .else
000669r 2                       beq @out0
000669r 2                 .endif
000669r 2               :                                   ; keep the bare label: it preserves the anonymous-label count
000669r 2  A0 07                ldy #7
00066Br 2  B1 rr                lda (ptr),y
00066Dr 2  85 rr                sta sp_lines
00066Fr 2  85 rr                sta sp_ext
000671r 2                 .if MODE1
000671r 2  4A                   lsr
000672r 2  85 E9                sta sp_mh                   ; mask bytes per column group = pixel rows
000674r 2                 .endif
000674r 2  A5 rr                lda sp_flags
000676r 2  29 02                and #2
000678r 2  D0 02                bne :+
00067Ar 2  06 rr                asl sp_ext                  ; half-res: two scanlines per stored row
00067Cr 2               :       ; ---- horizontal: sx = spx - refx - wx ; c0 = sx >> 1
00067Cr 2  A0 04                ldy #4
00067Er 2  B1 rr                lda (ptr),y
000680r 2  29 80                and #$80                    ; sext inlined: the jsr/rts was 12 cycles of the 39
000682r 2  F0 02                beq @sxp
000684r 2  A9 FF                lda #$FF
000686r 2  85 rr        @sxp:   sta tmp3
000688r 2  A5 rr                lda spx
00068Ar 2  38                   sec
00068Br 2  F1 rr                sbc (ptr),y
00068Dr 2  AA                   tax
00068Er 2  A5 rr                lda spx+1
000690r 2  E5 rr                sbc tmp3
000692r 2  A8                   tay
000693r 2  8A                   txa
000694r 2  38                   sec
000695r 2  E5 rr                sbc wx
000697r 2  85 rr                sta w16
000699r 2  98                   tya
00069Ar 2  E5 rr                sbc wx+1
00069Cr 2  C9 80                cmp #$80
00069Er 2  6A                   ror a                       ; sign into bit 7, old bit 0 out to C
00069Fr 2  66 rr                ror w16                     ; arithmetic shift right 1 -> c0 (16 bit)
0006A1r 2  C9 00                cmp #0                      ; A still holds w16+1: just restore N,Z
0006A3r 2  F0 29                beq @cpos
0006A5r 2  C9 FF                cmp #$FF
0006A7r 2  D0 49                bne @out0
0006A9r 2                       ; c0 negative (-128..-1): cstart = 0 ; visible if c0 + W > 0
0006A9r 2  A5 rr                lda w16
0006ABr 2  18                   clc
0006ACr 2  65 rr                adc sp_w
0006AEr 2  85 DF C6 DF          deca
0006B2r 2  A5 DF        
0006B4r 2  30 3C                bmi @out0
0006B6r 2  EE rr rr             inc spclip
0006B9r 2  85 rr                sta sp_c1
0006BBr 2  A9 00 85 rr          stz sp_c0
0006BFr 2                       ; first visible column index = -c0
0006BFr 2  A5 rr                lda w16
0006C1r 2  49 FF                eor #$FF
0006C3r 2  85 DF E6 DF          inca
0006C7r 2  A5 DF        
0006C9r 2  85 rr                sta sp_c                    ; starting image column
0006CBr 2  4C rr rr             bra @vert
0006CEr 2  A5 rr        @cpos:  lda w16
0006D0r 2  C9 50                cmp #ROWCHARS
0006D2r 2  B0 1E                bcs @out0                   ; not taken: C = 0 for the adc below
0006D4r 2  85 rr                sta sp_c0
0006D6r 2  65 rr                adc sp_w
0006D8r 2  85 DF C6 DF          deca
0006DCr 2  A5 DF        
0006DEr 2  C9 50                cmp #ROWCHARS
0006E0r 2  90 05                bcc :+
0006E2r 2  EE rr rr             inc spclip                  ; and at the right
0006E5r 2  A9 4F                lda #(ROWCHARS-1)
0006E7r 2  85 rr        :       sta sp_c1
0006E9r 2  48 A9 00 85          stza sp_c
0006EDr 2  rr 68        
0006EFr 2  4C rr rr             bra @vert
0006F2r 2  60           @out0:  rts
0006F3r 2               @vert:
0006F3r 2                       ; ---- vertical: sy = spy - refy - wy ; lb0 = 2*sy + wfine
0006F3r 2  A0 05                ldy #5
0006F5r 2  B1 rr                lda (ptr),y
0006F7r 2  20 rr rr             jsr sext
0006FAr 2  A5 rr                lda spy
0006FCr 2  38                   sec
0006FDr 2  F1 rr                sbc (ptr),y
0006FFr 2  AA                   tax
000700r 2  A5 rr                lda spy+1
000702r 2  E5 rr                sbc tmp3
000704r 2  A8                   tay
000705r 2                 .if .not MODELB               ; (Model B: the data's bank runs the loop, below)
000705r 2                       lda sp_dbank            ; done with the directory: the blitter wants the data
000705r 2                       sta ROMSEL_CPY
000705r 2                       sta ROMSEL
000705r 2                 .endif
000705r 2  8A                   txa
000706r 2  38                   sec
000707r 2  E5 rr                sbc wy
000709r 2  AA                   tax
00070Ar 2  98                   tya
00070Br 2  E5 rr                sbc wy+1
00070Dr 2  85 rr                sta sp_lb0+1
00070Fr 2  8A                   txa
000710r 2  0A                   asl                         ; C = old bit 7, exactly what 'asl w16' left
000711r 2  26 rr                rol sp_lb0+1
000713r 2  18                   clc
000714r 2  65 rr                adc wfine
000716r 2  85 rr                sta sp_lb0
000718r 2  90 03                bcc @nc
00071Ar 2  E6 rr                inc sp_lb0+1                ; lb0 (16 bit signed)
00071Cr 2  18                   clc                         ; only this arm arrives with C set
00071Dr 2               @nc:
00071Dr 2                       ; lend = lb0 + ext - 1
00071Dr 2  A5 rr                lda sp_ext
00071Fr 2  85 DF C6 DF          deca
000723r 2  A5 DF        
000725r 2  65 rr                adc sp_lb0
000727r 2  85 rr                sta w16
000729r 2  A5 rr                lda sp_lb0+1
00072Br 2  69 00                adc #0
00072Dr 2  85 rr                sta w16+1                   ; w16 = lb1
00072Fr 2                       ; clip lstart = max(lb0,0) ; lend = min(lb1, 247)
00072Fr 2  A5 rr                lda sp_lb0+1
000731r 2  30 0D                bmi @top
000733r 2  D0 BD                bne @out0                   ; lb0 >= 256 -> below
000735r 2  A5 rr                lda sp_lb0
000737r 2  C9 B0                cmp #BUFROWS*8
000739r 2  B0 B7                bcs @out0
00073Br 2  85 rr                sta tmp                     ; lstart
00073Dr 2  4C rr rr             bra @ck
