0002B2r 2  60                   rts
0002B3r 2  20 rr rr     :       jsr maptile
0002B6r 2                       ; alt class = LV_ALTCLS[tile id]
0002B6r 2  A8                   tay
0002B7r 2  B9 rr rr             lda LV_ALTCLS,y
0002BAr 2                       ; ALTTAB[cls*8 + (qx&7)]
0002BAr 2  0A                   asl
0002BBr 2  0A                   asl
0002BCr 2  0A                   asl
