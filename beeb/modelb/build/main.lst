000100r 2               ; ============================================================================
000100r 2               ; Main RAM, $0140-$02FF.  Everything here is visible whatever bank is paged in:
000100r 2               ; the interrupt handler, the section table it reads, the far-call thunk, and the
000100r 2               ; buffer a bank copies a strip of its data into for another bank to read.
000100r 2               ; ============================================================================
000100r 2                       .segment "LOWCODE"
000000r 2               
000000r 2               ; ---------------------------------------------------------------- far calls
000000r 2               ; X = the index of a (bank, address) entry.  The caller's bank comes back from the
000000r 2               ; stack, so a bank may call one that replaces it, and a call may nest.
000000r 2               farcall:
000000r 2  A5 F4                lda ROMSEL_CPY
000002r 2  48                   pha
000003r 2  BD rr rr             lda FARTAB+1,x
000006r 2  8D rr rr             sta @j+1
000009r 2  BD rr rr             lda FARTAB+2,x
00000Cr 2  8D rr rr             sta @j+2
00000Fr 2  BD rr rr             lda FARTAB,x
000012r 2  85 F4                sta ROMSEL_CPY
000014r 2  8D 30 FE             sta ROMSEL
000017r 2  20 FF FF     @j:     jsr $FFFF
00001Ar 2  68                   pla                         ; whatever the callee left in A is the result:
00001Br 2  85 F4                sta ROMSEL_CPY              ; the bank comes back from the stack, not from A
00001Dr 2  8D 30 FE             sta ROMSEL
000020r 2  60                   rts
000021r 2               
000021r 2               ; ---------------------------------------------------------------- map peek
000021r 2               ; The logic reads single map bytes with this: ptr/Y address the map in bank 6 and
000021r 2               ; the routine is in main RAM, so only the data is far away.  31 cycles.
000021r 2               mapbyte:
000021r 2  A9 06                lda #BANK_MAP
000023r 2  85 F4                sta ROMSEL_CPY
000025r 2  8D 30 FE             sta ROMSEL
000028r 2  B1 rr                lda (w16b),y
00002Ar 2  A2 07                ldx #BANK_LGC
00002Cr 2  86 F4                stx ROMSEL_CPY
00002Er 2  8E 30 FE             stx ROMSEL
000031r 2  60                   rts
000032r 2               
000032r 2               ; ---------------------------------------------------------------- interrupts
000032r 2               irq_handler:
000032r 2  86 rr                stx irq_x
000034r 2  84 rr                sty irq_y
000036r 2  2C 4D FE             bit VIA_IFR
000039r 2  70 03                bvs @t1arm
00003Br 2  4C rr rr             jmp @notT1
00003Er 2               @t1arm: ; A rupture step is a CRTC restart: R12/R13 were armed during the section
00003Er 2                       ; before and latch at the boundary; R9 with R4 decide where the section ends
00003Er 2                       ; and are compared at the start of its last scanline, and R6 from scanline 1
00003Er 2                       ; on.  The chain is phased so the step fires ~60 cycles BEFORE the restart,
00003Er 2                       ; and the hold below carries the first write past it.
00003Er 2  A6 rr                ldx SECIDX
000040r 2  A0 05                ldy #5
000042r 2  88           @hold:  dey
000043r 2  D0 FD                bne @hold
000045r 2  A9 09                lda #9
000047r 2  8D 00 FE             sta CRTC_IDX
00004Ar 2  BD rr rr             lda SECTAB+3,x
00004Dr 2  8D 01 FE             sta CRTC_DAT
000050r 2  A9 04                lda #4
000052r 2  8D 00 FE             sta CRTC_IDX
000055r 2  BD rr rr             lda SECTAB+2,x
000058r 2  8D 01 FE             sta CRTC_DAT
00005Br 2  A9 06                lda #6
00005Dr 2  8D 00 FE             sta CRTC_IDX
000060r 2  BD rr rr             lda SECTAB+4,x
000063r 2  8D 01 FE             sta CRTC_DAT
000066r 2  A9 07                lda #7
000068r 2  8D 00 FE             sta CRTC_IDX
00006Br 2  BD rr rr             lda SECTAB+5,x
00006Er 2  8D 01 FE             sta CRTC_DAT
000071r 2  85 rr                sta curR7
000073r 2  A9 0C                lda #12
000075r 2  8D 00 FE             sta CRTC_IDX
000078r 2  BD rr rr             lda SECTAB,x
00007Br 2  8D 01 FE             sta CRTC_DAT
00007Er 2  A9 0D                lda #13
000080r 2  8D 00 FE             sta CRTC_IDX
000083r 2  BD rr rr             lda SECTAB+1,x
000086r 2  8D 01 FE             sta CRTC_DAT
000089r 2  BD rr rr             lda SECTAB+6,x
00008Cr 2  8D 46 FE             sta VIA_T1LL
00008Fr 2  BD rr rr             lda SECTAB+7,x
000092r 2  8D 47 FE             sta VIA_T1LH
000095r 2  AD 44 FE             lda VIA_T1CL                ; clear the T1 flag
000098r 2  A5 rr                lda curR7                   ; the chain stops at Q, the only section whose R7
00009Ar 2  C9 08                cmp #QVSYNC                 ; is the vsync row: a late vsync must not walk it
00009Cr 2  F0 06                beq @stay                   ; off the end of SECTAB
00009Er 2  8A                   txa
00009Fr 2  18                   clc
0000A0r 2  69 08                adc #8
0000A2r 2  85 rr                sta SECIDX
0000A4r 2  A4 rr        @stay:  ldy irq_y
0000A6r 2  A6 rr                ldx irq_x
0000A8r 2  A5 FC                lda $FC
0000AAr 2  40                   rti
0000ABr 2               
0000ABr 2               @notT1:
0000ABr 2  AD 4D FE             lda VIA_IFR
0000AEr 2  29 02                and #$02
0000B0r 2  F0 05                beq @exit
0000B2r 2                       ; ---- vsync.  The T1 re-phase, the flip and section 0 all have the 64 lines
0000B2r 2                       ; between the vsync and the bar to happen in, so they live in bank 7 and this
0000B2r 2                       ; pays 63 cycles to reach them -- main RAM is 448 bytes and the step above is
0000B2r 2                       ; the only part of the chain that cannot afford to be anywhere else.
0000B2r 2  A2 00 20 rr          farjsr F_VSYNC
0000B6r 2  rr           
0000B7r 2               @exit:
0000B7r 2  A4 rr                ldy irq_y
0000B9r 2  A6 rr                ldx irq_x
0000BBr 2  A5 FC                lda $FC
0000BDr 2  40                   rti
0000BEr 2               
0000BEr 2                       .segment "LOWBSS"
000000r 2  xx xx xx xx  SECTAB:     .res 2*48               ; per buffer: 6 sections x 8 bytes
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000060r 2  xx xx xx xx  FARTAB:     .res 3*NFAR             ; (bank, lo, hi) per far entry point
000064r 2  xx xx xx xx  
000068r 2  xx xx xx xx  
000084r 2               
000084r 1                       .include "bank7.s"
000084r 2               ; ============================================================================
000084r 2               ; Bank 7: the game logic, the frame loop, and the chain the CRTC is driven by.
000084r 2               ; Bank 7 is the one the loader leaves paged in, so $8000 is the entry vector.
000084r 2               ; ============================================================================
000084r 2                       .segment "LGCCODE"
000000r 2  4C rr rr     entry:  jmp init
000003r 2               
000003r 2               ; ---------------------------------------------------------------- start up
000003r 2               init:
000003r 2  A2 3F                ldx #$3F                    ; the stack is 64 bytes: $0100-$013F
000005r 2  9A                   txs
000006r 2  A9 00                lda #0                      ; the OS left its own variables here; $F0-$FF is
000008r 2  A2 EF                ldx #$EF                    ; left alone ($F4 is the bank the loader selected,
00000Ar 2  95 00        :       sta $00,x                   ; and the OS IRQ still restores from it until
00000Cr 2  CA                   dex                         ; take_over)
00000Dr 2  10 FB                bpl :-
00000Fr 2                       ; the main-RAM image travels in bank 7 and is copied down to $0140
00000Fr 2  A9 rr                lda #<__LOWCODE_LOAD__
000011r 2  85 rr                sta w16
000013r 2  A9 rr                lda #>__LOWCODE_LOAD__
000015r 2  85 rr                sta w16+1
000017r 2  A9 rr                lda #<__LOWCODE_RUN__
000019r 2  85 rr                sta w16b
00001Br 2  A9 rr                lda #>__LOWCODE_RUN__
00001Dr 2  85 rr                sta w16b+1
00001Fr 2  A0 00                ldy #0
000021r 2  A2 rr                ldx #>(__LOWCODE_SIZE__ + 255)
000023r 2  B1 rr        @lc:    lda (w16),y
000025r 2  91 rr                sta (w16b),y
000027r 2  C8                   iny
000028r 2  D0 F9                bne @lc
00002Ar 2  E6 rr                inc w16+1
00002Cr 2  E6 rr                inc w16b+1
00002Er 2  CA                   dex
00002Fr 2  D0 F2                bne @lc
000031r 2  20 rr rr             jsr init_far
000034r 2  20 rr rr             jsr clear_screen
000037r 2  A9 00                lda #0
000039r 2  85 rr                sta curbuf
00003Br 2  20 rr rr             jsr select_backbuf
00003Er 2  20 rr rr             jsr draw_window
000041r 2  20 rr rr             jsr mirror_copy
000044r 2  A9 01                lda #1
000046r 2  85 rr                sta curbuf
000048r 2  20 rr rr             jsr select_backbuf
00004Br 2  20 rr rr             jsr draw_window
00004Er 2  20 rr rr             jsr mirror_copy
000051r 2  20 rr rr             jsr bar_pattern
000054r 2  A9 00                lda #0
000056r 2  85 rr                sta curbuf
000058r 2  85 rr                sta DISPSECT
00005Ar 2  85 rr                sta NEXTSECT
00005Cr 2  85 rr                sta SECIDX                  ; the chain starts at the bar; the first vsync
00005Er 2  85 rr                sta wcx                     ; re-phases everything
000060r 2  85 rr                sta wcx+1
000062r 2  85 rr                sta wcy
000064r 2  85 rr                sta wfine
000066r 2  85 rr                sta frame
000068r 2  A9 39                lda #<VS2T_DEFAULT
00006Ar 2  85 rr                sta VS2T
00006Cr 2  A9 0F                lda #>VS2T_DEFAULT
00006Er 2  85 rr                sta VS2T+1
000070r 2  20 rr rr             jsr select_backbuf
000073r 2  20 rr rr             jsr calc_ring
000076r 2  20 rr rr             jsr build_sections          ; buffer 0's chain, before anything can display it
000079r 2  20 rr rr             jsr set_palette
00007Cr 2  20 rr rr             jsr crtc_init
00007Fr 2  20 rr rr             jsr take_over
000082r 2                       ; ---------------------------------------------------------------- loop
000082r 2               frame_top:
000082r 2  E6 rr                inc frame
000084r 2                       .ifdef TESTY                ; a fixed window, so a screenshot can be checked
000084r 2  A9 2A                lda #TESTY                  ; against the geometry it is meant to show
000086r 2  85 rr                sta wcy
000088r 2  A9 30                lda #TESTX
00008Ar 2  85 rr                sta wcx
00008Cr 2  A9 00                lda #0
00008Er 2  85 rr                sta wcx+1
000090r 2  A9 00                lda #TESTF
000092r 2  85 rr                sta wfine
000094r 2                       .else
000094r 2                       lda frame                   ; walk the window: two frames a char row down,
000094r 2                       lsr                         ; and a char right every eight, which takes the
000094r 2                       sta wcy                     ; straddling row through every column
000094r 2                       lda frame
000094r 2                       lsr
000094r 2                       lsr
000094r 2                       lsr
000094r 2                       sta wcx
000094r 2                       lda #0
000094r 2                       sta wcx+1
000094r 2                       lda frame
000094r 2                       and #3
000094r 2                       asl
000094r 2                       sta wfine
000094r 2                       .endif
000094r 2  20 rr rr             jsr calc_ring
000097r 2  20 rr rr             jsr build_sections
00009Ar 2  A5 rr                lda curbuf
00009Cr 2  F0 02                beq :+
00009Er 2  A9 30                lda #48
0000A0r 2  85 rr        :       sta NEXTSECT
0000A2r 2  A9 01                lda #1
0000A4r 2  85 rr                sta flipreq
0000A6r 2  A5 rr        :       lda flipreq
0000A8r 2  D0 FC                bne :-
0000AAr 2  A5 rr                lda curbuf
0000ACr 2  49 01                eor #1
0000AEr 2  85 rr                sta curbuf
0000B0r 2  20 rr rr             jsr select_backbuf
0000B3r 2  4C rr rr             jmp frame_top
0000B6r 2               
0000B6r 2               ; ---------------------------------------------------------------- vsync
0000B6r 2               ; Reached from the interrupt handler in main RAM, 64 lines before the bar.
0000B6r 2               vsync_tick:
0000B6r 2  A5 rr                lda VS2T                    ; restart T1 first, for constant latency
0000B8r 2  8D 46 FE             sta VIA_T1LL
0000BBr 2  A5 rr                lda VS2T+1
0000BDr 2  8D 45 FE             sta VIA_T1CH
0000C0r 2  A9 02                lda #$02
0000C2r 2  8D 4D FE             sta VIA_IFR
0000C5r 2  A9 09                lda #9                      ; re-phase: end this frame curR7 + (QROWS-1-QVSYNC)
0000C7r 2  8D 00 FE             sta CRTC_IDX                ; rows from the vsync, whatever the row counter did
0000CAr 2  A9 07                lda #7
0000CCr 2  8D 01 FE             sta CRTC_DAT
0000CFr 2  A9 06                lda #6                      ; pre-arm the bar's R6 here in Q, where the display
0000D1r 2  8D 00 FE             sta CRTC_IDX                ; is off and a new R6 cannot show
0000D4r 2  A9 02                lda #BARROWS
0000D6r 2  8D 01 FE             sta CRTC_DAT
0000D9r 2  A9 04                lda #4
0000DBr 2  8D 00 FE             sta CRTC_IDX
0000DEr 2  A5 rr                lda curR7
0000E0r 2  18                   clc
0000E1r 2  69 07                adc #QROWS-1-QVSYNC
0000E3r 2  29 7F                and #$7F
0000E5r 2  8D 01 FE             sta CRTC_DAT
0000E8r 2  E6 rr                inc vsyncs
0000EAr 2  A5 rr                lda flipreq
0000ECr 2  F0 15                beq @noflip
0000EEr 2  A5 rr                lda vsyncs
0000F0r 2  38                   sec
0000F1r 2  E5 rr                sbc flipvs
0000F3r 2  C9 02                cmp #2
0000F5r 2  90 0C                bcc @noflip
0000F7r 2  A5 rr                lda vsyncs
0000F9r 2  85 rr                sta flipvs
0000FBr 2  A5 rr                lda NEXTSECT
0000FDr 2  85 rr                sta DISPSECT
0000FFr 2  A9 00 85 rr          stz flipreq
000103r 2               @noflip:
000103r 2  A2 00                ldx #0                      ; section 0 is the bar: its address and length come
000105r 2  A4 rr                ldy DISPSECT                ; from the buffer about to be displayed
000107r 2  F0 02                beq :+
000109r 2  A2 02                ldx #2
00010Br 2  B5 rr        :       lda BUF_SEC0T1,x
00010Dr 2  8D 46 FE             sta VIA_T1LL
000110r 2  B5 rr                lda BUF_SEC0T1+1,x
000112r 2  8D 47 FE             sta VIA_T1LH
000115r 2  A9 0C                lda #12
000117r 2  8D 00 FE             sta CRTC_IDX
00011Ar 2  B5 rr                lda BUF_SEC0,x
00011Cr 2  8D 01 FE             sta CRTC_DAT
00011Fr 2  A9 0D                lda #13
000121r 2  8D 00 FE             sta CRTC_IDX
000124r 2  B5 rr                lda BUF_SEC0+1,x
000126r 2  8D 01 FE             sta CRTC_DAT
000129r 2  A9 40                lda #$40
00012Br 2  8D 4D FE             sta VIA_IFR
00012Er 2  84 rr                sty SECIDX
000130r 2  60                   rts
000131r 2               
000131r 2               ; the (bank, address) table the thunk in main RAM indexes
000131r 2               init_far:
000131r 2  A2 23                ldx #3*NFAR-1
000133r 2  BD rr rr     :       lda @src,x
000136r 2  9D rr rr             sta FARTAB,x
000139r 2  CA                   dex
00013Ar 2  10 F7                bpl :-
00013Cr 2  60                   rts
00013Dr 2  07 rr rr     @src:   .byte BANK_LGC, <vsync_tick, >vsync_tick
000140r 2  07 rr rr             .byte BANK_LGC, <vsync_tick, >vsync_tick    ; F_SCANKEYS, not yet
000143r 2  07 rr rr             .byte BANK_LGC, <vsync_tick, >vsync_tick    ; F_SNDTICK, not yet
000146r 2  06 rr rr             .byte BANK_MAP, <map_strip, >map_strip
000149r 2  05 rr rr             .byte BANK_TIL, <draw_maprect, >draw_maprect
00014Cr 2  05 00 00             .byte BANK_TIL, 0, 0
00014Fr 2  05 00 00             .byte BANK_TIL, 0, 0
000152r 2  04 00 00             .byte BANK_SPR, 0, 0
000155r 2  04 00 00             .byte BANK_SPR, 0, 0
000158r 2  05 00 00             .byte BANK_TIL, 0, 0
00015Br 2  05 00 00             .byte BANK_TIL, 0, 0
00015Er 2  04 00 00             .byte BANK_SPR, 0, 0
000161r 2               
000161r 2               ; ---------------------------------------------------------------- tables
000161r 2               ; select_backbuf: point the ring tables, the fold and the CRTC base at curbuf
000161r 2               select_backbuf:
000161r 2  A5 rr                lda curbuf
000163r 2  F0 17                beq @a
000165r 2  A9 80                lda #<RING_B
000167r 2  85 rr                sta ringbase
000169r 2  A9 46                lda #>RING_B
00016Br 2  85 rr                sta ringbase+1
00016Dr 2  A9 80                lda #>RINGEND_B
00016Fr 2  85 rr                sta ringehi
000171r 2  A9 D0                lda #<CRTCB_B
000173r 2  85 rr                sta crtcb
000175r 2  A9 08                lda #>CRTCB_B
000177r 2  85 rr                sta crtcb+1
000179r 2  4C rr rr             bra @tab
00017Cr 2  A9 80        @a:     lda #<RING_A
00017Er 2  85 rr                sta ringbase
000180r 2  A9 0A                lda #>RING_A
000182r 2  85 rr                sta ringbase+1
000184r 2  A9 44                lda #>RINGEND_A
000186r 2  85 rr                sta ringehi
000188r 2  A9 50                lda #<CRTCB_A
00018Ar 2  85 rr                sta crtcb
00018Cr 2  A9 01                lda #>CRTCB_A
00018Er 2  85 rr                sta crtcb+1
000190r 2  A5 rr        @tab:   lda crtcb                   ; the mirror redirect is the same add with the ring
000192r 2  38                   sec                         ; subtracted: crtcb - RINGCHARS
000193r 2  E9 30                sbc #<RINGCHARS
000195r 2  85 rr                sta crtcbm
000197r 2  A5 rr                lda crtcb+1
000199r 2  E9 07                sbc #>RINGCHARS
00019Br 2  85 rr                sta crtcbm+1
00019Dr 2  A5 rr                lda ringbase
00019Fr 2  85 rr                sta w16
0001A1r 2  A5 rr                lda ringbase+1
0001A3r 2  85 rr                sta w16+1
0001A5r 2  A2 00                ldx #0
0001A7r 2  A5 rr        @rt:    lda w16
0001A9r 2  95 rr                sta RINGLO,x
0001ABr 2  A5 rr                lda w16+1
0001ADr 2  95 rr                sta RINGHI,x
0001AFr 2  A5 rr                lda w16
0001B1r 2  18                   clc
0001B2r 2  69 80                adc #<ROWBYTES
0001B4r 2  85 rr                sta w16
0001B6r 2  A5 rr                lda w16+1
0001B8r 2  69 02                adc #>ROWBYTES
0001BAr 2  85 rr                sta w16+1
0001BCr 2  E8                   inx
0001BDr 2  E0 17                cpx #RINGROWS
0001BFr 2  D0 E6                bne @rt
0001C1r 2  60                   rts
0001C2r 2               
0001C2r 2               ; calc_ring: ringS = ((wcy mod RINGROWS) * 80 + wcx) mod RINGCHARS ; barq = ringS / 80
0001C2r 2               calc_ring:
0001C2r 2  A6 rr                ldx wcy
0001C4r 2  BD 00 80             lda RINGMODTAB,x
0001C7r 2  AA                   tax
0001C8r 2  BD rr rr             lda mulrowlo,x
0001CBr 2  18                   clc
0001CCr 2  65 rr                adc wcx
0001CEr 2  85 rr                sta ringS
0001D0r 2  BD rr rr             lda mulrowhi,x
0001D3r 2  65 rr                adc wcx+1
0001D5r 2  85 rr                sta ringS+1
0001D7r 2  C9 07                cmp #>RINGCHARS
0001D9r 2  90 15                bcc :++
0001DBr 2  D0 06                bne :+
0001DDr 2  A5 rr                lda ringS
0001DFr 2  C9 30                cmp #<RINGCHARS
0001E1r 2  90 0D                bcc :++
0001E3r 2  A5 rr        :       lda ringS
0001E5r 2  38                   sec
0001E6r 2  E9 30                sbc #<RINGCHARS
0001E8r 2  85 rr                sta ringS
0001EAr 2  A5 rr                lda ringS+1
0001ECr 2  E9 07                sbc #>RINGCHARS
0001EEr 2  85 rr                sta ringS+1
0001F0r 2  A5 rr        :       lda ringS                   ; q = S / 80 by repeated subtraction: 23 at most
0001F2r 2  A4 rr                ldy ringS+1
0001F4r 2  A2 FF                ldx #$FF
0001F6r 2  38                   sec
0001F7r 2  E8           @div:   inx
0001F8r 2  E9 50                sbc #ROWCHARS
0001FAr 2  B0 FB                bcs @div
0001FCr 2  38                   sec
0001FDr 2  88                   dey
0001FEr 2  10 F7                bpl @div
000200r 2  86 rr                stx barq
000202r 2  60                   rts
000203r 2               
000203r 2               ; ---------------------------------------------------------------- the chain
000203r 2               ; entry i: R12n, R13n, R4, R9, R6, R7, T1lo, T1hi.  The shape is section i's; the
000203r 2               ; address and duration are section i+1's, because R12/R13 latch at the next restart
000203r 2               ; and the T1 latch takes effect one interrupt later.
000203r 2               build_sections:
000203r 2  A5 rr                lda curbuf
000205r 2  0A                   asl
000206r 2  AA                   tax
000207r 2  A9 00                lda #>BARCRTC               ; section 0 is the bar: fixed address and length
000209r 2  95 rr                sta BUF_SEC0,x
00020Br 2  A9 60                lda #<BARCRTC
00020Dr 2  95 rr                sta BUF_SEC0+1,x
00020Fr 2  A9 FE                lda #<(BARROWS*8*LINE-2)
000211r 2  95 rr                sta BUF_SEC0T1,x
000213r 2  A9 03                lda #>(BARROWS*8*LINE-2)
000215r 2  95 rr                sta BUF_SEC0T1+1,x
000217r 2  A6 rr                ldx curbuf
000219r 2  F0 02                beq :+
00021Br 2  A2 30                ldx #48
00021Dr 2  A9 01        :       lda #BARROWS-1
00021Fr 2  9D rr rr             sta SECTAB+2,x
000222r 2  A9 07                lda #7
000224r 2  9D rr rr             sta SECTAB+3,x
000227r 2  A9 02                lda #BARROWS
000229r 2  9D rr rr             sta SECTAB+4,x
00022Cr 2  A9 1E                lda #30
00022Er 2  9D rr rr             sta SECTAB+5,x
000231r 2  A5 rr                lda wfine
000233r 2  F0 6C                beq @coarse
000235r 2                       ; ---- f > 0: T -> A (the composed row) -> P.. -> P2 -> Q
000235r 2  49 07                eor #7
000237r 2  18 69 01             inca                        ; 8-f lines of it
00023Ar 2  20 rr rr             jsr @dur
00023Dr 2  9D rr rr             sta SECTAB+6,x
000240r 2  A5 rr                lda tmp3
000242r 2  9D rr rr             sta SECTAB+7,x
000245r 2  A5 rr                lda ringS                   ; the composed row is the 80 chars above the window
000247r 2  38                   sec
000248r 2  E9 50                sbc #<ROWCHARS
00024Ar 2  85 rr                sta w16
00024Cr 2  A5 rr                lda ringS+1
00024Er 2  E9 00                sbc #0
000250r 2  85 rr                sta w16+1
000252r 2  10 0D                bpl :+
000254r 2  A5 rr                lda w16
000256r 2  18                   clc
000257r 2  69 30                adc #<RINGCHARS
000259r 2  85 rr                sta w16
00025Br 2  A5 rr                lda w16+1
00025Dr 2  69 07                adc #>RINGCHARS
00025Fr 2  85 rr                sta w16+1
000261r 2  20 rr rr     :       jsr @addr
000264r 2  8A                   txa
000265r 2  18                   clc
000266r 2  69 08                adc #8
000268r 2  AA                   tax                         ; A's entry
000269r 2  A9 00 9D rr          stz SECTAB+2,x
00026Dr 2  rr           
00026Er 2  A5 rr                lda wfine
000270r 2  49 07                eor #7                      ; 7 - f
000272r 2  9D rr rr             sta SECTAB+3,x
000275r 2  A9 02                lda #2
000277r 2  9D rr rr             sta SECTAB+4,x
00027Ar 2  A9 1E                lda #30
00027Cr 2  9D rr rr             sta SECTAB+5,x
00027Fr 2  A5 rr                lda ringS                   ; the run starts one row into the window
000281r 2  18                   clc
000282r 2  69 50                adc #<ROWCHARS
000284r 2  85 rr                sta w16
000286r 2  A5 rr                lda ringS+1
000288r 2  69 00                adc #0
00028Ar 2  85 rr                sta w16+1
00028Cr 2  20 rr rr             jsr @wrap
00028Fr 2  A9 14                lda #VISROWS-1
000291r 2  85 rr                sta tmp4                    ; rows in the run
000293r 2  A4 rr                ldy barq
000295r 2  C8                   iny
000296r 2  C0 17                cpy #RINGROWS
000298r 2  90 02                bcc :+
00029Ar 2  A0 00                ldy #0
00029Cr 2  84 rr        :       sty tmp3
00029Er 2  4C rr rr             bra @run
0002A1r 2               @coarse:                            ; ---- f = 0: T -> P.. -> Q
0002A1r 2  A5 rr                lda ringS
0002A3r 2  85 rr                sta w16
0002A5r 2  A5 rr                lda ringS+1
0002A7r 2  85 rr                sta w16+1
0002A9r 2  A9 15                lda #VISROWS
0002ABr 2  85 rr                sta tmp4
0002ADr 2  A5 rr                lda barq
0002AFr 2  85 rr                sta tmp3
0002B1r 2               @run:   ; w16 = the run's ring offset, tmp4 = its rows, X = the entry before it
0002B1r 2  20 rr rr             jsr @nfull                  ; rows that end before the ring end
0002B4r 2  C5 rr                cmp tmp4
0002B6r 2  B0 15                bcs @one                    ; the whole run fits
0002B8r 2  C9 00                cmp #0
0002BAr 2  F0 11                beq @one                    ; it starts inside the straddling row: all of it folds
0002BCr 2  85 rr                sta tmp2
0002BEr 2  20 rr rr             jsr @emit                   ; up to the ring end
0002C1r 2  A5 rr                lda tmp2
0002C3r 2  20 rr rr             jsr @advance
0002C6r 2  A5 rr                lda tmp4
0002C8r 2  38                   sec
0002C9r 2  E5 rr                sbc tmp2
0002CBr 2  85 rr                sta tmp4
0002CDr 2  A5 rr        @one:   lda tmp4
0002CFr 2  85 rr                sta tmp2
0002D1r 2  20 rr rr             jsr @emit
0002D4r 2  A5 rr                lda tmp4
0002D6r 2  20 rr rr             jsr @advance                ; now the row below the playfield
0002D9r 2  A5 rr                lda wfine
0002DBr 2  F0 3D                beq @setq
0002DDr 2                       ; --- P2: the top f lines of that row
0002DDr 2  20 rr rr             jsr @addr
0002E0r 2  A5 rr                lda wfine
0002E2r 2  20 rr rr             jsr @dur
0002E5r 2  9D rr rr             sta SECTAB+6,x
0002E8r 2  A5 rr                lda tmp3
0002EAr 2  9D rr rr             sta SECTAB+7,x
0002EDr 2  8A                   txa
0002EEr 2  18                   clc
0002EFr 2  69 08                adc #8
0002F1r 2  AA                   tax
0002F2r 2  48 A9 00 9D          stza SECTAB+2, x
0002F6r 2  rr rr 68     
0002F9r 2  A5 rr                lda wfine
0002FBr 2  38 E9 01             deca
0002FEr 2  9D rr rr             sta SECTAB+3,x
000301r 2  A9 15                lda #VISROWS
000303r 2  9D rr rr             sta SECTAB+4,x
000306r 2  A9 1E                lda #30
000308r 2  9D rr rr             sta SECTAB+5,x
00030Br 2  BD rr rr             lda SECTAB-8,x              ; w16 has not moved: the address the P2 @addr left
00030Er 2  9D rr rr             sta SECTAB,x                ; in the previous entry is this one's too
000311r 2  BD rr rr             lda SECTAB-8+1,x
000314r 2  9D rr rr             sta SECTAB+1,x
000317r 2  4C rr rr             bra @sq2
00031Ar 2  20 rr rr     @setq:  jsr @addr                   ; Q starts on the row below the playfield
00031Dr 2  A9 FE        @sq2:   lda #<(40*LINE-2)
00031Fr 2  9D rr rr             sta SECTAB+6,x
000322r 2  A9 09                lda #>(40*LINE-2)
000324r 2  9D rr rr             sta SECTAB+7,x
000327r 2  8A                   txa
000328r 2  18                   clc
000329r 2  69 08                adc #8
00032Br 2  AA                   tax
00032Cr 2  A9 00                lda #>BARCRTC               ; and hands the chain back to the bar
00032Er 2  9D rr rr             sta SECTAB,x
000331r 2  A9 60                lda #<BARCRTC
000333r 2  9D rr rr             sta SECTAB+1,x
000336r 2  A9 0F                lda #QROWS-1
000338r 2  9D rr rr             sta SECTAB+2,x
00033Br 2  A9 07                lda #7
00033Dr 2  9D rr rr             sta SECTAB+3,x
000340r 2  48 A9 00 9D          stza SECTAB+4, x
000344r 2  rr rr 68     
000347r 2  A9 08                lda #QVSYNC
000349r 2  9D rr rr             sta SECTAB+5, x
00034Cr 2  A9 FE                lda #<(40*LINE-2)
00034Er 2  9D rr rr             sta SECTAB+6, x
000351r 2  A9 09                lda #>(40*LINE-2)
000353r 2  9D rr rr             sta SECTAB+7, x
000356r 2  60                   rts
000357r 2               ; --- emit a run of tmp2 rows starting at ring offset w16, following entry X
000357r 2  20 rr rr     @emit:  jsr @addr
00035Ar 2  A5 rr                lda tmp2
00035Cr 2  20 rr rr             jsr @lines
00035Fr 2  9D rr rr             sta SECTAB+6,x
000362r 2  A5 rr                lda tmp3
000364r 2  9D rr rr             sta SECTAB+7,x
000367r 2  8A                   txa
000368r 2  18                   clc
000369r 2  69 08                adc #8
00036Br 2  AA                   tax
00036Cr 2  A5 rr                lda tmp2
00036Er 2  38 E9 01             deca
000371r 2  9D rr rr             sta SECTAB+2,x
000374r 2  A9 07                lda #7
000376r 2  9D rr rr             sta SECTAB+3,x
000379r 2  A9 1E                lda #30
00037Br 2  9D rr rr             sta SECTAB+4,x
00037Er 2  9D rr rr             sta SECTAB+5,x
000381r 2  60                   rts
000382r 2               ; --- SECTAB+0/1,x = the CRTC address of the row at ring offset w16.  A row starting
000382r 2               ; past RINGCHARS-80 straddles the ring end and is read from the mirror below the base,
000382r 2               ; which is exactly the address w16 - RINGCHARS names.
000382r 2  A5 rr        @addr:  lda w16
000384r 2  A4 rr                ldy w16+1
000386r 2  C0 06                cpy #>(RINGCHARS-ROWCHARS+1)
000388r 2  90 13                bcc :++
00038Ar 2  D0 04                bne :+
00038Cr 2  C9 E1                cmp #<(RINGCHARS-ROWCHARS+1)
00038Er 2  90 0D                bcc :++
000390r 2  18           :       clc
000391r 2  65 rr                adc crtcbm
000393r 2  9D rr rr             sta SECTAB+1,x
000396r 2  98                   tya
000397r 2  65 rr                adc crtcbm+1
000399r 2  9D rr rr             sta SECTAB,x
00039Cr 2  60                   rts
00039Dr 2  18           :       clc
00039Er 2  65 rr                adc crtcb
0003A0r 2  9D rr rr             sta SECTAB+1,x
0003A3r 2  98                   tya
0003A4r 2  65 rr                adc crtcb+1
0003A6r 2  9D rr rr             sta SECTAB,x
0003A9r 2  60                   rts
0003AAr 2                       ; --- A = rows -> A/tmp3 = that many rows of lines, as a T1 count
0003AAr 2  0A           @lines: asl
0003ABr 2  0A                   asl
0003ACr 2  0A                   asl
0003ADr 2  4C rr rr             jmp @dur
0003B0r 2                       ; --- A = rows: advance w16 by that many rows, folding into 0..RINGCHARS
0003B0r 2               @advance:
0003B0r 2  A8                   tay
0003B1r 2  18                   clc
0003B2r 2  A5 rr                lda w16
0003B4r 2  79 rr rr             adc mulrowlo,y
0003B7r 2  85 rr                sta w16
0003B9r 2  A5 rr                lda w16+1
0003BBr 2  79 rr rr             adc mulrowhi,y
0003BEr 2  85 rr                sta w16+1
0003C0r 2  A5 rr        @wrap:  lda w16+1
0003C2r 2  C9 07                cmp #>RINGCHARS
0003C4r 2  90 15                bcc :++
0003C6r 2  D0 06                bne :+
0003C8r 2  A5 rr                lda w16
0003CAr 2  C9 30                cmp #<RINGCHARS
0003CCr 2  90 0D                bcc :++
0003CEr 2  A5 rr        :       lda w16
0003D0r 2  38                   sec
0003D1r 2  E9 30                sbc #<RINGCHARS
0003D3r 2  85 rr                sta w16
0003D5r 2  A5 rr                lda w16+1
0003D7r 2  E9 07                sbc #>RINGCHARS
0003D9r 2  85 rr                sta w16+1
0003DBr 2  60           :       rts
0003DCr 2                       ; --- rows of the run that finish before the ring end.  The run starts on ring
0003DCr 2                       ; row tmp3; when r = ringS mod 80 is non-zero the last ring row straddles and
0003DCr 2                       ; @addr sends it to the mirror, so RINGROWS-1-tmp3 rows come first.
0003DCr 2  A4 rr        @nfull: ldy barq
0003DEr 2  A5 rr                lda ringS
0003E0r 2  38                   sec
0003E1r 2  F9 rr rr             sbc mulrowlo,y              ; r
0003E4r 2  C9 01                cmp #1                      ; C = 1 iff r > 0
0003E6r 2  A9 16                lda #RINGROWS-1
0003E8r 2  B0 04                bcs :+
0003EAr 2  69 00                adc #0                      ; r == 0: C is clear here, so this adds 1
0003ECr 2  69 01                adc #1
0003EEr 2  38           :       sec
0003EFr 2  E5 rr                sbc tmp3
0003F1r 2  60                   rts
0003F2r 2                       ; --- A = lines -> A/tmp3 = the T1 count that lasts that long
0003F2r 2  85 rr        @dur:   sta tmp3                    ; n*64 == (n*256)>>2
0003F4r 2  A9 00                lda #0
0003F6r 2  46 rr                lsr tmp3
0003F8r 2  6A                   ror
0003F9r 2  46 rr                lsr tmp3
0003FBr 2  6A                   ror
0003FCr 2  E9 01                sbc #1                      ; C = 0 out of the ror pair: A - 2
0003FEr 2  B0 02                bcs :+
000400r 2  C6 rr                dec tmp3
000402r 2  60           :       rts
000403r 2               
000403r 2               ; ---------------------------------------------------------------- display
000403r 2               set_palette:                        ; MODE 1: logical 0..3 = black, cyan, magenta, yellow
000403r 2  A2 0F                ldx #15                     ; a pixel's two bits land in index bits 3 and 1
000405r 2  8A           :       txa
000406r 2  29 08                and #8
000408r 2  4A                   lsr
000409r 2  4A                   lsr
00040Ar 2  85 rr                sta tmp
00040Cr 2  8A                   txa
00040Dr 2  29 02                and #2
00040Fr 2  4A                   lsr
000410r 2  05 rr                ora tmp
000412r 2  A8                   tay
000413r 2  B9 rr rr             lda @cmyk,y
000416r 2  85 rr                sta tmp
000418r 2  8A                   txa
000419r 2  0A                   asl
00041Ar 2  0A                   asl
00041Br 2  0A                   asl
00041Cr 2  0A                   asl
00041Dr 2  05 rr                ora tmp
00041Fr 2  8D 21 FE             sta ULA_PAL
000422r 2  CA                   dex
000423r 2  10 E0                bpl :-
000425r 2  60                   rts
000426r 2  07 01 02 04  @cmyk:  .byte 0^7, 6^7, 5^7, 3^7    ; physical black, cyan, magenta, yellow, inverted
00042Ar 2               
00042Ar 2               crtc_init:                          ; start the chain at the bar and let vsync re-phase
00042Ar 2  A2 09                ldx #9
00042Cr 2  A9 07                lda #7
00042Er 2  20 rr rr             jsr @w
000431r 2  A2 04                ldx #4
000433r 2  A9 01                lda #BARROWS-1
000435r 2  20 rr rr             jsr @w
000438r 2  A2 06                ldx #6
00043Ar 2  A9 02                lda #BARROWS
00043Cr 2  20 rr rr             jsr @w
00043Fr 2  A2 07                ldx #7
000441r 2  A9 1E                lda #30
000443r 2  20 rr rr             jsr @w
000446r 2  A2 0C                ldx #12
000448r 2  A9 00                lda #>BARCRTC
00044Ar 2  20 rr rr             jsr @w
00044Dr 2  A2 0D                ldx #13
00044Fr 2  A9 60                lda #<BARCRTC
000451r 2  8E 00 FE     @w:     stx CRTC_IDX
000454r 2  8D 01 FE             sta CRTC_DAT
000457r 2  60                   rts
000458r 2               
000458r 2               take_over:
000458r 2  78                   sei
000459r 2  A9 rr                lda #<irq_handler
00045Br 2  8D 04 02             sta IRQ1V
00045Er 2  A9 rr                lda #>irq_handler
000460r 2  8D 05 02             sta IRQ1V+1
000463r 2  A9 7F                lda #$7F
000465r 2  8D 4E FE             sta VIA_IER
000468r 2  8D 6E FE             sta UVIA_IER
00046Br 2  AD 4B FE             lda VIA_ACR
00046Er 2  29 3F                and #$3F
000470r 2  09 40                ora #$40                    ; T1 continuous
000472r 2  8D 4B FE             sta VIA_ACR
000475r 2  A9 00                lda #<(40*LINE)
000477r 2  8D 46 FE             sta VIA_T1LL
00047Ar 2  A9 0A                lda #>(40*LINE)
00047Cr 2  8D 45 FE             sta VIA_T1CH
00047Fr 2  A9 C2                lda #$C2                    ; CA1 (vsync) + T1
000481r 2  8D 4E FE             sta VIA_IER
000484r 2  A9 7F                lda #$7F
000486r 2  8D 4D FE             sta VIA_IFR
000489r 2  A9 1E                lda #30                     ; the chain stops when curR7 is Q's; start it at a
00048Br 2  85 rr                sta curR7                   ; value that is not
00048Dr 2  A9 00 85 rr          stz flipreq
000491r 2  A9 00 85 rr          stz vsyncs
000495r 2  A9 00 85 rr          stz flipvs
000499r 2  58                   cli
00049Ar 2  60                   rts
00049Br 2               
00049Br 2               ; ---------------------------------------------------------------- scaffolding
00049Br 2               clear_screen:                       ; $0300-$7FFF: the bar, both mirrors and both rings
00049Br 2  A9 00                lda #0
00049Dr 2  85 rr                sta w16
00049Fr 2  A9 03                lda #>BARADDR
0004A1r 2  85 rr                sta w16+1
0004A3r 2  A0 00                ldy #0
0004A5r 2  A2 7D                ldx #$7D                    ; pages $03..$7F
0004A7r 2  91 rr        :       sta (w16),y
0004A9r 2  C8                   iny
0004AAr 2  D0 FB                bne :-
0004ACr 2  E6 rr                inc w16+1
0004AEr 2  CA                   dex
0004AFr 2  D0 F6                bne :-
0004B1r 2  60                   rts
0004B2r 2               
0004B2r 2               ; the whole window: 20 tiles across, 11 tile rows (22 char rows)
0004B2r 2               draw_window:
0004B2r 2  A5 rr                lda wcx                     ; a tile is four chars and two char rows
0004B4r 2  4A                   lsr
0004B5r 2  4A                   lsr
0004B6r 2  85 rr                sta dt_tx
0004B8r 2  A5 rr                lda wcy
0004BAr 2  4A                   lsr
0004BBr 2  85 rr                sta dt_ty
0004BDr 2  A9 14                lda #20
0004BFr 2  85 rr                sta dt_nx
0004C1r 2  A9 0B                lda #11
0004C3r 2  85 rr                sta dt_ny
0004C5r 2  A2 0C 20 rr          farjsr F_DRAWRECT
0004C9r 2  rr           
0004CAr 2  60                   rts
0004CBr 2               
0004CBr 2               ; A pattern that makes the geometry readable: each ring row is a band of one colour
0004CBr 2               ; with its slot number written as a run of black chars at the left, so the order of
0004CBr 2               ; the rows on screen, the wrap and the mirror can all be counted off.
0004CBr 2               test_pattern:
0004CBr 2  A2 00                ldx #0                      ; slot
0004CDr 2  86 rr        @slot:  stx tmp2
0004CFr 2  8A                   txa
0004D0r 2  18                   clc
0004D1r 2  69 01                adc #1
0004D3r 2  85 rr                sta tmp                     ; colour 1..3 by slot
0004D5r 2  C9 04        @c1:    cmp #4
0004D7r 2  90 05                bcc :+
0004D9r 2  E9 03                sbc #3
0004DBr 2  4C rr rr             bra @c1
0004DEr 2  A8           :       tay
0004DFr 2  B9 rr rr             lda @cols,y
0004E2r 2  85 rr                sta tmp3                    ; the band's byte
0004E4r 2  A6 rr                ldx tmp2
0004E6r 2  B5 rr                lda RINGLO,x
0004E8r 2  85 rr                sta w16
0004EAr 2  B5 rr                lda RINGHI,x
0004ECr 2  85 rr                sta w16+1
0004EEr 2  A0 00                ldy #0
0004F0r 2  A9 00                lda #0
0004F2r 2  85 rr                sta cnt                     ; char within the row
0004F4r 2  A5 rr        @char:  lda cnt
0004F6r 2  C5 rr                cmp tmp2                    ; the first (slot+1) chars are black
0004F8r 2  90 07                bcc @black
0004FAr 2  F0 05                beq @black
0004FCr 2  A5 rr                lda tmp3
0004FEr 2  4C rr rr             bra @put
000501r 2  A9 00        @black: lda #0
000503r 2  A2 08        @put:   ldx #8
000505r 2  91 rr        @st:    sta (w16),y
000507r 2  C8                   iny
000508r 2  D0 02                bne :+
00050Ar 2  E6 rr                inc w16+1
00050Cr 2  CA           :       dex
00050Dr 2  D0 F6                bne @st
00050Fr 2  E6 rr                inc cnt
000511r 2  A5 rr                lda cnt
000513r 2  C9 50                cmp #ROWCHARS
000515r 2  D0 DD                bne @char
000517r 2  A6 rr                ldx tmp2
000519r 2  E8                   inx
00051Ar 2  E0 17                cpx #RINGROWS
00051Cr 2  D0 AF                bne @slot
00051Er 2  60                   rts
00051Fr 2  00 0F F0 FF  @cols:  .byte $00, $0F, $F0, $FF
000523r 2               
000523r 2               bar_pattern:                        ; yellow with a black tick every eight chars
000523r 2  A9 00                lda #<BARADDR
000525r 2  85 rr                sta w16
000527r 2  A9 03                lda #>BARADDR
000529r 2  85 rr                sta w16+1
00052Br 2  A0 00                ldy #0
00052Dr 2  A2 00                ldx #0
00052Fr 2  98           @b:     tya
000530r 2  29 38                and #$38
000532r 2  C9 38                cmp #$38
000534r 2  D0 05                bne :+
000536r 2  A9 00                lda #0
000538r 2  4C rr rr             bra :++
00053Br 2  A9 FF        :       lda #$FF
00053Dr 2  91 rr        :       sta (w16),y
00053Fr 2  C8                   iny
000540r 2  D0 ED                bne @b
000542r 2  E6 rr                inc w16+1
000544r 2  E8                   inx
000545r 2  E0 05                cpx #5
000547r 2  D0 E6                bne @b
000549r 2  60                   rts
00054Ar 2               
00054Ar 2               ; the mirror is a copy of the ring's last row, so a straddling row reads as one run
00054Ar 2               mirror_copy:
00054Ar 2  A2 16                ldx #RINGROWS-1
00054Cr 2  B5 rr                lda RINGLO,x
00054Er 2  85 rr                sta w16
000550r 2  B5 rr                lda RINGHI,x
000552r 2  85 rr                sta w16+1
000554r 2  A5 rr                lda ringbase
000556r 2  38                   sec
000557r 2  E9 80                sbc #<ROWBYTES
000559r 2  85 rr                sta w16b
00055Br 2  A5 rr                lda ringbase+1
00055Dr 2  E9 02                sbc #>ROWBYTES
00055Fr 2  85 rr                sta w16b+1
000561r 2  A0 00                ldy #0
000563r 2  A2 02                ldx #>ROWBYTES
000565r 2  B1 rr        :       lda (w16),y
000567r 2  91 rr                sta (w16b),y
000569r 2  C8                   iny
00056Ar 2  D0 F9                bne :-
00056Cr 2  E6 rr                inc w16+1
00056Er 2  E6 rr                inc w16b+1
000570r 2  CA                   dex
000571r 2  D0 F2                bne :-
000573r 2  A2 80                ldx #<ROWBYTES              ; the odd half page
000575r 2  B1 rr        :       lda (w16),y
000577r 2  91 rr                sta (w16b),y
000579r 2  C8                   iny
00057Ar 2  CA                   dex
00057Br 2  D0 F8                bne :-
00057Dr 2  60                   rts
00057Er 2               
00057Er 2                       .include "tables.inc"
00057Er 3  00 50 A0 F0  mulrowlo:   .repeat RINGROWS+1, i
000582r 3  40 90 E0 30  
000586r 3  80 D0 20 70  
000596r 3                           .byte <(i*ROWCHARS)
000596r 3                           .endrepeat
000596r 3  00 00 00 00  mulrowhi:   .repeat RINGROWS+1, i
00059Ar 3  01 01 01 02  
00059Er 3  02 02 03 03  
0005AEr 3                           .byte >(i*ROWCHARS)
0005AEr 3                           .endrepeat
0005AEr 3               
0005AEr 2               
0005AEr 2                       .segment "LGCBSS"
000000r 2               
000000r 1                       .include "bank6.s"
000000r 2               ; ============================================================================
000000r 2               ; Bank 6: the map, the level's tables, and the routines that read them.  The
000000r 2               ; tile blitter and the logic live in other banks, so what leaves here goes
000000r 2               ; through a strip copy into MAPBUF in main RAM, or one byte through mapbyte.
000000r 2               ; ============================================================================
000000r 2                       .segment "MAPCODE"
000000r 2               ; map_strip: copy cnt map bytes from tile (tmp, tmp2) into MAPBUF.
000000r 2               map_strip:
000000r 2  A5 rr                lda tmp2
000002r 2  A2 05                ldx #MAPLW                  ; * the map's stride
000004r 2  A9 00 85 rr          stz w16+1
000008r 2  0A           @sh:    asl
000009r 2  26 rr                rol w16+1
00000Br 2  CA                   dex
00000Cr 2  D0 FA                bne @sh
00000Er 2  18                   clc
00000Fr 2  65 rr                adc tmp
000011r 2  85 rr                sta w16
000013r 2  A5 rr                lda w16+1
000015r 2  69 00                adc #0
000017r 2  18                   clc
000018r 2  69 rr                adc #>LV_MAP
00001Ar 2  85 rr                sta w16+1
00001Cr 2  A5 rr                lda w16
00001Er 2  18                   clc
00001Fr 2  69 rr                adc #<LV_MAP
000021r 2  85 rr                sta w16
000023r 2  90 02                bcc :+
000025r 2  E6 rr                inc w16+1
000027r 2  A0 00        :       ldy #0
000029r 2  B1 rr        @cp:    lda (w16),y
00002Br 2  99 rr rr             sta MAPBUF,y
00002Er 2  C8                   iny
00002Fr 2  C4 rr                cpy cnt
000031r 2  D0 F6                bne @cp
000033r 2  60                   rts
000034r 2               
000034r 2               ; map_col: the same, but a column: cnt bytes down from tile (tmp, tmp2)
000034r 2               map_col:
000034r 2  A5 rr                lda tmp2
000036r 2  A2 05                ldx #MAPLW
000038r 2  A9 00 85 rr          stz w16+1
00003Cr 2  0A           @sh:    asl
00003Dr 2  26 rr                rol w16+1
00003Fr 2  CA                   dex
000040r 2  D0 FA                bne @sh
000042r 2  18                   clc
000043r 2  65 rr                adc tmp
000045r 2  85 rr                sta w16
000047r 2  A5 rr                lda w16+1
000049r 2  69 00                adc #0
00004Br 2  18                   clc
00004Cr 2  69 rr                adc #>LV_MAP
00004Er 2  85 rr                sta w16+1
000050r 2  A5 rr                lda w16
000052r 2  18                   clc
000053r 2  69 rr                adc #<LV_MAP
000055r 2  85 rr                sta w16
000057r 2  90 02                bcc :+
000059r 2  E6 rr                inc w16+1
00005Br 2  A2 00        :       ldx #0
00005Dr 2  A0 00                ldy #0
00005Fr 2  B1 rr        @cp:    lda (w16),y
000061r 2  95 rr                sta MAPBUF,x
000063r 2  A5 rr                lda w16
000065r 2  18                   clc
000066r 2  69 20                adc #MAPW
000068r 2  85 rr                sta w16
00006Ar 2  90 02                bcc :+
00006Cr 2  E6 rr                inc w16+1
00006Er 2  E8           :       inx
00006Fr 2  E4 rr                cpx cnt
000071r 2  D0 EC                bne @cp
000073r 2  60                   rts
000074r 2               
000074r 2                       .segment "MAPDATA"
000000r 2                       .align 256
000000r 2               LV_HDR:
000000r 2  05 05 0D 1C          .incbin "build/level.bin"       ; header, objects, attributes, alt classes
000004r 2  16 1B 18 7F  
000008r 2  60 61 7F 7F  
000320r 2               LV_ALT:
000320r 2  80 80 80 80          .incbin "build/alt.bin"
000324r 2  80 80 80 80  
000328r 2  08 08 08 08  
000368r 2  xx xx xx xx          .align 256
00036Cr 2  xx xx xx xx  
000370r 2  xx xx xx xx  
000400r 2               LV_MAP:
000400r 2  03 03 03 03          .incbin "build/map.bin"
000404r 2  03 03 03 03  
000408r 2  03 03 03 03  
000800r 2               LV_OBJS = LV_HDR + 32
000800r 2               LV_ATTR = LV_HDR + 32 + 256
000800r 2               LV_ACLS = LV_HDR + 32 + 256 + 256
000800r 2               
000800r 1                       .include "bank5.s"
000800r 2               ; ============================================================================
000800r 2               ; Bank 5: this level's tiles and the blitter that draws them.  A tile is 8 game
000800r 2               ; pixels square: 4 chars wide and 2 char rows tall, 64 bytes, and 1840 (the ring
000800r 2               ; in chars) divides by 4, so a tile's four chars are always contiguous -- only
000800r 2               ; whole tiles can straddle the ring end, never their columns.
000800r 2               ; ============================================================================
000800r 2                       .segment "TILCODE"
000000r 2               ; draw_maprect: the tile rectangle (dt_tx, dt_ty) size (dt_nx, dt_ny), into the
000000r 2               ; ring where the window arithmetic says it goes.  A map char (cx, cy) is ring
000000r 2               ; char ((cy mod 23)*80 + cx) mod 1840, which does not depend on the window.
000000r 2               draw_maprect:
000000r 2  A5 rr        @row:   lda dt_tx                   ; one strip of map per tile row
000002r 2  85 rr                sta tmp
000004r 2  A5 rr                lda dt_ty
000006r 2  85 rr                sta tmp2
000008r 2  A5 rr                lda dt_nx
00000Ar 2  85 rr                sta cnt
00000Cr 2  A2 09 20 rr          farjsr F_MAPSTRIP
000010r 2  rr           
000011r 2  A5 rr                lda dt_ty                   ; char row = 2*ty, and its ring slot
000013r 2  0A                   asl
000014r 2  20 rr rr             jsr ring_row                ; -> dst0
000017r 2  A5 rr                lda dt_tx                   ; + 4*tx chars = 32*tx bytes, which is 16 bit
000019r 2  85 rr                sta w16                     ; from tx = 8 on
00001Br 2  A9 00 85 rr          stz w16+1
00001Fr 2  A2 05                ldx #5
000021r 2  06 rr        :       asl w16
000023r 2  26 rr                rol w16+1
000025r 2  CA                   dex
000026r 2  D0 F9                bne :-
000028r 2  A5 rr                lda dst0
00002Ar 2  18                   clc
00002Br 2  65 rr                adc w16
00002Dr 2  85 rr                sta dst0
00002Fr 2  A5 rr                lda dst0+1
000031r 2  65 rr                adc w16+1
000033r 2  85 rr                sta dst0+1
000035r 2  20 rr rr             jsr ring_next               ; dst1 = the char row below
000038r 2  A2 00                ldx #0
00003Ar 2  86 rr                stx dt_i
00003Cr 2  A6 rr        @tile:  ldx dt_i
00003Er 2  B5 rr                lda MAPBUF,x
000040r 2  20 rr rr             jsr draw_tile
000043r 2  A5 rr                lda dst0                    ; the next tile is four chars on
000045r 2  18                   clc
000046r 2  69 20                adc #32
000048r 2  85 rr                sta dst0
00004Ar 2  90 02                bcc :+
00004Cr 2  E6 rr                inc dst0+1
00004Er 2  A5 rr        :       lda dst1
000050r 2  18                   clc
000051r 2  69 20                adc #32
000053r 2  85 rr                sta dst1
000055r 2  90 02                bcc :+
000057r 2  E6 rr                inc dst1+1
000059r 2  E6 rr        :       inc dt_i
00005Br 2  A5 rr                lda dt_i
00005Dr 2  C5 rr                cmp dt_nx
00005Fr 2  D0 DB                bne @tile
000061r 2  E6 rr                inc dt_ty
000063r 2  C6 rr                dec dt_ny
000065r 2  D0 99                bne @row
000067r 2  60                   rts
000068r 2               
000068r 2               ; ring_row: A = char row -> dst0 = the address of its first char in the ring
000068r 2               ring_row:
000068r 2  AA                   tax
000069r 2  BD 00 80             lda RINGMODTAB,x            ; the slot
00006Cr 2  AA                   tax
00006Dr 2  B5 rr                lda RINGLO,x
00006Fr 2  85 rr                sta dst0
000071r 2  B5 rr                lda RINGHI,x
000073r 2  85 rr                sta dst0+1
000075r 2  60                   rts
000076r 2               
000076r 2               ; ring_next: dst1 = dst0 + one char row, folded at the ring end
000076r 2               ring_next:
000076r 2  A5 rr                lda dst0
000078r 2  18                   clc
000079r 2  69 80                adc #<ROWBYTES
00007Br 2  85 rr                sta dst1
00007Dr 2  A5 rr                lda dst0+1
00007Fr 2  69 02                adc #>ROWBYTES
000081r 2  C5 rr                cmp ringehi
000083r 2  90 0B                bcc :+
000085r 2  48                   pha                         ; past the end: - RINGBYTES, which is not a
000086r 2  A5 rr                lda dst1                    ; whole number of pages
000088r 2  38                   sec
000089r 2  E9 80                sbc #<RINGBYTES
00008Br 2  85 rr                sta dst1
00008Dr 2  68                   pla
00008Er 2  E9 39                sbc #>RINGBYTES
000090r 2  85 rr        :       sta dst1+1
000092r 2  60                   rts
000093r 2               
000093r 2               ; draw_tile: A = tile id, dst0/dst1 = where its two char rows go
000093r 2               draw_tile:
000093r 2  C9 7F                cmp #EMPTYTILE              ; nothing to draw for a hole in the map
000095r 2  F0 30                beq @done
000097r 2  48                   pha
000098r 2  4A                   lsr
000099r 2  4A                   lsr
00009Ar 2  18                   clc
00009Br 2  69 rr                adc #>TILES                 ; the tiles are page aligned: id*64 is
00009Dr 2  85 rr                sta tp+1                    ; (id >> 2) pages plus (id & 3) * 64
00009Fr 2  68                   pla
0000A0r 2  29 03                and #3
0000A2r 2  0A                   asl
0000A3r 2  0A                   asl
0000A4r 2  0A                   asl
0000A5r 2  0A                   asl
0000A6r 2  0A                   asl
0000A7r 2  0A                   asl
0000A8r 2  85 rr                sta tp
0000AAr 2  A0 1F                ldy #31
0000ACr 2  B1 rr        :       lda (tp),y
0000AEr 2  91 rr                sta (dst0),y
0000B0r 2  88                   dey
0000B1r 2  10 F9                bpl :-
0000B3r 2  A5 rr                lda tp
0000B5r 2  18                   clc
0000B6r 2  69 20                adc #32
0000B8r 2  85 rr                sta tp
0000BAr 2  90 02                bcc :+
0000BCr 2  E6 rr                inc tp+1
0000BEr 2  A0 1F        :       ldy #31
0000C0r 2  B1 rr        :       lda (tp),y
0000C2r 2  91 rr                sta (dst1),y
0000C4r 2  88                   dey
0000C5r 2  10 F9                bpl :-
0000C7r 2  60           @done:  rts
0000C8r 2               
0000C8r 2                       .segment "TILDATA"
000000r 2                       .align 256
000000r 2  00 00 00 00  TILES:  .incbin "build/tiles.bin"
000004r 2  00 00 00 00  
000008r 2  00 00 00 00  
002000r 2               
002000r 1               
002000r 1                       .segment "SPRCODE"
000000r 1  00                   .byte 0
000000r 1               
