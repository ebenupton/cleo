0010B7r 2               @lean:  ; Nothing staged.  Y is the object index throughout -- none of these handlers,
0010B7r 2                       ; nor anything they call, touches it -- so each reads and writes its own fields
0010B7r 2                       ; where they live: one cycle over a zero-page access, against seven to fetch a
0010B7r 2                       ; field and eight to put it back.  Every object field is 8-bit (tools/objaudit.py
0010B7r 2                       ; and tools/objfields.mjs are how that was established per handler).
0010B7r 2  B9 rr rr             lda O_XL,y                  ; rx/ry = object relative to the player
0010BAr 2  85 rr                sta spx                     ; spx/spy = where it draws: sta touches no flags,
0010BCr 2  38                   sec                         ; so the source byte can be banked on the way past
0010BDr 2  E5 rr                sbc px
0010BFr 2  85 B6                sta rx
0010C1r 2  B9 rr rr             lda O_XH,y
