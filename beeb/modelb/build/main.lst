000000r 1               ; ============================================================================
000000r 1               ; Cleo, Model B target: one assembly, four bank images.  The engine, the logic and
000000r 1               ; the game are the Master's sources (../src), assembled with MODELB=1 and MODE1=1;
000000r 1               ; what is this target's own is under modelb/src: the addresses (defs.inc), the low
000000r 1               ; RAM (low.s), the rupture chain (display.s), the banks' tables and data (banks.s)
000000r 1               ; and the start-up (init.s).  See DESIGN.md.
000000r 1               ; ============================================================================
000000r 1                       .include "cpu.inc"          ; -D MODELB=1 -D MODE1=1 on the command line
000000r 2               ; ============================================================================
000000r 2               ; The Master is a 65C02; the Model B (MODELB) is a 6502.  Every 65C02 spelling the
000000r 2               ; engine and the logic use goes through a macro here, so one source assembles for
000000r 2               ; both.  The 6502 expansions have side effects the 65C02 forms do not, and every
000000r 2               ; site has been audited for them with tools/flagscan.py -- the contracts:
000000r 2               ;
000000r 2               ;   stz m        A is DEAD at the site (the 6502 form is lda #0 / sta).  A site
000000r 2               ;                where A must survive spells stza.  Both leave N,Z set from the
000000r 2               ;                zero on the 6502; no site branches on the flags across either.
000000r 2               ;   stza m       A survives (pha / lda #0 / sta / pla).
000000r 2               ;   inca, deca   A +/- 1 with the CARRY PRESERVED (through mtmp), because the
000000r 2               ;                sprite prologue relies on that where the 65C02 inc a does.
000000r 2               ;   ldaz/staz/andz/cmpz  (zp) with no index: Y is DESTROYED (ldy #0).  The one
000000r 2               ;                site with Y live spells ldazy, which keeps it.
000000r 2               ;   bitimm v     bit #imm: Z from A & v, A and X preserved, through mtmp.
000000r 2               ;   jmpx t       jmp (t,x) through the zero page vector jv.
000000r 2               ;   phx/plx/phy/ply, bra: the obvious expansions (plx/ply set N,Z as the 65C02 do).
000000r 2               ;
000000r 2               ; mtmp is zero page scratch the expansions own; nothing that runs in the interrupt
000000r 2               ; may use inca/deca/bitimm/ldazy (the interrupt paths are audited free of them).
000000r 2               ; ============================================================================
000000r 2                       .ifndef MODELB
000000r 2               MODELB = 0
000000r 2                       .endif
000000r 2               
000000r 2               ; XJSR name, idx: a call that stays in main RAM on the Master and crosses a bank on
000000r 2               ; the Model B (idx names the far-table entry).
000000r 2               .macro XJSR name, idx
000000r 2                 .if MODELB
000000r 2                       farjsr idx
000000r 2                 .else
000000r 2                       jsr name
000000r 2                 .endif
000000r 2               .endmacro
000000r 2               
000000r 2               ; PLACE a, b: the segment a routine goes in -- a on the Master, b on the Model B,
000000r 2               ; whose code is split across four sideways banks by the data it reads.
000000r 2               .macro PLACE mseg, bseg
000000r 2                 .if MODELB
000000r 2                       .segment bseg
000000r 2                 .else
000000r 2                       .segment mseg
000000r 2                 .endif
000000r 2               .endmacro
000000r 2               
000000r 2                 .if .not MODELB
000000r 2                       .setcpu "65C02"
000000r 2               .macro jmpx tab
000000r 2                       jmp (tab,x)
000000r 2               .endmacro
000000r 2               .macro ldaz zp
000000r 2                       lda (zp)
000000r 2               .endmacro
000000r 2               .macro ldazy zp
000000r 2                       lda (zp)
000000r 2               .endmacro
000000r 2               .macro staz zp
000000r 2                       sta (zp)
000000r 2               .endmacro
000000r 2               .macro andz zp
000000r 2                       and (zp)
000000r 2               .endmacro
000000r 2               .macro cmpz zp
000000r 2                       cmp (zp)
000000r 2               .endmacro
000000r 2               .macro stza arg, ix                 ; on a 65C02 stz never touches A
000000r 2               .if .paramcount = 2
000000r 2                       stz arg,ix
000000r 2               .else
000000r 2                       stz arg
000000r 2               .endif
000000r 2               .endmacro
000000r 2               .macro inca
000000r 2                       inc a
000000r 2               .endmacro
000000r 2               .macro deca
000000r 2                       dec a
000000r 2               .endmacro
000000r 2               .macro bitimm v
000000r 2                       bit #v
000000r 2               .endmacro
000000r 2               
000000r 2                 .else                             ; ---------------------------------- 6502
000000r 2                       .setcpu "6502"
000000r 2               .macro stz arg, ix                  ; A dead at the site (flagscan)
000000r 2                       lda #0
000000r 2               .if .paramcount = 2
000000r 2                       sta arg,ix
000000r 2               .else
000000r 2                       sta arg
000000r 2               .endif
000000r 2               .endmacro
000000r 2               .macro stza arg, ix                 ; A live across the store
000000r 2                       pha
000000r 2                       lda #0
000000r 2               .if .paramcount = 2
000000r 2                       sta arg,ix
000000r 2               .else
000000r 2                       sta arg
000000r 2               .endif
000000r 2                       pla
000000r 2               .endmacro
000000r 2               .macro bra arg
000000r 2                       jmp arg
000000r 2               .endmacro
000000r 2               .macro inca                         ; the carry survives, as inc a's does
000000r 2                       sta mtmp
000000r 2                       inc mtmp
000000r 2                       lda mtmp
000000r 2               .endmacro
000000r 2               .macro deca
000000r 2                       sta mtmp
000000r 2                       dec mtmp
000000r 2                       lda mtmp
000000r 2               .endmacro
000000r 2               .macro phx
000000r 2                       txa
000000r 2                       pha
000000r 2               .endmacro
000000r 2               .macro plx
000000r 2                       pla
000000r 2                       tax
000000r 2               .endmacro
000000r 2               .macro phy
000000r 2                       tya
000000r 2                       pha
000000r 2               .endmacro
000000r 2               .macro ply
000000r 2                       pla
000000r 2                       tay
000000r 2               .endmacro
000000r 2               .macro jmpx tab                     ; jmp (abs,x): through a zero page vector
000000r 2                       pha
000000r 2                       lda tab,x
000000r 2                       sta jv
000000r 2                       lda tab+1,x
000000r 2                       sta jv+1
000000r 2                       pla
000000r 2                       jmp (jv)
000000r 2               .endmacro
000000r 2               .macro ldaz zp                      ; (zp) with no index: Y is free at the site
000000r 2                       ldy #0
000000r 2                       lda (zp),y
000000r 2               .endmacro
000000r 2               .macro ldazy zp                     ; and the form for the site where it is not
000000r 2                       sty mtmp
000000r 2                       ldy #0
000000r 2                       lda (zp),y
000000r 2                       ldy mtmp
000000r 2                       ora #0                      ; N,Z from A, as the load left them
000000r 2               .endmacro
000000r 2               .macro staz zp
000000r 2                       ldy #0
000000r 2                       sta (zp),y
000000r 2               .endmacro
000000r 2               .macro andz zp
000000r 2                       ldy #0
000000r 2                       and (zp),y
000000r 2               .endmacro
000000r 2               .macro cmpz zp
000000r 2                       ldy #0
000000r 2                       cmp (zp),y
000000r 2               .endmacro
000000r 2               .macro bitimm v                     ; Z = (A & v) = 0, A kept
000000r 2                       sta mtmp
000000r 2                       and #v
000000r 2                       php
000000r 2                       lda mtmp
000000r 2                       plp
000000r 2               .endmacro
000000r 2               
000000r 2               ; A far call: X = the index of a (bank, address-1) entry in FARTAB, which every
000000r 2               ; bank carries a copy of at the same address.  A goes in and comes back; Y is
000000r 2               ; untouched; X is destroyed.  farcall itself is in main RAM (modelb/src/low.s).
000000r 2               .macro farjsr idx
000000r 2                       ldx #idx
000000r 2                       jsr farcall
000000r 2               .endmacro
000000r 2                 .endif
000000r 2               
000000r 1                       .include "defs.inc"
000000r 2               ; ============================================================================
000000r 2               ; Cleo, Model B target: what differs from the Master is addresses -- this file --
000000r 2               ; and the 65C02 spellings (src/cpu.inc).  The engine, the logic and the game loop
000000r 2               ; are ../src/engine.s, logic.s and game.s, assembled with MODELB=1.
000000r 2               ;
000000r 2               ; Main RAM is the display: $0300-$7FFF is the bar, two mirrors and two 23-slot rings
000000r 2               ; (engine.s, screen shape).  What is left is zero page and $0100-$02FF: the stack, the
000000r 2               ; far-call thunk, the interrupt stub, the map helpers and the sprite list.  The code
000000r 2               ; lives in four sideways banks, each with the data its inner loops read:
000000r 2               ;   4  most of the sprite images and masks, the mask tables, the sprite row loop
000000r 2               ;   5  the tiles, the tile blitter, the sprite prologue and directory, the records
000000r 2               ;   6  the map, and the rest of the sprites with their own copy of the row loop
000000r 2               ;      (the Master's directory flag $10 names bank 6 too)
000000r 2               ;   7  the logic, the game loop, the level's tables, the display driver, the
000000r 2               ;      interrupt's work, the sound and the music, the HUD
000000r 2               ; ============================================================================
000000r 2               LEVEL_IDX = 2                       ; the level on the disc: index 2 is L1B, the main
000000r 2                                                   ; level of world 1 (see game.s: file = FI_L0A+(i^1)*2)
000000r 2               VSPEG     = 3                       ; vsyncs a rendered frame, as the Master: the median
000000r 2                                                   ; frame is 70k cycles, the 90th percentile 111k
000000r 2               MAPSTRIDE = 1 << MAPLW              ; bytes per map row: a constant here, so the row
000000r 2                                                   ; tables are arithmetic (maprow, maprow5)
000000r 2               
000000r 2               FARTAB    = $8000                   ; every bank carries the same far table here,
000000r 2               sprmul5   = $8030                   ; and these small tables (banks.s COMMON_TABLES)
000000r 2               mulrowlo  = $8050
000000r 2               mulrowhi  = $8068
000000r 2               ringmodtab = $8080
000000r 2               SWAPTAB   = $8300                   ; static, in both sprite data banks: dot reversal
000000r 2               MASKTAB0  = $8400                   ; and the four mask-phase pages (1K aligned)
000000r 2               MASKTAB1  = MASKTAB0 + $100
000000r 2               MASKTAB2  = MASKTAB0 + $200
000000r 2               MASKTAB3  = MASKTAB0 + $300
000000r 2               BANKCODE  = $8100                   ; bank 7's entry vector, where the loader jumps
000000r 2               
000000r 2               ; ---------------------------------------------------------------- zero page
000000r 2               ; The Master's zero page: engine.s's .zeropage ends at $A1, the logic's temps are
000000r 2               ; $A8-$DE.  These fill the gaps.  $F4 is the MOS's ROMSEL copy: nothing past $EF.
000000r 2               NSPR     = $A2                      ; (main RAM tables on the Master: low RAM is short)
000000r 2               BARDIRTY = $A3
000000r 2               BARBG    = $A4
000000r 2               SFXREQ   = $A5
000000r 2               mtmp     = $DF                      ; cpu.inc's scratch (inca/deca/bitimm/ldazy)
000000r 2               ringbhi  = $E0                      ; the buffer being drawn: ring base high byte,
000000r 2               ringehi  = $E1                      ;   ring end high byte (ringup's fold test),
000000r 2               ringe3   = $E2                      ;   >RINGEND-3 and 256->RINGEND (drawrect's wrap test)
000000r 2               ringneg  = $E3
000000r 2               mrow     = $E4                      ; the map char row in the ring's last slot (calc_ring)
000000r 2               wcxm     = $E5                      ; ringS mod 80: the mirror's first useful char
000000r 2               rstar    = $E6                      ; the window row that lives in the last slot
000000r 2               sp_disp  = $E7                      ; the sprite's blitter index, for the loop's bank
000000r 2               sp_mpg0  = $E8                      ; (the Master keeps these four in main RAM)
000000r 2               sp_mh    = $E9
000000r 2               sp_mrp   = $EA                      ; 2
000000r 2               sp_mbase = $EC                      ; 2
000000r 2               .assert sp_mbase + 2 <= $F0, error, "zero page runs into the MOS's"
000000r 2               
000000r 2               ; ---------------------------------------------------------------- display
000000r 2               LINE      = 64                      ; T1 ticks in one scanline
000000r 2               BARCRTC   = BARADDR / 8
000000r 2               CRTCB_A   = RING_A / 8
000000r 2               CRTCB_B   = RING_B / 8
000000r 2               ; CA1 fires at the end of the 2-line vsync pulse.  -35 would put each step ~5 us INTO
000000r 2               ; its section; the further -36 puts it ~30 us BEFORE the restart, so the shape
000000r 2               ; registers land early in the section's first scanline.  The interrupt stub's bank
000000r 2               ; switch (~30 cycles) replaces the hold the Master's handler had.
000000r 2               VS2T_DEFAULT = (QROWS-QVSYNC)*8*LINE - 2*LINE - 35 - 36
000000r 2               
000000r 2               ; ---------------------------------------------------------------- far calls
000000r 2               ; The index of a (bank, address-1) entry in FARTAB (modelb/src/banks.s).  Everything
000000r 2               ; that crosses a bank boundary goes through one of these: once a frame for the
000000r 2               ; render, once a sprite for its row loop, and the rare rest.
000000r 2               F_RENDCORE  = 0*3                   ; render_frame's middle: the ring work, bank 5
000000r 2               F_SPRLOOP4  = 1*3                   ; the sprite row loop   bank 4
000000r 2               F_SPRLOOP6  = 2*3                   ;                       bank 6
000000r 2               F_MARKDIRTY = 3*3                   ; mark_dirty            bank 5 (A = tx, Y = ty)
000000r 2               F_LVRESET   = 4*3                   ; the records and dirty lists cleared, bank 5
000000r 2               F_INIT5     = 5*3                   ; bank 5's start-up
000000r 2               NFAR        = 6
000000r 2               
000000r 1                       .include "engine.s"
000000r 2               ; ============================================================================
000000r 2               ; CLEO - BBC Master 128 MODE 2 port : display engine
000000r 2               ;   - main + shadow RAM double buffered 20K ring framebuffers
000000r 2               ;   - vertical rupture: fixed status bar section + hardware scrolled playfield
000000r 2               ;     with 2-scanline fine vertical scroll, 1-character horizontal scroll
000000r 2               ;   - tiles are 8x8 game pixels = 4 chars x 2 char rows (64 bytes) in SWR
000000r 2               ; ============================================================================
000000r 2                       .include "assets.inc"
000000r 3               ; generated by modelb/tools/assets.py from L1B
000000r 3               NTILES = 167
000000r 3               MAPW = 128
000000r 3               MAPH = 64
000000r 3               MAPLW = 7
000000r 3               MAPLH = 6
000000r 3               SOLID_CYAN = 254
000000r 3               SOLID_BLACK = 255
000000r 3               BOXID0 = 103
000000r 3               BOXN = 15
000000r 3               TITLE_ADDR = $8900
000000r 3               HUD_BANK = 6
000000r 3               SPR_BAR = 0
000000r 3               SPR_DIGITS = digits_art
000000r 3               NOBJS = 126
000000r 3               SPR6_MIRROR = 0
000000r 3               SPR4_COPY = 0
000000r 3               STARTX = 29
000000r 3               STARTY = 23
000000r 3               
000000r 2               
000000r 2               ; ---------------------------------------------------------------- hardware
000000r 2               CRTC_IDX  = $FE00
000000r 2               CRTC_DAT  = $FE01
000000r 2               ULA_CTRL  = $FE20
000000r 2               ULA_PAL   = $FE21
000000r 2               ROMSEL    = $FE30
000000r 2               ACCCON    = $FE34
000000r 2               VIA_ORB   = $FE40
000000r 2               VIA_ORA   = $FE41
000000r 2               VIA_DDRB  = $FE42
000000r 2               VIA_DDRA  = $FE43
000000r 2               VIA_T1CL  = $FE44
000000r 2               VIA_T1CH  = $FE45
000000r 2               VIA_T1LL  = $FE46
000000r 2               VIA_T1LH  = $FE47
000000r 2               VIA_ACR   = $FE4B
000000r 2               VIA_PCR   = $FE4C
000000r 2               VIA_IFR   = $FE4D
000000r 2               VIA_IER   = $FE4E
000000r 2               VIA_ORANH = $FE4F
000000r 2               UVIA_IER  = $FE6E
000000r 2               
000000r 2               OSWRCH    = $FFEE
000000r 2               OSBYTE    = $FFF4
000000r 2               OSFILE    = $FFDD
000000r 2               OSCLI     = $FFF7
000000r 2               IRQ1V     = $0204
000000r 2               ROMSEL_CPY= $F4
000000r 2               
000000r 2               SCREEN    = $3000
000000r 2               BARBUF    = SPR_BAR               ; master bar image lives in bank 4 (2 char rows x 640 bytes)
000000r 2               
000000r 2               BANK_SPR  = 4
000000r 2               BANK_TIL0 = 5
000000r 2               BANK_TIL1 = 6
000000r 2               BANK_TILES= 5                     ; every level's tile data now fits one bank
000000r 2               BANK_LVL  = 7
000000r 2               BANK_MAP  = 6                     ; the map and the tables read alongside it
000000r 2               
000000r 2               ; bank 6: this level's overflow tiles, then the map and everything the renderer or
000000r 2               ; the logic reads in the same breath as the map.  It is here rather than in bank 7
000000r 2               ; because the game logic took that bank: the Model B it was written for had no
000000r 2               ; HAZEL, and the map was the only thing big enough to make the room.  A Master
000000r 2               ; does have HAZEL, so that placement is now a free choice rather than a forced
000000r 2               ; one -- moving the logic there would hand bank 7 back.
000000r 2               ;         $8000  tiles 256.. of this level (16 tiles: no level needs more)
000000r 2                 .if .not MODELB                 ; (Model B: LV_PAGE0 is a label in bank 5, with the tiles)
000000r 2               LV_PAGE0  = $8500                 ; tile id -> tile data address: 256 lo ((id&3)<<6),
000000r 2                                                 ; 256 hi ($80 | id>>2).  A map byte is a tile id, so
000000r 2                                                 ; this is the whole translation -- and it is the same
000000r 2                                                 ; for every level and both sets, so build_tileaddr
000000r 2                                                 ; writes it once instead of every level shipping one.
000000r 2               LV_MAP    = $8900                 ; up to 8K, row major
000000r 2                 .endif
000000r 2               ;         $A900  LV_MAPROWLO, LV_MAPROWHI (built by level_init, see logic.s)
000000r 2               ;         $B000  box stars, $B800 music
000000r 2               
000000r 2               ; bank 7
000000r 2                 .if .not MODELB                 ; (Model B: these are labels, placed by the linker)
000000r 2               LOGIC_ADDR= $8900                 ; the game logic and menus: bank 7, above the tables
000000r 2               LV_HDR    = $8000
000000r 2               LV_OBJS   = $8100
000000r 2               LV_ATTR0  = $8500                 ; attribute (kill/push) by tile id
000000r 2               LV_ATTR1  = $8600
000000r 2               LV_ALTCLS = $8600                 ; 256 : tile id -> alt class (the map byte is
000000r 2                                                 ; the id, so the logic indexes this directly)
000000r 2               ;         $8900..$AFFF free: the game logic lives here
000000r 2               LV_OBJST  = $B000                 ; object state arrays (16 x 149)
000000r 2               LV_GRID   = $B950                 ; 128 grid heads
000000r 2               LV_BOBJ   = $B9D0                 ; 255
000000r 2               LV_BNEXT  = $BAD0                 ; 255
000000r 2               ;         $BC00  free (was LV_ALTPAGE, built per level; the map byte is the tile id now)
000000r 2               LV_BINSTAR= $BBD0                 ; cached bin-walk lists: star object indices, then
000000r 2               LV_BINOTH = $BC00                 ;   everything else (BINMAX each)
000000r 2               LV_ALTTAB = $BE00                 ; classes x 8 (global: loaded once)
000000r 2                 .endif
000000r 2               
000000r 2               ; ---------------------------------------------------------------- screen shape
000000r 2               ; Each buffer gets its own 20K screen, main and shadow, so both are an 80-char
000000r 2               ; ring at $3000 with 27 rows visible and the status bar above.
000000r 2               ROWCHARS  = 80
000000r 2                 .if MODELB
000000r 2               ; Model B: 32K of main RAM, and all but 768 bytes of it is the display.  Two rings of
000000r 2               ; 23 slots, each with a mirror row below it (the rupture chain reads the row that
000000r 2               ; straddles the ring end from there: see modelb/DESIGN.md), and the 2-row bar:
000000r 2               ;   $0300 bar  $0800 mirror A  $0A80 ring A  $4400 mirror B  $4680 ring B  $8000
000000r 2               ; 23 x 640 is not a whole number of pages, so the fold is 16 bit -- but both ring
000000r 2               ; ENDS are page aligned, which keeps the fold TEST a byte compare (ringup).
000000r 2               RINGROWS  = 23
000000r 2               VISROWS   = 21                    ; 168 lines = 84 game px
000000r 2               BUFROWS   = VISROWS + 1
000000r 2               MAXDWY    = 8
000000r 2                 .else
000000r 2               VSPEG     = 3                     ; vsyncs a rendered frame (game.s): 16.7 Hz of render
000000r 2               RINGROWS  = 32                    ; the whole 20K: the hardware fold IS the ring wrap
000000r 2                 .ifdef VISROWSDEF
000000r 2               VISROWS   = VISROWSDEF            ; a test build: the Model B's window on the Master, so
000000r 2                 .else                           ; the two can be run in lock step (modelb/tools)
000000r 2               VISROWS   = 30                    ; visible char rows: 240 lines = 120 game px.  The
000000r 2                 .endif
000000r 2                                                 ; original is 108 (a 128-line phone screen less a
000000r 2                                                 ; 20-line HUD); the ring at $3000 has room for more.
000000r 2                                                 ; 30 fills the ring exactly: 31 held + the composed row.
000000r 2               BUFROWS   = VISROWS + 1           ; rows held: the visible ones plus the bottom partial's
000000r 2               ; The camera follows Cleo one for one, so her fall speed is also how far the window
000000r 2               ; moves in a frame.  A char row is four map pixels.  Main and shadow are separate,
000000r 2               ; so nothing in the layout forces a limit; this one is a play decision.
000000r 2               MAXDWY    = 8
000000r 2                 .endif
000000r 2               ROWBYTES  = ROWCHARS*8
000000r 2               RINGCHARS = ROWCHARS*RINGROWS
000000r 2               RINGBYTES = RINGCHARS*8
000000r 2                 .if MODELB
000000r 2               RING_A    = $0A80
000000r 2               RING_B    = $4680
000000r 2               MIRR_A    = RING_A - ROWBYTES
000000r 2               MIRR_B    = RING_B - ROWBYTES
000000r 2               RINGEND_A = RING_A + RINGBYTES
000000r 2               RINGEND_B = RING_B + RINGBYTES
000000r 2               .assert RINGEND_B = $8000 && (RINGEND_A & $FF) = 0, error, "the ring ends must be page aligned"
000000r 2               .assert (<RING_A) = $80 && (<RING_B) = $80, error, "ringup's low-byte fold assumes bases at xx80"
000000r 2               BARADDR   = $0300
000000r 2                 .else
000000r 2               BUF0      = $3000
000000r 2               .assert (RINGCHARS & $FF) = 0, error, "the ring folds on a high-byte compare"
000000r 2               ; Three rows come out of the ring so the status bar can stop chasing it:
000000r 2               ;   $3000  the row copy_partial fills with the window's top slice
000000r 2               ;   $3280  a copy of the ring's last 80 chars, immediately before the ring, so a row
000000r 2               ;          that straddles the ring end can still be read as one run
000000r 2               ;   $3500  the ring, 28 rows -- both ends page aligned, so ringup stays a byte compare
000000r 2               ;   $7B00  the bar
000000r 2               ; The ring is the entire screen and the CRTC folds it for free: an address that runs
000000r 2               ; off $8000 comes back to $3000, which is the ring base, so a displayed row may straddle
000000r 2               ; the end and no mirror copy is needed.  That is the whole reason RINGROWS is 32 -- it
000000r 2               ; is not a choice, it is the size of the region the hardware wraps.
000000r 2               RINGBASE  = BUF0
000000r 2               RINGEND   = RINGBASE + RINGBYTES
000000r 2               ; The composed top row has to be INSIDE the screen: it is per buffer, and anything below
000000r 2               ; $3000 is only main RAM to the CRTC (the bar gets away with it by being single buffered
000000r 2               ; and scanned with D = 0).  It lives in the one ring row the window does not hold: the
000000r 2               ; row ABOVE it, ring chars [ringS + BUFROWS*80, ringS + RINGCHARS) = [ringS - 80, ringS).
000000r 2               ; The window start is char granular (ringS = wcy*80 + wcx), so that row is not a slot in
000000r 2               ; the row tables: its column c is ring char (ringS + c + RINGCHARS - 80) mod RINGCHARS,
000000r 2               ; a constant offset from its source, which makes it a ring row like any other -- a
000000r 2               ; horizontal scroll leaves it valid and only the newly drawn columns need recomposing.
000000r 2               ; (It was a row-aligned slot once, partq = barq + 31, which overlapped the window's last
000000r 2               ; row by ringS mod 80 chars whenever BUFROWS was 31: that is why VISROWS sat at 29.)
000000r 2               ; 30 would need the composed row at ring char ringS + 2480 exactly -- window aligned,
000000r 2               ; not slot aligned -- and a copy that folds at $8000 mid-run.
000000r 2               ; The bar is BELOW the screen, in main RAM, and there is only one of it.  The CRTC's
000000r 2               ; start address is just RAM/8, so it can scan from anywhere under $8000 -- but with
000000r 2               ; shadow selected for display (ACCCON D = 1) everything under $3000 reads HAZEL/ANDY
000000r 2               ; instead of main RAM, so the bar's section runs with D = 0 and the playfield's with
000000r 2               ; D = the buffer being shown.  Single buffered: it is drawn where it is displayed,
000000r 2               ; inside the 40 lines between vsync and the first scanned bar line.
000000r 2               BARADDR   = $2B00
000000r 2               CRTCBASE  = RINGBASE / 8          ; the CRTC counts characters, so the ring starts here
000000r 2                 .endif
000000r 2               WINPX     = ROWCHARS*2            ; window width in pixels
000000r 2               VISLINES  = VISROWS*8
000000r 2               BINMAX    = 40                    ; cached object list: 24-32 objects a frame is the most
000000r 2                                                 ; seen across the levels, and the walk falls back to
000000r 2                                                 ; processing directly if it ever overflows
000000r 2                 .if MODELB
000000r 2               MAXREC    = 24                    ; the records are bank RAM and the list low RAM,
000000r 2               MAXSPR    = 24                    ; both short; 24 is more than a frame has been seen to queue
000000r 2                 .else
000000r 2               MAXREC    = 32
000000r 2               MAXSPR    = 32
000000r 2                 .endif
000000r 2               
000000r 2               ; key bits
000000r 2               K_LEFT  = 1
000000r 2               K_RIGHT = 2
000000r 2               K_UP    = 4
000000r 2               K_DOWN  = 8
000000r 2               K_FIRE  = 16
000000r 2               K_MENU  = 32
000000r 2               
000000r 2               ; ---------------------------------------------------------------- zero page
000000r 2                       .zeropage
000000r 2  xx xx        jv:       .res 2                  ; jmp (abs,x) has no 6502 form: it goes through here
000002r 2  xx xx        ptr:      .res 2                  ; general pointer
000004r 2  xx xx        tp:       .res 2                  ; tile/source pointer
000006r 2  xx xx        sp:       .res 2                  ; screen pointer
000008r 2  xx           tmp:      .res 1
000009r 2  xx           tmp2:     .res 1
00000Ar 2  xx           tmp3:     .res 1
00000Br 2  xx           tmp4:     .res 1
00000Cr 2  xx           cnt:      .res 1
00000Dr 2  xx xx        w16:      .res 2                  ; scratch words
00000Fr 2  xx xx        w16b:     .res 2
000011r 2               
000011r 2               ; window (map coords) for the frame being rendered
000011r 2  xx xx        wx:       .res 2                  ; window x in map px (even)
000013r 2  xx xx        wy:       .res 2                  ; window y in map px
000015r 2  xx xx        wcx:      .res 2                  ; window x in map chars (wx/2)
000017r 2  xx           wcy:      .res 1                  ; window y in map char rows (wy/4)
000018r 2  xx           wfine:    .res 1                  ; fine scanline offset 0,2,4,6
000019r 2  xx           curbuf:   .res 1                  ; buffer being drawn: 0 = main, 1 = shadow
00001Ar 2  xx           tset:     .res 1                  ; tile set in bank 5 ($FF = none yet)
00001Br 2  xx           tchar:    .res 1                  ; drawtext's place in the string
00001Cr 2  xx xx        recp:     .res 2                  ; current buffer's sprite record base
00001Er 2  xx xx        rp:       .res 2                  ; current record
000020r 2               
000020r 2               ; drawrect args
000020r 2  xx xx        rc_x:     .res 2
000022r 2  xx           rc_y:     .res 1
000023r 2  xx           rc_w:     .res 1
000024r 2  xx           rc_h:     .res 1
000025r 2  xx           rc_sub:   .res 1
000026r 2  xx           rc_gi:    .res 1
000027r 2  xx           rc_subc:  .res 1
000028r 2  xx           rowoff:   .res 1                  ; rc_sub | rc_subc*8 : byte offset into the tile for this run
000029r 2  xx           rc_n:     .res 1
00002Ar 2  xx           rc_wrap:  .res 1                  ; row may cross $8000 (needs per-run wrap check)
00002Br 2  xx           rc_tx0:   .res 1                  ; per-rect invariants: first tile column,
00002Cr 2  xx           rc_nt:    .res 1                  ;   tiles-1 per row,
00002Dr 2  xx           rc_sc0:   .res 1                  ;   rc_x & 3 (chars into the first tile),
00002Er 2  xx           rc_ro0:   .res 1                  ;   (rc_x & 3) << 3,
00002Fr 2  xx xx        rc_sp:    .res 2                  ;   screen address of the current char row's first char
000031r 2  xx           irq_x:    .res 1                  ; IRQ handler register save (not reentrant)
000032r 2  xx           irq_y:    .res 1
000033r 2               
000033r 2               ; sprite draw
000033r 2  xx xx        spx:      .res 2
000035r 2  xx xx        spy:      .res 2
000037r 2  xx xx        sp_ptr:   .res 2
000039r 2  xx           sp_w:     .res 1
00003Ar 2  xx           sp_lines: .res 1
00003Br 2  xx           sp_ext:   .res 1                  ; height in scanlines (2*lines for half-res)
00003Cr 2  xx           sp_flags: .res 1
00003Dr 2  xx           tmp4c8:   .res 1                  ; copy_partial: the column's byte offset within a row
00003Er 2  xx           sp_dbank: .res 1                  ; the bank the sprite's DATA is in: selected once the
00003Fr 2                                                 ;   prologue has finished reading the directory
00003Fr 2  xx           sp_c0:    .res 1
000040r 2  xx           sp_c1:    .res 1
000041r 2  xx xx        sp_lb0:   .res 2
000043r 2  xx           sp_r0:    .res 1
000044r 2  xx           sp_r1:    .res 1
000045r 2  xx           sp_ra0:   .res 1
000046r 2  xx           sp_ra1:   .res 1
000047r 2  xx xx        sp_col:   .res 2                  ; current column base pointer
000049r 2  xx xx        sp_rb:    .res 2                  ; screen address of the current row's first char
00004Br 2  xx xx        sp_rp:    .res 2                  ; source pointer for the current row (col base + row offset)
00004Dr 2  xx           sp_rinc:  .res 1                  ; source bytes per row: 8 (full res) or 4 (half res)
00004Er 2  xx           sp_ncol:  .res 1                  ; columns-1
00004Fr 2  xx           sp_row:   .res 1
000050r 2  xx           sp_c:     .res 1
000051r 2  xx           sp_lim:   .res 1
000052r 2  xx           sp_cnt:   .res 1                  ; sprite column countdown
000053r 2                 .if MODE1                       ; the MODE 1 mask blitter (see SPRMSK).  Zero page is
000053r 2                                                 ; full past $A5 -- the MOS's disc code scribbles on
000053r 2                                                 ; $A8-$BF during a load -- so these alias zp the blit
000053r 2                                                 ; no longer needs, and the rest sit in main RAM (mrest)
000053r 2               mptr    = w16                     ; this column group's mask bytes, one per pixel row
000053r 2               mtab    = tmp3                    ; MASKTAB page for this column's phase (tmp3 = 0, tmp4 = page)
000053r 2               sp_msk  = tmp4c8                  ; the AND mask of the pair being drawn
000053r 2               sp_id   = sp_ext                  ; the sprite id, until sp_ext is set a few lines later
000053r 2                 .endif
000053r 2  xx           spi:      .res 1
000054r 2  xx           lcnt:     .res 1
000055r 2  xx           lidx:     .res 1
000056r 2  xx xx        ringS:    .res 2                  ; window start char S (0..2559)
000058r 2  xx           barq:     .res 1                  ; row slot q = S/80
000059r 2               
000059r 2               ; level geometry
000059r 2  xx           maplw:    .res 1                  ; log2 map width in tiles
00005Ar 2  xx           maplh:    .res 1
00005Br 2  xx xx        mapw:     .res 2                  ; map width in px
00005Dr 2  xx xx        maph:     .res 2
00005Fr 2  xx xx        maxwx:    .res 2                  ; mapw - 160
000061r 2  xx xx        maxwy:    .res 2                  ; maph - 120
000063r 2               
000063r 2               ; misc
000063r 2  xx           vsyncs:   .res 1                  ; incremented by vsync ISR
000064r 2  xx           flipreq:  .res 1                  ; 1 = flip pending
000065r 2  xx           flipvs:   .res 1
000066r 2  xx           keys:     .res 1                  ; current key bits
000067r 2  xx xx        seed:     .res 2
000069r 2  xx xx        SFXPTR:   .res 2
00006Br 2  xx xx        MUSPTR:   .res 2
00006Dr 2               
00006Dr 2               ; ---------------------------------------------------------------- tables (uninitialised RAM $0400-$0CFF)
00006Dr 2                 .if .not MODELB
00006Dr 2                       .segment "TABLES"
00006Dr 2                 .if MODE1
00006Dr 2               MASKTAB0:  .res 1024              ; four contiguous pages, one per column phase (SPRMSK):
00006Dr 2                                                 ; 1K aligned, so phase = page & 3.  SWAPTAB, SECTAB and
00006Dr 2                                                 ; music_tab move to CODE to make the room.
00006Dr 2               MASKTAB1 = MASKTAB0 + $100
00006Dr 2               MASKTAB2 = MASKTAB0 + $200
00006Dr 2               MASKTAB3 = MASKTAB0 + $300
00006Dr 2                       .assert (MASKTAB0 & $3FF) = 0, error, "MASKTAB0 must be 1K aligned"
00006Dr 2                 .else
00006Dr 2               MASKTAB:   .res 256               ; data byte -> AND mask
00006Dr 2               SWAPTAB:   .res 256               ; nibble (pixel) swap for mirroring
00006Dr 2               IDENT:     .res 256               ; ora IDENT,x == ora X (no temp) -- EXCEPT at $41, $44
00006Dr 2                 .endif
00006Dr 2                                                  ; and $82, which init_tables zeroes on purpose: $41 is
00006Dr 2                                                  ; the blank-run tag and must leave the screen byte
00006Dr 2                                                  ; alone, $82 is its mirror, $44 forces a black left
00006Dr 2                                                  ; pixel.  Substituting X for IDENT,x is therefore wrong.
00006Dr 2               RINGLO:    .res RINGROWS          ; ring row r -> screen address
00006Dr 2               RINGHI:    .res RINGROWS
00006Dr 2               GATHERL:   .res 24                ; per-row tile gather: tile address lo | bank (low nibble)
00006Dr 2               GATHERH:   .res 24                ;                       tile address hi
00006Dr 2                 .if .not MODE1
00006Dr 2               SECTAB:    .res 2*48              ; per buffer: 6 sections x 8 bytes
00006Dr 2                 .endif
00006Dr 2               SPRLIST:   .res 5*MAXSPR          ; sprite draw list: id, xlo, xhi, ylo, yhi
00006Dr 2               SPRREC:    .res 2*MAXREC*10       ; per buffer drawn-sprite records: id,xl,xh,yl,yh, cxl,cxh,cy,w,h
00006Dr 2               GLYPHBUF:  .res 8                 ; one font glyph, copied out of bank 4 for the menus
00006Dr 2               RECCNT:    .res 2
00006Dr 2               KEEP:      .res MAXREC
00006Dr 2               dpass:     .res 1                 ; draw_sprites pass: 1 = box stars, 0 = the rest
00006Dr 2               spclip:    .res 1                 ; drawsprite: the last sprite came off a window edge
00006Dr 2               NSPR:      .res 1
00006Dr 2               BUF_CX:    .res 4                 ; per buffer held window (cx lo,hi) x2
00006Dr 2               BUF_CY:    .res 2
00006Dr 2               BUF_VALID: .res 2
00006Dr 2               PART_CY:   .res 2                 ; per buffer: row/fine the partial (A) row was last copied for
00006Dr 2               PART_F:    .res 2
00006Dr 2               PART_LO:   .res 2                 ; per buffer: window columns of row wcy drawn since that copy
00006Dr 2               PART_HI:   .res 2                 ;   (LO > HI = none)
00006Dr 2               BUF_BARQ:  .res 2
00006Dr 2               BUF_SEC0:  .res 4              ; per buffer: CRTC start of the frame's first section
00006Dr 2               BUF_SEC0T1: .res 4             ;   and how long it lasts (the vsync handler needs both)
00006Dr 2               BARDIRTY:  .res 1                 ; one bar, so one flag
00006Dr 2               BINR:      .res 4                  ; gx0,gx1,gy,gy1 the cached lists were built for
00006Dr 2               NSTARL:    .res 1                  ; entries in the star list
00006Dr 2               NOTHL:     .res 1                  ;   and in the other one
00006Dr 2               BINI:      .res 1                  ; walk position
00006Dr 2               BINOK:     .res 1                  ; 0 = rebuild (level load, or a list overflowed)
00006Dr 2               MAPSTRIDE: .res 2                  ; bytes per map row (1 << maplw): drawrect walks the
00006Dr 2                                                  ; row pointer by this instead of re-deriving it
00006Dr 2               BARCACHE:  .res 16                 ; the nine digit values last blitted into the one bar
00006Dr 2                                                  ; its bar was last drawn with, $FF = unknown
00006Dr 2               BARBG:     .res 1                 ; the bar needs its static template blitted
00006Dr 2               DIRTYLIST: .res 2*2*16            ; per buffer dirty tiles (tx, ty)
00006Dr 2               DIRTYCNT:  .res 2
00006Dr 2               DISPSECT:  .res 1
00006Dr 2               dispD:     .res 1                 ; ACCCON D for the PLAYFIELD sections: which buffer is
00006Dr 2                                                 ;   displayed.  The bar's section forces D = 0, because
00006Dr 2                                                 ;   below $3000 D = 1 reads HAZEL/ANDY, not main RAM.                 ; SECTAB offset the ISR chain uses (0/48)
00006Dr 2               curR7:     .res 1                 ; last R7 written by the chain (for the vsync re-phase)
00006Dr 2               NEXTSECT:  .res 1
00006Dr 2               SECIDX:    .res 1
00006Dr 2               OLDIRQ:    .res 2
00006Dr 2               OLDIER:    .res 1
00006Dr 2               SFXREQ:    .res 1
00006Dr 2               SFXDUR:    .res 1
00006Dr 2               MUSON:     .res 1
00006Dr 2               MUSTMP:    .res 1                 ; musbyte scratch (ISR context: must not touch tmp)
00006Dr 2                 .if .not MODE1
00006Dr 2               music_tab: .res 144               ; SN76489 periods for MIDI 24..95, decoded at start-up
00006Dr 2                 .endif
00006Dr 2               MUSDUR:    .res 1
00006Dr 2               MUSNOTE:   .res 3
00006Dr 2               ISRT1:     .res 1
00006Dr 2               ISRT2:     .res 1
00006Dr 2               OSBLOCK:   .res 18
00006Dr 2               KEYSCAN:   .res 1
00006Dr 2               VS2T:      .res 2
00006Dr 2               NEXTBUF:   .res 1
00006Dr 2                 .else
00006Dr 2               ; Model B: main RAM is the screen, so each table lives in the bank of the code that
00006Dr 2               ; reads it, and only what more than one bank touches is in the 512 bytes of low RAM.
00006Dr 2               ; The mask tables are static data at a fixed address in both sprite banks (MASKTAB0,
00006Dr 2               ; SWAPTAB in modelb/src/defs.inc); sprmul5 and the row tables are static too.
00006Dr 2                       .segment "TILBSS"           ; bank 5: the tile blitter, the sprite prologue, the records
000000r 2  xx xx xx xx  GATHERL:   .res 24
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000018r 2  xx xx xx xx  GATHERH:   .res 24
00001Cr 2  xx xx xx xx  
000020r 2  xx xx xx xx  
000030r 2  xx xx xx xx  RINGLO:    .res RINGROWS            ; for the buffer being drawn: select_backbuf rebuilds them
000034r 2  xx xx xx xx  
000038r 2  xx xx xx xx  
000047r 2  xx xx xx xx  RINGHI:    .res RINGROWS
00004Br 2  xx xx xx xx  
00004Fr 2  xx xx xx xx  
00005Er 2  xx xx xx xx  SPRREC:    .res 2*MAXREC*10
000062r 2  xx xx xx xx  
000066r 2  xx xx xx xx  
00023Er 2  xx xx        RECCNT:    .res 2
000240r 2  xx xx xx xx  KEEP:      .res MAXREC
000244r 2  xx xx xx xx  
000248r 2  xx xx xx xx  
000258r 2  xx           dpass:     .res 1
000259r 2  xx xx xx xx  BUF_CX:    .res 4
00025Dr 2  xx xx        BUF_CY:    .res 2
00025Fr 2  xx xx        BUF_VALID: .res 2
000261r 2  xx xx        PART_CY:   .res 2
000263r 2  xx xx        PART_F:    .res 2
000265r 2  xx xx        PART_LO:   .res 2
000267r 2  xx xx        PART_HI:   .res 2
000269r 2  xx xx        BUF_BARQ:  .res 2
00026Br 2  xx xx xx xx  DIRTYLIST: .res 2*2*16
00026Fr 2  xx xx xx xx  
000273r 2  xx xx xx xx  
0002ABr 2  xx xx        DIRTYCNT:  .res 2
0002ADr 2  xx           spbank:    .res 1
0002AEr 2  xx           spclip:    .res 1
0002AFr 2                       .segment "LGCBSS"           ; bank 7: the logic's, the display driver's and
000000r 2  xx xx xx xx  BINR:      .res 4                   ; the interrupt's
000004r 2  xx           NSTARL:    .res 1
000005r 2  xx           NOTHL:     .res 1
000006r 2  xx           BINI:      .res 1
000007r 2  xx           BINOK:     .res 1
000008r 2  xx xx xx xx  BUF_SEC0:  .res 4
00000Cr 2  xx xx xx xx  BUF_SEC0T1: .res 4
000010r 2  xx xx xx xx  SECTAB:    .res 2*48
000014r 2  xx xx xx xx  
000018r 2  xx xx xx xx  
000070r 2  xx           SFXDUR:    .res 1
000071r 2  xx           MUSON:     .res 1
000072r 2  xx           MUSTMP:    .res 1
000073r 2  xx           MUSDUR:    .res 1
000074r 2  xx xx xx     MUSNOTE:   .res 3
000077r 2  xx           ISRT1:     .res 1
000078r 2  xx           ISRT2:     .res 1
000079r 2  xx           KEYSCAN:   .res 1
00007Ar 2  xx xx        VS2T:      .res 2
00007Cr 2                       .segment "LOWBSS"           ; main RAM: what more than one bank touches (the
000000r 2  xx xx xx xx  SPRLIST:   .res 5*MAXSPR            ; single bytes are in zero page: defs.inc)
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000078r 2  xx xx xx xx  BARCACHE:  .res 16                  ; bar_bg (bank 4) resets it, bar_digit (bank 7) keeps it
00007Cr 2  xx xx xx xx  
000080r 2  xx xx xx xx  
000088r 2  xx           DISPSECT:  .res 1
000089r 2  xx           NEXTSECT:  .res 1
00008Ar 2  xx           SECIDX:    .res 1
00008Br 2  xx           curR7:     .res 1
00008Cr 2                 .endif
00008Cr 2               
00008Cr 2                       PLACE "CODE", "TILCODE"
000000r 2               
000000r 2               ; ---------------------------------------------------------------- macros
000000r 2               .macro setbank n                    ; ROMSEL_CPY is the MOS's own shadow of ROMSEL, which
000000r 2                       lda #n                      ; the IRQ handler restores from -- nothing ever read
000000r 2                       sta ROMSEL_CPY              ; the private copy this used to keep as well
000000r 2                       sta ROMSEL
000000r 2               .endmacro
000000r 2               
000000r 2               .macro crtc reg, val
000000r 2                       lda #reg
000000r 2                       sta CRTC_IDX
000000r 2                       lda val
000000r 2                       sta CRTC_DAT
000000r 2               .endmacro
000000r 2               
000000r 2               ; advance sp (screen pointer) by one char (8 bytes) with ring wrap
000000r 2               ; ---------------------------------------------------------------- ring wrapping
000000r 2               ; A screen address that runs off the end of the buffer folds back to its start.
000000r 2               ; The buffer is the whole 20K and the test is the sign bit.
000000r 2               ; These spell their skip with an anonymous label, so a caller that wants to branch
000000r 2               ; over one has to count it: see spnext, which says :++ for that reason.  A named
000000r 2               ; label here would end the enclosing routine's cheap-local scope.
000000r 2               .macro ringmod                      ; A = a map char row -> its ring slot
000000r 2               .if (RINGROWS & (RINGROWS - 1)) = 0
000000r 2                       and #(RINGROWS-1)
000000r 2               .else
000000r 2                       tax
000000r 2                       lda ringmodtab,x
000000r 2               .endif
000000r 2               .endmacro
000000r 2               ; Both ends of the ring are page boundaries, so the fold is a compare on the high
000000r 2               ; byte alone.  A = high byte after moving forward, folded back into the ring.
000000r 2               ; The cmp leaves the carry set on the path that reaches the sbc, so the fold needs
000000r 2               ; no sec of its own whatever the caller was holding.
000000r 2               .macro ringup p                     ; p names the pointer whose high byte A holds;
000000r 2                 .if ::MODELB                        ; the Master's fold never needs it
000000r 2                       cmp ringehi                 ; the buffer's ring end, high byte (select_backbuf)
000000r 2                       bcc :+
000000r 2                       sbc #>RINGBYTES             ; C = 1 from the compare, and stays 1: A >= >RINGEND
000000r 2                       pha                         ; > >RINGBYTES.  The low byte folds by $80, which
000000r 2                       lda p                       ; borrows from A when p is below $80
000000r 2                       sec
000000r 2                       sbc #<RINGBYTES
000000r 2                       sta p
000000r 2                       pla
000000r 2                       sbc #0
000000r 2               :
000000r 2                 .else
000000r 2                       cmp #>RINGEND
000000r 2                       bcc :+
000000r 2                       sbc #>RINGBYTES
000000r 2               :
000000r 2                 .endif
000000r 2               .endmacro
000000r 2               .macro ringdn                       ; A = high byte after moving back
000000r 2                       cmp #>RINGBASE
000000r 2                       bcs :+
000000r 2                       adc #>RINGBYTES
000000r 2               :
000000r 2               .endmacro
000000r 2               
000000r 2               .macro spnext
000000r 2                       lda sp
000000r 2                       clc
000000r 2                       adc #8
000000r 2                       sta sp
000000r 2                       bcc :++                     ; past the fold's own anonymous label
000000r 2                       lda sp+1
000000r 2                       inca
000000r 2                       ringup sp
000000r 2                       sta sp+1
000000r 2               :
000000r 2               .endmacro
000000r 2               
000000r 2               ; ============================================================================
000000r 2               ; ringaddr: screen address of map char (w16 = cx 16 bit, A = cy) -> sp
000000r 2               ; ============================================================================
000000r 2               ringaddr:
000000r 2  AA BD 80 80          ringmod
000004r 2  AA                   tax
000005r 2  A5 rr                lda w16+1
000007r 2  85 rr                sta sp+1
000009r 2  A5 rr                lda w16
00000Br 2  0A                   asl
00000Cr 2  26 rr                rol sp+1
00000Er 2  0A                   asl
00000Fr 2  26 rr                rol sp+1
000011r 2  0A                   asl
000012r 2  26 rr                rol sp+1                    ; sp+1:A = cx*8
000014r 2  18                   clc
000015r 2  7D rr rr             adc RINGLO,x
000018r 2  85 rr                sta sp
00001Ar 2  A5 rr                lda sp+1
00001Cr 2  7D rr rr             adc RINGHI,x
00001Fr 2  C5 E1 90 0D          ringup sp
000023r 2  E9 39 48 A5  
000027r 2  rr 38 E9 80  
000030r 2  85 rr                sta sp+1
000032r 2  60                   rts
000033r 2               
000033r 2               ; ============================================================================
000033r 2               ; drawrect: draw map tiles into the current back buffer.
000033r 2               ;   rc_x (map chars, 16 bit), rc_y (map char rows), rc_w (chars 1..80), rc_h (rows)
000033r 2               ; ============================================================================
000033r 2               drawrect:
000033r 2  A5 rr                lda rc_h
000035r 2  D0 01                bne :+
000037r 2  60                   rts
000038r 2               :
000038r 2                 .if MODELB
000038r 2  A5 E4                lda mrow                    ; the map row the mirror follows (calc_ring): a rect
00003Ar 2  38                   sec                         ; that touches it says which window columns it wrote
00003Br 2  E5 rr                sbc rc_y
00003Dr 2  C5 rr                cmp rc_h
00003Fr 2  B0 0F                bcs @nomir
000041r 2  A5 rr                lda rc_x
000043r 2  38                   sec
000044r 2  E5 rr                sbc wcx                     ; the window column (rects are window clipped)
000046r 2  48                   pha
000047r 2  18                   clc
000048r 2  65 rr                adc rc_w
00004Ar 2  AA                   tax
00004Br 2  CA                   dex                         ; ..the last one
00004Cr 2  68                   pla
00004Dr 2  20 rr rr             jsr mirdirty
000050r 2               @nomir:
000050r 2                 .endif
000050r 2  A5 rr                lda rc_y
000052r 2  C5 rr                cmp wcy
000054r 2  D0 20                bne :+
000056r 2  A6 rr                ldx curbuf                  ; touches the window's top row: widen the partial-row
000058r 2  A5 rr                lda rc_x                    ; dirty column range (rects are window-clipped, so
00005Ar 2  38                   sec                         ; the low byte of rc_x - wcx is the column)
00005Br 2  E5 rr                sbc wcx
00005Dr 2  DD rr rr             cmp PART_LO,x
000060r 2  B0 03                bcs @plo
000062r 2  9D rr rr             sta PART_LO,x
000065r 2  18           @plo:   clc
000066r 2  65 rr                adc rc_w
000068r 2  85 DF C6 DF          deca
00006Cr 2  A5 DF        
00006Er 2  DD rr rr             cmp PART_HI,x
000071r 2  90 03                bcc :+
000073r 2  9D rr rr             sta PART_HI,x
000076r 2               :       ; ---- per-rect invariants: tx0 = rc_x >> 2 ; tiles-1 = ((rc_x + rc_w - 1) >> 2) - tx0
000076r 2  A5 rr                lda rc_x+1
000078r 2  85 rr                sta w16+1                   ; the ring address's copy, from this load too
00007Ar 2  4A                   lsr
00007Br 2  85 rr                sta tmp
00007Dr 2  A5 rr                lda rc_x
00007Fr 2  6A                   ror
000080r 2  46 rr                lsr tmp
000082r 2  6A                   ror                         ; A = tx0 (map width <= 256 tiles)
000083r 2  85 rr                sta rc_tx0
000085r 2  A5 rr                lda rc_x                    ; tiles-1 = tx1 - tx0 = ((rc_x & 3) + rc_w - 1) >> 2,
000087r 2  85 rr                sta w16                     ; the copy the ring address needs, from the same load
000089r 2  29 03                and #3                      ; so tx1 never needs building: max 3 + 80 - 1 = 82,
00008Br 2  85 rr                sta rc_sc0
00008Dr 2  18                   clc                         ; one byte, no 16-bit shift, no w16
00008Er 2  65 rr                adc rc_w
000090r 2  85 DF C6 DF          deca
000094r 2  A5 DF        
000096r 2  4A                   lsr
000097r 2  4A                   lsr
000098r 2  85 rr                sta rc_nt
00009Ar 2  A5 rr                lda rc_sc0
00009Cr 2  0A                   asl
00009Dr 2  0A                   asl
00009Er 2  0A                   asl
00009Fr 2  85 rr                sta rc_ro0
0000A1r 2  A5 rr                lda rc_y
0000A3r 2  20 rr rr             jsr ringaddr
