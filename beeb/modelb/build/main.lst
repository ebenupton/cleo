000B20r 2                       rts
000B20r 2                 .endif
000B20r 2                 .endif
000B20r 2                       PLACE "LOW2", "TILCODE"     ; back to the render helpers
000B20r 2               
000B20r 2               
000B20r 2               ; ============================================================================
000B20r 2               ; dirty tiles: redraw changed map tiles (both buffers keep their own list)
000B20r 2               ; ============================================================================
000B20r 2               mark_dirty:                         ; A = tx, X = ty  (adds to both buffers' lists)
000B20r 2  85 rr                sta tmp
000B22r 2  86 rr                stx tmp2
000B24r 2  A2 00                ldx #0
000B26r 2  BD rr rr     @b:     lda DIRTYCNT,x
000B29r 2  C9 10                cmp #16
000B2Br 2  B0 19                bcs @next
000B2Dr 2  0A                   asl
000B2Er 2  85 rr                sta tmp3
000B30r 2  8A                   txa
000B31r 2  0A                   asl
000B32r 2  0A                   asl
000B33r 2  0A                   asl
000B34r 2  0A                   asl
000B35r 2  0A                   asl                         ; x*32 -- X is 0 or 1, so the fifth asl cannot
000B36r 2  65 rr                adc tmp3                    ; carry out and the clc is dead
000B38r 2  A8                   tay
000B39r 2  A5 rr                lda tmp
000B3Br 2  99 rr rr             sta DIRTYLIST,y
000B3Er 2  A5 rr                lda tmp2
000B40r 2  99 rr rr             sta DIRTYLIST+1,y
