0004C7r 2  65 rr                adc wcy                     ; + wcy + 1 -> wcy + BUFROWS - rc_h
0004C9r 2  85 rr                sta rc_y
0004CBr 2               @dorows:
0004CBr 2  A5 rr                lda wcx
0004CDr 2  85 rr                sta rc_x
0004CFr 2  A5 rr                lda wcx+1
0004D1r 2  85 rr                sta rc_x+1
0004D3r 2  A9 50                lda #ROWCHARS
0004D5r 2  85 rr                sta rc_w
0004D7r 2  20 rr rr             jsr drawrect
0004DAr 2  4C rr rr             bra @done
0004DDr 2               @full:
0004DDr 2  A5 rr                lda wcy
0004DFr 2  85 rr                sta rc_y
0004E1r 2  A9 16                lda #BUFROWS
0004E3r 2  85 rr                sta rc_h
0004E5r 2  4C rr rr             bra @dorows
0004E8r 2               @done:
0004E8r 2  A6 rr                ldx curbuf
0004EAr 2  A9 01                lda #1
0004ECr 2  9D rr rr             sta BUF_VALID,x
0004EFr 2  A5 rr                lda wcy
0004F1r 2  9D rr rr             sta BUF_CY,x
0004F4r 2  8A                   txa
0004F5r 2  0A                   asl
0004F6r 2  A8                   tay
0004F7r 2  A5 rr                lda wcx
0004F9r 2  99 rr rr             sta BUF_CX,y
0004FCr 2  A5 rr                lda wcx+1
0004FEr 2  99 rr rr             sta BUF_CX+1,y
000501r 2  60                   rts
000502r 2               
000502r 2               ; ============================================================================
000502r 2               ; ============================================================================
000502r 2               ; Persistent sprite records.  match_sprites: KEEP[i] = new sprite i identical to record i
000502r 2               ; ============================================================================
000502r 2               match_sprites:
000502r 2  A6 rr                ldx curbuf
000504r 2  BD rr rr             lda RECCNT,x
000507r 2  C5 A2                cmp NSPR
000509r 2  90 02                bcc :+
00050Br 2  A5 A2                lda NSPR
00050Dr 2  85 rr        :       sta cnt                     ; n = min(RECCNT, NSPR)
00050Fr 2  48 A9 00 85          stza tmp4                   ; i
000513r 2  rr 68        
000515r 2  A5 rr                lda recp
000517r 2  85 rr                sta rp
000519r 2  A5 rr                lda recp+1
00051Br 2  85 rr                sta rp+1
00051Dr 2  A6 rr        @l:     ldx tmp4
00051Fr 2  E4 A2                cpx NSPR
000521r 2  B0 65                bcs @done
000523r 2  48 A9 00 9D          stza KEEP,x
000527r 2  rr rr 68     
00052Ar 2  E4 rr                cpx cnt
00052Cr 2  B0 4A                bcs @next
00052Er 2  BD 30 80             lda sprmul5,x
000531r 2  AA                   tax
000532r 2  BD rr rr             lda SPRLIST,x
000535r 2  A0 00 D1 rr          cmpz rp                     ; (zp): offset 0 needs no index register
000539r 2  F0 11                beq @same
00053Br 2                       ; two box-star frames at the same place overwrite each other exactly -- every
00053Br 2                       ; pixel opaque, and each box covers the art of the frame before it -- so a
00053Br 2                       ; frame change there needs no erase either
00053Br 2  C9 67                cmp #BOXID0
00053Dr 2  90 39                bcc @next
00053Fr 2  A0 00 B1 rr          ldaz rp
000543r 2  C9 67                cmp #BOXID0
000545r 2  90 31                bcc @next
000547r 2  A9 01                lda #1                      ; 1 = a different frame of the same thing
000549r 2  4C rr rr             bra @pos
00054Cr 2  A9 02        @same:  lda #2                      ; 2 = identical, so its pixels are already right
00054Er 2  85 rr        @pos:   sta tmp3
000550r 2  A0 01                ldy #1
000552r 2  BD rr rr             lda SPRLIST+1,x
000555r 2  D1 rr                cmp (rp),y
000557r 2  D0 1F                bne @next
000559r 2  C8                   iny
00055Ar 2  BD rr rr             lda SPRLIST+2,x
00055Dr 2  D1 rr                cmp (rp),y
00055Fr 2  D0 17                bne @next
000561r 2  C8                   iny
000562r 2  BD rr rr             lda SPRLIST+3,x
000565r 2  D1 rr                cmp (rp),y
000567r 2  D0 0F                bne @next
000569r 2  C8                   iny
00056Ar 2  BD rr rr             lda SPRLIST+4,x
00056Dr 2  D1 rr                cmp (rp),y
00056Fr 2  D0 07                bne @next
000571r 2  A6 rr                ldx tmp4
000573r 2  A5 rr                lda tmp3
000575r 2  9D rr rr             sta KEEP,x                  ; same pixels in the same place: skip the erase
000578r 2  A5 rr        @next:  lda rp
00057Ar 2  18                   clc
00057Br 2  69 0A                adc #10
00057Dr 2  85 rr                sta rp
00057Fr 2  90 02                bcc :+
000581r 2  E6 rr                inc rp+1
000583r 2  E6 rr        :       inc tmp4
000585r 2  4C rr rr             bra @l
000588r 2  60           @done:  rts
000589r 2               
000589r 2               ; erase_old: redraw tiles under old records that are not kept
000589r 2               erase_old:
000589r 2  A6 rr                ldx curbuf
00058Br 2  BD rr rr             lda RECCNT,x
00058Er 2  F0 4C                beq @done
000590r 2  85 rr                sta lcnt
000592r 2  A9 00 85 rr          stz lidx
000596r 2  A5 rr                lda recp
000598r 2  85 rr                sta rp
00059Ar 2  A5 rr                lda recp+1
00059Cr 2  85 rr                sta rp+1
00059Er 2  A6 rr        @l:     ldx lidx
0005A0r 2  E4 A2                cpx NSPR
0005A2r 2  B0 05                bcs @erase
0005A4r 2  BD rr rr             lda KEEP,x
0005A7r 2  D0 22                bne @next
0005A9r 2  A0 08        @erase: ldy #8
0005ABr 2  B1 rr                lda (rp),y
0005ADr 2  F0 1C                beq @next
0005AFr 2  85 rr                sta rc_w
0005B1r 2  C8                   iny
0005B2r 2  B1 rr                lda (rp),y
0005B4r 2  29 7F                and #$7F
0005B6r 2  85 rr                sta rc_h
0005B8r 2  A0 05                ldy #5
0005BAr 2  B1 rr                lda (rp),y
0005BCr 2  85 rr                sta rc_x
0005BEr 2  C8                   iny
0005BFr 2  B1 rr                lda (rp),y
0005C1r 2  85 rr                sta rc_x+1
0005C3r 2  C8                   iny
0005C4r 2  B1 rr                lda (rp),y
0005C6r 2  85 rr                sta rc_y
0005C8r 2  20 rr rr             jsr drawrect_clip
0005CBr 2  A5 rr        @next:  lda rp
0005CDr 2  18                   clc
0005CEr 2  69 0A                adc #10
0005D0r 2  85 rr                sta rp
0005D2r 2  90 02                bcc :+
0005D4r 2  E6 rr                inc rp+1
0005D6r 2  E6 rr        :       inc lidx
0005D8r 2  C6 rr                dec lcnt
0005DAr 2  D0 C2                bne @l
0005DCr 2  60           @done:  rts
0005DDr 2               
0005DDr 2               ; ============================================================================
0005DDr 2               ; Sprites
0005DDr 2               ; ============================================================================
0005DDr 2               ; add sprite to draw list: A = id, spx/spy = map px
0005DDr 2                       PLACE "CODE", "LGCLO"       ; Model B: the logic's bank writes SPRLIST in low RAM
000000r 2               addsprite:
000000r 2  A6 A2                ldx NSPR
000002r 2  E0 18                cpx #MAXSPR
000004r 2  B0 1C                bcs @full
000006r 2  BC 30 80             ldy sprmul5,x
000009r 2  99 rr rr             sta SPRLIST,y
00000Cr 2  A5 rr                lda spx
00000Er 2  99 rr rr             sta SPRLIST+1,y
000011r 2  A5 rr                lda spx+1
000013r 2  99 rr rr             sta SPRLIST+2,y
000016r 2  A5 rr                lda spy
000018r 2  99 rr rr             sta SPRLIST+3,y
00001Br 2  A5 rr                lda spy+1
00001Dr 2  99 rr rr             sta SPRLIST+4,y
000020r 2  E6 A2                inc NSPR
000022r 2  60           @full:  rts
000023r 2               
000023r 2               ; draw all listed sprites into current buffer (skipping unchanged kept ones)
000023r 2                       PLACE "CODE", "TILCODE"
0005DDr 2               draw_sprites:
0005DDr 2                       ; Two passes.  A box star is an opaque rectangle with its background baked in,
0005DDr 2                       ; so it has to go down before anything that shares its space -- drawn in list
0005DDr 2                       ; order it would paint that background over whatever was standing there.
0005DDr 2  A9 01                lda #1
0005DFr 2  8D rr rr             sta dpass
0005E2r 2  48 A9 00 85  @pass:  stza spi
0005E6r 2  rr 68        
0005E8r 2  A5 rr                lda recp
0005EAr 2  85 rr                sta rp
0005ECr 2  A5 rr                lda recp+1
0005EEr 2  85 rr                sta rp+1
0005F0r 2  A6 rr        @l:     ldx spi
0005F2r 2  E4 A2                cpx NSPR
0005F4r 2  B0 67                bcs @endpass
0005F6r 2  BD 30 80             lda sprmul5,x
0005F9r 2  AA                   tax
0005FAr 2  BD rr rr             lda SPRLIST,x
0005FDr 2  C9 67                cmp #BOXID0
0005FFr 2  AD rr rr             lda dpass
000602r 2  69 FF                adc #$FF
000604r 2  F0 47                beq @next
000606r 2  BD rr rr             lda SPRLIST,x
000609r 2  C9 76                cmp #BOXID0+BOXN            ; a box star the logic says nothing can disturb, and
00060Br 2  90 0F                bcc @write                  ; the same frame already in the same place: if
00060Dr 2  A4 rr                ldy spi                     ; nothing has been repainted under it, its pixels
00060Fr 2  B9 rr rr             lda KEEP,y                  ; are still right, so leave it alone
000612r 2  C9 02                cmp #2
000614r 2  D0 06                bne @write
000616r 2  A0 09                ldy #9                      ; and it was not cut off at a window edge, so all
000618r 2  B1 rr                lda (rp),y                  ; of it is on screen and still intact
00061Ar 2  10 31                bpl @next
00061Cr 2  A0 01        @write: ldy #1
00061Er 2  BD rr rr             lda SPRLIST+1,x
000621r 2  85 rr                sta spx
000623r 2  91 rr                sta (rp),y
000625r 2  C8                   iny
000626r 2  BD rr rr             lda SPRLIST+2,x
000629r 2  85 rr                sta spx+1
00062Br 2  91 rr                sta (rp),y
00062Dr 2  C8                   iny
00062Er 2  BD rr rr             lda SPRLIST+3,x
000631r 2  85 rr                sta spy
000633r 2  91 rr                sta (rp),y
000635r 2  C8                   iny
000636r 2  BD rr rr             lda SPRLIST+4,x
000639r 2  85 rr                sta spy+1
00063Br 2  91 rr                sta (rp),y
00063Dr 2  A0 08                ldy #8
00063Fr 2  A9 00                lda #0
000641r 2  91 rr                sta (rp),y
000643r 2  BD rr rr             lda SPRLIST,x
000646r 2  A0 00 91 rr          staz rp                     ; sta (rp) - offset 0 needs no index
00064Ar 2  20 rr rr             jsr drawsprite
00064Dr 2  A5 rr        @next:  lda rp
00064Fr 2  18                   clc
000650r 2  69 0A                adc #10
000652r 2  85 rr                sta rp
000654r 2  90 02                bcc :+
000656r 2  E6 rr                inc rp+1
000658r 2  E6 rr        :       inc spi
00065Ar 2  4C rr rr             jmp @l
00065Dr 2               @endpass:
00065Dr 2  CE rr rr             dec dpass
000660r 2  30 03                bmi :+
000662r 2  4C rr rr             jmp @pass                   ; (out of branch range on the 6502 build)
000665r 2  A6 rr        :       ldx curbuf
000667r 2  A5 A2                lda NSPR
000669r 2  9D rr rr             sta RECCNT,x
00066Cr 2  60                   rts
00066Dr 2               
00066Dr 2               ; draw one sprite: A = id ; spx, spy = map px (ref point)
00066Dr 2               ; A = sprite id. Game sprites (spbank = BANK_SPR): directory is in main RAM at
00066Dr 2               ; SPR_TABLE; sprite data is in bank 4, or in ANDY ($8000, ROMSEL bit7) when the
00066Dr 2               ; entry's flag bit2 is set. Title pieces (spbank != BANK_SPR): directory and data
00066Dr 2               ; both live at TITLE_ADDR of that bank.
00066Dr 2               drawsprite:
00066Dr 2  48 A9 00 8D          stza spclip                 ; set at every window edge the sprite is cut against
000671r 2  rr rr 68     
000674r 2  C9 76                cmp #BOXID0+BOXN            ; the "nothing can disturb it" aliases draw the same
000676r 2  90 02                bcc :+                      ; picture as the ids BOXN below them
000678r 2  E9 0F                sbc #BOXN
00067Ar 2               :
00067Ar 2                 .if MODE1
00067Ar 2  85 rr                sta sp_id
00067Cr 2                 .endif
00067Cr 2  48 A9 00 85          stza ptr+1
000680r 2  rr 68        
000682r 2  0A                   asl                         ; id*8 -> offset
000683r 2  26 rr                rol ptr+1
000685r 2  0A                   asl
000686r 2  26 rr                rol ptr+1
000688r 2  0A                   asl
000689r 2  26 rr                rol ptr+1
00068Br 2  AE rr rr             ldx spbank
00068Er 2  E0 04                cpx #BANK_SPR
000690r 2  D0 41                bne @titledir
000692r 2                 .if .not MODELB               ; (Model B: the directory is in this bank)
000692r 2                       ldx #BANK_LVL           ; SPR_TABLE is in bank 7; the whole prologue reads
000692r 2                       stx ROMSEL_CPY          ; the directory and none of it reads sprite data
000692r 2                       stx ROMSEL
000692r 2                 .endif
000692r 2  18                   clc
000693r 2  69 rr                adc #<SPR_TABLE
000695r 2  85 rr                sta ptr
000697r 2  A5 rr                lda ptr+1
000699r 2  69 rr                adc #>SPR_TABLE
00069Br 2  85 rr                sta ptr+1
00069Dr 2                 .if MODELB
00069Dr 2  20 rr rr             jsr dirfetch                ; the directory is in bank 6: its eight bytes come
0006A0r 2                 .endif                            ; into low RAM and ptr points there
0006A0r 2  A0 06                ldy #6
0006A2r 2  B1 rr                lda (ptr),y
0006A4r 2  85 rr                sta sp_flags
0006A6r 2  A2 04                ldx #BANK_SPR
0006A8r 2  85 DF 29 04          bitimm 4
0006ACr 2  08 A5 DF 28  
0006B0r 2  F0 02                beq :+
0006B2r 2  A2 84                ldx #(BANK_SPR|$80)
0006B4r 2  85 DF 29 10  :       bitimm $10              ; A still holds the flags byte
0006B8r 2  08 A5 DF 28  
0006BCr 2  F0 02                beq :+
0006BEr 2  A2 06                ldx #BANK_TIL1
0006C0r 2  86 rr        :       stx sp_dbank            ; wanted later: the directory is still being read
0006C2r 2                 .if MODE1
0006C2r 2  A5 rr                lda sp_id
0006C4r 2  0A                   asl
0006C5r 2  AA                   tax
0006C6r 2  BD rr rr             lda SPRMASK,x
0006C9r 2  85 EC                sta sp_mbase
0006CBr 2  BD rr rr             lda SPRMASK+1,x
0006CEr 2  85 ED                sta sp_mbase+1
0006D0r 2                 .endif
0006D0r 2  4C rr rr             bra @entry2
0006D3r 2               @titledir:
0006D3r 2                       ; ---- title piece: directory + data at TITLE_ADDR of bank(spbank)
0006D3r 2  85 rr                sta ptr                     ; only this path uses id*8 as the low byte unadjusted
0006D5r 2  A5 rr                lda ptr+1
0006D7r 2  18                   clc
0006D8r 2  69 89                adc #>TITLE_ADDR
0006DAr 2  85 rr                sta ptr+1
0006DCr 2  AD rr rr             lda spbank              ; title pieces keep directory and data in one bank
0006DFr 2  85 rr                sta sp_dbank
0006E1r 2                 .if .not MODELB
0006E1r 2                       sta ROMSEL_CPY
0006E1r 2                       sta ROMSEL
0006E1r 2                 .endif
0006E1r 2  A0 06                ldy #6
0006E3r 2  B1 rr                lda (ptr),y
0006E5r 2  85 rr                sta sp_flags
0006E7r 2                 .if MODE1
0006E7r 2  A5 rr                lda sp_id                   ; the mask address table behind the directory
0006E9r 2  0A                   asl
0006EAr 2  AA                   tax
0006EBr 2  BD 80 89             lda TITLE_ADDR+$80,x
0006EEr 2  85 EC                sta sp_mbase
0006F0r 2  BD 81 89             lda TITLE_ADDR+$81,x
0006F3r 2  85 ED                sta sp_mbase+1
0006F5r 2                 .endif
0006F5r 2               @entry2:
0006F5r 2  A0 00 B1 rr          ldaz ptr
0006F9r 2  85 rr                sta sp_ptr
0006FBr 2  A0 01                ldy #1
0006FDr 2  B1 rr                lda (ptr),y
0006FFr 2  85 rr                sta sp_ptr+1
000701r 2  C8                   iny
000702r 2  B1 rr                lda (ptr),y
000704r 2  85 rr                sta sp_w
000706r 2                 .if MODELB
000706r 2  D0 03                bne @w_ok                   ; (the 6502 spellings put @out0 out of reach)
000708r 2  4C rr rr             jmp @out0
00070Br 2               @w_ok:
00070Br 2                 .else
00070Br 2                       beq @out0
00070Br 2                 .endif
00070Br 2               :                                   ; keep the bare label: it preserves the anonymous-label count
00070Br 2  A0 07                ldy #7
00070Dr 2  B1 rr                lda (ptr),y
00070Fr 2  85 rr                sta sp_lines
000711r 2  85 rr                sta sp_ext
000713r 2                 .if MODE1
000713r 2  4A                   lsr
000714r 2  85 E9                sta sp_mh                   ; mask bytes per column group = pixel rows
000716r 2                 .endif
000716r 2  A5 rr                lda sp_flags
000718r 2  29 02                and #2
00071Ar 2  D0 02                bne :+
00071Cr 2  06 rr                asl sp_ext                  ; half-res: two scanlines per stored row
00071Er 2               :       ; ---- horizontal: sx = spx - refx - wx ; c0 = sx >> 1
00071Er 2  A0 04                ldy #4
000720r 2  B1 rr                lda (ptr),y
000722r 2  29 80                and #$80                    ; sext inlined: the jsr/rts was 12 cycles of the 39
000724r 2  F0 02                beq @sxp
000726r 2  A9 FF                lda #$FF
000728r 2  85 rr        @sxp:   sta tmp3
00072Ar 2  A5 rr                lda spx
00072Cr 2  38                   sec
00072Dr 2  F1 rr                sbc (ptr),y
00072Fr 2  AA                   tax
000730r 2  A5 rr                lda spx+1
000732r 2  E5 rr                sbc tmp3
000734r 2  A8                   tay
000735r 2  8A                   txa
000736r 2  38                   sec
000737r 2  E5 rr                sbc wx
000739r 2  85 rr                sta w16
00073Br 2  98                   tya
00073Cr 2  E5 rr                sbc wx+1
00073Er 2  C9 80                cmp #$80
000740r 2  6A                   ror a                       ; sign into bit 7, old bit 0 out to C
000741r 2  66 rr                ror w16                     ; arithmetic shift right 1 -> c0 (16 bit)
000743r 2  C9 00                cmp #0                      ; A still holds w16+1: just restore N,Z
000745r 2  F0 29                beq @cpos
000747r 2  C9 FF                cmp #$FF
000749r 2  D0 49                bne @out0
00074Br 2                       ; c0 negative (-128..-1): cstart = 0 ; visible if c0 + W > 0
00074Br 2  A5 rr                lda w16
00074Dr 2  18                   clc
00074Er 2  65 rr                adc sp_w
000750r 2  85 DF C6 DF          deca
000754r 2  A5 DF        
000756r 2  30 3C                bmi @out0
000758r 2  EE rr rr             inc spclip
00075Br 2  85 rr                sta sp_c1
00075Dr 2  A9 00 85 rr          stz sp_c0
000761r 2                       ; first visible column index = -c0
000761r 2  A5 rr                lda w16
000763r 2  49 FF                eor #$FF
000765r 2  85 DF E6 DF          inca
000769r 2  A5 DF        
00076Br 2  85 rr                sta sp_c                    ; starting image column
00076Dr 2  4C rr rr             bra @vert
000770r 2  A5 rr        @cpos:  lda w16
000772r 2  C9 50                cmp #ROWCHARS
000774r 2  B0 1E                bcs @out0                   ; not taken: C = 0 for the adc below
000776r 2  85 rr                sta sp_c0
000778r 2  65 rr                adc sp_w
00077Ar 2  85 DF C6 DF          deca
00077Er 2  A5 DF        
000780r 2  C9 50                cmp #ROWCHARS
000782r 2  90 05                bcc :+
000784r 2  EE rr rr             inc spclip                  ; and at the right
000787r 2  A9 4F                lda #(ROWCHARS-1)
000789r 2  85 rr        :       sta sp_c1
00078Br 2  48 A9 00 85          stza sp_c
00078Fr 2  rr 68        
000791r 2  4C rr rr             bra @vert
000794r 2  60           @out0:  rts
000795r 2               @vert:
000795r 2                       ; ---- vertical: sy = spy - refy - wy ; lb0 = 2*sy + wfine
000795r 2  A0 05                ldy #5
000797r 2  B1 rr                lda (ptr),y
000799r 2  20 rr rr             jsr sext
00079Cr 2  A5 rr                lda spy
00079Er 2  38                   sec
00079Fr 2  F1 rr                sbc (ptr),y
0007A1r 2  AA                   tax
0007A2r 2  A5 rr                lda spy+1
0007A4r 2  E5 rr                sbc tmp3
0007A6r 2  A8                   tay
0007A7r 2                 .if .not MODELB               ; (Model B: the data's bank runs the loop, below)
0007A7r 2                       lda sp_dbank            ; done with the directory: the blitter wants the data
0007A7r 2                       sta ROMSEL_CPY
0007A7r 2                       sta ROMSEL
0007A7r 2                 .endif
0007A7r 2  8A                   txa
0007A8r 2  38                   sec
0007A9r 2  E5 rr                sbc wy
0007ABr 2  AA                   tax
0007ACr 2  98                   tya
0007ADr 2  E5 rr                sbc wy+1
0007AFr 2  85 rr                sta sp_lb0+1
0007B1r 2  8A                   txa
0007B2r 2  0A                   asl                         ; C = old bit 7, exactly what 'asl w16' left
0007B3r 2  26 rr                rol sp_lb0+1
0007B5r 2  18                   clc
0007B6r 2  65 rr                adc wfine
0007B8r 2  85 rr                sta sp_lb0
0007BAr 2  90 03                bcc @nc
0007BCr 2  E6 rr                inc sp_lb0+1                ; lb0 (16 bit signed)
0007BEr 2  18                   clc                         ; only this arm arrives with C set
0007BFr 2               @nc:
0007BFr 2                       ; lend = lb0 + ext - 1
0007BFr 2  A5 rr                lda sp_ext
0007C1r 2  85 DF C6 DF          deca
0007C5r 2  A5 DF        
0007C7r 2  65 rr                adc sp_lb0
0007C9r 2  85 rr                sta w16
0007CBr 2  A5 rr                lda sp_lb0+1
0007CDr 2  69 00                adc #0
0007CFr 2  85 rr                sta w16+1                   ; w16 = lb1
0007D1r 2                       ; clip lstart = max(lb0,0) ; lend = min(lb1, 247)
0007D1r 2  A5 rr                lda sp_lb0+1
0007D3r 2  30 0D                bmi @top
0007D5r 2  D0 BD                bne @out0                   ; lb0 >= 256 -> below
0007D7r 2  A5 rr                lda sp_lb0
0007D9r 2  C9 B0                cmp #BUFROWS*8
0007DBr 2  B0 B7                bcs @out0
0007DDr 2  85 rr                sta tmp                     ; lstart
0007DFr 2  4C rr rr             bra @ck
0007E2r 2  A5 rr        @top:   lda w16+1
