001B1Dr 2               ; ---------------------------------------------------------------- VANISHING BLOCK (11)
001B1Dr 2               ob_vanish:
001B1Dr 2  A5 B4                lda fe
001B1Fr 2  D0 12                bne @count
001B21r 2                       ; rx > -16 && rx <= 0 && ry == 16 && vy == 0
001B21r 2  A2 38                ldx #56
001B23r 2  20 rr rr             jsr inrange
001B26r 2  90 0A                bcc @ret
001B28r 2  A5 rr                lda vy
001B2Ar 2  05 rr                ora vy+1
001B2Cr 2  D0 04                bne @ret
001B2Er 2  A9 01                lda #1
001B30r 2  85 B4                sta fe
001B32r 2  60           @ret:   rts
001B33r 2  E6 B4        @count: inc fe
001B35r 2  A5 B4                lda fe
001B37r 2  85 DF 29 03          bitimm 3
001B3Br 2  08 A5 DF 28  
001B3Fr 2  D0 6D                bne @done
001B41r 2  C9 0C                cmp #12
001B43r 2  B0 04                bcs :+
001B45r 2  4A                   lsr
001B46r 2  4C rr rr             bra @set
001B49r 2  C9 25        :       cmp #37
001B4Br 2  90 08                bcc @six
001B4Dr 2  A9 30                lda #48
001B4Fr 2  E5 B4                sbc fe                      ; carry is already set: bcc fell through
001B51r 2  4A                   lsr
001B52r 2  4C rr rr             bra @set
001B55r 2  A9 06        @six:   lda #6
001B57r 2  85 C3        @set:   sta q1
001B59r 2                       ; tiles at (ox>>3, oy>>3) and +1 : codes from header per page
001B59r 2  A5 A8 85 BE          mov16 qx, ox
001B5Dr 2  A5 A9 85 BF  
001B61r 2  A5 AA 85 C0          mov16 qy, oy
001B65r 2  A5 AB 85 C1  
001B69r 2  20 rr rr             jsr tilexy
001B6Cr 2  86 C6                stx q4                      ; tile x (q4/q5: gx/gy are the live grid-walk cursor)
001B6Er 2  85 C7                sta q5                      ; tile y
001B70r 2  A6 C3                ldx q1
001B72r 2  BD rr rr             lda LV_HDR+8,x
001B75r 2  85 C4                sta q2
001B77r 2  BD rr rr             lda LV_HDR+9,x
001B7Ar 2  85 C5                sta q3
001B7Cr 2  A6 C6                ldx q4
001B7Er 2  A5 C7                lda q5
001B80r 2  20 rr rr             jsr maptile                 ; sets mapptr, Y = tx
001B83r 2  A5 C4                lda q2
001B85r 2  20 rr rr             jsr mapput
001B88r 2  C8                   iny
001B89r 2  A5 C5                lda q3
001B8Br 2  20 rr rr             jsr mapput
001B8Er 2  A5 C6                lda q4
001B90r 2  A6 C7                ldx q5
001B92r 2  20 rr rr             jsr m_mark_dirty
001B95r 2  A5 C6                lda q4
001B97r 2  85 DF E6 DF          inca
001B9Br 2  A5 DF        
001B9Dr 2  A6 C7                ldx q5
001B9Fr 2  20 rr rr             jsr m_mark_dirty
001BA2r 2  A5 B4                lda fe
001BA4r 2  C9 30                cmp #48
001BA6r 2  D0 06                bne @done
001BA8r 2  48 A9 00 85          stza fe
001BACr 2  B4 68        
001BAEr 2  60           @done:  rts
001BAFr 2               
001BAFr 2               ; ---------------------------------------------------------------- SWITCH (12)
001BAFr 2               ob_switch:
001BAFr 2  A5 B2                lda fd
001BB1r 2  D0 58                bne @draw
001BB3r 2  A2 3C                ldx #60
001BB5r 2  20 rr rr             jsr inrange
001BB8r 2  90 51                bcc @draw
001BBAr 2  A9 14                lda #20
001BBCr 2  20 rr rr             jsr addscore
001BBFr 2  A9 06                lda #SFX_POWER
001BC1r 2  85 A5                sta SFXREQ
001BC3r 2                       ; copy map columns (A-2, A-1) -> (A, A+1) for rows B .. B+C-1
001BC3r 2  A5 B0                lda fc
001BC5r 2  F0 40                beq @set
001BC7r 2  85 C6                sta q4
001BC9r 2  A5 AE                lda fb
001BCBr 2  85 C7                sta q5                      ; row counter (q5: the grid-walk cursor must stay intact)
001BCDr 2  A6 AC        @rl:    ldx fa
001BCFr 2  A5 C7                lda q5
001BD1r 2  20 rr rr             jsr maptile                 ; mapptr = row, Y = A
001BD4r 2  88                   dey
001BD5r 2  88                   dey
001BD6r 2  20 rr rr             jsr mapbyte
001BD9r 2  85 C4                sta q2
001BDBr 2  C8                   iny
001BDCr 2  20 rr rr             jsr mapbyte
001BDFr 2  85 C5                sta q3
001BE1r 2  C8                   iny
001BE2r 2  A5 C4                lda q2
001BE4r 2  20 rr rr             jsr mapput
001BE7r 2  C8                   iny
001BE8r 2  A5 C5                lda q3
001BEAr 2  20 rr rr             jsr mapput
001BEDr 2  A5 AC                lda fa
001BEFr 2  A6 C7                ldx q5
001BF1r 2  20 rr rr             jsr m_mark_dirty
001BF4r 2  A5 AC                lda fa
001BF6r 2  85 DF E6 DF          inca
001BFAr 2  A5 DF        
001BFCr 2  A6 C7                ldx q5
001BFEr 2  20 rr rr             jsr m_mark_dirty
001C01r 2  E6 C7                inc q5
001C03r 2  C6 C6                dec q4
001C05r 2  D0 C6                bne @rl
001C07r 2  A9 01        @set:   lda #1
001C09r 2  85 B2                sta fd
001C0Br 2  A5 B2        @draw:  lda fd
001C0Dr 2  18                   clc
001C0Er 2  69 64                adc #100
001C10r 2  4C rr rr             jmp m_addsprite
001C13r 2               
001C13r 2               ; ============================================================================
001C13r 2               ; Status bar digits (drawn into the bar master image in bank 4)  [main RAM]
001C13r 2               ; ============================================================================
001C13r 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the digits and the bar art
001C13r 2               ; draw digit A at bar pixel column X (even), digit slot Y (0..8): copies a 64-byte digit
001C13r 2               ; tile into the bar image.
001C13r 2               ;
001C13r 2               ; Each buffer remembers the nine values its bar was last drawn with, because redraw_hud
001C13r 2               ; redraws all nine whenever anything changes and a score tick usually moves only one of
001C13r 2               ; them -- the other eight were 128 bytes of copy for no pixels (measured 5.0K cycles a
001C13r 2               ; render on an L0 run, 3.2% of the frame).  The bank is BANK_LVL on entry and on exit, so
001C13r 2               ; the skip path must not touch it.
001C13r 2               bar_digit:
001C13r 2  D9 rr rr             cmp BARCACHE,y              ; one bar, so one cache: no curbuf in the index
001C16r 2  F0 59                beq bd_same
001C18r 2  99 rr rr             sta BARCACHE,y
001C1Br 2                 .if .not MODELB
001C1Br 2                       pha
001C1Br 2                       setbank HUD_BANK
001C1Br 2                       pla
001C1Br 2                 .endif
001C1Br 2  4A                   lsr                         ; C = d bit0, A = d >> 1
001C1Cr 2  85 rr                sta w16+1
001C1Er 2  A9 00                lda #0
001C20r 2  6A                   ror                         ; A = d0 << 7
001C21r 2  46 rr                lsr w16+1                   ; C = d bit1, w16+1 = d >> 2
001C23r 2  6A                   ror                         ; A = d1 << 7 | d0 << 6
001C24r 2  18                   clc
001C25r 2  69 rr                adc #<SPR_DIGITS
001C27r 2  85 rr                sta w16
001C29r 2  A5 rr                lda w16+1
001C2Br 2  69 rr                adc #>SPR_DIGITS
001C2Dr 2  85 rr                sta w16+1                   ; digit tile
001C2Fr 2  8A                   txa
001C30r 2  29 FE                and #$FE                    ; char = x/2, then *8 -- i.e. (x & $FE) * 4
001C32r 2  48 A9 00 85          stza ptr+1
001C36r 2  rr 68        
001C38r 2  0A                   asl
001C39r 2  26 rr                rol ptr+1
001C3Br 2  0A                   asl
001C3Cr 2  26 rr                rol ptr+1
001C3Er 2  69 00                adc #<BARADDR               ; straight into the back buffer's bar row (no offscreen
001C40r 2  85 rr                sta ptr                     ; buffer): bank 4 glyph at $8xxx, screen bar at $7Bxx
001C42r 2  A5 rr                lda ptr+1                   ; C is already clear: ptr+1 was 0 or 1 before the second
001C44r 2  69 03                adc #>BARADDR               ; rol, so that rol shifted a 0 out
001C46r 2  85 rr                sta ptr+1
001C48r 2  A0 1F                ldy #31
001C4Ar 2  B1 rr        :       lda (w16),y
001C4Cr 2  91 rr                sta (ptr),y
001C4Er 2  88                   dey
001C4Fr 2  10 F9                bpl :-
001C51r 2  A5 rr                lda w16
001C53r 2  69 20                adc #32                     ; C still clear: ptr+1 <= 3 and >BARADDR = $7B, so the
001C55r 2  85 rr                sta w16                     ; adc above cannot carry, and the copy loop leaves C
001C57r 2  90 02                bcc @nc
001C59r 2  E6 rr                inc w16+1
001C5Br 2  18 A5 rr 69  @nc:    add16i ptr, 640
001C5Fr 2  80 85 rr A5  
001C63r 2  rr 69 02 85  
001C68r 2  A0 1F                ldy #31
001C6Ar 2  B1 rr        :       lda (w16),y
001C6Cr 2  91 rr                sta (ptr),y
001C6Er 2  88                   dey
001C6Fr 2  10 F9                bpl :-
001C71r 2                 .if .not MODELB
001C71r 2                       setbank BANK_LVL
001C71r 2                 .endif
001C71r 2               bd_same:
001C71r 2  60                   rts
001C72r 2               
001C72r 2               bar_touch:
001C72r 2  A9 01                lda #1
001C74r 2  85 A3                sta BARDIRTY
001C76r 2  60                   rts
001C77r 2               
001C77r 2               redraw_hud:
001C77r 2  20 rr rr             jsr draw_lives
001C7Ar 2  20 rr rr             jsr draw_health
001C7Dr 2  20 rr rr             jsr draw_stars
001C80r 2  4C rr rr             jmp draw_score
001C83r 2               
001C83r 2               draw_lives:
001C83r 2  A5 rr                lda lives
001C85r 2  A2 12                ldx #18
001C87r 2  A0 00                ldy #0
001C89r 2  4C rr rr             jmp bar_digit
001C8Cr 2               draw_health:
001C8Cr 2  A5 rr                lda health
001C8Er 2  A2 2E                ldx #46
001C90r 2  A0 01                ldy #1
001C92r 2  4C rr rr             jmp bar_digit
001C95r 2               draw_stars:                         ; stars remaining: 2 digits at 74, 82
001C95r 2  A5 rr                lda stars
001C97r 2  20 rr rr             jsr div10
001C9Ar 2  A2 4A                ldx #74
001C9Cr 2  A0 02                ldy #2
001C9Er 2  20 rr rr             jsr bar_digit
001CA1r 2  A5 C3                lda q1
001CA3r 2  A2 52                ldx #82
001CA5r 2  A0 03                ldy #3
001CA7r 2  4C rr rr             jmp bar_digit
001CAAr 2               ; A = A / 10 ; q1 = A mod 10
001CAAr 2  A2 00        div10:  ldx #0
001CACr 2  C9 0A        :       cmp #10
001CAEr 2  90 06                bcc :+
001CB0r 2  E9 0A                sbc #10
001CB2r 2  E8                   inx
001CB3r 2  4C rr rr             bra :-
001CB6r 2  85 C3        :       sta q1
001CB8r 2  8A                   txa
001CB9r 2  60                   rts
001CBAr 2               draw_score:                         ; 5 digits at 108..140
001CBAr 2  A5 rr 85 D1          mov16 t16, score
001CBEr 2  A5 rr 85 D2  
001CC2r 2  A2 04                ldx #4
001CC4r 2  8A 48        @d:     phx
001CC6r 2                       ; t16 /= 10 -> remainder
001CC6r 2  20 rr rr             jsr div10_16
001CC9r 2  68 AA                plx
001CCBr 2  8A 48                phx
001CCDr 2  8A                   txa
001CCEr 2  18                   clc
001CCFr 2  69 04                adc #4                      ; score digits are slots 4..8
001CD1r 2  A8                   tay
001CD2r 2  0A                   asl
001CD3r 2  0A                   asl
001CD4r 2  0A                   asl
001CD5r 2  69 4C                adc #76                     ; (X+4)*8 + 76 = X*8 + 108
001CD7r 2  AA                   tax
001CD8r 2  A5 C3                lda q1
001CDAr 2  20 rr rr             jsr bar_digit
001CDDr 2  68 AA                plx
001CDFr 2  CA                   dex
001CE0r 2  10 E2                bpl @d
001CE2r 2  60                   rts
001CE3r 2               ; t16 = t16 / 10 ; q1 = remainder
001CE3r 2               div10_16:
001CE3r 2  48 A9 00 85          stza q1
001CE7r 2  C3 68        
001CE9r 2  A2 10                ldx #16
001CEBr 2  A5 C3                lda q1                  ; remainder lives in A for the whole loop
001CEDr 2  06 D1        @l:     asl t16
001CEFr 2  26 D2                rol t16+1
001CF1r 2  2A                   rol a                   ; was rol q1 / lda q1
001CF2r 2  C9 0A                cmp #10
001CF4r 2  90 04                bcc :+
001CF6r 2  E9 0A                sbc #10                 ; was sbc #10 / sta q1
001CF8r 2  E6 D1                inc t16
001CFAr 2  CA           :       dex
001CFBr 2  D0 F0                bne @l
001CFDr 2  85 C3                sta q1
001CFFr 2  60                   rts
001D00r 2               
001D00r 2                       PLACE "LOGIC", "LGCCODE"
001D00r 2               ; ============================================================================
001D00r 2               ; Sound effect ids
001D00r 2               ; ============================================================================
001D00r 2               SFX_JUMP  = 1
001D00r 2               SFX_STAR  = 2
001D00r 2               SFX_THROW = 3
001D00r 2               SFX_HIT   = 4
001D00r 2               SFX_KILL  = 5
001D00r 2               SFX_POWER = 6
001D00r 2               SFX_DIE   = 7
001D00r 2               
001D00r 1                       .include "game.s"
001D00r 2               ; ============================================================================
001D00r 2               ; CLEO - the game: level loading, the camera clamp, the level and frame loops,
001D00r 2               ; the sound effects.  Shared by the Master (main.s) and the Model B
001D00r 2               ; (modelb/src/main.s); what differs between them is under MODELB.
001D00r 2               ; ============================================================================
001D00r 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the logic it drives
001D00r 2               ; ---------------------------------------------------------------- level loading
001D00r 2               ; X = level index 0..15 (even = main, odd = bonus)
001D00r 2               load_level:
001D00r 2                 .if .not MODELB                   ; (Model B: the one level is resident)
001D00r 2                       ; file order is L0A, L0B, L1A, ..., two files each, and level index 0 is the
001D00r 2                       ; main level, which is the 'B' one: file = FI_L0A + (i eor 1) * 2
001D00r 2                       txa
001D00r 2                       eor #1
001D00r 2                       asl                         ; two pieces: map, bank-7 tables
001D00r 2                       clc
001D00r 2                       adc #FI_L0A
001D00r 2                       sta tmp2
001D00r 2                       jsr loadfile
001D00r 2                       lda tmp2
001D00r 2                       inca
001D00r 2                       jsr loadfile
001D00r 2                       jsr load_tiles              ; only the tiles this level's page tables name
001D00r 2                       ; geometry
001D00r 2                       setbank BANK_LVL
001D00r 2                 .endif
001D00r 2  AD rr rr             lda LV_HDR
001D03r 2  85 rr                sta maplw
001D05r 2  AD rr rr             lda LV_HDR+1
001D08r 2  85 rr                sta maplh
001D0Ar 2                       ; mapw = 8 << lw ; maph = 8 << lh
001D0Ar 2  A9 08                lda #8
001D0Cr 2  85 rr                sta mapw
001D0Er 2  48 A9 00 85          stza mapw+1
001D12r 2  rr 68        
001D14r 2  A6 rr                ldx maplw
001D16r 2  06 rr        :       asl mapw
001D18r 2  26 rr                rol mapw+1
001D1Ar 2  CA                   dex
001D1Br 2  D0 F9                bne :-
001D1Dr 2  A9 08                lda #8
001D1Fr 2  85 rr                sta maph
001D21r 2  48 A9 00 85          stza maph+1
001D25r 2  rr 68        
001D27r 2  A6 rr                ldx maplh
001D29r 2  06 rr        :       asl maph
001D2Br 2  26 rr                rol maph+1
001D2Dr 2  CA                   dex
001D2Er 2  D0 F9                bne :-
001D30r 2  A5 rr                lda mapw
001D32r 2  38                   sec
001D33r 2  E9 A0                sbc #WINPX
001D35r 2  85 rr                sta maxwx
001D37r 2  A5 rr                lda mapw+1
001D39r 2  E9 00                sbc #0
001D3Br 2  85 rr                sta maxwx+1
001D3Dr 2  A5 rr                lda maph
001D3Fr 2  38                   sec
001D40r 2  E9 54                sbc #VISLINES/2
001D42r 2  85 rr                sta maxwy
001D44r 2  A5 rr                lda maph+1
001D46r 2  E9 00                sbc #0
001D48r 2  85 rr                sta maxwy+1
001D4Ar 2                 .if MODELB
001D4Ar 2  A2 0C 20 rr          farjsr F_LVRESET            ; the records and the dirty lists are bank 5's
001D4Er 2  rr           
001D4Fr 2                 .else
001D4Fr 2                       stza BUF_VALID
001D4Fr 2                       stza BUF_VALID+1
001D4Fr 2                       stza RECCNT
001D4Fr 2                       stza RECCNT+1
001D4Fr 2                       stza DIRTYCNT
001D4Fr 2                       stza DIRTYCNT+1
001D4Fr 2                 .endif
001D4Fr 2  48 A9 00 85          stza NSPR
001D53r 2  A2 68        
001D55r 2  60                   rts
001D56r 2               
001D56r 2                 .if .not MODELB                   ; the disc: the Model B loads its four bank images
001D56r 2               ; File table.  Five parallel arrays rather than five-byte records: there are more
001D56r 2               ; than fifty files now and index * 5 does not fit in a byte.
001D56r 2                       .include "files.inc"
001D56r 2                       .assert VMODE = 2 - MODE1, error, "assets were converted for the other MODE: rerun tools/convert.py"
001D56r 2               FTMODE .set 0
001D56r 2               .macro FILE sec, n, bank, dest
001D56r 2               .if FTMODE = 0
001D56r 2                       .byte <(sec)
001D56r 2               .elseif FTMODE = 1
001D56r 2                       .byte >(sec)
001D56r 2               .elseif FTMODE = 2
001D56r 2                       .byte n
001D56r 2               .elseif FTMODE = 3
001D56r 2                       .byte bank
001D56r 2               .else
001D56r 2                       .byte >(dest)
001D56r 2               .endif
001D56r 2               .endmacro
001D56r 2               .macro FILE_LIST
001D56r 2                       FILE F_SPR_SEC,   F_SPR_N,   BANK_SPR,  $8000
001D56r 2                       FILE F_TILESO_SEC, F_TILESO_N, BANK_TIL0, $8000
001D56r 2                       FILE F_TILESI_SEC, F_TILESI_N, BANK_TIL0, $8000
001D56r 2                       FILE F_LOGIC_SEC, <((__LOGIC_LAST__ - __LOGIC_START__ + 255) / 256), BANK_LVL, LOGIC_ADDR
001D56r 2                       FILE F_BOX_SEC,   F_BOX_N,   BANK_TIL1, BOX_BASE
001D56r 2                       FILE F_MUSIC_SEC, F_MUSIC_N, BANK_LVL,  MUSIC_ADDR
001D56r 2                       FILE F_ALT_SEC,   F_ALT_N,   BANK_LVL,  LV_ALTTAB
001D56r 2                       FILE F_TITLE_SEC, F_TITLE_N, BANK_MAP,  TITLE_ADDR
001D56r 2                       FILE F_L0A_SEC, LM_L0A, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L0A_SEC + LM_L0A, F_L0A_N - LM_L0A, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L0B_SEC, LM_L0B, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L0B_SEC + LM_L0B, F_L0B_N - LM_L0B, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L1A_SEC, LM_L1A, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L1A_SEC + LM_L1A, F_L1A_N - LM_L1A, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L1B_SEC, LM_L1B, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L1B_SEC + LM_L1B, F_L1B_N - LM_L1B, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L2A_SEC, LM_L2A, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L2A_SEC + LM_L2A, F_L2A_N - LM_L2A, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L2B_SEC, LM_L2B, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L2B_SEC + LM_L2B, F_L2B_N - LM_L2B, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L3A_SEC, LM_L3A, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L3A_SEC + LM_L3A, F_L3A_N - LM_L3A, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L3B_SEC, LM_L3B, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L3B_SEC + LM_L3B, F_L3B_N - LM_L3B, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L4A_SEC, LM_L4A, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L4A_SEC + LM_L4A, F_L4A_N - LM_L4A, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L4B_SEC, LM_L4B, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L4B_SEC + LM_L4B, F_L4B_N - LM_L4B, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L5A_SEC, LM_L5A, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L5A_SEC + LM_L5A, F_L5A_N - LM_L5A, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L5B_SEC, LM_L5B, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L5B_SEC + LM_L5B, F_L5B_N - LM_L5B, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L6A_SEC, LM_L6A, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L6A_SEC + LM_L6A, F_L6A_N - LM_L6A, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L6B_SEC, LM_L6B, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L6B_SEC + LM_L6B, F_L6B_N - LM_L6B, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L7A_SEC, LM_L7A, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L7A_SEC + LM_L7A, F_L7A_N - LM_L7A, BANK_LVL, LV_HDR
001D56r 2                       FILE F_L7B_SEC, LM_L7B, BANK_MAP, LV_MAP
001D56r 2                       FILE F_L7B_SEC + LM_L7B, F_L7B_N - LM_L7B, BANK_LVL, LV_HDR
001D56r 2                       FILE F_SPRAND_SEC, F_SPRAND_N, BANK_SPR|$80, $8000   ; -> ANDY (ROMSEL bit7)
001D56r 2               .endmacro
001D56r 2               FTMODE .set 0
001D56r 2               ft_seclo: FILE_LIST
001D56r 2               FTMODE .set 1
001D56r 2               ft_sechi: FILE_LIST
001D56r 2               FTMODE .set 2
001D56r 2               ft_n:     FILE_LIST
001D56r 2               FTMODE .set 3
001D56r 2               ft_bank:  FILE_LIST
001D56r 2               FTMODE .set 4
001D56r 2               ft_dest:  FILE_LIST
001D56r 2               
001D56r 2               FI_SPR = 0
001D56r 2               FI_TILESO = 1                     ; the two tile sets, outdoors and indoors
001D56r 2               FI_TILESI = 2
001D56r 2               FI_LOGIC = 3
001D56r 2               FI_BOX = 4
001D56r 2               FI_MUSIC = 5
001D56r 2               FI_ALT = 6
001D56r 2               FI_TITLE = 7
001D56r 2               FI_L0A = 8                        ; two pieces per level: map, bank-7 tables
001D56r 2               FI_SPRAND = 40
001D56r 2               
001D56r 2                 .endif
001D56r 2               
001D56r 2               ; ---------------------------------------------------------------- camera clamp
001D56r 2               ; clamp wx to [0, maxwx] (and even), wy to [0, maxwy]
001D56r 2               clamp_window:
001D56r 2  A5 rr                lda wx+1
001D58r 2  30 15                bmi @wx0
001D5Ar 2  A5 rr                lda wx
001D5Cr 2  C5 rr                cmp maxwx
001D5Er 2  A5 rr                lda wx+1
001D60r 2  E5 rr                sbc maxwx+1
001D62r 2  30 13                bmi @wxok
001D64r 2  A5 rr                lda maxwx
001D66r 2  85 rr                sta wx
001D68r 2  A5 rr                lda maxwx+1
001D6Ar 2  85 rr                sta wx+1
001D6Cr 2  4C rr rr             bra @wxok
001D6Fr 2  A9 00 85 rr  @wx0:   stz wx
001D73r 2  A9 00 85 rr          stz wx+1
001D77r 2               @wxok:
001D77r 2                 .if MODELB
001D77r 2  A5 rr                lda wx
001D79r 2  29 FE                and #$FE
001D7Br 2  85 rr                sta wx
001D7Dr 2                 .else
001D7Dr 2                       lda #1
001D7Dr 2                       trb wx                      ; wx &= ~1 : the 65C02 does this in one RMW
001D7Dr 2                 .endif
001D7Dr 2  A5 rr                lda wy+1
001D7Fr 2  30 13                bmi @wy0
001D81r 2  A5 rr                lda wy
001D83r 2  C5 rr                cmp maxwy
001D85r 2  A5 rr                lda wy+1
001D87r 2  E5 rr                sbc maxwy+1
001D89r 2  30 15                bmi @wyok
001D8Br 2  A5 rr                lda maxwy
001D8Dr 2  85 rr                sta wy
001D8Fr 2  A5 rr                lda maxwy+1
001D91r 2  85 rr                sta wy+1
001D93r 2  60                   rts
001D94r 2  48 A9 00 85  @wy0:   stza wy
001D98r 2  rr 68        
001D9Ar 2  48 A9 00 85          stza wy+1
001D9Er 2  rr 68        
001DA0r 2  60           @wyok:  rts
001DA1r 2               
001DA1r 2               ; ---------------------------------------------------------------- game
001DA1r 2               game_main:
001DA1r 2  48 A9 00 85          stza hiscore
001DA5r 2  rr 68        
001DA7r 2  48 A9 00 85          stza hiscore+1
001DABr 2  rr 68        
001DADr 2  48 A9 00 85          stza maxlevel
001DB1r 2  rr 68        
001DB3r 2  48 A9 00 8D          stza title_res
001DB7r 2  rr rr 68     
001DBAr 2               title_loop:
001DBAr 2  20 rr rr             jsr t_title_menu
001DBDr 2  C9 01                cmp #MENU_HELP
001DBFr 2  D0 06                bne new_game
001DC1r 2  20 rr rr             jsr t_help_screen
001DC4r 2  4C rr rr             bra title_loop
001DC7r 2               new_game:
001DC7r 2                 .if MODELB
001DC7r 2  A9 02                lda #LEVEL_IDX              ; the level on the disc
001DC9r 2  85 rr                sta level
001DCBr 2                 .else
001DCBr 2                       stz level
001DCBr 2                 .endif
001DCBr 2  A9 03                lda #3
001DCDr 2  85 rr                sta lives
001DCFr 2  85 rr                sta health
001DD1r 2  A9 00 85 rr          stz score
001DD5r 2  A9 00 85 rr          stz score+1
001DD9r 2  A5 rr                lda maxlevel
001DDBr 2  F0 06                beq level_loop
001DDDr 2  20 rr rr             jsr t_level_select
001DE0r 2  0A                   asl
001DE1r 2  85 rr                sta level
001DE3r 2               level_loop:
001DE3r 2                 .if MODELB
001DE3r 2  20 rr rr             jsr blank_palette
001DE6r 2  A9 02                lda #LEVEL_IDX              ; whatever the last level's end made of 'level'
001DE8r 2  85 rr                sta level
001DEAr 2                 .else
001DEAr 2                       jsr blank_palette           ; hide the loading and the first-frame build-up
001DEAr 2                       stza title_res               ; the level's map replaces the title pack
001DEAr 2                       lda #FI_BOX                  ; and the title pack replaced the box stars
001DEAr 2                       jsr loadfile
001DEAr 2                       ldx level
001DEAr 2                 .endif
001DEAr 2  20 rr rr             jsr load_level
001DEDr 2  20 rr rr             jsr t_level_init
001DF0r 2  A9 01                lda #1                      ; lay the bar template + digits into both buffers on
001DF2r 2  85 A4                sta BARBG                   ; the first two renders (drawing now would hit the
001DF4r 2  85 A3                sta BARDIRTY
001DF6r 2                       ; initial camera; render both buffers before the palette comes back
001DF6r 2  20 rr rr             jsr t_game_frame
001DF9r 2  20 rr rr             jsr render_frame
001DFCr 2  48 A9 00 85          stza NSPR
001E00r 2  A2 68        
001E02r 2  20 rr rr             jsr t_game_frame
001E05r 2  20 rr rr             jsr render_frame
001E08r 2  20 rr rr             jsr set_palette
001E0Br 2  A9 00 85 A2          stz NSPR
001E0Fr 2  A5 rr                lda vsyncs
001E11r 2  85 rr                sta logicvs
001E13r 2  A9 00 85 rr          stz pausing
001E17r 2               frame_loop:
001E17r 2                       ; pause?
001E17r 2  A5 rr                lda keys
001E19r 2  29 20                and #K_MENU
001E1Br 2  F0 19                beq fl_nopause
001E1Dr 2  A5 rr                lda pausing
001E1Fr 2  D0 15                bne fl_nopause
001E21r 2  20 rr rr             jsr t_pause_menu
001E24r 2  C9 00                cmp #0
001E26r 2  F0 03                beq :+
001E28r 2  4C rr rr             jmp title_loop
001E2Br 2  A9 01        :       lda #1
001E2Dr 2  85 rr                sta pausing
001E2Fr 2  A5 rr                lda vsyncs
001E31r 2  85 rr                sta logicvs
001E33r 2  4C rr rr             bra frame_loop
001E36r 2               fl_nopause:
001E36r 2  A5 rr                lda keys
001E38r 2  29 20                and #K_MENU
001E3Ar 2  D0 04                bne :+
001E3Cr 2  A9 00 85 rr          stz pausing
001E40r 2               :       ; The peg is three vsyncs -- 16.7Hz of render -- and the logic takes two
001E40r 2                       ; steps for each one, so the player, every animation and every enemy move
001E40r 2                       ; twice as far per frame as they used to.  Two steps is a fixed pairing,
001E40r 2                       ; not catching up: time lost to a long frame is still dropped, so the
001E40r 2                       ; window never moves more in a frame than these two steps ask for.
001E40r 2  A5 rr                lda vsyncs
001E42r 2  38                   sec
001E43r 2  E5 rr                sbc logicvs
001E45r 2  C9 03                cmp #VSPEG
001E47r 2  90 24                bcc fl_wait
001E49r 2  A5 rr                lda vsyncs
001E4Br 2  85 rr                sta logicvs
001E4Dr 2               frame_top:                          ; exactly once per rendered frame, before the two
001E4Dr 2                                                   ; logic steps read 'keys': the test harness breaks
001E4Dr 2                                                   ; here so every wait and every input it applies is
001E4Dr 2                                                   ; quantised to a frame boundary (tools/harness.mjs)
001E4Dr 2  48 A9 00 85          stza NSPR                   ; the list is rebuilt by each step; only the
001E51r 2  A2 68        
001E53r 2  20 rr rr             jsr t_game_frame            ; second one's survives to be drawn
001E56r 2  A5 rr                lda exiting
001E58r 2  D0 1C                bne fl_over
001E5Ar 2  48 A9 00 85          stza NSPR
001E5Er 2  A2 68        
001E60r 2  20 rr rr             jsr t_game_frame
001E63r 2  A5 rr                lda exiting
001E65r 2  D0 0F                bne fl_over
001E67r 2  20 rr rr             jsr render_frame
001E6Ar 2  4C rr rr             bra frame_loop
001E6Dr 2               fl_wait:  ; nothing to do yet: wait for the next vsync
001E6Dr 2  A5 rr                lda vsyncs
001E6Fr 2  C5 rr        :       cmp vsyncs
001E71r 2  F0 FC                beq :-
001E73r 2  4C rr rr             bra frame_loop
001E76r 2               fl_over:
001E76r 2                       ; level over
001E76r 2  A5 rr                lda lives
001E78r 2  F0 1D                beq game_over
001E7Ar 2  A5 rr                lda stars
001E7Cr 2  F0 07                beq @next1
001E7Er 2  A5 rr                lda level
001E80r 2  4A                   lsr                         ; C = bit 0
001E81r 2  B0 02                bcs @next1
001E83r 2  E6 rr                inc level
001E85r 2  E6 rr        @next1: inc level
001E87r 2  A5 rr                lda level
001E89r 2  C9 10                cmp #16
001E8Br 2  F0 15                beq game_won
001E8Dr 2  4A                   lsr
001E8Er 2  C5 rr                cmp maxlevel
001E90r 2  90 02                bcc :+
001E92r 2  85 rr                sta maxlevel
001E94r 2  4C rr rr     :       jmp level_loop
001E97r 2               game_over:
001E97r 2  20 rr rr             jsr update_hiscore
001E9Ar 2  A9 00                lda #0
001E9Cr 2  20 rr rr             jsr t_winlose
001E9Fr 2  4C rr rr             jmp title_loop
001EA2r 2               game_won:
001EA2r 2  20 rr rr             jsr update_hiscore
001EA5r 2  A9 01                lda #1
001EA7r 2  20 rr rr             jsr t_winlose
001EAAr 2  4C rr rr             jmp title_loop
001EADr 2               update_hiscore:
001EADr 2  A5 rr                lda hiscore
001EAFr 2  C5 rr                cmp score
001EB1r 2  A5 rr                lda hiscore+1
001EB3r 2  E5 rr                sbc score+1
001EB5r 2  B0 08                bcs :+
001EB7r 2  A5 rr 85 rr          mov16 hiscore, score
001EBBr 2  A5 rr 85 rr  
001EBFr 2  60           :       rts
001EC0r 2               
001EC0r 2               ; ---------------------------------------------------------------- sound data
001EC0r 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with sound_tick
001EC0r 2               ; sfx steps: byte0 = channel/period latch ($80 | ch<<5 | lo4), byte1 = period hi (data byte), byte2 = volume ($90|ch<<5|att), duration
001EC0r 2  rr rr rr rr  sfxtab: .word sfx_jump, sfx_star, sfx_throw, sfx_hit, sfx_kill, sfx_power, sfx_die
001EC4r 2  rr rr rr rr  
001EC8r 2  rr rr rr rr  
001ECEr 2  C8 0C D0 02  sfx_jump:  .byte $C0|8, 12, $D0, 2,  $C0|4, 9, $D2, 2,  $C0|0, 7, $D4, 2,  $C0|8, 5, $D6, 3, $FF
001ED2r 2  C4 09 D2 02  
001ED6r 2  C0 07 D4 02  
001EDFr 2  C0 04 D0 02  sfx_star:  .byte $C0|0, 4, $D0, 2,  $C0|0, 3, $D0, 3,  $C0|0, 3, $D6, 3, $FF
001EE3r 2  C0 03 D0 03  
001EE7r 2  C0 03 D6 03  
001EECr 2  E4 00 F2 02  sfx_throw: .byte $E0|4, 0, $F2, 2,  $E0|5, 0, $F5, 3,  $E0|5, 0, $F9, 3, $FF
001EF0r 2  E5 00 F5 03  
001EF4r 2  E5 00 F9 03  
001EF9r 2  C0 28 D0 04  sfx_hit:   .byte $C0|0, 40, $D0, 4, $C0|0, 48, $D2, 4, $C0|0, 60, $D5, 5, $FF
001EFDr 2  C0 30 D2 04  
001F01r 2  C0 3C D5 05  
001F06r 2  C0 06 D0 02  sfx_kill:  .byte $C0|0, 6, $D0, 2,  $C0|0, 9, $D1, 2,  $C0|0, 12, $D3, 3, $C0|0, 16, $D6, 3, $FF
001F0Ar 2  C0 09 D1 02  
001F0Er 2  C0 0C D3 03  
001F17r 2  C0 06 D0 03  sfx_power: .byte $C0|0, 6, $D0, 3,  $C0|0, 5, $D0, 3,  $C0|0, 4, $D0, 3,  $C0|0, 3, $D0, 6, $FF
001F1Br 2  C0 05 D0 03  
001F1Fr 2  C0 04 D0 03  
001F28r 2  C0 0C D0 06  sfx_die:   .byte $C0|0, 12, $D0, 6, $C0|0, 16, $D1, 6, $C0|0, 22, $D2, 8, $C0|0, 30, $D4, 10, $C0|0, 40, $D7, 12, $FF
001F2Cr 2  C0 10 D1 06  
001F30r 2  C0 16 D2 08  
001F3Dr 2               
001F3Dr 2               
001F3Dr 1                       .include "low.s"
001F3Dr 2               ; ============================================================================
001F3Dr 2               ; Main RAM, $0140-$02FF: what has to be visible whatever bank is paged in.  The
001F3Dr 2               ; far-call thunk, the interrupt stub (the handler itself is in bank 7), the two
001F3Dr 2               ; map fetches the tile blitter makes from bank 5, and the sprite list.  The
001F3Dr 2               ; Master's own main-RAM map helpers (maprow, mapbyte, mapput, pagelogic) land here
001F3Dr 2               ; too, from engine.s: they page bank 6 in and bank 7 back exactly as they do there.
001F3Dr 2               ; ============================================================================
001F3Dr 2                       .segment "LOWCODE"
000038r 2               
000038r 2               ; ---------------------------------------------------------------- far calls
000038r 2               ; X = the index of a (bank, address-1) entry in FARTAB, which every bank carries at
000038r 2               ; the same address.  A goes in and comes back, Y is untouched, X is destroyed.
000038r 2               ; Everything is on the stack -- the caller's bank, the return into fcret, the target
000038r 2               ; -- so it nests and a step of the interrupt handler can land anywhere in it: the
000038r 2               ; handler reads the bank from $F4 and puts it back, which is the MOS's own rule.
000038r 2               ;
000038r 2               ;   caller's return
000038r 2               ;   A on entry
000038r 2               ;   caller's bank          <- fcret pulls this
000038r 2               ;   fcret-1                <- the target's rts lands here
000038r 2               ;   target-1               <- this rts goes there
000038r 2               farcall:
000038r 2  48                   pha
000039r 2  A5 F4                lda ROMSEL_CPY
00003Br 2  48                   pha
00003Cr 2  A9 rr                lda #>(fcret-1)
00003Er 2  48                   pha
00003Fr 2  A9 rr                lda #<(fcret-1)
000041r 2  48                   pha
000042r 2  BD 02 80             lda FARTAB+2,x
000045r 2  48                   pha
000046r 2  BD 01 80             lda FARTAB+1,x
000049r 2  48                   pha
00004Ar 2  BD 00 80             lda FARTAB,x
00004Dr 2  85 F4                sta ROMSEL_CPY
00004Fr 2  8D 30 FE             sta ROMSEL
000052r 2  BA                   tsx
000053r 2  BD 06 01             lda $0106,x                 ; A as it came in
000056r 2  60                   rts
000057r 2  AA           fcret:  tax                         ; the target's A
000058r 2  68                   pla
000059r 2  85 F4                sta ROMSEL_CPY              ; the caller's bank
00005Br 2  8D 30 FE             sta ROMSEL
00005Er 2  68                   pla                         ; (the A that went in)
00005Fr 2  8A                   txa
000060r 2  60                   rts
000061r 2               
000061r 2               ; ---------------------------------------------------------------- interrupts
000061r 2               ; The chain step and the vsync work are in bank 7 with their tables: this pages it
000061r 2               ; in around them.  The step's timing (VS2T_DEFAULT) allows for the ~30 cycles that
000061r 2               ; takes, in place of the hold loop the Master's handler has.
000061r 2               irq_handler:
000061r 2  86 rr                stx irq_x
000063r 2  84 rr                sty irq_y
000065r 2  A5 F4                lda ROMSEL_CPY
000067r 2  48                   pha
000068r 2  A9 07                lda #BANK_LVL
00006Ar 2  85 F4                sta ROMSEL_CPY
00006Cr 2  8D 30 FE             sta ROMSEL
00006Fr 2  20 rr rr             jsr isr_body
000072r 2  68                   pla
000073r 2  85 F4                sta ROMSEL_CPY
000075r 2  8D 30 FE             sta ROMSEL
000078r 2  A4 rr                ldy irq_y
00007Ar 2  A6 rr                ldx irq_x
00007Cr 2  A5 FC                lda $FC
00007Er 2  40                   rti
00007Fr 2               
00007Fr 2               ; the start-up's switch from bank 6 to bank 7 (init.s): a bank cannot page itself out
00007Fr 2  A9 07        to7:    lda #BANK_LVL
000081r 2  85 F4                sta ROMSEL_CPY
000083r 2  8D 30 FE             sta ROMSEL
000086r 2  4C rr rr             jmp start7
000089r 2               
000089r 2               ; ---------------------------------------------------------------- the tile blitter's map
000089r 2               ; drawrect runs in bank 5 and reads the map in bank 6: the row pointer is arithmetic
000089r 2               ; (MAPSTRIDE is a constant here, so there are no row tables) and the strip copy is
000089r 2               ; the one bank switch a tile row costs.
000089r 2               maprow5:                            ; A = tile row -> ptr = LV_MAP + row*MAPSTRIDE + rc_tx0
000089r 2                 .if MAPLW = 7
000089r 2  4A                   lsr                         ; row * 128: the row's low bit is the low byte's top
00008Ar 2  85 rr                sta ptr+1
00008Cr 2  A9 00                lda #0
00008Er 2  6A                   ror
00008Fr 2  18                   clc
000090r 2  65 rr                adc rc_tx0                  ; < 128, so no carry out
000092r 2  85 rr                sta ptr
000094r 2  A5 rr                lda ptr+1
000096r 2  18                   clc
000097r 2  69 rr                adc #>LV_MAP
000099r 2  85 rr                sta ptr+1
00009Br 2  60                   rts
00009Cr 2                 .elseif MAPLW = 8
00009Cr 2                       clc                         ; row * 256: the row is the high byte
00009Cr 2                       adc #>LV_MAP
00009Cr 2                       sta ptr+1
00009Cr 2                       lda rc_tx0
00009Cr 2                       sta ptr
00009Cr 2                       rts
00009Cr 2                 .else
00009Cr 2                       .error "maprow5: a map is 128 or 256 tiles wide"
00009Cr 2                 .endif
00009Cr 2               
00009Cr 2               mapstrip:                           ; (ptr), 0..rc_nt -> MAPBUF
00009Cr 2  A9 06                lda #BANK_MAP
00009Er 2  85 F4                sta ROMSEL_CPY
0000A0r 2  8D 30 FE             sta ROMSEL
0000A3r 2  A4 rr                ldy rc_nt
0000A5r 2  B1 rr        :       lda (ptr),y
0000A7r 2  99 rr rr             sta MAPBUF,y
0000AAr 2  88                   dey
0000ABr 2  10 F8                bpl :-
0000ADr 2  A9 05                lda #BANK_TILES
0000AFr 2  85 F4                sta ROMSEL_CPY
0000B1r 2  8D 30 FE             sta ROMSEL
0000B4r 2  60                   rts
0000B5r 2               
0000B5r 2               ; the sprite directory is in bank 6 and the prologue in bank 5: an entry's eight
0000B5r 2               ; bytes come across here, and ptr is left pointing at the copy
0000B5r 2               dirfetch:                           ; ptr -> the entry in SPR_TABLE
0000B5r 2  A9 06                lda #BANK_TIL1
0000B7r 2  85 F4                sta ROMSEL_CPY
0000B9r 2  8D 30 FE             sta ROMSEL
0000BCr 2  A0 07                ldy #7
0000BEr 2  B1 rr        :       lda (ptr),y
0000C0r 2  99 rr rr             sta MAPBUF,y
0000C3r 2  88                   dey
0000C4r 2  10 F8                bpl :-
0000C6r 2  A9 05                lda #BANK_TILES
0000C8r 2  85 F4                sta ROMSEL_CPY
0000CAr 2  8D 30 FE             sta ROMSEL
0000CDr 2  A9 rr                lda #<MAPBUF
0000CFr 2  85 rr                sta ptr
0000D1r 2  A9 rr                lda #>MAPBUF
0000D3r 2  85 rr                sta ptr+1
0000D5r 2  60                   rts
0000D6r 2               
0000D6r 2                       .segment "LOWBSS"
00008Cr 2  xx xx xx xx  MAPBUF:   .res 21                   ; a tile row of the rectangle: 21 tiles at most
000090r 2  xx xx xx xx  
000094r 2  xx xx xx xx  
0000A1r 2               ; the mirror's bookkeeping (display.s): the blitters in bank 5 note what they wrote
0000A1r 2               ; to the ring's last slot row, the copy in bank 7 reads it
0000A1r 2  xx xx        mirdty:   .res 2                    ; per buffer: the row has been written since the copy
0000A3r 2  xx xx        mirlo:    .res 2                    ; and which chars of it (in slot chars, 0..79)
0000A5r 2  xx xx        mirhi:    .res 2
0000A7r 2  xx xx        mirwcx:   .res 2                    ; the wcxm the copy was made for
0000A9r 2               
0000A9r 1                       .include "display.s"
0000A9r 2               ; ============================================================================
0000A9r 2               ; The Model B's display driver: bank 7, with the logic.  The rupture chain the CRTC is driven by,
0000A9r 2               ; the mirror the straddling row is read from, and the interrupt's work.  The Master
0000A9r 2               ; needs none of this -- its ring is hardware wrapped -- so it is the one part of the
0000A9r 2               ; renderer that is this target's own (DESIGN.md, "the display").
0000A9r 2               ; ============================================================================
0000A9r 2                       .segment "LGCCODE"
001F3Dr 2               
001F3Dr 2               ; ---------------------------------------------------------------- the interrupt
001F3Dr 2               ; Reached from the stub in low RAM with this bank paged in and X, Y saved.
001F3Dr 2               isr_body:
001F3Dr 2  2C 4D FE             bit VIA_IFR
001F40r 2  70 0A                bvs @t1
001F42r 2  AD 4D FE             lda VIA_IFR
001F45r 2  29 02                and #$02
001F47r 2  F0 68                beq @exit
001F49r 2  4C rr rr             jmp vsync_tick
001F4Cr 2               @t1:    ; A rupture step is a CRTC restart: R12/R13 were armed during the section
001F4Cr 2                       ; before and latch at the boundary; R9 with R4 decide where the section ends
001F4Cr 2                       ; and are compared at the start of its last scanline, and R6 from scanline 1
001F4Cr 2                       ; on.  The chain is phased so the step fires ~60 cycles BEFORE the restart;
001F4Cr 2                       ; the stub's bank switch carries the first write past it.
001F4Cr 2  AE rr rr             ldx SECIDX
001F4Fr 2  A9 09                lda #9
001F51r 2  8D 00 FE             sta CRTC_IDX
001F54r 2  BD rr rr             lda SECTAB+3,x
001F57r 2  8D 01 FE             sta CRTC_DAT
001F5Ar 2  A9 04                lda #4
001F5Cr 2  8D 00 FE             sta CRTC_IDX
001F5Fr 2  BD rr rr             lda SECTAB+2,x
001F62r 2  8D 01 FE             sta CRTC_DAT
001F65r 2  A9 06                lda #6
001F67r 2  8D 00 FE             sta CRTC_IDX
001F6Ar 2  BC rr rr             ldy SECTAB+4,x
001F6Dr 2  8C 01 FE             sty CRTC_DAT
001F70r 2  A9 07                lda #7
001F72r 2  8D 00 FE             sta CRTC_IDX
001F75r 2  BD rr rr             lda SECTAB+5,x
001F78r 2  8D 01 FE             sta CRTC_DAT
001F7Br 2  8D rr rr             sta curR7                   ; the vsync handler re-phases the frame from this
001F7Er 2  A9 0C                lda #12
001F80r 2  8D 00 FE             sta CRTC_IDX
001F83r 2  BD rr rr             lda SECTAB,x
001F86r 2  8D 01 FE             sta CRTC_DAT
001F89r 2  A9 0D                lda #13
001F8Br 2  8D 00 FE             sta CRTC_IDX
001F8Er 2  BD rr rr             lda SECTAB+1,x
001F91r 2  8D 01 FE             sta CRTC_DAT
001F94r 2  BD rr rr             lda SECTAB+6,x
001F97r 2  8D 46 FE             sta VIA_T1LL
001F9Ar 2  BD rr rr             lda SECTAB+7,x
001F9Dr 2  8D 47 FE             sta VIA_T1LH
001FA0r 2  AD 44 FE             lda VIA_T1CL                ; clear the T1 flag
001FA3r 2  AD rr rr             lda curR7                   ; the chain stops at Q, the only section whose R7
001FA6r 2  C9 08                cmp #QVSYNC                 ; is the vsync row: a late vsync must not walk it
001FA8r 2  F0 07                beq @exit                   ; off the end of SECTAB
001FAAr 2  8A                   txa
001FABr 2  18                   clc
001FACr 2  69 08                adc #8
001FAEr 2  8D rr rr             sta SECIDX
001FB1r 2  60           @exit:  rts
001FB2r 2               
001FB2r 2               ; ---- vsync: restart T1 first (constant latency), counter = vsync -> the bar
001FB2r 2               vsync_tick:
001FB2r 2  AD rr rr             lda VS2T
001FB5r 2  8D 46 FE             sta VIA_T1LL
001FB8r 2  AD rr rr             lda VS2T+1
001FBBr 2  8D 45 FE             sta VIA_T1CH
001FBEr 2  A9 02                lda #$02
001FC0r 2  8D 4D FE             sta VIA_IFR
001FC3r 2  A9 09                lda #9                      ; re-phase: end this frame curR7 + (QROWS-1-QVSYNC)
001FC5r 2  8D 00 FE             sta CRTC_IDX                ; rows from the vsync, whatever the row counter did
001FC8r 2  A9 07                lda #7
001FCAr 2  8D 01 FE             sta CRTC_DAT
001FCDr 2  A9 06                lda #6                      ; pre-arm the bar's R6 here in Q, where the display
001FCFr 2  8D 00 FE             sta CRTC_IDX                ; is off and a new R6 cannot show
001FD2r 2  A9 02                lda #BARROWS
001FD4r 2  8D 01 FE             sta CRTC_DAT
001FD7r 2  A9 04                lda #4
001FD9r 2  8D 00 FE             sta CRTC_IDX
001FDCr 2  AD rr rr             lda curR7
001FDFr 2  18                   clc
001FE0r 2  69 07                adc #QROWS-1-QVSYNC
001FE2r 2  29 7F                and #$7F
001FE4r 2  8D 01 FE             sta CRTC_DAT
001FE7r 2  E6 rr                inc vsyncs
001FE9r 2  A5 rr                lda flipreq
001FEBr 2  F0 17                beq @noflip
001FEDr 2  A5 rr                lda vsyncs
001FEFr 2  38                   sec
001FF0r 2  E5 rr                sbc flipvs
001FF2r 2  C9 02                cmp #2
001FF4r 2  90 0E                bcc @noflip
001FF6r 2  A5 rr                lda vsyncs
001FF8r 2  85 rr                sta flipvs
001FFAr 2  AD rr rr             lda NEXTSECT
001FFDr 2  8D rr rr             sta DISPSECT
002000r 2  A9 00 85 rr          stz flipreq
002004r 2               @noflip:
002004r 2  A2 00                ldx #0                      ; section 0 is the bar: its address and length come
002006r 2  AC rr rr             ldy DISPSECT                ; from the buffer about to be displayed
002009r 2  F0 02                beq :+
00200Br 2  A2 02                ldx #2
00200Dr 2  BD rr rr     :       lda BUF_SEC0T1,x
002010r 2  8D 46 FE             sta VIA_T1LL
002013r 2  BD rr rr             lda BUF_SEC0T1+1,x
002016r 2  8D 47 FE             sta VIA_T1LH
002019r 2  A9 0C                lda #12
00201Br 2  8D 00 FE             sta CRTC_IDX
00201Er 2  BD rr rr             lda BUF_SEC0,x
002021r 2  8D 01 FE             sta CRTC_DAT
002024r 2  A9 0D                lda #13
002026r 2  8D 00 FE             sta CRTC_IDX
002029r 2  BD rr rr             lda BUF_SEC0+1,x
00202Cr 2  8D 01 FE             sta CRTC_DAT
00202Fr 2  A9 40                lda #$40
002031r 2  8D 4D FE             sta VIA_IFR
002034r 2  8C rr rr             sty SECIDX
002037r 2  20 rr rr             jsr scan_keys               ; the keyboard and the sound are the interrupt's,
00203Ar 2  4C rr rr             jmp sound_tick              ; as they are on the Master
00203Dr 2               
00203Dr 2               ; ---------------------------------------------------------------- the chain
00203Dr 2               ; build_sections: fill SECTAB for the current buffer from ringS and wfine.
00203Dr 2               ; entry i: R12n, R13n, R4, R9, R6, R7, T1lo, T1hi.  The shape is section i's; the
00203Dr 2               ; address and duration are section i+1's, because R12/R13 latch at the next restart
00203Dr 2               ; and the T1 latch takes effect one interrupt later.
00203Dr 2               ;
00203Dr 2               ;   T   bar          2 rows at $0300
00203Dr 2               ;   A   composed row 8-f lines, the fine scroll                (only when f > 0)
00203Dr 2               ;   P1  playfield    from the window's slot to the ring's end
00203Dr 2               ;   M   playfield    the rest, from the mirror
00203Dr 2               ;   P2  bottom       f lines                                   (only when f > 0)
00203Dr 2               ;   Q   blanking     16 rows, vsync at row 8
00203Dr 2               ;
00203Dr 2               ; A row starting past RINGCHARS-80 straddles the ring end and is read from the mirror
00203Dr 2               ; sitting immediately below the ring base, which is exactly the address c - RINGCHARS
00203Dr 2               ; names; every row after it follows on contiguously.
00203Dr 2               build_sections:
00203Dr 2  A6 rr                ldx curbuf                  ; the buffer's CRTC base, and the mirror redirect:
00203Fr 2  BD rr rr             lda @cbl,x                  ; the same add with the ring subtracted
002042r 2  8D rr rr             sta crtcb
002045r 2  BD rr rr             lda @cbh,x
002048r 2  8D rr rr             sta crtcb+1
00204Br 2  BD rr rr             lda @cml,x
00204Er 2  8D rr rr             sta crtcbm
002051r 2  BD rr rr             lda @cmh,x
002054r 2  8D rr rr             sta crtcbm+1
002057r 2  A5 rr                lda curbuf
002059r 2  0A                   asl
00205Ar 2  AA                   tax
00205Br 2  A9 00                lda #>BARCRTC               ; section 0 is the bar: fixed address and length
00205Dr 2  9D rr rr             sta BUF_SEC0,x
002060r 2  A9 60                lda #<BARCRTC
002062r 2  9D rr rr             sta BUF_SEC0+1,x
002065r 2  A9 FE                lda #<(BARROWS*8*LINE-2)
002067r 2  9D rr rr             sta BUF_SEC0T1,x
00206Ar 2  A9 03                lda #>(BARROWS*8*LINE-2)
00206Cr 2  9D rr rr             sta BUF_SEC0T1+1,x
00206Fr 2  A6 rr                ldx curbuf
002071r 2  F0 02                beq :+
002073r 2  A2 30                ldx #48
002075r 2  A9 01        :       lda #BARROWS-1
002077r 2  9D rr rr             sta SECTAB+2,x
00207Ar 2  A9 07                lda #7
00207Cr 2  9D rr rr             sta SECTAB+3,x
00207Fr 2  A9 02                lda #BARROWS
002081r 2  9D rr rr             sta SECTAB+4,x
002084r 2  A9 1E                lda #30
002086r 2  9D rr rr             sta SECTAB+5,x
002089r 2  A5 rr                lda wfine
00208Br 2  F0 6F                beq @coarse
00208Dr 2                       ; ---- f > 0: T -> A (the composed row) -> P.. -> P2 -> Q
00208Dr 2  49 07                eor #7
00208Fr 2  85 DF E6 DF          inca                        ; 8-f lines of it
002093r 2  A5 DF        
002095r 2  20 rr rr             jsr @dur
002098r 2  9D rr rr             sta SECTAB+6,x
00209Br 2  A5 rr                lda tmp3
00209Dr 2  9D rr rr             sta SECTAB+7,x
0020A0r 2  A5 rr                lda ringS                   ; the composed row is the 80 chars above the window
0020A2r 2  38                   sec
0020A3r 2  E9 50                sbc #<ROWCHARS
0020A5r 2  85 rr                sta w16
0020A7r 2  A5 rr                lda ringS+1
0020A9r 2  E9 00                sbc #0
0020ABr 2  85 rr                sta w16+1
0020ADr 2  10 0D                bpl :+
0020AFr 2  A5 rr                lda w16
0020B1r 2  18                   clc
0020B2r 2  69 30                adc #<RINGCHARS
0020B4r 2  85 rr                sta w16
0020B6r 2  A5 rr                lda w16+1
0020B8r 2  69 07                adc #>RINGCHARS
0020BAr 2  85 rr                sta w16+1
0020BCr 2  20 rr rr     :       jsr @addr
0020BFr 2  8A                   txa
0020C0r 2  18                   clc
0020C1r 2  69 08                adc #8
0020C3r 2  AA                   tax                         ; A's entry
0020C4r 2  A9 00 9D rr          stz SECTAB+2,x
0020C8r 2  rr           
0020C9r 2  A5 rr                lda wfine
0020CBr 2  49 07                eor #7                      ; 7 - f
0020CDr 2  9D rr rr             sta SECTAB+3,x
0020D0r 2  A9 02                lda #2
0020D2r 2  9D rr rr             sta SECTAB+4,x
0020D5r 2  A9 1E                lda #30
0020D7r 2  9D rr rr             sta SECTAB+5,x
0020DAr 2  A5 rr                lda ringS                   ; the run starts one row into the window
0020DCr 2  18                   clc
0020DDr 2  69 50                adc #<ROWCHARS
0020DFr 2  85 rr                sta w16
0020E1r 2  A5 rr                lda ringS+1
0020E3r 2  69 00                adc #0
0020E5r 2  85 rr                sta w16+1
0020E7r 2  20 rr rr             jsr @wrap
0020EAr 2  A9 14                lda #VISROWS-1
0020ECr 2  85 rr                sta tmp4                    ; rows in the run
0020EEr 2  A4 rr                ldy barq
0020F0r 2  C8                   iny
0020F1r 2  C0 17                cpy #RINGROWS
0020F3r 2  90 02                bcc :+
0020F5r 2  A0 00                ldy #0
0020F7r 2  84 rr        :       sty tmp3
0020F9r 2  4C rr rr             bra @run
0020FCr 2               @coarse:                            ; ---- f = 0: T -> P.. -> Q
0020FCr 2  A5 rr                lda ringS
0020FEr 2  85 rr                sta w16
002100r 2  A5 rr                lda ringS+1
002102r 2  85 rr                sta w16+1
002104r 2  A9 15                lda #VISROWS
002106r 2  85 rr                sta tmp4
002108r 2  A5 rr                lda barq
00210Ar 2  85 rr                sta tmp3
00210Cr 2               @run:   ; w16 = the run's ring offset, tmp4 = its rows, X = the entry before it
00210Cr 2  20 rr rr             jsr @nfull                  ; rows that end before the ring end
00210Fr 2  C5 rr                cmp tmp4
002111r 2  B0 15                bcs @one                    ; the whole run fits
002113r 2  C9 00                cmp #0
002115r 2  F0 11                beq @one                    ; it starts inside the straddling row: all of it folds
002117r 2  85 rr                sta tmp2
002119r 2  20 rr rr             jsr @emit                   ; up to the ring end
00211Cr 2  A5 rr                lda tmp2
00211Er 2  20 rr rr             jsr @advance
002121r 2  A5 rr                lda tmp4
002123r 2  38                   sec
002124r 2  E5 rr                sbc tmp2
002126r 2  85 rr                sta tmp4
002128r 2  A5 rr        @one:   lda tmp4
00212Ar 2  85 rr                sta tmp2
00212Cr 2  20 rr rr             jsr @emit
00212Fr 2  A5 rr                lda tmp4
002131r 2  20 rr rr             jsr @advance                ; now the row below the playfield
002134r 2  A5 rr                lda wfine
002136r 2  F0 40                beq @setq
002138r 2                       ; --- P2: the top f lines of that row
002138r 2  20 rr rr             jsr @addr
00213Br 2  A5 rr                lda wfine
00213Dr 2  20 rr rr             jsr @dur
002140r 2  9D rr rr             sta SECTAB+6,x
002143r 2  A5 rr                lda tmp3
002145r 2  9D rr rr             sta SECTAB+7,x
002148r 2  8A                   txa
002149r 2  18                   clc
00214Ar 2  69 08                adc #8
00214Cr 2  AA                   tax
00214Dr 2  48 A9 00 9D          stza SECTAB+2, x
002151r 2  rr rr 68     
002154r 2  A5 rr                lda wfine
002156r 2  85 DF C6 DF          deca
00215Ar 2  A5 DF        
00215Cr 2  9D rr rr             sta SECTAB+3,x
00215Fr 2  A9 15                lda #VISROWS
002161r 2  9D rr rr             sta SECTAB+4,x
002164r 2  A9 1E                lda #30
002166r 2  9D rr rr             sta SECTAB+5,x
002169r 2  BD rr rr             lda SECTAB-8,x              ; w16 has not moved: the address the P2 @addr left
00216Cr 2  9D rr rr             sta SECTAB,x                ; in the previous entry is this one's too
00216Fr 2  BD rr rr             lda SECTAB-8+1,x
002172r 2  9D rr rr             sta SECTAB+1,x
002175r 2  4C rr rr             bra @sq2
002178r 2  20 rr rr     @setq:  jsr @addr                   ; Q starts on the row below the playfield
00217Br 2  A9 FE        @sq2:   lda #<(40*LINE-2)
00217Dr 2  9D rr rr             sta SECTAB+6,x
002180r 2  A9 09                lda #>(40*LINE-2)
002182r 2  9D rr rr             sta SECTAB+7,x
002185r 2  8A                   txa
002186r 2  18                   clc
002187r 2  69 08                adc #8
002189r 2  AA                   tax
00218Ar 2  A9 00                lda #>BARCRTC               ; and hands the chain back to the bar
00218Cr 2  9D rr rr             sta SECTAB,x
00218Fr 2  A9 60                lda #<BARCRTC
002191r 2  9D rr rr             sta SECTAB+1,x
002194r 2  A9 0F                lda #QROWS-1
002196r 2  9D rr rr             sta SECTAB+2,x
002199r 2  A9 07                lda #7
00219Br 2  9D rr rr             sta SECTAB+3,x
00219Er 2  48 A9 00 9D          stza SECTAB+4, x
0021A2r 2  rr rr 68     
0021A5r 2  A9 08                lda #QVSYNC
0021A7r 2  9D rr rr             sta SECTAB+5, x
0021AAr 2  A9 FE                lda #<(40*LINE-2)
0021ACr 2  9D rr rr             sta SECTAB+6, x
0021AFr 2  A9 09                lda #>(40*LINE-2)
0021B1r 2  9D rr rr             sta SECTAB+7, x
0021B4r 2  60                   rts
0021B5r 2  50 D0        @cbl:   .byte <CRTCB_A, <CRTCB_B
0021B7r 2  01 08        @cbh:   .byte >CRTCB_A, >CRTCB_B
0021B9r 2  20 A0        @cml:   .byte <(CRTCB_A-RINGCHARS), <(CRTCB_B-RINGCHARS)
0021BBr 2  FA 01        @cmh:   .byte >(CRTCB_A-RINGCHARS), >(CRTCB_B-RINGCHARS)
0021BDr 2               ; --- emit a run of tmp2 rows starting at ring offset w16, following entry X
0021BDr 2  20 rr rr     @emit:  jsr @addr
0021C0r 2  A5 rr                lda tmp2
0021C2r 2  20 rr rr             jsr @lines
0021C5r 2  9D rr rr             sta SECTAB+6,x
0021C8r 2  A5 rr                lda tmp3
0021CAr 2  9D rr rr             sta SECTAB+7,x
0021CDr 2  8A                   txa
0021CEr 2  18                   clc
0021CFr 2  69 08                adc #8
0021D1r 2  AA                   tax
0021D2r 2  A5 rr                lda tmp2
0021D4r 2  85 DF C6 DF          deca
0021D8r 2  A5 DF        
0021DAr 2  9D rr rr             sta SECTAB+2,x
0021DDr 2  A9 07                lda #7
0021DFr 2  9D rr rr             sta SECTAB+3,x
0021E2r 2  A9 1E                lda #30
0021E4r 2  9D rr rr             sta SECTAB+4,x
0021E7r 2  9D rr rr             sta SECTAB+5,x
0021EAr 2  60                   rts
0021EBr 2               ; --- SECTAB+0/1,x = the CRTC address of the row at ring offset w16.  A row starting
0021EBr 2               ; past RINGCHARS-80 straddles the ring end and is read from the mirror below the base,
0021EBr 2               ; which is exactly the address w16 - RINGCHARS names.
0021EBr 2  A5 rr        @addr:  lda w16
0021EDr 2  A4 rr                ldy w16+1
0021EFr 2  C0 06                cpy #>(RINGCHARS-ROWCHARS+1)
0021F1r 2  90 15                bcc :++
0021F3r 2  D0 04                bne :+
0021F5r 2  C9 E1                cmp #<(RINGCHARS-ROWCHARS+1)
0021F7r 2  90 0F                bcc :++
0021F9r 2  18           :       clc
0021FAr 2  6D rr rr             adc crtcbm
0021FDr 2  9D rr rr             sta SECTAB+1,x
002200r 2  98                   tya
002201r 2  6D rr rr             adc crtcbm+1
002204r 2  9D rr rr             sta SECTAB,x
002207r 2  60                   rts
002208r 2  18           :       clc
002209r 2  6D rr rr             adc crtcb
00220Cr 2  9D rr rr             sta SECTAB+1,x
00220Fr 2  98                   tya
002210r 2  6D rr rr             adc crtcb+1
002213r 2  9D rr rr             sta SECTAB,x
002216r 2  60                   rts
002217r 2                       ; --- A = rows -> A/tmp3 = that many rows of lines, as a T1 count
002217r 2  0A           @lines: asl
002218r 2  0A                   asl
002219r 2  0A                   asl
00221Ar 2  4C rr rr             jmp @dur
00221Dr 2                       ; --- A = rows: advance w16 by that many rows, folding into 0..RINGCHARS
00221Dr 2               @advance:
00221Dr 2  A8                   tay
00221Er 2  18                   clc
00221Fr 2  A5 rr                lda w16
002221r 2  79 50 80             adc mulrowlo,y
002224r 2  85 rr                sta w16
002226r 2  A5 rr                lda w16+1
002228r 2  79 68 80             adc mulrowhi,y
00222Br 2  85 rr                sta w16+1
00222Dr 2  A5 rr        @wrap:  lda w16+1
00222Fr 2  C9 07                cmp #>RINGCHARS
002231r 2  90 15                bcc :++
002233r 2  D0 06                bne :+
002235r 2  A5 rr                lda w16
002237r 2  C9 30                cmp #<RINGCHARS
002239r 2  90 0D                bcc :++
00223Br 2  A5 rr        :       lda w16
00223Dr 2  38                   sec
00223Er 2  E9 30                sbc #<RINGCHARS
002240r 2  85 rr                sta w16
002242r 2  A5 rr                lda w16+1
002244r 2  E9 07                sbc #>RINGCHARS
002246r 2  85 rr                sta w16+1
002248r 2  60           :       rts
002249r 2                       ; --- rows of the run that finish before the ring end.  The run starts on ring
002249r 2                       ; row tmp3; when r = ringS mod 80 is non-zero the last ring row straddles and
002249r 2                       ; @addr sends it to the mirror, so RINGROWS-1-tmp3 rows come first.
002249r 2  A4 rr        @nfull: ldy barq
00224Br 2  A5 rr                lda ringS
00224Dr 2  38                   sec
00224Er 2  F9 50 80             sbc mulrowlo,y              ; r
002251r 2  C9 01                cmp #1                      ; C = 1 iff r > 0
002253r 2  A9 16                lda #RINGROWS-1
002255r 2  B0 04                bcs :+
002257r 2  69 00                adc #0                      ; r == 0: C is clear here, so this adds 1
002259r 2  69 01                adc #1
00225Br 2  38           :       sec
00225Cr 2  E5 rr                sbc tmp3
00225Er 2  60                   rts
00225Fr 2                       ; --- A = lines -> A/tmp3 = the T1 count that lasts that long
00225Fr 2  85 rr        @dur:   sta tmp3                    ; n*64 == (n*256)>>2
002261r 2  A9 00                lda #0
002263r 2  46 rr                lsr tmp3
002265r 2  6A                   ror
002266r 2  46 rr                lsr tmp3
002268r 2  6A                   ror
002269r 2  E9 01                sbc #1                      ; C = 0 out of the ror pair: A - 2
00226Br 2  B0 02                bcs :+
00226Dr 2  C6 rr                dec tmp3
00226Fr 2  60           :       rts
002270r 2               
002270r 2               ; ---------------------------------------------------------------- the mirror
002270r 2                       .segment "TILCODE"          ; bank 5: render_core's last step
000BF3r 2               ; A copy of the ring's last slot row sits immediately below the ring base, so the
000BF3r 2               ; one displayed row that straddles the ring end can be read as a single run.  Only
000BF3r 2               ; the chars that row takes from it -- wcxm..79 -- need to be right, and when the
000BF3r 2               ; window is slot aligned no row straddles at all.  It is made only when its row
000BF3r 2               ; has been written: the blitters note the range (mirdirty, bank 5).
000BF3r 2               mirror_copy:
000BF3r 2  A6 rr                ldx curbuf
000BF5r 2  A5 E5                lda wcxm
000BF7r 2  DD rr rr             cmp mirwcx,x                ; a move left uncovers chars the last copy never
000BFAr 2  B0 0F                bcs :+                      ; reached, so the whole row has to be made again
000BFCr 2  A9 01                lda #1
000BFEr 2  9D rr rr             sta mirdty,x
000C01r 2  A9 00                lda #0
000C03r 2  9D rr rr             sta mirlo,x
000C06r 2  A9 4F                lda #ROWCHARS-1
000C08r 2  9D rr rr             sta mirhi,x
000C0Br 2  BD rr rr     :       lda mirdty,x                ; nothing has touched the ring's last row in this
000C0Er 2  D0 01                bne :+                      ; buffer since the mirror was last made
000C10r 2  60                   rts
000C11r 2  A5 E5        :       lda wcxm
000C13r 2  D0 01                bne :+                      ; slot aligned: no row straddles, so the mirror is
000C15r 2  60                   rts                         ; not read -- and the flag stays up for when it is
000C16r 2  A9 00        :       lda #0
000C18r 2  9D rr rr             sta mirdty,x
000C1Br 2  BD rr rr             lda mirlo,x                 ; the copy starts at the first written char, or at
000C1Er 2  C5 E5                cmp wcxm                    ; wcxm if the writing started left of it
000C20r 2  B0 02                bcs :+
000C22r 2  A5 E5                lda wcxm
000C24r 2  85 rr        :       sta tmp4                    ; and runs to the last written one
000C26r 2  BD rr rr             lda mirhi,x
000C29r 2  85 rr                sta tmp3
000C2Br 2  A9 FF                lda #$FF                    ; the written range is empty again
000C2Dr 2  9D rr rr             sta mirlo,x
000C30r 2  A9 00                lda #0
000C32r 2  9D rr rr             sta mirhi,x
000C35r 2  A5 E5                lda wcxm                    ; the chars left of wcxm are not copied
000C37r 2  9D rr rr             sta mirwcx,x
000C3Ar 2  A5 rr                lda tmp3                    ; the chars from the first written to the last
000C3Cr 2  38                   sec
000C3Dr 2  E5 rr                sbc tmp4
000C3Fr 2  B0 01                bcs :+                      ; nothing of it is in the window
000C41r 2  60                   rts
000C42r 2  18           :       clc
000C43r 2  69 01                adc #1
000C45r 2  85 rr                sta tmp
000C47r 2                       ; source: the last slot, base + (RINGROWS-1)*640 + tmp4*8; the mirror is one
000C47r 2                       ; whole ring below it
000C47r 2  A5 rr                lda tmp4
000C49r 2  85 rr                sta w16
000C4Br 2  A9 00                lda #0
000C4Dr 2  85 rr                sta w16+1
000C4Fr 2  06 rr                asl w16
000C51r 2  26 rr                rol w16+1
000C53r 2  06 rr                asl w16
000C55r 2  26 rr                rol w16+1
000C57r 2  06 rr                asl w16
000C59r 2  26 rr                rol w16+1
000C5Br 2  A5 rr                lda w16
000C5Dr 2  18                   clc
000C5Er 2  69 80                adc #<(RING_A + (RINGROWS-1)*ROWBYTES)
000C60r 2  85 rr                sta w16
000C62r 2  A5 rr                lda w16+1
000C64r 2  65 E0                adc ringbhi
000C66r 2  69 37                adc #>((RINGROWS-1)*ROWBYTES)
000C68r 2  85 rr                sta w16+1
000C6Ar 2  A5 rr                lda w16
000C6Cr 2  38                   sec
000C6Dr 2  E9 80                sbc #<RINGBYTES
000C6Fr 2  85 rr                sta w16b
000C71r 2  A5 rr                lda w16+1
000C73r 2  E9 39                sbc #>RINGBYTES
000C75r 2  85 rr                sta w16b+1
000C77r 2  A0 00                ldy #0
000C79r 2  A2 08        @c:     ldx #8
000C7Br 2  B1 rr        @b:     lda (w16),y
000C7Dr 2  91 rr                sta (w16b),y
000C7Fr 2  C8                   iny
000C80r 2  CA                   dex
000C81r 2  D0 F8                bne @b
000C83r 2  C0 00                cpy #0
000C85r 2  D0 04                bne :+
000C87r 2  E6 rr                inc w16+1
000C89r 2  E6 rr                inc w16b+1
000C8Br 2  C6 rr        :       dec tmp
000C8Dr 2  D0 EA                bne @c
000C8Fr 2  60                   rts
000C90r 2               
000C90r 2               ; ---------------------------------------------------------------- the CRTC
000C90r 2                       .segment "LGCLO"
000046r 2               crtc_init:                          ; start the chain at the bar and let vsync re-phase
000046r 2  A2 0A                ldx #10
000048r 2  A9 20                lda #$20                    ; the MOS's cursor off
00004Ar 2  20 rr rr             jsr @w
00004Dr 2  A2 09                ldx #9
00004Fr 2  A9 07                lda #7
000051r 2  20 rr rr             jsr @w
000054r 2  A2 04                ldx #4
000056r 2  A9 01                lda #BARROWS-1
000058r 2  20 rr rr             jsr @w
00005Br 2  A2 06                ldx #6
00005Dr 2  A9 02                lda #BARROWS
00005Fr 2  20 rr rr             jsr @w
000062r 2  A2 07                ldx #7
000064r 2  A9 1E                lda #30
000066r 2  20 rr rr             jsr @w
000069r 2  A2 0C                ldx #12
00006Br 2  A9 00                lda #>BARCRTC
00006Dr 2  20 rr rr             jsr @w
000070r 2  A2 0D                ldx #13
000072r 2  A9 60                lda #<BARCRTC
000074r 2  8E 00 FE     @w:     stx CRTC_IDX
000077r 2  8D 01 FE             sta CRTC_DAT
00007Ar 2  60                   rts
00007Br 2               
00007Br 2                       .segment "LGCBSS"
00007Cr 2  xx xx        crtcb:    .res 2                    ; the buffer being built: its CRTC base, and the
00007Er 2  xx xx        crtcbm:   .res 2                    ; mirror redirect (base - RINGCHARS)
000080r 2               
000080r 1                       .include "banks.s"
000080r 2               ; ============================================================================
000080r 2               ; The banks' tables and data, and the few routines that exist only here.
000080r 2               ;
000080r 2               ; $8000-$80FF of EVERY bank is the same: the far table (the thunk in low RAM reads
000080r 2               ; it from whichever bank is paged in), and the small tables more than one bank's
000080r 2               ; code indexes (sprmul5, the row multiples, the ring modulus).  The Master builds
000080r 2               ; these at start-up; here they are assembled.
000080r 2               ; ============================================================================
000080r 2               .macro COMMON_TABLES full           ; the far table alone in banks 4 and 6, whose
000080r 2                       .assert * = FARTAB, error, "the far table must be at FARTAB in every bank"
000080r 2                       .byte BANK_TILES, <(render_core-1),     >(render_core-1)        ; F_RENDCORE
000080r 2                       .byte BANK_SPR,   <(spr4::ds_entry-1),  >(spr4::ds_entry-1)     ; F_SPRLOOP4
000080r 2                       .byte BANK_MAP,   <(spr6::ds_entry-1),  >(spr6::ds_entry-1)     ; F_SPRLOOP6
000080r 2                       .byte BANK_TILES, <(mark_dirty_far-1),  >(mark_dirty_far-1)     ; F_MARKDIRTY
000080r 2                       .byte BANK_TILES, <(lvreset-1),         >(lvreset-1)            ; F_LVRESET
000080r 2                       .byte BANK_TILES, <(init5-1),           >(init5-1)              ; F_INIT5
000080r 2                 .if full
000080r 2                       .res $30 - 3*NFAR
000080r 2                       .assert * = sprmul5, error
000080r 2               .repeat MAXSPR, i
000080r 2                       .byte i*5
000080r 2               .endrepeat
000080r 2                       .res $20 - MAXSPR
000080r 2                       .assert * = mulrowlo, error
000080r 2               .repeat RINGROWS, i
000080r 2                       .byte <(i*ROWCHARS)
000080r 2               .endrepeat
000080r 2                       .res $18 - RINGROWS
000080r 2                       .assert * = mulrowhi, error
000080r 2               .repeat RINGROWS, i
000080r 2                       .byte >(i*ROWCHARS)
000080r 2               .endrepeat
000080r 2                       .res $18 - RINGROWS
000080r 2                       .assert * = ringmodtab, error
000080r 2               .repeat 128, i                      ; A = a map char row -> its ring slot: 128 rows
000080r 2                       .byte i .mod RINGROWS       ; is the tallest map (64 tiles)
000080r 2               .endrepeat
000080r 2                 .else
000080r 2                       .res $20 - 3*NFAR
000080r 2                 .endif
000080r 2               .endmacro
000080r 2                       .segment "COMMON4"
000000r 2  05 rr rr 04          COMMON_TABLES 0
000004r 2  rr rr 06 rr  
000008r 2  rr 05 rr rr  
000020r 2                       .segment "COMMON5"
000000r 2  05 rr rr 04          COMMON_TABLES 1
000004r 2  rr rr 06 rr  
000008r 2  rr 05 rr rr  
000100r 2                       .segment "COMMON6"
000000r 2  05 rr rr 04          COMMON_TABLES 0
000004r 2  rr rr 06 rr  
000008r 2  rr 05 rr rr  
000020r 2                       .segment "COMMON7"
000000r 2  05 rr rr 04          COMMON_TABLES 1
000004r 2  rr rr 06 rr  
000008r 2  rr 05 rr rr  
000100r 2               
000100r 2               ; ---------------------------------------------------------------- the sprite banks
000100r 2               ; SWAPTAB and MASKTAB0..3, at the same address in both banks that hold sprite data,
000100r 2               ; so the prologue in bank 5 can name a mask page for either.  The values are the
000100r 2               ; Master's init_tables' (MODE 1).
000100r 2               .macro MASK4 f                      ; AND mask by pair: keep what is NOT opaque
000100r 2                 .if f = 0
000100r 2                       .byte $FF
000100r 2                 .elseif f = 1
000100r 2                       .byte $CC
000100r 2                 .elseif f = 2
000100r 2                       .byte $33
000100r 2                 .else
000100r 2                       .byte $00
000100r 2                 .endif
000100r 2               .endmacro
000100r 2               .macro SWAP_TABLE
000100r 2                       .assert * = SWAPTAB, error, "SWAPTAB must be at the same address in both sprite banks"
000100r 2               .repeat 256, xx                     ; four-dot reversal: bits 7<->4, 6<->5, 3<->0, 2<->1
000100r 2                       .byte ((xx & $88) >> 3) | ((xx & $44) >> 1) | ((xx & $22) << 1) | ((xx & $11) << 3)
000100r 2               .endrepeat
000100r 2               .endmacro
000100r 2               .macro MASK_TABLES
000100r 2                       .assert * = MASKTAB0, error, "MASKTAB0 must be at the same address in both sprite banks"
000100r 2               .repeat 4, kk                       ; MASKTABk[x] = mask4[(x >> (6 - 2k)) & 3]
000100r 2                 .repeat 256, xx
000100r 2                       MASK4 {((xx >> (6 - 2*kk)) & 3)}
000100r 2                 .endrepeat
000100r 2               .endrepeat
000100r 2               .endmacro
000100r 2                       .segment "SPR4SWAP"
000000r 2  00 08 04 0C          SWAP_TABLE
000004r 2  02 0A 06 0E  
000008r 2  01 09 05 0D  
000100r 2                       .segment "SPR4MASK"
000000r 2  FF FF FF FF          MASK_TABLES
000004r 2  FF FF FF FF  
000008r 2  FF FF FF FF  
000400r 2                       .segment "SPR6SWAP"         ; bank 6 draws nothing mirrored: the packer keeps
000000r 2                 .if SPR6_MIRROR                   ; such images out, and the page holds data instead
000000r 2                       SWAP_TABLE
000000r 2                 .else
000000r 2  20 11 31 33          .incbin "build/spr6s.bin"
000004r 2  31 33 00 00  
000008r 2  00 00 20 11  
000100r 2                 .endif
000100r 2                       .segment "SPR6MASK"
000000r 2  FF FF FF FF          MASK_TABLES
000004r 2  FF FF FF FF  
000008r 2  FF FF FF FF  
000400r 2               
000400r 2                       .segment "SPR4HOLE"         ; $8030-$82FF of bank 4: mask planes, packed there
000000r 2  00 00 00 00          .incbin "build/spr4h.bin"
000004r 2  00 00 00 00  
000008r 2  03 07 07 03  
0002E0r 2                       .segment "SPR4DATA"         ; the images (and their masks) the packer put here
000000r 2  00 00 00 00          .incbin "build/spr4.bin"
000004r 2  00 00 00 00  
000008r 2  00 00 00 00  
0031F4r 2                       .segment "SPR6DATA"         ; and the rest, in bank 6 (directory flag $10)
000000r 2  13 32 E4 55          .incbin "build/spr6.bin"
000004r 2  A8 11 9B 32  
000008r 2  6E C8 E6 44  
0011B9r 2                       .segment "SPR6HOLE"         ; $8180-$82FF of bank 6: more of them
000000r 2  00 00 00 00          .incbin "build/spr6h.bin"
000004r 2  00 00 FF FF  
000008r 2  31 11 00 00  
0001ACr 2               
0001ACr 2               ; ---------------------------------------------------------------- bank 5: tiles
0001ACr 2                       .segment "TILDATA"
000000r 2               TILES:                              ; this level's tiles, 64 bytes each, by tile id
000000r 2                       .assert (* & $FF) = 0, error, "TILES must be page aligned (build_tileaddr)"
000000r 2  F5 FF F5 FF          .incbin "build/tiles.bin"
000004r 2  F5 FF F5 FF  
000008r 2  F5 FF F5 FF  
0029C0r 2               SPRMASK:                            ; mask plane address by sprite id
0029C0r 2  0A 82 0A 82          .incbin "build/sprmask.bin"
0029C4r 2  31 A8 31 A8  
0029C8r 2  AC 82 AC 82  
002AACr 2                       .segment "TILBSS"
0002AFr 2  xx xx xx xx  LV_PAGE0:  .res 512                 ; tile id -> address (build_tileaddr), page aligned
0002B3r 2  xx xx xx xx  
0002B7r 2  xx xx xx xx  
0004AFr 2               
0004AFr 2               ; the mirror's range: A = the first window column written of the row the mirror
0004AFr 2               ; follows, X = the last (0..79).  Those chars sit in the last slot row at wcxm on;
0004AFr 2               ; only the ones up to char 79 are in it (the rest wrapped to slot row 0), and only
0004AFr 2               ; those from wcxm are ever read (display.s).
0004AFr 2                       .segment "TILCODE"
000C90r 2               mirdirty:
000C90r 2  18                   clc
000C91r 2  65 E5                adc wcxm
000C93r 2  C9 50                cmp #ROWCHARS
000C95r 2  B0 26                bcs @out
000C97r 2  48                   pha
000C98r 2  8A                   txa
000C99r 2  18                   clc
000C9Ar 2  65 E5                adc wcxm
000C9Cr 2  C9 50                cmp #ROWCHARS
000C9Er 2  90 02                bcc :+
000CA0r 2  A9 4F                lda #ROWCHARS-1
000CA2r 2  AA           :       tax
000CA3r 2  A4 rr                ldy curbuf
000CA5r 2  A9 01                lda #1
000CA7r 2  99 rr rr             sta mirdty,y
000CAAr 2  68                   pla
000CABr 2  D9 rr rr             cmp mirlo,y
000CAEr 2  B0 03                bcs :+
000CB0r 2  99 rr rr             sta mirlo,y
000CB3r 2  8A           :       txa
000CB4r 2  D9 rr rr             cmp mirhi,y
000CB7r 2  90 03                bcc :+
000CB9r 2  99 rr rr             sta mirhi,y
000CBCr 2  60           :       rts
000CBDr 2  60           @out:   rts
000CBEr 2               
000CBEr 2               ; the per-level clear the Master's load_level does in main RAM
000CBEr 2               lvreset:
000CBEr 2  A9 00 8D rr          stz BUF_VALID
000CC2r 2  rr           
000CC3r 2  A9 00 8D rr          stz BUF_VALID+1
000CC7r 2  rr           
000CC8r 2  A9 00 8D rr          stz RECCNT
000CCCr 2  rr           
000CCDr 2  A9 00 8D rr          stz RECCNT+1
000CD1r 2  rr           
000CD2r 2  A9 00 8D rr          stz DIRTYCNT
000CD6r 2  rr           
000CD7r 2  A9 00 8D rr          stz DIRTYCNT+1
000CDBr 2  rr           
000CDCr 2  60                   rts
000CDDr 2               
000CDDr 2               ; and the once-only part of its init_tables that is this bank's
000CDDr 2               init5:
000CDDr 2  A9 04                lda #BANK_SPR
000CDFr 2  8D rr rr             sta spbank
000CE2r 2  A9 FF                lda #$FF
000CE4r 2  8D rr rr             sta BUF_BARQ
000CE7r 2  8D rr rr             sta BUF_BARQ+1
