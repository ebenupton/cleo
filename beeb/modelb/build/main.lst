000542r 2                       cmp #$FF
000542r 2                       beq done                    ; both transparent
000542r 2                 .if mirror
000542r 2                       tax
000542r 2                       lda SWAPTAB,x
000542r 2                 .endif
000542r 2                       sta sp_msk
000542r 2                       ldy #k
000542r 2                       MLINE mirror
