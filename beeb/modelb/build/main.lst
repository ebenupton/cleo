000961r 2               ; ---- inner blocks.  ptr = source column (already offset), sp = screen char,
000961r 2               ;      tmp = ra0', tmp2 = ra1'.  Full-res: source byte per line.
000961r 2               .macro SPRLINE k, mirror, copy, solid, blank
000961r 2                       .local done, skip, opaque, masked
000961r 2               .if k = 0
000961r 2                       ldaz ptr                    ; line 0: Y is not needed here
000961r 2               .else
000961r 2                       ldy #k
000961r 2                       lda (ptr),y
000961r 2               .endif
000961r 2               .if copy
000961r 2                 .if mirror
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2                 .endif
000961r 2                 .if k = 0
000961r 2                       staz sp                     ; box sprite: every byte opaque, plain copy
000961r 2                 .else
000961r 2                       sta (sp),y
000961r 2                 .endif
000961r 2               .else
000961r 2                 .if k = 0
000961r 2                       beq done                    ; 0: both pixels transparent, no store
000961r 2                       bpl masked                  ; (N from the load: cmp would set it from the subtraction)
000961r 2                       cmp #$C0
000961r 2                       bcc opaque                  ; bit7 alone: single opaque byte
000961r 2                       jmp solid                   ; bit 7+6: this and the next 7 bytes all opaque
000961r 2               masked: cmp #$41                    ; and the mirror image of that: this and the next 7
000961r 2                       beq blank                   ; all transparent, so the cell is left alone
000961r 2                 .else
000961r 2                       bmi opaque                  ; bit 7: both pixels opaque (see encode_sprite).  Tested
000961r 2                       beq done                    ; before the transparent case because the sprite data is
000961r 2                                                   ; 45.7% opaque against 24.1% transparent, and both read
000961r 2                                                   ; the same load's flags -- $00 is never negative
000961r 2                       cmp #$41                    ; a blank-run tag reached below line 0 (the packer marks
000961r 2                       bne :+                      ; every line a run covers): the rest of this cell is all
000961r 2                       jmp blank                   ; transparent, so skip it -- $41 else draws a red pixel
000961r 2               :
000961r 2                 .endif
000961r 2                       tax
000961r 2                 .if mirror
000961r 2                       lda MASKTAB+$80,x           ; mask of the mirrored byte (MASKTAB[SWAPTAB[x]])
000961r 2                 .else
000961r 2                       lda MASKTAB,x
000961r 2                 .endif
000961r 2                 .if k = 0
000961r 2                       andz sp
000961r 2                 .else
000961r 2                       and (sp),y
000961r 2                 .endif
000961r 2                 .if mirror
000961r 2                       ora IDENT+$80,x             ; the mirrored byte's OR value (IDENT[SWAPTAB[x]])
000961r 2                 .else
000961r 2                       ora IDENT,x
000961r 2                 .endif
000961r 2                 .if mirror
000961r 2                       bra skip                    ; only the mirrored form has anything at 'opaque' to
000961r 2                 .endif                            ; jump over; unmirrored, this branched to the next
000961r 2               opaque:                             ; instruction, 3 cycles on every masked byte
000961r 2                 .if mirror
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2                 .endif
000961r 2               skip:
000961r 2                 .if k = 0
000961r 2                       staz sp
000961r 2                 .else
000961r 2                       sta (sp),y
000961r 2                 .endif
000961r 2               done:
000961r 2               .endif
000961r 2               .endmacro
000961r 2               
000961r 2               .macro SOLID1 k
000961r 2                       ldy #k
000961r 2                       lda (ptr),y
000961r 2                       sta (sp),y
000961r 2               .endmacro
000961r 2               .macro SOLIDM k                     ; mirrored: nibble swap through the table
000961r 2               .if k > 0
000961r 2                       ldy #k
000961r 2                       lda (ptr),y
000961r 2               .endif
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2               .if k = 0
000961r 2                       staz sp
000961r 2               .else
000961r 2                       sta (sp),y
000961r 2               .endif
000961r 2               .endmacro
000961r 2               
000961r 2               .macro SPRFULL name, mirror, copy
000961r 2                       .local partial, et, l0, l1, l2, l3, l4, l5, l6, l7, pl, ps, po, pd, solid, blank
000961r 2               .if .not copy
000961r 2               solid:  ; byte 0 carried the RUN flag: the whole cell is opaque, straight copy
000961r 2               .if mirror
000961r 2                       SOLIDM 0
000961r 2                       SOLIDM 1
000961r 2                       SOLIDM 2
000961r 2                       SOLIDM 3
000961r 2                       SOLIDM 4
000961r 2                       SOLIDM 5
000961r 2                       SOLIDM 6
000961r 2                       SOLIDM 7
000961r 2                       jmp sprretM
000961r 2               .else
000961r 2                       staz sp                     ; A = byte 0
000961r 2                       ldy #1
000961r 2                       lda (ptr),y
000961r 2                       sta (sp),y
000961r 2                       iny
000961r 2                       lda (ptr),y
000961r 2                       sta (sp),y
000961r 2                       iny
000961r 2                       lda (ptr),y
000961r 2                       sta (sp),y
000961r 2                       iny
000961r 2                       lda (ptr),y
000961r 2                       sta (sp),y
000961r 2                       iny
000961r 2                       lda (ptr),y
000961r 2                       sta (sp),y
000961r 2                       iny
000961r 2                       lda (ptr),y
000961r 2                       sta (sp),y
000961r 2                       iny
000961r 2                       lda (ptr),y
000961r 2                       sta (sp),y
000961r 2                       jmp sprretP
000961r 2               .endif
000961r 2               .endif
000961r 2               name:
000961r 2                       lda tmp2
000961r 2                       cmp #7
000961r 2                       bne @np
000961r 2                       lda tmp
000961r 2                       beq l0                      ; the whole cell: the overwhelmingly common case, and
000961r 2                       asl                         ; it needs no table at all (was lda/asl/tax/jmpx, 21
000961r 2                       tax                         ; cycles of dispatch to reach the same place)
000961r 2                       jmpx et
000961r 2               @np:    jmp partial
000961r 2               et:     .word l0,l1,l2,l3,l4,l5,l6,l7
000961r 2               .if .not copy
000961r 2               blank:  ; byte 0 was $41: the whole cell is transparent, so there is nothing to do
000961r 2               .if mirror
000961r 2                       jmp sprretM
000961r 2               .else
000961r 2                       jmp sprretP
000961r 2               .endif
000961r 2               .endif
000961r 2               l0:     SPRLINE 0, mirror, copy, solid, blank
000961r 2               l1:     SPRLINE 1, mirror, copy, solid, blank
000961r 2               l2:     SPRLINE 2, mirror, copy, solid, blank
000961r 2               l3:     SPRLINE 3, mirror, copy, solid, blank
000961r 2               l4:     SPRLINE 4, mirror, copy, solid, blank
000961r 2               l5:     SPRLINE 5, mirror, copy, solid, blank
000961r 2               l6:     SPRLINE 6, mirror, copy, solid, blank
000961r 2               l7:     SPRLINE 7, mirror, copy, solid, blank
000961r 2                       .if mirror
000961r 2                       jmp sprretM
000961r 2                       .else
000961r 2                       jmp sprretP
000961r 2                       .endif
000961r 2               partial:
000961r 2                       ldy tmp
000961r 2               .if copy
000961r 2               pl:     lda (ptr),y
000961r 2                 .if mirror
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2                 .endif
000961r 2                       sta (sp),y
000961r 2               .else
000961r 2               pl:     lda (ptr),y
000961r 2                       bmi po                      ; bit 7: both pixels opaque.  Tested before the
000961r 2                       beq ps                      ; transparent case for the same reason SPRLINE does
000961r 2                       ; it -- 45.7% opaque against 24.1% transparent, and
000961r 2                       ; both read this load's flags ($00 is never negative)
000961r 2                       cmp #$41
000961r 2                       beq pd
000961r 2                       tax
000961r 2               .if mirror
000961r 2                       lda MASKTAB+$80,x
000961r 2                       and (sp),y
000961r 2                       ora IDENT+$80,x
000961r 2               .else
000961r 2                       lda MASKTAB,x
000961r 2                       and (sp),y
000961r 2                       ora IDENT,x
000961r 2               .endif
000961r 2                       sta (sp),y
000961r 2                       bra ps
000961r 2               po:
000961r 2               .if mirror
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2               .endif
000961r 2                       sta (sp),y
000961r 2               .endif
000961r 2               ps:     cpy tmp2
000961r 2                       beq pd
000961r 2                       iny
000961r 2                       bra pl
000961r 2               pd:
000961r 2                       .if mirror
000961r 2                       jmp sprretM
000961r 2                       .else
000961r 2                       jmp sprretP
000961r 2                       .endif
000961r 2               .endmacro
000961r 2               
000961r 2                 .if ::MODE1
000961r 2               ; ---- MODE 1 masked blitter.  A col entry has no spare bit, so the mask is a plane of
000961r 2               ; its own: one bit per game pixel, a data byte's two pixels as a 2-bit pair, four
000961r 2               ; horizontally adjacent columns packed into one byte (column 4g+j in bits 7-2j, 6-2j),
000961r 2               ; column-group-major: for group g, one byte per pixel row -- the shape of the data, so
000961r 2               ; mptr walks like ptr.  MASKTAB0..3 turn a whole mask byte into the AND mask for the
000961r 2               ; column of that phase, no shifting: $FF (both transparent) $CC $33 $00 (both opaque).
000961r 2               ; The two scanlines of a pixel row share a mask, so lines go in pairs, and a sprite's
000961r 2               ; first line in a cell is always even (refy is a multiple of 4 game px).  The data has
000961r 2               ; 0 in transparent pixels, so screen = (screen AND mask) OR data.  Mirrored: the pair's
000961r 2               ; mask is SWAPTAB of the table's answer ($33 <-> $CC), and the data byte is swapped.
000961r 2               .macro MLINE mirror                 ; masked store of line Y
000961r 2                 .if mirror
000961r 2                       lda (ptr),y
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2                       sta sp_ext                  ; dead during the blit
000961r 2                       lda (sp),y
000961r 2                       and sp_msk
000961r 2                       ora sp_ext
000961r 2                 .else
000961r 2                       lda (sp),y
000961r 2                       and sp_msk
000961r 2                       ora (ptr),y
000961r 2                 .endif
000961r 2                       sta (sp),y
000961r 2               .endmacro
000961r 2               .macro CLINE mirror                 ; plain store of line Y
000961r 2                       lda (ptr),y
000961r 2                 .if mirror
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2                 .endif
000961r 2                       sta (sp),y
000961r 2               .endmacro
000961r 2               .macro MPAIR k, mirror              ; lines k, k+1 of the cell
000961r 2                       .local opq, done
000961r 2                       ldy #k/2
000961r 2                       lda (mptr),y
000961r 2                       tay
000961r 2                       lda (mtab),y
000961r 2                       beq opq                     ; $00: both pixels opaque, plain stores
000961r 2                       cmp #$FF
000961r 2                       beq done                    ; both transparent
000961r 2                 .if mirror
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2                 .endif
000961r 2                       sta sp_msk
000961r 2                       ldy #k
000961r 2                       MLINE mirror
000961r 2                       iny
000961r 2                       MLINE mirror
000961r 2                       bra done
000961r 2               opq:    ldy #k
000961r 2                       CLINE mirror
000961r 2                       iny
000961r 2                       CLINE mirror
000961r 2               done:
000961r 2               .endmacro
000961r 2               .macro SPRMSK name, mirror
000961r 2                       .local partial, np, et, p0, p1, p2, p3, pl, pop, pnext
000961r 2               name:
000961r 2                       lda tmp2
000961r 2                       cmp #7
000961r 2                       bne np
000961r 2                       lda tmp                     ; even: 0,2,4,6 -> entry p0..p3
000961r 2                       beq p0
000961r 2                       tax
000961r 2                       jmpx et
000961r 2               np:     jmp partial
000961r 2               et:     .word p0, p1, p2, p3
000961r 2               p0:     MPAIR 0, mirror
000961r 2               p1:     MPAIR 2, mirror
000961r 2               p2:     MPAIR 4, mirror
000961r 2               p3:     MPAIR 6, mirror
000961r 2                 .if mirror
000961r 2                       jmp sprretMk
000961r 2                 .else
000961r 2                       jmp sprretPk
000961r 2                 .endif
000961r 2               partial:                            ; lines tmp..tmp2: tmp even, tmp2 odd
000961r 2                       lda tmp
000961r 2                       sta sp_lim
000961r 2               pl:     lda sp_lim
000961r 2                       lsr
000961r 2                       tay
000961r 2                       lda (mptr),y
000961r 2                       tay
000961r 2                       lda (mtab),y
000961r 2                       beq pop
000961r 2                       cmp #$FF
000961r 2                       beq pnext
000961r 2                 .if mirror
000961r 2                       tax
000961r 2                       lda SWAPTAB,x
000961r 2                 .endif
000961r 2                       sta sp_msk
000961r 2                       ldy sp_lim
000961r 2                       MLINE mirror
000961r 2                       iny
000961r 2                       MLINE mirror
000961r 2                       bra pnext
000961r 2               pop:    ldy sp_lim
000961r 2                       CLINE mirror
000961r 2                       iny
000961r 2                       CLINE mirror
000961r 2               pnext:  lda sp_lim
000961r 2                       inca
000961r 2                       inca
000961r 2                       sta sp_lim
000961r 2                       cmp tmp2
000961r 2                       bcc pl
000961r 2                 .if mirror
000961r 2                       jmp sprretMk
000961r 2                 .else
000961r 2                       jmp sprretPk
000961r 2                 .endif
000961r 2               .endmacro
000961r 2                 .endif
000961r 2               ; The row loop and the inner blocks.  On the Master this is plain code after the
000961r 2               ; prologue; on the Model B it is assembled once into EACH sprite data bank (the loop
000961r 2               ; reads image bytes, so it must be resident with them) and reached by a far call
000961r 2               ; from the prologue, which lives with the directory in bank 5.
000961r 2               .macro SPRITE_LOOPS withmirror, withcopy   ; withmirror = 0: a copy for a bank whose
000961r 2                 .if ::MODELB                      ; images are never drawn mirrored (no sprFM, no
000961r 2                                                   ; SWAPTAB); withcopy = 0: none drawn by the copy
000961r 2                                                   ; blitter (no sprFC)
000961r 2               ds_entry:                           ; the far entry: the dispatch jump is patched here,
000961r 2                       ldx sp_disp                 ; in the bank that owns it
000961r 2                       lda sprdisp_tab,x
000961r 2                       sta ds_dispatch+1
000961r 2                       lda sprdisp_tab+1,x
000961r 2                       sta ds_dispatch+2
000961r 2                 .endif
000961r 2               ds_rowloop:
000961r 2                       lda sp_rb
000961r 2                       sta sp
000961r 2                       lda sp_rb+1
000961r 2                       sta sp+1
000961r 2                       lda sp_rp
000961r 2                       sta ptr
000961r 2                       lda sp_rp+1
000961r 2                       sta ptr+1
000961r 2                 .if ::MODE1
000961r 2                       lda sp_mrp
000961r 2                       sta mptr
000961r 2                       lda sp_mrp+1
000961r 2                       sta mptr+1
000961r 2                       lda sp_mpg0
000961r 2                       sta mtab+1
000961r 2                 .endif
000961r 2                       ; ra range for this row
000961r 2                       stz tmp                     ; ra0' = 0 unless this is the first row
000961r 2                       lda sp_row
000961r 2                       cmp sp_r0
000961r 2                       bne :+
000961r 2                       ldx sp_ra0
000961r 2                       stx tmp
000961r 2               :       ldx #7
000961r 2                       cmp sp_r1
000961r 2                       bne :+
000961r 2                       ldx sp_ra1
000961r 2               :       stx tmp2                    ; ra1'
000961r 2                       lda sp_ncol
000961r 2                       sta sp_cnt                  ; columns-1 (countdown)
000961r 2               ds_colloop:
000961r 2               ds_dispatch:
000961r 2                       jmp sprFN                   ; operand patched per sprite
000961r 2                 .if withmirror
000961r 2               sprdisp_tab: .word sprFN, sprFM, sprFN, sprFM
000961r 2                 .else
000961r 2               sprdisp_tab: .word sprFN, sprFN, sprFN, sprFN
000961r 2                 .endif
000961r 2                 .if withcopy
000961r 2                       .word sprFC
000961r 2                 .else
000961r 2                       .word sprFN
000961r 2                 .endif
000961r 2                 .if withmirror
000961r 2                 .if ::MODE1
000961r 2               sprretMk:                           ; mask blitter, mirrored: the image column descends,
000961r 2                       dec mtab+1                  ; so the phase (= page & 3) does too; below phase 0
000961r 2                       lda mtab+1                  ; it is the previous group's phase 3
000961r 2                       and #3
000961r 2                       cmp #3
000961r 2                       bne @mk
000961r 2                       lda mtab+1
000961r 2                       clc
000961r 2                       adc #4
000961r 2                       sta mtab+1
000961r 2                       lda mptr
000961r 2                       sec
000961r 2                       sbc sp_mh
000961r 2                       sta mptr
000961r 2                       bcs @mk
000961r 2                       dec mptr+1
000961r 2               @mk:
000961r 2                 .endif
000961r 2               sprretM:                            ; next column, mirrored: source pointer - lines
000961r 2                       lda ptr
000961r 2                       sec
000961r 2                       sbc sp_lines
000961r 2                       sta ptr
000961r 2                       bcs sprnext
000961r 2                       dec ptr+1
000961r 2                       bra sprnext
000961r 2                 .endif
000961r 2                 .if ::MODE1
000961r 2               sprretPk:                           ; mask blitter: next phase is the next page; past
000961r 2                       inc mtab+1                  ; phase 3 it is the next group's phase 0
000961r 2                       lda mtab+1
000961r 2                       and #3
000961r 2                       bne @pk
000961r 2                       lda mtab+1
000961r 2                       sec
000961r 2                       sbc #4
000961r 2                       sta mtab+1
000961r 2                       lda mptr
000961r 2                       clc
000961r 2                       adc sp_mh
000961r 2                       sta mptr
000961r 2                       bcc @pk
000961r 2                       inc mptr+1
000961r 2               @pk:
000961r 2                 .endif
000961r 2               sprretP:                            ; next column: source pointer + lines
000961r 2                       lda ptr
000961r 2                       clc
000961r 2                       adc sp_lines
000961r 2                       sta ptr
000961r 2                       bcc sprnext
000961r 2                       inc ptr+1
000961r 2               sprnext:
000961r 2                       spnext
000961r 2                       dec sp_cnt
000961r 2                 .if ::MODELB
000961r 2                       bmi ds_rowdone              ; (the 6502 spellings put ds_colloop out of reach)
000961r 2                       jmp ds_colloop
000961r 2                 .else
000961r 2                       bpl ds_colloop
000961r 2                 .endif
000961r 2               ds_rowdone:
000961r 2                       lda sp_row
000961r 2                       cmp sp_r1
000961r 2                       beq ds_done
000961r 2                       inc sp_row
000961r 2                       lda sp_rp
000961r 2                       clc
000961r 2                       adc sp_rinc
000961r 2                       sta sp_rp
000961r 2                       bcc :+
000961r 2                       inc sp_rp+1
000961r 2                       clc
000961r 2               :
000961r 2                 .if ::MODE1
000961r 2                       lda sp_mrp
000961r 2                       adc #4                      ; C is clear
000961r 2                       sta sp_mrp
000961r 2                       bcc @mrnc
000961r 2                       inc sp_mrp+1
000961r 2                       clc
000961r 2               @mrnc:
000961r 2                 .endif
000961r 2                       lda sp_rb
000961r 2                       adc #<ROWBYTES
000961r 2                       sta sp_rb
000961r 2                       lda sp_rb+1
000961r 2                       adc #>ROWBYTES
000961r 2                       ringup sp_rb
000961r 2                       sta sp_rb+1
000961r 2                       jmp ds_rowloop
000961r 2               ds_done: rts
000961r 2               
000961r 2                 .if ::MODE1
000961r 2                       SPRMSK sprFN, 0
000961r 2                 .if withmirror
000961r 2                       SPRMSK sprFM, 1
000961r 2                 .endif
000961r 2               mask4:  .byte $FF, $CC, $33, $00    ; AND mask by pair (bit 1 = left opaque, bit 0 = right):
000961r 2                                                   ; keep what is NOT opaque -- right only opaque keeps the left dots
000961r 2                 .else
000961r 2                       SPRFULL sprFN, 0, 0
000961r 2                 .if withmirror
000961r 2                       SPRFULL sprFM, 1, 0
000961r 2                 .endif
000961r 2                 .endif
000961r 2               .endmacro
000961r 2                 .if ::MODELB
000961r 2                       .segment "SPR4CODE"
000000r 2                       .scope spr4
000000r 2  A6 E7 BD rr          SPRITE_LOOPS 1, ::SPR4_COPY ; (assets.inc: the packer puts the box stars in one
000004r 2  rr 8D rr rr  
000008r 2  BD rr rr 8D  
000407r 2                       .if ::SPR4_COPY             ;  bank and no mirrored image in the other)
000407r 2                       SPRFULL sprFC, 0, 1
000407r 2                       .endif
000407r 2                       .endscope
000407r 2                       .segment "SPR6CODE"
000000r 2                       .scope spr6
000000r 2  A6 E7 BD rr          SPRITE_LOOPS ::SPR6_MIRROR, 1
000004r 2  rr 8D rr rr  
000008r 2  BD rr rr 8D  
00021Cr 2  A5 rr C9 07          SPRFULL sprFC, 0, 1
000220r 2  D0 15 A5 rr  
000224r 2  F0 24 0A AA  
000290r 2                       .endscope
000290r 2                       PLACE "CODE", "TILCODE"
000961r 2                 .else
000961r 2                       SPRITE_LOOPS 1, 1
000961r 2                 .if ::MODE1
000961r 2               sp_mpg0:  .res 1                  ; MASKTAB page of the sprite's first column: >MASKTAB0 | phase
000961r 2               sp_mh:    .res 1                  ; pixel rows = mask bytes per column group
000961r 2               sp_mrp:   .res 2                  ; mask pointer for the current row's first column
000961r 2               sp_mbase: .res 2                  ; the sprite's mask plane
000961r 2               SWAPTAB:   .res 256               ; four-dot reversal for mirroring (from TABLES in MODE 2)
000961r 2               SECTAB:    .res 2*48              ; per buffer: 6 sections x 8 bytes
000961r 2               music_tab: .res 144               ; SN76489 periods for MIDI 24..95, decoded at start-up
000961r 2                 .endif
000961r 2                       SPRFULL sprFC, 0, 1         ; box stars: pre-composited on their background, no mask
000961r 2                 .endif
000961r 2               
000961r 2               ; (There were half-res blitters here -- one source byte to two screen lines -- for the
000961r 2               ; title's Cleo frames.  Every image is full-res now, so entries 0/1 of sprdisp_tab
000961r 2               ; alias the full blitters and the flag bit is vestigial.)
000961r 2               
000961r 2               ; ============================================================================
000961r 2               ; copy_partial: copy lines wfine..7 of ring row wcy into lines 0..(7-wfine) of the
000961r 2               ; ring row above the window (the "A" section source), for the columns drawn since.
000961r 2               ; ============================================================================
000961r 2               copy_partial:
000961r 2  A5 rr                lda wfine
000963r 2  D0 01                bne :+
000965r 2  60                   rts
000966r 2  A6 rr        :       ldx curbuf
000968r 2  DD rr rr             cmp PART_F,x
00096Br 2  D0 25                bne @all
00096Dr 2  A5 rr                lda wcy
00096Fr 2  DD rr rr             cmp PART_CY,x
000972r 2  D0 1E                bne @all
000974r 2                       ; same source row and lines as last time: only the columns drawn since.  A
000974r 2                       ; horizontal scroll does not matter: the composed row is a ring row at a fixed
000974r 2                       ; offset from its source, so it moves with the ring and stays valid
000974r 2  BD rr rr             lda PART_HI,x
000977r 2  C9 50                cmp #ROWCHARS
000979r 2  90 02                bcc :+
00097Br 2  A9 4F                lda #(ROWCHARS-1)
00097Dr 2  38           :       sec
00097Er 2  FD rr rr             sbc PART_LO,x
000981r 2  B0 01                bcs :+
000983r 2  60                   rts                         ; nothing drawn in the top row
000984r 2  85 DF E6 DF  :       inca
000988r 2  A5 DF        
00098Ar 2  85 rr                sta cnt
00098Cr 2  BD rr rr             lda PART_LO,x
00098Fr 2  4C rr rr             bra @go
000992r 2  A5 rr        @all:   lda wfine
000994r 2  9D rr rr             sta PART_F,x
000997r 2  A5 rr                lda wcy
000999r 2  9D rr rr             sta PART_CY,x
00099Cr 2  A9 50                lda #ROWCHARS
00099Er 2  85 rr                sta cnt
0009A0r 2  A9 00                lda #0
0009A2r 2  85 rr        @go:    sta tmp4                    ; first column to copy
0009A4r 2  18                   clc
0009A5r 2  65 rr                adc wcx
0009A7r 2  85 rr                sta w16
0009A9r 2  A5 rr                lda wcx+1
0009ABr 2  69 00                adc #0
0009ADr 2  85 rr                sta w16+1
0009AFr 2  A9 FF                lda #$FF                    ; range is clean once copied
0009B1r 2  9D rr rr             sta PART_LO,x
0009B4r 2  48 A9 00 9D          stza PART_HI, x
0009B8r 2  rr rr 68     
0009BBr 2                 .if MODELB
0009BBr 2  A5 rr                lda barq                    ; the composed row is the ring row above the window,
0009BDr 2  D0 0C                bne @nomir                  ; the last slot when the window starts at slot 0
0009BFr 2  A5 rr                lda tmp4
0009C1r 2  18                   clc
0009C2r 2  65 rr                adc cnt
0009C4r 2  AA                   tax
0009C5r 2  CA                   dex
0009C6r 2  A5 rr                lda tmp4
0009C8r 2  20 rr rr             jsr mirdirty
0009CBr 2               @nomir:
0009CBr 2                 .endif
0009CBr 2  A5 rr                lda wcy
0009CDr 2  20 rr rr             jsr ringaddr                ; sp = source start (row wcy, first dirty column)
0009D0r 2                       ; source: sp is the char, and the copy starts wfine lines into it.  Offsetting
0009D0r 2                       ; sp by wfine (under 8, and a char is 8-aligned) keeps its page crossings on
0009D0r 2                       ; the real char boundaries, so spnext's fold still lands where it should
0009D0r 2  A5 rr                lda sp
0009D2r 2  18                   clc
0009D3r 2  65 rr                adc wfine
0009D5r 2  85 rr                sta sp
0009D7r 2                       ; dest: the same column of the composed row, ring char (ringS + col + 2480)
0009D7r 2                       ; mod 2560 -- the row above the window -- as a real address from RINGBASE
0009D7r 2  A5 rr                lda tmp4
0009D9r 2  18                   clc
0009DAr 2  65 rr                adc ringS
0009DCr 2  85 rr                sta ptr
0009DEr 2  A5 rr                lda ringS+1
0009E0r 2  69 00                adc #0
0009E2r 2  85 rr                sta ptr+1
0009E4r 2  A5 rr                lda ptr
0009E6r 2  18                   clc
0009E7r 2  69 E0                adc #<(RINGCHARS-ROWCHARS)
0009E9r 2  85 rr                sta ptr
0009EBr 2  A5 rr                lda ptr+1
0009EDr 2  69 06                adc #>(RINGCHARS-ROWCHARS)
0009EFr 2                 .if MODELB
0009EFr 2  85 rr                sta ptr+1                   ; 23 rows of chars is not whole pages: 16-bit fold
0009F1r 2  C9 07                cmp #>RINGCHARS
0009F3r 2  90 15                bcc @pnf
0009F5r 2  D0 06                bne @pfold
0009F7r 2  A5 rr                lda ptr
0009F9r 2  C9 30                cmp #<RINGCHARS
0009FBr 2  90 0D                bcc @pnf
0009FDr 2  A5 rr        @pfold: lda ptr
0009FFr 2  38                   sec
000A00r 2  E9 30                sbc #<RINGCHARS
000A02r 2  85 rr                sta ptr
000A04r 2  A5 rr                lda ptr+1
000A06r 2  E9 07                sbc #>RINGCHARS
000A08r 2  85 rr                sta ptr+1
000A0Ar 2               @pnf:
000A0Ar 2                 .else
000A0Ar 2                       cmp #>RINGCHARS             ; RINGCHARS is whole pages, so the fold is a
000A0Ar 2                       bcc @pnf                    ; high-byte compare
000A0Ar 2                       sbc #>RINGCHARS
000A0Ar 2               @pnf:   sta ptr+1
000A0Ar 2                 .endif
000A0Ar 2  06 rr                asl ptr                     ; char -> byte address, + RINGBASE (the rols leave
000A0Cr 2  26 rr                rol ptr+1                   ; C clear: the offset is under $5000)
000A0Er 2  06 rr                asl ptr
000A10r 2  26 rr                rol ptr+1
000A12r 2  06 rr                asl ptr
000A14r 2  26 rr                rol ptr+1
000A16r 2                 .if MODELB
000A16r 2  A5 rr                lda ptr                     ; the base is xx80, and which xx is the buffer's
000A18r 2  69 80                adc #<RING_A
000A1Ar 2  85 rr                sta ptr
000A1Cr 2  A5 rr                lda ptr+1
000A1Er 2  65 E0                adc ringbhi
000A20r 2                 .else
000A20r 2                       lda ptr+1
000A20r 2                       adc #>RINGBASE
000A20r 2                 .endif
000A20r 2  85 rr                sta ptr+1
000A22r 2                       ; Y is the dest line, 0..7-wfine, and the source line is Y + wfine through the
000A22r 2                       ; offset sp: enter the unrolled copy at the pair for this wfine
000A22r 2  A6 rr                ldx wfine
000A24r 2  BD rr rr             lda @ftab-2,x
000A27r 2  8D rr rr             sta @fjmp+1
000A2Ar 2  BD rr rr             lda @ftab-1,x
000A2Dr 2  8D rr rr             sta @fjmp+2
000A30r 2  A6 rr                ldx cnt                     ; char counter in X: dex/beq is 3 cycles cheaper
000A32r 2  4C rr rr     @fjmp:  jmp @g4
000A35r 2  rr rr rr rr  @ftab:  .word @g4, @g2, @g0         ; wfine 2: six lines, 4: four, 6: two
000A39r 2  rr rr        
000A3Br 2  A0 05        @g4:    ldy #5
000A3Dr 2  B1 rr                lda (sp),y
000A3Fr 2  91 rr                sta (ptr),y
000A41r 2  88                   dey
000A42r 2  B1 rr                lda (sp),y
000A44r 2  91 rr                sta (ptr),y
000A46r 2  A0 03        @g2:    ldy #3
000A48r 2  B1 rr                lda (sp),y
000A4Ar 2  91 rr                sta (ptr),y
000A4Cr 2  88                   dey
000A4Dr 2  B1 rr                lda (sp),y
000A4Fr 2  91 rr                sta (ptr),y
000A51r 2  A0 01        @g0:    ldy #1
000A53r 2  B1 rr                lda (sp),y
000A55r 2  91 rr                sta (ptr),y
000A57r 2  88                   dey
000A58r 2  B1 rr                lda (sp),y
000A5Ar 2  91 rr                sta (ptr),y
000A5Cr 2                       ; next char, both with the ring fold on the page crossing: the composed row
000A5Cr 2                       ; can straddle the ring end like any other row
000A5Cr 2  A5 rr 18 69          spnext
000A60r 2  08 85 rr 90  
000A64r 2  1B A5 rr 85  
000A80r 2  CA                   dex
000A81r 2  F0 27                beq @done
000A83r 2  A5 rr                lda ptr
000A85r 2  18                   clc
000A86r 2  69 08                adc #8
000A88r 2  85 rr                sta ptr
000A8Ar 2  90 A6                bcc @fjmp
000A8Cr 2  A5 rr                lda ptr+1
000A8Er 2  85 DF E6 DF          inca
000A92r 2  A5 DF        
000A94r 2  C5 E1 90 0D          ringup ptr
000A98r 2  E9 39 48 A5  
000A9Cr 2  rr 38 E9 80  
000AA5r 2  85 rr                sta ptr+1
000AA7r 2  4C rr rr             bra @fjmp
000AAAr 2  60           @done:  rts
000AABr 2               
000AABr 2               ; ============================================================================
000AABr 2               ; calc_ring: ringS = ((wcy & 31) * 80 + wcx) mod 2560 ; barq = ringS / 80
000AABr 2               ; ============================================================================
000AABr 2               ; copy_bar: if this buffer's bar rows are stale, write bar image into ring slots q-3, q-2
000AABr 2               ; The bar has a fixed home outside the ring, so it stays put however the window
000AABr 2               ; scrolls and is only written when its contents change.  It used to live in the two
000AABr 2               ; ring rows above the window, which move every frame the view scrolls vertically;
000AABr 2               ; re-copying 1280 bytes for that cost 13,310 cycles of an 80,000 cycle frame.
000AABr 2               ; bar_bg: blit the static bar template (icons, labels, blank digit slots) from bank 4
000AABr 2               ; into the current back buffer's fixed bar rows.  Source art, not a maintained buffer.
000AABr 2                       PLACE "CODE", "LGCCODE"     ; Model B: the bar is loaded into place by the loader
000000r 2               bar_bg:                             ; and never redrawn: only the digit cache is reset                             ; runs only when a buffer needs its bar (twice per
000000r 2  A6 rr                ldx curbuf                  ; level).  The template buries the digits, so the
000002r 2  F0 02                beq :+                      ; cached "already drawn" values for this buffer are
000004r 2  A2 10                ldx #16                     ; no longer true
000006r 2  A9 FF        :       lda #$FF
000008r 2  A0 09                ldy #9
00000Ar 2  9D rr rr     @bci:   sta BARCACHE,x
00000Dr 2  E8                   inx
00000Er 2  88                   dey
00000Fr 2  D0 F9                bne @bci
000011r 2                 .if MODELB
000011r 2  60                   rts
000012r 2                 .else
000012r 2                       lda #HUD_BANK               ; The bar is black with a few icon spans, so
000012r 2                                                   ; fill black and lay the spans (BARBUF is now the span
000012r 2                       sta ROMSEL_CPY              ; list: offset16, len, bytes... ending $FFFF).
000012r 2                       sta ROMSEL
000012r 2                 .if MODE1
000012r 2                       lda #0                      ; MODE 1 black is plain 0: no opaque-black tag
000012r 2                 .else
000012r 2                       lda #$C0                    ; BARADDR is a constant, so the fill needs no pointer:
000012r 2                 .endif
000012r 2                       ldx #0                      ; five abs,x stores cover the 5 pages in one pass
000012r 2               @bf:    sta BARADDR+$000,x
000012r 2                       sta BARADDR+$100,x
000012r 2                       sta BARADDR+$200,x
000012r 2                       sta BARADDR+$300,x
000012r 2                       sta BARADDR+$400,x
000012r 2                       inx
000012r 2                       bne @bf
000012r 2                       lda #<BARBUF
000012r 2                       sta w16
000012r 2                       lda #>BARBUF
000012r 2                       sta w16+1
000012r 2               @bs:    ldy #1
000012r 2                       lda (w16),y                 ; offset high ($FF = end)
000012r 2                       cmp #$FF
000012r 2                       beq @bsdone
000012r 2                       tax                         ; X is free: the @bf counter ran down to 0
000012r 2                       ldaz w16                    ; offset low, (zp): no dey needed
000012r 2                       clc
000012r 2                       adc #<BARADDR
000012r 2                       sta w16b
000012r 2                       txa
000012r 2                       adc #>BARADDR
000012r 2                       sta w16b+1
000012r 2                       ldy #2
000012r 2                       lda (w16),y
000012r 2                       sta tmp2                    ; len
000012r 2                       lda w16                     ; step past the 3-byte header
000012r 2                       clc
000012r 2                       adc #3
000012r 2                       sta w16
000012r 2                       bcc :+
000012r 2                       inc w16+1
000012r 2               :       ldy #0
000012r 2               @bc:    lda (w16),y
000012r 2                       sta (w16b),y
000012r 2                       iny
000012r 2                       cpy tmp2
000012r 2                       bne @bc
000012r 2                       tya                         ; step past the data
000012r 2                       clc
000012r 2                       adc w16
000012r 2                       sta w16
000012r 2                       bcc @bs
000012r 2                       inc w16+1
000012r 2                       bra @bs
000012r 2               @bsdone: rts
000012r 2                 .endif
000012r 2               
000012r 2               ; ============================================================================
000012r 2                 .if .not MODELB                   ; (Model B: its rupture chain is modelb/src/display.s)
000012r 2                       .segment "LOGIC"           ; main RAM is full on a Master: this touches
000012r 2                                                   ; nothing but main RAM and the CRTC, so it can
000012r 2                                                   ; live in the bank the game logic already uses
000012r 2               ; build_sections: fill SECTAB for the current buffer from ringS and wfine.
000012r 2               ; entry i: R12n, R13n, R4, R9, R6, R7, T1lo, T1hi (T1 = duration of section i+1)
000012r 2               ;
000012r 2               ; The bar and the partial row have fixed homes, so only the playfield walks the ring.
000012r 2               ; A row starting past RINGCHARS-80 straddles the ring end; it is read from the mirror
000012r 2               ; sitting immediately below the ring base, which makes its address c - RINGCHARS in
000012r 2               ; ring-offset terms, and every row after it follows on contiguously.  That costs one
000012r 2               ; extra section whenever the window straddles.
000012r 2               ; ============================================================================
000012r 2               LINE = 64
000012r 2               BARLEAD = 10                        ; us the bar's T1 fires early, beyond the lead every
000012r 2                                                   ; step has, so ACCCON D can be switched in the
000012r 2                                                   ; blanking of the bar's last line
000012r 2               BARCRTC  = BARADDR / 8
000012r 2                       .code
000012r 2                       .segment "LOGIC"            ; back to the bank
000012r 2               build_sections:
000012r 2                       lda curbuf
000012r 2                       asl
000012r 2                       tax
000012r 2                       lda #>BARCRTC               ; section 0 is the bar: fixed address, fixed length
000012r 2                       sta BUF_SEC0,x
000012r 2                       lda #<BARCRTC
000012r 2                       sta BUF_SEC0+1,x
000012r 2                       lda #<(BARROWS*8*LINE-2-BARLEAD)   ; the bar's step fires early: see the ISR
000012r 2                       sta BUF_SEC0T1,x
000012r 2                       lda #>(BARROWS*8*LINE-2-BARLEAD)
000012r 2                       sta BUF_SEC0T1+1,x
000012r 2                       ldx curbuf
000012r 2                       beq :+
000012r 2                       ldx #48
000012r 2               :       lda #1
000012r 2                       sta SECTAB+2,x
000012r 2                       lda #7
000012r 2                       sta SECTAB+3,x
000012r 2                       lda #2
000012r 2                       sta SECTAB+4,x
000012r 2                       lda #30
000012r 2                       sta SECTAB+5,x
000012r 2                       lda wfine
000012r 2                       beq @coarse
000012r 2                       ; ---- f > 0 : T -> A (the partial row) -> P.. -> P2 -> Q
000012r 2                       eor #7                      ; wfine is still in A from the test above
000012r 2                       inca                        ; 8-f lines of it
000012r 2                       jsr @dur
000012r 2                       sta SECTAB+6,x
000012r 2                       lda tmp3
000012r 2                       sta SECTAB+7,x
000012r 2                       lda ringS                   ; section A shows the composed row: the ring row
000012r 2                       sec                         ; above the window, ringS - 80 mod RINGCHARS
000012r 2                       sbc #ROWCHARS
000012r 2                       sta w16
000012r 2                       lda ringS+1
000012r 2                       sbc #0
000012r 2                       bpl :+
000012r 2                       adc #>RINGCHARS             ; went below 0: + RINGCHARS (whole pages; C clear)
000012r 2               :       sta w16+1
000012r 2                       jsr @addr
000012r 2                       txa
000012r 2                       clc
000012r 2                       adc #8
000012r 2                       tax                         ; A's entry
000012r 2                       stz SECTAB+2,x
000012r 2                       lda wfine
000012r 2                       eor #7                      ; 7 - wfine, wfine in 0..7
000012r 2                       sta SECTAB+3,x
000012r 2                       lda #2
000012r 2                       sta SECTAB+4,x
000012r 2                       lda #30
000012r 2                       sta SECTAB+5,x
000012r 2                       lda ringS                   ; the run starts one row into the window
000012r 2                       clc
000012r 2                       adc #ROWCHARS
000012r 2                       sta w16
000012r 2                       lda ringS+1
000012r 2                       adc #0
000012r 2                       sta w16+1
000012r 2                       jsr @wrap
000012r 2                       lda #VISROWS-1
000012r 2                       sta tmp4                    ; rows in the run
000012r 2                       lda barq
000012r 2                       inca
000012r 2                       cmp #RINGROWS
000012r 2                       bcc :+
000012r 2                       lda #0
000012r 2               :       sta tmp3
000012r 2                       bra @run
000012r 2               @coarse:                            ; ---- f = 0 : T -> P.. -> Q
000012r 2                       lda ringS
000012r 2                       sta w16
000012r 2                       lda ringS+1
000012r 2                       sta w16+1
000012r 2                       lda #VISROWS
000012r 2                       sta tmp4
000012r 2                       lda barq                    ; the run starts on the window's ring row
000012r 2                       sta tmp3
000012r 2               @run:   ; w16 = the run's ring offset, tmp4 = its rows, X = the entry of the section
000012r 2                       ; before it.  Entry i carries section i+1's address and duration, and section
000012r 2                       ; i's own R4/R9/R6/R7, so each section is written across two entries.
000012r 2                       ; The run is never split any more: a row that straddles the ring end is
000012r 2                       ; folded by the CRTC, so the playfield is one section however the window sits.
000012r 2                       lda tmp4
000012r 2                       sta tmp2
000012r 2                       jsr @emit
000012r 2               @past:  lda tmp4
000012r 2                       jsr @advance                ; now the row below the playfield
000012r 2                       lda wfine
000012r 2                       beq @setq
000012r 2                       ; --- P2 : the top f lines of that row
000012r 2                       jsr @addr
000012r 2                       lda wfine
000012r 2                       jsr @dur
000012r 2                       sta SECTAB+6,x
000012r 2                       lda tmp3
000012r 2                       sta SECTAB+7,x
000012r 2                       txa
000012r 2                       clc
000012r 2                       adc #8
000012r 2                       tax
000012r 2                       stza SECTAB+2,x             ; stz abs,x
000012r 2                       lda wfine
000012r 2                       deca
000012r 2                       sta SECTAB+3,x
000012r 2                       lda #VISROWS
000012r 2                       sta SECTAB+4,x
000012r 2                       lda #30
000012r 2                       sta SECTAB+5,x
000012r 2                       lda SECTAB-8,x              ; w16 has not moved since the P2 @addr above, so the
000012r 2                       sta SECTAB,x                ; address it left in the previous entry is this one's
000012r 2                       lda SECTAB-8+1,x
000012r 2                       sta SECTAB+1,x
000012r 2                       bra @sq2
000012r 2               @setq:  jsr @addr                   ; Q starts on the row below the playfield
000012r 2               @sq2:   lda #<(40*LINE-2)
000012r 2                       sta SECTAB+6,x
000012r 2                       lda #>(40*LINE-2)
000012r 2                       sta SECTAB+7,x
000012r 2                       txa
000012r 2                       clc
000012r 2                       adc #8
000012r 2                       tax
000012r 2                       lda #>BARCRTC               ; and hands the chain back to the bar
000012r 2                       sta SECTAB,x
000012r 2                       lda #<BARCRTC
000012r 2                       sta SECTAB+1,x
000012r 2                       lda #QROWS-1
000012r 2                       sta SECTAB+2,x
000012r 2                       lda #7
000012r 2                       sta SECTAB+3,x
000012r 2                       stza SECTAB+4, x
000012r 2                       lda #QVSYNC
000012r 2                       sta SECTAB+5, x
000012r 2                       lda #<(40*LINE-2)
000012r 2                       sta SECTAB+6, x
000012r 2                       lda #>(40*LINE-2)
000012r 2                       sta SECTAB+7, x
000012r 2                       ; the bar's step fired BARLEAD early, so the section after the bar -- whose
000012r 2                       ; duration entry 0 carries -- runs BARLEAD longer to end where it should
000012r 2                       ldx curbuf
000012r 2                       beq @e0
000012r 2                       ldx #48
000012r 2               @e0:    lda SECTAB+6,x
000012r 2                       clc
000012r 2                       adc #BARLEAD
000012r 2                       sta SECTAB+6,x
000012r 2                       bcc @e1
000012r 2                       inc SECTAB+7,x
000012r 2               @e1:    rts
000012r 2               ; --- emit a run of tmp2 rows starting at w16 (a ring offset), following entry X
000012r 2               @emit:  jsr @addr
000012r 2                       lda tmp2
000012r 2                       jsr @lines
000012r 2                       sta SECTAB+6,x
000012r 2                       lda tmp3
000012r 2                       sta SECTAB+7,x
000012r 2                       txa
000012r 2                       clc
000012r 2                       adc #8
000012r 2                       tax
000012r 2                       lda tmp2
000012r 2                       deca
000012r 2                       sta SECTAB+2,x
000012r 2                       lda #7
000012r 2                       sta SECTAB+3,x
000012r 2                       lda #30
000012r 2                       sta SECTAB+4,x
000012r 2                       sta SECTAB+5,x
000012r 2                       rts
000012r 2               ; --- SECTAB+0/1,x = the CRTC address for the row at ring offset w16.  Ring offsets are
000012r 2               ; 0..RINGCHARS-1 and CRTCBASE is $600, so the sum is always under $1000 and MA12 is
000012r 2               ; clear: a section's START address never needs folding.  The fold happens mid-scan, in
000012r 2               ; hardware, which is the whole reason the ring begins at $3000.
000012r 2               @addr:  lda w16
000012r 2                       ldy w16+1
000012r 2                       clc
000012r 2                       adc #<CRTCBASE
000012r 2                       sta SECTAB+1,x
000012r 2                       tya
000012r 2                       adc #>CRTCBASE
000012r 2                       sta SECTAB,x
000012r 2                       rts
000012r 2                       ; --- A = rows -> A/tmp3 = that many rows of lines, as a T1 count
000012r 2               @lines: asl
000012r 2                       asl
000012r 2                       asl
000012r 2                       jmp @dur
000012r 2                       ; --- A = rows: advance w16 by that many rows, folding into 0..RINGCHARS
000012r 2               @advance:
000012r 2                       tay
000012r 2                       clc
000012r 2                       lda w16
000012r 2                       adc mulrowlo,y
000012r 2                       sta w16
000012r 2                       lda w16+1
000012r 2                       adc mulrowhi,y
000012r 2                       sta w16+1
000012r 2                       ; fall through
000012r 2               @wrap:  lda w16+1
000012r 2                       cmp #>RINGCHARS
000012r 2                       bcc :++
000012r 2                       bne :+
000012r 2                       lda w16
000012r 2                       cmp #<RINGCHARS
000012r 2                       bcc :++
000012r 2               :       lda w16
000012r 2                       sec
000012r 2                       sbc #<RINGCHARS
000012r 2                       sta w16
000012r 2                       lda w16+1
000012r 2                       sbc #>RINGCHARS
000012r 2                       sta w16+1
000012r 2               :       rts
000012r 2               ; A = lines -> A/tmp3 = lines*64-2
000012r 2               @dur:   sta tmp3                    ; n*64 == (n*256)>>2: start from hi=n, lo=0 and
000012r 2                       lda #0                      ; shift right twice instead of left six times
000012r 2                       lsr tmp3
000012r 2                       ror
000012r 2                       lsr tmp3
000012r 2                       ror
000012r 2                       sbc #1                      ; C = 0 out of the ror pair, so this is A - 2
000012r 2                       bcs :+
000012r 2                       dec tmp3
000012r 2               :       rts
000012r 2               ; w16 = (w16 - 80) with ring wrap (w16 holds CRTC address S+$600 in $600..$FFF)
000012r 2               @subrow: lda w16
000012r 2                       sec
000012r 2                       sbc #ROWCHARS
000012r 2                       sta w16
000012r 2                       bcs :+
000012r 2                       dec w16+1
000012r 2               :       lda w16+1
000012r 2                       cmp #6
000012r 2                       bcs :+                      ; not taken: C = 0 for the adc
000012r 2                       adc #$0A
000012r 2                       sta w16+1
000012r 2               :       rts
000012r 2               @addrow: lda w16
000012r 2                       clc
000012r 2                       adc #ROWCHARS
000012r 2                       sta w16
000012r 2                       bcc :+
000012r 2                       inc w16+1
000012r 2               :       lda w16+1
000012r 2                       cmp #$10
000012r 2                       bcc :+                      ; not taken: C = 1 for the sbc
000012r 2                       sbc #$0A
000012r 2                       sta w16+1
000012r 2               :       rts
000012r 2                 .endif
000012r 2               
000012r 2                       PLACE "CODE", "TILCODE"
000AABr 2               
000AABr 2               BARROWS = 2                        ; the status bar
000AABr 2               QROWS  = 39 - VISROWS - BARROWS    ; blank rows after the display: 312 lines in all
000AABr 2                 .if MODELB
000AABr 2               QVSYNC = 8                         ; vsync at Q row 8 of 16: the picture starts 64 lines after
000AABr 2                                                  ; it, 4 lines below where a MODE 1 screen sits
000AABr 2                 .else
000AABr 2               QVSYNC = 3                         ; vsync at Q row 3 of 7: four rows (32 lines) between the
000AABr 2                                                  ; vsync and the bar, which is where the bar is drawn, and
000AABr 2                                                  ; three below.  Measured against the Master MOS's own
000AABr 2                                                  ; MODE 2 (R7 = 35): the picture sits exactly where it does.
000AABr 2                 .endif
000AABr 2               
000AABr 2               ; ============================================================================
000AABr 2               ; Frame control
000AABr 2               ; ============================================================================
000AABr 2               ; select CPU access to the current back buffer (ACCCON X bit)
000AABr 2               select_backbuf:
000AABr 2                 .if MODELB
000AABr 2  A6 rr                ldx curbuf                  ; the buffer's ring: its base and end, the two
000AADr 2  BD rr rr             lda @bhi,x                  ; derived constants the blitters' wrap tests use,
000AB0r 2  85 E0                sta ringbhi                 ; and the row table from its base
000AB2r 2  BD rr rr             lda @ehi,x
000AB5r 2  85 E1                sta ringehi
000AB7r 2  38                   sec
000AB8r 2  E9 03                sbc #3
000ABAr 2  85 E2                sta ringe3
000ABCr 2  A9 00                lda #0
000ABEr 2  38                   sec
000ABFr 2  E5 E1                sbc ringehi
000AC1r 2  85 E3                sta ringneg
000AC3r 2  20 rr rr             jsr build_ring
000AC6r 2  4C rr rr             jmp @recs
000AC9r 2  0A 46        @bhi:   .byte >RING_A, >RING_B
000ACBr 2  44 80        @ehi:   .byte >RINGEND_A, >RINGEND_B
000ACDr 2               @recs:
000ACDr 2                 .else
000ACDr 2                       php                         ; the ISR writes ACCCON's D bit; this read-modify-
000ACDr 2                       sei                         ; write of the X bit must not straddle one
000ACDr 2                       lda ACCCON
000ACDr 2                       and #$FB
000ACDr 2                       ldx curbuf
000ACDr 2                       beq :+
000ACDr 2                       ora #$04
000ACDr 2               :       sta ACCCON
000ACDr 2                       plp
000ACDr 2                 .endif
000ACDr 2  A5 rr                lda curbuf
000ACFr 2  F0 09                beq :+
000AD1r 2  A9 rr                lda #<(SPRREC+MAXREC*10)
000AD3r 2  85 rr                sta recp
000AD5r 2  A9 rr                lda #>(SPRREC+MAXREC*10)
000AD7r 2  85 rr                sta recp+1
000AD9r 2  60                   rts
000ADAr 2  A9 rr        :       lda #<SPRREC
000ADCr 2  85 rr                sta recp
000ADEr 2  A9 rr                lda #>SPRREC
000AE0r 2  85 rr                sta recp+1
000AE2r 2  60                   rts
000AE3r 2               
000AE3r 2               ; render everything queued for the current back buffer and request flip
000AE3r 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the game loop; the ring work
000012r 2               render_frame:                       ; is render_core in bank 5
000012r 2  20 rr rr             jsr wait_flip               ; the previous frame's flip must land before we
000015r 2                 .if .not MODELB
000015r 2                       jsr select_backbuf          ; draw into the buffer it is leaving
000015r 2                 .endif
000015r 2                       ; ---- the bar first.  It is single buffered and drawn where it is displayed,
000015r 2                       ; so it has to be finished before the CRTC reaches it: T starts 40 lines after
000015r 2                       ; the vsync wait_flip just returned from, which is 2560 cycles.  A full
000015r 2                       ; template blit does not fit and does not need to -- it runs twice a level.
000015r 2  A5 A4                lda BARBG
000017r 2  F0 07                beq :+
000019r 2  20 rr rr             jsr bar_bg
00001Cr 2  A9 00 85 A4          stz BARBG
000020r 2  A5 A3        :       lda BARDIRTY
000022r 2  F0 07                beq :+
000024r 2  20 rr rr             jsr t_redraw_hud
000027r 2  A9 00 85 A3          stz BARDIRTY
00002Br 2               :
00002Br 2                       ; derive char window
00002Br 2  A5 rr                lda wx
00002Dr 2  85 rr                sta wcx
00002Fr 2  A5 rr                lda wx+1
000031r 2  4A                   lsr
000032r 2  85 rr                sta wcx+1
000034r 2  66 rr                ror wcx
000036r 2  A5 rr                lda wy
000038r 2  29 03                and #3
00003Ar 2  0A                   asl
00003Br 2  85 rr                sta wfine
00003Dr 2  A5 rr                lda wy+1                    ; wcy = wy >> 2, a full 16-bit shift: shifting the
00003Fr 2  4A                   lsr                         ; high byte once only was right below wy = 512 and
000040r 2  85 rr                sta wcy                     ; lost 128 rows above it, which put the tall maps
000042r 2  A5 rr                lda wy                      ; 512 px out of place once the player got that deep
000044r 2  6A                   ror
000045r 2  46 rr                lsr wcy
000047r 2  6A                   ror
000048r 2  85 rr                sta wcy
00004Ar 2                 .if MODELB
00004Ar 2  A2 00 20 rr          farjsr F_RENDCORE
00004Er 2  rr           
00004Fr 2                 .else
00004Fr 2                       jsr calc_ring
00004Fr 2                       jsr match_sprites
00004Fr 2                       jsr erase_old
00004Fr 2                       jsr scroll_validate
00004Fr 2                       jsr draw_dirty
00004Fr 2                       jsr draw_sprites
00004Fr 2                       jsr copy_partial
00004Fr 2                 .endif
00004Fr 2  48 A9 00 85          stza NSPR
000053r 2  A2 68        
000055r 2                 .if MODELB
000055r 2  20 rr rr             jsr build_sections
000058r 2                 .else
000058r 2                       jsr t_build_sections
000058r 2                 .endif
000058r 2                       ; hand over to ISR
000058r 2  A5 rr                lda curbuf
00005Ar 2                 .if .not MODELB
00005Ar 2                       sta NEXTBUF
00005Ar 2                 .endif
00005Ar 2  F0 02                beq :+
00005Cr 2  A9 30                lda #48
00005Er 2  8D rr rr     :       sta NEXTSECT
000061r 2  A9 01                lda #1
000063r 2  85 rr                sta flipreq
000065r 2               render_done:                        ; (label for the phase timer harness)
000065r 2                       ; no wait here: the next logic step runs while the flip is pending and
000065r 2                       ; the next render_frame waits for it before touching the buffer
000065r 2  A5 rr                lda curbuf
000067r 2  49 01                eor #1
000069r 2  85 rr                sta curbuf
00006Br 2  60                   rts
00006Cr 2               
00006Cr 2               ; spin until any pending flip has been taken by the vsync ISR
00006Cr 2               wait_flip:
00006Cr 2  A5 rr                lda flipreq
00006Er 2  D0 FC                bne wait_flip
000070r 2  60                   rts
000071r 2                 .if MODELB
000071r 2                       .segment "TILCODE"          ; the ring work, in the tile blitter's bank
000AE3r 2               render_core:
000AE3r 2  20 rr rr             jsr select_backbuf          ; draw into the buffer the flip is leaving
000AE6r 2  20 rr rr             jsr calc_ring
000AE9r 2  20 rr rr             jsr match_sprites
000AECr 2  20 rr rr             jsr erase_old
000AEFr 2  20 rr rr             jsr scroll_validate
000AF2r 2  20 rr rr             jsr draw_dirty
000AF5r 2  20 rr rr             jsr draw_sprites
000AF8r 2  20 rr rr             jsr copy_partial
000AFBr 2  4C rr rr             jmp mirror_copy             ; the straddling row's copy (display.s)
000AFEr 2                 .endif
000AFEr 2               
000AFEr 2               
000AFEr 2                       PLACE "LOW", "TILCODE"     ; render-time helpers in the NMI page ($0D03..),
000AFEr 2                                                  ; copied there at init
000AFEr 2               ; ============================================================================
000AFEr 2               drawrect_clip:
000AFEr 2                       ; rows
000AFEr 2  A5 rr                lda rc_y
000B00r 2  38                   sec
000B01r 2  E5 rr                sbc wcy                     ; rel row start (may be negative), kept in A
000B03r 2  10 0F                bpl :+
000B05r 2                       ; start above window: shrink
000B05r 2  18                   clc
000B06r 2  65 rr                adc rc_h
000B08r 2  F0 69                beq @none
000B0Ar 2  30 67                bmi @none
000B0Cr 2  85 rr                sta rc_h
000B0Er 2  A5 rr                lda wcy
000B10r 2  85 rr                sta rc_y
000B12r 2  A9 00                lda #0                      ; clipped to the top: rel is now 0
000B14r 2  85 rr        :       sta tmp                     ; stored here, so the common path never reloads it
000B16r 2  18                   clc
000B17r 2  65 rr                adc rc_h                    ; rel end+1
000B19r 2  C9 17                cmp #BUFROWS+1
000B1Br 2  90 0A                bcc :+
000B1Dr 2  A9 16                lda #BUFROWS                ; bcc not taken: C = 1 already, for the sbc
000B1Fr 2  E5 rr                sbc tmp
000B21r 2  F0 50                beq @none
000B23r 2  30 4E                bmi @none
000B25r 2  85 rr                sta rc_h
000B27r 2               :       ; cols: rel = rc_x - wcx (16 bit signed)
000B27r 2  A5 rr                lda rc_x
000B29r 2  38                   sec
000B2Ar 2  E5 rr                sbc wcx
000B2Cr 2  85 rr                sta w16
000B2Er 2  A5 rr                lda rc_x+1
000B30r 2  E5 rr                sbc wcx+1
000B32r 2  85 rr                sta w16+1
000B34r 2  10 24                bpl @right
000B36r 2                       ; rel < 0: the visible width is w + rel, and rel is already two's complement,
000B36r 2                       ; so add rather than negate-and-subtract.  Only a result whose high byte comes
000B36r 2                       ; out exactly 0 survives: anything else is the whole rect off the left edge.
000B36r 2  A5 rr                lda w16
000B38r 2  18                   clc
000B39r 2  65 rr                adc rc_w
000B3Br 2  85 rr                sta rc_w
000B3Dr 2  F0 34                beq @none                   ; Z is still the low sum: sta sets no flags
000B3Fr 2  A5 rr                lda w16+1
000B41r 2  69 00                adc #0                      ; branches do not touch C
000B43r 2  D0 2E                bne @none
000B45r 2  A5 rr                lda wcx
000B47r 2  85 rr                sta rc_x
000B49r 2  A5 rr                lda wcx+1
000B4Br 2  85 rr                sta rc_x+1
000B4Dr 2  A5 rr                lda rc_w                    ; rel is now exactly 0, so the right clip is just
000B4Fr 2  C9 51                cmp #ROWCHARS+1             ; min(rc_w, ROWCHARS): no need to store it and read
000B51r 2  90 04                bcc :+                      ; it back through the general test below
000B53r 2  A9 50                lda #ROWCHARS
000B55r 2  85 rr                sta rc_w
000B57r 2  4C rr rr     :       jmp drawrect
000B5Ar 2  A5 rr        @right: lda w16+1
000B5Cr 2  D0 15                bne @none                   ; rel >= 256 -> off right
000B5Er 2  A5 rr                lda w16
000B60r 2  C9 50                cmp #ROWCHARS
000B62r 2  B0 0F                bcs @none                   ; not taken: C = 0 for the adc
000B64r 2  65 rr                adc rc_w
000B66r 2  C9 51                cmp #ROWCHARS+1
000B68r 2  90 06                bcc :+                      ; not taken: C = 1 for the sbc
000B6Ar 2  A9 50                lda #ROWCHARS
000B6Cr 2  E5 rr                sbc w16
000B6Er 2  85 rr                sta rc_w
000B70r 2  4C rr rr     :       jmp drawrect
000B73r 2  60           @none:  rts
000B74r 2               ; ============================================================================
000B74r 2               ; drawrect_clip: like drawrect but clips the rect to the current window
000B74r 2               ; (rows wcy..wcy+BUFROWS-1, cols wcx..wcx+ROWCHARS-1).
000B74r 2               calc_ring:
000B74r 2  A5 rr                lda wcy
000B76r 2  AA BD 80 80          ringmod
000B7Ar 2  AA                   tax
000B7Br 2  BD 50 80             lda mulrowlo,x
000B7Er 2  18                   clc
000B7Fr 2  65 rr                adc wcx
000B81r 2  85 rr                sta ringS
000B83r 2  BD 68 80             lda mulrowhi,x
000B86r 2  65 rr                adc wcx+1
000B88r 2  85 rr                sta ringS+1
000B8Ar 2  C9 07                cmp #>RINGCHARS
000B8Cr 2  90 15                bcc :+
000B8Er 2  D0 06                bne @sub
000B90r 2  A5 rr                lda ringS
000B92r 2  C9 30                cmp #<RINGCHARS
000B94r 2  90 0D                bcc :+
000B96r 2  A5 rr        @sub:   lda ringS
000B98r 2  38                   sec
000B99r 2  E9 30                sbc #<RINGCHARS
000B9Br 2  85 rr                sta ringS
000B9Dr 2  A5 rr                lda ringS+1
000B9Fr 2  E9 07                sbc #>RINGCHARS
000BA1r 2  85 rr                sta ringS+1
000BA3r 2               :       ; q = S / 80
000BA3r 2  A5 rr                lda ringS                   ; running value: low in A, high in Y
000BA5r 2  A4 rr                ldy ringS+1
000BA7r 2  A2 FF                ldx #$FF                    ; quotient, pre-decremented
000BA9r 2  38                   sec                         ; the loop's own bcs guarantees C=1 all the way
000BAAr 2  E8           @div:   inx                         ; round, so the only entries needing a sec are
000BABr 2  E9 50                sbc #ROWCHARS               ; this one and the one after a borrow
000BADr 2  B0 FB                bcs @div                    ; no borrow: high byte unchanged, value still >= 0
000BAFr 2  38                   sec                         ; dey does not touch the carry
000BB0r 2  88                   dey
000BB1r 2  10 F7                bpl @div                    ; borrow absorbed by the high byte
000BB3r 2  86 rr        @dd:    stx barq                    ; high byte went negative: X is the quotient
000BB5r 2                 .if MODELB
000BB5r 2  18                   clc                         ; the remainder, A + 80, is where the window starts
000BB6r 2  69 50                adc #ROWCHARS               ; in its slot: the first char the mirror is read for
000BB8r 2  85 E5                sta wcxm
000BBAr 2  A9 16                lda #RINGROWS-1             ; the window row that lives in the last slot, and
000BBCr 2  38                   sec                         ; the map row it shows: the row the mirror follows
000BBDr 2  E5 rr                sbc barq
000BBFr 2  85 E6                sta rstar
000BC1r 2  18                   clc
000BC2r 2  65 rr                adc wcy
000BC4r 2  85 E4                sta mrow
000BC6r 2                 .endif
000BC6r 2  60                   rts
000BC7r 2               
000BC7r 2                 .if .not MODELB                   ; (Model B: modelb/src/init.s -- its tables are static)
000BC7r 2                       .segment "LOW2"            ; MOS vector/VDU pages ($0206..$03FF), copied there after MODE 2:
000BC7r 2                                                  ; init-only table builders and the dirty-tile routines
000BC7r 2               
000BC7r 2               ; ============================================================================
000BC7r 2               ; table init
000BC7r 2               ; ============================================================================
000BC7r 2                       .segment "LOGIC"            ; cold, and main RAM under the screen is full
000BC7r 2               init_tables:
000BC7r 2                 .if MODE1
000BC7r 2                       ldx #0
000BC7r 2               @mt:    txa                         ; MASKTABk[x] = mask4[(x >> (6 - 2k)) & 3]
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       tay
000BC7r 2                       lda mask4,y
000BC7r 2                       sta MASKTAB0,x
000BC7r 2                       txa
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       and #3
000BC7r 2                       tay
000BC7r 2                       lda mask4,y
000BC7r 2                       sta MASKTAB1,x
000BC7r 2                       txa
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       and #3
000BC7r 2                       tay
000BC7r 2                       lda mask4,y
000BC7r 2                       sta MASKTAB2,x
000BC7r 2                       txa
000BC7r 2                       and #3
000BC7r 2                       tay
000BC7r 2                       lda mask4,y
000BC7r 2                       sta MASKTAB3,x
000BC7r 2                       inx
000BC7r 2                       bne @mt
000BC7r 2                 .else
000BC7r 2                       jsr init_ident
000BC7r 2                 .endif
000BC7r 2                       ldx #0
000BC7r 2               @t:     txa
000BC7r 2                 .if .not MODE1
000BC7r 2                       and #$AA
000BC7r 2                       beq :+
000BC7r 2                       lda #0
000BC7r 2                       bra :++
000BC7r 2               :       lda #$AA
000BC7r 2               :       sta tmp
000BC7r 2                       txa
000BC7r 2                       and #$55
000BC7r 2                       beq :+
000BC7r 2                       lda #0
000BC7r 2                       bra :++
000BC7r 2               :       lda #$55
000BC7r 2               :       ora tmp
000BC7r 2                       sta MASKTAB,x
000BC7r 2                 .endif
000BC7r 2                 .if MODE1
000BC7r 2                       ; MODE 1: a byte is four dots, bit 7-i / bit 3-i for dot i; mirroring reverses
000BC7r 2                       ; them: 7<->4, 6<->5, 3<->0, 2<->1
000BC7r 2                       txa
000BC7r 2                       and #$88
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       lsr
000BC7r 2                       sta tmp
000BC7r 2                       txa
000BC7r 2                       and #$44
000BC7r 2                       lsr
000BC7r 2                       ora tmp
000BC7r 2                       sta tmp
000BC7r 2                       txa
000BC7r 2                       and #$22
000BC7r 2                       asl
000BC7r 2                       ora tmp
000BC7r 2                       sta tmp
000BC7r 2                       txa
000BC7r 2                       and #$11
000BC7r 2                       asl
000BC7r 2                       asl
000BC7r 2                       asl
000BC7r 2                       ora tmp
000BC7r 2                 .else
000BC7r 2                       txa
000BC7r 2                       and #$AA
000BC7r 2                       lsr
000BC7r 2                       sta tmp
000BC7r 2                       txa
000BC7r 2                       and #$55
000BC7r 2                       asl
000BC7r 2                       ora tmp
000BC7r 2                 .endif
000BC7r 2                       sta SWAPTAB,x
000BC7r 2                       inx
000BC7r 2                       bne @t
000BC7r 2                 .if .not MODE1
000BC7r 2                       ; sprite encoding (convert.py encode_sprite): bit 7 = both pixels opaque and never
000BC7r 2                       ; reaches the tables; left-black-only is code $44 (its $80 slot is taken)
000BC7r 2                       lda #$55
000BC7r 2                       sta MASKTAB+$44             ; keep the right screen pixel
000BC7r 2                       stz IDENT+$44               ; left pixel black
000BC7r 2                       lda #$44
000BC7r 2                       sta SWAPTAB+$40             ; right-black-only <-> left-black-only
000BC7r 2                       lda #$40
000BC7r 2                       sta SWAPTAB+$44
000BC7r 2                       lda #$FF                    ; $41 marks eight transparent bytes; if it reaches
000BC7r 2                       sta MASKTAB+$41             ; the tables (a clipped cell, or as a line 1..7)
000BC7r 2                       stza IDENT+$41               ; it must leave the screen byte alone.  $82 is its
000BC7r 2                       sta MASKTAB+$82             ; mirror image, and unreachable otherwise
000BC7r 2                       stz IDENT+$82
000BC7r 2                       ; MASKTAB+$80..: the mask of the mirrored byte, so the mirrored blitters do one
000BC7r 2                       ; lookup instead of SWAPTAB then MASKTAB (only codes < $80 are ever looked up)
000BC7r 2                       ldx #0
000BC7r 2               :       ldy SWAPTAB,x
000BC7r 2                       lda MASKTAB,y
000BC7r 2                       sta MASKTAB+$80,x
000BC7r 2                       lda IDENT,y
000BC7r 2                       sta IDENT+$80,x             ; and its OR value (differs from SWAPTAB only at \$40)
000BC7r 2                       inx
000BC7r 2                       bpl :-
000BC7r 2                 .endif
000BC7r 2                       jsr build_ring              ; ring row -> screen address
000BC7r 2                       ; row slot -> chars
000BC7r 2                       stz w16
000BC7r 2                       stz w16+1
000BC7r 2                       ldx #0
000BC7r 2               @m80:   lda w16+1
000BC7r 2                       sta mulrowhi,x
000BC7r 2                       lda w16
000BC7r 2                       sta mulrowlo,x
000BC7r 2                       clc
000BC7r 2                       adc #ROWCHARS
000BC7r 2                       sta w16
000BC7r 2                       bcc :+
000BC7r 2                       inc w16+1
000BC7r 2               :       inx
000BC7r 2                       cpx #RINGROWS
000BC7r 2                       bne @m80
000BC7r 2                       ldx #0
000BC7r 2                       lda #0
000BC7r 2               @m:     sta sprmul5,x
000BC7r 2                       clc
000BC7r 2                       adc #5
000BC7r 2                       inx
000BC7r 2                       cpx #MAXSPR
000BC7r 2                       bne @m
000BC7r 2                       stz RECCNT
000BC7r 2                       stz RECCNT+1
000BC7r 2                       stz DIRTYCNT
000BC7r 2                       stz DIRTYCNT+1
000BC7r 2                       stz BUF_VALID
000BC7r 2                       stz BUF_VALID+1
000BC7r 2                       stz NSPR
000BC7r 2                       stz SFXREQ
000BC7r 2                       stz SFXPTR+1
000BC7r 2                       stz MUSON
000BC7r 2                       stz DISPSECT
000BC7r 2                       stz curbuf
000BC7r 2                       lda #BANK_SPR
000BC7r 2                       sta spbank
000BC7r 2                       lda #$FF
000BC7r 2                       sta BUF_BARQ
000BC7r 2                       sta BUF_BARQ+1
000BC7r 2                       sta tset                    ; no tile set resident yet
000BC7r 2                       stz BARDIRTY
000BC7r 2                       stz BARBG
000BC7r 2                       lda #<VS2T_DEFAULT
000BC7r 2                       sta VS2T
000BC7r 2                       lda #>VS2T_DEFAULT
000BC7r 2                       sta VS2T+1
000BC7r 2                       rts
000BC7r 2               
000BC7r 2               
000BC7r 2               ; identity table for the sprite blitter (A | X without a temp store)
000BC7r 2                 .if .not MODE1
000BC7r 2               init_ident:
000BC7r 2                       ldx #0
000BC7r 2               :       txa
000BC7r 2                       sta IDENT,x
000BC7r 2                       inx
000BC7r 2                       bne :-
000BC7r 2                       rts
000BC7r 2                 .endif
000BC7r 2                 .endif
000BC7r 2                       PLACE "LOW2", "TILCODE"     ; back to the render helpers
000BC7r 2               
000BC7r 2               
000BC7r 2               ; ============================================================================
000BC7r 2               ; dirty tiles: redraw changed map tiles (both buffers keep their own list)
000BC7r 2               ; ============================================================================
000BC7r 2               mark_dirty:                         ; A = tx, X = ty  (adds to both buffers' lists)
000BC7r 2  85 rr                sta tmp
000BC9r 2  86 rr                stx tmp2
000BCBr 2  A2 00                ldx #0
000BCDr 2  BD rr rr     @b:     lda DIRTYCNT,x
000BD0r 2  C9 10                cmp #16
000BD2r 2  B0 19                bcs @next
000BD4r 2  0A                   asl
000BD5r 2  85 rr                sta tmp3
000BD7r 2  8A                   txa
000BD8r 2  0A                   asl
000BD9r 2  0A                   asl
000BDAr 2  0A                   asl
000BDBr 2  0A                   asl
000BDCr 2  0A                   asl                         ; x*32 -- X is 0 or 1, so the fifth asl cannot
000BDDr 2  65 rr                adc tmp3                    ; carry out and the clc is dead
000BDFr 2  A8                   tay
000BE0r 2  A5 rr                lda tmp
000BE2r 2  99 rr rr             sta DIRTYLIST,y
000BE5r 2  A5 rr                lda tmp2
000BE7r 2  99 rr rr             sta DIRTYLIST+1,y
000BEAr 2  FE rr rr             inc DIRTYCNT,x
000BEDr 2  E8           @next:  inx
000BEEr 2  E0 02                cpx #2
000BF0r 2  D0 DB                bne @b
000BF2r 2  60                   rts
000BF3r 2               
000BF3r 2               draw_dirty:
000BF3r 2  A6 rr                ldx curbuf
000BF5r 2  BD rr rr             lda DIRTYCNT,x
000BF8r 2  F0 3F                beq @done
000BFAr 2  85 rr                sta lcnt
000BFCr 2  8A                   txa
000BFDr 2  0A                   asl
000BFEr 2  0A                   asl
000BFFr 2  0A                   asl
000C00r 2  0A                   asl
000C01r 2  0A                   asl
000C02r 2  85 rr                sta lidx
000C04r 2  A4 rr        @l:     ldy lidx
000C06r 2  B9 rr rr             lda DIRTYLIST,y
000C09r 2  48 A9 00 85          stza rc_x+1
000C0Dr 2  rr 68        
000C0Fr 2  0A                   asl
000C10r 2  26 rr                rol rc_x+1
000C12r 2  0A                   asl
000C13r 2  26 rr                rol rc_x+1
000C15r 2  85 rr                sta rc_x
000C17r 2  B9 rr rr             lda DIRTYLIST+1,y
000C1Ar 2  C8                   iny                         ; Y is dead from here: advance the index in it
000C1Br 2  C8                   iny
000C1Cr 2  84 rr                sty lidx
000C1Er 2  0A                   asl
000C1Fr 2  85 rr                sta rc_y
000C21r 2  A9 04                lda #4
000C23r 2  85 rr                sta rc_w
000C25r 2  A9 02                lda #2
000C27r 2  85 rr                sta rc_h
000C29r 2  20 rr rr             jsr drawrect_clip
000C2Cr 2  C6 rr                dec lcnt
000C2Er 2  D0 D4                bne @l
000C30r 2  A6 rr                ldx curbuf
000C32r 2  48 A9 00 9D          stza DIRTYCNT,x
000C36r 2  rr rr 68     
000C39r 2  60           @done:  rts
000C3Ar 2               
000C3Ar 2                 .if .not MODELB                   ; (Model B: modelb/src/display.s, in bank 6)
000C3Ar 2                       .segment "CODE"
000C3Ar 2               
000C3Ar 2               ; ============================================================================
000C3Ar 2               ; IRQ handling
000C3Ar 2               ; ============================================================================
000C3Ar 2               irq_handler:
000C3Ar 2                       stx irq_x
000C3Ar 2                       sty irq_y
000C3Ar 2                       bit VIA_IFR
000C3Ar 2                       bvs @t1arm                  ; the T1 arm grew past bvc's reach: one cycle each way
000C3Ar 2                       jmp @notT1
000C3Ar 2               @t1arm: ; ---- rupture chain step.  This is a CRTC restart: the next section's address
000C3Ar 2                       ; was armed during the previous one and is latched at the boundary.  What the
000C3Ar 2                       ; new section needs quickly is its shape.  R9 and R4 together decide where the
000C3Ar 2                       ; section ENDS: the CRTC latches end-of-frame at the start of the scanline
000C3Ar 2                       ; where row = R4 and line = R9, so for a 2-line section (a partial with
000C3Ar 2                       ; R9 = 1) both must be in place before the start of scanline 1 -- 128 cycles
000C3Ar 2                       ; after the restart.  R6 is compared from scanline 1 on, so Q's R6 = 0 has
000C3Ar 2                       ; the same deadline.  Everything else has a row or more to spare.  The chain is
000C3Ar 2                       ; phased (VS2T_DEFAULT) so the step fires ~50 cycles BEFORE the restart, the
000C3Ar 2                       ; hold below carries the first write past it, and the three deadline registers
000C3Ar 2                       ; then land about 40, 60 and 80 cycles in, with the rest behind them.  Writing
000C3Ar 2                       ; R4 third put it at ~140 for a 2-line P2: that section never ended, Q's R6
000C3Ar 2                       ; hit never came, and both borders lit up on every scroll frame.
000C3Ar 2                       ; ACCCON D is different again: it is the memory map, sampled by every fetch,
000C3Ar 2                       ; so it must be in place BEFORE the boundary -- the bar's T1 fires a further
000C3Ar 2                       ; BARLEAD us early so D lands in the horizontal blanking of the bar's last line.
000C3Ar 2                       ldx SECIDX
000C3Ar 2                       cpx DISPSECT                ; the first step is the start of the bar itself, which
000C3Ar 2                       beq @noD                    ; is only main RAM to the CRTC while D = 0: leave it
000C3Ar 2                       lda ACCCON
000C3Ar 2                       and #$FE
000C3Ar 2                       ora dispD
000C3Ar 2                       sta ACCCON
000C3Ar 2               @noD:   ldy #5                      ; ~26 cycles: the first CRTC write must follow the
000C3Ar 2               @hold:  dey                         ; restart, and the step fires ahead of it
000C3Ar 2                       bne @hold
000C3Ar 2                       lda #9
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda SECTAB+3,x
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       lda #4
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda SECTAB+2,x
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       lda #6
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       ldy SECTAB+4,x
000C3Ar 2                       sty CRTC_DAT
000C3Ar 2                       lda #7
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda SECTAB+5,x
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       sta curR7                   ; the vsync handler re-phases the frame from this
000C3Ar 2                       lda #12
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda SECTAB,x
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       lda #13
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda SECTAB+1,x
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       lda SECTAB+6,x
000C3Ar 2                       sta VIA_T1LL
000C3Ar 2                       lda SECTAB+7,x
000C3Ar 2                       sta VIA_T1LH
000C3Ar 2                       lda VIA_T1CL                ; clear T1 flag
000C3Ar 2                       ; next entry; the chain stops at Q, the only entry whose R7 is the vsync row: a
000C3Ar 2                       ; late vsync must not walk the chain off the end of SECTAB.  Every other
000C3Ar 2                       ; section's R7 is 30, so C = 1 on the way past, as the adc below needs.
000C3Ar 2                       lda curR7                   ; R7, just written
000C3Ar 2                       cmp #QVSYNC
000C3Ar 2                       beq @stay
000C3Ar 2                       txa
000C3Ar 2                       adc #7                      ; cpy #0 always leaves C set, so this adds 8
000C3Ar 2                       sta SECIDX                  ; X is dead: @exit restores it from irq_x
000C3Ar 2               @stay:  ldy irq_y                   ; @exit inlined: no jmp on the chain-step path
000C3Ar 2                       ldx irq_x                   ; (X is still SECIDX here, so nothing to store)
000C3Ar 2                       lda $FC
000C3Ar 2                       rti
000C3Ar 2               @notT1:
000C3Ar 2                       lda VIA_IFR
000C3Ar 2                       and #$02
000C3Ar 2                       bne :+
000C3Ar 2                       jmp @exit
000C3Ar 2               :       ; ---- vsync: restart T1 first (constant latency), counter = vsync->T.  The
000C3Ar 2                       ; latch (how long section 0 lasts) is programmed further down, after the
000C3Ar 2                       ; flip, because with no status bar section 0's length depends on the fine
000C3Ar 2                       ; scroll and so belongs to the buffer that is about to be displayed.
000C3Ar 2                       lda VS2T
000C3Ar 2                       sta VIA_T1LL
000C3Ar 2                       lda VS2T+1
000C3Ar 2                       sta VIA_T1CH
000C3Ar 2                       lda #$02
000C3Ar 2                       sta VIA_IFR
000C3Ar 2                       ; re-phase: the vsync fired at row curR7, so end this frame at row curR7+5 with
000C3Ar 2                       ; 8-line rows -> T starts exactly 40 lines after the vsync even if the CRTC row
000C3Ar 2                       ; counter had run past its vertical total (which otherwise never recovers)
000C3Ar 2                       lda #9
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda #7
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       lda #6                      ; pre-arm the bar's R6 now, in Q, where the display
000C3Ar 2                       sta CRTC_IDX                ; is already off and a new R6 cannot show: the step
000C3Ar 2                       lda #BARROWS                ; ISR at the bar's start is too close to the second
000C3Ar 2                       sta CRTC_DAT                ; scanline to be trusted with it
000C3Ar 2                       lda #4
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda curR7
000C3Ar 2                       clc
000C3Ar 2                       adc #QROWS-1-QVSYNC
000C3Ar 2                       and #$7F
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       inc vsyncs
000C3Ar 2                       lda flipreq
000C3Ar 2                       beq @noflip
000C3Ar 2                       lda vsyncs
000C3Ar 2                       sec
000C3Ar 2                       sbc flipvs
000C3Ar 2                       cmp #2
000C3Ar 2                       bcc @noflip
000C3Ar 2                       lda vsyncs
000C3Ar 2                       sta flipvs
000C3Ar 2                       lda NEXTSECT
000C3Ar 2                       sta DISPSECT
000C3Ar 2                       lda NEXTBUF                 ; the flip is the section chain moving to the other
000C3Ar 2                       sta dispD                   ; buffer's rows; D follows it, but only from the
000C3Ar 2                       stz flipreq                 ; first playfield section -- the bar needs D = 0
000C3Ar 2               @noflip:
000C3Ar 2                       ; everything section 0 needs comes from the buffer that is about to be
000C3Ar 2                       ; displayed -- its start address, and (with no status bar) its length
000C3Ar 2                       ldx #0
000C3Ar 2                       ldy DISPSECT                ; held in Y: SECIDX wants the same byte below
000C3Ar 2                       beq :+
000C3Ar 2                       ldx #2
000C3Ar 2               :       lda BUF_SEC0T1,x
000C3Ar 2                       sta VIA_T1LL
000C3Ar 2                       lda BUF_SEC0T1+1,x
000C3Ar 2                       sta VIA_T1LH
000C3Ar 2                       lda #12
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda BUF_SEC0,x
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       lda #13
000C3Ar 2                       sta CRTC_IDX
000C3Ar 2                       lda BUF_SEC0+1,x
000C3Ar 2                       sta CRTC_DAT
000C3Ar 2                       lda #$40
000C3Ar 2                       sta VIA_IFR
000C3Ar 2                       sty SECIDX
000C3Ar 2                       lda ACCCON                  ; the bar is below $3000: it is only main RAM to the
000C3Ar 2                       and #$FE                    ; CRTC while D = 0
000C3Ar 2                       sta ACCCON
000C3Ar 2                       jsr scan_keys
000C3Ar 2                       jsr sound_tick
000C3Ar 2               @exit:
000C3Ar 2                       ldy irq_y
000C3Ar 2                       ldx irq_x
000C3Ar 2                       lda $FC
000C3Ar 2                       rti
000C3Ar 2               
000C3Ar 2               ; CA1 fires at the end of the 2-line vsync pulse.  -35 put every step ~5 us INTO its
000C3Ar 2               ; section; the further -36 puts it ~30 us before the restart, so that the shape
000C3Ar 2               ; registers land early in the first scanline -- see the chain step in irq_handler.
000C3Ar 2               VS2T_DEFAULT = (QROWS-QVSYNC)*8*LINE - 2*LINE - 35 - 36
000C3Ar 2                 .endif
000C3Ar 2               
000C3Ar 2               ; ---------------------------------------------------------------- keyboard
000C3Ar 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the interrupt's own work
000071r 2               scan_keys:
000071r 2  A9 7F                lda #$7F
000073r 2  8D 43 FE             sta VIA_DDRA
000076r 2  A9 03                lda #3
000078r 2  8D 40 FE             sta VIA_ORB                 ; disable keyboard autoscan
00007Br 2  A9 00 8D rr          stz KEYSCAN
00007Fr 2  rr           
000080r 2  A2 0A                ldx #10
000082r 2  BD rr rr     @k:     lda keytab,x
000085r 2  8D 4F FE             sta VIA_ORANH
000088r 2  AD 4F FE             lda VIA_ORANH
00008Br 2  10 09                bpl :+
00008Dr 2  BD rr rr             lda keybits,x
000090r 2                 .if MODELB
000090r 2  0D rr rr             ora KEYSCAN
000093r 2  8D rr rr             sta KEYSCAN
000096r 2                 .else
000096r 2                       tsb KEYSCAN
000096r 2                 .endif
000096r 2  CA           :       dex
000097r 2  10 E9                bpl @k
000099r 2  AD rr rr             lda KEYSCAN
00009Cr 2  85 rr                sta keys
00009Er 2  60                   rts
00009Fr 2  61 19 42 79  keytab:  .byte $61,$19, $42,$79, $48,$39,$49, $68,$29, $62, $70
0000A3r 2  48 39 49 68  
0000A7r 2  29 62 70     
0000AAr 2  01 01 02 02  keybits: .byte K_LEFT,K_LEFT, K_RIGHT,K_RIGHT, K_UP,K_UP,K_FIRE, K_DOWN,K_DOWN, K_FIRE, K_MENU
0000AEr 2  04 04 10 08  
0000B2r 2  08 10 20     
0000B5r 2               
0000B5r 2               ; ---------------------------------------------------------------- sound
0000B5r 2               ; sfx format: steps of (b0,b1,b2,frames) written to the SN76489 ; end = $FF
0000B5r 2               sound_tick:
0000B5r 2  A5 A5                lda SFXREQ
0000B7r 2  F0 15                beq @play
0000B9r 2                       ; start new sfx
0000B9r 2  0A                   asl
0000BAr 2  AA                   tax
0000BBr 2  BD rr rr             lda sfxtab-2,x
0000BEr 2  85 rr                sta SFXPTR
0000C0r 2  BD rr rr             lda sfxtab-1,x
0000C3r 2  85 rr                sta SFXPTR+1
0000C5r 2  A9 00 85 A5          stz SFXREQ
0000C9r 2  A9 01                lda #1
0000CBr 2  8D rr rr             sta SFXDUR
0000CEr 2  A5 rr        @play:  lda SFXPTR+1
0000D0r 2  F0 3F                beq @music
0000D2r 2  CE rr rr             dec SFXDUR
0000D5r 2  D0 3A                bne @music
0000D7r 2  A0 00 B1 rr          ldaz SFXPTR                 ; (zp): the first byte needs no index
0000DBr 2  C9 FF                cmp #$FF
0000DDr 2  F0 24                beq @end
0000DFr 2  20 rr rr             jsr sndwrite
0000E2r 2  A0 01                ldy #1
0000E4r 2  B1 rr                lda (SFXPTR),y
0000E6r 2  20 rr rr             jsr sndwrite
0000E9r 2  C8                   iny
0000EAr 2  B1 rr                lda (SFXPTR),y
0000ECr 2  20 rr rr             jsr sndwrite
0000EFr 2  C8                   iny
0000F0r 2  B1 rr                lda (SFXPTR),y
0000F2r 2  8D rr rr             sta SFXDUR
0000F5r 2  A5 rr                lda SFXPTR
0000F7r 2  18                   clc
0000F8r 2  69 04                adc #4
0000FAr 2  85 rr                sta SFXPTR
0000FCr 2  90 13                bcc @music
0000FEr 2  E6 rr                inc SFXPTR+1
000100r 2  4C rr rr             bra @music
000103r 2  A9 00 85 rr  @end:   stz SFXPTR+1
000107r 2  A9 DF                lda #$DF                    ; channel 2 off
000109r 2  20 rr rr             jsr sndwrite
00010Cr 2  A9 FF                lda #$FF
00010Er 2  20 rr rr             jsr sndwrite
000111r 2  4C rr rr     @music: jmp music_tick
000114r 2               
000114r 2               sndwrite:
000114r 2  48                   pha
000115r 2  A9 FF                lda #$FF
000117r 2  8D 43 FE             sta VIA_DDRA
00011Ar 2  A9 0B                lda #$0B
00011Cr 2  8D 40 FE             sta VIA_ORB                 ; keyboard autoscan on so the keyboard does not pull PA7
00011Fr 2  68                   pla
000120r 2  8D 4F FE             sta VIA_ORANH
000123r 2  A9 00                lda #0
000125r 2  8D 40 FE             sta VIA_ORB
000128r 2  EA                   nop
000129r 2  EA                   nop
00012Ar 2  EA                   nop
00012Br 2  EA                   nop
00012Cr 2  EA                   nop
00012Dr 2  EA                   nop
00012Er 2  EA                   nop
00012Fr 2  EA                   nop
000130r 2  A9 08                lda #8
000132r 2  8D 40 FE             sta VIA_ORB
000135r 2  A9 7F                lda #$7F
000137r 2  8D 43 FE             sta VIA_DDRA
00013Ar 2  60                   rts
00013Br 2               
00013Br 2               ; ---------------------------------------------------------------- music
00013Br 2               ; 144-byte period table then the sequence (4-byte records: frames, note0..2;
00013Br 2               ; frames = 0 -> loop).  It used to be hidden in bit 6 of the tile bytes, which only
00013Br 2               ; worked while the whole tile set was resident; a level now loads just the tiles it
00013Br 2               ; uses, so the music is its own file -- in bank 7 above the logic: bank 6 has no room
00013Br 2               ; ($B000 + 2208 bytes of box stars runs past $B800, which is where it used to sit, and
00013Br 2               ; the music load then took the tail off the last trampoline box).
00013Br 2                 .if .not MODELB                   ; (Model B: a label in bank 6, with the player)
00013Br 2               MUSIC_ADDR = $B000                  ; bank 7: LOGIC may reach $B000, LV_ALTTAB is at $BE00
00013Br 2                 .endif
00013Br 2               MUSIC_SEQ  = MUSIC_ADDR + 144
00013Br 2                 .if MODELB
00013Br 2               MUSIC_TAB  = MUSIC_ADDR             ; the player is in the data's bank: no copy needed
00013Br 2                 .else
00013Br 2               MUSIC_TAB  = music_tab              ; 72 x 2 byte periods (MIDI 24..95), decoded into RAM
00013Br 2                 .endif
00013Br 2               ; decode the period table (the first 144 hidden bytes) into music_tab; bank 5 loaded
00013Br 2               music_init:
00013Br 2                 .if MODELB
00013Br 2  60                   rts
00013Cr 2                 .else
00013Cr 2                       lda #BANK_LVL
00013Cr 2                       sta ROMSEL_CPY
00013Cr 2                       sta ROMSEL
00013Cr 2                       ldx #144
00013Cr 2               :       lda MUSIC_ADDR-1,x
00013Cr 2                       sta music_tab-1,x
00013Cr 2                       dex
00013Cr 2                       bne :-
00013Cr 2                       rts
00013Cr 2                 .endif
00013Cr 2               music_tick:
00013Cr 2  AD rr rr             lda MUSON
00013Fr 2  F0 2D                beq @done
000141r 2  CE rr rr             dec MUSDUR
000144r 2  D0 28                bne @done
000146r 2                 .if .not MODELB
000146r 2                       lda ROMSEL_CPY
000146r 2                       pha
000146r 2                       lda #BANK_LVL
000146r 2                       sta ROMSEL_CPY
000146r 2                       sta ROMSEL
000146r 2                 .endif
000146r 2  20 rr rr             jsr musbyte
000149r 2  D0 0B                bne :+
00014Br 2  A9 rr                lda #<MUSIC_SEQ
00014Dr 2  85 rr                sta MUSPTR
00014Fr 2  A9 rr                lda #>MUSIC_SEQ
000151r 2  85 rr                sta MUSPTR+1
000153r 2  20 rr rr             jsr musbyte
000156r 2  8D rr rr     :       sta MUSDUR
000159r 2  A2 00                ldx #0
00015Br 2  20 rr rr     @v:     jsr musbyte
00015Er 2  DD rr rr             cmp MUSNOTE,x
000161r 2  F0 06                beq :+
000163r 2  9D rr rr             sta MUSNOTE,x
000166r 2  20 rr rr             jsr set_voice
000169r 2  E8           :       inx
00016Ar 2  E0 03                cpx #3
00016Cr 2  D0 ED                bne @v
00016Er 2                 .if .not MODELB
00016Er 2                       pla
00016Er 2                       sta ROMSEL_CPY
00016Er 2                       sta ROMSEL
00016Er 2                 .endif
00016Er 2  60           @done:  rts
00016Fr 2               
00016Fr 2               ; A = next music byte; MUSPTR += 1.  Preserves X.  Z reflects A.  Bank 6 selected.
00016Fr 2               musbyte:
00016Fr 2  A0 00 B1 rr          ldaz MUSPTR
000173r 2  E6 rr                inc MUSPTR
000175r 2  D0 02                bne :+
000177r 2  E6 rr                inc MUSPTR+1
000179r 2  C9 00        :       cmp #0
00017Br 2  60                   rts
00017Cr 2               
00017Cr 2               
00017Cr 2               ; X = voice (0..2), A = MIDI note (0 = rest)
00017Cr 2               set_voice:
00017Cr 2  A8                   tay                         ; the note goes in Y before X is pushed: on a 6502
00017Dr 2  8A 48                phx                         ; phx is txa/pha and would land on it
00017Fr 2  8A                   txa
000180r 2  0A                   asl
000181r 2  0A                   asl
000182r 2  0A                   asl
000183r 2  0A                   asl
000184r 2  0A                   asl
000185r 2  8D rr rr             sta ISRT1                   ; ch << 5
000188r 2  C0 00                cpy #0
00018Ar 2  D0 08                bne @note
00018Cr 2  09 9F                ora #$9F                    ; A is still ch<<5
00018Er 2  20 rr rr             jsr sndwrite
000191r 2  68 AA                plx
000193r 2  60                   rts
000194r 2  98           @note:  tya
000195r 2  38                   sec
000196r 2  E9 18                sbc #24
000198r 2  0A                   asl
000199r 2  A8                   tay
00019Ar 2  B9 rr rr             lda MUSIC_TAB,y
00019Dr 2  29 0F                and #15
00019Fr 2  0D rr rr             ora ISRT1
0001A2r 2  09 80                ora #$80
0001A4r 2  20 rr rr             jsr sndwrite
0001A7r 2  B9 rr rr             lda MUSIC_TAB,y
0001AAr 2  4A                   lsr
0001ABr 2  4A                   lsr
0001ACr 2  4A                   lsr
0001ADr 2  4A                   lsr
0001AEr 2  8D rr rr             sta ISRT2
0001B1r 2  B9 rr rr             lda MUSIC_TAB+1,y
0001B4r 2  0A                   asl
0001B5r 2  0A                   asl
0001B6r 2  0A                   asl
0001B7r 2  0A                   asl
0001B8r 2  0D rr rr             ora ISRT2
0001BBr 2  20 rr rr             jsr sndwrite
0001BEr 2  68 AA                plx
0001C0r 2  BD rr rr             lda musvol,x
0001C3r 2  0D rr rr             ora ISRT1
0001C6r 2  09 90                ora #$90
0001C8r 2  4C rr rr             jmp sndwrite
0001CBr 2  03 08 08     musvol: .byte 3, 8, 8
0001CEr 2               
0001CEr 2               music_start:
0001CEr 2  A9 rr                lda #<MUSIC_SEQ
0001D0r 2  85 rr                sta MUSPTR
0001D2r 2  A9 rr                lda #>MUSIC_SEQ
0001D4r 2  85 rr                sta MUSPTR+1
0001D6r 2  A9 01                lda #1
0001D8r 2  8D rr rr             sta MUSDUR
0001DBr 2  48 A9 00 8D          stza MUSNOTE
0001DFr 2  rr rr 68     
0001E2r 2  48 A9 00 8D          stza MUSNOTE+1
0001E6r 2  rr rr 68     
0001E9r 2  48 A9 00 8D          stza MUSNOTE+2
0001EDr 2  rr rr 68     
0001F0r 2  8D rr rr             sta MUSON
0001F3r 2  60                   rts
0001F4r 2               
0001F4r 2               music_stop:
0001F4r 2  A9 00 8D rr          stz MUSON
0001F8r 2  rr           
0001F9r 2  A9 9F                lda #$9F
0001FBr 2  20 rr rr             jsr sndwrite
0001FEr 2  A9 BF                lda #$BF
000200r 2  20 rr rr             jsr sndwrite
000203r 2  A9 DF                lda #$DF
000205r 2  20 rr rr             jsr sndwrite
000208r 2  A9 FF                lda #$FF
00020Ar 2  4C rr rr             jmp sndwrite
00020Dr 2               
00020Dr 2               ; ---------------------------------------------------------------- interrupt takeover
00020Dr 2               take_over:
00020Dr 2  78                   sei
00020Er 2                 .if .not MODELB
00020Er 2                       lda IRQ1V
00020Er 2                       sta OLDIRQ
00020Er 2                       lda IRQ1V+1
00020Er 2                       sta OLDIRQ+1
00020Er 2                 .endif
00020Er 2  A9 rr                lda #<irq_handler
000210r 2  8D 04 02             sta IRQ1V
000213r 2  A9 rr                lda #>irq_handler
000215r 2  8D 05 02             sta IRQ1V+1
000218r 2  A9 7F                lda #$7F
00021Ar 2  8D 4E FE             sta VIA_IER
00021Dr 2  8D 6E FE             sta UVIA_IER
000220r 2  AD 4B FE             lda VIA_ACR
000223r 2  29 3F                and #$3F
000225r 2  09 40                ora #$40                    ; T1 continuous
000227r 2  8D 4B FE             sta VIA_ACR
00022Ar 2  A9 00                lda #<(40*LINE)
00022Cr 2  8D 46 FE             sta VIA_T1LL
00022Fr 2  A9 0A                lda #>(40*LINE)
000231r 2  8D 45 FE             sta VIA_T1CH
000234r 2  A9 C2                lda #$C2                    ; enable CA1 (vsync) + T1
000236r 2  8D 4E FE             sta VIA_IER
000239r 2  A9 7F                lda #$7F
00023Br 2  8D 4D FE             sta VIA_IFR
00023Er 2  48 A9 00 85          stza flipreq
000242r 2  rr 68        
000244r 2  58                   cli
000245r 2  60                   rts
000246r 2               
000246r 2               ; ============================================================================
000246r 2               ; CRTC / palette setup
000246r 2               ; ============================================================================
000246r 2                 .if .not MODELB                   ; (Model B: modelb/src/display.s)
000246r 2               crtc_init:
000246r 2                       ; standard MODE 2 timings, no interlace, cursor off
000246r 2                       ldx #0
000246r 2               :       stx CRTC_IDX
000246r 2                       lda crtctab,x
000246r 2                       sta CRTC_DAT
000246r 2                       inx
000246r 2                       cpx #14
000246r 2                       bne :-
000246r 2                       lda crtctab+7
000246r 2                       sta curR7
000246r 2                       rts
000246r 2               crtctab: .byte 127,ROWCHARS,98,$28, 38,0,32,34, 0,7, $20,8, $06,$00
000246r 2               .if (RINGROWS & (RINGROWS - 1)) <> 0
000246r 2               ringmodtab:                         ; only a non-power-of-two ring needs the table; at
000246r 2               .repeat 256, i                      ; RINGROWS = 32 ringmod is `and #31` and this is 256
000246r 2                       .byte i .mod RINGROWS       ; bytes of main RAM that the bar now uses instead
000246r 2               .endrepeat
000246r 2               .endif
000246r 2                 .endif
000246r 2               
000246r 2               set_palette:
000246r 2                 .if MODE1
000246r 2                       ; MODE 1: a pixel's two bits land in bits 3 and 1 of the palette index, the other
000246r 2                       ; two bits are don't-cares, so all 16 entries are written: logical 0..3 = K C M Y
000246r 2  A2 0F                ldx #15
000248r 2  8A           :       txa
000249r 2  29 08                and #8
00024Br 2  4A                   lsr
00024Cr 2  4A                   lsr
00024Dr 2  85 rr                sta tmp
00024Fr 2  8A                   txa
000250r 2  29 02                and #2
000252r 2  4A                   lsr
000253r 2  05 rr                ora tmp
000255r 2  A8                   tay
000256r 2  B9 rr rr             lda @cmyk,y
000259r 2  85 rr                sta tmp
00025Br 2  8A                   txa
00025Cr 2  0A                   asl
00025Dr 2  0A                   asl
00025Er 2  0A                   asl
00025Fr 2  0A                   asl
000260r 2  05 rr                ora tmp
000262r 2  8D 21 FE             sta ULA_PAL
000265r 2  CA                   dex
000266r 2  10 E0                bpl :-
000268r 2  60                   rts
000269r 2  07 01 02 04  @cmyk:  .byte 0^7, 6^7, 5^7, 3^7    ; physical black, cyan, magenta, yellow (inverted)
00026Dr 2                 .else
00026Dr 2                       ldx #15
00026Dr 2               :       txa
00026Dr 2                       asl
00026Dr 2                       asl
00026Dr 2                       asl
00026Dr 2                       asl
00026Dr 2                       sta tmp
00026Dr 2                       txa
00026Dr 2                       and #7
00026Dr 2                       eor #7
00026Dr 2                       ora tmp
00026Dr 2                       sta ULA_PAL
00026Dr 2                       dex
00026Dr 2                       bpl :-
00026Dr 2                       rts
00026Dr 2                 .endif
00026Dr 2               
00026Dr 2               blank_palette:
00026Dr 2  A2 0F                ldx #15
00026Fr 2  8A           :       txa
000270r 2  0A                   asl
000271r 2  0A                   asl
000272r 2  0A                   asl
000273r 2  0A                   asl
000274r 2  09 07                ora #7
000276r 2  8D 21 FE             sta ULA_PAL
000279r 2  CA                   dex
00027Ar 2  10 F3                bpl :-
00027Cr 2  60                   rts
00027Dr 2                 .if .not MODELB                   ; (Model B: static tables in the banks that read them,
00027Dr 2                       .segment "TABLES"           ;  and no disc loader -- modelb/src/banks.s)
00027Dr 2               sprmul5: .res MAXSPR
00027Dr 2               mulrowlo: .res RINGROWS
00027Dr 2               mulrowhi: .res RINGROWS
00027Dr 2                       .code
00027Dr 2               
00027Dr 2               ; ============================================================================
00027Dr 2               ; Disc loading: polled WD1770 sector reads (DFS single density, 10 x 256 byte sectors/track)
00027Dr 2               ; file table entries: sector lo, hi, nsectors, bank, dest hi (dest lo = 0)
00027Dr 2               ; ============================================================================
00027Dr 2               FDC_CTRL = $FE24
00027Dr 2               FDC_STAT = $FE28
00027Dr 2               FDC_CMD  = $FE28
00027Dr 2               FDC_TRK  = $FE29
00027Dr 2               FDC_SEC  = $FE2A
00027Dr 2               FDC_DATA = $FE2B
00027Dr 2               
00027Dr 2                       .segment "TABLES"
00027Dr 2               ld_sec:    .res 2
00027Dr 2               ld_n:      .res 1
00027Dr 2               ld_trk:    .res 1
00027Dr 2               ld_sc:     .res 1
00027Dr 2               cur_trk:   .res 1
00027Dr 2               ld_done:   .res 1
00027Dr 2               ld_secs:   .res 1
00027Dr 2                       .code
00027Dr 2               
00027Dr 2               ; NMI handler (reached via JMP at $0D00): 1770 data request / completion (multi-sector read)
00027Dr 2               nmi_handler:
00027Dr 2                       pha
00027Dr 2                       lda FDC_STAT
00027Dr 2                       and #3
00027Dr 2                       cmp #3
00027Dr 2                       bne nmi_nd
00027Dr 2                       lda FDC_DATA
00027Dr 2               nmi_sta:
00027Dr 2                       sta $FFFF
00027Dr 2                       inc nmi_sta+1
00027Dr 2                       bne :+
00027Dr 2                       inc nmi_sta+2
00027Dr 2                       dec ld_secs                 ; a whole sector done
00027Dr 2                       bne :+
00027Dr 2                       lda #$D0                    ; force interrupt: stop the multi-sector read
00027Dr 2                       sta FDC_CMD
00027Dr 2                       lda #1
00027Dr 2                       sta ld_done
00027Dr 2               :       pla
00027Dr 2                       rti
00027Dr 2               nmi_nd: and #1
00027Dr 2                       bne :+
00027Dr 2                       lda #1
00027Dr 2                       sta ld_done
00027Dr 2               :       pla
00027Dr 2                       rti
00027Dr 2               
00027Dr 2               ; The 1770 answers at $FE24 (control) and $FE28 (registers).  Control has reset in
00027Dr 2               ; bit 2 (active low) and density in bit 5.
00027Dr 2               ; initialise: reset controller, restore head to track 0
00027Dr 2               disc_init:
00027Dr 2                       lda #$20
00027Dr 2                       sta FDC_CTRL                ; reset asserted (active low bit 2)
00027Dr 2                       lda #$25
00027Dr 2                       sta FDC_CTRL                ; drive 0, FM, reset released
00027Dr 2                       lda #$00                    ; restore, spin up, 6ms
00027Dr 2                       sta FDC_CMD
00027Dr 2                       jsr fdc_wait
00027Dr 2                       stza cur_trk
00027Dr 2                       rts
00027Dr 2               
00027Dr 2               fdc_wait:
00027Dr 2                       ldx #20
00027Dr 2               :       dex
00027Dr 2                       bne :-
00027Dr 2               :
00027Dr 2                       lda FDC_STAT
00027Dr 2                       and #1
00027Dr 2                       bne :-
00027Dr 2                       rts
00027Dr 2               
00027Dr 2               ; load file A (index into filetab) into its destination
00027Dr 2               loadfile:
00027Dr 2                       pha
00027Dr 2                       jsr music_stop
00027Dr 2                       pla
00027Dr 2                       tax
00027Dr 2                       lda ft_seclo,x
00027Dr 2                       sta ld_sec
00027Dr 2                       lda ft_sechi,x
00027Dr 2                       sta ld_sec+1
00027Dr 2                       lda ft_n,x
00027Dr 2                       sta ld_n
00027Dr 2                       lda ft_bank,x
00027Dr 2                       beq :+
00027Dr 2                       sta ROMSEL_CPY
00027Dr 2                       sta ROMSEL
00027Dr 2               :       lda ft_dest,x
00027Dr 2                       sta ptr+1
00027Dr 2                       stz ptr
00027Dr 2                       ; read ld_n sectors from linear sector ld_sec to ptr
00027Dr 2               ldread:
00027Dr 2                       ; track/sector from linear sector
00027Dr 2                       stz ld_trk
00027Dr 2                       lda ld_sec
00027Dr 2                       sta ld_sc
00027Dr 2                       lda ld_sec+1
00027Dr 2                       beq :++
00027Dr 2               :       lda ld_sc                   ; subtract 256 = 25 tracks + 6 sectors
00027Dr 2                       clc
00027Dr 2                       adc #6
00027Dr 2                       sta ld_sc
00027Dr 2                       lda ld_trk
00027Dr 2                       adc #25
00027Dr 2                       sta ld_trk
00027Dr 2                       dec ld_sec+1
00027Dr 2                       bne :-
00027Dr 2               :       lda ld_sc
00027Dr 2                       cmp #10
00027Dr 2                       bcc ldr_trk
00027Dr 2                       sbc #10
00027Dr 2                       sta ld_sc
00027Dr 2                       inc ld_trk
00027Dr 2                       bra :-
00027Dr 2               ldr_trk: lda ld_trk
00027Dr 2                       cmp cur_trk
00027Dr 2                       beq ldr_rd
00027Dr 2                       sta cur_trk
00027Dr 2                       sta FDC_DATA
00027Dr 2                       lda #$10                    ; seek (no verify)
00027Dr 2                       sta FDC_CMD
00027Dr 2                       jsr fdc_wait
00027Dr 2               ldr_rd:  ; sectors to read on this track: min(ld_n, 10 - ld_sc)
00027Dr 2                       lda #10
00027Dr 2                       sec
00027Dr 2                       sbc ld_sc
00027Dr 2                       cmp ld_n
00027Dr 2                       bcc :+
00027Dr 2                       lda ld_n
00027Dr 2               :       sta ld_secs
00027Dr 2                       sta tmp
00027Dr 2                       lda ld_sc
00027Dr 2                       sta FDC_SEC
00027Dr 2                       lda ptr
00027Dr 2                       sta nmi_sta+1
00027Dr 2                       lda ptr+1
00027Dr 2                       sta nmi_sta+2
00027Dr 2                       stz ld_done
00027Dr 2                       lda #$94                    ; read multiple sectors with head settle (NMI handler transfers and stops)
00027Dr 2                       sta FDC_CMD
00027Dr 2                       ldx #20
00027Dr 2               :       dex
00027Dr 2                       bne :-
00027Dr 2               :       lda ld_done
00027Dr 2                       bne :+
00027Dr 2                       lda FDC_STAT                ; fallback: command finished without a completion NMI
00027Dr 2                       and #1
00027Dr 2                       bne :-
00027Dr 2               :       jsr fdc_wait                ; the abort takes a moment to clear busy
00027Dr 2                       lda ptr+1
00027Dr 2                       clc
00027Dr 2                       adc tmp
00027Dr 2                       sta ptr+1
00027Dr 2                       lda ld_n
00027Dr 2                       sec
00027Dr 2                       sbc tmp
00027Dr 2                       sta ld_n
00027Dr 2                       beq ldr_end
00027Dr 2                       stza ld_sc
00027Dr 2                       inc ld_trk
00027Dr 2                       bra ldr_trk
00027Dr 2               ldr_end:  rts
00027Dr 2                 .endif
00027Dr 2               
00027Dr 2                       PLACE "LOW2", "LOWCODE"     ; main RAM under the screen is full; the old MOS
000000r 2               ; ============================================================================
000000r 2               ; Map access for the logic, which lives in bank 7 and so cannot select bank 6
000000r 2               ; itself.  Each of these leaves bank 7 selected, so the logic calls them directly.
000000r 2               ; ============================================================================
000000r 2               ; A = tile row -> mapptr = address of that map row
000000r 2                 .if MODELB
000000r 2                       .assert MAPLW = 7, error, "maprow assumes 128-tile rows"
000000r 2  4A           maprow: lsr                         ; row * 128: the row's low bit is the low byte's top
000001r 2  8D DA 00             sta mapptr+1
000004r 2  A9 00                lda #0
000006r 2  6A                   ror
000007r 2  8D D9 00             sta mapptr
00000Ar 2  AD DA 00             lda mapptr+1
00000Dr 2  18                   clc
00000Er 2  69 rr                adc #>LV_MAP
000010r 2  8D DA 00             sta mapptr+1
000013r 2  60                   rts
000014r 2                 .else
000014r 2               maprow: tay
000014r 2                       lda #BANK_MAP
000014r 2                       sta ROMSEL_CPY
000014r 2                       sta ROMSEL
000014r 2                       lda LV_MAPROWLO,y
000014r 2                       sta mapptr
000014r 2                       lda LV_MAPROWHI,y
000014r 2                       sta mapptr+1
000014r 2                       jmp pagelogic
000014r 2                 .endif
000014r 2               
000014r 2               ; A = (mapptr),y ; Y preserved
000014r 2               mapbyte:
000014r 2  A9 06                lda #BANK_MAP
000016r 2  85 F4                sta ROMSEL_CPY
000018r 2  8D 30 FE             sta ROMSEL
00001Br 2  B1 D9                lda (mapptr),y
00001Dr 2  4C rr rr             jmp pagelogic
000020r 2               
000020r 2               ; store A at (mapptr),y ; Y preserved
000020r 2  48           mapput: pha
000021r 2  A9 06                lda #BANK_MAP
000023r 2  85 F4                sta ROMSEL_CPY
000025r 2  8D 30 FE             sta ROMSEL
000028r 2  68                   pla
000029r 2  91 D9                sta (mapptr),y
00002Br 2  4C rr rr             jmp pagelogic
00002Er 2               
00002Er 2               ; the level's map row address table, from maplw (level_init's first job)
00002Er 2                 .if MODELB
00002Er 2                       .segment "LGCLO"
000023r 2               init_maprows:                       ; the row address is arithmetic here (maprow,
000023r 2  60                   rts                         ; maprow5): there is no table to build
000024r 2                 .else
000024r 2               init_maprows:
000024r 2                       lda #BANK_MAP
000024r 2                       sta ROMSEL_CPY
000024r 2                       sta ROMSEL
000024r 2                       stz t16
000024r 2                       lda #>LV_MAP
000024r 2                       sta t16+1
000024r 2                       stz t16b                    ; row stride = 1 << maplw bytes
000024r 2                       stz t16b+1
000024r 2                       ldx maplw
000024r 2                       cpx #8
000024r 2                       beq :++
000024r 2                       lda #1
000024r 2               :       asl
000024r 2                       dex
000024r 2                       bne :-
000024r 2                       sta t16b
000024r 2                       bra :++
000024r 2               :       lda #1
000024r 2                       sta t16b+1
000024r 2               :       lda t16b                    ; (this ':' is counted by the beq/bra :++ above)
000024r 2                       sta MAPSTRIDE
000024r 2                       lda t16b+1
000024r 2                       sta MAPSTRIDE+1
000024r 2                       ldx #0
000024r 2               :       lda t16
000024r 2                       sta LV_MAPROWLO,x
000024r 2                       clc
000024r 2                       adc t16b
000024r 2                       sta t16
000024r 2                       lda t16+1
000024r 2                       sta LV_MAPROWHI,x
000024r 2                       adc t16b+1
000024r 2                       sta t16+1
000024r 2                       inx
000024r 2                       bne :-
000024r 2                       jmp pagelogic
000024r 2                 .endif
000024r 2               
000024r 2               ; build_tileaddr: the tile id -> data address table, into bank 6 at LV_PAGE0.  Ids
000024r 2               ; 0..253 address 64 bytes each from $8000 in the tile bank; 254 and 255 are the two
000024r 2               ; solid fills, which own no bytes there -- hi bit 6 says "fill from a constant" and
000024r 2               ; lo bit 4 picks cyan over black.  Constant, so this runs once at startup.
000024r 2                       PLACE "LOW2", "TILCODE"     ; Model B: the table is in bank 5 with the tiles
000C3Ar 2               build_tileaddr:
000C3Ar 2                 .if .not MODELB
000C3Ar 2                       lda #BANK_MAP
000C3Ar 2                       sta ROMSEL_CPY
000C3Ar 2                       sta ROMSEL
000C3Ar 2                 .endif
000C3Ar 2  A2 00                ldx #0
000C3Cr 2  8A           @t:     txa
000C3Dr 2  0A                   asl                         ; (id & 3) << 6: the rest shifts out
000C3Er 2  0A                   asl
000C3Fr 2  0A                   asl
000C40r 2  0A                   asl
000C41r 2  0A                   asl
000C42r 2  0A                   asl
000C43r 2  9D rr rr             sta LV_PAGE0,x
000C46r 2  8A                   txa
000C47r 2  4A                   lsr
000C48r 2  4A                   lsr
000C49r 2                 .if MODELB
000C49r 2  18                   clc                         ; the tiles sit at TILES (page aligned), not $8000
000C4Ar 2  69 rr                adc #>TILES
000C4Cr 2                 .else
000C4Cr 2                       ora #$80                    ; $80 | id >> 2
000C4Cr 2                 .endif
000C4Cr 2  9D rr rr             sta LV_PAGE0+256,x
000C4Fr 2  E8                   inx
000C50r 2  D0 EA                bne @t
000C52r 2  A9 C0                lda #$C0                    ; the two solid ids carry a fill, not an address
000C54r 2  8D rr rr             sta LV_PAGE0+256+SOLID_CYAN
000C57r 2  8D rr rr             sta LV_PAGE0+256+SOLID_BLACK
000C5Ar 2  A9 10                lda #$10
000C5Cr 2  8D rr rr             sta LV_PAGE0+SOLID_CYAN
000C5Fr 2  A9 00 8D rr          stz LV_PAGE0+SOLID_BLACK
000C63r 2  rr           
000C64r 2  4C rr rr             jmp pagelogic
000C67r 2               
000C67r 2                 .if .not MODELB
000C67r 2               ; one font glyph out of bank 4, for the menus
000C67r 2               getglyph:
000C67r 2                       lda #HUD_BANK
000C67r 2                       sta ROMSEL_CPY
000C67r 2                       sta ROMSEL
000C67r 2                       ldy #7
000C67r 2               :       lda (w16b),y
000C67r 2                       sta GLYPHBUF,y
000C67r 2                       dey
000C67r 2                       bpl :-
000C67r 2                       jmp pagelogic
000C67r 2                       .segment "CODE"
000C67r 2                 .endif
000C67r 2               
000C67r 2                       PLACE "LOW2", "TILCODE"
000C67r 2               ; the screen address of each ring row, from the base of the buffer being drawn
000C67r 2               build_ring:
000C67r 2                 .if MODELB
000C67r 2  A9 80                lda #<RING_A                ; both bases are xx80: the high byte is the buffer's
000C69r 2  85 rr                sta w16
000C6Br 2  A5 E0                lda ringbhi
000C6Dr 2                 .else
000C6Dr 2                       stz w16
000C6Dr 2                       lda #>RINGBASE
000C6Dr 2                 .endif
000C6Dr 2  85 rr                sta w16+1
000C6Fr 2  A2 00                ldx #0
000C71r 2  A5 rr        @r:     lda w16+1
000C73r 2  9D rr rr             sta RINGHI,x
000C76r 2  A5 rr                lda w16
000C78r 2  9D rr rr             sta RINGLO,x
000C7Br 2  18                   clc
000C7Cr 2  69 80                adc #<ROWBYTES
000C7Er 2  85 rr                sta w16
000C80r 2  A5 rr                lda w16+1
000C82r 2  69 02                adc #>ROWBYTES
000C84r 2  85 rr                sta w16+1
000C86r 2  E8                   inx
000C87r 2  E0 17                cpx #RINGROWS
000C89r 2  D0 E6                bne @r
000C8Br 2  60                   rts
000C8Cr 2                 .if .not MODELB
000C8Cr 2                       .segment "CODE"
000C8Cr 2               
000C8Cr 2               ; ---------------------------------------------------------------- level tiles
000C8Cr 2               ; There are two fixed tile sets, outdoors and indoors, each a bank of at most
000C8Cr 2               ; 256 tiles, and a level's header says which it wants.  Levels alternate, so
000C8Cr 2               ; this reads 16K about every other level and nothing in between.
000C8Cr 2               load_tiles:
000C8Cr 2                       setbank BANK_LVL
000C8Cr 2                       lda LV_HDR+20               ; which tile set (header: 20 fixed bytes, then gset)
000C8Cr 2                       cmp tset
000C8Cr 2                       beq :+
000C8Cr 2                       sta tset
000C8Cr 2                       clc
000C8Cr 2                       adc #FI_TILESO
000C8Cr 2                       jmp loadfile
000C8Cr 2               :       rts
000C8Cr 2                 .endif
000C8Cr 2               
000C8Cr 2               ; sign extend A -> tmp3 (0 or $FF).  In LOW2 (the old MOS vector page) because main
000C8Cr 2               ; RAM below the screen is full: there is room to spare there.
000C8Cr 2                       PLACE "LOW2", "TILCODE"     ; (its one caller is the sprite prologue)
000C8Cr 2  29 80        sext:   and #$80
000C8Er 2  F0 02                beq :+
000C90r 2  A9 FF                lda #$FF
000C92r 2  85 rr        :       sta tmp3
000C94r 2  60                   rts
000C95r 2               
000C95r 2               ; ============================================================================
000C95r 2               ; Bridges between main RAM and the game logic, which lives at $8900 in bank 7 --
000C95r 2               ; a choice inherited from the Model B, which had no HAZEL to put it in.  t_ goes
000C95r 2               ; in, m_ comes back out:
000C95r 2               ; both leave bank 7 selected on return, so a tail jump through one is as good as
000C95r 2               ; a call.  pagelogic is the whole of the bank switch and the return path of m_.
000C95r 2               ; ============================================================================
000C95r 2                       PLACE "LOW2", "LOWCODE"
00002Er 2               pagelogic:                          ; A, X, Y and the carry all come through intact:
00002Er 2  48                   pha                         ; these sit in the middle of calls that return values
00002Fr 2  A9 07                lda #BANK_LVL
000031r 2  85 F4                sta ROMSEL_CPY
000033r 2  8D 30 FE             sta ROMSEL
000036r 2  68                   pla
000037r 2  60                   rts
000038r 2                 .if .not MODELB
000038r 2               .macro TOBANK n
000038r 2               .ident(.concat("t_", n)):
000038r 2                       jsr pagelogic
000038r 2                       jmp .ident(n)
000038r 2               .endmacro
000038r 2               ; Only TOBANK pays for pagelogic being a subroutine: the jsr and its rts are 12 cycles
000038r 2               ; of ceremony, where m_ and the six direct `jmp pagelogic` are tail jumps that waste
000038r 2               ; nothing.  Of pagelogic's 54 executions a frame only 3.1 are t_ entries, so this is
000038r 2               ; worth 36 cycles a frame, not the 646 the window-wide count suggested.  The inline form
000038r 2               ; is 7 bytes dearer and the bridges live in LOW2, which has ten bytes to its name -- so
000038r 2               ; the two that are worth it move to CODE, which gives LOW2 twelve bytes back.
000038r 2               .macro TOBANKI n
000038r 2               .ident(.concat("t_", n)):
000038r 2                       pha
000038r 2                       lda #BANK_LVL
000038r 2                       sta ROMSEL_CPY
000038r 2                       sta ROMSEL
000038r 2                       pla
000038r 2                       jmp .ident(n)
000038r 2               .endmacro
000038r 2                       .segment "CODE"             ; the two hot bridges, inlined, out of LOW2
000038r 2                       TOBANKI "game_frame"
000038r 2                       TOBANKI "build_sections"
000038r 2                       .segment "LOW2"
000038r 2               
000038r 2               .macro TOMAIN n
000038r 2               .ident(.concat("m_", n)):
000038r 2                       jsr .ident(n)
000038r 2                       jmp pagelogic
000038r 2               .endmacro
000038r 2                       TOBANK "init_tables"
000038r 2                       TOBANK "draw_health"
000038r 2                       TOBANK "draw_lives"
000038r 2                       TOBANK "draw_score"
000038r 2                       TOBANK "redraw_hud"
000038r 2                       TOBANK "draw_stars"
000038r 2                       TOBANK "help_screen"
000038r 2                       TOBANK "level_init"
000038r 2                       TOBANK "level_select"
000038r 2                       TOBANK "pause_menu"
000038r 2                       TOBANK "title_menu"
000038r 2                       TOBANK "winlose"
000038r 2                       TOMAIN "addsprite"
000038r 2                       TOMAIN "blank_palette"
000038r 2                       TOMAIN "calc_ring"
000038r 2                       TOMAIN "clamp_window"
000038r 2                       TOMAIN "drawsprite"
000038r 2                       TOMAIN "loadfile"
000038r 2                       TOMAIN "mark_dirty"
000038r 2               
000038r 2                       .segment "CODE"
000038r 2                       TOMAIN "music_start"
000038r 2                       TOMAIN "music_stop"
000038r 2                       TOMAIN "ringaddr"
000038r 2                       TOMAIN "rnd"
000038r 2                       TOMAIN "select_backbuf"
000038r 2                       TOMAIN "set_palette"
000038r 2                       TOMAIN "wait_flip"
000038r 2                 .else
000038r 2               ; Model B: the logic and the game loop share bank 7, so a bridge to it is only a
000038r 2               ; name; what crosses a bank goes through the far table (modelb/src/defs.inc), and
000038r 2               ; the menus, which the one-level disc does without, are stubs.
000038r 2               t_game_frame = game_frame
000038r 2               t_level_init = level_init
000038r 2               m_addsprite  = addsprite
000038r 2               m_clamp_window = clamp_window
000038r 2               m_rnd        = rnd
000038r 2                       .segment "LGCLO"            ; bank 7's first page, with the entry vector
000024r 2               m_mark_dirty:                       ; A = tx, X = ty -> the lists are in bank 5, and a
000024r 2  48                   pha                         ; far call keeps only A and Y: ty travels in Y
000025r 2  8A                   txa
000026r 2  A8                   tay
000027r 2  68                   pla
000028r 2  A2 09 20 rr          farjsr F_MARKDIRTY
00002Cr 2  rr           
00002Dr 2  60                   rts
00002Er 2               MENU_HELP = 1
00002Er 2               t_title_menu:                       ; "play": never the help screen
00002Er 2  A9 00                lda #0
000030r 2  60                   rts
000031r 2               t_help_screen:
000031r 2               t_pause_menu:                       ; resume
000031r 2               t_winlose:
000031r 2  A9 00                lda #0
000033r 2  60                   rts
000034r 2               t_level_select:                     ; the level is the one on the disc
000034r 2  A9 01                lda #LEVEL_IDX/2
000036r 2  60                   rts
000037r 2               t_redraw_hud = redraw_hud
000037r 2                       .segment "TILCODE"
000C95r 2               mark_dirty_far:                     ; the far entry: Y = ty back into X
000C95r 2  98                   tya
000C96r 2  AA                   tax
000C97r 2  4C rr rr             jmp mark_dirty
000C9Ar 2                 .endif
000C9Ar 2               
000C9Ar 2               ; ============================================================================
000C9Ar 2               ; Random
000C9Ar 2               ; ============================================================================
000C9Ar 2                       PLACE "CODE", "LGCLO"
000037r 2  46 rr        rnd:    lsr seed+1
000039r 2  66 rr                ror seed
00003Br 2  90 06                bcc :+
00003Dr 2  A5 rr                lda seed+1
00003Fr 2  49 B4                eor #$B4
000041r 2  85 rr                sta seed+1
000043r 2  A5 rr        :       lda seed
000045r 2  60                   rts
000046r 2               
000046r 1                       .include "logic.s"
000046r 2               ; ============================================================================
000046r 2               ; CLEO - game logic (port of CleoApp.run() from the J2ME original)
000046r 2               ; ============================================================================
000046r 2               
000046r 2               ; ---------------------------------------------------------------- 16-bit macros
000046r 2               .macro mov16 dst, src
000046r 2                       lda src
000046r 2                       sta dst
000046r 2                       lda src+1
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro mov16i dst, imm
000046r 2                       lda #<(imm)
000046r 2                       sta dst
000046r 2                       lda #>(imm)
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro add16 dst, src
000046r 2                       clc
000046r 2                       lda dst
000046r 2                       adc src
000046r 2                       sta dst
000046r 2                       lda dst+1
000046r 2                       adc src+1
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro add16i dst, imm
000046r 2                       clc
000046r 2                       lda dst
000046r 2                       adc #<(imm)
000046r 2                       sta dst
000046r 2                       lda dst+1
000046r 2                       adc #>(imm)
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro sub16 dst, src
000046r 2                       sec
000046r 2                       lda dst
000046r 2                       sbc src
000046r 2                       sta dst
000046r 2                       lda dst+1
000046r 2                       sbc src+1
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro sub16i dst, imm
000046r 2                       sec
000046r 2                       lda dst
000046r 2                       sbc #<(imm)
000046r 2                       sta dst
000046r 2                       lda dst+1
000046r 2                       sbc #>(imm)
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               ; dst = a - b
000046r 2               .macro dif16 dst, aa, bb
000046r 2                       sec
000046r 2                       lda aa
000046r 2                       sbc bb
000046r 2                       sta dst
000046r 2                       lda aa+1
000046r 2                       sbc bb+1
000046r 2                       sta dst+1
000046r 2               .endmacro
000046r 2               .macro asr16 var
000046r 2                       lda var+1
000046r 2                       cmp #$80
000046r 2                       ror var+1
000046r 2                       ror var
000046r 2               .endmacro
000046r 2               .macro asl16 var
000046r 2                       asl var
000046r 2                       rol var+1
000046r 2               .endmacro
000046r 2               .macro neg16 var
000046r 2                       sec
000046r 2                       lda #0
000046r 2                       sbc var
000046r 2                       sta var
000046r 2                       lda #0
000046r 2                       sbc var+1
000046r 2                       sta var+1
000046r 2               .endmacro
000046r 2               ; sign-extend 8-bit A into dst
000046r 2               .macro sx16 dst
000046r 2                       sta dst
000046r 2                       and #$80
000046r 2                       beq :+
000046r 2                       lda #$FF
000046r 2               :       sta dst+1
000046r 2               .endmacro
000046r 2               ; branch if var > imm (signed 16)
000046r 2               .macro bgt16i var, imm, label
000046r 2                       lda #<(imm)
000046r 2                       cmp var
000046r 2                       lda #>(imm)
000046r 2                       sbc var+1
000046r 2                       bvc :+
000046r 2                       eor #$80
000046r 2               :      bmi label
000046r 2               .endmacro
000046r 2               ; branch if var < imm
000046r 2                       ; branch if var < imm
000046r 2               .macro blt16i var, imm, label
000046r 2                       lda var
000046r 2                       cmp #<(imm)
000046r 2                       lda var+1
000046r 2                       eor #$80                    ; bias both sides by $8000 and compare unsigned:
000046r 2                       sbc #(>(imm) ^ $80)         ; the bias on the constant is free at assembly time
000046r 2               :                                   ; placeholder - keeps the anonymous-label count
000046r 2                       bcc label
000046r 2               .endmacro
000046r 2                       ; branch if var >= imm
000046r 2               .macro bge16i var, imm, label
000046r 2                       lda var
000046r 2                       cmp #<(imm)
000046r 2                       lda var+1
000046r 2                       eor #$80
000046r 2                       sbc #(>(imm) ^ $80)
000046r 2               :                                   ; placeholder - keeps the anonymous-label count
000046r 2                       bcs label
000046r 2               .endmacro
000046r 2               ; branch if var <= imm
000046r 2                       ; branch if var <= imm
000046r 2               .macro ble16i var, imm, label
000046r 2                       lda var                     ; var <= imm is var < imm+1, so this is blt16i's
000046r 2                       cmp #<((imm)+1)             ; bias form: one instruction and no V fixup
000046r 2                       lda var+1
000046r 2                       eor #$80
000046r 2                       sbc #(>((imm)+1) ^ $80)
000046r 2               :                                   ; placeholder - keeps the anonymous-label count
000046r 2                       bcc label
000046r 2               .endmacro
000046r 2               ; branch if a > b (both 16-bit vars)
000046r 2               .macro bgt16 aa, bb, label
000046r 2                       lda bb
000046r 2                       cmp aa
000046r 2                       lda bb+1
000046r 2                       sbc aa+1
000046r 2                       bvc :+
000046r 2                       eor #$80
000046r 2               :      bmi label
000046r 2               .endmacro
000046r 2               .macro blt16 aa, bb, label
000046r 2                       lda aa
000046r 2                       cmp bb
000046r 2                       lda aa+1
000046r 2                       sbc bb+1
000046r 2                       bvc :+
000046r 2                       eor #$80
000046r 2               :      bmi label
000046r 2               .endmacro
000046r 2               .macro bge16 aa, bb, label
000046r 2                       lda aa
000046r 2                       cmp bb
000046r 2                       lda aa+1
000046r 2                       sbc bb+1
000046r 2                       bvc :+
000046r 2                       eor #$80
000046r 2               :      bpl label
000046r 2               .endmacro
000046r 2               .macro bmi16 var, label
000046r 2                       bit var+1
000046r 2                       bmi label
000046r 2               .endmacro
000046r 2               .macro bpl16 var, label
000046r 2                       bit var+1
000046r 2                       bpl label
000046r 2               .endmacro
000046r 2               ; A = max(A - n, 0)  (unsigned)
000046r 2                       ; A = max(A - n, 0)  (unsigned)
000046r 2               .macro submin0 n
000046r 2                       sec
000046r 2                       sbc #n
000046r 2                       bcs :+                      ; no borrow: A >= n, the difference stands
000046r 2                       lda #0
000046r 2               :
000046r 2               .endmacro
000046r 2               ; branch if var (16) == 0
000046r 2               .macro beq16 var, label
000046r 2                       lda var
000046r 2                       ora var+1
000046r 2                       beq label
000046r 2               .endmacro
000046r 2               .macro bne16 var, label
000046r 2                       lda var
000046r 2                       ora var+1
000046r 2                       bne label
000046r 2               .endmacro
000046r 2               
000046r 2               ; ---------------------------------------------------------------- object arrays (bank 7)
000046r 2               NLEAN   = 2                        ; object types below this take the lean path in
000046r 2                                                  ; process_object: no zero-page staging at all
000046r 2                 .if MODELB
000046r 2               OBJN    = 126                      ; the one level on the disc has 126 objects; the arrays
000046r 2                 .else                            ; are laid out exactly as the Master's, just shorter
000046r 2               OBJN    = 149
000046r 2                 .endif
000046r 2               O_STAMP = LV_OBJST
000046r 2               O_TYPE  = O_STAMP + OBJN
000046r 2               O_XL    = O_TYPE + OBJN
000046r 2               O_XH    = O_XL + OBJN
000046r 2               O_YL    = O_XH + OBJN
000046r 2               O_YH    = O_YL + OBJN
000046r 2               O_AL    = O_YH + OBJN
000046r 2               O_AH    = O_AL + OBJN
000046r 2               O_BL    = O_AH + OBJN
000046r 2               O_BH    = O_BL + OBJN
000046r 2               O_CL    = O_BH + OBJN
000046r 2               O_CH    = O_CL + OBJN
000046r 2               O_DL    = O_CH + OBJN
000046r 2               O_DH    = O_DL + OBJN
000046r 2               O_EL    = O_DH + OBJN
000046r 2               O_EH    = O_EL + OBJN
000046r 2                 .if .not MODELB                  ; (Model B: labels in bank 6, page aligned)
000046r 2               LV_MAPROWLO = $A900               ; bank 6: 256 : tile row -> map row address
000046r 2               LV_MAPROWHI = $AA00
000046r 2                 .endif
000046r 2               
000046r 2               ; ---------------------------------------------------------------- game state (zero page, persistent)
000046r 2                       .zeropage
00006Dr 2  xx xx        frame:    .res 2
00006Fr 2  xx xx        px:       .res 2                  ; player x, y (px)
000071r 2  xx xx        py:       .res 2
000073r 2  xx xx        vx:       .res 2                  ; 1/256 px per frame
000075r 2  xx xx        vy:       .res 2
000077r 2  xx           anim:     .res 1
000078r 2  xx xx        evframe:  .res 2
00007Ar 2  xx           facing:   .res 1                  ; 1 = left
00007Br 2  xx           running:  .res 1
00007Cr 2  xx           firing:   .res 1
00007Dr 2  xx           hurt:     .res 1                  ; invulnerable after hit
00007Er 2  xx           control:  .res 1
00007Fr 2  xx xx        bx:       .res 2                  ; boomerang
000081r 2  xx xx        by:       .res 2
000083r 2  xx xx        bvx:      .res 2
000085r 2  xx xx        bvy:      .res 2
000087r 2  xx           bcnt:     .res 1
000088r 2  xx           bactive:  .res 1
000089r 2  xx           bounce:   .res 1
00008Ar 2  xx           stars:    .res 1
00008Br 2  xx xx        startx:   .res 2
00008Dr 2  xx xx        starty:   .res 2
00008Fr 2  xx xx        exitx:    .res 2
000091r 2  xx xx        exity:    .res 2
000093r 2  xx           nobj:     .res 1
000094r 2  xx           pausing:  .res 1
000095r 2  xx           exiting:  .res 1
000096r 2  xx           level:    .res 1
000097r 2  xx           lives:    .res 1
000098r 2  xx           health:   .res 1
000099r 2  xx xx        score:    .res 2
00009Br 2  xx xx        hiscore:  .res 2
00009Dr 2  xx           maxlevel: .res 1
00009Er 2  xx           lastkeys: .res 1
00009Fr 2  xx           logicvs:  .res 1
0000A0r 2  xx           lsteps:   .res 1
0000A1r 2  xx           gridsh:   .res 1                  ; log2 of the collision grid width
0000A2r 2               
0000A2r 2               ; transient temps (not preserved across disc loads)
0000A2r 2               ox      = $A8
0000A2r 2               oy      = $AA
0000A2r 2               fa      = $AC
0000A2r 2               fb      = $AE
0000A2r 2               fc      = $B0
0000A2r 2               fd      = $B2
0000A2r 2               fe      = $B4
0000A2r 2               rx      = $B6
0000A2r 2               ry      = $B8
0000A2r 2               sx      = $BA
0000A2r 2               sy      = $BC
0000A2r 2               qx      = $BE
0000A2r 2               qy      = $C0
0000A2r 2               alt     = $C2
0000A2r 2               q1      = $C3
0000A2r 2               q2      = $C4
0000A2r 2               q3      = $C5
0000A2r 2               q4      = $C6
0000A2r 2               q5      = $C7
0000A2r 2               q6      = $C8
0000A2r 2               obj     = $C9
0000A2r 2               gx      = $CA
0000A2r 2               gy      = $CB
0000A2r 2               grow    = $DE                   ; bucket walk: gy << gridsh
0000A2r 2               gx0     = $CC
0000A2r 2               gx1     = $CD
0000A2r 2               gy1     = $CE
0000A2r 2               bent    = $CF
0000A2r 2               otype   = $D0
0000A2r 2               t16     = $D1                     ; 2 bytes
0000A2r 2               t16b    = $D3                     ; 2 bytes
0000A2r 2               dpx     = $D5                     ; 2 bytes: player step count etc
0000A2r 2               hx      = $D7                     ; 2 bytes: rx used for hit direction
0000A2r 2               mapptr  = $D9                     ; 2 bytes
0000A2r 2               q1x     = $DB
0000A2r 2               rise    = $DC                     ; 2 bytes
0000A2r 2               
0000A2r 2                       PLACE "LOGIC", "LGCCODE"
00027Dr 2               
00027Dr 2               ; ============================================================================
00027Dr 2               ; Map queries.  The map is in bank 6 with the row tables and the row-page table,
00027Dr 2               ; so these select it and put bank 7 back; maptilew leaves bank 6 selected for a
00027Dr 2               ; caller that is about to write through mapptr.
00027Dr 2               ; ============================================================================
00027Dr 2               ; get map byte at tile (X = tx, A = ty) -> A = byte, q1 = page (0/1).  The per-page
00027Dr 2               ; alt-class and attribute tables are 256 bytes apart (q1 used to be page*2, which sent
00027Dr 2               ; every page-1 row's altitude lookup into LV_MAPROWLO: no ground, Cleo fell through
00027Dr 2               ; the floor at the Vineyards spawn and wherever else those levels use page 1)
00027Dr 2               maptile:
00027Dr 2  20 rr rr             jsr maprow                  ; main RAM: the map is in bank 6 and this code is
000280r 2  8A                   txa                         ; in bank 7, so every touch goes through a helper
000281r 2  A8                   tay
000282r 2  4C rr rr             jmp mapbyte
000285r 2               
000285r 2               ; tilexy: X = qx >> 3, A = qy >> 3, carry set if (qx,qy) is inside the map.
000285r 2               ; Map sizes are multiples of 256 px, so "0 <= q < size" is just a compare of the high
000285r 2               ; byte, and with that byte < 8 the tile coordinate is (hi << 5) | (lo >> 3) in one byte.
000285r 2  A5 BF        tilexy: lda qx+1
000287r 2  C5 rr                cmp mapw+1
000289r 2  B0 25                bcs @out
00028Br 2  0A                   asl
00028Cr 2  0A                   asl
00028Dr 2  0A                   asl
00028Er 2  0A                   asl
00028Fr 2  0A                   asl
000290r 2  85 C4                sta q2
000292r 2  A5 BE                lda qx
000294r 2  4A                   lsr
000295r 2  4A                   lsr
000296r 2  4A                   lsr
000297r 2  05 C4                ora q2
000299r 2  AA                   tax
00029Ar 2  A5 C1                lda qy+1
00029Cr 2  C5 rr                cmp maph+1
00029Er 2  B0 10                bcs @out
0002A0r 2  0A                   asl
0002A1r 2  0A                   asl
0002A2r 2  0A                   asl
0002A3r 2  0A                   asl
0002A4r 2  0A                   asl
0002A5r 2  85 C4                sta q2
0002A7r 2  A5 C0                lda qy
0002A9r 2  4A                   lsr
0002AAr 2  4A                   lsr
0002ABr 2  4A                   lsr
0002ACr 2  05 C4                ora q2
0002AEr 2  38                   sec
0002AFr 2  60                   rts
0002B0r 2  18           @out:   clc
0002B1r 2  60                   rts
0002B2r 2               
0002B2r 2               ; getinfo: A = alt byte for pixel (qx, qy), 8 if outside the map
0002B2r 2               getinfo:
0002B2r 2  20 rr rr             jsr tilexy                  ; X = qx>>3, A = qy>>3
0002B5r 2  B0 03                bcs :+
0002B7r 2  A9 08                lda #8
0002B9r 2  60                   rts
0002BAr 2  20 rr rr     :       jsr maptile
0002BDr 2                       ; alt class = LV_ALTCLS[tile id]
0002BDr 2  A8                   tay
0002BEr 2  B9 rr rr             lda LV_ALTCLS,y
0002C1r 2                       ; ALTTAB[cls*8 + (qx&7)]
0002C1r 2  0A                   asl
0002C2r 2  0A                   asl
0002C3r 2  0A                   asl
0002C4r 2  85 C4                sta q2
0002C6r 2  A5 BE                lda qx
0002C8r 2  29 07                and #7
0002CAr 2  05 C4                ora q2
0002CCr 2  A8                   tay
0002CDr 2  B9 rr rr             lda LV_ALTTAB,y
0002D0r 2  60                   rts
0002D1r 2               
0002D1r 2               ; getaltitude: A = altitude (signed) at pixel (qx, qy)  [qy modified]
0002D1r 2               getaltitude:
0002D1r 2  20 rr rr             jsr getinfo
0002D4r 2  85 C5                sta q3                      ; n3
0002D6r 2  4A                   lsr
0002D7r 2  4A                   lsr
0002D8r 2  4A                   lsr
0002D9r 2  4A                   lsr
0002DAr 2  85 C6                sta q4                      ; n4
0002DCr 2  A5 C0                lda qy
0002DEr 2  29 07                and #7
0002E0r 2  85 C7                sta q5                      ; n5
0002E2r 2  A5 C5                lda q3
0002E4r 2  29 0F                and #15
0002E6r 2  C5 C7                cmp q5
0002E8r 2  F0 02                beq @below
0002EAr 2  B0 18                bcs @notbelow
0002ECr 2  A5 C0        @below: lda qy
0002EEr 2  18                   clc
0002EFr 2  69 08                adc #8
0002F1r 2  85 C0                sta qy
0002F3r 2  90 02                bcc @b1
0002F5r 2  E6 C1                inc qy+1
0002F7r 2  20 rr rr     @b1:    jsr getinfo
0002FAr 2  4A                   lsr
0002FBr 2  4A                   lsr
0002FCr 2  4A                   lsr
0002FDr 2  4A                   lsr
0002FEr 2  18                   clc
0002FFr 2  69 09                adc #9                      ; the extra 1 pays the borrow: A <= 24 so adc leaves
000301r 2  E5 C7                sbc q5                      ; C = 0, and (A+9) - q5 - 1 is the (A+8) - q5 wanted
000303r 2  60                   rts
000304r 2               @notbelow:
000304r 2  A5 C6                lda q4
000306r 2  D0 22                bne @d2
000308r 2  A5 C0                lda qy
00030Ar 2  38                   sec
00030Br 2  E9 08                sbc #8
00030Dr 2  85 C0                sta qy
00030Fr 2  B0 02                bcs :+
000311r 2  C6 C1                dec qy+1
000313r 2  20 rr rr     :       jsr getinfo
000316r 2  85 C5                sta q3
000318r 2  29 0F                and #15
00031Ar 2  C9 08                cmp #8
00031Cr 2  D0 0A                bne @done
00031Er 2  A5 C5                lda q3
000320r 2  4A                   lsr
000321r 2  4A                   lsr
000322r 2  4A                   lsr
000323r 2  4A                   lsr
000324r 2  E9 08                sbc #8
000326r 2  85 C6                sta q4
000328r 2  A5 C6        @done:  lda q4
00032Ar 2  38           @d2:    sec
00032Br 2  E5 C7                sbc q5
00032Dr 2  60                   rts
00032Er 2               
00032Er 2               ; gettileattr: A = attribute byte for the tile at (qx,qy): bits0-2 push+3, bit7 kill ; 3 if outside
00032Er 2               gettileattr:
00032Er 2  20 rr rr             jsr tilexy                  ; X = qx>>3, A = qy>>3
000331r 2  B0 03                bcs :+
000333r 2  A9 03                lda #3
000335r 2  60                   rts
000336r 2  20 rr rr     :       jsr maptile
000339r 2  A8                   tay
00033Ar 2  B9 rr rr             lda LV_ATTR0,y
00033Dr 2  60                   rts
00033Er 2               
00033Er 2               ; ============================================================================
00033Er 2               ; Level initialisation (level pack already loaded in bank 7)
00033Er 2               ; ============================================================================
00033Er 2               level_init:
