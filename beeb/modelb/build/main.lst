001A2Br 2  24 AF 30 08          bmi16 fb, @bset
001A2Fr 2  A5 AE                lda fb
001A31r 2  F0 04                beq @bset
001A33r 2  A9 01                lda #1
001A35r 2  85 B0                sta fc
001A37r 2  A9 08        @bset:  lda #8
001A39r 2  85 rr                sta bcnt
001A3Br 2  24 AF 30 26  @draw:  bmi16 fb, @f8               ; standing frame at either end.  Past the sign test
001A3Fr 2  A5 AE                lda fb                      ; fb+1 is 0, so the rest is an 8-bit compare
001A41r 2  F0 22                beq @f8
001A43r 2  C5 AC                cmp fa
001A45r 2  B0 1E                bcs @f8
001A47r 2  A5 B4                lda fe
001A49r 2  C9 03                cmp #3
001A4Br 2  90 0E                bcc @f0
001A4Dr 2  C9 06                cmp #6
001A4Fr 2  90 0F                bcc @f2
001A51r 2  C9 09                cmp #9
001A53r 2  90 15                bcc @f4
001A55r 2  A9 06                lda #6
001A57r 2  18                   clc                         ; only this arm reaches @fr with C set (cmp #9
001A58r 2  4C rr rr             bra @fr                     ; fell through); @f2 and @f4 got here on a bcc
001A5Br 2  A5 B0        @f0:    lda fc
001A5Dr 2  4C rr rr             bra @sp
001A60r 2  A9 02        @f2:    lda #2
001A62r 2  4C rr rr             bra @fr
001A65r 2  A9 08        @f8:    lda #8
001A67r 2  4C rr rr             bra @sp
001A6Ar 2  A9 04        @f4:    lda #4
001A6Cr 2  65 B0        @fr:    adc fc
001A6Er 2  A6 D0        @sp:    ldx otype                   ; the frame stays in A: no round trip through q1
001A70r 2  E0 05                cpx #5
001A72r 2  D0 05                bne :+
001A74r 2  69 42                adc #66                     ; C = 1 from the equal cpx, so this is A + 67
001A76r 2  4C rr rr             bra :++
001A79r 2  18           :       clc
001A7Ar 2  69 4C                adc #76
001A7Cr 2  4C rr rr     :       jmp m_addsprite
001A7Fr 2               
001A7Fr 2               ; ---------------------------------------------------------------- SPIKE (7)
001A7Fr 2               ob_spike:
001A7Fr 2                       ; A is a dormancy counter running -127..24 (CleoApp.run case 7: A++, and at 24
001A7Fr 2                       ; A = -(rnd&63)-64).  That fits a signed byte exactly, so the byte IS the value
001A7Fr 2                       ; and the high half was only ever its sign extension.
001A7Fr 2  E6 AC                inc fa
001A81r 2  A5 AC                lda fa
001A83r 2  C9 18                cmp #24
001A85r 2  D0 0C                bne @nowrap
001A87r 2  20 rr rr             jsr m_rnd
001A8Ar 2  29 3F                and #63
001A8Cr 2  49 3F                eor #63                     ; 63-r, then +129, is 192-r: the byte form of
001A8Er 2  18                   clc                         ; -(r&63)-64, i.e. -64 down to -127
001A8Fr 2  69 81                adc #129
001A91r 2  85 AC                sta fa
001A93r 2               @nowrap:
001A93r 2  A5 rr                lda health
001A95r 2  F0 2A                beq @draw
001A97r 2  A5 AC                lda fa
001A99r 2  30 26                bmi @draw                   ; still dormant
001A9Br 2  C9 08                cmp #8
001A9Dr 2  B0 22                bcs @draw
001A9Fr 2                       ; rx > -8 && rx < (A+1)*2 && ry > -24 && ry < 8
001A9Fr 2  85 DF E6 DF          inca                        ; A is still fa: cmp does not write A
001AA3r 2  A5 DF        
001AA5r 2  0A                   asl
001AA6r 2  49 80                eor #$80                    ; biased limit
001AA8r 2  8D rr rr             sta RNGTAB+49
001AABr 2  A2 30                ldx #48
001AADr 2  20 rr rr             jsr inrange
001AB0r 2  90 0F                bcc @draw
001AB2r 2  A5 rr                lda hurt
001AB4r 2  D0 0B                bne @draw
001AB6r 2  A5 B6 85 D7          mov16 hx, rx
001ABAr 2  A5 B7 85 D8  
001ABEr 2  20 rr rr             jsr player_hit
001AC1r 2  A5 AC        @draw:  lda fa
001AC3r 2  30 10                bmi @done
001AC5r 2  C9 08                cmp #8
001AC7r 2  90 07                bcc :+
001AC9r 2  A9 17                lda #23
001ACBr 2  38                   sec
001ACCr 2  E5 AC                sbc fa
001ACEr 2  4A                   lsr
001ACFr 2  18                   clc                         ; only the lsr can leave C set; bcc arrives with C=0
001AD0r 2  69 55        :       adc #85
001AD2r 2  4C rr rr             jmp m_addsprite
001AD5r 2  60           @done:  rts
001AD6r 2               
001AD6r 2               ; ---------------------------------------------------------------- FLAME (9)
001AD6r 2               ob_flame:
