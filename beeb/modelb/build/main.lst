001B17r 2  A5 AC        @draw:  lda fa
001B19r 2  4A                   lsr
001B1Ar 2  C9 03                cmp #3
001B1Cr 2  B0 05                bcs @done
001B1Er 2  69 61                adc #97
001B20r 2  4C rr rr             jmp m_addsprite
001B23r 2  60           @done:  rts
001B24r 2               
001B24r 2               ; ---------------------------------------------------------------- VANISHING BLOCK (11)
001B24r 2               ob_vanish:
001B24r 2  A5 B4                lda fe
001B26r 2  D0 12                bne @count
001B28r 2                       ; rx > -16 && rx <= 0 && ry == 16 && vy == 0
001B28r 2  A2 38                ldx #56
001B2Ar 2  20 rr rr             jsr inrange
001B2Dr 2  90 0A                bcc @ret
001B2Fr 2  A5 rr                lda vy
001B31r 2  05 rr                ora vy+1
001B33r 2  D0 04                bne @ret
001B35r 2  A9 01                lda #1
001B37r 2  85 B4                sta fe
001B39r 2  60           @ret:   rts
001B3Ar 2  E6 B4        @count: inc fe
001B3Cr 2  A5 B4                lda fe
001B3Er 2  85 DF 29 03          bitimm 3
001B42r 2  08 A5 DF 28  
001B46r 2  D0 6D                bne @done
001B48r 2  C9 0C                cmp #12
001B4Ar 2  B0 04                bcs :+
001B4Cr 2  4A                   lsr
001B4Dr 2  4C rr rr             bra @set
001B50r 2  C9 25        :       cmp #37
001B52r 2  90 08                bcc @six
001B54r 2  A9 30                lda #48
001B56r 2  E5 B4                sbc fe                      ; carry is already set: bcc fell through
001B58r 2  4A                   lsr
001B59r 2  4C rr rr             bra @set
001B5Cr 2  A9 06        @six:   lda #6
001B5Er 2  85 C3        @set:   sta q1
001B60r 2                       ; tiles at (ox>>3, oy>>3) and +1 : codes from header per page
001B60r 2  A5 A8 85 BE          mov16 qx, ox
001B64r 2  A5 A9 85 BF  
001B68r 2  A5 AA 85 C0          mov16 qy, oy
001B6Cr 2  A5 AB 85 C1  
001B70r 2  20 rr rr             jsr tilexy
001B73r 2  86 C6                stx q4                      ; tile x (q4/q5: gx/gy are the live grid-walk cursor)
001B75r 2  85 C7                sta q5                      ; tile y
001B77r 2  A6 C3                ldx q1
001B79r 2  BD rr rr             lda LV_HDR+8,x
001B7Cr 2  85 C4                sta q2
001B7Er 2  BD rr rr             lda LV_HDR+9,x
001B81r 2  85 C5                sta q3
001B83r 2  A6 C6                ldx q4
001B85r 2  A5 C7                lda q5
001B87r 2  20 rr rr             jsr maptile                 ; sets mapptr, Y = tx
001B8Ar 2  A5 C4                lda q2
001B8Cr 2  20 rr rr             jsr mapput
001B8Fr 2  C8                   iny
001B90r 2  A5 C5                lda q3
001B92r 2  20 rr rr             jsr mapput
001B95r 2  A5 C6                lda q4
001B97r 2  A6 C7                ldx q5
001B99r 2  20 rr rr             jsr m_mark_dirty
001B9Cr 2  A5 C6                lda q4
001B9Er 2  85 DF E6 DF          inca
001BA2r 2  A5 DF        
001BA4r 2  A6 C7                ldx q5
001BA6r 2  20 rr rr             jsr m_mark_dirty
001BA9r 2  A5 B4                lda fe
001BABr 2  C9 30                cmp #48
001BADr 2  D0 06                bne @done
001BAFr 2  48 A9 00 85          stza fe
001BB3r 2  B4 68        
001BB5r 2  60           @done:  rts
001BB6r 2               
001BB6r 2               ; ---------------------------------------------------------------- SWITCH (12)
001BB6r 2               ob_switch:
001BB6r 2  A5 B2                lda fd
001BB8r 2  D0 58                bne @draw
001BBAr 2  A2 3C                ldx #60
001BBCr 2  20 rr rr             jsr inrange
001BBFr 2  90 51                bcc @draw
001BC1r 2  A9 14                lda #20
001BC3r 2  20 rr rr             jsr addscore
001BC6r 2  A9 06                lda #SFX_POWER
001BC8r 2  85 A5                sta SFXREQ
001BCAr 2                       ; copy map columns (A-2, A-1) -> (A, A+1) for rows B .. B+C-1
001BCAr 2  A5 B0                lda fc
001BCCr 2  F0 40                beq @set
001BCEr 2  85 C6                sta q4
001BD0r 2  A5 AE                lda fb
001BD2r 2  85 C7                sta q5                      ; row counter (q5: the grid-walk cursor must stay intact)
001BD4r 2  A6 AC        @rl:    ldx fa
001BD6r 2  A5 C7                lda q5
001BD8r 2  20 rr rr             jsr maptile                 ; mapptr = row, Y = A
001BDBr 2  88                   dey
001BDCr 2  88                   dey
001BDDr 2  20 rr rr             jsr mapbyte
001BE0r 2  85 C4                sta q2
001BE2r 2  C8                   iny
001BE3r 2  20 rr rr             jsr mapbyte
001BE6r 2  85 C5                sta q3
001BE8r 2  C8                   iny
001BE9r 2  A5 C4                lda q2
001BEBr 2  20 rr rr             jsr mapput
001BEEr 2  C8                   iny
001BEFr 2  A5 C5                lda q3
001BF1r 2  20 rr rr             jsr mapput
001BF4r 2  A5 AC                lda fa
001BF6r 2  A6 C7                ldx q5
001BF8r 2  20 rr rr             jsr m_mark_dirty
001BFBr 2  A5 AC                lda fa
001BFDr 2  85 DF E6 DF          inca
001C01r 2  A5 DF        
001C03r 2  A6 C7                ldx q5
001C05r 2  20 rr rr             jsr m_mark_dirty
001C08r 2  E6 C7                inc q5
001C0Ar 2  C6 C6                dec q4
001C0Cr 2  D0 C6                bne @rl
001C0Er 2  A9 01        @set:   lda #1
001C10r 2  85 B2                sta fd
001C12r 2  A5 B2        @draw:  lda fd
001C14r 2  18                   clc
001C15r 2  69 64                adc #100
001C17r 2  4C rr rr             jmp m_addsprite
001C1Ar 2               
001C1Ar 2               ; ============================================================================
001C1Ar 2               ; Status bar digits (drawn into the bar master image in bank 4)  [main RAM]
001C1Ar 2               ; ============================================================================
001C1Ar 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the digits and the bar art
001C1Ar 2               ; draw digit A at bar pixel column X (even), digit slot Y (0..8): copies a 64-byte digit
001C1Ar 2               ; tile into the bar image.
001C1Ar 2               ;
001C1Ar 2               ; Each buffer remembers the nine values its bar was last drawn with, because redraw_hud
001C1Ar 2               ; redraws all nine whenever anything changes and a score tick usually moves only one of
001C1Ar 2               ; them -- the other eight were 128 bytes of copy for no pixels (measured 5.0K cycles a
001C1Ar 2               ; render on an L0 run, 3.2% of the frame).  The bank is BANK_LVL on entry and on exit, so
001C1Ar 2               ; the skip path must not touch it.
001C1Ar 2               bar_digit:
001C1Ar 2  D9 rr rr             cmp BARCACHE,y              ; one bar, so one cache: no curbuf in the index
001C1Dr 2  F0 68                beq bd_same
001C1Fr 2  99 rr rr             sta BARCACHE,y
001C22r 2                 .if .not MODELB
001C22r 2                       pha
001C22r 2                       setbank HUD_BANK
001C22r 2                       pla
001C22r 2                 .endif
001C22r 2  4A                   lsr                         ; C = d bit0, A = d >> 1
001C23r 2  85 rr                sta w16+1
001C25r 2  A9 00                lda #0
001C27r 2  6A                   ror                         ; A = d0 << 7
001C28r 2  46 rr                lsr w16+1                   ; C = d bit1, w16+1 = d >> 2
001C2Ar 2  6A                   ror                         ; A = d1 << 7 | d0 << 6
001C2Br 2  18                   clc
001C2Cr 2  69 rr                adc #<SPR_DIGITS
001C2Er 2  85 rr                sta w16
001C30r 2  A5 rr                lda w16+1
001C32r 2  69 rr                adc #>SPR_DIGITS
001C34r 2  85 rr                sta w16+1                   ; digit tile
001C36r 2  8A                   txa
001C37r 2  29 FE                and #$FE                    ; char = x/2, then *8 -- i.e. (x & $FE) * 4
001C39r 2  48 A9 00 85          stza ptr+1
001C3Dr 2  rr 68        
001C3Fr 2  0A                   asl
001C40r 2  26 rr                rol ptr+1
001C42r 2  0A                   asl
001C43r 2  26 rr                rol ptr+1
001C45r 2  69 00                adc #<BARADDR               ; straight into the back buffer's bar row (no offscreen
001C47r 2  85 rr                sta ptr                     ; buffer): bank 4 glyph at $8xxx, screen bar at $7Bxx
001C49r 2  A5 rr                lda ptr+1                   ; C is already clear: ptr+1 was 0 or 1 before the second
001C4Br 2  69 03                adc #>BARADDR               ; rol, so that rol shifted a 0 out
001C4Dr 2  85 rr                sta ptr+1
001C4Fr 2  A0 1F                ldy #31
001C51r 2  B1 rr        :       lda (w16),y
001C53r 2  91 rr                sta (ptr),y
001C55r 2  88                   dey
001C56r 2  10 F9                bpl :-
001C58r 2  A5 rr                lda w16
001C5Ar 2  69 20                adc #32                     ; C still clear: ptr+1 <= 3 and >BARADDR = $7B, so the
001C5Cr 2  85 rr                sta w16                     ; adc above cannot carry, and the copy loop leaves C
001C5Er 2  90 02                bcc @nc
001C60r 2  E6 rr                inc w16+1
001C62r 2  18 A5 rr 69  @nc:    add16i ptr, 640
001C66r 2  80 85 rr A5  
001C6Ar 2  rr 69 02 85  
001C6Fr 2  A0 1F                ldy #31
001C71r 2  B1 rr        :       lda (w16),y
001C73r 2  91 rr                sta (ptr),y
001C75r 2  88                   dey
001C76r 2  B1 rr                lda (w16),y
001C78r 2  91 rr                sta (ptr),y
001C7Ar 2  88                   dey
001C7Br 2  B1 rr                lda (w16),y
001C7Dr 2  91 rr                sta (ptr),y
001C7Fr 2  88                   dey
001C80r 2  B1 rr                lda (w16),y
001C82r 2  91 rr                sta (ptr),y
001C84r 2  88                   dey
001C85r 2  10 EA                bpl :-
001C87r 2                 .if .not MODELB
001C87r 2                       setbank BANK_LVL
001C87r 2                 .endif
001C87r 2               bd_same:
001C87r 2  60                   rts
001C88r 2               
001C88r 2               bar_touch:
001C88r 2  A9 01                lda #1
001C8Ar 2  85 A3                sta BARDIRTY
001C8Cr 2  60                   rts
001C8Dr 2               
001C8Dr 2               redraw_hud:
001C8Dr 2  20 rr rr             jsr draw_lives
001C90r 2  20 rr rr             jsr draw_health
001C93r 2  20 rr rr             jsr draw_stars
001C96r 2  4C rr rr             jmp draw_score
001C99r 2               
001C99r 2               draw_lives:
001C99r 2  A5 rr                lda lives
001C9Br 2  A2 12                ldx #18
001C9Dr 2  A0 00                ldy #0
001C9Fr 2  4C rr rr             jmp bar_digit
001CA2r 2               draw_health:
001CA2r 2  A5 rr                lda health
001CA4r 2  A2 2E                ldx #46
001CA6r 2  A0 01                ldy #1
001CA8r 2  4C rr rr             jmp bar_digit
001CABr 2               draw_stars:                         ; stars remaining: 2 digits at 74, 82
001CABr 2  A5 rr                lda stars
001CADr 2  20 rr rr             jsr div10
001CB0r 2  A2 4A                ldx #74
001CB2r 2  A0 02                ldy #2
001CB4r 2  20 rr rr             jsr bar_digit
001CB7r 2  A5 C3                lda q1
001CB9r 2  A2 52                ldx #82
001CBBr 2  A0 03                ldy #3
001CBDr 2  4C rr rr             jmp bar_digit
001CC0r 2               ; A = A / 10 ; q1 = A mod 10
001CC0r 2  A2 00        div10:  ldx #0
001CC2r 2  C9 0A        :       cmp #10
001CC4r 2  90 06                bcc :+
001CC6r 2  E9 0A                sbc #10
001CC8r 2  E8                   inx
001CC9r 2  4C rr rr             bra :-
001CCCr 2  85 C3        :       sta q1
001CCEr 2  8A                   txa
001CCFr 2  60                   rts
001CD0r 2               draw_score:                         ; 5 digits at 108..140
001CD0r 2  A5 rr 85 D1          mov16 t16, score
001CD4r 2  A5 rr 85 D2  
001CD8r 2  A2 04                ldx #4
001CDAr 2  8A 48        @d:     phx
001CDCr 2                       ; t16 /= 10 -> remainder
001CDCr 2  20 rr rr             jsr div10_16
001CDFr 2  68 AA                plx
001CE1r 2  8A 48                phx
001CE3r 2  8A                   txa
001CE4r 2  18                   clc
001CE5r 2  69 04                adc #4                      ; score digits are slots 4..8
001CE7r 2  A8                   tay
001CE8r 2  0A                   asl
001CE9r 2  0A                   asl
001CEAr 2  0A                   asl
001CEBr 2  69 4C                adc #76                     ; (X+4)*8 + 76 = X*8 + 108
001CEDr 2  AA                   tax
001CEEr 2  A5 C3                lda q1
001CF0r 2  20 rr rr             jsr bar_digit
001CF3r 2  68 AA                plx
001CF5r 2  CA                   dex
001CF6r 2  10 E2                bpl @d
001CF8r 2  60                   rts
001CF9r 2               ; t16 = t16 / 10 ; q1 = remainder
001CF9r 2               div10_16:
001CF9r 2  48 A9 00 85          stza q1
001CFDr 2  C3 68        
001CFFr 2  A2 10                ldx #16
001D01r 2  A5 C3                lda q1                  ; remainder lives in A for the whole loop
001D03r 2  06 D1        @l:     asl t16
001D05r 2  26 D2                rol t16+1
001D07r 2  2A                   rol a                   ; was rol q1 / lda q1
001D08r 2  C9 0A                cmp #10
001D0Ar 2  90 04                bcc :+
001D0Cr 2  E9 0A                sbc #10                 ; was sbc #10 / sta q1
001D0Er 2  E6 D1                inc t16
001D10r 2  CA           :       dex
001D11r 2  D0 F0                bne @l
001D13r 2  85 C3                sta q1
001D15r 2  60                   rts
001D16r 2               
001D16r 2                       PLACE "LOGIC", "LGCCODE"
001D16r 2               ; ============================================================================
001D16r 2               ; Sound effect ids
001D16r 2               ; ============================================================================
001D16r 2               SFX_JUMP  = 1
001D16r 2               SFX_STAR  = 2
001D16r 2               SFX_THROW = 3
001D16r 2               SFX_HIT   = 4
001D16r 2               SFX_KILL  = 5
001D16r 2               SFX_POWER = 6
001D16r 2               SFX_DIE   = 7
001D16r 2               
001D16r 1                       .include "game.s"
001D16r 2               ; ============================================================================
001D16r 2               ; CLEO - the game: level loading, the camera clamp, the level and frame loops,
001D16r 2               ; the sound effects.  Shared by the Master (main.s) and the Model B
001D16r 2               ; (modelb/src/main.s); what differs between them is under MODELB.
001D16r 2               ; ============================================================================
001D16r 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with the logic it drives
001D16r 2               ; ---------------------------------------------------------------- level loading
001D16r 2               ; X = level index 0..15 (even = main, odd = bonus)
001D16r 2               load_level:
001D16r 2                 .if .not MODELB                   ; (Model B: the one level is resident)
001D16r 2                       ; file order is L0A, L0B, L1A, ..., two files each, and level index 0 is the
001D16r 2                       ; main level, which is the 'B' one: file = FI_L0A + (i eor 1) * 2
001D16r 2                       txa
001D16r 2                       eor #1
001D16r 2                       asl                         ; two pieces: map, bank-7 tables
001D16r 2                       clc
001D16r 2                       adc #FI_L0A
001D16r 2                       sta tmp2
001D16r 2                       jsr loadfile
001D16r 2                       lda tmp2
001D16r 2                       inca
001D16r 2                       jsr loadfile
001D16r 2                       jsr load_tiles              ; only the tiles this level's page tables name
001D16r 2                       ; geometry
001D16r 2                       setbank BANK_LVL
001D16r 2                 .endif
001D16r 2  AD rr rr             lda LV_HDR
001D19r 2  85 rr                sta maplw
001D1Br 2  AD rr rr             lda LV_HDR+1
001D1Er 2  85 rr                sta maplh
001D20r 2                       ; mapw = 8 << lw ; maph = 8 << lh
001D20r 2  A9 08                lda #8
001D22r 2  85 rr                sta mapw
001D24r 2  48 A9 00 85          stza mapw+1
001D28r 2  rr 68        
001D2Ar 2  A6 rr                ldx maplw
001D2Cr 2  06 rr        :       asl mapw
001D2Er 2  26 rr                rol mapw+1
001D30r 2  CA                   dex
001D31r 2  D0 F9                bne :-
001D33r 2  A9 08                lda #8
001D35r 2  85 rr                sta maph
001D37r 2  48 A9 00 85          stza maph+1
001D3Br 2  rr 68        
001D3Dr 2  A6 rr                ldx maplh
001D3Fr 2  06 rr        :       asl maph
001D41r 2  26 rr                rol maph+1
001D43r 2  CA                   dex
001D44r 2  D0 F9                bne :-
001D46r 2  A5 rr                lda mapw
001D48r 2  38                   sec
001D49r 2  E9 A0                sbc #WINPX
001D4Br 2  85 rr                sta maxwx
001D4Dr 2  A5 rr                lda mapw+1
001D4Fr 2  E9 00                sbc #0
001D51r 2  85 rr                sta maxwx+1
001D53r 2  A5 rr                lda maph
001D55r 2  38                   sec
001D56r 2  E9 54                sbc #VISLINES/2
001D58r 2  85 rr                sta maxwy
001D5Ar 2  A5 rr                lda maph+1
001D5Cr 2  E9 00                sbc #0
001D5Er 2  85 rr                sta maxwy+1
001D60r 2                 .if MODELB
001D60r 2  A2 0C 20 rr          farjsr F_LVRESET            ; the records and the dirty lists are bank 5's
001D64r 2  rr           
001D65r 2                 .else
001D65r 2                       stza BUF_VALID
001D65r 2                       stza BUF_VALID+1
001D65r 2                       stza RECCNT
001D65r 2                       stza RECCNT+1
001D65r 2                       stza DIRTYCNT
001D65r 2                       stza DIRTYCNT+1
001D65r 2                 .endif
001D65r 2  48 A9 00 85          stza NSPR
001D69r 2  A2 68        
001D6Br 2  60                   rts
001D6Cr 2               
001D6Cr 2                 .if .not MODELB                   ; the disc: the Model B loads its four bank images
001D6Cr 2               ; File table.  Five parallel arrays rather than five-byte records: there are more
001D6Cr 2               ; than fifty files now and index * 5 does not fit in a byte.
001D6Cr 2                       .include "files.inc"
001D6Cr 2                       .assert VMODE = 2 - MODE1, error, "assets were converted for the other MODE: rerun tools/convert.py"
001D6Cr 2               FTMODE .set 0
001D6Cr 2               .macro FILE sec, n, bank, dest
001D6Cr 2               .if FTMODE = 0
001D6Cr 2                       .byte <(sec)
001D6Cr 2               .elseif FTMODE = 1
001D6Cr 2                       .byte >(sec)
001D6Cr 2               .elseif FTMODE = 2
001D6Cr 2                       .byte n
001D6Cr 2               .elseif FTMODE = 3
001D6Cr 2                       .byte bank
001D6Cr 2               .else
001D6Cr 2                       .byte >(dest)
001D6Cr 2               .endif
001D6Cr 2               .endmacro
001D6Cr 2               .macro FILE_LIST
001D6Cr 2                       FILE F_SPR_SEC,   F_SPR_N,   BANK_SPR,  $8000
001D6Cr 2                       FILE F_TILESO_SEC, F_TILESO_N, BANK_TIL0, $8000
001D6Cr 2                       FILE F_TILESI_SEC, F_TILESI_N, BANK_TIL0, $8000
001D6Cr 2                       FILE F_LOGIC_SEC, <((__LOGIC_LAST__ - __LOGIC_START__ + 255) / 256), BANK_LVL, LOGIC_ADDR
001D6Cr 2                       FILE F_BOX_SEC,   F_BOX_N,   BANK_TIL1, BOX_BASE
001D6Cr 2                       FILE F_MUSIC_SEC, F_MUSIC_N, BANK_LVL,  MUSIC_ADDR
001D6Cr 2                       FILE F_ALT_SEC,   F_ALT_N,   BANK_LVL,  LV_ALTTAB
001D6Cr 2                       FILE F_TITLE_SEC, F_TITLE_N, BANK_MAP,  TITLE_ADDR
001D6Cr 2                       FILE F_L0A_SEC, LM_L0A, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L0A_SEC + LM_L0A, F_L0A_N - LM_L0A, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L0B_SEC, LM_L0B, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L0B_SEC + LM_L0B, F_L0B_N - LM_L0B, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L1A_SEC, LM_L1A, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L1A_SEC + LM_L1A, F_L1A_N - LM_L1A, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L1B_SEC, LM_L1B, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L1B_SEC + LM_L1B, F_L1B_N - LM_L1B, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L2A_SEC, LM_L2A, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L2A_SEC + LM_L2A, F_L2A_N - LM_L2A, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L2B_SEC, LM_L2B, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L2B_SEC + LM_L2B, F_L2B_N - LM_L2B, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L3A_SEC, LM_L3A, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L3A_SEC + LM_L3A, F_L3A_N - LM_L3A, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L3B_SEC, LM_L3B, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L3B_SEC + LM_L3B, F_L3B_N - LM_L3B, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L4A_SEC, LM_L4A, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L4A_SEC + LM_L4A, F_L4A_N - LM_L4A, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L4B_SEC, LM_L4B, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L4B_SEC + LM_L4B, F_L4B_N - LM_L4B, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L5A_SEC, LM_L5A, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L5A_SEC + LM_L5A, F_L5A_N - LM_L5A, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L5B_SEC, LM_L5B, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L5B_SEC + LM_L5B, F_L5B_N - LM_L5B, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L6A_SEC, LM_L6A, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L6A_SEC + LM_L6A, F_L6A_N - LM_L6A, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L6B_SEC, LM_L6B, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L6B_SEC + LM_L6B, F_L6B_N - LM_L6B, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L7A_SEC, LM_L7A, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L7A_SEC + LM_L7A, F_L7A_N - LM_L7A, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_L7B_SEC, LM_L7B, BANK_MAP, LV_MAP
001D6Cr 2                       FILE F_L7B_SEC + LM_L7B, F_L7B_N - LM_L7B, BANK_LVL, LV_HDR
001D6Cr 2                       FILE F_SPRAND_SEC, F_SPRAND_N, BANK_SPR|$80, $8000   ; -> ANDY (ROMSEL bit7)
001D6Cr 2               .endmacro
001D6Cr 2               FTMODE .set 0
001D6Cr 2               ft_seclo: FILE_LIST
001D6Cr 2               FTMODE .set 1
001D6Cr 2               ft_sechi: FILE_LIST
001D6Cr 2               FTMODE .set 2
001D6Cr 2               ft_n:     FILE_LIST
001D6Cr 2               FTMODE .set 3
001D6Cr 2               ft_bank:  FILE_LIST
001D6Cr 2               FTMODE .set 4
001D6Cr 2               ft_dest:  FILE_LIST
001D6Cr 2               
001D6Cr 2               FI_SPR = 0
001D6Cr 2               FI_TILESO = 1                     ; the two tile sets, outdoors and indoors
001D6Cr 2               FI_TILESI = 2
001D6Cr 2               FI_LOGIC = 3
001D6Cr 2               FI_BOX = 4
001D6Cr 2               FI_MUSIC = 5
001D6Cr 2               FI_ALT = 6
001D6Cr 2               FI_TITLE = 7
001D6Cr 2               FI_L0A = 8                        ; two pieces per level: map, bank-7 tables
001D6Cr 2               FI_SPRAND = 40
001D6Cr 2               
001D6Cr 2                 .endif
001D6Cr 2               
001D6Cr 2               ; ---------------------------------------------------------------- camera clamp
001D6Cr 2               ; clamp wx to [0, maxwx] (and even), wy to [0, maxwy]
001D6Cr 2               clamp_window:
001D6Cr 2  A5 rr                lda wx+1
001D6Er 2  30 15                bmi @wx0
001D70r 2  A5 rr                lda wx
001D72r 2  C5 rr                cmp maxwx
001D74r 2  A5 rr                lda wx+1
001D76r 2  E5 rr                sbc maxwx+1
001D78r 2  30 13                bmi @wxok
001D7Ar 2  A5 rr                lda maxwx
001D7Cr 2  85 rr                sta wx
001D7Er 2  A5 rr                lda maxwx+1
001D80r 2  85 rr                sta wx+1
001D82r 2  4C rr rr             bra @wxok
001D85r 2  A9 00 85 rr  @wx0:   stz wx
001D89r 2  A9 00 85 rr          stz wx+1
001D8Dr 2               @wxok:
001D8Dr 2                 .if MODELB
001D8Dr 2  A5 rr                lda wx
001D8Fr 2  29 FE                and #$FE
001D91r 2  85 rr                sta wx
001D93r 2                 .else
001D93r 2                       lda #1
001D93r 2                       trb wx                      ; wx &= ~1 : the 65C02 does this in one RMW
001D93r 2                 .endif
001D93r 2  A5 rr                lda wy+1
001D95r 2  30 13                bmi @wy0
001D97r 2  A5 rr                lda wy
001D99r 2  C5 rr                cmp maxwy
001D9Br 2  A5 rr                lda wy+1
001D9Dr 2  E5 rr                sbc maxwy+1
001D9Fr 2  30 15                bmi @wyok
001DA1r 2  A5 rr                lda maxwy
001DA3r 2  85 rr                sta wy
001DA5r 2  A5 rr                lda maxwy+1
001DA7r 2  85 rr                sta wy+1
001DA9r 2  60                   rts
001DAAr 2  48 A9 00 85  @wy0:   stza wy
001DAEr 2  rr 68        
001DB0r 2  48 A9 00 85          stza wy+1
001DB4r 2  rr 68        
001DB6r 2  60           @wyok:  rts
001DB7r 2               
001DB7r 2               ; ---------------------------------------------------------------- game
001DB7r 2               game_main:
001DB7r 2  48 A9 00 85          stza hiscore
001DBBr 2  rr 68        
001DBDr 2  48 A9 00 85          stza hiscore+1
001DC1r 2  rr 68        
001DC3r 2  48 A9 00 85          stza maxlevel
001DC7r 2  rr 68        
001DC9r 2  48 A9 00 8D          stza title_res
001DCDr 2  rr rr 68     
001DD0r 2               title_loop:
001DD0r 2  20 rr rr             jsr t_title_menu
001DD3r 2  C9 01                cmp #MENU_HELP
001DD5r 2  D0 06                bne new_game
001DD7r 2  20 rr rr             jsr t_help_screen
001DDAr 2  4C rr rr             bra title_loop
001DDDr 2               new_game:
001DDDr 2                 .if MODELB
001DDDr 2  A9 02                lda #LEVEL_IDX              ; the level on the disc
001DDFr 2  85 rr                sta level
001DE1r 2                 .else
001DE1r 2                       stz level
001DE1r 2                 .endif
001DE1r 2  A9 03                lda #3
001DE3r 2  85 rr                sta lives
001DE5r 2  85 rr                sta health
001DE7r 2  A9 00 85 rr          stz score
001DEBr 2  A9 00 85 rr          stz score+1
001DEFr 2  A5 rr                lda maxlevel
001DF1r 2  F0 06                beq level_loop
001DF3r 2  20 rr rr             jsr t_level_select
001DF6r 2  0A                   asl
001DF7r 2  85 rr                sta level
001DF9r 2               level_loop:
001DF9r 2                 .if MODELB
001DF9r 2  20 rr rr             jsr blank_palette
001DFCr 2  A9 02                lda #LEVEL_IDX              ; whatever the last level's end made of 'level'
001DFEr 2  85 rr                sta level
001E00r 2                 .else
001E00r 2                       jsr blank_palette           ; hide the loading and the first-frame build-up
001E00r 2                       stza title_res               ; the level's map replaces the title pack
001E00r 2                       lda #FI_BOX                  ; and the title pack replaced the box stars
001E00r 2                       jsr loadfile
001E00r 2                       ldx level
001E00r 2                 .endif
001E00r 2  20 rr rr             jsr load_level
001E03r 2  20 rr rr             jsr t_level_init
001E06r 2  A9 01                lda #1                      ; lay the bar template + digits into both buffers on
001E08r 2  85 A4                sta BARBG                   ; the first two renders (drawing now would hit the
001E0Ar 2  85 A3                sta BARDIRTY
001E0Cr 2                       ; initial camera; render both buffers before the palette comes back
001E0Cr 2  20 rr rr             jsr t_game_frame
001E0Fr 2  20 rr rr             jsr render_frame
001E12r 2  48 A9 00 85          stza NSPR
001E16r 2  A2 68        
001E18r 2  20 rr rr             jsr t_game_frame
001E1Br 2  20 rr rr             jsr render_frame
001E1Er 2  20 rr rr             jsr set_palette
001E21r 2  A9 00 85 A2          stz NSPR
001E25r 2  A5 rr                lda vsyncs
001E27r 2  85 rr                sta logicvs
001E29r 2  A9 00 85 rr          stz pausing
001E2Dr 2               frame_loop:
001E2Dr 2                       ; pause?
001E2Dr 2  A5 rr                lda keys
001E2Fr 2  29 20                and #K_MENU
001E31r 2  F0 19                beq fl_nopause
001E33r 2  A5 rr                lda pausing
001E35r 2  D0 15                bne fl_nopause
001E37r 2  20 rr rr             jsr t_pause_menu
001E3Ar 2  C9 00                cmp #0
001E3Cr 2  F0 03                beq :+
001E3Er 2  4C rr rr             jmp title_loop
001E41r 2  A9 01        :       lda #1
001E43r 2  85 rr                sta pausing
001E45r 2  A5 rr                lda vsyncs
001E47r 2  85 rr                sta logicvs
001E49r 2  4C rr rr             bra frame_loop
001E4Cr 2               fl_nopause:
001E4Cr 2  A5 rr                lda keys
001E4Er 2  29 20                and #K_MENU
001E50r 2  D0 04                bne :+
001E52r 2  A9 00 85 rr          stz pausing
001E56r 2               :       ; The peg is three vsyncs -- 16.7Hz of render -- and the logic takes two
001E56r 2                       ; steps for each one, so the player, every animation and every enemy move
001E56r 2                       ; twice as far per frame as they used to.  Two steps is a fixed pairing,
001E56r 2                       ; not catching up: time lost to a long frame is still dropped, so the
001E56r 2                       ; window never moves more in a frame than these two steps ask for.
001E56r 2  A5 rr                lda vsyncs
001E58r 2  38                   sec
001E59r 2  E5 rr                sbc logicvs
001E5Br 2  C9 03                cmp #VSPEG
001E5Dr 2  90 24                bcc fl_wait
001E5Fr 2  A5 rr                lda vsyncs
001E61r 2  85 rr                sta logicvs
001E63r 2               frame_top:                          ; exactly once per rendered frame, before the two
001E63r 2                                                   ; logic steps read 'keys': the test harness breaks
001E63r 2                                                   ; here so every wait and every input it applies is
001E63r 2                                                   ; quantised to a frame boundary (tools/harness.mjs)
001E63r 2  48 A9 00 85          stza NSPR                   ; the list is rebuilt by each step; only the
001E67r 2  A2 68        
001E69r 2  20 rr rr             jsr t_game_frame            ; second one's survives to be drawn
001E6Cr 2  A5 rr                lda exiting
001E6Er 2  D0 1C                bne fl_over
001E70r 2  48 A9 00 85          stza NSPR
001E74r 2  A2 68        
001E76r 2  20 rr rr             jsr t_game_frame
001E79r 2  A5 rr                lda exiting
001E7Br 2  D0 0F                bne fl_over
001E7Dr 2  20 rr rr             jsr render_frame
001E80r 2  4C rr rr             bra frame_loop
001E83r 2               fl_wait:  ; nothing to do yet: wait for the next vsync
001E83r 2  A5 rr                lda vsyncs
001E85r 2  C5 rr        :       cmp vsyncs
001E87r 2  F0 FC                beq :-
001E89r 2  4C rr rr             bra frame_loop
001E8Cr 2               fl_over:
001E8Cr 2                       ; level over
001E8Cr 2  A5 rr                lda lives
001E8Er 2  F0 1D                beq game_over
001E90r 2  A5 rr                lda stars
001E92r 2  F0 07                beq @next1
001E94r 2  A5 rr                lda level
001E96r 2  4A                   lsr                         ; C = bit 0
001E97r 2  B0 02                bcs @next1
001E99r 2  E6 rr                inc level
001E9Br 2  E6 rr        @next1: inc level
001E9Dr 2  A5 rr                lda level
001E9Fr 2  C9 10                cmp #16
001EA1r 2  F0 15                beq game_won
001EA3r 2  4A                   lsr
001EA4r 2  C5 rr                cmp maxlevel
001EA6r 2  90 02                bcc :+
001EA8r 2  85 rr                sta maxlevel
001EAAr 2  4C rr rr     :       jmp level_loop
001EADr 2               game_over:
001EADr 2  20 rr rr             jsr update_hiscore
001EB0r 2  A9 00                lda #0
001EB2r 2  20 rr rr             jsr t_winlose
001EB5r 2  4C rr rr             jmp title_loop
001EB8r 2               game_won:
001EB8r 2  20 rr rr             jsr update_hiscore
001EBBr 2  A9 01                lda #1
001EBDr 2  20 rr rr             jsr t_winlose
001EC0r 2  4C rr rr             jmp title_loop
001EC3r 2               update_hiscore:
001EC3r 2  A5 rr                lda hiscore
001EC5r 2  C5 rr                cmp score
001EC7r 2  A5 rr                lda hiscore+1
001EC9r 2  E5 rr                sbc score+1
001ECBr 2  B0 08                bcs :+
001ECDr 2  A5 rr 85 rr          mov16 hiscore, score
001ED1r 2  A5 rr 85 rr  
001ED5r 2  60           :       rts
001ED6r 2               
001ED6r 2               ; ---------------------------------------------------------------- sound data
001ED6r 2                       PLACE "CODE", "LGCCODE"     ; Model B: bank 7, with sound_tick
001ED6r 2               ; sfx steps: byte0 = channel/period latch ($80 | ch<<5 | lo4), byte1 = period hi (data byte), byte2 = volume ($90|ch<<5|att), duration
001ED6r 2  rr rr rr rr  sfxtab: .word sfx_jump, sfx_star, sfx_throw, sfx_hit, sfx_kill, sfx_power, sfx_die
001EDAr 2  rr rr rr rr  
001EDEr 2  rr rr rr rr  
001EE4r 2  C8 0C D0 02  sfx_jump:  .byte $C0|8, 12, $D0, 2,  $C0|4, 9, $D2, 2,  $C0|0, 7, $D4, 2,  $C0|8, 5, $D6, 3, $FF
001EE8r 2  C4 09 D2 02  
001EECr 2  C0 07 D4 02  
001EF5r 2  C0 04 D0 02  sfx_star:  .byte $C0|0, 4, $D0, 2,  $C0|0, 3, $D0, 3,  $C0|0, 3, $D6, 3, $FF
001EF9r 2  C0 03 D0 03  
001EFDr 2  C0 03 D6 03  
001F02r 2  E4 00 F2 02  sfx_throw: .byte $E0|4, 0, $F2, 2,  $E0|5, 0, $F5, 3,  $E0|5, 0, $F9, 3, $FF
001F06r 2  E5 00 F5 03  
001F0Ar 2  E5 00 F9 03  
001F0Fr 2  C0 28 D0 04  sfx_hit:   .byte $C0|0, 40, $D0, 4, $C0|0, 48, $D2, 4, $C0|0, 60, $D5, 5, $FF
001F13r 2  C0 30 D2 04  
001F17r 2  C0 3C D5 05  
001F1Cr 2  C0 06 D0 02  sfx_kill:  .byte $C0|0, 6, $D0, 2,  $C0|0, 9, $D1, 2,  $C0|0, 12, $D3, 3, $C0|0, 16, $D6, 3, $FF
001F20r 2  C0 09 D1 02  
001F24r 2  C0 0C D3 03  
001F2Dr 2  C0 06 D0 03  sfx_power: .byte $C0|0, 6, $D0, 3,  $C0|0, 5, $D0, 3,  $C0|0, 4, $D0, 3,  $C0|0, 3, $D0, 6, $FF
001F31r 2  C0 05 D0 03  
001F35r 2  C0 04 D0 03  
001F3Er 2  C0 0C D0 06  sfx_die:   .byte $C0|0, 12, $D0, 6, $C0|0, 16, $D1, 6, $C0|0, 22, $D2, 8, $C0|0, 30, $D4, 10, $C0|0, 40, $D7, 12, $FF
001F42r 2  C0 10 D1 06  
001F46r 2  C0 16 D2 08  
001F53r 2               
001F53r 2               
001F53r 1                       .include "low.s"
001F53r 2               ; ============================================================================
001F53r 2               ; Main RAM, $0140-$02FF: what has to be visible whatever bank is paged in.  The
001F53r 2               ; far-call thunk, the interrupt stub (the handler itself is in bank 7), the two
001F53r 2               ; map fetches the tile blitter makes from bank 5, and the sprite list.  The
001F53r 2               ; Master's own main-RAM map helpers (maprow, mapbyte, mapput, pagelogic) land here
001F53r 2               ; too, from engine.s: they page bank 6 in and bank 7 back exactly as they do there.
001F53r 2               ; ============================================================================
001F53r 2                       .segment "LOWCODE"
000038r 2               
000038r 2               ; ---------------------------------------------------------------- far calls
000038r 2               ; X = the index of a (bank, address-1) entry in FARTAB, which every bank carries at
000038r 2               ; the same address.  A goes in and comes back, Y is untouched, X is destroyed.
000038r 2               ; Everything is on the stack -- the caller's bank, the return into fcret, the target
000038r 2               ; -- so it nests and a step of the interrupt handler can land anywhere in it: the
000038r 2               ; handler reads the bank from $F4 and puts it back, which is the MOS's own rule.
000038r 2               ;
000038r 2               ;   caller's return
000038r 2               ;   A on entry
000038r 2               ;   caller's bank          <- fcret pulls this
000038r 2               ;   fcret-1                <- the target's rts lands here
000038r 2               ;   target-1               <- this rts goes there
000038r 2               farcall:
000038r 2  48                   pha
000039r 2  A5 F4                lda ROMSEL_CPY
00003Br 2  48                   pha
00003Cr 2  A9 rr                lda #>(fcret-1)
00003Er 2  48                   pha
00003Fr 2  A9 rr                lda #<(fcret-1)
000041r 2  48                   pha
000042r 2  BD 02 80             lda FARTAB+2,x
000045r 2  48                   pha
000046r 2  BD 01 80             lda FARTAB+1,x
000049r 2  48                   pha
00004Ar 2  BD 00 80             lda FARTAB,x
00004Dr 2  85 F4                sta ROMSEL_CPY
00004Fr 2  8D 30 FE             sta ROMSEL
000052r 2  BA                   tsx
000053r 2  BD 06 01             lda $0106,x                 ; A as it came in
000056r 2  60                   rts
000057r 2  AA           fcret:  tax                         ; the target's A
000058r 2  68                   pla
000059r 2  85 F4                sta ROMSEL_CPY              ; the caller's bank
00005Br 2  8D 30 FE             sta ROMSEL
00005Er 2  68                   pla                         ; (the A that went in)
00005Fr 2  8A                   txa
000060r 2  60                   rts
000061r 2               
000061r 2               ; ---------------------------------------------------------------- interrupts
000061r 2               ; The chain step and the vsync work are in bank 7 with their tables: this pages it
000061r 2               ; in around them.  The step's timing (VS2T_DEFAULT) allows for the ~30 cycles that
000061r 2               ; takes, in place of the hold loop the Master's handler has.
000061r 2               irq_handler:
000061r 2  86 rr                stx irq_x
000063r 2  84 rr                sty irq_y
000065r 2  A5 F4                lda ROMSEL_CPY
000067r 2  48                   pha
000068r 2  A9 07                lda #BANK_LVL
00006Ar 2  85 F4                sta ROMSEL_CPY
00006Cr 2  8D 30 FE             sta ROMSEL
00006Fr 2  20 rr rr             jsr isr_body
000072r 2  68                   pla
000073r 2  85 F4                sta ROMSEL_CPY
000075r 2  8D 30 FE             sta ROMSEL
000078r 2  A4 rr                ldy irq_y
00007Ar 2  A6 rr                ldx irq_x
00007Cr 2  A5 FC                lda $FC
00007Er 2  40                   rti
00007Fr 2               
00007Fr 2               ; the start-up's switch from bank 6 to bank 7 (init.s): a bank cannot page itself out
00007Fr 2  A9 07        to7:    lda #BANK_LVL
000081r 2  85 F4                sta ROMSEL_CPY
000083r 2  8D 30 FE             sta ROMSEL
000086r 2  4C rr rr             jmp start7
000089r 2               
000089r 2               ; ---------------------------------------------------------------- the tile blitter's map
000089r 2               ; drawrect runs in bank 5 and reads the map in bank 6: the row pointer is arithmetic
000089r 2               ; (MAPSTRIDE is a constant here, so there are no row tables) and the strip copy is
000089r 2               ; the one bank switch a tile row costs.
000089r 2               maprow5:                            ; A = tile row -> ptr = LV_MAP + row*MAPSTRIDE + rc_tx0
000089r 2                       .assert MAPLW = 7, error, "maprow5 assumes 128-tile rows"
000089r 2  4A                   lsr                         ; row * 128: the row's low bit is the low byte's top
00008Ar 2  85 rr                sta ptr+1
00008Cr 2  A9 00                lda #0
00008Er 2  6A                   ror
00008Fr 2  18                   clc
000090r 2  65 rr                adc rc_tx0                  ; < 128, so no carry out
000092r 2  85 rr                sta ptr
000094r 2  A5 rr                lda ptr+1
000096r 2  18                   clc
000097r 2  69 rr                adc #>LV_MAP
000099r 2  85 rr                sta ptr+1
00009Br 2  60                   rts
00009Cr 2               
00009Cr 2               mapstrip:                           ; (ptr), 0..rc_nt -> MAPBUF
00009Cr 2  A9 06                lda #BANK_MAP
00009Er 2  85 F4                sta ROMSEL_CPY
0000A0r 2  8D 30 FE             sta ROMSEL
0000A3r 2  A4 rr                ldy rc_nt
0000A5r 2  B1 rr        :       lda (ptr),y
0000A7r 2  99 rr rr             sta MAPBUF,y
0000AAr 2  88                   dey
0000ABr 2  10 F8                bpl :-
0000ADr 2  A9 05                lda #BANK_TILES
0000AFr 2  85 F4                sta ROMSEL_CPY
0000B1r 2  8D 30 FE             sta ROMSEL
0000B4r 2  60                   rts
0000B5r 2               
0000B5r 2               ; the sprite directory is in bank 6 and the prologue in bank 5: an entry's eight
0000B5r 2               ; bytes come across here, and ptr is left pointing at the copy
0000B5r 2               dirfetch:                           ; ptr -> the entry in SPR_TABLE
0000B5r 2  A9 06                lda #BANK_TIL1
0000B7r 2  85 F4                sta ROMSEL_CPY
0000B9r 2  8D 30 FE             sta ROMSEL
0000BCr 2  A0 07                ldy #7
0000BEr 2  B1 rr        :       lda (ptr),y
0000C0r 2  99 rr rr             sta MAPBUF,y
0000C3r 2  88                   dey
0000C4r 2  10 F8                bpl :-
0000C6r 2  A9 05                lda #BANK_TILES
0000C8r 2  85 F4                sta ROMSEL_CPY
0000CAr 2  8D 30 FE             sta ROMSEL
0000CDr 2  A9 rr                lda #<MAPBUF
0000CFr 2  85 rr                sta ptr
0000D1r 2  A9 rr                lda #>MAPBUF
0000D3r 2  85 rr                sta ptr+1
0000D5r 2  60                   rts
0000D6r 2               
0000D6r 2                       .segment "LOWBSS"
00008Cr 2  xx xx xx xx  MAPBUF:   .res 21                   ; a tile row of the rectangle: 21 tiles at most
000090r 2  xx xx xx xx  
000094r 2  xx xx xx xx  
0000A1r 2               ; the mirror's bookkeeping (display.s): the blitters in bank 5 note what they wrote
0000A1r 2               ; to the ring's last slot row, the copy in bank 7 reads it
0000A1r 2  xx xx        mirdty:   .res 2                    ; per buffer: the row has been written since the copy
0000A3r 2  xx xx        mirlo:    .res 2                    ; and which chars of it (in slot chars, 0..79)
0000A5r 2  xx xx        mirhi:    .res 2
0000A7r 2  xx xx        mirwcx:   .res 2                    ; the wcxm the copy was made for
0000A9r 2               
0000A9r 1                       .include "display.s"
0000A9r 2               ; ============================================================================
0000A9r 2               ; The Model B's display driver: bank 7, with the logic.  The rupture chain the CRTC is driven by,
0000A9r 2               ; the mirror the straddling row is read from, and the interrupt's work.  The Master
0000A9r 2               ; needs none of this -- its ring is hardware wrapped -- so it is the one part of the
0000A9r 2               ; renderer that is this target's own (DESIGN.md, "the display").
0000A9r 2               ; ============================================================================
0000A9r 2                       .segment "LGCCODE"
001F53r 2               
001F53r 2               ; ---------------------------------------------------------------- the interrupt
001F53r 2               ; Reached from the stub in low RAM with this bank paged in and X, Y saved.
001F53r 2               isr_body:
001F53r 2  2C 4D FE             bit VIA_IFR
001F56r 2  70 0A                bvs @t1
001F58r 2  AD 4D FE             lda VIA_IFR
001F5Br 2  29 02                and #$02
001F5Dr 2  F0 68                beq @exit
001F5Fr 2  4C rr rr             jmp vsync_tick
001F62r 2               @t1:    ; A rupture step is a CRTC restart: R12/R13 were armed during the section
001F62r 2                       ; before and latch at the boundary; R9 with R4 decide where the section ends
001F62r 2                       ; and are compared at the start of its last scanline, and R6 from scanline 1
001F62r 2                       ; on.  The chain is phased so the step fires ~60 cycles BEFORE the restart;
001F62r 2                       ; the stub's bank switch carries the first write past it.
001F62r 2  AE rr rr             ldx SECIDX
001F65r 2  A9 09                lda #9
001F67r 2  8D 00 FE             sta CRTC_IDX
001F6Ar 2  BD rr rr             lda SECTAB+3,x
001F6Dr 2  8D 01 FE             sta CRTC_DAT
001F70r 2  A9 04                lda #4
001F72r 2  8D 00 FE             sta CRTC_IDX
001F75r 2  BD rr rr             lda SECTAB+2,x
001F78r 2  8D 01 FE             sta CRTC_DAT
001F7Br 2  A9 06                lda #6
001F7Dr 2  8D 00 FE             sta CRTC_IDX
001F80r 2  BC rr rr             ldy SECTAB+4,x
001F83r 2  8C 01 FE             sty CRTC_DAT
001F86r 2  A9 07                lda #7
001F88r 2  8D 00 FE             sta CRTC_IDX
001F8Br 2  BD rr rr             lda SECTAB+5,x
001F8Er 2  8D 01 FE             sta CRTC_DAT
001F91r 2  8D rr rr             sta curR7                   ; the vsync handler re-phases the frame from this
001F94r 2  A9 0C                lda #12
001F96r 2  8D 00 FE             sta CRTC_IDX
001F99r 2  BD rr rr             lda SECTAB,x
001F9Cr 2  8D 01 FE             sta CRTC_DAT
001F9Fr 2  A9 0D                lda #13
001FA1r 2  8D 00 FE             sta CRTC_IDX
001FA4r 2  BD rr rr             lda SECTAB+1,x
001FA7r 2  8D 01 FE             sta CRTC_DAT
001FAAr 2  BD rr rr             lda SECTAB+6,x
001FADr 2  8D 46 FE             sta VIA_T1LL
001FB0r 2  BD rr rr             lda SECTAB+7,x
001FB3r 2  8D 47 FE             sta VIA_T1LH
001FB6r 2  AD 44 FE             lda VIA_T1CL                ; clear the T1 flag
001FB9r 2  AD rr rr             lda curR7                   ; the chain stops at Q, the only section whose R7
001FBCr 2  C9 08                cmp #QVSYNC                 ; is the vsync row: a late vsync must not walk it
001FBEr 2  F0 07                beq @exit                   ; off the end of SECTAB
001FC0r 2  8A                   txa
001FC1r 2  18                   clc
001FC2r 2  69 08                adc #8
001FC4r 2  8D rr rr             sta SECIDX
001FC7r 2  60           @exit:  rts
001FC8r 2               
001FC8r 2               ; ---- vsync: restart T1 first (constant latency), counter = vsync -> the bar
001FC8r 2               vsync_tick:
001FC8r 2  AD rr rr             lda VS2T
001FCBr 2  8D 46 FE             sta VIA_T1LL
001FCEr 2  AD rr rr             lda VS2T+1
001FD1r 2  8D 45 FE             sta VIA_T1CH
001FD4r 2  A9 02                lda #$02
001FD6r 2  8D 4D FE             sta VIA_IFR
001FD9r 2  A9 09                lda #9                      ; re-phase: end this frame curR7 + (QROWS-1-QVSYNC)
001FDBr 2  8D 00 FE             sta CRTC_IDX                ; rows from the vsync, whatever the row counter did
001FDEr 2  A9 07                lda #7
001FE0r 2  8D 01 FE             sta CRTC_DAT
001FE3r 2  A9 06                lda #6                      ; pre-arm the bar's R6 here in Q, where the display
001FE5r 2  8D 00 FE             sta CRTC_IDX                ; is off and a new R6 cannot show
001FE8r 2  A9 02                lda #BARROWS
001FEAr 2  8D 01 FE             sta CRTC_DAT
001FEDr 2  A9 04                lda #4
001FEFr 2  8D 00 FE             sta CRTC_IDX
001FF2r 2  AD rr rr             lda curR7
001FF5r 2  18                   clc
001FF6r 2  69 07                adc #QROWS-1-QVSYNC
001FF8r 2  29 7F                and #$7F
001FFAr 2  8D 01 FE             sta CRTC_DAT
001FFDr 2  E6 rr                inc vsyncs
001FFFr 2  A5 rr                lda flipreq
002001r 2  F0 17                beq @noflip
002003r 2  A5 rr                lda vsyncs
002005r 2  38                   sec
002006r 2  E5 rr                sbc flipvs
002008r 2  C9 02                cmp #2
00200Ar 2  90 0E                bcc @noflip
00200Cr 2  A5 rr                lda vsyncs
00200Er 2  85 rr                sta flipvs
002010r 2  AD rr rr             lda NEXTSECT
002013r 2  8D rr rr             sta DISPSECT
002016r 2  A9 00 85 rr          stz flipreq
00201Ar 2               @noflip:
00201Ar 2  A2 00                ldx #0                      ; section 0 is the bar: its address and length come
00201Cr 2  AC rr rr             ldy DISPSECT                ; from the buffer about to be displayed
00201Fr 2  F0 02                beq :+
002021r 2  A2 02                ldx #2
002023r 2  BD rr rr     :       lda BUF_SEC0T1,x
002026r 2  8D 46 FE             sta VIA_T1LL
002029r 2  BD rr rr             lda BUF_SEC0T1+1,x
00202Cr 2  8D 47 FE             sta VIA_T1LH
00202Fr 2  A9 0C                lda #12
002031r 2  8D 00 FE             sta CRTC_IDX
002034r 2  BD rr rr             lda BUF_SEC0,x
002037r 2  8D 01 FE             sta CRTC_DAT
00203Ar 2  A9 0D                lda #13
00203Cr 2  8D 00 FE             sta CRTC_IDX
00203Fr 2  BD rr rr             lda BUF_SEC0+1,x
002042r 2  8D 01 FE             sta CRTC_DAT
002045r 2  A9 40                lda #$40
002047r 2  8D 4D FE             sta VIA_IFR
00204Ar 2  8C rr rr             sty SECIDX
00204Dr 2  20 rr rr             jsr scan_keys               ; the keyboard and the sound are the interrupt's,
002050r 2  4C rr rr             jmp sound_tick              ; as they are on the Master
002053r 2               
002053r 2               ; ---------------------------------------------------------------- the chain
002053r 2               ; build_sections: fill SECTAB for the current buffer from ringS and wfine.
002053r 2               ; entry i: R12n, R13n, R4, R9, R6, R7, T1lo, T1hi.  The shape is section i's; the
002053r 2               ; address and duration are section i+1's, because R12/R13 latch at the next restart
002053r 2               ; and the T1 latch takes effect one interrupt later.
002053r 2               ;
002053r 2               ;   T   bar          2 rows at $0300
002053r 2               ;   A   composed row 8-f lines, the fine scroll                (only when f > 0)
002053r 2               ;   P1  playfield    from the window's slot to the ring's end
002053r 2               ;   M   playfield    the rest, from the mirror
002053r 2               ;   P2  bottom       f lines                                   (only when f > 0)
002053r 2               ;   Q   blanking     16 rows, vsync at row 8
002053r 2               ;
002053r 2               ; A row starting past RINGCHARS-80 straddles the ring end and is read from the mirror
002053r 2               ; sitting immediately below the ring base, which is exactly the address c - RINGCHARS
002053r 2               ; names; every row after it follows on contiguously.
002053r 2               build_sections:
002053r 2  A6 rr                ldx curbuf                  ; the buffer's CRTC base, and the mirror redirect:
002055r 2  BD rr rr             lda @cbl,x                  ; the same add with the ring subtracted
002058r 2  8D rr rr             sta crtcb
00205Br 2  BD rr rr             lda @cbh,x
00205Er 2  8D rr rr             sta crtcb+1
002061r 2  BD rr rr             lda @cml,x
002064r 2  8D rr rr             sta crtcbm
002067r 2  BD rr rr             lda @cmh,x
00206Ar 2  8D rr rr             sta crtcbm+1
00206Dr 2  A5 rr                lda curbuf
00206Fr 2  0A                   asl
002070r 2  AA                   tax
002071r 2  A9 00                lda #>BARCRTC               ; section 0 is the bar: fixed address and length
002073r 2  9D rr rr             sta BUF_SEC0,x
002076r 2  A9 60                lda #<BARCRTC
002078r 2  9D rr rr             sta BUF_SEC0+1,x
00207Br 2  A9 FE                lda #<(BARROWS*8*LINE-2)
00207Dr 2  9D rr rr             sta BUF_SEC0T1,x
002080r 2  A9 03                lda #>(BARROWS*8*LINE-2)
002082r 2  9D rr rr             sta BUF_SEC0T1+1,x
002085r 2  A6 rr                ldx curbuf
002087r 2  F0 02                beq :+
002089r 2  A2 30                ldx #48
00208Br 2  A9 01        :       lda #BARROWS-1
00208Dr 2  9D rr rr             sta SECTAB+2,x
002090r 2  A9 07                lda #7
002092r 2  9D rr rr             sta SECTAB+3,x
002095r 2  A9 02                lda #BARROWS
002097r 2  9D rr rr             sta SECTAB+4,x
00209Ar 2  A9 1E                lda #30
00209Cr 2  9D rr rr             sta SECTAB+5,x
00209Fr 2  A5 rr                lda wfine
0020A1r 2  F0 6F                beq @coarse
0020A3r 2                       ; ---- f > 0: T -> A (the composed row) -> P.. -> P2 -> Q
0020A3r 2  49 07                eor #7
0020A5r 2  85 DF E6 DF          inca                        ; 8-f lines of it
0020A9r 2  A5 DF        
0020ABr 2  20 rr rr             jsr @dur
0020AEr 2  9D rr rr             sta SECTAB+6,x
0020B1r 2  A5 rr                lda tmp3
0020B3r 2  9D rr rr             sta SECTAB+7,x
0020B6r 2  A5 rr                lda ringS                   ; the composed row is the 80 chars above the window
0020B8r 2  38                   sec
0020B9r 2  E9 50                sbc #<ROWCHARS
0020BBr 2  85 rr                sta w16
0020BDr 2  A5 rr                lda ringS+1
0020BFr 2  E9 00                sbc #0
0020C1r 2  85 rr                sta w16+1
0020C3r 2  10 0D                bpl :+
0020C5r 2  A5 rr                lda w16
0020C7r 2  18                   clc
0020C8r 2  69 30                adc #<RINGCHARS
0020CAr 2  85 rr                sta w16
0020CCr 2  A5 rr                lda w16+1
0020CEr 2  69 07                adc #>RINGCHARS
0020D0r 2  85 rr                sta w16+1
0020D2r 2  20 rr rr     :       jsr @addr
0020D5r 2  8A                   txa
0020D6r 2  18                   clc
0020D7r 2  69 08                adc #8
0020D9r 2  AA                   tax                         ; A's entry
0020DAr 2  A9 00 9D rr          stz SECTAB+2,x
0020DEr 2  rr           
0020DFr 2  A5 rr                lda wfine
0020E1r 2  49 07                eor #7                      ; 7 - f
0020E3r 2  9D rr rr             sta SECTAB+3,x
0020E6r 2  A9 02                lda #2
0020E8r 2  9D rr rr             sta SECTAB+4,x
0020EBr 2  A9 1E                lda #30
0020EDr 2  9D rr rr             sta SECTAB+5,x
0020F0r 2  A5 rr                lda ringS                   ; the run starts one row into the window
0020F2r 2  18                   clc
0020F3r 2  69 50                adc #<ROWCHARS
0020F5r 2  85 rr                sta w16
0020F7r 2  A5 rr                lda ringS+1
0020F9r 2  69 00                adc #0
0020FBr 2  85 rr                sta w16+1
0020FDr 2  20 rr rr             jsr @wrap
002100r 2  A9 14                lda #VISROWS-1
002102r 2  85 rr                sta tmp4                    ; rows in the run
002104r 2  A4 rr                ldy barq
002106r 2  C8                   iny
002107r 2  C0 17                cpy #RINGROWS
002109r 2  90 02                bcc :+
00210Br 2  A0 00                ldy #0
00210Dr 2  84 rr        :       sty tmp3
00210Fr 2  4C rr rr             bra @run
002112r 2               @coarse:                            ; ---- f = 0: T -> P.. -> Q
002112r 2  A5 rr                lda ringS
002114r 2  85 rr                sta w16
002116r 2  A5 rr                lda ringS+1
002118r 2  85 rr                sta w16+1
00211Ar 2  A9 15                lda #VISROWS
00211Cr 2  85 rr                sta tmp4
00211Er 2  A5 rr                lda barq
002120r 2  85 rr                sta tmp3
002122r 2               @run:   ; w16 = the run's ring offset, tmp4 = its rows, X = the entry before it
002122r 2  20 rr rr             jsr @nfull                  ; rows that end before the ring end
002125r 2  C5 rr                cmp tmp4
002127r 2  B0 15                bcs @one                    ; the whole run fits
002129r 2  C9 00                cmp #0
00212Br 2  F0 11                beq @one                    ; it starts inside the straddling row: all of it folds
00212Dr 2  85 rr                sta tmp2
00212Fr 2  20 rr rr             jsr @emit                   ; up to the ring end
002132r 2  A5 rr                lda tmp2
002134r 2  20 rr rr             jsr @advance
002137r 2  A5 rr                lda tmp4
002139r 2  38                   sec
00213Ar 2  E5 rr                sbc tmp2
00213Cr 2  85 rr                sta tmp4
00213Er 2  A5 rr        @one:   lda tmp4
002140r 2  85 rr                sta tmp2
002142r 2  20 rr rr             jsr @emit
002145r 2  A5 rr                lda tmp4
002147r 2  20 rr rr             jsr @advance                ; now the row below the playfield
00214Ar 2  A5 rr                lda wfine
00214Cr 2  F0 40                beq @setq
00214Er 2                       ; --- P2: the top f lines of that row
00214Er 2  20 rr rr             jsr @addr
002151r 2  A5 rr                lda wfine
002153r 2  20 rr rr             jsr @dur
002156r 2  9D rr rr             sta SECTAB+6,x
002159r 2  A5 rr                lda tmp3
00215Br 2  9D rr rr             sta SECTAB+7,x
00215Er 2  8A                   txa
00215Fr 2  18                   clc
002160r 2  69 08                adc #8
002162r 2  AA                   tax
002163r 2  48 A9 00 9D          stza SECTAB+2, x
002167r 2  rr rr 68     
00216Ar 2  A5 rr                lda wfine
00216Cr 2  85 DF C6 DF          deca
002170r 2  A5 DF        
002172r 2  9D rr rr             sta SECTAB+3,x
002175r 2  A9 15                lda #VISROWS
002177r 2  9D rr rr             sta SECTAB+4,x
00217Ar 2  A9 1E                lda #30
00217Cr 2  9D rr rr             sta SECTAB+5,x
00217Fr 2  BD rr rr             lda SECTAB-8,x              ; w16 has not moved: the address the P2 @addr left
002182r 2  9D rr rr             sta SECTAB,x                ; in the previous entry is this one's too
002185r 2  BD rr rr             lda SECTAB-8+1,x
002188r 2  9D rr rr             sta SECTAB+1,x
00218Br 2  4C rr rr             bra @sq2
00218Er 2  20 rr rr     @setq:  jsr @addr                   ; Q starts on the row below the playfield
002191r 2  A9 FE        @sq2:   lda #<(40*LINE-2)
002193r 2  9D rr rr             sta SECTAB+6,x
002196r 2  A9 09                lda #>(40*LINE-2)
002198r 2  9D rr rr             sta SECTAB+7,x
00219Br 2  8A                   txa
00219Cr 2  18                   clc
00219Dr 2  69 08                adc #8
00219Fr 2  AA                   tax
0021A0r 2  A9 00                lda #>BARCRTC               ; and hands the chain back to the bar
0021A2r 2  9D rr rr             sta SECTAB,x
0021A5r 2  A9 60                lda #<BARCRTC
0021A7r 2  9D rr rr             sta SECTAB+1,x
0021AAr 2  A9 0F                lda #QROWS-1
0021ACr 2  9D rr rr             sta SECTAB+2,x
0021AFr 2  A9 07                lda #7
0021B1r 2  9D rr rr             sta SECTAB+3,x
0021B4r 2  48 A9 00 9D          stza SECTAB+4, x
0021B8r 2  rr rr 68     
0021BBr 2  A9 08                lda #QVSYNC
0021BDr 2  9D rr rr             sta SECTAB+5, x
0021C0r 2  A9 FE                lda #<(40*LINE-2)
0021C2r 2  9D rr rr             sta SECTAB+6, x
0021C5r 2  A9 09                lda #>(40*LINE-2)
0021C7r 2  9D rr rr             sta SECTAB+7, x
0021CAr 2  60                   rts
0021CBr 2  50 D0        @cbl:   .byte <CRTCB_A, <CRTCB_B
0021CDr 2  01 08        @cbh:   .byte >CRTCB_A, >CRTCB_B
0021CFr 2  20 A0        @cml:   .byte <(CRTCB_A-RINGCHARS), <(CRTCB_B-RINGCHARS)
0021D1r 2  FA 01        @cmh:   .byte >(CRTCB_A-RINGCHARS), >(CRTCB_B-RINGCHARS)
0021D3r 2               ; --- emit a run of tmp2 rows starting at ring offset w16, following entry X
0021D3r 2  20 rr rr     @emit:  jsr @addr
0021D6r 2  A5 rr                lda tmp2
0021D8r 2  20 rr rr             jsr @lines
0021DBr 2  9D rr rr             sta SECTAB+6,x
0021DEr 2  A5 rr                lda tmp3
0021E0r 2  9D rr rr             sta SECTAB+7,x
0021E3r 2  8A                   txa
0021E4r 2  18                   clc
0021E5r 2  69 08                adc #8
0021E7r 2  AA                   tax
0021E8r 2  A5 rr                lda tmp2
0021EAr 2  85 DF C6 DF          deca
0021EEr 2  A5 DF        
0021F0r 2  9D rr rr             sta SECTAB+2,x
0021F3r 2  A9 07                lda #7
0021F5r 2  9D rr rr             sta SECTAB+3,x
0021F8r 2  A9 1E                lda #30
0021FAr 2  9D rr rr             sta SECTAB+4,x
0021FDr 2  9D rr rr             sta SECTAB+5,x
002200r 2  60                   rts
002201r 2               ; --- SECTAB+0/1,x = the CRTC address of the row at ring offset w16.  A row starting
002201r 2               ; past RINGCHARS-80 straddles the ring end and is read from the mirror below the base,
002201r 2               ; which is exactly the address w16 - RINGCHARS names.
002201r 2  A5 rr        @addr:  lda w16
002203r 2  A4 rr                ldy w16+1
002205r 2  C0 06                cpy #>(RINGCHARS-ROWCHARS+1)
002207r 2  90 15                bcc :++
002209r 2  D0 04                bne :+
00220Br 2  C9 E1                cmp #<(RINGCHARS-ROWCHARS+1)
00220Dr 2  90 0F                bcc :++
00220Fr 2  18           :       clc
002210r 2  6D rr rr             adc crtcbm
002213r 2  9D rr rr             sta SECTAB+1,x
002216r 2  98                   tya
002217r 2  6D rr rr             adc crtcbm+1
00221Ar 2  9D rr rr             sta SECTAB,x
00221Dr 2  60                   rts
00221Er 2  18           :       clc
00221Fr 2  6D rr rr             adc crtcb
002222r 2  9D rr rr             sta SECTAB+1,x
002225r 2  98                   tya
002226r 2  6D rr rr             adc crtcb+1
002229r 2  9D rr rr             sta SECTAB,x
00222Cr 2  60                   rts
00222Dr 2                       ; --- A = rows -> A/tmp3 = that many rows of lines, as a T1 count
00222Dr 2  0A           @lines: asl
00222Er 2  0A                   asl
00222Fr 2  0A                   asl
002230r 2  4C rr rr             jmp @dur
002233r 2                       ; --- A = rows: advance w16 by that many rows, folding into 0..RINGCHARS
002233r 2               @advance:
002233r 2  A8                   tay
002234r 2  18                   clc
002235r 2  A5 rr                lda w16
002237r 2  79 50 80             adc mulrowlo,y
00223Ar 2  85 rr                sta w16
00223Cr 2  A5 rr                lda w16+1
00223Er 2  79 68 80             adc mulrowhi,y
002241r 2  85 rr                sta w16+1
002243r 2  A5 rr        @wrap:  lda w16+1
002245r 2  C9 07                cmp #>RINGCHARS
002247r 2  90 15                bcc :++
002249r 2  D0 06                bne :+
00224Br 2  A5 rr                lda w16
00224Dr 2  C9 30                cmp #<RINGCHARS
00224Fr 2  90 0D                bcc :++
002251r 2  A5 rr        :       lda w16
002253r 2  38                   sec
002254r 2  E9 30                sbc #<RINGCHARS
002256r 2  85 rr                sta w16
002258r 2  A5 rr                lda w16+1
00225Ar 2  E9 07                sbc #>RINGCHARS
00225Cr 2  85 rr                sta w16+1
00225Er 2  60           :       rts
00225Fr 2                       ; --- rows of the run that finish before the ring end.  The run starts on ring
00225Fr 2                       ; row tmp3; when r = ringS mod 80 is non-zero the last ring row straddles and
00225Fr 2                       ; @addr sends it to the mirror, so RINGROWS-1-tmp3 rows come first.
00225Fr 2  A4 rr        @nfull: ldy barq
002261r 2  A5 rr                lda ringS
002263r 2  38                   sec
002264r 2  F9 50 80             sbc mulrowlo,y              ; r
002267r 2  C9 01                cmp #1                      ; C = 1 iff r > 0
002269r 2  A9 16                lda #RINGROWS-1
00226Br 2  B0 04                bcs :+
00226Dr 2  69 00                adc #0                      ; r == 0: C is clear here, so this adds 1
00226Fr 2  69 01                adc #1
002271r 2  38           :       sec
002272r 2  E5 rr                sbc tmp3
002274r 2  60                   rts
002275r 2                       ; --- A = lines -> A/tmp3 = the T1 count that lasts that long
002275r 2  85 rr        @dur:   sta tmp3                    ; n*64 == (n*256)>>2
002277r 2  A9 00                lda #0
002279r 2  46 rr                lsr tmp3
00227Br 2  6A                   ror
00227Cr 2  46 rr                lsr tmp3
00227Er 2  6A                   ror
00227Fr 2  E9 01                sbc #1                      ; C = 0 out of the ror pair: A - 2
002281r 2  B0 02                bcs :+
002283r 2  C6 rr                dec tmp3
002285r 2  60           :       rts
002286r 2               
002286r 2               ; ---------------------------------------------------------------- the mirror
002286r 2                       .segment "TILCODE"          ; bank 5: render_core's last step
000C9Ar 2               ; A copy of the ring's last slot row sits immediately below the ring base, so the
000C9Ar 2               ; one displayed row that straddles the ring end can be read as a single run.  Only
000C9Ar 2               ; the chars that row takes from it -- wcxm..79 -- need to be right, and when the
000C9Ar 2               ; window is slot aligned no row straddles at all.  It is made only when its row
000C9Ar 2               ; has been written: the blitters note the range (mirdirty, bank 5).
000C9Ar 2               mirror_copy:
000C9Ar 2  A6 rr                ldx curbuf
000C9Cr 2  A5 E5                lda wcxm
000C9Er 2  DD rr rr             cmp mirwcx,x                ; a move left uncovers chars the last copy never
000CA1r 2  B0 0F                bcs :+                      ; reached, so the whole row has to be made again
000CA3r 2  A9 01                lda #1
000CA5r 2  9D rr rr             sta mirdty,x
000CA8r 2  A9 00                lda #0
000CAAr 2  9D rr rr             sta mirlo,x
000CADr 2  A9 4F                lda #ROWCHARS-1
000CAFr 2  9D rr rr             sta mirhi,x
000CB2r 2  BD rr rr     :       lda mirdty,x                ; nothing has touched the ring's last row in this
000CB5r 2  D0 01                bne :+                      ; buffer since the mirror was last made
000CB7r 2  60                   rts
000CB8r 2  A5 E5        :       lda wcxm
000CBAr 2  D0 01                bne :+                      ; slot aligned: no row straddles, so the mirror is
000CBCr 2  60                   rts                         ; not read -- and the flag stays up for when it is
000CBDr 2  A9 00        :       lda #0
000CBFr 2  9D rr rr             sta mirdty,x
000CC2r 2  BD rr rr             lda mirlo,x                 ; the copy starts at the first written char, or at
000CC5r 2  C5 E5                cmp wcxm                    ; wcxm if the writing started left of it
000CC7r 2  B0 02                bcs :+
000CC9r 2  A5 E5                lda wcxm
000CCBr 2  85 rr        :       sta tmp4                    ; and runs to the last written one
000CCDr 2  BD rr rr             lda mirhi,x
000CD0r 2  85 rr                sta tmp3
000CD2r 2  A9 FF                lda #$FF                    ; the written range is empty again
000CD4r 2  9D rr rr             sta mirlo,x
000CD7r 2  A9 00                lda #0
000CD9r 2  9D rr rr             sta mirhi,x
000CDCr 2  A5 E5                lda wcxm                    ; the chars left of wcxm are not copied
000CDEr 2  9D rr rr             sta mirwcx,x
000CE1r 2  A5 rr                lda tmp3                    ; the chars from the first written to the last
000CE3r 2  38                   sec
000CE4r 2  E5 rr                sbc tmp4
000CE6r 2  B0 01                bcs :+                      ; nothing of it is in the window
000CE8r 2  60                   rts
000CE9r 2  18           :       clc
000CEAr 2  69 01                adc #1
000CECr 2  85 rr                sta tmp
000CEEr 2                       ; source: the last slot, base + (RINGROWS-1)*640 + tmp4*8; the mirror is one
000CEEr 2                       ; whole ring below it
000CEEr 2  A5 rr                lda tmp4
000CF0r 2  85 rr                sta w16
000CF2r 2  A9 00                lda #0
000CF4r 2  85 rr                sta w16+1
000CF6r 2  06 rr                asl w16
000CF8r 2  26 rr                rol w16+1
000CFAr 2  06 rr                asl w16
000CFCr 2  26 rr                rol w16+1
000CFEr 2  06 rr                asl w16
000D00r 2  26 rr                rol w16+1
000D02r 2  A5 rr                lda w16
000D04r 2  18                   clc
000D05r 2  69 80                adc #<(RING_A + (RINGROWS-1)*ROWBYTES)
000D07r 2  85 rr                sta w16
000D09r 2  A5 rr                lda w16+1
000D0Br 2  65 E0                adc ringbhi
000D0Dr 2  69 37                adc #>((RINGROWS-1)*ROWBYTES)
000D0Fr 2  85 rr                sta w16+1
000D11r 2  A5 rr                lda w16
000D13r 2  38                   sec
000D14r 2  E9 80                sbc #<RINGBYTES
000D16r 2  85 rr                sta w16b
000D18r 2  A5 rr                lda w16+1
000D1Ar 2  E9 39                sbc #>RINGBYTES
000D1Cr 2  85 rr                sta w16b+1
000D1Er 2  A0 00                ldy #0
000D20r 2  B1 rr 91 rr  @c:     .repeat 8
000D24r 2  C8 B1 rr 91  
000D28r 2  rr C8 B1 rr  
000D48r 2                       lda (w16),y
000D48r 2                       sta (w16b),y
000D48r 2                       iny
000D48r 2                       .endrepeat
000D48r 2  D0 04                bne :+
000D4Ar 2  E6 rr                inc w16+1
000D4Cr 2  E6 rr                inc w16b+1
000D4Er 2  C6 rr        :       dec tmp
000D50r 2  D0 CE                bne @c
000D52r 2  60                   rts
000D53r 2               
000D53r 2               ; ---------------------------------------------------------------- the CRTC
000D53r 2                       .segment "LGCLO"
000046r 2               crtc_init:                          ; start the chain at the bar and let vsync re-phase
000046r 2  A2 0A                ldx #10
000048r 2  A9 20                lda #$20                    ; the MOS's cursor off
00004Ar 2  20 rr rr             jsr @w
00004Dr 2  A2 09                ldx #9
00004Fr 2  A9 07                lda #7
000051r 2  20 rr rr             jsr @w
000054r 2  A2 04                ldx #4
000056r 2  A9 01                lda #BARROWS-1
000058r 2  20 rr rr             jsr @w
00005Br 2  A2 06                ldx #6
00005Dr 2  A9 02                lda #BARROWS
00005Fr 2  20 rr rr             jsr @w
000062r 2  A2 07                ldx #7
000064r 2  A9 1E                lda #30
000066r 2  20 rr rr             jsr @w
000069r 2  A2 0C                ldx #12
00006Br 2  A9 00                lda #>BARCRTC
00006Dr 2  20 rr rr             jsr @w
000070r 2  A2 0D                ldx #13
000072r 2  A9 60                lda #<BARCRTC
000074r 2  8E 00 FE     @w:     stx CRTC_IDX
000077r 2  8D 01 FE             sta CRTC_DAT
00007Ar 2  60                   rts
00007Br 2               
00007Br 2                       .segment "LGCBSS"
00007Cr 2  xx xx        crtcb:    .res 2                    ; the buffer being built: its CRTC base, and the
00007Er 2  xx xx        crtcbm:   .res 2                    ; mirror redirect (base - RINGCHARS)
000080r 2               
000080r 1                       .include "banks.s"
000080r 2               ; ============================================================================
000080r 2               ; The banks' tables and data, and the few routines that exist only here.
000080r 2               ;
000080r 2               ; $8000-$80FF of EVERY bank is the same: the far table (the thunk in low RAM reads
000080r 2               ; it from whichever bank is paged in), and the small tables more than one bank's
000080r 2               ; code indexes (sprmul5, the row multiples, the ring modulus).  The Master builds
000080r 2               ; these at start-up; here they are assembled.
000080r 2               ; ============================================================================
000080r 2               .macro COMMON_TABLES full           ; the far table alone in banks 4 and 6, whose
000080r 2                       .assert * = FARTAB, error, "the far table must be at FARTAB in every bank"
000080r 2                       .byte BANK_TILES, <(render_core-1),     >(render_core-1)        ; F_RENDCORE
000080r 2                       .byte BANK_SPR,   <(spr4::ds_entry-1),  >(spr4::ds_entry-1)     ; F_SPRLOOP4
000080r 2                       .byte BANK_MAP,   <(spr6::ds_entry-1),  >(spr6::ds_entry-1)     ; F_SPRLOOP6
000080r 2                       .byte BANK_TILES, <(mark_dirty_far-1),  >(mark_dirty_far-1)     ; F_MARKDIRTY
000080r 2                       .byte BANK_TILES, <(lvreset-1),         >(lvreset-1)            ; F_LVRESET
000080r 2                       .byte BANK_TILES, <(init5-1),           >(init5-1)              ; F_INIT5
000080r 2                 .if full
000080r 2                       .res $30 - 3*NFAR
000080r 2                       .assert * = sprmul5, error
000080r 2               .repeat MAXSPR, i
000080r 2                       .byte i*5
000080r 2               .endrepeat
000080r 2                       .res $20 - MAXSPR
000080r 2                       .assert * = mulrowlo, error
000080r 2               .repeat RINGROWS, i
000080r 2                       .byte <(i*ROWCHARS)
000080r 2               .endrepeat
000080r 2                       .res $18 - RINGROWS
000080r 2                       .assert * = mulrowhi, error
000080r 2               .repeat RINGROWS, i
000080r 2                       .byte >(i*ROWCHARS)
000080r 2               .endrepeat
000080r 2                       .res $18 - RINGROWS
000080r 2                       .assert * = ringmodtab, error
000080r 2               .repeat 128, i                      ; A = a map char row -> its ring slot: 128 rows
000080r 2                       .byte i .mod RINGROWS       ; is the tallest map (64 tiles)
000080r 2               .endrepeat
000080r 2                 .else
000080r 2                       .res $20 - 3*NFAR
000080r 2                 .endif
000080r 2               .endmacro
000080r 2                       .segment "COMMON4"
000000r 2  05 rr rr 04          COMMON_TABLES 0
000004r 2  rr rr 06 rr  
000008r 2  rr 05 rr rr  
000020r 2                       .segment "COMMON5"
000000r 2  05 rr rr 04          COMMON_TABLES 1
000004r 2  rr rr 06 rr  
000008r 2  rr 05 rr rr  
000100r 2                       .segment "COMMON6"
000000r 2  05 rr rr 04          COMMON_TABLES 0
000004r 2  rr rr 06 rr  
000008r 2  rr 05 rr rr  
000020r 2                       .segment "COMMON7"
000000r 2  05 rr rr 04          COMMON_TABLES 1
000004r 2  rr rr 06 rr  
000008r 2  rr 05 rr rr  
000100r 2               
000100r 2               ; ---------------------------------------------------------------- the sprite banks
000100r 2               ; SWAPTAB and MASKTAB0..3, at the same address in both banks that hold sprite data,
000100r 2               ; so the prologue in bank 5 can name a mask page for either.  The values are the
000100r 2               ; Master's init_tables' (MODE 1).
000100r 2               .macro MASK4 f                      ; AND mask by pair: keep what is NOT opaque
000100r 2                 .if f = 0
000100r 2                       .byte $FF
000100r 2                 .elseif f = 1
000100r 2                       .byte $CC
000100r 2                 .elseif f = 2
000100r 2                       .byte $33
000100r 2                 .else
000100r 2                       .byte $00
000100r 2                 .endif
000100r 2               .endmacro
000100r 2               .macro SWAP_TABLE
000100r 2                       .assert * = SWAPTAB, error, "SWAPTAB must be at the same address in both sprite banks"
000100r 2               .repeat 256, xx                     ; four-dot reversal: bits 7<->4, 6<->5, 3<->0, 2<->1
000100r 2                       .byte ((xx & $88) >> 3) | ((xx & $44) >> 1) | ((xx & $22) << 1) | ((xx & $11) << 3)
000100r 2               .endrepeat
000100r 2               .endmacro
000100r 2               .macro MASK_TABLES
000100r 2                       .assert * = MASKTAB0, error, "MASKTAB0 must be at the same address in both sprite banks"
000100r 2               .repeat 4, kk                       ; MASKTABk[x] = mask4[(x >> (6 - 2k)) & 3]
000100r 2                 .repeat 256, xx
000100r 2                       MASK4 {((xx >> (6 - 2*kk)) & 3)}
000100r 2                 .endrepeat
000100r 2               .endrepeat
000100r 2               .endmacro
000100r 2                       .segment "SPR4SWAP"
000000r 2  00 08 04 0C          SWAP_TABLE
000004r 2  02 0A 06 0E  
000008r 2  01 09 05 0D  
000100r 2                       .segment "SPR4MASK"
000000r 2  FF FF FF FF          MASK_TABLES
000004r 2  FF FF FF FF  
000008r 2  FF FF FF FF  
000400r 2                       .segment "SPR6SWAP"         ; bank 6 draws nothing mirrored: the packer keeps
000000r 2                 .if SPR6_MIRROR                   ; such images out, and the page holds data instead
000000r 2                       SWAP_TABLE
000000r 2                 .else
000000r 2  20 11 31 33          .incbin "build/spr6s.bin"
000004r 2  31 33 00 00  
000008r 2  00 00 20 11  
000100r 2                 .endif
000100r 2                       .segment "SPR6MASK"
000000r 2  FF FF FF FF          MASK_TABLES
000004r 2  FF FF FF FF  
000008r 2  FF FF FF FF  
000400r 2               
000400r 2                       .segment "SPR4HOLE"         ; $8030-$82FF of bank 4: mask planes, packed there
000000r 2  00 00 00 00          .incbin "build/spr4h.bin"
000004r 2  00 00 00 00  
000008r 2  03 07 07 03  
0002E0r 2                       .segment "SPR4DATA"         ; the images (and their masks) the packer put here
000000r 2  00 00 00 00          .incbin "build/spr4.bin"
000004r 2  00 00 00 00  
000008r 2  00 00 00 00  
0031F4r 2                       .segment "SPR6DATA"         ; and the rest, in bank 6 (directory flag $10)
000000r 2  13 32 E4 55          .incbin "build/spr6.bin"
000004r 2  A8 11 9B 32  
000008r 2  6E C8 E6 44  
0011B9r 2                       .segment "SPR6HOLE"         ; $8180-$82FF of bank 6: more of them
000000r 2  00 00 00 00          .incbin "build/spr6h.bin"
000004r 2  00 00 FF FF  
000008r 2  31 11 00 00  
0001ACr 2               
0001ACr 2               ; ---------------------------------------------------------------- bank 5: tiles
0001ACr 2                       .segment "TILDATA"
000000r 2               TILES:                              ; this level's tiles, 64 bytes each, by tile id
000000r 2                       .assert (* & $FF) = 0, error, "TILES must be page aligned (build_tileaddr)"
000000r 2  F5 FF F5 FF          .incbin "build/tiles.bin"
000004r 2  F5 FF F5 FF  
000008r 2  F5 FF F5 FF  
0029C0r 2               SPRMASK:                            ; mask plane address by sprite id
0029C0r 2  0A 82 0A 82          .incbin "build/sprmask.bin"
0029C4r 2  31 A8 31 A8  
0029C8r 2  AC 82 AC 82  
002AACr 2                       .segment "TILBSS"
0002AFr 2  xx xx xx xx  LV_PAGE0:  .res 512                 ; tile id -> address (build_tileaddr), page aligned
0002B3r 2  xx xx xx xx  
0002B7r 2  xx xx xx xx  
0004AFr 2               
0004AFr 2               ; the mirror's range: A = the first window column written of the row the mirror
0004AFr 2               ; follows, X = the last (0..79).  Those chars sit in the last slot row at wcxm on;
0004AFr 2               ; only the ones up to char 79 are in it (the rest wrapped to slot row 0), and only
0004AFr 2               ; those from wcxm are ever read (display.s).
0004AFr 2                       .segment "TILCODE"
000D53r 2               mirdirty:
000D53r 2  18                   clc
000D54r 2  65 E5                adc wcxm
000D56r 2  C9 50                cmp #ROWCHARS
000D58r 2  B0 26                bcs @out
000D5Ar 2  48                   pha
000D5Br 2  8A                   txa
000D5Cr 2  18                   clc
000D5Dr 2  65 E5                adc wcxm
000D5Fr 2  C9 50                cmp #ROWCHARS
000D61r 2  90 02                bcc :+
000D63r 2  A9 4F                lda #ROWCHARS-1
000D65r 2  AA           :       tax
000D66r 2  A4 rr                ldy curbuf
000D68r 2  A9 01                lda #1
000D6Ar 2  99 rr rr             sta mirdty,y
000D6Dr 2  68                   pla
000D6Er 2  D9 rr rr             cmp mirlo,y
000D71r 2  B0 03                bcs :+
000D73r 2  99 rr rr             sta mirlo,y
000D76r 2  8A           :       txa
000D77r 2  D9 rr rr             cmp mirhi,y
000D7Ar 2  90 03                bcc :+
000D7Cr 2  99 rr rr             sta mirhi,y
000D7Fr 2  60           :       rts
000D80r 2  60           @out:   rts
000D81r 2               
000D81r 2               ; the per-level clear the Master's load_level does in main RAM
000D81r 2               lvreset:
000D81r 2  A9 00 8D rr          stz BUF_VALID
000D85r 2  rr           
000D86r 2  A9 00 8D rr          stz BUF_VALID+1
000D8Ar 2  rr           
000D8Br 2  A9 00 8D rr          stz RECCNT
000D8Fr 2  rr           
000D90r 2  A9 00 8D rr          stz RECCNT+1
000D94r 2  rr           
000D95r 2  A9 00 8D rr          stz DIRTYCNT
000D99r 2  rr           
000D9Ar 2  A9 00 8D rr          stz DIRTYCNT+1
000D9Er 2  rr           
000D9Fr 2  60                   rts
000DA0r 2               
000DA0r 2               ; and the once-only part of its init_tables that is this bank's
000DA0r 2               init5:
000DA0r 2  A9 04                lda #BANK_SPR
000DA2r 2  8D rr rr             sta spbank
000DA5r 2  A9 FF                lda #$FF
000DA7r 2  8D rr rr             sta BUF_BARQ
000DAAr 2  8D rr rr             sta BUF_BARQ+1
000DADr 2  20 rr rr             jsr lvreset
000DB0r 2  4C rr rr             jmp build_tileaddr          ; (ends in pagelogic: harmless under a far call)
000DB3r 2               
000DB3r 2               ; ---------------------------------------------------------------- bank 6: the map
000DB3r 2                       .segment "MAPDATA"
000000r 2               LV_MAP:                             ; row major, 128 x 64 tile ids
000000r 2                       .assert (* & $FF) = 0, error, "LV_MAP must be page aligned (maprow)"
000000r 2  21 00 00 22          .incbin "build/map.bin"
000004r 2  23 02 02 24  
000008r 2  21 00 00 22  
002000r 2               SPR_TABLE:                          ; the sprite directory: the prologue in bank 5 reads
002000r 2  1A 96 09 1B          .incbin "build/sprtab.bin"  ; an entry through low RAM (dirfetch)
002004r 2  09 0B 02 36  
002008r 2  1A 96 09 1B  
0023B0r 2               
0023B0r 2               ; ---------------------------------------------------------------- bank 7: the level
0023B0r 2                       .segment "LGCDATA"          ; (page aligned: <LV_OBJS = 0 is what the logic assumes)
000000r 2               LV_OBJS:                            ; 6 bytes an object
000000r 2  00 19 17 02          .incbin "build/objs.bin"
000004r 2  00 00 00 16  
000008r 2  18 02 01 00  
000300r 2               LV_ATTR0:                           ; attribute (kill/push) by tile id
000300r 2  03 03 03 03          .incbin "build/attr.bin"
000304r 2  03 03 03 03  
000308r 2  03 03 03 03  
000400r 2               LV_ALTCLS:                          ; alt class by tile id
000400r 2  01 00 01 00          .incbin "build/altcls.bin"
000404r 2  00 00 00 00  
000408r 2  00 00 00 00  
000500r 2               LV_ATTR1 = LV_ALTCLS
000500r 2               LV_HDR:                             ; header: lw, lh, start, exit, nobj, the special tiles
000500r 2  07 06 1D 17          .incbin "build/hdr.bin"
000504r 2  5F 3B 7E 01  
000508r 2  64 65 66 67  
000520r 2               LV_ALTTAB:                          ; alt class -> eight altitudes
000520r 2  80 80 80 80          .incbin "build/alt.bin"
000524r 2  80 80 80 80  
000528r 2  08 08 08 08  
000568r 2               MUSIC_ADDR:                         ; 144 bytes of periods (the table itself, here),
000568r 2  BC 03 86 03          .incbin "build/music.bin"   ; then the note stream
00056Cr 2  53 03 24 03  
000570r 2  F6 02 CC 02  
000D54r 2               digits_art:                         ; the HUD's ten digits, 64 bytes each
000D54r 2  00 00 33 33          .incbin "build/digits.bin"
000D58r 2  FD FF EE CC  
000D5Cr 2  FF FF E6 CC  
000FD4r 2                       .segment "LGCBSS"
000080r 2               ; the object state arrays, laid out as the Master's (logic.s): O_STAMP + k*OBJN, then
000080r 2               ; the grid heads and chains and the cached bin walk lists.  level_init's clear runs
000080r 2               ; 2560 bytes from LV_OBJST, which stays inside these.
000080r 2  xx xx xx xx  LV_OBJST:   .res 16*OBJN
000084r 2  xx xx xx xx  
000088r 2  xx xx xx xx  
000860r 2  xx xx xx xx  LV_GRID:    .res 128
000864r 2  xx xx xx xx  
000868r 2  xx xx xx xx  
0008E0r 2  xx xx xx xx  LV_BOBJ:    .res 256                ; an entry per object per grid cell it covers: up
0008E4r 2  xx xx xx xx  
0008E8r 2  xx xx xx xx  
0009E0r 2  xx xx xx xx  LV_BNEXT:   .res 256                ; to 255 of them, as the Master's tables
0009E4r 2  xx xx xx xx  
0009E8r 2  xx xx xx xx  
000AE0r 2  xx xx xx xx  LV_BINSTAR: .res BINMAX
000AE4r 2  xx xx xx xx  
000AE8r 2  xx xx xx xx  
000B08r 2  xx xx xx xx  LV_BINOTH:  .res BINMAX
000B0Cr 2  xx xx xx xx  
000B10r 2  xx xx xx xx  
000B30r 2                       .assert 16*OBJN + 128 + 512 + 2*BINMAX >= 2560, error, "level_init's clear overruns the arrays"
000B30r 2  xx           title_res:  .res 1                  ; (the menus': game.s clears it)
000B31r 2               
000B31r 1                       .include "init.s"
000B31r 2               ; ============================================================================
000B31r 2               ; Start-up.  The loader leaves bank 7 paged in and jumps to $8100.  The low-RAM
000B31r 2               ; image lives in bank 6 (the only bank with a corner free below the mask tables),
000B31r 2               ; so the copy runs there; the rest is the Master's start (src/main.s) less the
000B31r 2               ; disc: the tables it builds are static here (banks.s) and the bank-5 part is
000B31r 2               ; init5.
000B31r 2               ; ============================================================================
000B31r 2                       .segment "LGCENT"           ; bank 7, $8100: the entry vector
000000r 2                       .assert * = BANKCODE, error, "the loader jumps to BANKCODE"
000000r 2               ; A bank cannot page itself out and carry on: the instruction after the switch is
000000r 2               ; read from the new bank.  So the switch runs from main RAM -- the bottom of the
000000r 2               ; stack page, which nothing has used yet.
000000r 2  A2 09        entry:  ldx #@stubend-@stub-1
000002r 2  BD rr rr     :       lda @stub,x
000005r 2  9D 00 01             sta $0100,x
000008r 2  CA                   dex
000009r 2  10 F7                bpl :-
00000Br 2  4C 00 01             jmp $0100
00000Er 2  A9 06        @stub:  lda #BANK_MAP
000010r 2  85 F4                sta ROMSEL_CPY
000012r 2  8D 30 FE             sta ROMSEL
000015r 2  4C rr rr             jmp start6
000018r 2               @stubend:
000018r 2               
000018r 2                       .segment "MAPLO"            ; bank 6
000000r 2                       .import __LOWCODE_LOAD__: absolute, __LOWCODE_RUN__: absolute
000000r 2                       .import __LOWCODE_SIZE__: absolute
000000r 2               start6:
000000r 2  78                   sei
000001r 2  A2 3F                ldx #$3F                    ; the stack is 64 bytes: $0100-$013F
000003r 2  9A                   txs
000004r 2  A9 00                lda #0                      ; zero page ($F0-$FF is the MOS's: $F4 is the
000006r 2  A2 00                ldx #0                      ; bank the loader selected, and the OS IRQ still
000008r 2  95 00        :       sta $00,x                   ; restores from it until take_over) and the low RAM
00000Ar 2  E8                   inx
00000Br 2  E0 F0                cpx #$F0
00000Dr 2  D0 F9                bne :-
00000Fr 2  A2 00                ldx #0
000011r 2  9D 40 01     :       sta $0140,x
000014r 2  E8                   inx
000015r 2  E0 C4                cpx #$C4
000017r 2  D0 F8                bne :-
000019r 2                       ; the low-RAM image is copied down to $0206
000019r 2  A9 rr                lda #<__LOWCODE_LOAD__
00001Br 2  85 rr                sta w16
00001Dr 2  A9 rr                lda #>__LOWCODE_LOAD__
00001Fr 2  85 rr                sta w16+1
000021r 2  A9 rr                lda #<__LOWCODE_RUN__
000023r 2  85 rr                sta w16b
000025r 2  A9 rr                lda #>__LOWCODE_RUN__
000027r 2  85 rr                sta w16b+1
000029r 2                       .assert __LOWCODE_SIZE__ < 256, error, "the low-RAM image is copied a byte at a time"
000029r 2  A0 00                ldy #0                      ; exactly its length: the bar starts at $0300
00002Br 2  B1 rr        @lc:    lda (w16),y
00002Dr 2  91 rr                sta (w16b),y
00002Fr 2  C8                   iny
000030r 2  C0 rr                cpy #<__LOWCODE_SIZE__
000032r 2  D0 F7                bne @lc
000034r 2  4C rr rr             jmp to7                     ; the switch to bank 7 runs from low RAM (low.s)
000037r 2               
000037r 2                       .segment "LGCCODE"
002286r 2               start7:
002286r 2  A2 0F 20 rr          farjsr F_INIT5              ; bank 5's records, spbank, the tile address table
00228Ar 2  rr           
00228Br 2                       ; what the Master's init_tables sets that is this bank's or the zero page's
00228Br 2  A9 00 8D rr          stz MUSON
00228Fr 2  rr           
002290r 2  A9 00 85 A5          stz SFXREQ
002294r 2  A9 39                lda #<VS2T_DEFAULT
002296r 2  8D rr rr             sta VS2T
002299r 2  A9 0F                lda #>VS2T_DEFAULT
00229Br 2  8D rr rr             sta VS2T+1
00229Er 2  20 rr rr             jsr music_init
0022A1r 2  A9 34                lda #$34
0022A3r 2  85 rr                sta seed
0022A5r 2  A9 12                lda #$12
0022A7r 2  85 rr                sta seed+1
0022A9r 2  20 rr rr             jsr crtc_init
0022ACr 2                       ; both buffers' chains, for a blank window at the origin (ringS, barq, wfine
0022ACr 2                       ; are the zeros above), before the interrupt can walk one
0022ACr 2  20 rr rr             jsr build_sections
0022AFr 2  E6 rr                inc curbuf
0022B1r 2  20 rr rr             jsr build_sections
0022B4r 2  A9 00 85 rr          stz curbuf
0022B8r 2  20 rr rr             jsr take_over
0022BBr 2  20 rr rr             jsr music_start             ; the title menu would have
0022BEr 2  4C rr rr             jmp game_main
0022C1r 2               
0022C1r 1               
